# generated by theme-apply — do not edit
# omarchy's semantic palette, at the path their apps read it from:
# ~/.local/state/omarchy/current/theme/colors.toml. Read unpatched by disktree
# (and anything else built on gpui-omarchy) and by Hype.
#
# The mapping is bin/theme-port-omarchy run backwards, so a ported theme comes
# out with omarchy's own values. Two exceptions follow oma-theme.toml.tmpl:
# foreground is text.primary and selection is surface.3. gpui-omarchy rejects
# the WHOLE file for one missing or malformed key, and then falls back to Tokyo
# Night. The keys it requires are background, foreground, accent, red, yellow,
# green, and mode (dark or light). Every value has to be #RRGGBB.
# darker_background, light_foreground, orange and brown are left out: no token
# maps to them, and nothing here reads them.
mode = "{{meta.mode}}"

accent = "{{accent.accent}}"
selection = "{{surface.3}}"
muted = "{{ansi.bright-black}}"

background = "{{surface.1}}"
dark_background = "{{surface.0}}"
lighter_background = "{{surface.2}}"

foreground = "{{text.primary}}"
dark_foreground = "{{text.muted}}"
bright_foreground = "{{ansi.bright-white}}"

red = "{{ansi.red}}"
yellow = "{{ansi.yellow}}"
green = "{{ansi.green}}"
cyan = "{{ansi.cyan}}"
blue = "{{ansi.blue}}"
magenta = "{{ansi.magenta}}"

bright_red = "{{ansi.bright-red}}"
bright_yellow = "{{ansi.bright-yellow}}"
bright_green = "{{ansi.bright-green}}"
bright_cyan = "{{ansi.bright-cyan}}"
bright_blue = "{{ansi.bright-blue}}"
bright_magenta = "{{ansi.bright-magenta}}"
