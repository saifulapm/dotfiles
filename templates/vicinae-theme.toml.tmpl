# Generated by bin/theme-apply from the active qshell theme — do not edit.
# Vicinae theme (docs.vicinae.com/theming): unset keys derive from core or
# inherit from the built-in parent for this variant.

[meta]
version = 1
name = "qshell"
description = "Generated from the active qshell theme"
variant = "{{meta.mode}}"

[colors.core]
background = "{{surface.1}}"
foreground = "{{text.primary}}"
secondary_background = "{{surface.0}}"
border = "{{surface.3}}"
accent = "{{accent.accent}}"

[colors.accents]
blue = "{{ansi.blue}}"
green = "{{ansi.green}}"
magenta = "{{ansi.magenta}}"
orange = "{{ansi.bright-yellow}}"
purple = "{{ansi.magenta}}"
red = "{{ansi.red}}"
yellow = "{{ansi.yellow}}"
cyan = "{{ansi.cyan}}"

[colors.text]
default = "{{text.primary}}"
muted = "{{text.muted}}"
danger = "{{accent.error}}"
success = "{{accent.ok}}"
placeholder = "{{text.muted}}"

[colors.text.selection]
background = "{{accent.accent}}"
foreground = "{{text.on-accent}}"

[colors.input]
background = "{{surface.0}}"
border = "{{surface.3}}"
border_focus = "{{accent.accent}}"
border_error = "{{accent.error}}"

[colors.list.item.selection]
background = "{{surface.2}}"

[colors.list.item.hover]
background = "{{surface.2}}"

[colors.grid.item]
background = "{{surface.2}}"

[colors.grid.item.selection]
outline = "{{accent.accent}}"

[colors.grid.item.hover]
outline = "{{surface.3}}"

[colors.main_window]
border = "{{ gradient_start border.active }}"

[colors.main_window.footer]
background = "{{surface.0}}"

[colors.settings_window]
border = "{{surface.3}}"

[colors.shortcut]
border = "{{surface.3}}"

[colors.tooltip]
background = "{{surface.2}}"
foreground = "{{text.primary}}"
border = "{{surface.3}}"

[colors.scrollbars]
background = "{{surface.3}}"

[colors.loading]
bar = "{{accent.accent}}"
spinner = "{{accent.accent}}"

[colors.button.primary]
background = "{{accent.accent}}"
foreground = "{{text.on-accent}}"
