# generated by theme-apply — do not edit.
# Rendered to ~/.config/yazi/flavors/qshell.yazi/flavor.toml, alongside the
# tmtheme.xml this same script renders from templates/yazi-tmtheme.xml.tmpl.
# Those two filenames are the whole runtime contract: yazi resolves a flavor as
# flavors/<name>.yazi/flavor.toml plus flavors/<name>.yazi/tmtheme.xml, and the
# README/preview/LICENSE files in a published flavor are convention only.
#
# A flavor rather than a bare theme.toml, since 2026-08-18, because the flavor
# is the only thing that carries a tmTheme — which is what colours the CODE
# PREVIEW. A hand-written theme.toml can set `mgr.syntect_theme` to a path, but
# a flavor's tmtheme.xml is picked up automatically and follows the light/dark
# polarity with it. ~/.config/yazi/theme.toml still exists and still wins over
# everything here; it just holds the two-line [flavor] selection now.
#
# Every key below is on the 26.8.15 schema. The file this replaced still used
# names from before v25.12.29 — `mgr.hovered`, `mgr.tab_active`,
# `status.mode_normal`, `status.permissions_r`, `[completion]`, `help.on` —
# and yazi ignores unknown fields silently, so roughly a third of the old
# theme had simply stopped applying without ever erroring.

[mgr]
cwd = { fg = "{{accent.accent}}" }

# Find
find_keyword = { fg = "{{ansi.yellow}}", bold = true, italic = true, underline = true }
find_position = { fg = "{{ansi.magenta}}", bg = "reset", italic = true }

# Symlink target, appended after the filename
symlink_target = { fg = "{{text.muted}}", italic = true }

# Marker: the thin bar in the gutter next to a copied/cut/selected file
marker_copied = { fg = "{{ansi.green}}", bg = "{{ansi.green}}" }
marker_cut = { fg = "{{ansi.red}}", bg = "{{ansi.red}}" }
marker_marked = { fg = "{{ansi.cyan}}", bg = "{{ansi.cyan}}" }
marker_selected = { fg = "{{accent.accent}}", bg = "{{accent.accent}}" }
marker_symbol = "│"

# Count badges on the tab/status
count_copied = { fg = "{{surface.0}}", bg = "{{ansi.green}}" }
count_cut = { fg = "{{surface.0}}", bg = "{{ansi.red}}" }
count_selected = { fg = "{{surface.0}}", bg = "{{accent.accent}}" }

# Border
border_symbol = "│"
border_style = { fg = "{{surface.2}}" }

# The cursor bar. Was [mgr] hovered / preview_hovered before v25.12.29.
#
# `padding` is written as \u escapes, not as literal glyphs, and that is the
# whole point: these are private-use-area powerline caps (U+E0B6 / U+E0B4) and
# they do not survive being copied around — the template this file replaced had
# lost the same pair from its status separators long ago, which is how they
# reached here empty.
#
# Empty padding is not cosmetic. yazi reserves the cap column on the cursor row
# only when the strings are non-empty, so with `""` the hovered row's text
# renders ONE COLUMN LEFT of every other row — the ragged cursor line reported
# 2026-08-18. Bisected to this exact key: with the glyphs the offset is 0, with
# empty strings it is -1, and stock yazi (which ships the glyphs) is aligned.
[indicator]
parent = { reversed = true }
current = { reversed = true }
preview = { underline = true }
padding = { open = "\ue0b6", close = "\ue0b4" }

# Was [mgr] tab_active / tab_inactive / tab_width.
[tabs]
active = { fg = "{{surface.0}}", bg = "{{accent.accent}}", bold = true }
inactive = { fg = "{{text.primary}}", bg = "{{surface.2}}" }
sep_inner = { open = "", close = "" }
sep_outer = { open = "", close = "" }

# Was [status] mode_normal / mode_select / mode_unset. The _alt half is the
# shoulder either side of the badge, which the old file had no concept of.
[mode]
normal_main = { fg = "{{surface.0}}", bg = "{{accent.accent}}", bold = true }
normal_alt = { fg = "{{accent.accent}}", bg = "{{surface.2}}" }
select_main = { fg = "{{surface.0}}", bg = "{{ansi.green}}", bold = true }
select_alt = { fg = "{{ansi.green}}", bg = "{{surface.2}}" }
unset_main = { fg = "{{surface.0}}", bg = "{{ansi.magenta}}", bold = true }
unset_alt = { fg = "{{ansi.magenta}}", bg = "{{surface.2}}" }

[status]
overall = { bg = "{{surface.0}}" }
sep_left = { open = "", close = "" }
sep_right = { open = "", close = "" }

# Permissions. Was permissions_t / _r / _w / _x / _s.
perm_type = { fg = "{{accent.accent}}" }
perm_read = { fg = "{{ansi.yellow}}" }
perm_write = { fg = "{{ansi.red}}" }
perm_exec = { fg = "{{ansi.green}}" }
perm_sep = { fg = "{{text.muted}}" }

# Progress
progress_label = { fg = "{{text.primary}}", bold = true }
progress_normal = { fg = "{{accent.accent}}", bg = "{{surface.2}}" }
progress_error = { fg = "{{ansi.red}}", bg = "{{surface.2}}" }

[pick]
border = { fg = "{{accent.accent}}" }
active = { fg = "{{ansi.magenta}}", bold = true }
inactive = {}

[input]
border = { fg = "{{accent.accent}}" }
title = {}
value = {}
selected = { reversed = true }

[confirm]
border = { fg = "{{accent.accent}}" }
title = { fg = "{{accent.accent}}" }
body = {}
list = {}
btn_yes = { reversed = true }
btn_no = {}
btn_labels = [ "  [Y]es  ", "  [N]o  " ]

# The file-information panel on Tab. New section — the old theme never had one.
[spot]
border = { fg = "{{accent.accent}}" }
title = { fg = "{{accent.accent}}" }
tbl_col = { fg = "{{accent.accent}}" }
tbl_cell = { fg = "{{ansi.yellow}}", reversed = true }

# Was [completion].
[cmp]
border = { fg = "{{accent.accent}}" }
active = { reversed = true }
inactive = {}
icon_file = ""
icon_folder = ""
icon_command = ""

[tasks]
border = { fg = "{{accent.accent}}" }
title = {}
hovered = { fg = "{{ansi.magenta}}" }

[which]
border = { fg = "{{accent.accent}}" }
cols = 3
mask = { bg = "{{surface.0}}" }
cand = { fg = "{{accent.accent}}" }
rest = { fg = "{{text.muted}}" }
desc = { fg = "{{ansi.magenta}}" }
separator = "  "
separator_style = { fg = "{{surface.2}}" }

# The help menu is a command palette since v26.8.15: `on`/`run`/`desc` became
# `chord`/`action`, and `footer` no longer exists.
[help]
border = { fg = "{{accent.accent}}" }
chord = { fg = "{{accent.accent}}" }
action = { fg = "{{ansi.magenta}}" }
hovered = { reversed = true, bold = true }

[notify]
title_info = { fg = "{{ansi.green}}" }
title_warn = { fg = "{{ansi.yellow}}" }
title_error = { fg = "{{ansi.red}}" }
icon_info = ""
icon_warn = ""
icon_error = ""

# git.yazi reads its own styles from here (custom plugin styles, v26.5.6).
# Without this block it falls back to hardcoded magenta/yellow/green that owe
# nothing to the palette.
[git]
unknown = { fg = "{{text.muted}}" }
ignored = { fg = "{{text.muted}}" }
untracked = { fg = "{{ansi.magenta}}" }
modified = { fg = "{{ansi.yellow}}" }
added = { fg = "{{ansi.green}}" }
deleted = { fg = "{{ansi.red}}" }
updated = { fg = "{{ansi.yellow}}" }
clean = { fg = "{{text.muted}}" }

[filetype]
rules = [
	# Images
	{ mime = "image/*", fg = "{{ansi.cyan}}" },

	# Media
	{ mime = "{audio,video}/*", fg = "{{ansi.magenta}}" },

	# Archives
	{ mime = "application/*zip*", fg = "{{ansi.red}}" },
	{ mime = "application/x-{tar,bzip*,7z-compressed,xz,rar}", fg = "{{ansi.red}}" },

	# Documents
	{ mime = "application/{pdf,doc,rtf}", fg = "{{ansi.blue}}" },

	# Special files, from the preset — these were lost when the old theme
	# replaced the whole rule list with its own.
	{ url = "*", is = "orphan", bg = "{{ansi.red}}" },
	{ url = "*", is = "dummy", bg = "{{ansi.red}}" },
	{ url = "*", is = "exec", fg = "{{ansi.green}}" },

	# Fallback
	{ url = "*", fg = "{{text.primary}}" },
	{ url = "*/", fg = "{{accent.accent}}" },
]
