# generated by theme-apply — do not edit. amx (coding agents as tmux panes) on
# our tokens. Rendered to ~/.config/amx/themes/qshell.toml, which makes the
# theme's name "qshell" — amx takes it from the filename, the cliamp/helix/
# btop/television convention — and ~/.config/amx/config.toml pins theme =
# "qshell".
#
# No poke below, and none needed: amx stamps the theme file's mtime and
# re-reads it when it moves (src/theme.rs), so an open `amx` view repaints on
# the next tick of its own accord. Nothing to signal, nothing to restart.
#
# SIX KEYS IS THE WHOLE FILE. amx's theme has no per-widget keys, no styles and
# no glyphs — six roles named for what they MEAN, not for what colour they are,
# because a row is painted for having failed rather than for being red. A
# missing role falls back to amx's built-in value rather than killing the
# process (the television hazard does not apply here), but all six are emitted
# anyway: a palette that is five-sixths ours and one-sixth claude's is the one
# outcome nobody would have chosen.
#
# The restraint is load-bearing and worth preserving if this file ever grows:
# most of an amx screen wears none of these. What a row is, where the cursor
# sits and what a group holds are said in words, in weight, and in the dim the
# terminal already has. A colour is spent on one question — how it went, or
# whether it wants a person — so that the two or three of them on a wall of
# forty rows are the two or three worth looking at.

# Something is waiting on a person. The semantic warn rather than ansi.yellow:
# this is the one state that is asking for attention rather than reporting, so
# it takes the token every theme tunes to be legible as a warning.
waiting = "{{accent.warn}}"

# It went the way it was meant to.
done = "{{accent.ok}}"

# It was attempted and it failed.
failed = "{{accent.error}}"

# It was ended by hand, and nothing more is coming. text.muted, not an ansi
# grey: a stopped agent is finished business, and it should recede to exactly
# the weight every other piece of secondary text on the machine recedes to.
stopped = "{{text.muted}}"

# What the next agent will be allowed to do without asking, printed under the
# line that would start it. The theme's signature colour, which is the same
# call television's input_text_fg and match_fg make — this is the one thing on
# screen about an agent that does not exist yet, and the one a person is about
# to press enter past.
accent = "{{accent.accent}}"

# The line the cursor is on, as a BACKGROUND rather than a foreground: it says
# where the cursor is without taking a colour away from what the line was
# already saying. surface.3 is the selection pair helix and television both
# use, so a selection reads identically in the terminal, the editor, the picker
# and here.
cursor = "{{surface.3}}"
