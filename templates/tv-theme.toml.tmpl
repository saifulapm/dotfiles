# generated by theme-apply — do not edit. television (tv) picker theme on our
# tokens, following the helix/btop mapping: foot's selection pair, ansi palette
# for result hues, accent for the theme's signature marks. Rendered to
# ~/.config/television/themes/qshell.toml; config.toml pins theme = "qshell".
#
# No poke needed, unlike btop/helix/kak: tv is a short-lived process launched
# fresh by the ctrl-r / ctrl-t bindings, so it re-reads this file every time.
# Theme::from_name tries <config-dir>/themes/<name>.toml FIRST and only falls
# back to the builtins, so this file wins on name alone.
#
# EVERY key below is load-bearing. television 0.15.9's Theme deserializer does
# `Inner::deserialize(...).unwrap_or_else(|err| { eprintln!(...); exit(1) })` —
# a missing required key does NOT degrade to the default theme, it kills the
# process, which would take ctrl-r down with it. background/selection_fg/
# channel_mode_bg/action_picker_mode_* are the only Option<String> fields;
# the rest are required. Re-check this list when bumping television.

# general
# background is deliberately LEFT UNSET (upstream's own default.toml comments
# it out for the same reason): unset means "paint nothing", so tv inherits the
# terminal's background instead of covering it. That keeps the ctrl-r popup on
# foot's frosted/blurred background — an explicit surface.0 here would be the
# same color but opaque, punching a solid rectangle through the blur and
# desyncing from bin/foot-frost on every toggle. foot's background already IS
# surface.0, so the theme still lands.
border_fg = "{{text.muted}}"
text_fg = "{{text.primary}}"
dimmed_text_fg = "{{text.muted}}"

# input
# The query you type carries the theme's signature color, as match_fg does —
# same semantic (this is what matched), same color, which is how upstream's
# own themes read (gruvbox-dark ties both to #fb4934).
input_text_fg = "{{accent.accent}}"
# The n/N counter is metadata, so it stays muted rather than following
# upstream's vivid choice — same call as btop's inactive_fg.
result_count_fg = "{{text.muted}}"

# results
# Entry names are paths in the file/dirs/git channels — ansi.blue is what
# helix's ui.text.directory uses, so directories read the same in both.
result_name_fg = "{{ansi.blue}}"
result_line_number_fg = "{{ansi.yellow}}"
result_value_fg = "{{text.primary}}"
# The selected row reuses foot's selection pair, exactly as the helix template
# does (selection_background = surface.3), so a selection looks identical
# across the terminal, the editor and the picker.
selection_bg = "{{surface.3}}"
selection_fg = "{{text.primary}}"
match_fg = "{{accent.accent}}"

# preview
preview_title_fg = "{{accent.accent}}"

# modes
# The mode chips are colored badges, so their text takes surface.0 — the same
# `fg = "background"` move the helix template makes for its colored statusline
# segments, and it holds on light themes too because surface.0 is always the
# far end from a vivid ansi hue. Upstream's hue-per-mode split is kept so the
# three badges stay tellable apart at a glance.
channel_mode_fg = "{{surface.0}}"
channel_mode_bg = "{{ansi.magenta}}"
remote_control_mode_fg = "{{surface.0}}"
remote_control_mode_bg = "{{ansi.cyan}}"
action_picker_mode_fg = "{{surface.0}}"
action_picker_mode_bg = "{{ansi.blue}}"
