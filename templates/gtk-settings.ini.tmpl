# generated by theme-apply — do not edit
#
# What actually makes GTK apps dark on niri. Measured, because none of it is
# obvious:
#
#   * GTK3 on Wayland reads org.gnome.desktop.interface through gsettings for
#     the keys that schema defines, so it already knows the theme name and the
#     font — but `gtk-application-prefer-dark-theme` is NOT one of those keys,
#     and `color-scheme: prefer-dark` (which theme-apply also sets, and which
#     libadwaita and GTK4 do read) moves nothing in GTK3. This file is the only
#     channel that carries the polarity to GTK3.
#   * the theme name must stay "Adwaita". There is no Adwaita-dark on disk —
#     /usr/share/themes holds only Default and Emacs, GTK3's Adwaita is built
#     into the library, and its dark variant is Adwaita plus the flag below.
#     Naming a theme that does not exist drops GTK back to the light default
#     and takes the flag down with it.
#
# Colors still come from gtk.css next door (@define-color over Adwaita); this
# only picks which Adwaita they are painted onto, and follows the theme's own
# mode so a light theme takes GTK apps light with it.
#
# Read at application start: apps already running keep the old polarity until
# they are restarted.
[Settings]
gtk-theme-name=Adwaita
gtk-application-prefer-dark-theme={{gtk.prefer-dark}}
