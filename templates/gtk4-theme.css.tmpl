/* generated by theme-apply — do not edit */
/* A recolor for PLAIN GTK4 apps (ripdrag et al.), opt-in per launcher via
   GTK_THEME=qshell — global gtk.css rules this blunt would also stomp
   libadwaita apps, which already take these tokens as named colors from
   ~/.config/gtk-4.0/gtk.css. GTK's builtin Default stylesheet hardcodes its
   grays (no variables to override, checked against 4.22), so it is imported
   as the base and the theme surfaces are painted over it. Surface roles
   mirror gtk.css.tmpl: window/headerbar surface.1, views surface.0,
   raised/popover surface.2. */
@import url("resource:///org/gtk/libgtk/theme/Default/{{gtk.default-stylesheet}}.css");

window, .background { background-color: {{surface.1}}; color: {{text.primary}}; }
headerbar {
    background-color: {{surface.1}};
    color: {{text.primary}};
    box-shadow: none;
    border-bottom: 1px solid {{surface.3}};
}
.view, listview, textview > text { background-color: {{surface.0}}; color: {{text.primary}}; }
listview > row:hover { background-color: {{surface.2}}; }
listview > row:selected { background-color: {{accent.accent}}; color: {{text.on-accent}}; }
button {
    background-image: none;
    background-color: {{surface.2}};
    color: {{text.primary}};
    border-color: {{surface.3}};
}
button:hover { background-color: {{surface.3}}; }
button:active { background-color: {{accent.accent}}; color: {{text.on-accent}}; }
popover > contents, popover > arrow { background-color: {{surface.2}}; color: {{text.primary}}; }
scrollbar > range > trough > slider { background-color: {{surface.3}}; }
selection { background-color: {{accent.accent}}; color: {{text.on-accent}}; }
tooltip { background-color: {{surface.2}}; color: {{text.primary}}; }
