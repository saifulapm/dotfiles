// Generated by bin/theme-apply from the active theme — do not edit.
// Theme character only (colors, corner radius, motion speed): geometry
// (widths, gaps) lives in config.kdl.
// Included configs never auto-enable border/focus-ring, so listing both
// here is safe — whichever one config.kdl enables picks up these colors.
layout {
    // Transparent so the wallpaper shows through: the shell's background
    // layer is placed within niri's backdrop (see the layer-rule in
    // config.kdl), and an opaque workspace background would cover it
    // everywhere except the overview. With no wallpaper set, the overview
    // backdrop-color below is what shows.
    background-color "transparent"

    // border.active carries either a solid color or a gradient; the
    // {{ niri_active }} template function in bin/theme-apply writes
    // active-color or active-gradient accordingly. A *-gradient key takes
    // precedence over the matching *-color, so only one is ever emitted.
    focus-ring {
        {{ niri_active border.active }}
        inactive-color "{{surface.3}}"
        urgent-color "{{accent.error}}"
    }

    border {
        {{ niri_active border.active }}
        inactive-color "{{surface.3}}"
        urgent-color "{{accent.error}}"
    }

    tab-indicator {
        active-color "{{accent.accent}}"
        inactive-color "{{text.muted}}"
        urgent-color "{{accent.error}}"
    }

    insert-hint {
        color "{{accent.accent}}80"
    }

    // Per-theme drop shadow — a full block with explicit `on` when the theme
    // (or its preset) enables it, a comment otherwise. config.kdl carries no
    // shadow of its own, so this is the only writer.
    {{ niri_shadow shadow.enabled }}
}

overview {
    backdrop-color "{{surface.0}}"
}

// The Alt-Tab switcher's selection highlight. niri's defaults are a flat
// #999999 grey with square corners — the last surface in the session that
// ignored the theme. accent.accent and accent.error are the same tokens
// tab-indicator uses above, so "this one is selected" and "this one is
// shouting" read identically wherever they appear. Padding and the open delay
// are geometry and live in config.kdl.
//
// The radius is the window radius, not window radius + highlight padding, so
// the corners are very slightly tighter than truly concentric. At padding 10
// that is not visible, and the engine does no arithmetic — a template function
// for a 10 px offset would cost more than it buys.
recent-windows {
    highlight {
        active-color "{{accent.accent}}"
        urgent-color "{{accent.error}}"
        corner-radius {{shape.radius}}
    }
}

// The theme's radius clips every window; the border/shadow follow it.
window-rule {
    geometry-corner-radius {{shape.radius}}
    clip-to-geometry true
}

// Marks whichever window an ongoing screencast is pointed at, including the
// dynamic cast target (Mod+Shift+8/9/0 in config.kdl) — without it a dynamic
// cast gives no on-screen sign of what it currently shows. Lives here rather
// than in config.kdl because the colour has to be a theme token: config.kdl's
// own border colours are only the fallback, and this include overrides them
// per theme. accent.error is the same token the urgent-* colours above use,
// so "a screencast is watching this" reads like every other alarm state.
// Both blocks listed for the same reason the layout ones are — an include
// never enables border or focus-ring, so whichever config.kdl turns on picks
// the colours up (today: border, focus-ring is off).
//
// Placement matters: window rules apply in order and later ones win, so this
// must stay AFTER the unconditional radius rule above, and the whole include
// sits after config.kdl's own window rules. Only borders are set, so the
// radius and clip from that rule still apply.
window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "{{accent.error}}"
        inactive-color "{{accent.error}}b0"
    }

    border {
        active-color "{{accent.error}}"
        inactive-color "{{accent.error}}b0"
    }
}

// The base window-opacity pair, themed (config.kdl no longer carries one).
// The media/PiP/shell-toplevel exemption is re-stated by the emitter AFTER
// the pair: for a contested property the latest matching rule wins, and this
// include sits after every config.kdl rule. The blur fragment (niri-blur.kdl,
// included after this file) overrides the pair again while blur is on.
{{ niri_opacity opacity.active }}

// The compositor side of the theme's motion character: explicit blocks built
// from the motion.* tokens. Included sections merge per block and the later
// definition wins, so these replace config.kdl's reference values wholesale.
// A zero-motion theme emits `off` and stills the compositor outright.
animations {
    {{ niri_animations motion.duration }}
}
