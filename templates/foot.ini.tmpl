# Rendered to ~/.config/foot/foot.ini by bin/theme-apply — do not edit there.
# Only deviations from foot 1.27 defaults live here; everything else (TERM=foot,
# url mode, mouse bindings) is deliberately stock. See foot.ini(5).
[main]
# The Arch config's tuned pair — 12.5pt glyphs in a 32px cell (~40% leading),
# within 2 physical px of the Emacs look at this machine's scale — is the
# ANCHOR; both numbers now scale with the desktop text-size knob
# (bin/text-size → theme-override [font] size → theme-apply's font.foot-*
# derivations; token 12 renders exactly the tuned 12.5/32 pair). Points beat
# pixelsize: they stay proportional under any output scale. foot cannot
# reload config — running windows keep their size until reopened.
#
# The second entry is the icon font, named explicitly rather than left to
# fontconfig. foot.ini(5): "the first font is the primary font. The remaining
# fonts are fallback fonts... searched in the order they appear. If a glyph
# cannot be found in any of the fallback fonts, the dynamic fallback list from
# fontconfig (for the primary font) is searched." Both paths reach the same
# file today — 50-qshell.conf puts Symbols Nerd Font Mono on the `monospace`
# accept-list, and glyphs did render without this line (verified by screenshot
# 2026-08-09: powerline, seti, devicon, codicon, FontAwesome, Material and IEC
# all drew). Naming it here makes that deterministic instead of incidental:
# the terminal stops depending on the generic-alias chain resolving the way it
# happens to today, and a fontconfig edit cannot silently cost the icons.
# Sized to match the text font so the icon cell lines up. Bold/italic inherit
# this list automatically — foot.ini(5) again: with font-bold et al unset, the
# bold/italic variants of "the regular font(s) specified in font" are used.
font={{font.mono}}:size={{font.foot-pt}}, Symbols Nerd Font Mono:size={{font.foot-pt}}
line-height={{font.foot-line-height}}px
include=~/.config/foot/theme.ini

# The frost half of the blur toggle: a symlink flipped between the
# theme-apply-rendered frost/solid alpha fragments (bin/foot-frost, called
# by the shell's blur service). Always present — theme-apply guarantees it —
# because foot treats a missing include as fatal and falls back to stock
# defaults wholesale.
include=~/.local/state/qshell/foot-alpha.ini

# Arch parity: selecting text copies it to the clipboard too (primary is still
# fed, so middle-click paste and anything reading the primary selection keep
# working).
selection-target=both

# Server-mode windows default to app-id "footclient"; pin one id so niri rules
# and the shell's icon lookup see the same window either way it was launched.
app-id=foot

# The old Arch config's inset, plus foot's default centering mode (writing a
# pad value without it would drop back to top-left anchoring).
pad=14x14 center-when-maximized-and-fullscreen

# Linear-space blending — how macOS composites text, and why its bright-on-dark
# glyphs read heavier. Inert on niri today (foot logs "gamma-corrected-blending:
# disabling" — it wants the Wayland color-management protocol, which niri lacks)
# but kept so the look arrives the day niri implements it. Was briefly removed
# 2026-08-07 as the suspected yazi held-j corruption; actual culprit was the
# no-status plugin handing the bottom row to sixel previews (see yazi init.lua).
gamma-correct-blending=yes

[scrollback]
lines=10000
# omarchy scroll feel: 7 lines per wheel notch instead of foot's 3.
multiplier=7.0

[mouse]
# macOS behavior: the pointer gets out of the way while typing.
hide-when-typing=yes

[key-bindings]
# Arch parity: Ctrl+Insert/Shift+Insert copy/paste the CLIPBOARD. Shift+Insert
# is freed from its default primary-paste role (selection-target=both puts the
# selection on the clipboard anyway); middle-click primary paste is untouched.
clipboard-copy=Control+Shift+c Control+Insert
clipboard-paste=Control+Shift+v Shift+Insert
primary-paste=none

[text-bindings]
# omarchy's CSI-u escapes so TUIs (Claude Code, tmux) can tell Shift+Return
# and Alt+Shift+Return apart from plain Return.
\x1b[13;2u=Shift+Return
\x1b[13;4u=Mod1+Shift+Return
