# Rendered to ~/.config/foot/foot.ini by bin/theme-apply — do not edit there.
# Only deviations from foot 1.27 defaults live here; everything else (TERM=foot,
# key bindings, url mode, selection→primary — bin/emoji-insert relies on that
# primary paste) is deliberately stock. See foot.ini(5).
[main]
font={{font.mono}}:pixelsize={{font.size}}
include=~/.config/foot/theme.ini

# Server-mode windows default to app-id "footclient"; pin one id so niri rules
# and the shell's icon lookup see the same window either way it was launched.
app-id=foot

# The old Arch config's inset, plus foot's default centering mode (writing a
# pad value without it would drop back to top-left anchoring).
pad=14x14 center-when-maximized-and-fullscreen

# Linear-space blending — how macOS composites text, and why its bright-on-dark
# glyphs read heavier. Inert on niri today (foot logs "gamma-corrected-blending:
# disabling" — it wants the Wayland color-management protocol, which niri lacks)
# but kept so the look arrives the day niri implements it. Was briefly removed
# 2026-08-07 as the suspected yazi held-j corruption; actual culprit was the
# no-status plugin handing the bottom row to sixel previews (see yazi init.lua).
gamma-correct-blending=yes

[scrollback]
lines=10000
# omarchy scroll feel: 7 lines per wheel notch instead of foot's 3.
multiplier=7.0

[mouse]
# macOS behavior: the pointer gets out of the way while typing.
hide-when-typing=yes

[text-bindings]
# omarchy's CSI-u escapes so TUIs (Claude Code, tmux) can tell Shift+Return
# and Alt+Shift+Return apart from plain Return.
\x1b[13;2u=Shift+Return
\x1b[13;4u=Mod1+Shift+Return
