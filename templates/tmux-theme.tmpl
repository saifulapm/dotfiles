# generated by theme-apply — do not edit. Source: templates/tmux-theme.tmpl,
# rendered to ~/.config/tmux/theme.conf and sourced by ~/.tmux.conf.
#
# The status bar's LAYOUT stays in ~/.tmux.conf (lengths, justification,
# separator); everything carrying a color lives here. The three format strings
# are here rather than there because tmux bakes the color into the format
# itself (#[fg=…]) — the two cannot be separated without splitting one string
# across two files.
#
# Ported 2026-08-07 from the mac .tmux.conf's hardcoded tokyo-night literals,
# copied byte-for-byte so the Nerd Font directory glyph in status-right (U+F413,
# verified present in SymbolsNerdFontMono-Regular.ttf) survives the move.
# What each literal became:
#
#   #20212f  both pane borders     → surface.3
#            The mac drew the ACTIVE and inactive borders identically — a
#            deliberately flat look, kept rather than "improved" into an
#            accent-colored active border.
#   #ff7a93  message style and     → accent.error
#            the active-window       The shell's own bar uses accent.error for
#            marker                  its active marker (the [bar] defaults in
#                                    themes/tokyo-night.toml), so tmux's status
#                                    bar now agrees with the desktop bar. On
#                                    tokyo-night that is #f7768e against the
#                                    original #ff7a93 — the theme's red either
#                                    way.
#   #444b6a  status-left/-right    → text.muted

# Pane borders — flat by design: active and inactive are the same color.
set -g pane-active-border-style "fg={{surface.3}}"
set -g pane-border-style "fg={{surface.3}}"

# Messages and the copy-mode indicator.
set -g message-style "fg={{accent.error}},bold"

# Transparent status bar — the terminal's background shows through.
set -g status-style bg=default

# Left: session / window index / pane index.
set -g status-left " #[fg={{text.muted}}]#S #[fg={{text.muted}}]/ #[fg={{text.muted}}]#I #[fg={{text.muted}}]/ #[fg={{text.muted}}]#P"

# Window list: a filled dot for the current window, hollow for the rest.
set -g window-status-current-format "#[fg={{accent.error}}]●"
set -g window-status-format "○"

# Right: the current pane's directory, ~ when it is $HOME.
set -g status-right "#[fg={{text.muted}}]#{?#{==:#{pane_current_path},#{HOME}},~, #{=/-23/…:#{b:pane_current_path}}} "
