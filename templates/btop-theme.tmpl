# generated by theme-apply — do not edit. Port of omarchy default/themed/
# btop.theme.tpl onto our tokens: terminal-family surface.0
# background, selection pair from foot's, ansi palette for the graph ramps.
# Rendered to ~/.config/btop/themes/qshell.theme; theme-apply pins
# color_theme = "qshell" in btop.conf and pokes running btops with SIGUSR2.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="{{surface.0}}"

# Main text color
theme[main_fg]="{{text.primary}}"

# Title color for boxes
theme[title]="{{text.primary}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{accent.accent}}"

# Background color of selected item in processes box
theme[selected_bg]="{{surface.3}}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{accent.accent}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{text.muted}}"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="{{ansi.white}}"

# Background color of the percentage meters
theme[meter_bg]="{{surface.3}}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{ansi.white}}"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="{{ansi.magenta}}"
theme[mem_box]="{{ansi.green}}"
theme[net_box]="{{ansi.red}}"
theme[proc_box]="{{accent.accent}}"

# Box divider line and small boxes line color
theme[div_line]="{{text.muted}}"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="{{ansi.green}}"
theme[temp_mid]="{{ansi.yellow}}"
theme[temp_end]="{{ansi.red}}"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="{{ansi.cyan}}"
theme[cpu_mid]="{{ansi.blue}}"
theme[cpu_end]="{{ansi.magenta}}"

# Mem/Disk free meter
theme[free_start]="{{ansi.magenta}}"
theme[free_mid]="{{ansi.blue}}"
theme[free_end]="{{ansi.cyan}}"

# Mem/Disk cached meter
theme[cached_start]="{{ansi.blue}}"
theme[cached_mid]="{{ansi.cyan}}"
theme[cached_end]="{{ansi.magenta}}"

# Mem/Disk available meter
theme[available_start]="{{ansi.yellow}}"
theme[available_mid]="{{ansi.red}}"
theme[available_end]="{{ansi.red}}"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="{{ansi.green}}"
theme[used_mid]="{{ansi.cyan}}"
theme[used_end]="{{ansi.blue}}"

# Download graph colors
theme[download_start]="{{ansi.yellow}}"
theme[download_mid]="{{ansi.red}}"
theme[download_end]="{{ansi.red}}"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="{{ansi.green}}"
theme[upload_mid]="{{ansi.cyan}}"
theme[upload_end]="{{ansi.blue}}"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="{{ansi.cyan}}"
theme[process_mid]="{{ansi.blue}}"
theme[process_end]="{{ansi.magenta}}"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="{{surface.0}}"
theme[gradient_color_1]="{{surface.2}}"
theme[gradient_color_2]="{{surface.3}}"
theme[gradient_color_3]="{{text.muted}}"
theme[gradient_color_4]="{{ansi.white}}"
theme[gradient_color_5]="{{text.primary}}"
theme[gradient_color_6]="{{ansi.white}}"
theme[gradient_color_7]="{{ansi.bright-white}}"
