# generated by theme-apply — do not edit.
#
# cliamp's entire theme is six hex values (its theme.Theme struct), and
# Validate() REJECTS a partial palette rather than half-applying it — an
# incomplete file is silently ignored and the player stays on whatever it had.
# So all six are always emitted, even where a token would round-trip.
#
# Rendered to ~/.config/cliamp/themes/qshell.toml, which makes the theme name
# "qshell" (cliamp takes the name from the filename). ~/.config/cliamp/config.toml
# pins `theme = "qshell"`, and theme-apply pokes a running player with
# `cliamp theme qshell` — its IPC handler calls theme.LoadAll() before
# applying, so re-sending the same name is exactly what re-reads this file.

# Title, current track name, seek bar, and the selected row in every list.
accent = "{{accent.accent}}"

# Primary text — the time readout and the text inside the help-bar key pills.
bright_fg = "{{text.primary}}"

# Muted text — the help bar, inactive rows, and the pill BACKGROUNDS, which is
# why this has to stay a mid-tone: text.muted reads against both surface.0 and
# text.primary, where surface.3 would swallow the pill labels.
fg = "{{text.muted}}"

# The spectrum analyser's three bands, bottom to top. green also paints the
# playing indicator and the volume bar; red also paints error messages.
#
# The ANSI trio rather than the theme's semantic accent.ok/warn/error: these
# three are a GRADIENT, not three statuses, and every theme here guarantees
# ansi.green/yellow/red are a coherent ramp — which is what makes the LED
# analyser read the way Winamp's did. accent.warn is tuned for legible warning
# text on a surface and would land as a stripe, not a step.
green = "{{ansi.green}}"
yellow = "{{ansi.yellow}}"
red = "{{ansi.red}}"
