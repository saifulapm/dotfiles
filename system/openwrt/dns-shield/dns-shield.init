#!/bin/sh /etc/rc.common
# DNS Shield's Kid resolver: its own dnsmasq, because OpenWrt gives every uci dnsmasq instance the LAN's DHCP.
START=20
USE_PROCD=1
DIR=/etc/dns-shield
RUN=/tmp/dns-shield

allow_conf() {
	mkdir -p "$RUN"
	: >"$RUN/allow.conf"
	[ -f "$DIR/allow" ] || return 0
	while read -r d; do
		[ -n "$d" ] && echo "server=/$d/94.140.14.14" >>"$RUN/allow.conf"
	done <"$DIR/allow"
}

start_service() {
	allow_conf
	touch "$RUN/kid.log"
	chown dnsmasq:dnsmasq "$RUN/kid.log"
	procd_open_instance
	procd_set_param command /usr/sbin/dnsmasq -k -C "$DIR/kid.conf"
	procd_set_param respawn
	procd_close_instance
}

reload_service() {
	stop
	start
}
