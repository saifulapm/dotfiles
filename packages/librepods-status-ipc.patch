+    // One-line JSON snapshot for external consumers (bars, scripts) over the
+    // local control socket. The battery object deliberately matches the shape
+    // raw AAP readers print ({"address","battery":{left|right|case|single:
+    // {level,charging}}}) so a subscriber can drop in where one stood.
+    QByteArray statusJson() const
+    {
+        QJsonObject root;
+        root["address"] = m_deviceInfo->bluetoothAddress().toUpper();
+        root["connected"] = areAirpodsConnected();
+        QJsonObject battery;
+        const Battery *b = m_deviceInfo->getBattery();
+        const auto put = [&](Battery::Component c, const char *name) {
+            const Battery::BatteryState s = b->getState(c);
+            if (s.level == 0 || s.status == Battery::BatteryStatus::Disconnected)
+                return;
+            QJsonObject o;
+            o["level"] = int(s.level);
+            o["charging"] = (s.status == Battery::BatteryStatus::Charging);
+            battery[name] = o;
+        };
+        put(Battery::Component::Left, "left");
+        put(Battery::Component::Right, "right");
+        put(Battery::Component::Case, "case");
+        put(Battery::Component::Headset, "single");
+        root["battery"] = battery;
+        root["noise"] = m_deviceInfo->noiseControlModeInt();
+        QJsonObject ear;
+        ear["primaryInEar"] = m_deviceInfo->getEarDetection()->isPrimaryInEar();
+        ear["secondaryInEar"] = m_deviceInfo->getEarDetection()->isSecondaryInEar();
+        root["ear"] = ear;
+        return QJsonDocument(root).toJson(QJsonDocument::Compact);
+    }
