diff --git a/linux/librepods-ctl.cpp b/linux/librepods-ctl.cpp
index 71c32ce..458998d 100644
--- a/linux/librepods-ctl.cpp
+++ b/linux/librepods-ctl.cpp
@@ -11,7 +11,9 @@ int main(int argc, char *argv[]) {
                             << "  noise:off           Disable noise control\n"
                             << "  noise:anc           Enable Active Noise Cancellation\n"
                             << "  noise:transparency  Enable Transparency mode\n"
-                            << "  noise:adaptive      Enable Adaptive mode\n";
+                            << "  noise:adaptive      Enable Adaptive mode\n"
+                            << "  status              Print one JSON state line and exit\n"
+                            << "  subscribe           Print a JSON state line per change until killed\n";
         return 1;
     }
 
@@ -23,9 +25,23 @@ int main(int argc, char *argv[]) {
         return 1;
     }
 
-    socket.write(QByteArray(argv[1]));
+    const QByteArray cmd(argv[1]);
+    socket.write(cmd);
     socket.flush();
     socket.waitForBytesWritten(200);
+
+    if (cmd == "status" || cmd == "subscribe") {
+        QTextStream out(stdout);
+        // status: one reply line. subscribe: lines until the server goes away.
+        while (socket.waitForReadyRead(cmd == "subscribe" ? -1 : 2000)) {
+            out << socket.readAll();
+            out.flush();
+            if (cmd == "status")
+                break;
+        }
+        return 0;
+    }
+
     socket.disconnectFromServer();
     return 0;
 }
