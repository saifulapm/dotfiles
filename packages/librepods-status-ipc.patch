+                            << "  subscribe           Print a JSON state line per change until killed\n";
+        return 1;
+    }
+
+    // The one path both binaries compute, from ipcpath.hpp.
+    const QString ipcPath = LibrePods::Ipc::socketPath();
+    if (ipcPath.isEmpty()) {
+        QTextStream(stderr) << "XDG_RUNTIME_DIR is unset, so there is no socket path to use\n";
         return 1;
     }
 
     QLocalSocket socket;
-    socket.connectToServer("app_server");
+    socket.connectToServer(ipcPath);
 
     if (!socket.waitForConnected(500)) {
-        QTextStream(stderr) << "Could not connect to librepods (is it running?)\n";
+        QTextStream(stderr) << "Could not connect to librepods at " << ipcPath << " (is it running?)\n";
         return 1;
     }
 
-    socket.write(QByteArray(argv[1]));
+    const QByteArray cmd(argv[1]);
+    socket.write(cmd);
     socket.flush();
     socket.waitForBytesWritten(200);
+
+    if (cmd == "status" || cmd == "subscribe") {
+        QTextStream out(stdout);
+        // status: one reply line. subscribe: lines until the server goes away.
+        while (socket.waitForReadyRead(cmd == "subscribe" ? -1 : 2000)) {
+            out << socket.readAll();
+            out.flush();
+            if (cmd == "status")
+                break;
+        }
+        return 0;
+    }
+
     socket.disconnectFromServer();
     return 0;
 }
