diff --git a/linux/ipcpath.hpp b/linux/ipcpath.hpp
new file mode 100644
index 0000000..eb9bce1
--- /dev/null
+++ b/linux/ipcpath.hpp
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <QtGlobal>
+#include <QByteArray>
+#include <QString>
+
+// Where the daemon's control socket lives, in ONE place because both binaries
+// need it. Two copies of a path string drift, and a drifted socket path fails
+// as "could not connect to librepods (is it running?)" — a message pointing
+// nowhere near the cause.
+//
+// Qt resolves a QLocalServer/QLocalSocket name that does NOT begin with '/'
+// against the temp dir. That is how this channel used to sit at a
+// world-visible /tmp/app_server, where any local user could open it and drive
+// the pods. A name beginning with '/' is taken as a full filesystem path
+// instead, so moving under $XDG_RUNTIME_DIR — /run/user/<uid>, mode 0700 on a
+// systemd session — is a path change and not a protocol change.
+//
+// Empty when XDG_RUNTIME_DIR is unset, and callers must treat that as fatal
+// rather than falling back to /tmp: a fallback would quietly restore the exact
+// thing being removed, and every context that matters here (the graphical
+// session, the shell process drawing the panel) has a runtime dir.
+namespace LibrePods
+{
+    namespace Ipc
+    {
+        inline QString socketPath()
+        {
+            const QByteArray runtimeDir = qgetenv("XDG_RUNTIME_DIR");
+            if (runtimeDir.isEmpty())
+                return QString();
+            return QString::fromLocal8Bit(runtimeDir) + QStringLiteral("/librepods.sock");
+        }
+    }
+}
