                             << "  noise:anc           Enable Active Noise Cancellation\n"
                             << "  noise:transparency  Enable Transparency mode\n"
-                            << "  noise:adaptive      Enable Adaptive mode\n";
+                            << "  noise:adaptive      Enable Adaptive mode\n"
+                            << "  ca:on|off           Conversational awareness (Pro)\n"
+                            << "  onebud:on|off       Keep ANC on with one pod in (Pro)\n"
+                            << "  adaptive:N          Adaptive noise level 0-100; only\n"
