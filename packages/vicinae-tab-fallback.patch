+bool RootSearchModel::activateFirstFallback() {
+  for (int row = 0, rows = rowCount(); row < rows; ++row) {
+    int sourceIdx = -1;
+    int itemIdx = -1;
+    if (!dataItemAt(row, sourceIdx, itemIdx)) continue;
+    if (sources().at(sourceIdx) != m_fallbackSource || itemIdx != 0) continue;
+
+    setSelectedIndex(row);
+    activateSelected();
+    return true;
+  }
+
+  return false;
+}
