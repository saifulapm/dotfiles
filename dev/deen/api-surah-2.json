{"ayahs":[{"a":281,"ar":"وَٱتَّقُوا۟ يَوْمًا تُرْجَعُونَ فِيهِ إِلَى ٱللَّهِ ثُمَّ تُوَفَّىٰ كُلُّ نَفْسٍ مَّا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ","en":"English 2:281","bn":"অর্থ ২:281","bn_pron":"ওয়াত্তাক্বূ ইয়াউমান তুরজা‘ঊনা ফীহি ইলাল্লা-হি সুম্মা তুওয়াফ্ফা- কুল্লু নাফসিম মা- কাসাবাত ওয়াহুম লা- ইউযলামূন","juz":3,"s":2,"taj":[]},{"a":282,"ar":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا تَدَايَنتُم بِدَيْنٍ إِلَىٰٓ أَجَلٍ مُّسَمًّى فَٱكْتُبُوهُ وَلْيَكْتُب بَّيْنَكُمْ كَاتِبٌۢ بِٱلْعَدْلِ وَلَا يَأْبَ كَاتِبٌ أَن يَكْتُبَ كَمَا عَلَّمَهُ ٱللَّهُ فَلْيَكْتُبْ وَلْيُمْلِلِ ٱلَّذِى عَلَيْهِ ٱلْحَقُّ وَلْيَتَّقِ ٱللَّهَ رَبَّهُۥ وَلَا يَبْخَسْ مِنْهُ شَيْـًٔا فَإِن كَانَ ٱلَّذِى عَلَيْهِ ٱلْحَقُّ سَفِيهًا أَوْ ضَعِيفًا أَوْ لَا يَسْتَطِيعُ أَن يُمِلَّ هُوَ فَلْيُمْلِلْ وَلِيُّهُۥ بِٱلْعَدْلِ وَٱسْتَشْهِدُوا۟ شَهِيدَيْنِ مِن رِّجَالِكُمْ فَإِن لَّمْ يَكُونَا رَجُلَيْنِ فَرَجُلٌ وَٱمْرَأَتَانِ مِمَّن تَرْضَوْنَ مِنَ ٱلشُّهَدَآءِ أَن تَضِلَّ إِحْدَىٰهُمَا فَتُذَكِّرَ إِحْدَىٰهُمَا ٱلْأُخْرَىٰ وَلَا يَأْبَ ٱلشُّهَدَآءُ إِذَا مَا دُعُوا۟ وَلَا تَسْـَٔمُوٓا۟ أَن تَكْتُبُوهُ صَغِيرًا أَوْ كَبِيرًا إِلَىٰٓ أَجَلِهِۦ ذَٰلِكُمْ أَقْسَطُ عِندَ ٱللَّهِ وَأَقْوَمُ لِلشَّهَٰدَةِ وَأَدْنَىٰٓ أَلَّا تَرْتَابُوٓا۟ إِلَّآ أَن تَكُونَ تِجَٰرَةً حَاضِرَةً تُدِيرُونَهَا بَيْنَكُمْ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَلَّا تَكْتُبُوهَا وَأَشْهِدُوٓا۟ إِذَا تَبَايَعْتُمْ وَلَا يُضَآرَّ كَاتِبٌ وَلَا شَهِيدٌ وَإِن تَفْعَلُوا۟ فَإِنَّهُۥ فُسُوقٌۢ بِكُمْ وَٱتَّقُوا۟ ٱللَّهَ وَيُعَلِّمُكُمُ ٱللَّهُ وَٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمٌ","en":"English 2:282","bn":"অর্থ ২:282","bn_pron":"ইয়া-’আইয়্যুহাল্লাযীনা আ-মানূ ইযা- তাদা-য়ানতুম বিদাইনিন ইলা- আজালিম মুসাম্মান ফাকতুবূহু ওয়ালইয়াকতুব বাইনাকুম কা-তিবুম বিল‘আদলি ওয়ালা- ইয়া’বা কা-তিবুন আই ইয়াকতুবা কামা- ‘আল্লামাহুল্লা-হু ফালইয়াকতুব ওয়ালইউমলিলিল্লাযী ‘আলাইহিলহাক্ক্বু ওয়ালইয়াত্তাক্বিল্লা-হা রব্বাহূ ওয়ালা- ইয়াবখাস মিনহু শাই’আন ফাইন কা-নাল্লাযী ‘আলাইহিলহাক্ক্বু সাফীহান আউ দা‘ঈফান আউ লা- ইয়াসতাত্বী‘উ আই ইউমিল্লা হুওয়া ফালইউমলিল ওয়ালিয়্যুহূ বিল‘আদলি ওয়াসতাশহিদূ শাহীদাইনি মির রিজা-লিকুম ফাইল লাম ইয়াকূনা- রাজুলাইনি ফারাজুলুউ ওয়ামরা’আতা-নি মিম্মান তারদাউনা মিনাশ্শুহাদা-’ই আন তাদিল্লা ইহদা-হুমা- ফাতুযাক্কিরা ইহদা-হুমাল’উখরা- ওয়ালা- ইয়া’বাশ্শুহাদা-’উ ইযা- মা- দু‘ঊ ওয়ালা- তাস’আমূ আন তাকতুবূহু সাগীরান আউ কাবীরান ইলা- আজালিহী যা-লিকুম আক্বসাত্বু ‘ইনদাল্লা-হি ওয়াআক্বওয়ামু লিশ্শাহা-দাতি ওয়াআদনা- আল্লা- তারতা-বূ ইল্লা- আন তাকূনা তিজা-রাতান হা-দিরাতান তুদীরূনাহা- বাইনাকুম ফালাইসা ‘আলাইকুম জুনা-হুন আল্লা- তাকতুবূহা- ওয়াআশহিদূ ইযা- তাবা-য়া‘তুম ওয়ালা- ইউদা-র্রা কা-তিবুউ ওয়ালা- শাহীদুউ ওয়াইন তাফ‘আলূ ফাইন্নাহূ ফুসূক্বুম বিকুম ওয়াত্তাক্বুল্লা-হা ওয়াইউ‘আল্লিমুকুমুল্লা-হু ওয়াল্লা-হু বিকুল্লি শাই’ইন ‘আলীম","juz":3,"s":2,"taj":[]}],"basmala":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","surah":{"ar":"سُورَةُ البَقَرَةِ","count":286,"en":"Al-Baqara","n":2,"tr":"The Cow","type":"Medinan","bn":"সূরা আল-বাকারা"},"words":[[{"audio":"002_281_001","en":"word 1","bn":"শব্দ 1","i":1,"root":null,"segments":[{"t":"وَٱتَّقُوا۟"}],"text":"وَٱتَّقُوا۟","tr":"","bn_pron":"ওয়াত্তাক্বূ"},{"audio":"002_281_002","en":"word 2","bn":"শব্দ 2","i":2,"root":null,"segments":[{"t":"يَوْمًۭا"}],"text":"يَوْمًۭا","tr":"","bn_pron":"ইয়াউমান"},{"audio":"002_281_003","en":"word 3","bn":"শব্দ 3","i":3,"root":null,"segments":[{"t":"تُرْجَعُونَ"}],"text":"تُرْجَعُونَ","tr":"","bn_pron":"তুরজা‘ঊনা"},{"audio":"002_281_004","en":"word 4","bn":"শব্দ 4","i":4,"root":null,"segments":[{"t":"فِيهِ"}],"text":"فِيهِ","tr":"","bn_pron":"ফীহি"},{"audio":"002_281_005","en":"word 5","bn":"শব্দ 5","i":5,"root":null,"segments":[{"t":"إِلَى"}],"text":"إِلَى","tr":"","bn_pron":"ইলা-"},{"audio":"002_281_006","en":"word 6","bn":"শব্দ 6","i":6,"root":null,"segments":[{"t":"ٱللَّهِ ۖ"}],"text":"ٱللَّهِ ۖ","tr":"","bn_pron":"আল্লা-হি"},{"audio":"002_281_007","en":"word 7","bn":"শব্দ 7","i":7,"root":null,"segments":[{"t":"ثُمَّ"}],"text":"ثُمَّ","tr":"","bn_pron":"সুম্মা"},{"audio":"002_281_008","en":"word 8","bn":"শব্দ 8","i":8,"root":null,"segments":[{"t":"تُوَفَّىٰ"}],