{"ayahs":[{"a":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","bn":"শুরু করছি আল্লাহর নামে যিনি পরম করুণাময়, অতি দয়ালু।","en":"In the name of Allah, the Entirely Merciful, the Especially Merciful.","juz":1,"s":1,"taj":[[7,8,0],[15,16,0],[16,17,1],[24,25,2],[28,29,0],[29,30,1],[35,36,3]]},{"a":2,"ar":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","bn":"যাবতীয় প্রশংসা আল্লাহ তাআলার যিনি সকল সৃষ্টি জগতের পালনকর্তা।","en":"[All] praise is [due] to Allah, Lord of the worlds -","juz":1,"s":1,"taj":[[24,25,0],[29,30,2],[34,35,3]]},{"a":3,"ar":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","bn":"যিনি নিতান্ত মেহেরবান ও দয়ালু।","en":"The Entirely Merciful, the Especially Merciful,","juz":1,"s":1,"taj":[[1,2,1],[9,10,2],[13,14,0],[14,15,1],[20,21,3]]},{"a":4,"ar":"مَٰلِكِ يَوْمِ ٱلدِّينِ","bn":"যিনি বিচার দিনের মালিক।","en":"Sovereign of the Day of Recompense.","juz":1,"s":1,"taj":[[2,3,2],[15,16,0],[16,17,1],[20,21,3]]},{"a":5,"ar":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","bn":"আমরা একমাত্র তোমারই ইবাদত করি এবং শুধুমাত্র তোমারই সাহায্য প্রার্থনা করি।","en":"It is You we worship and You we ask for help.","juz":1,"s":1,"taj":[[37,38,3]]},{"a":6,"ar":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","bn":"আমাদেরকে সরল পথ দেখাও,","en":"Guide us to the straight path -","juz":1,"s":1,"taj":[[9,10,0],[10,11,1],[16,17,2],[20,21,0],[31,32,3]]},{"a":7,"ar":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","bn":"সে সমস্ত লোকের পথ, যাদেরকে তুমি নেয়ামত দান করেছ। তাদের পথ নয়, যাদের প্রতি তোমার গজব নাযিল হয়েছে এবং যারা পথভ্রষ্ট হয়েছে।","en":"The path of those upon whom You have bestowed favor, not of those who have evoked [Your] anger or of those who are astray.","juz":1,"s":1,"taj":[[4,5,2],[8,9,0],[47,48,0],[77,78,0],[78,79,1],[82,84,4],[87,88,3]]}],"basmala":"","surah":{"ar":"سُورَةُ ٱلْفَاتِحَةِ","count":7,"en":"Al-Faatiha","n":1,"tr":"The Opening","type":"Meccan"},"words":[[{"audio":"001_001_001","en":"In (the) name","i":1,"root":"س م و","segments":[{"t":"بِسْمِ"}],"text":"بِ