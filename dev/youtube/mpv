#!/usr/bin/env bash
# The YouTube nested checks' mpv: logs the command line it is given to DOTS_DEV_DIR/youtube-mpv.log, then opens dev/fake-mpv.qml's window titled with the URL, which ends when that window closes, as mpv does.
printf '%s\n' "$*" >>"$DOTS_DEV_DIR/youtube-mpv.log"
FAKE_MPV_TITLE=${*: -1} exec env -u QS_CONFIG_PATH qs -p "$(dirname "$(realpath "$0")")/../fake-mpv.qml"
