#!/usr/bin/env bash
# ~/.claude/settings.json — a modify_ script rather than a plain source file,
# for the reason spelled out in home/dot_pi/agent/modify_settings.json: this
# repo applies in symlink mode, and Claude Code writes to this file. `/config`
# writes theme, `/plugin` writes enabledPlugins, `/permissions` appends allow
# rules. As a symlink into ~/.dotfiles every one of those left the repo dirty —
# and it is exactly why run_after_45-amx.sh refuses to run `amx doctor --fix`,
# which would write amx's seven hooks straight through the symlink into the
# source tree. That refusal can be revisited now: a --fix lands on a real file.
#
# chezmoi writes a real file for a modify_ script and feeds the current one in
# on stdin, so Claude owns the file day to day and this owns the keys below.
# Anything Claude adds that is not named here survives apply untouched.
#
# The trade is that this config can no longer be edited live: edit here, then
# `chezmoi apply`.
set -euo pipefail

managed=$(
  cat <<'JSON'
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "skillListingBudgetFraction": 0.02,
  "env": {
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "WORKFLOW_AGENT": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false,
    "commitTrailers": false
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(ls:*)",
      "Bash(mem:*)",
      "Bash(workflow:*)",
      "Bash(amx:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release list:*)",
      "Bash(redis-cli:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)"
    ],
    "defaultMode": "auto"
  },
  "fallbackModel": [
    "opus"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mem context || true"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mem context --brief --hook-json --session-id \"$CLAUDE_CODE_SESSION_ID\" || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mem precompact --hook-json || true"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      "vendor"
    ],
    "baseRef": "fresh"
  },
  "disableAgentView": true,
  "disableRemoteControl": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py",
    "refreshInterval": 10
  },
  "extraKnownMarketplaces": {
    "amx": {
      "source": {
        "source": "github",
        "repo": "saifulapm/amx"
      }
    }
  },
  "sandbox": {
    "enabled": false
  },
  "spinnerTipsEnabled": false,
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "prefersReducedMotion": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:qshell",
  "enabledPlugins": {
    "amx@amx": true
  }
}
JSON
)

# Empty stdin is a machine where Claude has never run, so merge onto {}.
current=$(cat)
[ -n "$current" ] || current='{}'

# `*` is jq's recursive object merge: nested objects combine, scalars and
# arrays are replaced outright by the right-hand side.
printf '%s' "$current" | jq --argjson managed "$managed" '. * $managed'
