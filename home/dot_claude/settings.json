{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "commitTrailers": false,
    "pr": "",
    "sessionUrl": false
  },
  "cleanupPeriodDays": 90,
  "effortLevel": "xhigh",
  "enabledPlugins": {},
  "env": {
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "WORKFLOW_AGENT": "1"
  },
  "extraKnownMarketplaces": {
    "focus": {
      "source": {
        "repo": "saifulapm/focus",
        "source": "github"
      }
    }
  },
  "fallbackModel": [
    "opus"
  ],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "/home/saiful/.cargo/bin/amx _hook",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "command": "/home/saiful/.cargo/bin/amx _hook",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "/home/saiful/.cargo/bin/amx _hook",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/home/saiful/.cargo/bin/amx _hook",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/home/saiful/.cargo/bin/amx _hook",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/home/saiful/.cargo/bin/amx _hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/home/saiful/.cargo/bin/amx _hook",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "haiku",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh release list:*)",
      "Bash(redis-cli:*)"
    ],
    "defaultMode": "auto"
  },
  "sandbox": {
    "enabled": false
  },
  "skillListingBudgetFraction": 0.02,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "~/.claude/statusline.py",
    "refreshInterval": 10,
    "type": "command"
  },
  "theme": "custom:qshell",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "none",
    "symlinkDirectories": [
      "node_modules",
      "vendor"
    ]
  }
}
