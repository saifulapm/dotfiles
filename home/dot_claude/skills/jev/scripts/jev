#!/usr/bin/env python3
"""jev — decide about what is on screen without reading it into context.

Every subcommand turns one surface into text, hands it to `pxy ask` (Typesafe's
Jev, through pxy's [media] systemone chain) with a typed question, and prints
the answer alone. A 25 KB page snapshot costs about $0.0005 to judge this way
and never enters the agent's context.

  jev pick  <intent> [-s SESSION] [--grep RE]   a ref on the live playwright page
  jev check <claim>  [-s SESSION]               judge the live playwright page
  jev gui   <app> <intent> [--grep RE]          a widget name, over the a11y bus
  jev pane  <session> <claim>                   judge a tmux pane, selection marked
  jev guard <action> --asked <request>          before you press: is this safe?
            (--pane S | --page [-s S] | --context F)

Common: --min P (answer only above this probability) · --margin D (pick/gui:
abstain when the winner leads by less than D) · --json (the whole answer).

Exit codes are `pxy ask`'s: 0 answered, 1 error, 2 the claim is not true,
3 abstained — too close to call, or the target is not on this screen. Treat 3
as "look yourself", never as "no".

Jev cannot see. It reads the text these subcommands produce, so a question
about colour, layout or anything absent from the a11y tree needs a screenshot
instead. It cannot count or do arithmetic either: check totals in code.

To drive a whole goal rather than answer one question, see `browse`.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _jev  # noqa: E402
from _jev import PANE_LEGEND, cap, describe, die, page, page_elements  # noqa: E402
from _jev import ask_many, need_pxy, page_text, pane_text, trim  # noqa: E402

# fka.dev's computer-use thresholds, which the recorded Jev runs agree with: a
# standard action wants a clear winner, an assertion wants better than a coin
# flip. Overridable per call — tune on false negatives before false positives.
MIN_PICK = 0.55
MARGIN_PICK = 0.15
MIN_CLAIM = 0.70

GUI = Path.home() / ".claude/skills/desktop/scripts/gui"
GUI_LINE = re.compile(r"^\s*(\S+(?: \S+)?)\s+'([^']*)'(.*)$")


def ask(verb, instructions, state, criteria=None, min_p=None, margin=None, as_json=False):
    """Shell out to `pxy ask`, which owns the thresholds and the exit codes.

    Returns (exit code, stdout). Stderr is forwarded as it is: that is where
    pxy says why it abstained, and the caller should see it either way.
    """
    need_pxy()
    state = trim(state)
    scratch = []
    try:
        handle = tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False)
        handle.write(state)
        handle.close()
        scratch.append(handle.name)
        cmd = ["pxy", "ask", verb, instructions, "--state-file", handle.name]
        if criteria is not None:
            opts = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False)
            json.dump(criteria, opts)
            opts.close()
            scratch.append(opts.name)
            cmd += ["--options-file", opts.name]
        if min_p is not None:
            cmd += ["--min", str(min_p)]
        if margin is not None:
            cmd += ["--margin", str(margin)]
        if as_json:
            cmd.append("--json")
        p = subprocess.run(cmd, capture_output=True, text=True)
        if p.stderr:
            sys.stderr.write(p.stderr)
        return p.returncode, p.stdout
    finally:
        for path in scratch:
            os.unlink(path)


# ----------------------------------------------------------------------- gui


def gui_widgets(app):
    """Named widgets from the a11y bus, as {w<n>: describe-line}."""
    if not GUI.exists():
        die(f"{GUI} is missing — the desktop skill provides it")
    widgets = {}
    for i, line in enumerate(_jev.run([str(GUI), "tree", app]).splitlines(), 1):
        m = GUI_LINE.match(line)
        if m and m.group(2):
            widgets[f"w{i}"] = f"{m.group(1)} '{m.group(2)}'{m.group(3)}".strip()[:120]
    if not widgets:
        die(f"no named widgets on the a11y bus for {app!r} — try `gui apps`")
    return widgets


def widget_name(description):
    m = re.search(r"'([^']*)'", description)
    return m.group(1) if m else None


# --------------------------------------------------------------------- guard

# The gate, in the shape fka.dev's computer-use loop uses: a low bar to call
# something consequential (erring toward caution), a high bar to call it
# authorised. An action that cannot be undone has to clear both.
CONSEQUENTIAL = 0.35
TARGET_SURE = 0.85
AUTHORISED = 0.85
TARGET_ORDINARY = 0.55

GUARD_QUESTIONS = {
    "consequential": {
        "type": "noul",
        "instructions": (
            "Carrying out the stated action now would have a material effect that "
            "is hard or impossible to undo — sending, paying, ordering, deleting, "
            "overwriting, submitting, changing a system or network setting, or "
            "ending the session."
        ),
    },
    "target_matches": {
        "type": "noul",
        "instructions": (
            "The thing that would actually receive the action — the highlighted "
            "row, the focused field, the named element — is the same thing the "
            "stated action says it is aimed at."
        ),
    },
    "authorised": {
        "type": "noul",
        "instructions": (
            "The user's request, quoted in the state, actually asks for this "
            "specific action. Answer no if the action goes beyond what was asked, "
            "even when it seems helpful or follows naturally from it."
        ),
    },
}


def guard(action, asked, surface):
    state = (
        f"The user asked for:\n{asked}\n\n"
        f"The action about to be carried out:\n{action}\n\n"
        f"The surface it would act on:\n{surface}"
    )
    a = ask_many(state, GUARD_QUESTIONS)
    p = {k: a[k]["noul"] for k in GUARD_QUESTIONS}
    verdict = (
        f"consequential={p['consequential']:.2f} "
        f"target_matches={p['target_matches']:.2f} "
        f"authorised={p['authorised']:.2f}"
    )

    stop = []
    if p["consequential"] >= CONSEQUENTIAL:
        if p["authorised"] < AUTHORISED:
            stop.append("this was not clearly asked for and cannot be undone")
        if p["target_matches"] < TARGET_SURE:
            stop.append("the target is not certain enough for an irreversible action")
    elif p["target_matches"] < TARGET_ORDINARY:
        stop.append("the action would land on something other than its stated target")

    if stop:
        print(f"jev guard: STOP — {'; '.join(stop)} ({verdict})", file=sys.stderr)
        return 3
    print(f"jev guard: proceed ({verdict})", file=sys.stderr)
    return 0


# ---------------------------------------------------------------------- main


def build_parser():
    ap = argparse.ArgumentParser(prog="jev", add_help=False)
    ap.add_argument("-h", "--help", action="store_true")
    sub = ap.add_subparsers(dest="cmd")

    def thresholds(p, min_default, with_margin):
        p.add_argument("--min", type=float, default=min_default)
        if with_margin:
            p.add_argument("--margin", type=float, default=MARGIN_PICK)
        p.add_argument("--json", action="store_true")

    p = sub.add_parser("pick", add_help=False)
    p.add_argument("intent")
    p.add_argument("-s", "--session")
    p.add_argument("--grep")
    thresholds(p, MIN_PICK, True)

    p = sub.add_parser("check", add_help=False)
    p.add_argument("claim")
    p.add_argument("-s", "--session")
    thresholds(p, MIN_CLAIM, False)

    p = sub.add_parser("gui", add_help=False)
    p.add_argument("app")
    p.add_argument("intent")
    p.add_argument("--grep")
    thresholds(p, MIN_PICK, True)

    p = sub.add_parser("pane", add_help=False)
    p.add_argument("session")
    p.add_argument("claim")
    thresholds(p, MIN_CLAIM, False)

    p = sub.add_parser("guard", add_help=False)
    p.add_argument("action")
    p.add_argument("--asked", required=True, help="what the user actually asked for")
    p.add_argument("--pane", help="judge against this tmux pane")
    p.add_argument("--page", action="store_true", help="judge against the live page")
    p.add_argument("-s", "--session")
    p.add_argument("--context", help="judge against this file")

    return ap


def main(argv):
    ap = build_parser()
    args, unknown = ap.parse_known_args(argv)
    if args.help or not args.cmd:
        print(__doc__.strip())
        return 0
    if unknown:
        die(f"unknown argument {unknown[0]!r} — `jev --help` lists them")

    if args.cmd == "pick":
        criteria = cap(describe(page_elements(args.session)), args.grep)
        # The candidates travel as the options, so the state is only what says
        # which page they are on — listing them twice would double the tokens
        # and tell Jev nothing it is not already reading.
        code, out = ask(
            "pick", args.intent, page(args.session, "eval", _jev.PAGE_WHERE, expect=True),
            criteria, args.min, args.margin, args.json,
        )
        sys.stdout.write(out)
        return code

    if args.cmd == "check":
        code, out = ask(
            "check", args.claim, page_text(args.session), None, args.min, None, args.json
        )
        sys.stdout.write(out)
        return code

    if args.cmd == "gui":
        widgets = gui_widgets(args.app)
        code, out = ask(
            "pick", args.intent, f"The open windows of the {args.app!r} application.",
            cap(widgets, args.grep), args.min, args.margin, True,
        )
        if code != 0:
            return code
        answer = json.loads(out)
        description = widgets[answer["choice"]]
        # `gui click` takes a name, so that is what this prints; the rest of
        # the line goes to stderr, where the coordinates and state flags are
        # there to read without getting in the way of `$(jev gui …)`.
        name = widget_name(description)
        print(description, file=sys.stderr)
        if args.json:
            sys.stdout.write(out)
            return 0
        if name is None:
            die(f"the chosen widget has no name to click by: {description}")
        twins = [d for d in widgets.values() if widget_name(d) == name]
        if len(twins) > 1:
            print(
                f"jev: {len(twins)} widgets are named {name!r} — `gui click` takes "
                "the first; click by coordinates instead if that is the wrong one",
                file=sys.stderr,
            )
        print(name)
        return 0

    if args.cmd == "pane":
        state = PANE_LEGEND + pane_text(args.session)
        code, out = ask("check", args.claim, state, None, args.min, None, args.json)
        sys.stdout.write(out)
        return code

    if args.cmd == "guard":
        chosen = [bool(args.pane), args.page, bool(args.context)]
        if sum(chosen) != 1:
            die("guard needs exactly one of --pane, --page or --context")
        if args.pane:
            surface = PANE_LEGEND + pane_text(args.pane)
        elif args.page:
            surface = page_text(args.session)
        else:
            try:
                surface = Path(args.context).read_text()
            except OSError as e:
                die(f"reading {args.context}: {e}")
        return guard(args.action, args.asked, surface)

    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
