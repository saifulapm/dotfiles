#!/usr/bin/env python3
"""jev — decide about what is on screen without reading it into context.

Every subcommand turns one surface into text, hands it to `pxy ask` (Typesafe's
Jev, through pxy's [media] systemone chain) with a typed question, and prints
the answer alone. A 25 KB page snapshot costs about $0.0005 to judge this way
and never enters the agent's context.

  jev pick  <intent> [-s SESSION] [--grep RE]   a ref on the live playwright page
  jev check <claim>  [-s SESSION]               judge the live playwright page
  jev gui   <app> <intent> [--grep RE]          a widget name, over the a11y bus
  jev pane  <session> <claim>                   judge a tmux pane, selection marked
  jev guard <action> --asked <request>          before you press: is this safe?
            (--pane S | --page [-s S] | --context F)

Common: --min P (answer only above this probability) · --margin D (pick/gui:
abstain when the winner leads by less than D) · --json (the whole answer).

Exit codes are `pxy ask`'s: 0 answered, 1 error, 2 the claim is not true,
3 abstained — too close to call, or the target is not on this screen. Treat 3
as "look yourself", never as "no".

Jev cannot see. It reads the text these subcommands produce, so a question
about colour, layout or anything absent from the a11y tree needs a screenshot
instead. It cannot count or do arithmetic either: check totals in code.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# fka.dev's computer-use thresholds, which the recorded Jev runs agree with: a
# standard action wants a clear winner, an assertion wants better than a coin
# flip. Overridable per call — tune on false negatives before false positives.
MIN_PICK = 0.55
MARGIN_PICK = 0.15
MIN_CLAIM = 0.70

# Jev caps a choice at 255 options and `pxy ask pick` spends one of them on
# `none_of_these`, so 254 is what a caller may fill.
MAX_OPTIONS = 254
# Typesafe documents 64k tokens for the state and questions together, but the
# gateway pxy reaches answers `max_tokens_exceeded` above ~32,768 (measured
# 2026-09-22: 125,000 chars of page text went through as 32,539 tokens, 129,643
# did not). Accessibility markup is the densest thing sent here at 2.29
# chars/token, so this stays under that ceiling even at its worst.
MAX_STATE = 70_000

GUI = Path.home() / ".claude/skills/desktop/scripts/gui"

# Roles worth offering as a target. A page snapshot is mostly generics and
# containers, and every one of them on the list is one more way to be wrong.
PAGE_ROLES = (
    "button|link|textbox|searchbox|combobox|checkbox|radio|menuitem|"
    "option|tab|slider|spinbutton|switch"
)
PAGE_REF = re.compile(rf"^\s*-\s+({PAGE_ROLES})\b(.*?)\[ref=([A-Za-z0-9]+)\]")
GUI_LINE = re.compile(r"^\s*(\S+(?: \S+)?)\s+'([^']*)'(.*)$")

SGR = re.compile(r"\x1b\[([0-9;]*)m")
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def die(msg):
    print(f"jev: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd):
    """Run a command, returning stdout; die with its stderr if it fails."""
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0:
        die(f"{cmd[0]} failed: {(p.stderr or p.stdout).strip()}")
    return p.stdout


def trim(state):
    if len(state) <= MAX_STATE:
        return state
    # The head is kept, so anything below the fold is not being judged.
    print(
        f"jev: state trimmed to the first {MAX_STATE:,} of {len(state):,} chars "
        "(the gateway's token ceiling) — the answer does not account for the rest",
        file=sys.stderr,
    )
    return state[:MAX_STATE]


def need_pxy():
    if not shutil.which("pxy"):
        die("pxy is not on PATH — the systemone chain lives there")


def ask(verb, instructions, state, criteria=None, min_p=None, margin=None, as_json=False):
    """Shell out to `pxy ask`, which owns the thresholds and the exit codes.

    Returns (exit code, stdout). Stderr is forwarded as it is: that is where
    pxy says why it abstained, and the caller should see it either way.
    """
    need_pxy()
    state = trim(state)
    scratch = []
    try:
        handle = tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False)
        handle.write(state)
        handle.close()
        scratch.append(handle.name)
        cmd = ["pxy", "ask", verb, instructions, "--state-file", handle.name]
        if criteria is not None:
            opts = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False)
            json.dump(criteria, opts)
            opts.close()
            scratch.append(opts.name)
            cmd += ["--options-file", opts.name]
        if min_p is not None:
            cmd += ["--min", str(min_p)]
        if margin is not None:
            cmd += ["--margin", str(margin)]
        if as_json:
            cmd.append("--json")
        p = subprocess.run(cmd, capture_output=True, text=True)
        if p.stderr:
            sys.stderr.write(p.stderr)
        return p.returncode, p.stdout
    finally:
        for path in scratch:
            os.unlink(path)


def ask_many(state, questions):
    """Several questions about one state, in one call.

    Jev answers every question in a request in parallel, so the questions are
    nearly free and the round trip is not: asking three separately would cost
    three times the latency and tell us the same thing.
    """
    need_pxy()
    body = {"model": "auto", "state": trim(state), "questions": questions}
    p = subprocess.run(
        ["pxy", "ask", "raw"], input=json.dumps(body), capture_output=True, text=True
    )
    if p.returncode != 0:
        die(f"pxy ask raw failed: {(p.stderr or p.stdout).strip()}")
    return json.loads(p.stdout)


# The gate, in the shape fka.dev's computer-use loop uses: a low bar to call
# something consequential (erring toward caution), a high bar to call it
# authorised. An action that cannot be undone has to clear both.
CONSEQUENTIAL = 0.35
TARGET_SURE = 0.85
AUTHORISED = 0.85
TARGET_ORDINARY = 0.55

GUARD_QUESTIONS = {
    "consequential": {
        "type": "noul",
        "instructions": (
            "Carrying out the stated action now would have a material effect that "
            "is hard or impossible to undo — sending, paying, ordering, deleting, "
            "overwriting, submitting, changing a system or network setting, or "
            "ending the session."
        ),
    },
    "target_matches": {
        "type": "noul",
        "instructions": (
            "The thing that would actually receive the action — the highlighted "
            "row, the focused field, the named element — is the same thing the "
            "stated action says it is aimed at."
        ),
    },
    "authorised": {
        "type": "noul",
        "instructions": (
            "The user's request, quoted in the state, actually asks for this "
            "specific action. Answer no if the action goes beyond what was asked, "
            "even when it seems helpful or follows naturally from it."
        ),
    },
}


def guard(action, asked, surface):
    state = (
        f"The user asked for:\n{asked}\n\n"
        f"The action about to be carried out:\n{action}\n\n"
        f"The surface it would act on:\n{surface}"
    )
    a = ask_many(state, GUARD_QUESTIONS)
    p = {k: a[k]["noul"] for k in GUARD_QUESTIONS}
    verdict = (
        f"consequential={p['consequential']:.2f} "
        f"target_matches={p['target_matches']:.2f} "
        f"authorised={p['authorised']:.2f}"
    )

    stop = []
    if p["consequential"] >= CONSEQUENTIAL:
        if p["authorised"] < AUTHORISED:
            stop.append("this was not clearly asked for and cannot be undone")
        if p["target_matches"] < TARGET_SURE:
            stop.append("the target is not certain enough for an irreversible action")
    elif p["target_matches"] < TARGET_ORDINARY:
        stop.append("the action would land on something other than its stated target")

    if stop:
        print(f"jev guard: STOP — {'; '.join(stop)} ({verdict})", file=sys.stderr)
        return 3
    print(f"jev guard: proceed ({verdict})", file=sys.stderr)
    return 0


def cap(criteria, grep):
    """Narrow the candidate set to something Jev will accept.

    Over the cap this refuses rather than keeping the first 254. Dropping
    candidates silently is the one failure `none_of_these` cannot catch: a
    target Jev was never shown cannot be reported missing, so the answer comes
    back confident and wrong.
    """
    if grep:
        pattern = re.compile(grep, re.I)
        criteria = {k: v for k, v in criteria.items() if pattern.search(v)}
        if not criteria:
            die(f"no candidate matched --grep {grep!r} — widen it, or drop it")
    if not criteria:
        die("no interactive candidates on this surface")
    if len(criteria) > MAX_OPTIONS:
        die(
            f"{len(criteria)} candidates, and Jev takes {MAX_OPTIONS} — narrow them "
            "with --grep (it matches the role and label, case-insensitively), or "
            "use `playwright-cli find` to locate the target directly"
        )
    return criteria


# ---------------------------------------------------------------- playwright


def page(session, *args):
    cmd = ["playwright-cli"]
    if session:
        cmd.append(f"--s={session}")
    out = run(cmd + ["--raw", *args])
    if not out.strip():
        die("the page is empty — is a playwright session open?")
    return out


def page_refs(session):
    """Every interactive ref, as {ref: "role label"}.

    The element table is the state as well as the options: a real page's
    snapshot runs past a megabyte (Wikipedia: 1.18 MB, 3,621 refs), so sending
    the whole tree would blow the token budget on markup nobody asked about.
    """
    found = {}
    for line in page(session, "snapshot").splitlines():
        m = PAGE_REF.match(line)
        if not m:
            continue
        label = m.group(2).strip().strip(":").strip() or "(no label)"
        found[m.group(3)] = f"{m.group(1)} {label}"[:120]
    return found


PAGE_WHERE = "JSON.stringify({url: location.href, title: document.title})"


def page_text(session):
    """What the page says, which is what a claim about it is usually about.

    Five times smaller than the accessibility tree and better prose, so more
    of the page survives the token budget. The cost is that control state
    (disabled, checked, focused) is not in it — assert those over `jev pick
    --json` or by reading the snapshot.
    """
    return page(session, "eval", "document.body.innerText")


# ----------------------------------------------------------------------- gui


def gui_widgets(app):
    """Named widgets from the a11y bus, as {w<n>: describe-line}."""
    if not GUI.exists():
        die(f"{GUI} is missing — the desktop skill provides it")
    widgets = {}
    for i, line in enumerate(run([str(GUI), "tree", app]).splitlines(), 1):
        m = GUI_LINE.match(line)
        if m and m.group(2):
            widgets[f"w{i}"] = f"{m.group(1)} '{m.group(2)}'{m.group(3)}".strip()[:120]
    if not widgets:
        die(f"no named widgets on the a11y bus for {app!r} — try `gui apps`")
    return widgets


def widget_name(description):
    m = re.search(r"'([^']*)'", description)
    return m.group(1) if m else None


# ---------------------------------------------------------------------- tmux


def pane_text(session):
    """A pane as text, with the highlighted run marked.

    `capture-pane -p` strips colour, so the selection becomes invisible and a
    question about it cannot be answered at all. `-e` keeps it, but as escape
    codes. Turning reverse-video into a marker is deterministic, so it happens
    here rather than being left for the model to infer.
    """
    p = subprocess.run(
        ["tmux", "capture-pane", "-p", "-e", "-t", session],
        capture_output=True,
        text=True,
    )
    if p.returncode != 0:
        die(f"no such tmux pane {session!r}: {p.stderr.strip()}")

    lines = []
    for line in p.stdout.splitlines():
        buf, reverse, pos = [], False, 0
        for m in SGR.finditer(line):
            buf.append(line[pos : m.start()])
            codes = [c for c in m.group(1).split(";") if c] or ["0"]
            now = reverse
            for code in codes:
                if code == "7":
                    now = True
                elif code in ("0", "27"):
                    now = False
            if now != reverse:
                buf.append("»" if now else "«")
                reverse = now
            pos = m.end()
        buf.append(line[pos:])
        if reverse:
            buf.append("«")
        lines.append(ANSI.sub("", "".join(buf)))
    return "\n".join(lines)


PANE_LEGEND = (
    "A terminal pane follows. Text between » and « is what the terminal is "
    "highlighting — the current selection. If no » appears anywhere, nothing "
    "is selected.\n\n"
)


# ---------------------------------------------------------------------- main


def build_parser():
    ap = argparse.ArgumentParser(prog="jev", add_help=False)
    ap.add_argument("-h", "--help", action="store_true")
    sub = ap.add_subparsers(dest="cmd")

    def thresholds(p, min_default, with_margin):
        p.add_argument("--min", type=float, default=min_default)
        if with_margin:
            p.add_argument("--margin", type=float, default=MARGIN_PICK)
        p.add_argument("--json", action="store_true")

    p = sub.add_parser("pick", add_help=False)
    p.add_argument("intent")
    p.add_argument("-s", "--session")
    p.add_argument("--grep")
    thresholds(p, MIN_PICK, True)

    p = sub.add_parser("check", add_help=False)
    p.add_argument("claim")
    p.add_argument("-s", "--session")
    thresholds(p, MIN_CLAIM, False)

    p = sub.add_parser("gui", add_help=False)
    p.add_argument("app")
    p.add_argument("intent")
    p.add_argument("--grep")
    thresholds(p, MIN_PICK, True)

    p = sub.add_parser("pane", add_help=False)
    p.add_argument("session")
    p.add_argument("claim")
    thresholds(p, MIN_CLAIM, False)

    p = sub.add_parser("guard", add_help=False)
    p.add_argument("action")
    p.add_argument("--asked", required=True, help="what the user actually asked for")
    p.add_argument("--pane", help="judge against this tmux pane")
    p.add_argument("--page", action="store_true", help="judge against the live page")
    p.add_argument("-s", "--session")
    p.add_argument("--context", help="judge against this file")

    return ap


def main(argv):
    ap = build_parser()
    args, unknown = ap.parse_known_args(argv)
    if args.help or not args.cmd:
        print(__doc__.strip())
        return 0
    if unknown:
        die(f"unknown argument {unknown[0]!r} — `jev --help` lists them")

    if args.cmd == "pick":
        criteria = cap(page_refs(args.session), args.grep)
        # The candidates travel as the options, so the state is only what says
        # which page they are on — listing them twice would double the tokens
        # and tell Jev nothing it is not already reading.
        code, out = ask(
            "pick", args.intent, page(args.session, "eval", PAGE_WHERE),
            criteria, args.min, args.margin, args.json,
        )
        sys.stdout.write(out)
        return code

    if args.cmd == "check":
        code, out = ask(
            "check", args.claim, page_text(args.session), None, args.min, None, args.json
        )
        sys.stdout.write(out)
        return code

    if args.cmd == "gui":
        widgets = gui_widgets(args.app)
        code, out = ask(
            "pick", args.intent, f"The open windows of the {args.app!r} application.",
            cap(widgets, args.grep), args.min, args.margin, True,
        )
        if code != 0:
            return code
        answer = json.loads(out)
        description = widgets[answer["choice"]]
        # `gui click` takes a name, so that is what this prints; the rest of
        # the line goes to stderr, where the coordinates and state flags are
        # there to read without getting in the way of `$(jev gui …)`.
        name = widget_name(description)
        print(description, file=sys.stderr)
        if args.json:
            sys.stdout.write(out)
            return 0
        if name is None:
            die(f"the chosen widget has no name to click by: {description}")
        twins = [d for d in widgets.values() if widget_name(d) == name]
        if len(twins) > 1:
            print(
                f"jev: {len(twins)} widgets are named {name!r} — `gui click` takes "
                "the first; click by coordinates instead if that is the wrong one",
                file=sys.stderr,
            )
        print(name)
        return 0

    if args.cmd == "pane":
        state = PANE_LEGEND + pane_text(args.session)
        code, out = ask("check", args.claim, state, None, args.min, None, args.json)
        sys.stdout.write(out)
        return code

    if args.cmd == "guard":
        chosen = [bool(args.pane), args.page, bool(args.context)]
        if sum(chosen) != 1:
            die("guard needs exactly one of --pane, --page or --context")
        if args.pane:
            surface = PANE_LEGEND + pane_text(args.pane)
        elif args.page:
            surface = page_text(args.session)
        else:
            try:
                surface = Path(args.context).read_text()
            except OSError as e:
                die(f"reading {args.context}: {e}")
        return guard(args.action, args.asked, surface)

    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
