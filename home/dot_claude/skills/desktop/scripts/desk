#!/usr/bin/env python3
"""desk — the desktop skill's record of agent windows, shared by screen, mouse and gui.

  desk launch CMD...     start CMD through niri; its windows in the next 5 s are agent windows
  desk window [ID]       the window's JSON with "agent", the focused one without ID; exit 4 if none
  desk acted ID          note an agent action in window ID, if it is an agent window
  desk journal TOOL RC MS WINDOW ARG...   the journal line for one action
  desk watch             the watcher itself, started by the others
  desk doctor            whether an agent can drive this desktop now: JSON, exit 1 with blockers
  desk wait COND [--timeout S]   until COND holds on niri's event stream; exit 1 at the timeout

A window is an agent window when it opens within 5 s after a launch, or
after an agent action in an agent window (a Save As dialog). One watcher per
niri reads its event stream and decides that the moment a window opens, from
the times the scripts noted just before acting, so no command waits 5 s. The
state is $XDG_RUNTIME_DIR/desk/<NIRI_SOCKET basename>/, so a nested niri and
the live one never share agent windows; it goes when that niri does.

Every action and refusal is one NDJSON line in
$XDG_STATE_HOME/dots/agent-journal.ndjson: ts, tool, args, outcome, ms and
the window seen. Typed text is kept as its length and sha256, never as the
text, and the day's first line prunes those older than 30 days.
"""

import datetime
import fcntl
import hashlib
import json
import os
import re
import select
import shutil
import subprocess
import sys
import time

WINDOW_MS = 5000
KEEP_DAYS = 30
OUTCOMES = {0: "ok", 3: "refused", 4: "nothing"}
WAIT_S, WAIT_MAX_S = 10, 60
# The kinds niri replays on connect that a wait reads; once all three are in, the state is whole.
REPLAY = {"WindowsChanged", "WorkspacesChanged", "OverviewOpenedOrClosed"}
WAIT_USAGE = "wait window-open --app ID | window-closed --id N | focus --id N | title --id N --matches RE | workspace N | overview open|closed [--timeout S]"
TOOLS = ("grim", "wtype", "dots-pointer", "ydotoold", "tesseract")
# The first blocker's way out; a tool the skill does not call (ydotoold, tesseract) blocks nothing.
NEXT = {
    "niri": "run inside the niri session, or source the env bin/dots-dev prints",
    "locked": "dots-call lock unlock claude 120",
    "grim": "dots install",
    "wtype": "dots install",
    "dots-pointer": "chezmoi apply (it builds ~/.local/bin/dots-pointer)",
    "at-spi": "systemctl --user restart at-spi-dbus-bus.service",
}


def die(msg, code=1):
    print(f"desk: {msg}", file=sys.stderr)
    sys.exit(code)


def state_dir():
    sock = os.environ.get("NIRI_SOCKET")
    if not sock:
        die("NIRI_SOCKET is not set")
    run = os.environ.get("XDG_RUNTIME_DIR") or die("XDG_RUNTIME_DIR is not set")
    return os.path.join(run, "desk", os.path.basename(sock))


def now_ms():
    return int(time.time() * 1000)


def write_json(path, value):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(value, f)
    os.replace(tmp, path)


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def note(kind, extra=""):
    """Appends a launch or an action time; the watcher reads them when a window opens."""
    d = state_dir()
    os.makedirs(d, mode=0o700, exist_ok=True)
    with open(os.path.join(d, "times"), "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(f"{kind} {now_ms()} {extra}\n")


def recent_times(d, opened):
    try:
        with open(os.path.join(d, "times")) as f:
            lines = f.read().split("\n")
    except OSError:
        return []
    out = []
    for line in lines:
        parts = line.split()
        if len(parts) >= 2 and parts[1].isdigit():
            out.append(int(parts[1]))
    return [t for t in out if t <= opened <= t + WINDOW_MS]


def prune_times(d):
    """Keeps only the times a window opening from now on could still join by."""
    try:
        f = open(os.path.join(d, "times"), "r+")
    except OSError:
        return
    with f:
        # The lock note() takes too, so a time noted meanwhile is never cut.
        fcntl.flock(f, fcntl.LOCK_EX)
        lines = [l for l in f.read().split("\n") if l.strip()]
        keep = [l for l in lines if l.split()[1].isdigit() and int(l.split()[1]) > now_ms() - 2 * WINDOW_MS]
        if len(keep) < len(lines):
            f.seek(0)
            f.truncate()
            f.write("".join(l + "\n" for l in keep))


def entry(w, opened, agent):
    return {"id": w["id"], "app_id": w.get("app_id"), "title": w.get("title"), "pid": w.get("pid"), "opened": opened, "agent": agent}


def sweep(d):
    """Removes the state of every niri whose socket is gone, such as a nested check's that never ran a watcher."""
    socks = os.path.dirname(os.environ["NIRI_SOCKET"])
    top = os.path.dirname(d)
    for name in os.listdir(top):
        if name != os.path.basename(d) and not os.path.exists(os.path.join(socks, name)):
            shutil.rmtree(os.path.join(top, name), ignore_errors=True)


def watch():
    d = state_dir()
    os.makedirs(d, mode=0o700, exist_ok=True)
    sweep(d)
    lock = open(os.path.join(d, "watch.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another watcher has this niri
    path = os.path.join(d, "windows.json")
    # A watcher started again keeps what the last one knew of windows still open; niri never reuses an id.
    known = read_json(os.path.join(d, "windows.old"), {})
    stream = subprocess.Popen(["niri", "msg", "-j", "event-stream"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    windows = None
    for line in stream.stdout:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if "WindowsChanged" in ev:
            fresh = {}
            for w in ev["WindowsChanged"]["windows"]:
                old = (windows or known).get(str(w["id"]))
                # Windows open before the first watch never joined: they opened without a launch to tie them to.
                if old:
                    fresh[str(w["id"])] = entry(w, old["opened"], old["agent"])
                elif windows is None:
                    fresh[str(w["id"])] = entry(w, None, False)
                else:
                    opened = now_ms()
                    fresh[str(w["id"])] = entry(w, opened, bool(recent_times(d, opened)))
            windows = fresh
            try:
                os.unlink(os.path.join(d, "windows.old"))
            except OSError:
                pass
        elif "WindowOpenedOrChanged" in ev and windows is not None:
            w = ev["WindowOpenedOrChanged"]["window"]
            old = windows.get(str(w["id"]))
            if old:
                windows[str(w["id"])] = entry(w, old["opened"], old["agent"])
            else:
                opened = now_ms()
                windows[str(w["id"])] = entry(w, opened, bool(recent_times(d, opened)))
                prune_times(d)
        elif "WindowClosed" in ev and windows is not None:
            windows.pop(str(ev["WindowClosed"]["id"]), None)
        else:
            continue
        write_json(path, windows)
    # The stream ends when niri does, and its state goes with it.
    for f in ("windows.json", "windows.old", "times", "shot", "gesture.lock", "watch.lock"):
        try:
            os.unlink(os.path.join(d, f))
        except OSError:
            pass
    try:
        os.rmdir(d)
    except OSError:
        pass


def ensure_watcher():
    """Starts the watcher unless one runs, and waits until it has read niri's windows."""
    d = state_dir()
    os.makedirs(d, mode=0o700, exist_ok=True)
    lock_path = os.path.join(d, "watch.lock")
    with open(lock_path, "a") as probe:
        try:
            fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
            running = False
            fcntl.flock(probe, fcntl.LOCK_UN)
        except OSError:
            running = True
    path = os.path.join(d, "windows.json")
    if not running:
        # The new watcher reads the old list for the windows still open, and writes its own once it has niri's.
        try:
            os.replace(path, os.path.join(d, "windows.old"))
        except OSError:
            pass
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "watch"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    deadline = time.monotonic() + 3
    while not os.path.exists(path):
        if time.monotonic() > deadline:
            die("the desk watcher never read niri's windows")
        time.sleep(0.02)
    return path


def windows():
    return read_json(ensure_watcher(), {})


def window(wid=None):
    """The window's entry, read from niri if the watcher has not caught up yet; None if there is none."""
    if wid is None:
        out = subprocess.run(["niri", "msg", "-j", "focused-window"], capture_output=True, text=True)
        try:
            focused = json.loads(out.stdout)
        except ValueError:
            die("niri msg focused-window failed")
        if not focused:
            return None
        wid = focused["id"]
    deadline = time.monotonic() + 0.5
    while True:
        w = windows().get(str(wid))
        if w or time.monotonic() > deadline:
            return w
        time.sleep(0.02)


def journal_path():
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(state, "dots", "agent-journal.ndjson")


def redact(tool, args):
    """The text of screen type and gui type becomes its length and digest."""
    args = list(args)
    at = {"screen": 1, "gui": 3}.get(tool)
    if at is None or args[:1] != ["type"]:
        return args
    # Everything from the text on but a trailing --any, so a misplaced flag never leaves text in the clear.
    for i in range(at, len(args)):
        if not (i == len(args) - 1 and args[i] == "--any"):
            args[i] = {"len": len(args[i]), "sha256": hashlib.sha256(args[i].encode()).hexdigest()}
    return args


def journal(tool, rc, ms, window, args):
    """Appends one line; a usage error is no action and leaves none."""
    if rc == 2:
        return
    path = journal_path()
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    now = datetime.datetime.now().astimezone()
    line = json.dumps({"ts": now.isoformat(timespec="milliseconds"), "tool": tool, "args": redact(tool, args), "outcome": OUTCOMES.get(rc, "error"), "ms": ms, "window": window})
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "r+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        lines = f.read().splitlines()
        # The day's first write is the one whose last line is from another day.
        if lines and stamp(lines[-1]) and stamp(lines[-1]).date() != now.date():
            cut = now - datetime.timedelta(days=KEEP_DAYS)
            keep = [l for l in lines if (stamp(l) or now) >= cut]
            if len(keep) < len(lines):
                f.seek(0)
                f.truncate()
                f.write("".join(l + "\n" for l in keep))
        f.write(line + "\n")


def stamp(line):
    try:
        return datetime.datetime.fromisoformat(json.loads(line)["ts"])
    except (ValueError, KeyError, TypeError):
        return None


def run_json(argv):
    try:
        return json.loads(subprocess.run(argv, capture_output=True, text=True, timeout=5).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def dbus(argv):
    try:
        r = subprocess.run(["dbus-send", "--print-reply=literal", *argv], capture_output=True, text=True, timeout=3)
        return r.stdout.strip() if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def a11y_alive():
    """The a11y bus gui reaches answers for the registry's root; the bus launcher is never run (m48's probe killed the bus)."""
    # libatspi takes AT_SPI_BUS_ADDRESS first, as a nested session sets it, and asks org.a11y.Bus only without it.
    addr = os.environ.get("AT_SPI_BUS_ADDRESS") or dbus(["--session", "--dest=org.a11y.Bus", "/org/a11y/bus", "org.a11y.Bus.GetAddress"])
    return bool(addr) and dbus([f"--bus={addr}", "--dest=org.a11y.atspi.Registry", "/org/a11y/atspi/accessible/root", "org.freedesktop.DBus.Properties.Get", "string:org.a11y.atspi.Accessible", "string:ChildCount"]) is not None


def doctor():
    """Prints whether an agent can drive this desktop now, and the one step that comes first when it cannot."""
    lock = run_json(["dots-call", "lock", "state"])
    locked = lock.get("locked") if isinstance(lock, dict) else None
    sock = os.environ.get("NIRI_SOCKET")
    outputs = run_json(["niri", "msg", "-j", "outputs"]) if sock else None
    focused = (run_json(["niri", "msg", "-j", "focused-output"]) or {}) if sock else {}
    tools = {t: shutil.which(t) is not None for t in TOOLS}
    at_spi = a11y_alive()
    blockers = [b for b, bad in (
        ("niri", not isinstance(outputs, dict)),
        # A shell that does not answer counts as locked, as it does for every input.
        ("locked", locked is not False),
        ("grim", not tools["grim"]), ("wtype", not tools["wtype"]), ("dots-pointer", not tools["dots-pointer"]),
        ("at-spi", not at_spi),
    ) if bad]
    print(json.dumps({
        "blockers": blockers,
        "next": NEXT[blockers[0]] if blockers else None,
        "locked": locked,
        "lease": {"by": lock["heldBy"], "until": lock.get("leaseUntil")} if isinstance(lock, dict) and lock.get("heldBy") else None,
        "niri": {"socket": sock or None, "ok": isinstance(outputs, dict)},
        "outputs": [{"name": o["name"], "focused": o["name"] == focused.get("name"), **{k: o["logical"][k] for k in ("x", "y", "width", "height", "scale")}}
                    for o in (outputs or {}).values() if o.get("logical")],
        "at_spi": at_spi,
        "tools": tools,
    }))
    sys.exit(1 if blockers else 0)


def wait_args(args):
    """The condition's kind and options, and the timeout in seconds; anything else is a usage error."""
    args, timeout = list(args), WAIT_S
    if "--timeout" in args:
        at = args.index("--timeout")
        try:
            timeout = float(args[at + 1])
        except (IndexError, ValueError):
            die(WAIT_USAGE, 2)
        del args[at:at + 2]
        if not 0 < timeout <= WAIT_MAX_S:
            die(f"--timeout: more than 0, at most {WAIT_MAX_S} s", 2)
        timeout = int(timeout) if timeout == int(timeout) else timeout
    kind, rest = (args[0], args[1:]) if args else ("", [])
    shapes = {"window-open": {"--app"}, "window-closed": {"--id"}, "focus": {"--id"}, "title": {"--id", "--matches"}}
    if kind in shapes and len(rest) % 2 == 0:
        opts = dict(zip(rest[::2], rest[1::2]))
        if set(opts) == shapes[kind] and opts.get("--id", "0").isdigit():
            try:
                re.compile(opts.get("--matches", ""))
                return kind, opts, timeout
            except re.error:
                pass
    if kind == "workspace" and len(rest) == 1 or kind == "overview" and rest in (["open"], ["closed"]):
        return kind, {"ref": rest[0]}, timeout
    die(WAIT_USAGE, 2)


def follow(st, ev):
    """Folds one niri event into st: windows by id, the focused window, workspaces by id, the overview."""
    if "WindowsChanged" in ev:
        st["windows"] = {w["id"]: w for w in ev["WindowsChanged"]["windows"]}
        st["focused"] = next((w["id"] for w in st["windows"].values() if w.get("is_focused")), None)
    elif "WindowOpenedOrChanged" in ev:
        w = ev["WindowOpenedOrChanged"]["window"]
        st["windows"][w["id"]] = w
        if w.get("is_focused"):
            st["focused"] = w["id"]
    elif "WindowClosed" in ev:
        st["windows"].pop(ev["WindowClosed"]["id"], None)
        if st["focused"] == ev["WindowClosed"]["id"]:
            st["focused"] = None
    elif "WindowFocusChanged" in ev:
        st["focused"] = ev["WindowFocusChanged"]["id"]
    elif "WorkspacesChanged" in ev:
        st["workspaces"] = {w["id"]: w for w in ev["WorkspacesChanged"]["workspaces"]}
    elif "WorkspaceActivated" in ev:
        a = ev["WorkspaceActivated"]
        ws = st["workspaces"].get(a["id"])
        if ws:
            for o in st["workspaces"].values():
                if o.get("output") == ws.get("output"):
                    o["is_active"] = False
                if a["focused"]:
                    o["is_focused"] = False
            ws["is_active"] = True
            ws["is_focused"] = ws.get("is_focused") or a["focused"]
    elif "OverviewOpenedOrClosed" in ev:
        st["overview"] = ev["OverviewOpenedOrClosed"]["is_open"]


def brief(st, w):
    return {"id": w["id"], "app_id": w.get("app_id"), "title": w.get("title"), "pid": w.get("pid"), "workspace_id": w.get("workspace_id"), "focused": w["id"] == st["focused"]}


def focused_workspace(st):
    ws = next((w for w in st["workspaces"].values() if w.get("is_focused")), None)
    return ws and {k: ws.get(k) for k in ("id", "idx", "name", "output")}


def holds(kind, opts, st):
    """What the wait prints once its condition holds, else None."""
    wins = st["windows"]
    n = int(opts.get("--id", 0))
    if kind == "window-open":
        hits = [w for w in wins.values() if w.get("app_id") == opts["--app"]]
        return {"window": brief(st, max(hits, key=lambda w: w["id"]))} if hits else None
    if kind == "window-closed":
        return None if n in wins else {"closed": n}
    if kind == "focus":
        return {"window": brief(st, wins[n])} if st["focused"] == n and n in wins else None
    if kind == "title":
        w = wins.get(n)
        return {"window": brief(st, w)} if w and re.search(opts["--matches"], w.get("title") or "") else None
    if kind == "workspace":
        ws = focused_workspace(st)
        return {"workspace": ws} if ws and opts["ref"] in (str(ws["idx"]), ws["name"]) else None
    return {"overview": opts["ref"]} if st["overview"] == (opts["ref"] == "open") else None


def wait(args):
    """Prints what the condition holds for once it does, with already when niri's opening replay held it; exit 1 at the timeout."""
    started = time.monotonic()
    kind, opts, timeout = wait_args(args)
    # One connection: its replay is the check and its events are the listen, so nothing happens between them.
    stream = subprocess.Popen(["niri", "msg", "-j", "event-stream"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    st = {"windows": {}, "focused": None, "workspaces": {}, "overview": False}
    seen, buf = set(), b""
    try:
        while True:
            left = started + timeout - time.monotonic()
            if left <= 0 or not select.select([stream.stdout], [], [], left)[0]:
                last = {"windows": [brief(st, w) for _, w in sorted(st["windows"].items())], "focused": st["focused"], "workspace": focused_workspace(st), "overview": st["overview"]}
                print(json.dumps({"timeout": timeout, "last": last}))
                sys.exit(1)
            chunk = os.read(stream.stdout.fileno(), 65536)
            if not chunk:
                die("niri's event stream ended")
            *lines, buf = (buf + chunk).split(b"\n")
            for line in lines:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                replaying = seen != REPLAY
                follow(st, ev)
                seen |= REPLAY & ev.keys()
                hit = seen == REPLAY and holds(kind, opts, st)
                if hit:
                    print(json.dumps({"already": replaying, **hit}))
                    return
    finally:
        stream.kill()


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "watch":
        watch()
    elif cmd == "wait":
        wait(argv[2:])
    elif cmd == "doctor" and len(argv) == 2:
        doctor()
    elif cmd == "launch" and len(argv) > 2:
        ensure_watcher()
        note("launch")
        r = subprocess.run(["niri", "msg", "action", "spawn", "--", *argv[2:]], capture_output=True, text=True)
        if r.returncode != 0:
            die(f"niri could not spawn {argv[2]}: {r.stderr.strip()}")
        print(json.dumps({"launched": argv[2:], "agent_ms": WINDOW_MS}))
    elif cmd == "window" and len(argv) <= 3 and (len(argv) == 2 or argv[2].isdigit()):
        w = window(int(argv[2]) if len(argv) == 3 else None)
        if not w:
            print(json.dumps({"window": None}))
            sys.exit(4)
        print(json.dumps(w))
    elif cmd == "journal" and len(argv) >= 6 and argv[3].isdigit() and argv[4].isdigit():
        try:
            seen = json.loads(argv[5])
        except ValueError:
            seen = None
        journal(argv[2], int(argv[3]), int(argv[4]), seen, argv[6:])
    elif cmd == "acted" and len(argv) == 3 and argv[2].isdigit():
        w = window(int(argv[2]))
        if w and w["agent"]:
            note("act", argv[2])
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
