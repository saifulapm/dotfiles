#!/usr/bin/env python3
"""gui — read and drive GUI apps through the accessibility bus (AT-SPI).

Widgets by name instead of pixels: no coordinate guessing, no screenshots,
no focus stealing. Works for GTK/Qt apps that expose AT-SPI; Electron and
Chromium need --force-renderer-accessibility to appear.

  gui apps                      apps currently on the a11y bus
  gui tree <app> [--all]        interactive widgets (--all = every node)
  gui find <app> <text>         matching widgets + screen coords
  gui click <app> <text> [--any]       activate the first match semantically
  gui type <app> <text> <val> [--any]  set an entry's text
  gui text <app>                all readable text in the app

<app> and <text> match case-insensitively on a substring, so `gui click
files 'Save'` is enough. click and type act only in an agent window: the
element's app pid and window title must match one `screen launch` opened
(scripts/desk), else they exit 3 printing the refusal; --any lifts that for
a brief that grants it. Exit 4 = no such app/widget (nothing was clicked),
2 = usage.
"""

import importlib.machinery
import importlib.util
import json
import os
import sys
import warnings

warnings.filterwarnings("ignore")
sys.dont_write_bytecode = True

import gi  # noqa: E402

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi  # noqa: E402

# Roles a person would actually interact with. `tree` shows these by
# default because a full GTK tree is mostly fillers and panels.
INTERACTIVE = {
    "button", "push button", "toggle button", "check box", "radio button",
    "entry", "text", "password text", "page tab", "combo box", "slider",
    "menu item", "check menu item", "radio menu item", "link", "list item",
    "tree item", "spin button", "table cell",
}

MAX_NODES = 4000  # a deep tree must not hang the caller


def load_desk():
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "desk")
    spec = importlib.util.spec_from_loader("desk", importlib.machinery.SourceFileLoader("desk", path))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def usage():
    print(__doc__, file=sys.stderr)
    sys.exit(2)


def nothing(msg):
    print(f"gui: {msg}", file=sys.stderr)
    sys.exit(4)


def toplevel(node):
    """The window holding node: the ancestor whose parent is the application."""
    try:
        while node.get_parent() and node.get_parent().get_role_name() != "application":
            node = node.get_parent()
    except Exception:
        pass
    return node


def confine(app, node):
    """Returns only when node sits in an agent window, noting the action there; else refuses with exit 3."""
    desk = load_desk()
    pid, title = app.get_process_id(), toplevel(node).get_name() or ""
    seen = [w for w in desk.windows().values() if w["pid"] == pid and w["title"] == title]
    for w in seen:
        if w["agent"]:
            desk.note("act", str(w["id"]))
            return
    window = {k: seen[0][k] for k in ("id", "app_id", "title")} if seen else {"pid": pid, "title": title}
    print(json.dumps({"refused": "not an agent window", "window": window}))
    sys.exit(3)


def apps():
    Atspi.init()
    desktop = Atspi.get_desktop(0)
    out = []
    for i in range(desktop.get_child_count()):
        try:
            app = desktop.get_child_at_index(i)
            out.append((app.get_name() or "", app))
        except Exception:
            continue
    return out


def find_app(pattern):
    hits = [app for name, app in apps() if pattern.lower() in name.lower()]
    if not hits:
        known = ", ".join(n for n, _ in apps() if n) or "none"
        nothing(f"no app matching {pattern!r} on the a11y bus (have: {known})")
    return hits[0]


def walk(node, want=None, depth=0, budget=None):
    """Yield (depth, node) for the subtree, cheapest-first and bounded."""
    if budget is None:
        budget = [MAX_NODES]
    if budget[0] <= 0:
        return
    budget[0] -= 1
    try:
        role = node.get_role_name()
        if want is None or role in want:
            yield depth, node
        for i in range(node.get_child_count()):
            yield from walk(node.get_child_at_index(i), want, depth + 1, budget)
    except Exception:
        return  # a widget can vanish mid-walk; that is not an error


def coords(node):
    try:
        e = Atspi.Component.get_extents(node.get_component(), Atspi.CoordType.SCREEN)
        return (e.x, e.y, e.width, e.height)
    except Exception:
        return None


def states(node):
    try:
        return {s.value_nick for s in node.get_state_set().get_states()}
    except Exception:
        return set()


def value(node):
    """A slider's, spin button's or scroll bar's current value, else None."""
    try:
        return node.get_value().get_current_value()
    except Exception:
        return None


def describe(node):
    role = node.get_role_name()
    name = node.get_name() or ""
    box = coords(node)
    where = f" at {box[0]},{box[1]} {box[2]}x{box[3]}" if box else ""
    v = value(node)
    current = f" = {v:g}" if v is not None else ""
    flags = states(node) & {"checked", "selected", "focused", "expanded", "sensitive"}
    marks = f" [{','.join(sorted(flags))}]" if flags else ""
    return f"{role:14} {name!r}{current}{where}{marks}"


def matches(node, text):
    haystack = (node.get_name() or "") + " " + (node.get_role_name() or "")
    return text.lower() in haystack.lower()


def main(argv):
    anywhere = argv[-1] == "--any"
    if anywhere:
        argv = argv[:-1]
    if len(argv) < 2:
        usage()
    cmd = argv[1]

    if cmd == "apps":
        Atspi.init()
        for name, app in apps():
            if name:
                print(f"{name}  (windows: {app.get_child_count()})")
        return

    if len(argv) < 3:
        usage()
    Atspi.init()
    app = find_app(argv[2])

    if cmd == "tree":
        want = None if "--all" in argv else INTERACTIVE
        for depth, node in walk(app, want):
            if node is app:
                continue
            print("  " * min(depth, 6) + describe(node))
        return

    if cmd == "text":
        seen = set()
        for _, node in walk(app):
            name = node.get_name() or ""
            if len(name) > 1 and name not in seen:
                seen.add(name)
                print(name)
        return

    if len(argv) < 4:
        usage()
    needle = argv[3]
    hits = [n for _, n in walk(app) if n is not app and matches(n, needle)]

    if cmd == "find":
        if not hits:
            nothing(f"nothing matching {needle!r}")
        for node in hits[:20]:
            print(describe(node))
        return

    if cmd == "click":
        for node in hits:
            try:
                action = node.get_action()
                names = [
                    Atspi.Action.get_action_name(action, i)
                    for i in range(Atspi.Action.get_n_actions(action))
                ]
            except Exception:
                continue
            if not names:
                continue
            # "click" where offered, else the first action the widget has.
            index = names.index("click") if "click" in names else 0
            if not anywhere:
                confine(app, node)
            Atspi.Action.do_action(action, index)
            print(f"{names[index]}: {describe(node)}")
            return
        nothing(f"nothing clickable matching {needle!r}")

    if cmd == "type":
        if len(argv) < 5:
            usage()
        value = argv[4]
        for node in hits:
            try:
                editable = node.get_editable_text()
            except Exception:
                continue
            if editable is None:
                continue
            if not anywhere:
                confine(app, node)
            try:
                Atspi.EditableText.set_text_contents(editable, value)
            except Exception:
                continue
            print(f"typed into {describe(node)}")
            return
        nothing(f"no editable widget matching {needle!r}")

    usage()


if __name__ == "__main__":
    main(sys.argv)
