#!/usr/bin/env python3
"""gui — read and drive GUI apps through the accessibility bus (AT-SPI).

Widgets by name instead of pixels: no coordinate guessing, no screenshots,
no focus stealing. Works for GTK/Qt apps that expose AT-SPI; Electron and
Chromium need --force-renderer-accessibility to appear.

  gui apps                      apps currently on the a11y bus
  gui tree <app> [--all] [--depth N] [--root REF]   interactive widgets as one JSON object, each with a ref
                                (--all = every node; --depth cuts N levels down, a cut node showing children_count;
                                --root walks only that node's subtree)
  gui tree --pid <n> [--all]    the same for the app with process id n
  gui find <app> <text>         matching widgets + screen coords
  gui check|uncheck <app> <text>   tick or clear a check box; one already so prints "already": true
  gui wait <app> --text T | --gone T | --state <text> <state> [--timeout S]
                                until a name or field holds T, none does, or the widget has the state;
                                10 s by default, 60 at most, exit 1 at the timeout with the last state seen
  gui get <app> <text> [text|states|box]   one property, or all three (a password field's text is withheld)
  gui click <app> <text> [--any] [--then shot|windows|tree]       activate the first match semantically
  gui type <app> <text> <val> [--any] [--then shot|windows|tree]  set an entry's text
  gui text <app>                all readable text in the app

<app> and <text> match case-insensitively on a substring of the name and
role, so `gui click files 'Save'` is enough; where a text matches an
interactive widget, only those count, and two or more print {"ambiguous":
[...]} with up to 10 refs, exit 4. A ref `s<hex>:<i>` from `gui tree` names
one node until the app changes: re-found by its path, it must keep its role
and name, else {"stale": "<cause>"}, exit 4. Nothing acts in either case. click and type act only in an agent window: the
element's app pid and window title must match one `screen launch` opened
(scripts/desk), else they exit 3 printing the refusal; --any lifts that for
a brief that grants it. click and type print {"ok": ...} with the result the
accessibility call reported, exit 1 when it failed; --then adds the look
`screen look` takes once the screen is still, the tree of this app. tree prints at most 1000
nodes and 32 KB; a longer tree is written whole to a file in the desk state
directory, named under "spill". Both refuse with exit 3 unless `dots-call lock
state` reads "locked": false and `dots-call polkit state` and `pinentry state`
read "open": false, --any or not. Exit 4 = no such app/widget (nothing was
clicked), 2 = usage.
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import time
import warnings

warnings.filterwarnings("ignore")
sys.dont_write_bytecode = True

import gi  # noqa: E402

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi  # noqa: E402

# Roles a person would actually interact with. `tree` shows these by
# default because a full GTK tree is mostly fillers and panels.
INTERACTIVE = {
    "button", "push button", "toggle button", "check box", "radio button",
    "entry", "text", "password text", "page tab", "combo box", "slider",
    "menu item", "check menu item", "radio menu item", "link", "list item",
    "tree item", "spin button", "table cell",
}

MAX_NODES = 4000  # a deep tree must not hang the caller
INLINE_NODES = 1000  # what gui tree prints before it spills
INLINE_BYTES = 32768  # the printed object, newline included
SPILL_KEEP_S = 3600  # a spill or snapshot older than this goes on the next gui call
AMBIGUOUS_SHOWN = 10
WAIT_S, WAIT_MAX_S, WAIT_EVERY_S = 10, 60, 0.1
GONE_SEE_S = 2  # a --gone wait must see the thing first, or wait this long: a menu shows up to 0.7 s after its opener
FIELDS = {"text", "entry"}  # roles whose text, not only their name, a --text wait reads
REF = re.compile(r"^s([0-9a-f]{4}):([0-9]+)$")
CALL_MS = 3000  # every AT-SPI call; a stopped app never answers, and libatspi would wait 25 s
READ_FROM_S, READ_EVERY_S, READ_UNTIL_S = 0.3, 0.1, 2.0  # a write's effect lands a beat after its reply
seen = None  # the window an action saw, for its journal line
delivered = None  # an action's delivery, for its journal line
STARTED_MS = int(time.time() * 1000)  # the 2 s a --then look waits count from here


def load_desk():
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "desk")
    spec = importlib.util.spec_from_loader("desk", importlib.machinery.SourceFileLoader("desk", path))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def usage():
    print(__doc__, file=sys.stderr)
    sys.exit(2)


def nothing(msg):
    print(f"gui: {msg}", file=sys.stderr)
    sys.exit(4)


def toplevel(app, path):
    """The window holding the node at path: the app's child it was walked down from, since GTK's parents disagree with its child lists."""
    try:
        return app.get_child_at_index(path[0])
    except Exception:
        return None


def unlocked():
    """A press or text at a lock lands in it, so anything but a literal "locked": false refuses with exit 3."""
    try:
        out = subprocess.run(["dots-call", "lock", "state"], capture_output=True, text=True, timeout=5).stdout
        if json.loads(out).get("locked") is False:
            return
    except Exception:
        pass
    print(json.dumps({"refused": "locked"}))
    sys.exit(3)


def no_prompt():
    """A press or text at a polkit or pinentry prompt lands in its field, so anything but a literal "open": false from both refuses with exit 3."""
    for target in ("polkit", "pinentry"):
        try:
            out = subprocess.run(["dots-call", target, "state"], capture_output=True, text=True, timeout=5).stdout
            if json.loads(out).get("open") is False:
                continue
        except Exception:
            pass
        print(json.dumps({"refused": "auth prompt"}))
        sys.exit(3)


def guard():
    unlocked()
    no_prompt()


def confine(app, path):
    """Returns only when the node at path sits in an agent window, noting the action there; else refuses with exit 3."""
    global seen
    desk = load_desk()
    window = toplevel(app, path)
    pid, title = app.get_process_id(), (window.get_name() if window else "") or ""
    hits = [w for w in desk.windows().values() if w["pid"] == pid and w["title"] == title]
    seen = {k: hits[0][k] for k in ("id", "app_id", "title")} if hits else {"pid": pid, "title": title}
    agents = [w for w in hits if w["agent"]]
    # Two windows of one app with one title are one to AT-SPI, so either could be the agent's.
    if len(agents) < len(hits):
        print(json.dumps({"refused": "not an agent window" if not agents else "windows share a title", "window": seen}))
        sys.exit(3)
    seen = {k: agents[0][k] for k in ("id", "app_id", "title")}
    desk.note("act", str(agents[0]["id"]))


def apps():
    Atspi.init()
    desktop = Atspi.get_desktop(0)
    out = []
    for i in range(desktop.get_child_count()):
        try:
            app = desktop.get_child_at_index(i)
            out.append((app.get_name() or "", app))
        except Exception:
            continue
    return out


def find_app(pattern):
    hits = [app for name, app in apps() if pattern.lower() in name.lower()]
    if not hits:
        known = ", ".join(n for n, _ in apps() if n) or "none"
        nothing(f"no app matching {pattern!r} on the a11y bus (have: {known})")
    return hits[0]


def walk(node, want=None, path=(), budget=None, below=None):
    """Yield (path, node) for the subtree, path the child indexes from node down; cheapest-first and bounded, and below levels deep at most."""
    if budget is None:
        budget = [MAX_NODES]
    if budget[0] <= 0:
        return
    budget[0] -= 1
    try:
        role = node.get_role_name()
        if want is None or role in want:
            yield path, node
        if below == 0:
            return
        for i in range(node.get_child_count()):
            yield from walk(node.get_child_at_index(i), want, path + (i,), budget, None if below is None else below - 1)
    except Exception:
        return  # a widget can vanish mid-walk; that is not an error


def coords(node):
    try:
        e = Atspi.Component.get_extents(node.get_component(), Atspi.CoordType.SCREEN)
        return (e.x, e.y, e.width, e.height)
    except Exception:
        return None


def states(node):
    try:
        return {s.value_nick for s in node.get_state_set().get_states()}
    except Exception:
        return set()


def value(node):
    """A slider's, spin button's or scroll bar's current value, else None."""
    try:
        return node.get_value().get_current_value()
    except Exception:
        return None


FLAGS = {"checked", "pressed", "selected", "focused", "expanded", "sensitive"}


def walked(app, root=None, path=(), depth=None):
    """[(i, path, node, role, name)] for every node under app, or root and under it, depth levels down at most; i its place in the walk, path from app."""
    rows = []
    for path, node in walk(root or app, path=path, below=depth):
        if node is not app:
            try:
                rows.append((len(rows), path, node, node.get_role_name(), node.get_name() or ""))
            except Exception:
                continue  # gone mid-walk
    return rows


def state_files(state, prefix):
    try:
        return [os.path.join(state, f) for f in os.listdir(state) if f.startswith(prefix) and f.endswith(".json")]
    except OSError:
        return []


def sweep():
    """Removes spills and snapshots older than an hour; any gui call, and never a reason to fail."""
    try:
        state = load_desk().state_dir()
        for path in state_files(state, "tree-") + state_files(state, "snap-"):
            if time.time() - os.stat(path).st_mtime > SPILL_KEEP_S:
                os.unlink(path)
    except (Exception, SystemExit):
        pass


def snapshot(app, rows):
    """Writes each node's path, role and name under a fresh 4-hex id, returned; None off niri, where refs have nowhere to live."""
    if not os.environ.get("NIRI_SOCKET"):
        return None
    state = load_desk().state_dir()
    os.makedirs(state, mode=0o700, exist_ok=True)
    body = {"app": app.get_name() or "", "pid": app.get_process_id(), "nodes": [[list(p), role, name] for _, p, _, role, name in rows]}
    while True:
        hexid = os.urandom(2).hex()
        try:
            fd = os.open(os.path.join(state, f"snap-{hexid}.json"), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            break
        except FileExistsError:
            continue
    with os.fdopen(fd, "w") as f:
        json.dump(body, f)
    return hexid


def ref(hexid, i):
    return f"s{hexid}:{i}" if hexid else None


def widget(r, role, name):
    return {"ref": r, "role": role, "name": name}


def refuse4(out):
    print(json.dumps(out))
    sys.exit(4)


def target(app, arg):
    """(ref, path, node, role, name) for a ref still naming what it named, or a text one widget matches; else exits 4 saying why, acting on nothing."""
    m = REF.match(arg)
    if m:
        try:
            with open(os.path.join(load_desk().state_dir(), f"snap-{m[1]}.json")) as f:
                snap = json.load(f)
        except (OSError, ValueError, SystemExit):
            refuse4({"stale": "snapshot_gone"})
        i = int(m[2])
        if snap.get("pid") != app.get_process_id() or i >= len(snap["nodes"]):
            refuse4({"stale": "path_gone"})
        path, role, name = snap["nodes"][i]
        node = app
        try:
            for k in path:
                node = node.get_child_at_index(k) if k < node.get_child_count() else None
                if node is None:
                    refuse4({"stale": "path_gone"})
            now_role, now_name = node.get_role_name(), node.get_name() or ""
        except Exception:
            refuse4({"stale": "path_gone"})
        if now_role != role:
            refuse4({"stale": "role_changed"})
        if now_name != name:
            refuse4({"stale": "name_changed"})
        return arg, tuple(path), node, role, name
    if not arg:
        usage()
    rows = walked(app)
    hits = [r for r in rows if matches(r[3], r[4], arg)]
    # A GTK4 button's label is a node of its own name, so a widget a person acts on wins over the text around it.
    if any(r[3] in INTERACTIVE for r in hits):
        hits = [r for r in hits if r[3] in INTERACTIVE]
    if not hits:
        nothing(f"nothing matching {arg!r}")
    hexid = snapshot(app, rows)
    if len(hits) > 1:
        refuse4({"ambiguous": [widget(ref(hexid, i), role, name) for i, _, _, role, name in hits[:AMBIGUOUS_SHOWN]]})
    i, path, node, role, name = hits[0]
    return ref(hexid, i), path, node, role, name


def entry(i, depth, node):
    box = coords(node)
    out = {"i": i, "depth": depth, "role": node.get_role_name(), "name": node.get_name() or "", "box": list(box) if box else None, "states": sorted(states(node) & FLAGS)}
    v = value(node)
    if v is not None:
        out["value"] = v
    return out


def tree(app, everything, depth=None, root=None):
    """The app's widgets as a dict, each with its ref; past 1000 nodes or 32 KB the dict is cut and the whole tree is in the "spill" file.

    depth cuts the walk that many levels below the app or root: a node there whose children were left out shows them as children_count, kept whatever its role."""
    top = len(root[1]) if root else 0
    rows = walked(app, root and root[2], root[1] if root else (), depth)
    hexid = snapshot(app, rows)
    nodes = []
    for i, p, n, role, _ in rows:
        count = n.get_child_count() if depth is not None and len(p) - top == depth else 0
        if everything or role in INTERACTIVE or count > 0:
            nodes.append(dict(entry(i, len(p), n), ref=ref(hexid, i), **({"children_count": count} if count > 0 else {})))
    head = {"app": app.get_name() or "", "pid": app.get_process_id(), "count": len(nodes)}
    whole = dict(head, nodes=nodes)
    # Every tree replaces the spill before it, whether it spills or not; snapshots stay their hour.
    state = load_desk().state_dir() if os.environ.get("NIRI_SOCKET") else None
    for old in state_files(state, "tree-") if state else []:
        os.unlink(old)
    if len(nodes) <= INLINE_NODES and len(json.dumps(whole)) < INLINE_BYTES:
        return whole
    state = load_desk().state_dir()
    os.makedirs(state, mode=0o700, exist_ok=True)
    path = os.path.join(state, f"tree-{int(time.time() * 1000)}.json")
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
        json.dump(whole, f)
    # The newline print adds counts against the budget, so stop one byte short.
    size = len(json.dumps(dict(head, nodes=[], spill=path)))
    kept = 0
    for n in nodes[:INLINE_NODES]:
        size += len(json.dumps(n)) + (2 if kept else 0)
        if size >= INLINE_BYTES:
            break
        kept += 1
    return dict(head, nodes=nodes[:kept], spill=path)


def describe(node):
    role = node.get_role_name()
    name = node.get_name() or ""
    box = coords(node)
    where = f" at {box[0]},{box[1]} {box[2]}x{box[3]}" if box else ""
    v = value(node)
    current = f" = {v:g}" if v is not None else ""
    flags = states(node) & FLAGS
    marks = f" [{','.join(sorted(flags))}]" if flags else ""
    return f"{role:14} {name!r}{current}{where}{marks}"


def timed_out(e):
    return "Did not receive a reply" in str(e)


def read_text(node):
    """The field's text, or raises: a widget with no Text interface has none to read."""
    return Atspi.Text.get_text(node, 0, -1)


def delivery(how, cause=None, matched=None):
    """An action's delivery fields; only a write that never landed is safe to send again."""
    out = {"ok": how != "not_delivered", "delivery": how, "retry_safe": how == "not_delivered"}
    if cause:
        out["cause"] = cause
    if matched is not None:
        out["matched"] = matched
    return out


def write(node, role, editable, value):
    """Sets the text, then judges it by what the field reads after, never by the reply."""
    secure = role == "password text"
    before = None
    if not secure:
        try:
            before = read_text(node)
        except Exception as e:
            if timed_out(e):
                return delivery("not_delivered", "timeout", False)
    try:
        Atspi.EditableText.set_text_contents(editable, value)
    except Exception as e:
        if timed_out(e):
            return delivery("unverified", "timeout", False)
    if secure:
        return delivery("unverified", "secure_field", False)
    t0, now = time.monotonic(), None
    time.sleep(READ_FROM_S)
    while True:
        try:
            now = read_text(node)
        except Exception as e:
            return delivery("unverified", "timeout" if timed_out(e) else None, False)
        if now == value:
            return delivery("verified", matched=True)
        if time.monotonic() - t0 >= READ_UNTIL_S:
            break
        time.sleep(READ_EVERY_S)
    if now == before:
        return delivery("not_delivered", "write_ignored", False)
    return delivery("unverified", matched=False)


ACTS = ("click", "type", "check", "uncheck")  # the commands that act, each guarded and journalled
TOGGLES = {"check box", "toggle button", "radio button", "check menu item", "radio menu item"}
SHOWN = {"checked", "pressed", "expanded"}  # what a toggle's or an expander's click changes


def shown(node):
    """The node's checked, pressed and expanded states; raises when the app does not answer."""
    return {s.value_nick for s in node.get_state_set().get_states()} & SHOWN


def press(node, action, index):
    """Runs the action, then judges a toggle or expander by its state; a plain click stays unverified."""
    st = states(node)
    toggle = node.get_role_name() in TOGGLES or bool(st & (SHOWN | {"checkable", "expandable"}))
    before = st & SHOWN
    try:
        if not Atspi.Action.do_action(action, index):
            return delivery("not_delivered", "action_refused")
    except Exception as e:
        return delivery("unverified", "timeout") if timed_out(e) else delivery("not_delivered", "action_refused")
    if not toggle:
        return delivery("unverified")
    t0 = time.monotonic()
    time.sleep(READ_FROM_S)
    while True:
        try:
            if shown(node) != before:
                return delivery("verified")
        except Exception as e:
            return delivery("unverified", "timeout" if timed_out(e) else None)
        if time.monotonic() - t0 >= READ_UNTIL_S:
            return delivery("not_delivered", "state_unchanged")
        time.sleep(READ_EVERY_S)


def matches(role, name, text):
    return text.lower() in f"{name} {role}".lower()


def holding(app, text):
    """(rows, the first row whose name, or a field's text, holds text), the row None when none does; a password field is never read."""
    t = text.lower()
    rows = walked(app)
    for row in rows:
        _, _, node, role, name = row
        if t in name.lower():
            return rows, row
        if role in FIELDS:
            try:
                if t in read_text(node).lower():
                    return rows, row
            except Exception:
                pass
    return rows, None


def wait(app, kind, args, timeout):
    """Polls every 100 ms until the tree shows what kind asks, printing what it saw; exit 1 at the timeout with the last state."""
    t0 = time.monotonic()
    node = None
    if kind == "--state":
        r, _, node, role, name = target(app, args[0])
    seen = False
    while True:
        if kind == "--state":
            last = sorted(states(node))
            if args[1] in last:
                print(json.dumps({"ok": True, "ms": int((time.monotonic() - t0) * 1000), "widget": widget(r, role, name), "states": last}))
                return
        else:
            rows, row = holding(app, args[0])
            seen = seen or row is not None
            last = {"present": row is not None}
            # A --gone right after an opener would pass before the thing shows, so it first sees it or waits 2 s.
            done = row is not None if kind == "--text" else row is None and (seen or time.monotonic() - t0 >= GONE_SEE_S)
            if done:
                out = {"ok": True, "ms": int((time.monotonic() - t0) * 1000)}
                if row:
                    i, _, _, role, name = row
                    out["widget"] = widget(ref(snapshot(app, rows), i), role, name)
                print(json.dumps(out))
                return
        if time.monotonic() - t0 >= timeout:
            print(json.dumps({"ok": False, "timeout": timeout, "last": last}))
            sys.exit(1)
        time.sleep(WAIT_EVERY_S)


def finish(out, then, app):
    """Prints an action's JSON, with the look --then asked for once it worked; exit 1 when it did not."""
    global delivered
    delivered = out.get("delivery")
    if out["ok"] and then:
        screen = os.path.join(os.path.dirname(os.path.realpath(__file__)), "screen")
        r = subprocess.run([screen, "look", then, str(app.get_process_id())], capture_output=True, text=True, env={**os.environ, "DESK_T0": str(STARTED_MS)})
        if r.returncode != 0:
            print(json.dumps(out))
            print(f"gui: the look failed: {r.stderr.strip()}", file=sys.stderr)
            sys.exit(1)
        out.update(json.loads(r.stdout))
    print(json.dumps(out))
    sys.exit(0 if out["ok"] else 1)


def main(argv):
    # The trailing flags, in either order: --any, and --then KIND on click and type.
    anywhere, then = False, None
    while len(argv) > 2:
        if argv[-1] == "--any" and not anywhere:
            anywhere, argv = True, argv[:-1]
        elif argv[1] in ("click", "type") and argv[-2] == "--then" and then is None:
            then, argv = argv[-1], argv[:-2]
            if then not in ("shot", "windows", "tree"):
                usage()
        else:
            break
    if len(argv) < 2:
        usage()
    cmd = argv[1]
    sweep()
    Atspi.set_timeout(CALL_MS, CALL_MS)

    if cmd == "apps":
        Atspi.init()
        for name, app in apps():
            if name:
                print(f"{name}  (windows: {app.get_child_count()})")
        return

    if len(argv) < 3:
        usage()
    if cmd in ACTS:
        guard()
    Atspi.init()
    if cmd == "tree":
        # gui tree <app> | --pid N, then --all, --depth N and --root REF in any order.
        rest = argv[4:] if argv[2] == "--pid" else argv[3:]
        everything, depth, root = False, None, None
        while rest:
            if rest[0] == "--all":
                everything, rest = True, rest[1:]
            elif rest[0] == "--depth" and len(rest) > 1 and rest[1].isdigit() and int(rest[1]) > 0:
                depth, rest = int(rest[1]), rest[2:]
            elif rest[0] == "--root" and len(rest) > 1 and REF.match(rest[1]):
                root, rest = rest[1], rest[2:]
            else:
                usage()
        if argv[2] == "--pid":
            if len(argv) < 4 or not argv[3].isdigit():
                usage()
            pids = [app for _, app in apps() if app.get_process_id() == int(argv[3])]
            if not pids:
                nothing(f"no app with pid {argv[3]} on the a11y bus")
            app = pids[0]
        else:
            app = find_app(argv[2])
        print(json.dumps(tree(app, everything, depth, root and target(app, root))))
        return
    if cmd == "wait":
        # gui wait <app> --text T | --gone T | --state TARGET STATE, then --timeout S.
        rest, timeout = argv[3:], WAIT_S
        if len(rest) >= 2 and rest[-2] == "--timeout":
            try:
                timeout = float(rest[-1])
            except ValueError:
                usage()
            rest = rest[:-2]
            if not 0 < timeout <= WAIT_MAX_S:
                usage()
        if not rest or (rest[0], len(rest)) not in (("--text", 2), ("--gone", 2), ("--state", 3)) or not rest[1]:
            usage()
        wait(find_app(argv[2]), rest[0], rest[1:], timeout)
        return
    app = find_app(argv[2])

    if cmd == "text":
        seen = set()
        for _, node in walk(app):
            name = node.get_name() or ""
            if len(name) > 1 and name not in seen:
                seen.add(name)
                print(name)
        return

    if len(argv) < 4:
        usage()
    needle = argv[3]

    if cmd == "find":
        hits = [r for r in walked(app) if matches(r[3], r[4], needle)]
        if not hits:
            nothing(f"nothing matching {needle!r}")
        for _, _, node, _, _ in hits[:20]:
            print(describe(node))
        return

    if cmd == "get":
        what = argv[4:] or ["text", "states", "box"]
        if len(what) > 1 and len(argv) > 4 or what[0] not in ("text", "states", "box"):
            usage()
        r, _, node, role, name = target(app, needle)
        out = {"widget": widget(r, role, name)}
        if "text" in what:
            # A password field's text never leaves it, whatever asks.
            if role == "password text":
                out.update(text=None, withheld=True)
            else:
                try:
                    out["text"] = read_text(node)
                except Exception:
                    out["text"] = None
        if "states" in what:
            out["states"] = sorted(states(node))
        if "box" in what:
            box = coords(node)
            out["box"] = list(box) if box else None
        print(json.dumps(out))
        return

    if cmd == "click":
        r, path, node, role, name = target(app, needle)
        try:
            action = node.get_action()
            names = [Atspi.Action.get_action_name(action, k) for k in range(Atspi.Action.get_n_actions(action))]
        except Exception:
            names = []
        if not names:
            nothing(f"{role} {name!r} offers no action (a GTK4 check box offers none)")
        # "click" where offered, else the first action the widget has.
        index = names.index("click") if "click" in names else 0
        w = widget(r, role, name)
        if not anywhere:
            confine(app, path)
        guard()
        finish({**press(node, action, index), "action": names[index], "widget": w}, then, app)

    if cmd in ("check", "uncheck"):
        r, path, node, role, name = target(app, needle)
        w = widget(r, role, name)
        want = cmd == "check"
        # Already as asked: nothing to press, and pressing would undo it.
        if ("checked" in states(node)) == want:
            finish({**delivery("verified"), "already": True, "widget": w}, None, app)
        try:
            action = node.get_action()
            names = [Atspi.Action.get_action_name(action, k) for k in range(Atspi.Action.get_n_actions(action))]
        except Exception:
            names = []
        if not names:
            nothing(f"{role} {name!r} offers no action (a GTK4 check box offers none)")
        index = names.index("click") if "click" in names else 0
        if not anywhere:
            confine(app, path)
        guard()
        out = press(node, action, index)
        # The change press saw must be the one asked for.
        if out["delivery"] == "verified" and ("checked" in states(node)) != want:
            out = delivery("unverified")
        finish({**out, "action": names[index], "widget": w}, None, app)

    if cmd == "type":
        if len(argv) < 5:
            usage()
        value = argv[4]
        # Role and name come from the walk: an app that stops on the write answers nothing after.
        r, path, node, role, name = target(app, needle)
        w = widget(r, role, name)
        if not anywhere:
            confine(app, path)
        guard()
        try:
            editable = node.get_editable_text()
        except Exception:
            editable = None
        # Editable set and read-only clear, whatever interfaces the widget has.
        st = states(node)
        if editable is None or "editable" not in st or "read-only" in st:
            print(json.dumps({"refused": "not editable", "widget": w}))
            sys.exit(3)
        finish({**write(node, role, editable, value), "typed": len(value), "widget": w}, then, app)

    usage()


if __name__ == "__main__":
    started, rc = time.monotonic(), 1
    try:
        main(sys.argv)
        rc = 0
    except SystemExit as e:
        rc = e.code if isinstance(e.code, int) else (0 if e.code is None else 1)
        raise
    finally:
        # click and type are actions, and each leaves one journal line, refusals included.
        if sys.argv[1:2] in ([a] for a in ACTS):
            load_desk().journal("gui", rc, int((time.monotonic() - started) * 1000), seen, sys.argv[1:], delivery=delivered)
