#!/usr/bin/env bash
# screen — the computer-use action set over this desktop, in screenshot space.
#
#   screen shot [--output NAME]          the focused output, 1280 px wide → /tmp/desk/shot.png
#   screen zoom X0 Y0 X1 Y1              that box at native resolution → /tmp/desk/zoom.png
#   screen move X Y                      hover
#   screen click X Y [left|right|middle] [COUNT] [--any]   COUNT 2 = double, 3 = triple
#   screen drag X1 Y1 X2 Y2 [--any]      press at 1, release at 2
#   screen scroll X Y up|down|left|right [N]       N wheel notches (default 3)
#   screen type TEXT [--any]             literal text at keyboard focus
#   screen key COMBO [REPEAT] [--any]    ctrl+s · Return · super+t · shift+Tab
#   screen launch CMD...                 start CMD; its windows in the next 5 s are agent windows
#   screen wait COND [--timeout S]       until niri says COND (10 s, at most 60): window-open --app ID,
#                                        window-closed --id N, focus --id N, title --id N --matches RE,
#                                        workspace N, overview open|closed
#   screen doctor                        readiness JSON: blockers and the one next step
#
# Every X/Y is a pixel in the LAST `screen shot` image, never a logical
# coordinate, so a shot must come first; it records the scale it used in
# $XDG_RUNTIME_DIR/desk/<NIRI_SOCKET basename>/, so a nested session's shot
# never steers the live one, and every later action converts through it. A
# point outside that image is refused, not clamped — moving it into range
# would act where the caller did not point. Pointer work goes through
# scripts/mouse, which keeps 2 px off the edges, where the hot corners are.
#
# Refuses all input unless `dots-call lock state` reads "locked": false, keys unless
# the focused window is an agent window (one `screen launch` opened, see
# scripts/desk) or a shell surface holds the keyboard, and a click or drag
# unless an agent window is under the point (scripts/mouse): a refusal exits 3
# printing {"refused":"<reason>","window":{...}}. --any lifts that for a task
# whose brief grants it. Usage exits 2. Each action leaves a journal line. For the nested session, source the
# env bin/dots-dev prints, as the desktop skill says; MOUSE_SCREEN=WxH passes
# straight through to scripts/mouse.

set -euo pipefail
ARGV=("$@") T0=$(date +%s%3N) SEEN=

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
die() { echo "screen: $*" >&2; exit 1; }

# doctor answers without a niri too: no niri is one of its blockers.
[[ ${1:-} == doctor ]] && exec "$(dirname "$(readlink -f "$0")")/desk" doctor "${@:2}"

DIR=/tmp/desk
[[ -n "${NIRI_SOCKET:-}" ]] || die "NIRI_SOCKET is not set"
DESK=${XDG_RUNTIME_DIR:?}/desk/${NIRI_SOCKET##*/}
STATE=$DESK/shot
SHOT_W=1280
MOUSE="$(dirname "$(readlink -f "$0")")/mouse"
DESK_PY="$(dirname "$(readlink -f "$0")")/desk"

int() { [[ $1 =~ ^-?[0-9]+$ ]] || die "not an integer: $1"; }

# The focused output, or the one named: "NAME X Y W H" in logical pixels.
# A name niri does not have is a usage error that lists the ones it has.
geometry() {
    local all
    if [[ -n "${MOUSE_SCREEN:-}" ]]; then
        echo "screen 0 0 ${MOUSE_SCREEN%x*} ${MOUSE_SCREEN#*x}"
    elif [[ -z ${1:-} ]]; then
        niri msg -j focused-output | jq -er '"\(.name) \(.logical | "\(.x) \(.y) \(.width) \(.height)")"'
    else
        all=$(niri msg -j outputs)
        jq -er --arg n "$1" '.[$n] | select(.logical) | "\(.name) \(.logical | "\(.x) \(.y) \(.width) \(.height)")"' <<<"$all" && return
        echo "screen: no output $1; there are: $(jq -r '[.[] | select(.logical) | .name] | join(", ")' <<<"$all")" >&2
        exit 2
    fi
}

load() {
    [[ -f $STATE ]] || die "no shot yet — run 'screen shot' first"
    read -r OX OY W H SW SH <"$STATE"
}

# Screenshot pixel → global logical pixel, refusing points off the image.
# A third argument "edge" admits x == width / y == height: a box's far corner.
to_logical() {
    int "$1"; int "$2"
    local e=0; [[ ${3:-} == edge ]] && e=1
    ((0 <= $1 && $1 < SW + e && 0 <= $2 && $2 < SH + e)) || die "[$1, $2] is outside the ${SW}x${SH} shot"
    LX=$((OX + $1 * W / SW)) LY=$((OY + $2 * H / SH))
}

# Keys sent at a lock land in its password field, so input waits for a lock
# state that reads unlocked; a shell that does not answer counts as locked.
unlocked() {
    dots-call lock state 2>/dev/null | jq -e '.locked == false' >/dev/null 2>&1 || refuse "locked"
}

refuse() { # reason [window JSON]
    [[ -z ${2:-} ]] || SEEN=$2
    jq -nc --arg r "$1" --argjson w "${2:-null}" '{refused: $r} + (if $w then {window: $w} else {} end)'
    exit 3
}

# A shell surface holds the keyboard when niri gives it the keys: an Exclusive
# layer on the focused output, Overlay always, Top only with no fullscreen
# window in front of it (niri's update_keyboard_focus).
shell_has_keys() {
    jq -en --argjson l "$(niri msg -j layers)" --argjson o "$(niri msg -j focused-output)" --argjson w "$(niri msg -j focused-window)" '
        ($w != null and $w.layout.window_size == [$o.logical.width, $o.logical.height]) as $full
        | any($l[]; .output == $o.name and .keyboard_interactivity == "Exclusive"
            and (.layer == "Overlay" or (.layer == "Top" and ($full | not))))' >/dev/null
}

# Keys reach the focused window, so they go only when an agent opened it, or
# when a shell surface holds the keyboard; the window is read here, in the
# same command, and an action in it lets the dialog it opens join.
keys_allowed() {
    ((any)) && return
    shell_has_keys && return
    local w
    w=$("$DESK_PY" window) || refuse "no window"
    SEEN=$(jq -c '{id, app_id, title}' <<<"$w")
    jq -e .agent <<<"$w" >/dev/null || refuse "not an agent window" "$SEEN"
    "$DESK_PY" acted "$(jq -r .id <<<"$w")"
}

cmd=${1:-}
[[ -n $cmd ]] || usage
shift
any=0 anyarg=()
if [[ $cmd =~ ^(type|key|click|drag)$ ]] && [[ ${!#} == --any ]]; then
    any=1 anyarg=(--any)
    set -- "${@:1:$#-1}"
fi

# One journal line per action, refusals included (scripts/desk); the window is
# the one the action saw, scripts/mouse's for the pointer, else the focused one.
journal() {
    local rc=$? w=$SEEN
    [[ -z $w && -s $DESK_SEEN ]] && w=$(<"$DESK_SEEN")
    [[ -n $w ]] || w=$(niri msg -j focused-window 2>/dev/null | jq -c 'if . then {id, app_id, title} else null end' 2>/dev/null) || w=null
    rm -f "$DESK_SEEN"
    "$DESK_PY" journal screen "$rc" $(($(date +%s%3N) - T0)) "${w:-null}" "${ARGV[@]}" || true
    exit "$rc"
}
if [[ $cmd =~ ^(move|click|drag|scroll|type|key|launch)$ ]]; then
    DESK_SEEN=$(mktemp)
    export DESK_SEEN
    trap journal EXIT
fi

case "$cmd" in
shot)
    output=
    [[ $# -eq 0 ]] || { [[ $# -eq 2 && $1 == --output ]] && output=$2; } || usage
    mkdir -p "$DIR" "$DESK"
    g=$(geometry "$output") || { (($? == 2)) && exit 2; die "no output geometry (niri msg failed? set MOUSE_SCREEN=WxH)"; }
    read -r NAME OX OY W H <<<"$g"
    SH=$((H * SHOT_W / W))
    grim -g "$OX,$OY ${W}x$H" -s "$(awk "BEGIN { print $SHOT_W / $W }")" "$DIR/shot.png"
    # grim rounds the scaled size; record what it actually wrote.
    read -r SW SH < <(file "$DIR/shot.png" | sed -n 's/.*, \([0-9]*\) x \([0-9]*\),.*/\1 \2/p')
    echo "$OX $OY $W $H $SW $SH" >"$STATE"
    jq -nc --arg p "$DIR/shot.png" --arg o "$NAME" --argjson w "$SW" --argjson h "$SH" '{shot: $p, output: $o, width: $w, height: $h}'
    ;;
zoom)
    [[ $# -eq 4 ]] || usage
    load
    to_logical "$1" "$2"; X0=$LX Y0=$LY
    to_logical "$3" "$4" edge; X1=$LX Y1=$LY
    ((X1 > X0 && Y1 > Y0)) || die "zoom box must run top-left to bottom-right"
    # Native scale, so small text survives; the box is the caller's to keep small.
    grim -g "$X0,$Y0 $((X1 - X0))x$((Y1 - Y0))" "$DIR/zoom.png"
    echo "$DIR/zoom.png"
    ;;
move)
    [[ $# -eq 2 ]] || usage
    unlocked; load; to_logical "$1" "$2"
    "$MOUSE" to "$LX" "$LY"
    ;;
click)
    [[ $# -ge 2 && $# -le 4 ]] || usage
    unlocked; load; to_logical "$1" "$2"
    button=${3:-left} count=${4:-1}
    [[ $button =~ ^(left|right|middle)$ ]] || die "button: left, right or middle"
    [[ $count =~ ^[1-3]$ ]] || die "count: 1 to 3"
    "$MOUSE" click "$LX" "$LY" "$button" "$count" "${anyarg[@]}"
    ;;
drag)
    [[ $# -eq 4 ]] || usage
    unlocked; load
    to_logical "$1" "$2"; X1=$LX Y1=$LY
    to_logical "$3" "$4"
    "$MOUSE" drag "$X1" "$Y1" "$LX" "$LY" "${anyarg[@]}"
    ;;
scroll)
    [[ $# -ge 3 && $# -le 4 ]] || usage
    unlocked; load; to_logical "$1" "$2"
    "$MOUSE" scroll "$LX" "$LY" "$3" "${4:-3}"
    ;;
type)
    [[ $# -eq 1 ]] || usage
    unlocked; keys_allowed
    wtype -- "$1"
    ;;
key)
    [[ $# -ge 1 && $# -le 2 ]] || usage
    unlocked; keys_allowed
    repeat=${2:-1}
    [[ $repeat =~ ^[0-9]+$ ]] && ((repeat >= 1 && repeat <= 50)) || die "repeat: 1 to 50"
    IFS=+ read -ra parts <<<"$1"
    key=${parts[-1]}
    case "${key,,}" in # the names models reach for that are not X keysyms
    enter) key=Return ;; esc) key=Escape ;; backspace) key=BackSpace ;;
    del) key=Delete ;; pageup | pgup) key=Page_Up ;; pagedown | pgdn) key=Page_Down ;;
    space) key=space ;; tab) key=Tab ;;
    esac
    args=()
    for m in "${parts[@]:0:${#parts[@]}-1}"; do
        case "${m,,}" in
        ctrl | control) args+=(-M ctrl) ;; shift) args+=(-M shift) ;;
        alt) args+=(-M alt) ;; super | meta | cmd | win | logo) args+=(-M logo) ;;
        *) die "modifier: ctrl, shift, alt or super (got $m)" ;;
        esac
    done
    up=()
    for ((i = ${#args[@]} - 1; i >= 1; i -= 2)); do up+=(-m "${args[i]}"); done
    for ((i = 0; i < repeat; i++)); do wtype "${args[@]}" -k "$key" "${up[@]}"; done
    ;;
launch)
    [[ $# -ge 1 ]] || usage
    "$DESK_PY" launch "$@"
    ;;
wait)
    exec "$DESK_PY" wait "$@"
    ;;
*)
    usage
    ;;
esac
