#!/usr/bin/env bash
# screen — the computer-use action set over this desktop, in screenshot space.
#
#   screen shot [--output NAME]          the focused output, 1280 px wide → /tmp/desk/shot.png
#   screen zoom X0 Y0 X1 Y1              that box at native resolution → /tmp/desk/zoom.png
#   screen move X Y                      hover
#   screen click X Y [left|right|middle] [COUNT] [--any]   COUNT 2 = double, 3 = triple
#   screen drag X1 Y1 X2 Y2 [--any]      press at 1, release at 2
#   screen scroll X Y up|down|left|right [N]       N wheel notches (default 3)
#   screen type TEXT [--any]             literal text at keyboard focus, newlines dropped
#   screen key COMBO [REPEAT] [--any]    ctrl+s · Return · super+t · shift+Tab
#   screen launch CMD...                 start CMD; its windows in the next 5 s are agent windows
#   screen wait COND [--timeout S]       until niri says COND (10 s, at most 60): window-open --app ID,
#                                        window-closed --id N, focus --id N, title --id N --matches RE,
#                                        workspace N, overview open|closed
#   screen doctor                        readiness JSON: blockers and the one next step
#   screen look shot|windows|tree        wait for a still screen, then look: {"stable", KIND}
#   screen find DESCRIPTION --jev [--any]   a fresh shot to JEV: the point to click, in shot pixels
#   screen check QUESTION --jev [--any]     a fresh shot to JEV: yes or no, with its probability
#
# Every acting command takes --then shot|windows|tree last: it acts, then
# prints the look in the same JSON. A still screen is two identical frames
# 100 ms apart; 2 s after the command began it stops waiting and says
# "stable": false, which is no failure (a spinner never stops).
#
# Every X/Y is a pixel in the LAST `screen shot` image, never a logical
# coordinate, so a shot must come first; it records the scale it used in
# $XDG_RUNTIME_DIR/desk/<NIRI_SOCKET basename>/, so a nested session's shot
# never steers the live one, and every later action converts through it. A
# point outside that image is refused, not clamped — moving it into range
# would act where the caller did not point. Pointer work goes through
# scripts/mouse, which keeps 2 px off the edges, where the hot corners are.
#
# Refuses all input unless `dots-call lock state` reads "locked": false and
# `dots-call polkit state` and `pinentry state` read "open": false, keys unless
# the focused window is an agent window (one `screen launch` opened, see
# scripts/desk) or a shell surface holds the keyboard, and a click or drag
# unless an agent window is under the point (scripts/mouse): a refusal exits 3
# printing {"refused":"<reason>","window":{...}}. --any lifts the window checks
# for a task whose brief grants it, never the lock or a prompt. Usage exits 2. Each action leaves a journal line. For the nested session, source the
# env bin/dots-dev prints, as the desktop skill says; MOUSE_SCREEN=WxH passes
# straight through to scripts/mouse.

set -euo pipefail
# A failing step inside $(...) fails it too, so a look that could not grab a frame is an error, not a stale shot.
shopt -s inherit_errexit
ARGV=("$@") T0=$(date +%s%3N) SEEN=

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
die() { echo "screen: $*" >&2; exit 1; }

# doctor answers without a niri too: no niri is one of its blockers.
[[ ${1:-} == doctor ]] && exec "$(dirname "$(readlink -f "$0")")/desk" doctor "${@:2}"

DIR=/tmp/desk
[[ -n "${NIRI_SOCKET:-}" ]] || die "NIRI_SOCKET is not set"
DESK=${XDG_RUNTIME_DIR:?}/desk/${NIRI_SOCKET##*/}
STATE=$DESK/shot
SHOT_W=1280
MOUSE="$(dirname "$(readlink -f "$0")")/mouse"
GUI="$(dirname "$(readlink -f "$0")")/gui"
DESK_PY="$(dirname "$(readlink -f "$0")")/desk"

int() { [[ $1 =~ ^-?[0-9]+$ ]] || die "not an integer: $1"; }

# The focused output, or the one named: "NAME X Y W H" in logical pixels.
# A name niri does not have is a usage error that lists the ones it has.
geometry() {
    local all
    if [[ -n "${MOUSE_SCREEN:-}" ]]; then
        echo "screen 0 0 ${MOUSE_SCREEN%x*} ${MOUSE_SCREEN#*x}"
    elif [[ -z ${1:-} ]]; then
        niri msg -j focused-output | jq -er '"\(.name) \(.logical | "\(.x) \(.y) \(.width) \(.height)")"'
    else
        all=$(niri msg -j outputs)
        jq -er --arg n "$1" '.[$n] | select(.logical) | "\(.name) \(.logical | "\(.x) \(.y) \(.width) \(.height)")"' <<<"$all" && return
        echo "screen: no output $1; there are: $(jq -r '[.[] | select(.logical) | .name] | join(", ")' <<<"$all")" >&2
        exit 2
    fi
}

# The focused output's box and the scale that makes it SHOT_W wide.
focused_box() {
    local g
    g=$(geometry "") || die "no output geometry (niri msg failed? set MOUSE_SCREEN=WxH)"
    read -r NAME OX OY W H <<<"$g"
}

# grim rounds the scaled size, so the shot's state records what it actually wrote.
record() {
    read -r SW SH < <(file "$1" | sed -n 's/.*, \([0-9]*\) x \([0-9]*\),.*/\1 \2/p')
    echo "$OX $OY $W $H $SW $SH" >"$STATE"
}

# A shot of output $1, the focused one when empty, into $2; every later X/Y converts through it.
shoot() {
    local g
    g=$(geometry "$1") || { (($? == 2)) && exit 2; die "no output geometry (niri msg failed? set MOUSE_SCREEN=WxH)"; }
    read -r NAME OX OY W H <<<"$g"
    grim -g "$OX,$OY ${W}x$H" -s "$(awk "BEGIN { print $SHOT_W / $W }")" "$2"
    record "$2"
}

ms() { echo $((${EPOCHREALTIME/./} / 1000)); }

# Frames of the focused output into $1, each starting 100 ms after the last
# began (at once when a grab takes longer), until two match or it is 2 s
# since the acting command began ($DESK_T0 from mouse and gui); STABLE says
# which. The last frame stays in $1. PNG at compression 1, for speed.
settle() {
    local t0=${DESK_T0:-$T0} next=$1.next scale start pause
    scale=$(awk "BEGIN { print $SHOT_W / $W }")
    grab() { grim -l 1 -g "$OX,$OY ${W}x$H" -s "$scale" "$1"; }
    start=$(ms)
    grab "$1"
    STABLE=false
    while :; do
        pause=$((start + 100 - $(ms)))
        ((pause <= 0)) || sleep "0.$(printf %03d "$pause")"
        start=$(ms)
        grab "$next"
        cmp -s "$1" "$next" && { STABLE=true; rm -f "$next"; return; }
        mv "$next" "$1"
        (($(ms) - t0 < 2000)) || return 0
    done
}

# Prints {"stable": bool, KIND: ...}: the still frame as the shot, niri's
# windows, or the AT-SPI tree of pid $2's app, the focused window's without it.
look() {
    local kind=$1 pid=${2:-} file tree
    focused_box
    mkdir -p "$DIR"
    mkdir -p -m 700 "${DESK%/*}" "$DESK"
    file=$DESK/settle.png
    [[ $kind == shot ]] && file=$DIR/shot.png
    settle "$file"
    case $kind in
    shot)
        record "$file"
        jq -nc --argjson s "$STABLE" --arg p "$file" '{stable: $s, shot: $p}'
        ;;
    windows)
        rm -f "$file"
        niri msg -j windows | jq -c --argjson s "$STABLE" '{stable: $s, windows: map({id, app_id, title, workspace_id, focused: .is_focused})}'
        ;;
    tree)
        rm -f "$file"
        [[ -n $pid ]] || pid=$(niri msg -j focused-window | jq -r '.pid // empty')
        tree=$("$GUI" tree --pid "${pid:-0}" 2>/dev/null) || tree=null
        jq -nc --argjson s "$STABLE" --argjson t "$tree" '{stable: $s, tree: $t}'
        ;;
    esac
}

load() {
    [[ -f $STATE ]] || die "no shot yet — run 'screen shot' first"
    read -r OX OY W H SW SH <"$STATE"
}

# Screenshot pixel → global logical pixel, refusing points off the image.
# A third argument "edge" admits x == width / y == height: a box's far corner.
to_logical() {
    int "$1"; int "$2"
    local e=0; [[ ${3:-} == edge ]] && e=1
    ((0 <= $1 && $1 < SW + e && 0 <= $2 && $2 < SH + e)) || die "[$1, $2] is outside the ${SW}x${SH} shot"
    LX=$((OX + $1 * W / SW)) LY=$((OY + $2 * H / SH))
}

# Keys sent at a lock land in its password field, so input waits for a lock
# state that reads unlocked; a shell that does not answer counts as locked.
unlocked() {
    dots-call lock state 2>/dev/null | jq -e '.locked == false' >/dev/null 2>&1 || refuse "locked"
}

# A key or a press at a polkit or pinentry prompt lands in its password field,
# so input waits until both read a literal "open": false, --any or not.
no_prompt() {
    local p
    for p in polkit pinentry; do
        dots-call "$p" state 2>/dev/null | jq -e '.open == false' >/dev/null 2>&1 || refuse "auth prompt"
    done
}
guard() { unlocked; no_prompt; }

refuse() { # reason [window JSON]
    [[ -z ${2:-} ]] || SEEN=$2
    jq -nc --arg r "$1" --argjson w "${2:-null}" '{refused: $r} + (if $w then {window: $w} else {} end)'
    exit 3
}

# A shell surface holds the keyboard when niri gives it the keys: an Exclusive
# layer on the focused output, Overlay always, Top only with no fullscreen
# window in front of it (niri's update_keyboard_focus).
shell_has_keys() {
    jq -en --argjson l "$(niri msg -j layers)" --argjson o "$(niri msg -j focused-output)" --argjson w "$(niri msg -j focused-window)" '
        ($w != null and $w.layout.window_size == [$o.logical.width, $o.logical.height]) as $full
        | any($l[]; .output == $o.name and .keyboard_interactivity == "Exclusive"
            and (.layer == "Overlay" or (.layer == "Top" and ($full | not))))' >/dev/null
}

# Keys reach the focused window, so they go only when an agent opened it, or
# when a shell surface holds the keyboard; the window is read here, in the
# same command, and an action in it lets the dialog it opens join.
keys_allowed() {
    ((any)) && return
    shell_has_keys && return
    local w
    w=$("$DESK_PY" window) || refuse "no window"
    SEEN=$(jq -c '{id, app_id, title}' <<<"$w")
    jq -e .agent <<<"$w" >/dev/null || refuse "not an agent window" "$SEEN"
    "$DESK_PY" acted "$(jq -r .id <<<"$w")"
}

# Without --any a JEV shot goes only when it can show agent windows alone: the
# overview shows every workspace of the output, and on the active one every
# window, floating ones too, must be an agent's. niri gives tiled windows no
# position, so the workspace is what is checked; a niri that cannot say lets
# nothing through.
only_agents() {
    ((any)) && return
    local w rc=0
    niri msg -j overview-state 2>/dev/null | jq -e '.is_open == false' >/dev/null 2>&1 || refuse "overview open"
    w=$("$DESK_PY" stranger "$NAME") || rc=$?
    ((rc == 4)) || { ((rc == 0)) && refuse "not an agent window" "$w"; die "could not read the workspace's windows"; }
}

# One key per wtype, each gated and 15 ms after the last one went out, so a
# lock or a prompt arriving mid-burst stops it at the next key.
SENT=0
send() {
    local pause=$((SENT + 15 - $(ms)))
    ((pause <= 0)) || sleep "0.$(printf %03d "$pause")"
    guard
    wtype "$@"
    SENT=$(ms)
}

# wtype's keymap reaches a window only once a key has gone to it, so a key
# into a window not typed into before can arrive as another (Return as
# Escape): the first key there is Shift_L. A dialog an agent click opened is
# a new window too. Ids grow for the life of a niri, so the list never prunes.
prime() {
    local id
    id=$(niri msg -j focused-window | jq -r '.id // empty')
    [[ -n $id ]] && grep -qx "$id" "$DESK/typed" 2>/dev/null && return
    send -k Shift_L
    [[ -z $id ]] || { mkdir -p -m 700 "${DESK%/*}" "$DESK"; echo "$id" >>"$DESK/typed"; }
}

cmd=${1:-}
[[ -n $cmd ]] || usage
shift
# The trailing flags of an acting command, in either order: --any, and --then KIND.
any=0 anyarg=() then=
if [[ $cmd =~ ^(move|click|drag|scroll|type|key|launch)$ ]]; then
    while (($# > 0)); do
        if [[ $cmd =~ ^(type|key|click|drag)$ && ${!#} == --any && $any == 0 ]]; then
            any=1 anyarg=(--any)
            set -- "${@:1:$#-1}"
        elif (($# > 1)) && [[ ${*:$#-1:1} == --then && -z $then ]]; then
            then=${!#}
            [[ $then =~ ^(shot|windows|tree)$ ]] || usage
            set -- "${@:1:$#-2}"
        else
            break
        fi
    done
fi

# One journal line per action, refusals included (scripts/desk); the window is
# the one the action saw, scripts/mouse's for the pointer, else the focused one.
journal() {
    local rc=$? w=$SEEN
    [[ -z $w && -s $DESK_SEEN ]] && w=$(<"$DESK_SEEN")
    [[ -n $w ]] || w=$(niri msg -j focused-window 2>/dev/null | jq -c 'if . then {id, app_id, title} else null end' 2>/dev/null) || w=null
    rm -f "$DESK_SEEN"
    "$DESK_PY" journal screen "$rc" $(($(date +%s%3N) - T0)) "${w:-null}" "${ARGV[@]}" || true
    rm -f "${DESK_JEV:-}" "${JEV_SHOT:-}"
    exit "$rc"
}
if [[ $cmd =~ ^(move|click|drag|scroll|type|key|launch|find|check)$ ]]; then
    DESK_SEEN=$(mktemp)
    export DESK_SEEN
    # What a JEV send answered, for its journal line.
    [[ ! $cmd =~ ^(find|check)$ ]] || { DESK_JEV=$(mktemp); export DESK_JEV; }
    trap journal EXIT
fi

case "$cmd" in
shot)
    output=
    [[ $# -eq 0 ]] || { [[ $# -eq 2 && $1 == --output ]] && output=$2; } || usage
    mkdir -p "$DIR"
    mkdir -p -m 700 "${DESK%/*}" "$DESK"
    shoot "$output" "$DIR/shot.png"
    jq -nc --arg p "$DIR/shot.png" --arg o "$NAME" --argjson w "$SW" --argjson h "$SH" '{shot: $p, output: $o, width: $w, height: $h}'
    ;;
zoom)
    [[ $# -eq 4 ]] || usage
    load
    to_logical "$1" "$2"; X0=$LX Y0=$LY
    to_logical "$3" "$4" edge; X1=$LX Y1=$LY
    ((X1 > X0 && Y1 > Y0)) || die "zoom box must run top-left to bottom-right"
    # Native scale, so small text survives; the box is the caller's to keep small.
    grim -g "$X0,$Y0 $((X1 - X0))x$((Y1 - Y0))" "$DIR/zoom.png"
    echo "$DIR/zoom.png"
    ;;
move)
    [[ $# -eq 2 ]] || usage
    guard; load; to_logical "$1" "$2"
    "$MOUSE" to "$LX" "$LY"
    ;;
click)
    [[ $# -ge 2 && $# -le 4 ]] || usage
    guard; load; to_logical "$1" "$2"
    button=${3:-left} count=${4:-1}
    [[ $button =~ ^(left|right|middle)$ ]] || die "button: left, right or middle"
    [[ $count =~ ^[1-3]$ ]] || die "count: 1 to 3"
    "$MOUSE" click "$LX" "$LY" "$button" "$count" "${anyarg[@]}"
    ;;
drag)
    [[ $# -eq 4 ]] || usage
    guard; load
    to_logical "$1" "$2"; X1=$LX Y1=$LY
    to_logical "$3" "$4"
    "$MOUSE" drag "$X1" "$Y1" "$LX" "$LY" "${anyarg[@]}"
    ;;
scroll)
    [[ $# -ge 3 && $# -le 4 ]] || usage
    guard; load; to_logical "$1" "$2"
    "$MOUSE" scroll "$LX" "$LY" "$3" "${4:-3}"
    ;;
type)
    [[ $# -eq 1 ]] || usage
    guard; keys_allowed
    # A newline, or a CRLF's \r, would go as Return and submit a form halfway; characters, not bytes, whatever the caller's locale.
    LC_ALL=C.UTF-8
    text=${1//[$'\n\r']/}
    [[ -z $text ]] || prime
    for ((i = 0; i < ${#text}; i++)); do send -- "${text:i:1}"; done
    ;;
key)
    [[ $# -ge 1 && $# -le 2 ]] || usage
    guard; keys_allowed
    repeat=${2:-1}
    [[ $repeat =~ ^[0-9]+$ ]] && ((repeat >= 1 && repeat <= 50)) || die "repeat: 1 to 50"
    IFS=+ read -ra parts <<<"$1"
    key=${parts[-1]}
    case "${key,,}" in # the names models reach for that are not X keysyms
    enter) key=Return ;; esc) key=Escape ;; backspace) key=BackSpace ;;
    del) key=Delete ;; pageup | pgup) key=Page_Up ;; pagedown | pgdn) key=Page_Down ;;
    space) key=space ;; tab) key=Tab ;;
    esac
    args=()
    for m in "${parts[@]:0:${#parts[@]}-1}"; do
        case "${m,,}" in
        ctrl | control) args+=(-M ctrl) ;; shift) args+=(-M shift) ;;
        alt) args+=(-M alt) ;; super | meta | cmd | win | logo) args+=(-M logo) ;;
        *) die "modifier: ctrl, shift, alt or super (got $m)" ;;
        esac
    done
    up=()
    for ((i = ${#args[@]} - 1; i >= 1; i -= 2)); do up+=(-m "${args[i]}"); done
    prime
    for ((i = 0; i < repeat; i++)); do send "${args[@]}" -k "$key" "${up[@]}"; done
    ;;
launch)
    [[ $# -ge 1 ]] || usage
    launched=$("$DESK_PY" launch "$@")
    [[ -n $then ]] || echo "$launched"
    ;;
look)
    [[ $# -ge 1 && $# -le 2 && $1 =~ ^(shot|windows|tree)$ ]] || usage
    look "$@"
    ;;
wait)
    exec "$DESK_PY" wait "$@"
    ;;
find | check)
    # The grant comes first: without it nothing is read, shot or sent.
    jev=0
    while (($# > 1)) && [[ ${!#} =~ ^--(jev|any)$ ]]; do
        if [[ ${!#} == --jev ]]; then jev=1; else any=1; fi
        set -- "${@:1:$#-1}"
    done
    [[ $# -eq 1 && -n $1 && $1 != --* ]] || usage
    ((jev)) || refuse "jev not granted"
    # The shot that goes is this command's own, never one another agent wrote to $DIR meanwhile; it is the last shot too.
    mkdir -p "$DIR"
    mkdir -p -m 700 "${DESK%/*}" "$DESK"
    JEV_SHOT=$(mktemp -p "$DESK" jev-XXXXXX.png)
    # Read before the shot and after it, so a window that left while grim ran counts, and one that mapped meanwhile.
    guard
    focused_box
    only_agents
    shoot "" "$JEV_SHOT"
    cp "$JEV_SHOT" "$DIR/shot.png"
    guard
    only_agents
    "$DESK_PY" jev "$cmd" "$1" "$JEV_SHOT"
    ;;
*)
    usage
    ;;
esac

if [[ -n $then ]]; then
    seen=$(look "$then")
    jq -nc --argjson a "${launched:-null}" --argjson l "$seen" '($a // {}) + $l'
fi
