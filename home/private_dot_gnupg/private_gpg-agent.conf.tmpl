# gpg-agent — the passphrase prompt and cache policy behind `pass`
# (packages/manifest.toml: pass, browserpass, pinentry-qt).
#
# pinentry-program is the load-bearing line here. Fedora's base `pinentry`
# package ships only pinentry-curses, which can draw a prompt in a terminal
# and nowhere else. browserpass is spawned by Chromium with no controlling
# tty, so under the default program a browser autofill blocks on a prompt
# that can never appear and then times out — the single most common way an
# otherwise-correct pass setup looks broken. pinentry-qt rather than
# pinentry-gnome3 because this session is niri, not GNOME: gnome3's prompter
# goes through gcr and degrades to curses when no GNOME session answers,
# which is precisely the failure being avoided. Qt costs nothing on this
# machine — quickshell already pulls Qt 6 in.
#
# Resolved through lookPath instead of hardcoded so the file written by a
# background apply — which cannot sudo, so run_before_00 installed nothing —
# still names a pinentry that EXISTS. gpg-agent pointed at a missing binary
# does not fall back, it fails the operation, and that would break gpg for
# everything rather than just for pass. The next terminal apply rewrites this
# line to pinentry-qt.
{{ if lookPath "pinentry-qt" }}pinentry-program {{ lookPath "pinentry-qt" }}{{ else }}pinentry-program /usr/bin/pinentry{{ end }}

# Cache for the life of the session — 400 days, which on a machine that is
# switched off nightly means "until the next boot".
#
# What this is really tuning is ONE prompt, and it is not a browser prompt.
# imapnotify@icloud.service starts with the graphical session and resolves
# `pass email/icloud/<user>` before it can log into iCloud IMAP, so a fresh
# boot draws pinentry about half a second after the watcher starts (measured
# 2026-08-19: unit started 16:06:32.710, pinentry-qt at 16:06:33.172). mbsync
# via mail-sync.timer and msmtp's passwordeval want the same secret and hit
# the cache behind it. That first prompt CANNOT be removed by any TTL: the
# agent's cache is memory-only and dies with the session, so nothing here
# survives a power cycle. Removing it would mean taking the mail password out
# of gpg entirely — considered 2026-08-19, deliberately not done.
#
# What the TTL does control is the SECOND prompt. The previous 1 h idle / 8 h
# ceiling meant a machine left on through a working day re-asked mid-afternoon
# for no security gained, because max-cache-ttl counts from first entry, not
# from last use — so a continuously-exercised agent still expired on schedule.
#
# The security this gives up is smaller than the number suggests, because the
# TTL was never the thing guarding a walked-away machine: Idle.qml locks the
# session after 300 s (defaultLockSeconds), and an attacker at a locked screen
# cannot reach gpg-agent at all. Nor was it protecting much against someone
# with the disk — tty1 autologins, /home is plain btrfs with no LUKS, and the
# store holds exactly one entry (the iCloud app-specific password) whose entire
# mailbox already sits unencrypted in ~/Mail. The residual cost is honest and
# accepted: an attacker who reaches an UNLOCKED session can now read the store
# all day rather than only within 8 h of the last unlock.
default-cache-ttl 34560000
max-cache-ttl 34560000
