[user]
  name = "Saiful Islam"
  email = "saiful.apm@gmail.com"
[github]
  # https://github.com/blog/180-local-github-config
  user = "saifulapm"

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[core]
  excludesfile = ~/.gitignore
  quotepath = false
  # line endings: force LF during add, warn on conversion
  autocrlf = input
  safecrlf = warn
  # No core.editor on purpose (the mac set vim): core.editor outranks
  # $VISUAL/$EDITOR, and here the environment is the source of truth —
  # kak outside Emacs, with-editor's emacsclient inside (00-env.fish).
  pager = delta
  hooksPath = /home/saiful/.config/git/hooks

[init]
  defaultBranch = main

# Modernization batch (user pick 2026-08-08) — behavior changes, not cosmetics:
[push]
  # `git push` on a new branch creates the upstream itself; the fish `push`
  # alias dropped its hardcoded `-u origin main` the same day.
  autoSetupRemote = true
[pull]
  rebase = true
[rebase]
  autoStash = true
[fetch]
  prune = true
[rerere]
  # replay recorded conflict resolutions — pays off with pull.rebase above
  enabled = true
[merge]
  # zdiff3 adds the merge base to conflict hunks; kak/emacs both render it
  conflictStyle = zdiff3
[diff]
  algorithm = histogram
[branch]
  sort = -committerdate
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

# Two GitHub accounts are authenticated at once since 2026-09-09 (saifulapm
# personal, lareysbd commercial — see ~/.config/gh/config.yml). Which one a
# git operation uses has to follow the REPO, not whichever account gh happens
# to have active, or the failure mode is a push that 403s in the middle of
# work for a reason nothing on screen explains.
#
# These rewrites make the URL decide. Every lareysbd/* remote — in any of the
# three forms `gh repo clone`, a copied browser URL, or an old clone can
# produce — is dialled through the github.com-lareys ssh alias, which
# IdentitiesOnly-pins it to the commercial key. Nothing to switch and nothing
# to remember; the rule travels to every machine with this file.
#
# Rewriting only affects the URL git DIALS, never what is written into
# .git/config, so a clone still shows its canonical github.com remote.
# Commit identity is deliberately untouched: one email everywhere (user pick,
# 2026-09-09), so there is no includeIf and no second [user] block.
[url "git@github.com-lareys:lareysbd/"]
	insteadOf = git@github.com:lareysbd/
	insteadOf = https://github.com/lareysbd/
	insteadOf = ssh://git@github.com/lareysbd/

# The personal half of the same rule, added 2026-09-09 after an https remote in
# amx 403'd: saifulapm/* was not being rewritten, so the URL reached the
# [credential] helper above and authenticated as whichever gh account was
# ACTIVE — lareysbd that day. Sending those remotes down the plain github.com
# alias lets the URL decide here too. No `git@github.com:saifulapm/` line: that
# form already dials the right alias, and rewriting it to itself is a loop.
[url "git@github.com:saifulapm/"]
	insteadOf = https://github.com/saifulapm/
	insteadOf = ssh://git@github.com/saifulapm/

[interactive]
  diffFilter = delta --color-only --features=interactive

[delta]
  features = decorations
  navigate = true # n/N jump between files in a diff
  # ansi = the 16 terminal colors, so diffs follow foot's live OSC retint on
  # every theme change (same trick as bat's config and kak's Default=default)
  syntax-theme = ansi

[delta "interactive"]
  keep-plus-minus-markers = false

[delta "decorations"]
  commit-decoration-style = blue ol
  commit-style = raw
  file-style = omit
  hunk-header-decoration-style = blue box
  hunk-header-file-style = red
  hunk-header-line-number-style = "#067a00"
  hunk-header-style = file line-number syntax
