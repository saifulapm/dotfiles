// Theme fragment rendered by the theme renderer: layout, background-color, animations.
include "~/.local/state/dots/theme-out/niri.kdl"
include "binds.kdl"
include "rules.kdl"

spawn-at-startup "systemctl" "--user" "start" "dots-shell.service"
spawn-at-startup "systemctl" "--user" "start" "dots-dshift.service"
spawn-at-startup "systemctl" "--user" "start" "dots-clip.service"
spawn-at-startup "systemctl" "--user" "start" "dots-sync.timer"
spawn-at-startup "systemctl" "--user" "start" "dots-sync-notes.path"
spawn-at-startup "systemctl" "--user" "start" "dots-sync-goals.path"

// logind ignores the lid (there is no suspend), so closing it only locks.
switch-events {
    lid-close { spawn "qs" "ipc" "call" "lock" "lock"; }
}
