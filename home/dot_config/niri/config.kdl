// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://niri-wm.github.io/niri/Configuration:-Introduction

// Input device configuration.
// Find the full list of options on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            // You can set rules, model, layout, variant and options.
            // For more information, see xkeyboard-config(7).

            // For example:
            // layout "us,ru"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"

            // If this section is empty, niri will fetch xkb settings
            // from org.freedesktop.locale1. You can control these using
            // localectl set-x11-keymap.

            // omarchy's compose setup (input.lua: kb_options): CapsLock is
            // the Compose key; plain CapsLock moves to pressing both Shifts
            // at once (and clears itself the same way). Delete this line to
            // fall back to the localectl defaults.
            options "compose:caps,shift:both_capslock_cancel"
        }

        // Enable numlock on startup, omitting this setting disables it.
        numlock

        // Omarchy-matched key repeat: snappier than the 600/25 default.
        repeat-delay 250
        repeat-rate 40
    }

    // Next sections include libinput settings.
    // Omitting settings disables them, or leaves them at their default values.
    // All commented-out settings here are examples, not defaults.
    touchpad {
        // off
        tap
        // Palm-brush guard while typing — Hyprland ships this on (omarchy
        // inherits it); niri's default is off.
        dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // Mac-style whole-pad clicks (omarchy: clickfinger_behavior).
        click-method "clickfinger"
        // omarchy: scroll_factor 0.4 — without it two-finger scrolling runs
        // ~2.5× faster than the Arch setup did.
        scroll-factor 0.4
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // Uncomment this to make the mouse warp to the center of newly focused windows.
    // warp-mouse-to-focus

    // Focus windows and outputs automatically when moving the mouse into them.
    // "0%" = only when it would not scroll the view (omarchy: follow_mouse 1).
    focus-follows-mouse max-scroll-amount="0%"
}

// You can configure outputs by their name, which you can find
// by running `niri msg outputs` while inside a niri instance.
// The config is shared across machines (symlinked, not templated): output
// sections are machine-scoped by construction — eDP-1 is the MacBook's
// built-in panel and simply doesn't exist on the Mac mini or the NUC.
output "eDP-1" {
    // Pinned to what niri was auto-picking anyway (2560x1600 at 227 DPI →
    // logical 1706x1066), so an upstream heuristic change can't reshape the
    // desktop.
    scale 1.5

    // On the small panel, new windows take the full width instead of the
    // global half-width default in the layout section below — per-output
    // layout overrides merge over the shared one, and deliberately don't
    // follow the MacBook to an external monitor.
    layout {
        default-column-width { proportion 1.0; }
    }
}

// The NUC's display. niri's auto-scale heuristic reads its DPI and picks a
// fractional scale, which is wrong for this monitor at this viewing distance
// — pin it to 1 (2026-08-10). Mode stays auto: only the scale was ever wrong.
output "DP-3" {
    scale 1
}

// Settings that influence how windows are positioned and sized.
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Layout
layout {
    // Set gaps around windows in logical pixels.
    // Omarchy feel: gaps_in 5 (= 10 px between windows) / gaps_out 10, and
    // niri's `gaps N` is N between columns AND to the screen edge — so 10
    // is an exact translation.
    gaps 10

    // When to center a column when changing focus, options are:
    // - "never", default behavior, focusing an off-screen column will keep at the left
    //   or right edge of the screen.
    // - "always", the focused column will always be centered.
    // - "on-overflow", focusing a column will center it if it doesn't fit
    //   together with the previously focused column.
    center-focused-column "never"

    // You can customize the widths that "switch-preset-column-width" (Mod+R) toggles between.
    preset-column-widths {
        // Proportion sets the width as a fraction of the output width, taking gaps into account.
        // For example, you can perfectly fit four windows sized "proportion 0.25" on an output.
        // The default preset widths are 1/3, 1/2 and 2/3 of the output.
        proportion 0.33333
        proportion 0.5
        proportion 0.66667

        // Fixed sets the width in logical pixels exactly.
        // fixed 1920
    }

    // You can also customize the heights that "switch-preset-window-height" (Mod+Ctrl+Shift+R) toggles between.
    // preset-window-heights { }

    // You can change the default width of the new windows.
    default-column-width { proportion 0.5; }
    // If you leave the brackets empty, the windows themselves will decide their initial width.
    // default-column-width {}

    // By default focus ring and border are rendered as a solid background rectangle
    // behind windows. That is, they will show up through semitransparent windows.
    // This is because windows using client-side decorations can have an arbitrary shape.
    //
    // If you don't like that, you should uncomment `prefer-no-csd` below.
    // Niri will draw focus ring and border *around* windows that agree to omit their
    // client-side decorations.
    //
    // Alternatively, you can override it with a window rule called
    // `draw-border-with-background`.

    // Border (below) plays the omarchy role: drawn around every window.
    // The focus ring would double up with it, so it's off.
    focus-ring {
        off

        // How many logical pixels the ring extends out from the windows.
        width 4

        // Colors can be set in a variety of ways:
        // - CSS named colors: "red"
        // - RGB hex: "#rgb", "#rgba", "#rrggbb", "#rrggbbaa"
        // - CSS-like notation: "rgb(255, 127, 0)", rgba(), hsl() and a few others.

        // Color of the ring on the active monitor.
        active-color "#7fc8ff"

        // Color of the ring on inactive monitors.
        //
        // The focus ring only draws around the active window, so the only place
        // where you can see its inactive-color is on other monitors.
        inactive-color "#505050"

        // You can also use gradients. They take precedence over solid colors.
        // Gradients are rendered the same as CSS linear-gradient(angle, from, to).
        // The angle is the same as in linear-gradient, and is optional,
        // defaulting to 180 (top-to-bottom gradient).
        // You can use any CSS linear-gradient tool on the web to set these up.
        // Changing the color space is also supported, check the wiki for more info.
        //
        // active-gradient from="#80c8ff" to="#c7ff7f" angle=45

        // You can also color the gradient relative to the entire view
        // of the workspace, rather than relative to just the window itself.
        // To do that, set relative-to="workspace-view".
        //
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // You can also add a border. It's similar to the focus ring, but always visible.
    // Omarchy: border_size 2 on all windows. Colors here are fallbacks —
    // the theme include at the end of this file overrides them per theme.
    border {
        width 2
        active-color "#7aa2f7"
        inactive-color "#2f3549"

        // Color of the border around windows that request your attention.
        urgent-color "#f7768e"

        // Gradients can use a few different interpolation color spaces.
        // For example, this is a pastel rainbow gradient via in="oklch longer hue".
        //
        // active-gradient from="#e5989b" to="#ffb4a2" angle=45 relative-to="workspace-view" in="oklch longer hue"

        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // You can enable drop shadows for windows.
    shadow {
        // Uncomment the next line to enable shadows.
        // on

        // By default, the shadow draws only around its window, and not behind it.
        // Uncomment this setting to make the shadow draw behind its window.
        //
        // Note that niri has no way of knowing about the CSD window corner
        // radius. It has to assume that windows have square corners, leading to
        // shadow artifacts inside the CSD rounded corners. This setting fixes
        // those artifacts.
        //
        // However, instead you may want to set prefer-no-csd and/or
        // geometry-corner-radius. Then, niri will know the corner radius and
        // draw the shadow correctly, without having to draw it behind the
        // window. These will also remove client-side shadows if the window
        // draws any.
        //
        // draw-behind-window true

        // You can change how shadows look. The values below are in logical
        // pixels and match the CSS box-shadow properties.

        // Softness controls the shadow blur radius.
        softness 30

        // Spread expands the shadow.
        spread 5

        // Offset moves the shadow relative to the window.
        offset x=0 y=5

        // You can also change the shadow color and opacity.
        color "#0007"
    }

    // Struts shrink the area occupied by windows, similarly to layer-shell panels.
    // You can think of them as a kind of outer gaps. They are set in logical pixels.
    // Left and right struts will cause the next window to the side to always be visible.
    // Top and bottom struts will simply add outer gaps in addition to the area occupied by
    // layer-shell panels and regular gaps.
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

// Add lines like this to spawn processes at startup.
// Note that running niri as a session supports xdg-desktop-autostart,
// which may be more convenient to use.
// See the binds section below for more spawn examples.

// The shell (quickshell) is NOT spawned here: it runs as a supervised
// systemd user service bound to the session (qshell.service, enabled by
// chezmoi's run_after_02-user-timers.sh) — the wiki's Example-systemd-Setup
// shape. Restart it with `systemctl --user restart qshell`.

// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"

hotkey-overlay {
    // No hotkey pop-up at login, and hide actions that have no bind.
    skip-at-startup
    hide-not-bound
}

// Uncomment this line to ask the clients to omit their client-side decorations if possible.
// If the client will specifically ask for CSD, the request will be honored.
// Additionally, clients will be informed that they are tiled, removing some client-side rounded corners.
// This option will also fix border/focus ring drawing behind some semitransparent windows.
// After enabling or disabling this, you need to restart the apps for this to take effect.
// Required for borders to draw *around* windows (not as a rect behind them)
// and for correct shadows/rounded corners.
prefer-no-csd

// Hide the cursor while typing and after 5 s idle.
cursor {
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 5000
}

// You can change the path where screenshots are saved.
// A ~ at the front will be expanded to the home directory.
// The path is formatted with strftime(3) to give you the screenshot date and time.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// You can also set this to null to disable saving screenshots to disk.
// screenshot-path null

// Animation settings.
// The wiki explains how to configure individual animations:
// https://niri-wm.github.io/niri/Configuration:-Animations
animations {
    // Uncomment to turn off all animations.
    // off

    // Slow down all animations by this factor. Values below 1 speed them up instead.
    // slowdown 3.0

    // Omarchy's timing, translated. easeOutQuint = cubic-bezier(0.23 1 0.32 1)
    // is its signature curve; windowsIn 410 ms, windowsOut 149 ms linear.
    window-open {
        duration-ms 400
        curve "cubic-bezier" 0.23 1 0.32 1
    }

    window-close {
        duration-ms 150
        curve "linear"
    }

    // Keep these three identical — niri drives synchronized animations from
    // whichever one is "in charge", and mismatched params look broken.
    window-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    // Snappier than default; springs track touchpad swipe velocity.
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.0001
    }

    // Default is stiffness 800 — matched to the window springs above so the
    // overview zoom snaps with the same character as everything else.
    overview-open-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.001
    }

    // Default is ease-out-quad; use the signature curve instead.
    screenshot-ui-open {
        duration-ms 200
        curve "cubic-bezier" 0.23 1 0.32 1
    }

    // config-notification-open-close and exit-confirmation-open-close stay at
    // their bouncy underdamped defaults on purpose — rare surfaces where the
    // wobble reads as intentional, not as lag.
}

// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Picture-in-picture players float pinned to the top-right — omarchy's
// pip.lua geometry (600×338, 40 px off the right edge, ~4% down). The title
// regex is omarchy's, unanchored: it catches Firefox ("Picture-in-Picture")
// and Chromium ("Picture in picture") alike. niri can't pin across
// workspaces or lock the aspect ratio; the opacity exemption lives in the
// media rule after the global opacity pair below.
window-rule {
    match title=r#"Picture.?in.?[Pp]icture"#
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 338; }
    default-floating-position x=40 y=43 relative-to="top-right"
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// Rounded corners come from the theme include at the end of this file
// (the radius is a theme token). These two rules are omarchy's window
// opacity: 0.985 active / 0.96 inactive.
window-rule {
    opacity 0.985
}

window-rule {
    match is-active=false
    opacity 0.96
}

// The shell's helper terminals (nmtui, bluetoothctl, voxtype configure, …)
// launch as `foot --app-id=qshell-float` and expect omarchy's floating
// treatment (system.lua: float + center + 875×600). niri opens floating
// windows centered, so geometry is all that needs stating.
window-rule {
    match app-id="^qshell-float$"
    open-floating true
    default-column-width { fixed 875; }
    default-window-height { fixed 600; }
}

// bin/tui-install's launcher entries (omarchy's TUI.float/TUI.tile app-id
// convention): float gets the qshell-float treatment above, tile opens as a
// normal column and needs no rule. Desktop file and window rule are a
// matched pair — change one, change both.
window-rule {
    match app-id=r#"^TUI\.float$"#
    open-floating true
    default-column-width { fixed 875; }
    default-window-height { fixed 600; }
}

// omarchy's floating-window tag (system.lua) also covers the media viewers:
// mpv, imv and Evince open floating at the same 875×600 — zathura joins them
// as the Evince replacement. omacalc floats in omarchy untagged — no forced
// geometry, it sizes itself.
window-rule {
    match app-id="^mpv$"
    match app-id="^imv$"
    match app-id=r#"^org\.gnome\.Evince$"#
    match app-id=r#"^org\.pwmt\.zathura$"#
    open-floating true
    default-column-width { fixed 875; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="^omacalc$"
    open-floating true
    // Compact portrait-calculator size — left to itself the app opens far
    // too big (user call 2026-08-07).
    default-column-width { fixed 360; }
    default-window-height { fixed 540; }
}

// OAuth/sign-in popups (window.open) share the browser's app-id, so the
// initial title is the only handle (observed live: "Sign in - Google
// Accounts - Chromium"). Safe from false positives on the main window:
// open-floating is evaluated once at open, and main windows open as
// "New Tab"/session titles — navigating to a sign-in page later doesn't
// re-trigger it. Floating popups keep their window.open size, no forced
// geometry. (user ask 2026-08-07; not an omarchy port — omarchy force-
// tiles chromium windows outright)
window-rule {
    match app-id="^chromium-browser$" title=r#"(?i)^(sign in|sign up|log in|login|authoriz|authenticat|continue with|verify)"#
    open-floating true
}

// Chromium's screen-share indicator strip ("… is sharing your screen") opens
// as a real window and would take a whole tile in the scrolling layout.
// omarchy shunts it to a silent special workspace; niri has none, so it
// floats unfocused against the bottom edge instead — visible, out of the way,
// and the column layout never moves. (omarchy gap item 8)
window-rule {
    match app-id="^chromium-browser$" title=r#"(?i)is sharing (your screen|a window|this tab)"#
    open-floating true
    open-focused false
    default-floating-position x=0 y=8 relative-to="bottom"
}

// omarchy scrolls terminals 1.5× (input.lua: scroll_touchpad), multiplied
// on top of the touchpad scroll-factor in the input section. Every foot
// window carries it, whatever app-id the launcher stamped on it: plain foot,
// the qshell-float helpers, the singleton tmux terminal, and TUI desktop
// entries (bin/tui-install's TUI.float / TUI.tile).
window-rule {
    match app-id="^foot$"
    match app-id="^qshell-float$"
    match app-id="^tmux-main$"
    match app-id=r#"^TUI\.(float|tile)$"#
    scroll-factor 1.5
}

// No transparency on media windows (omarchy system.lua's list) nor on PiP
// players (pip.lua forces opacity 1). Deliberately the last opacity rule:
// for a contested property, the latest matching rule wins.
window-rule {
    match app-id=r#"^(zoom|vlc|mpv|org\.kde\.kdenlive|com\.obsproject\.Studio|com\.github\.PintaProject\.Pinta|imv)$"#
    match title=r#"Picture.?in.?[Pp]icture"#
    opacity 1.0
}

binds {
    // Keys consist of modifiers separated by + signs, followed by an XKB key name
    // in the end. To find an XKB name for a particular key, you may use a program
    // like wev.
    //
    // "Mod" is a special modifier equal to Super when running on a TTY, and to Alt
    // when running as a winit window.
    //
    // Most actions that you can bind here can also be invoked programmatically with
    // `niri msg action do-something`.

    // Mod-Shift-/, which is usually the same as Mod-?,
    // shows a list of important hotkeys.
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Suggested binds for running programs: terminal, app launcher, screen locker.
    // bin/foot-run = footclient -N against the socket-activated foot server
    // (shared glyph caches, instant spawn), plain foot only if the socket is
    // broken. Every terminal spawn below and in the shell goes through it.
    Mod+T hotkey-overlay-title="Open a Terminal: foot" { spawn "foot-run"; }
    // omarchy's core app chords. Browser on both of their chords
    // (SUPER+SHIFT+RETURN and SUPER+SHIFT+B), Alt for a private window;
    // chromium-browser is Fedora's binary name, and CHROMIUM_USER_FLAGS
    // already carries the wayland flags.
    Mod+Shift+Return hotkey-overlay-title="Open the Browser" { spawn "app-run" "chromium-browser"; }
    // Focus-not-spawn variant: raises the newest existing browser window and
    // only launches when there is none (bin/launch-or-focus, omarchy's
    // launch-or-focus semantics). Mod+Shift+Return above stays a plain spawn
    // so a second window is always one keypress away.
    Mod+Shift+B hotkey-overlay-title="Focus the Browser" { spawn "launch-or-focus" "chromium-browser" "chromium-browser"; }
    Mod+Shift+Alt+B hotkey-overlay-title="Browser (Incognito)" { spawn "chromium-browser" "--incognito"; }
    // omarchy: SUPER+SHIFT+F file manager — taken by fullscreen-window here,
    // so the explorer key instead. Same yazi-in-foot as yazi.desktop.
    // Floating via the qshell-float rule, like btop and the shell's helpers.
    Mod+E hotkey-overlay-title="File Manager: yazi" { spawn "foot-run" "--app-id=qshell-float" "yazi"; }
    // omarchy: SUPER+SHIFT+N editor — $EDITOR (kak) in a foot window.
    Mod+Shift+N hotkey-overlay-title="Editor: kak" { spawn "foot-run" "kak"; }
    // Emacs: raise the daemon's existing frame or make one — the same
    // emacsclient invocation as the emacs.desktop override, so the key and
    // the launcher entry behave identically (user ask 2026-08-07).
    // launch-or-focus first: emacsclient --reuse-frame reuses a FRAME inside
    // Emacs but does not reliably raise the niri window under Wayland —
    // focusing through the compositor does, and the emacsclient path still
    // runs when no Emacs window exists yet.
    Mod+N hotkey-overlay-title="Editor: Emacs" { spawn "launch-or-focus" "emacs" "emacsclient" "--reuse-frame" "--alternate-editor="; }
    // omarchy: SUPER+ALT+RETURN tmux terminal — attach-or-create "main".
    // The "main" tmux session is a singleton by design (new-session -A), so
    // the window is too: a distinct app-id lets launch-or-focus raise the
    // existing terminal instead of stacking a second client on the session.
    Mod+Alt+Return hotkey-overlay-title="Terminal: tmux" { spawn "launch-or-focus" "tmux-main" "foot-run" "--app-id=tmux-main" "tmux" "new-session" "-A" "-s" "main"; }
    Mod+D hotkey-overlay-title="Run an Application" { spawn "qs" "ipc" "call" "launcher" "toggle"; }
    Mod+Space hotkey-overlay-title="Open the Menu" { spawn "qs" "ipc" "call" "menu" "toggle"; }
    // Omarchy's SUPER+ALT+SPACE apps-menu bind (b92510f). Our menu has no
    // app rows — its Apps row hands off to the launcher, as Mod+D does — so
    // this summons the launcher directly.
    Mod+Alt+Space hotkey-overlay-title="Run an Application" { spawn "qs" "ipc" "call" "launcher" "toggle"; }
    Mod+Shift+T hotkey-overlay-title="Switch Theme" { spawn "qs" "ipc" "call" "theme" "toggle"; }
    // Omarchy's own emoji bind (SUPER+CTRL+E). Their commented-out
    // SUPER+PERIOD alternative is unavailable here: Mod+Period is niri's
    // expel-window-from-column.
    Mod+Ctrl+E hotkey-overlay-title="Pick an Emoji" { spawn "qs" "ipc" "call" "emojis" "toggle"; }
    // Omarchy's own clipboard bind (SUPER+CTRL+V), which is also the only key
    // left: Mod+V is toggle-window-floating and Mod+Shift+V is
    // switch-focus-between-floating-and-tiling, both niri defaults we keep.
    Mod+Ctrl+V hotkey-overlay-title="Clipboard History" { spawn "qs" "ipc" "call" "clipboard" "toggle"; }
    // Omarchy has no keybind for their background switcher at all (menu only);
    // Mod+Ctrl+B was the free key next to the other picker binds.
    Mod+Ctrl+B hotkey-overlay-title="Pick a Wallpaper" { spawn "qs" "ipc" "call" "wallpaper" "toggle"; }
    // Omarchy: SUPER+CTRL+B summons their bluetooth panel — that chord is the
    // wallpaper picker above (established first, kept), so bluetooth takes
    // the Shift variant. Same toggle semantics as theirs, on the ported
    // `bluetooth` IPC target.
    Mod+Ctrl+Shift+B hotkey-overlay-title="Bluetooth Panel" { spawn "qs" "ipc" "call" "bluetooth" "toggle"; }
    // The rest of omarchy's SUPER+CTRL panel chords, same letters, on the
    // bar's summon-widget IPC (focused-output-first, like their
    // summonBarWidget).
    Mod+Ctrl+A hotkey-overlay-title="Audio Panel" { spawn "qs" "ipc" "call" "bar" "open" "audio"; }
    Mod+Ctrl+W hotkey-overlay-title="Network Panel" { spawn "qs" "ipc" "call" "bar" "open" "network"; }
    Mod+Ctrl+P hotkey-overlay-title="Power Panel" { spawn "qs" "ipc" "call" "bar" "open" "battery"; }
    Mod+Ctrl+D hotkey-overlay-title="Display Panel" { spawn "qs" "ipc" "call" "bar" "open" "monitor"; }
    Mod+Ctrl+Alt+D hotkey-overlay-title="Calendar" { spawn "qs" "ipc" "call" "bar" "open" "clock"; }
    // omarchy: SUPER+SHIFT+CTRL+A agent — the bar's AI panel.
    Mod+Shift+Ctrl+A hotkey-overlay-title="AI Panel" { spawn "qs" "ipc" "call" "bar" "open" "ai"; }
    // omarchy: SUPER+CTRL+T btop, floating via the qshell-float rule.
    Mod+Ctrl+T hotkey-overlay-title="System Monitor: btop" { spawn "foot-run" "--app-id=qshell-float" "btop"; }
    // Ours: omarchy has no radio and no music picker at all — their music
    // story is a Spotify package with no aarch64 build (bin/radio's header).
    // Mod+Ctrl+M and its Shift variant were the free keys beside the other
    // Mod+Ctrl pickers. Both open a menu-select; playback then lands in the
    // bar's media widget like any MPRIS player, so the XF86Audio* binds
    // below already control it.
    Mod+Ctrl+M hotkey-overlay-title="Radio" { spawn "radio"; }
    Mod+Ctrl+Shift+M hotkey-overlay-title="Play Music" { spawn "music"; }
    // omarchy: XF86Calculator → their calculator; ours is omacalc. (Their
    // SUPER+SHIFT+EQUAL alternative is set-window-height here.)
    XF86Calculator hotkey-overlay-title="Calculator" { spawn "omacalc"; }
    // omarchy: SUPER+BACKSPACE toggles the focused window's transparency
    // (against the 0.985/0.96 opacity rules below).
    Mod+BackSpace hotkey-overlay-title="Toggle Window Opacity" { toggle-window-rule-opacity; }
    Super+Alt+L hotkey-overlay-title="Lock the Screen" { spawn "qs" "ipc" "call" "lock" "lock"; }
    // Omarchy's notification binds all hang off comma (dismiss last on
    // SUPER+comma, history on SUPER+SHIFT+ALT+comma). Mod+Comma is niri's
    // consume-window-into-column, a default we keep, so dismiss-last takes
    // the Alt variant — which is their invokeLast chord, left unbound here
    // because clicking a toast already invokes its default action.
    Mod+Alt+Comma hotkey-overlay-title="Dismiss Last Notification" { spawn "qs" "ipc" "call" "notifs" "dismissOne"; }
    Mod+Shift+Alt+Comma hotkey-overlay-title="Show Notification History" { spawn "qs" "ipc" "call" "notifs" "showHistory"; }
    Mod+Shift+Comma hotkey-overlay-title="Dismiss All Notifications" { spawn "qs" "ipc" "call" "notifs" "dismissAll"; }
    Mod+Ctrl+Comma hotkey-overlay-title="Toggle Do Not Disturb" { spawn "qs" "ipc" "call" "notifs" "toggleDnd"; }
    // Ours: the review panel over the same history the replay bind pops as
    // toasts — the last free chord in the comma family.
    Mod+Ctrl+Alt+Comma hotkey-overlay-title="Notification Center" { spawn "qs" "ipc" "call" "notifs" "toggle"; }

    // The rest of omarchy's utility chords (2026-08-06 parity audit), each on
    // the nearest free key where the upstream chord is a niri default we keep.
    // Omarchy: SUPER+CTRL+C — Mod+Ctrl+C is niri's center-visible-columns, so
    // the capture menu takes Shift.
    Mod+Shift+C hotkey-overlay-title="Capture Menu" { spawn "qs" "ipc" "call" "menu" "open" "capture"; }
    Mod+Ctrl+O hotkey-overlay-title="Toggles Menu" { spawn "qs" "ipc" "call" "menu" "open" "toggle"; }
    // Omarchy: SUPER+ESCAPE — taken by niri's toggle-keyboard-shortcuts-inhibit;
    // the power key opens the system menu instead, which is also their bind.
    XF86PowerOff hotkey-overlay-title="System Menu" { spawn "qs" "ipc" "call" "menu" "open" "system"; }
    Mod+Shift+Space hotkey-overlay-title="Toggle the Bar" { spawn "qs" "ipc" "call" "bar" "toggle"; }
    // Omarchy: SUPER+CTRL+I — taken by niri's move-column-to-workspace-up.
    Mod+Ctrl+Alt+I hotkey-overlay-title="Toggle Idle Locking" { spawn "qs" "ipc" "call" "idle" "toggle"; }
    Mod+Ctrl+N hotkey-overlay-title="Toggle Night Light" { spawn "qs" "ipc" "call" "nightlight" "toggle"; }
    // Omarchy's reminder family hangs off SUPER+CTRL+R; Mod+Ctrl+R and
    // Mod+Ctrl+Shift+R are niri's window-height defaults, so ours take Alt.
    Mod+Alt+R hotkey-overlay-title="Set a Reminder" { spawn "qs" "ipc" "call" "reminders" "toggle"; }
    Mod+Ctrl+Alt+R hotkey-overlay-title="Show Reminders" { spawn "reminder" "show"; }
    Mod+Alt+Shift+R hotkey-overlay-title="Clear Reminders" { spawn "reminder" "clear"; }

    // Voice dictation (voxtype), state shown by the bar's dictation indicator.
    // Omarchy's own toggle chord is SUPER+CTRL+X; Ctrl+X is free here.
    //
    // Their second bind is F9 as push-to-talk — press starts, and a separate
    // `release = true` bind stops. niri has no release binds: a bind takes
    // repeat, cooldown-ms, allow-when-locked, allow-inhibiting and
    // hotkey-overlay-title, and nothing else (niri-config/src/binds.rs), so
    // hold-to-talk cannot be expressed. F9 is therefore a second toggle, which
    // is also why both binds set repeat=false — key repeat on a toggle would
    // flap the recorder while the key is held.
    // These spawn bin/voxtype-toggle rather than `voxtype record toggle`
    // because the daemon is no longer running when idle: it preloads its
    // whisper model, which costs 486 MB resident for nothing, so it is
    // disabled at login and stopped again after ~10 min idle by
    // voxtype-idle-stop.timer. The wrapper starts it (0.20 s) and then
    // toggles; `voxtype record toggle` on its own just errors when the daemon
    // is down. Full reasoning in bin/voxtype-toggle.
    Mod+Ctrl+X repeat=false hotkey-overlay-title="Toggle Dictation" { spawn "voxtype-toggle"; }
    F9 repeat=false hotkey-overlay-title="Toggle Dictation" { spawn "voxtype-toggle"; }

    // Use spawn-sh to run a shell command. Do this if you need pipes, multiple commands, etc.
    // Note: the entire command goes as a single argument. It's passed verbatim to `sh -c`.
    // The stock niri screen-reader bind (Super+Alt+S → orca) is pruned: orca
    // is not installed here and a dead bind is worse than none (audit
    // 2026-08-07). Reinstate alongside an `orca` manifest entry if needed.

    // Example volume keys mappings for PipeWire & WirePlumber.
    // The allow-when-locked=true property makes them work even when the session is locked.
    // Using spawn-sh allows to pass multiple arguments together with the command.
    // "-l 1.0" limits the volume to 100%.
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    // omarchy's precise ±1% steps on the Alt variants.
    Alt+XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01+ -l 1.0"; }
    Alt+XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01-"; }

    // Media keys route through the shell's MPRIS service (no playerctl).
    XF86AudioPlay        allow-when-locked=true { spawn "qs" "ipc" "call" "media" "playPause"; }
    // Omarchy's Alt variants of the play key step tracks.
    Alt+XF86AudioPlay       allow-when-locked=true { spawn "qs" "ipc" "call" "media" "next"; }
    Alt+Shift+XF86AudioPlay allow-when-locked=true { spawn "qs" "ipc" "call" "media" "previous"; }
    XF86AudioStop        allow-when-locked=true { spawn "qs" "ipc" "call" "media" "stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn "qs" "ipc" "call" "media" "previous"; }
    XF86AudioNext        allow-when-locked=true { spawn "qs" "ipc" "call" "media" "next"; }
    // The dedicated pause key (omarchy binds it alongside play)…
    XF86AudioPause       allow-when-locked=true { spawn "qs" "ipc" "call" "media" "playPause"; }
    // …and their Shift variants rotate which player the media keys control.
    Shift+XF86AudioPause allow-when-locked=true { spawn "qs" "ipc" "call" "media" "sourceSwitch"; }
    Shift+XF86AudioPlay  allow-when-locked=true { spawn "qs" "ipc" "call" "media" "sourceSwitch"; }

    // All brightness keys route through bin/brightness-display (omarchy gap
    // item 1, their omarchy-brightness-display port): internal panels ride
    // brightnessctl exactly as before, external connectors go DDC/CI — the
    // Mac mini's HDMI monitor gains working brightness keys. The script
    // raises the OSD itself (incl. the Shift/Alt variants that used to skip
    // it); the old `osd brightnessUp/Down` IPC stays as a compat path.
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightness-display" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightness-display" "5%-"; }
    // omarchy's brightness extremes and precise ±1% steps.
    Shift+XF86MonBrightnessUp   allow-when-locked=true { spawn "brightness-display" "100%"; }
    Shift+XF86MonBrightnessDown allow-when-locked=true { spawn "brightness-display" "1%"; }
    Alt+XF86MonBrightnessUp     allow-when-locked=true { spawn "brightness-display" "+1%"; }
    Alt+XF86MonBrightnessDown   allow-when-locked=true { spawn "brightness-display" "1%-"; }
    // Keyboard backlight — this MacBook's kbd_backlight LED, through
    // bin/brightness-keyboard (omarchy's omarchy-brightness-keyboard) so the
    // keys raise the OSD the display keys already do, and so the blank paths
    // can park the level with the same script. Upstream also binds the cycle
    // key (XF86KbdLightOnOff); Apple keyboards have no such key, so the
    // script's `cycle` verb stays unbound here.
    XF86KbdBrightnessUp   allow-when-locked=true { spawn "brightness-keyboard" "up"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "brightness-keyboard" "down"; }

    // Open/close the Overview: a zoomed-out view of workspaces and windows.
    // You can also move the mouse into the top-left hot corner,
    // or do a four-finger swipe up on a touchpad.
    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    // Alternative commands that move across workspaces when reaching
    // the first or last window in a column.
    // Mod+J     { focus-window-or-workspace-down; }
    // Mod+K     { focus-window-or-workspace-up; }
    // Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    // Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // Alternatively, there are commands to move just a single window:
    // Mod+Shift+Ctrl+Left  { move-window-to-monitor-left; }
    // ...

    // omarchy: SUPER+SHIFT+ALT+arrows move the whole workspace to another
    // monitor (the same chord on numbers is the silent column move below).
    Mod+Shift+Alt+Left  { move-workspace-to-monitor-left; }
    Mod+Shift+Alt+Down  { move-workspace-to-monitor-down; }
    Mod+Shift+Alt+Up    { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+Right { move-workspace-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // Alternatively, there are commands to move just a single window:
    // Mod+Ctrl+Page_Down { move-window-to-workspace-down; }
    // ...

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // You can bind mouse wheel scroll ticks using the following syntax.
    // These binds will change direction based on the natural-scroll setting.
    //
    // To avoid scrolling through workspaces really fast, you can use
    // the cooldown-ms property. The bind will be rate-limited to this value.
    // You can set a cooldown on any bind, but it's most useful for the wheel.
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Usually scrolling up and down with Shift in applications results in
    // horizontal scrolling; these binds replicate that.
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Similarly, you can bind touchpad scroll "ticks".
    // Touchpad scrolling is continuous, so for these binds it is split into
    // discrete intervals.
    // These binds are also affected by touchpad's natural-scroll, so these
    // example binds are "inverted", since we have natural-scroll enabled for
    // touchpads by default.
    // Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    // Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }

    // You can refer to workspaces by index. However, keep in mind that
    // niri is a dynamic workspace system, so these commands are kind of
    // "best effort". Trying to refer to a workspace index bigger than
    // the current workspace count will instead refer to the bottommost
    // (empty) workspace.
    //
    // For example, with 2 workspaces + 1 empty, indices 3, 4, 5 and so on
    // will all refer to the 3rd workspace.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    // omarchy runs workspaces 1..10; 0 is the tenth.
    Mod+0      { focus-workspace 10; }
    Mod+Ctrl+0 { move-column-to-workspace 10; }

    // omarchy: SUPER+SHIFT+ALT+number moves the column without following it.
    Mod+Shift+Alt+1 { move-column-to-workspace 1 focus=false; }
    Mod+Shift+Alt+2 { move-column-to-workspace 2 focus=false; }
    Mod+Shift+Alt+3 { move-column-to-workspace 3 focus=false; }
    Mod+Shift+Alt+4 { move-column-to-workspace 4 focus=false; }
    Mod+Shift+Alt+5 { move-column-to-workspace 5 focus=false; }
    Mod+Shift+Alt+6 { move-column-to-workspace 6 focus=false; }
    Mod+Shift+Alt+7 { move-column-to-workspace 7 focus=false; }
    Mod+Shift+Alt+8 { move-column-to-workspace 8 focus=false; }
    Mod+Shift+Alt+9 { move-column-to-workspace 9 focus=false; }
    Mod+Shift+Alt+0 { move-column-to-workspace 10 focus=false; }

    // Alternatively, there are commands to move just a single window:
    // Mod+Ctrl+1 { move-window-to-workspace 1; }

    // Switches focus between the current and the previous workspace.
    // omarchy: SUPER+CTRL+TAB (plain Mod+Tab belongs to niri's built-in
    // recent-windows switcher).
    Mod+Ctrl+Tab { focus-workspace-previous; }

    // The following binds move the focused window in and out of a column.
    // If the window is alone, they will consume it into the nearby column to the side.
    // If the window is already in a column, they will expel it out.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Consume one window from the right to the bottom of the focused column.
    Mod+Comma  { consume-window-into-column; }
    // Expel the bottom window from the focused column to the right.
    Mod+Period { expel-window-from-column; }

    // Cycle through widths set in preset-column-widths.
    Mod+R { switch-preset-column-width; }
    // Cycling through the presets in reverse order is also possible.
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // While maximize-column leaves gaps and borders around the window,
    // maximize-window-to-edges doesn't: the window expands to the edges of the screen.
    // This bind corresponds to normal window maximizing,
    // e.g. by double-clicking on the titlebar.
    Mod+M { maximize-window-to-edges; }

    // Expand the focused column to space not taken up by other fully visible columns.
    // Makes the column "fill the rest of the space".
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }

    // Center all fully visible columns on screen.
    Mod+Ctrl+C { center-visible-columns; }

    // Finer width adjustments.
    // This command can also:
    // * set width in pixels: "1000"
    // * adjust width in pixels: "-5" or "+5"
    // * set width as a percentage of screen width: "25%"
    // * adjust width as a percentage of screen width: "-10%" or "+10%"
    // Pixel sizes use logical, or scaled, pixels. I.e. on an output with scale 2.0,
    // set-column-width "100" will make the column occupy 200 physical screen pixels.
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Finer height adjustments when in column with other windows.
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Move the focused window between the floating and the tiling layout.
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Toggle tabbed column display mode.
    // Windows in this column will appear as vertical tabs,
    // rather than stacked on top of each other.
    Mod+W { toggle-column-tabbed-display; }

    // Actions to switch layouts.
    // Note: if you uncomment these, make sure you do NOT have
    // a matching layout switch hotkey configured in xkb options above.
    // Having both at once on the same hotkey will break the switching,
    // since it will switch twice upon pressing the hotkey (once by xkb, once by niri).
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }

    Print { spawn "omasnap"; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    // The annotate/OCR flow from the pre-qshell dotfiles-linux (satty on the
    // capture, slurp + tesseract for text). niri's own captures above leave
    // the shot on the clipboard, which is what Mod+Shift+A reads.
    Shift+Print hotkey-overlay-title="Screenshot Region + Annotate" { spawn "sh" "-c" "screenshot-annotate --region"; }
    Mod+Shift+A hotkey-overlay-title="Annotate Last Capture" { spawn "sh" "-c" "screenshot-annotate"; }
    // Omarchy: SUPER+CTRL+PRINT — OCR, the same slot.
    Mod+Ctrl+Print hotkey-overlay-title="Extract Text (OCR)" { spawn "sh" "-c" "screenshot-ocr"; }
    // Read a region aloud (OCR → text-to-speech). Deliberately NOT Orca: a
    // screen reader walks AT-SPI widget trees, so it cannot see text baked
    // into images, video, canvas or PDFs — this reads the pixels themselves.
    Mod+Ctrl+Shift+Print hotkey-overlay-title="Read Region Aloud" { spawn "sh" "-c" "screenshot-ocr --speak"; }
    // Apple keyboards have NO Print key, so every Print bind above is dead on
    // this hardware — the macOS-style Mod+Shift+number family from the
    // pre-qshell dotfiles-linux is the reachable set (Cmd+Shift+3/4/5 muscle
    // memory; 6 = OCR as that repo had it, 7 = region → annotate, ours).
    Mod+Shift+3 hotkey-overlay-title="Screenshot: Full Screen" { screenshot-screen; }
    Mod+Shift+4 hotkey-overlay-title="Screenshot: Region (omasnap)" { spawn "omasnap"; }
    Mod+Shift+5 hotkey-overlay-title="Screenshot: Focused Window" { screenshot-window; }
    Mod+Shift+6 hotkey-overlay-title="Screenshot: OCR Region" { spawn "sh" "-c" "screenshot-ocr"; }
    Mod+Shift+7 hotkey-overlay-title="Screenshot: Region + Annotate" { spawn "sh" "-c" "screenshot-annotate --region"; }
    // Read-aloud rides the "6 = OCR" mnemonic with one extra modifier: same
    // pick, spoken instead of copied. 8/9/0 are the dynamic-cast family below,
    // so the Mod+Shift+number row is full — hence Mod+Ctrl+Shift here.
    Mod+Ctrl+Shift+6 hotkey-overlay-title="Read Region Aloud" { spawn "sh" "-c" "screenshot-ocr --speak"; }
    Mod+Ctrl+Shift+S hotkey-overlay-title="Stop Reading Aloud" { spawn "sh" "-c" "screenshot-ocr --stop"; }
    // Omarchy: ALT+PRINT — taken by screenshot-window above. Stops a running
    // recording, else opens the capture menu's Screenrecord submenu.
    Mod+Print hotkey-overlay-title="Screen Recording" { spawn "sh" "-c" "screenrecord --stop-recording || qs ipc call menu open screenrecording"; }

    // Dynamic cast target (niri >= 25.05): a screencast source that can be
    // re-pointed mid-call. Share "niri Dynamic Cast Target" once in the
    // portal dialog, then swap what the far end sees with these — no
    // renegotiation, so the meeting never drops the stream.
    //
    // A fresh dynamic cast deliberately starts EMPTY and transparent (niri
    // wiki, Screencasting § Dynamic screencast target — it refuses to inherit
    // the last target so a new call cannot leak the previous one). A blank
    // share is therefore the expected first state, not a fault: these binds
    // are the only way to fill it, which is why the feature looked dead while
    // nothing was bound to them. The red border from the theme include's
    // is-window-cast-target rule is the confirmation something is live.
    //
    // Continues the Mod+Shift+number capture family above, which exists
    // because Apple keyboards have no Print key; 8/9/0 were the free tail.
    Mod+Shift+8 hotkey-overlay-title="Cast: Focused Window" { set-dynamic-cast-window; }
    Mod+Shift+9 hotkey-overlay-title="Cast: Focused Monitor" { set-dynamic-cast-monitor; }
    Mod+Shift+0 hotkey-overlay-title="Cast: Blank Target" { clear-dynamic-cast-target; }
    // Click-to-pick variant of Mod+Shift+8, riding the same Mod+Ctrl+Shift+digit
    // "variant of that digit" shape as Read Region Aloud above. Worth having
    // because the plain bind takes whatever is FOCUSED at press time — and
    // right after you click Share, that is the browser, so the obvious press
    // casts the meeting window into itself. This one asks instead.
    // jq -e exits non-zero on a cancelled pick (empty input), so Escape is a
    // no-op rather than a set-target call with an empty --id.
    Mod+Ctrl+Shift+8 hotkey-overlay-title="Cast: Pick a Window" { spawn-sh "id=$(niri msg --json pick-window | jq -e -r .id) && niri msg action set-dynamic-cast-window --id \"$id\""; }

    // Applications such as remote-desktop clients and software KVM switches may
    // request that niri stops processing the keyboard shortcuts defined here
    // so they may, for example, forward the key presses as-is to a remote machine.
    // It's a good idea to bind an escape hatch to toggle the inhibitor,
    // so a buggy application can't hold your session hostage.
    //
    // The allow-inhibiting=false property can be applied to other binds as well,
    // which ensures niri always processes them, even when an inhibitor is active.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // The quit action will show a confirmation dialog to avoid accidental exits.
    // Ctrl+Alt+Delete used to quit too — dropped: in omarchy that chord
    // merely closes all windows (and niri has no close-all action), so
    // muscle memory would end the whole session.
    Mod+Shift+E { quit; }

    // Powers off the monitors. To turn them back on, do any input like
    // moving the mouse or pressing any other key.
    Mod+Shift+P { power-off-monitors; }
}

// Lid close = lock + all screens off, never suspend: Asahi never brings the
// display back after resume, and agentic sessions must keep the network up.
// niri already turns the internal panel off/on with the lid; the explicit
// power calls cover docked external monitors. The keyboard backlight goes
// with them (bin/brightness-keyboard) — a lit keyboard under a closed lid is
// the machine looking awake while it isn't. The logind half (lid/suspend
// keys ignored, sleep targets masked) is run_after_18-no-suspend.sh.
switch-events {
    lid-close { spawn "sh" "-c" "qs ipc call lock lock; niri msg action power-off-monitors; brightness-keyboard off"; }
    lid-open { spawn "sh" "-c" "niri msg action power-on-monitors; brightness-keyboard restore"; }
}

// Theme colors + corner radius, rendered by bin/theme-apply on every theme
// switch. Last so its settings override the fallbacks above. Optional so a
// fresh machine boots before the first theme-apply run.
include optional=true "~/.local/state/qshell/niri-theme.kdl"

// App-window blur, rendered by the shell's Blur service (`qs ipc call blur
// toggle`, or the menu's Style > Blur row). Off by default: the fragment is
// empty of rules until blur is enabled. After the theme include so its
// opacity rules override the 0.985/0.96 pair above while frosted.
include optional=true "~/.local/state/qshell/niri-blur.kdl"

// The shell's wallpaper joins the overview backdrop instead of zooming
// with workspaces.
layer-rule {
    match namespace="^qshell-background$"
    place-within-backdrop true
}

// Notification toasts never reach a screen-share (omarchy gap item 8):
// "screencast" blocks portal casts only — grim screenshots still see them,
// which the verification recipes in this repo depend on.
layer-rule {
    match namespace="^qshell-notifications$"
    block-out-from "screencast"
}
