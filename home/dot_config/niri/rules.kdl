// Shared with dev/niri-dev.kdl; Notes floats 420 px wide, docked to the right edge under the margin.
window-rule {
    match title="^Notes$" app-id="^org.quickshell$"
    open-floating true
    default-column-width { fixed 420; }
    default-window-height { proportion 0.9; }
    default-floating-position x=32 y=56 relative-to="top-right"
}
