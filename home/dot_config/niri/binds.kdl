// Shared with dev/niri-dev.kdl; Mod is Super (Cmd on Apple keyboards) on a TTY and Alt in a nested niri. Mod+key opens a thing, Mod+Shift+that key is its second action, and Mod+Ctrl moves windows and columns.
binds {
    Mod+Slash hotkey-overlay-title="Cheat Sheet" { spawn "dots-call" "cheatsheet" "toggle"; }
    Mod+Return hotkey-overlay-title="Open a Terminal: foot" { spawn "dots-foot"; }
    Mod+B hotkey-overlay-title="Browser: Chromium" { spawn "chromium-browser"; }
    Mod+E hotkey-overlay-title="Editor: kak" { spawn "dots-foot" "kak"; }
    Mod+Y repeat=false hotkey-overlay-title="Files" { spawn "dots-files"; }
    Mod+Shift+M hotkey-overlay-title="Mail: kak-mail" { spawn "mail-open" "Imbox"; }
    Mod+Space hotkey-overlay-title="Launcher" { spawn "dots-call" "launcher" "toggle"; }
    Mod+V hotkey-overlay-title="Clipboard" { spawn "dots-call" "launcher" "mode" "clipboard"; }
    Mod+Period hotkey-overlay-title="Emoji" { spawn "dots-call" "launcher" "mode" "emoji"; }
    Mod+C hotkey-overlay-title="Control" { spawn "dots-call" "control" "toggle"; }
    Mod+Shift+T hotkey-overlay-title="Themes" { spawn "dots-call" "themes" "toggle"; }
    Mod+A hotkey-overlay-title="Notifications" { spawn "dots-call" "notifs" "toggle"; }
    Mod+Shift+A hotkey-overlay-title="Clear Notifications" { spawn "dots-call" "notifs" "clear"; }
    Mod+D hotkey-overlay-title="Do Not Disturb" { spawn "dots-call" "notifs" "toggleDnd"; }
    Mod+I hotkey-overlay-title="Island" { spawn "dots-call" "island" "focus"; }
    Mod+N hotkey-overlay-title="Notes" { spawn "dots-call" "notes" "toggle"; }
    Mod+Shift+N hotkey-overlay-title="Pin Notes" { spawn "dots-call" "notes" "pin"; }
    Mod+S hotkey-overlay-title="Shelf" { spawn "dots-call" "notes" "shelf"; }
    Mod+G hotkey-overlay-title="Goals" { spawn "dots-call" "goals" "toggle"; }
    Mod+P hotkey-overlay-title="Pass" { spawn "dots-call" "pass" "toggle"; }
    Mod+T hotkey-overlay-title="Tailscale" { spawn "dots-call" "tailscale" "toggle"; }
    Mod+U hotkey-overlay-title="Accounts" { spawn "dots-call" "accounts" "toggle"; }
    Mod+Shift+D hotkey-overlay-title="DNS Shield" { spawn "dots-call" "dns" "toggle"; }
    Mod+Escape hotkey-overlay-title="Lock" { spawn "dots-call" "lock" "lock"; }
    Mod+Shift+Escape hotkey-overlay-title="System Monitor: btop" { spawn "dots-foot" "btop"; }
    Mod+Ctrl+Escape allow-inhibiting=false hotkey-overlay-title="Toggle Shortcut Inhibit" { toggle-keyboard-shortcuts-inhibit; }
    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+Q repeat=false hotkey-overlay-title="Close Window" { close-window; }
    Mod+Shift+Q hotkey-overlay-title="Quit niri" { quit; }
    Mod+Shift+P hotkey-overlay-title="Screens Off" { power-off-monitors; }

    // Apple keyboards have no Print key, so captures sit on Cmd+Shift+3, 4 and 5 as on a Mac.
    Print hotkey-overlay-title="Screenshot" { screenshot; }
    Mod+Shift+3 hotkey-overlay-title="Screenshot: Screen" { screenshot-screen; }
    Mod+Shift+4 hotkey-overlay-title="Screenshot: Region" { screenshot; }
    Mod+Shift+5 hotkey-overlay-title="Screenshot: Window" { screenshot-window; }
    Mod+Shift+6 hotkey-overlay-title="Copy Text from a Region" { spawn "dots-capture" "ocr"; }
    Mod+Shift+7 hotkey-overlay-title="Annotate a Region" { spawn "dots-capture" "annotate"; }
    Mod+Shift+R hotkey-overlay-title="Record a Region" { spawn "dots-call" "record" "toggle"; }
    Mod+Shift+8 hotkey-overlay-title="Cast: Focused Window" { set-dynamic-cast-window; }
    Mod+Shift+9 hotkey-overlay-title="Cast: Focused Screen" { set-dynamic-cast-monitor; }
    Mod+Shift+0 hotkey-overlay-title="Cast: Nothing" { clear-dynamic-cast-target; }

    // J and K go on into the next workspace at the edge of a column; the arrows, Home and End mirror the letters.
    Mod+H hotkey-overlay-title="Focus Column Left" { focus-column-left; }
    Mod+J hotkey-overlay-title="Focus Window or Workspace Down" { focus-window-or-workspace-down; }
    Mod+K hotkey-overlay-title="Focus Window or Workspace Up" { focus-window-or-workspace-up; }
    Mod+L hotkey-overlay-title="Focus Column Right" { focus-column-right; }
    Mod+Ctrl+H hotkey-overlay-title="Move Column Left" { move-column-left; }
    Mod+Ctrl+J hotkey-overlay-title="Move Window Down or to Workspace Down" { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+K hotkey-overlay-title="Move Window Up or to Workspace Up" { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+L hotkey-overlay-title="Move Column Right" { move-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Down { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+Up { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Home hotkey-overlay-title="Focus First Column" { focus-column-first; }
    Mod+End hotkey-overlay-title="Focus Last Column" { focus-column-last; }
    Mod+Ctrl+Home hotkey-overlay-title="Move Column to First" { move-column-to-first; }
    Mod+Ctrl+End hotkey-overlay-title="Move Column to Last" { move-column-to-last; }

    Mod+R hotkey-overlay-title="Cycle Column Width" { switch-preset-column-width; }
    Mod+Minus hotkey-overlay-title="Column Narrower" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Column Wider" { set-column-width "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title="Window Shorter" { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="Window Taller" { set-window-height "+10%"; }
    Mod+Ctrl+R hotkey-overlay-title="Reset Window Height" { reset-window-height; }
    Mod+F hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen Window" { fullscreen-window; }
    Mod+Ctrl+F hotkey-overlay-title="Fill Free Space" { expand-column-to-available-width; }
    Mod+M hotkey-overlay-title="Maximize to Edges" { maximize-window-to-edges; }
    Mod+W hotkey-overlay-title="Column as Tabs" { toggle-column-tabbed-display; }
    Mod+BracketLeft hotkey-overlay-title="Pull In or Push Out Left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Pull In or Push Out Right" { consume-or-expel-window-right; }
    Mod+Comma hotkey-overlay-title="Take Next Window into Column" { consume-window-into-column; }
    Mod+Shift+Comma hotkey-overlay-title="Expel Window from Column" { expel-window-from-column; }
    Mod+Ctrl+V hotkey-overlay-title="Float or Tile Window" { toggle-window-floating; }
    Mod+Shift+V hotkey-overlay-title="Focus Floating or Tiled" { switch-focus-between-floating-and-tiling; }
    Mod+Shift+C hotkey-overlay-title="Center Column" { center-column; }
    Mod+Ctrl+C hotkey-overlay-title="Center Visible Columns" { center-visible-columns; }

    Mod+Page_Down hotkey-overlay-title="Focus Workspace Down" { focus-workspace-down; }
    Mod+Page_Up hotkey-overlay-title="Focus Workspace Up" { focus-workspace-up; }
    Mod+Ctrl+Page_Down hotkey-overlay-title="Move Column to Workspace Down" { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up hotkey-overlay-title="Move Column to Workspace Up" { move-column-to-workspace-up; }
    Mod+Shift+Page_Down hotkey-overlay-title="Move Workspace Down" { move-workspace-down; }
    Mod+Shift+Page_Up hotkey-overlay-title="Move Workspace Up" { move-workspace-up; }
    Mod+Ctrl+Tab hotkey-overlay-title="Previous Workspace" { focus-workspace-previous; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }

    Mod+1 hotkey-overlay-title="Focus Workspace 1" { focus-workspace 1; }
    Mod+2 hotkey-overlay-title="Focus Workspace 2" { focus-workspace 2; }
    Mod+3 hotkey-overlay-title="Focus Workspace 3" { focus-workspace 3; }
    Mod+4 hotkey-overlay-title="Focus Workspace 4" { focus-workspace 4; }
    Mod+5 hotkey-overlay-title="Focus Workspace 5" { focus-workspace 5; }
    Mod+6 hotkey-overlay-title="Focus Workspace 6" { focus-workspace 6; }
    Mod+7 hotkey-overlay-title="Focus Workspace 7" { focus-workspace 7; }
    Mod+8 hotkey-overlay-title="Focus Workspace 8" { focus-workspace 8; }
    Mod+9 hotkey-overlay-title="Focus Workspace 9" { focus-workspace 9; }
    Mod+0 hotkey-overlay-title="Focus Workspace 10" { focus-workspace 10; }
    Mod+Ctrl+1 hotkey-overlay-title="Move Column to Workspace 1" { move-column-to-workspace 1; }
    Mod+Ctrl+2 hotkey-overlay-title="Move Column to Workspace 2" { move-column-to-workspace 2; }
    Mod+Ctrl+3 hotkey-overlay-title="Move Column to Workspace 3" { move-column-to-workspace 3; }
    Mod+Ctrl+4 hotkey-overlay-title="Move Column to Workspace 4" { move-column-to-workspace 4; }
    Mod+Ctrl+5 hotkey-overlay-title="Move Column to Workspace 5" { move-column-to-workspace 5; }
    Mod+Ctrl+6 hotkey-overlay-title="Move Column to Workspace 6" { move-column-to-workspace 6; }
    Mod+Ctrl+7 hotkey-overlay-title="Move Column to Workspace 7" { move-column-to-workspace 7; }
    Mod+Ctrl+8 hotkey-overlay-title="Move Column to Workspace 8" { move-column-to-workspace 8; }
    Mod+Ctrl+9 hotkey-overlay-title="Move Column to Workspace 9" { move-column-to-workspace 9; }
    Mod+Ctrl+0 hotkey-overlay-title="Move Column to Workspace 10" { move-column-to-workspace 10; }

    // wpctl set-volume leaves a muted sink muted, so a volume key unmutes it first; Alt steps 1 % and Shift jumps brightness to its ends.
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Volume Up" { spawn "sh" "-c" "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Volume Down" { spawn "sh" "-c" "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    Alt+XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Volume Up 1%" { spawn "sh" "-c" "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+"; }
    Alt+XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Volume Down 1%" { spawn "sh" "-c" "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Mute" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Mic Mute" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Play/Pause" { spawn "dots-call" "media" "playPause"; }
    XF86AudioPause allow-when-locked=true hotkey-overlay-title="Pause" { spawn "dots-call" "media" "playPause"; }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Next Track" { spawn "dots-call" "media" "next"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Previous Track" { spawn "dots-call" "media" "previous"; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Brightness Up" { spawn "dots-call" "osd" "brightness" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness Down" { spawn "dots-call" "osd" "brightness" "5%-"; }
    Alt+XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Brightness Up 1%" { spawn "dots-call" "osd" "brightness" "1%+"; }
    Alt+XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness Down 1%" { spawn "dots-call" "osd" "brightness" "1%-"; }
    Shift+XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Brightness Full" { spawn "dots-call" "osd" "brightness" "100%"; }
    Shift+XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness Lowest" { spawn "dots-call" "osd" "brightness" "1%"; }
    // The Touch Bar's Fn row sends these.
    XF86KbdBrightnessUp allow-when-locked=true hotkey-overlay-title="Keyboard Light Up" { spawn "brightnessctl" "-q" "-d" "kbd_backlight" "set" "10%+"; }
    XF86KbdBrightnessDown allow-when-locked=true hotkey-overlay-title="Keyboard Light Down" { spawn "brightnessctl" "-q" "-d" "kbd_backlight" "set" "10%-"; }
    XF86Search hotkey-overlay-title="Launcher" { spawn "dots-call" "launcher" "toggle"; }
    XF86PowerOff hotkey-overlay-title="Power" { spawn "dots-call" "control" "section" "power"; }
}

// Naming any switcher bind drops niri's defaults, so the app-id ones are kept here, and the cheat sheet reads these rows.
recent-windows {
    binds {
        Alt+Tab hotkey-overlay-title="Switch Windows" { next-window; }
        Alt+Shift+Tab hotkey-overlay-title="Switch Windows Back" { previous-window; }
        Mod+Tab hotkey-overlay-title="Switch Windows" { next-window; }
        Mod+Shift+Tab hotkey-overlay-title="Switch Windows Back" { previous-window; }
        Alt+grave { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
        Mod+grave { next-window filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}
