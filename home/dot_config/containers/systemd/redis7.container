[Unit]
Description=Redis 7 (on-demand dev cache/queue)
StopWhenUnneeded=true

[Container]
Image=docker.io/library/redis:7
ContainerName=dev-redis7
Volume=redis7-data:/data
PublishPort=127.0.0.1:36379:6379
Exec=redis-server --appendonly yes
Notify=healthy
HealthCmd=redis-cli ping
HealthInterval=30s
HealthStartPeriod=10s
HealthRetries=3

[Service]
TimeoutStartSec=300
