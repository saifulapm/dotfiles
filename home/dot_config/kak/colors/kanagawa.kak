declare-option str sumiInk3 'rgb:1F1F28'
declare-option str sumiInk4 'rgb:2A2A37'
declare-option str sumiInk5 'rgb:363646'
declare-option str sumiInk6 'rgb:54546D'
declare-option str waveBlue1 'rgb:223249'
declare-option str waveBlue2 'rgb:2D4F67'
declare-option str winterGreen 'rgb:2B3328'
declare-option str winterYellow 'rgb:49443C'
declare-option str winterRed 'rgb:43242B'
declare-option str winterBlue 'rgb:252535'
declare-option str autumnGreen 'rgb:76946A'
declare-option str autumnRed 'rgb:C34043'
declare-option str autumnYellow 'rgb:DCA561'
declare-option str samuraiRed 'rgb:E82424'
declare-option str roninYellow 'rgb:FF9E3B'
declare-option str waveAqua1 'rgb:6A9589'
declare-option str dragonBlue 'rgb:658594'
declare-option str oniViolet 'rgb:957FB8'
declare-option str oniViolet2 'rgb:B8B4D0'
declare-option str crystalBlue 'rgb:7E9CD8'
declare-option str springViolet1 'rgb:938AA9'
declare-option str springViolet2 'rgb:9CABCA'
declare-option str springBlue 'rgb:7FB4CA'
declare-option str lightBlue 'rgb:A3D4D5'
declare-option str waveAqua2 'rgb:7AA89F'
declare-option str waveAqua3 'rgb:68AD99'
declare-option str waveAqua4 'rgb:7AA880'
declare-option str waveAqua5 'rgb:6CAF95'
declare-option str springGreen 'rgb:98BB6C'
declare-option str boatYellow1 'rgb:938056'
declare-option str boatYellow2 'rgb:C0A36E'
declare-option str carpYellow 'rgb:E6C384'
declare-option str sakuraPink 'rgb:D27E99'
declare-option str waveRed 'rgb:E46876'
declare-option str peachRed 'rgb:FF5D62'
declare-option str surimiOrange 'rgb:FFA066'
declare-option str katanaGray 'rgb:717C7C'

# Faces
set-face global Default "%opt{fujiWhite}"
set-face global LineNumbers "%opt{sumiInk6}"
set-face global LineNumberCursor "%opt{roninYellow}+b"
set-face global StatusLine "%opt{oldWhite},%opt{sumiInk0}"
set-face global StatusLineMode "%opt{roninYellow}"
set-face global StatusLineInfo "%opt{dragonBlue}"
set-face global StatusLineValue "%opt{dragonBlue}"
set-face global StatusCursor "%opt{fujiWhite},%opt{waveBlue2}+b"
set-face global Prompt "%opt{oldWhite},%opt{sumiInk0}"
set-face global PrimarySelection ",%opt{waveBlue2}"
set-face global SecondarySelection ",%opt{waveBlue2}"
set-face global PrimaryCursor "%opt{waveBlue1},%opt{fujiWhite}"
set-face global SecondaryCursor "%opt{waveBlue1},%opt{waveAqua2}"
set-face global PrimaryCursorEol "%opt{waveBlue1},%opt{waveAqua2}"
set-face global SecondaryCursorEol "%opt{waveBlue1},%opt{waveAqua2}"
set-face global MenuBackground "%opt{fujiWhite},%opt{waveBlue1}"
set-face global MenuForeground "%opt{fujiWhite},%opt{waveBlue2}+b"
set-face global MenuInfo "%opt{fujiWhite},%opt{waveBlue1}"
set-face global InlineInformation "%opt{sumiInk6}"
