# kanagawa
# Converted from Helix theme

# Palette
declare-option str oldWhite 'rgb:C8C093'
declare-option str fujiWhite 'rgb:DCD7BA'
declare-option str fujiGray 'rgb:727169'
declare-option str sumiInk0 'rgb:16161D'
declare-option str sumiInk1 'rgb:181820'
