set-face global DiagnosticWarning ",,%opt{roninYellow}+c"
set-face global MatchingChar "%opt{waveRed}+b"
set-face global Whitespace "%opt{fujiGray}+f"
set-face global Search ",%opt{waveBlue2}"
set-face global WrapMarker "%opt{sumiInk6}"
set-face global Information "%opt{fujiWhite},%opt{sumiInk0}"
