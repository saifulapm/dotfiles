# tokyonight_storm
# Converted from Helix theme

# Palette
declare-option str red 'rgb:f7768e'
declare-option str orange 'rgb:ff9e64'
declare-option str yellow 'rgb:e0af68'
declare-option str light_green 'rgb:9ece6a'
declare-option str green 'rgb:73daca'
declare-option str aqua 'rgb:2ac3de'
declare-option str teal 'rgb:1abc9c'
declare-option str turquoise 'rgb:89ddff'
declare-option str light_cyan 'rgb:b4f9f8'
declare-option str cyan 'rgb:7dcfff'
declare-option str blue 'rgb:7aa2f7'
declare-option str purple 'rgb:9d7cd8'
declare-option str magenta 'rgb:bb9af7'
declare-option str comment 'rgb:565f89'
declare-option str black 'rgb:414868'
declare-option str add 'rgb:449dab'
declare-option str change 'rgb:6183bb'
declare-option str delete 'rgb:914c54'
declare-option str error 'rgb:db4b4b'
declare-option str info 'rgb:0db9d7'
declare-option str hint 'rgb:1abc9c'
declare-option str fg 'rgb:c0caf5'
declare-option str fg_dark 'rgb:a9b1d6'
declare-option str fg_gutter 'rgb:3b4261'
declare-option str fg_linenr 'rgb:737aa2'
declare-option str fg_selected 'rgb:343a55'
declare-option str border 'rgb:1d202f'
declare-option str border_highlight 'rgb:29a4bd'
declare-option str bg 'rgb:24283b'
declare-option str bg_inlay 'rgb:233745'
declare-option str bg_selection 'rgb:373d5a'
declare-option str bg_menu 'rgb:1f2335'
declare-option str bg_focus 'rgb:2e3c64'

# Faces
set-face global Default "%opt{fg}"
set-face global LineNumbers "%opt{fg_gutter}"
set-face global LineNumberCursor "%opt{fg_linenr}"
set-face global StatusLine "%opt{fg_dark},%opt{bg_menu}"
set-face global StatusLineMode "%opt{yellow}"
set-face global StatusLineInfo "%opt{info}"
set-face global StatusLineValue "%opt{info}"
set-face global StatusCursor ",%opt{fg_selected}"
set-face global Prompt "%opt{fg_dark},%opt{bg_menu}"
set-face global PrimarySelection ",%opt{bg_selection}"
set-face global SecondarySelection ",%opt{bg_selection}"
set-face global PrimaryCursor "+r"
set-face global SecondaryCursor "+r"
set-face global PrimaryCursorEol "+r"
set-face global SecondaryCursorEol "+r"
set-face global MenuBackground "%opt{fg},%opt{bg_menu}"
set-face global MenuForeground ",%opt{fg_selected}"
set-face global MenuInfo "%opt{fg},%opt{bg_menu}"
set-face global InlineInformation "%opt{teal},%opt{bg_inlay}"
set-face global InlayHint "%opt{teal},%opt{bg_inlay}+f"
set-face global Error "%opt{error}"
set-face global DiagnosticError ",,%opt{error}+c"
set-face global DiagnosticWarning ",,%opt{yellow}+c"
set-face global MatchingChar "%opt{orange}+b"
set-face global Whitespace "%opt{fg_gutter}+f"
set-face global Search ",%opt{bg_selection}"
set-face global Information "%opt{fg},%opt{bg_menu}"
set-face global hop_label_head "%opt{orange}+bf"
set-face global hop_label_tail "%opt{orange}+bf"
set-face global value "%opt{aqua}"
set-face global type "%opt{aqua}"
set-face global variable "%opt{fg}"
set-face global function "%opt{blue}+i"
set-face global string "%opt{light_green}"
set-face global keyword "%opt{purple}+i"
set-face global operator "%opt{turquoise}"
set-face global attribute "%opt{cyan}"
set-face global comment "%opt{comment}+i"
set-face global documentation "%opt{comment}+i"
set-face global meta "%opt{aqua}"
set-face global builtin "%opt{red}"
set-face global InfoDefault "%opt{fg},%opt{bg_menu}"
set-face global InfoBlock "%opt{teal}"
set-face global InfoBlockQuote "%opt{teal}"
set-face global InfoBullet "%opt{orange}+b"
set-face global InfoHeader "%opt{blue}+b"
set-face global InfoLink "+u"
set-face global InfoLinkMono "%opt{teal}"
set-face global InfoMono "%opt{blue},%opt{black}"
set-face global InfoRule ",%opt{fg_gutter}"
set-face global InfoDiagnosticError ",,%opt{error}+c"
set-face global InfoDiagnosticHint ",,%opt{hint}+c"
set-face global InfoDiagnosticInformation ",,%opt{info}+c"
set-face global InfoDiagnosticWarning ",,%opt{yellow}+c"
set-face global Reference "%opt{orange}+b"
set-face global InlayCodeLens "%opt{teal},%opt{bg_inlay}"
set-face global LineFlagError "%opt{error}"
set-face global LineFlagHint "%opt{hint}"
set-face global LineFlagInfo "%opt{info}"
set-face global LineFlagWarning "%opt{yellow}"
set-face global title "%opt{blue}+b"
set-face global header "%opt{blue}+b"
set-face global mono "%opt{blue},%opt{black}"
set-face global block "%opt{teal}"
set-face global link "+u"
set-face global bullet "%opt{orange}+b"
set-face global list "%opt{orange}+b"
set-face global ts_attribute "%opt{cyan}"
set-face global ts_comment "%opt{comment}+i"
set-face global ts_comment_block_documentation "%opt{yellow}"
