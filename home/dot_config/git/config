[user]
	name = Saiful Islam
	email = saiful.apm@gmail.com
[github]
	user = saifulapm

[core]
	excludesFile = ~/.config/git/ignore
	quotepath = false
	# line endings: force LF during add, warn on conversion
	autocrlf = input
	safecrlf = warn
	# No core.editor: it outranks $VISUAL/$EDITOR, which config.fish sets.
	pager = delta
	# workflow install writes its hook stubs here, and each one chains into the repo's own hook.
	hooksPath = ~/.config/git/hooks

# delta draws syntax in the terminal's palette, which every colorscheme sets, and marks a change by its colour alone: a fixed background would sit as a block on the clear terminal.
[delta]
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red ul
	plus-style = green
	plus-emph-style = bold green ul

[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
[fetch]
	prune = true
[rerere]
	enabled = true
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
[branch]
	sort = -committerdate
[alias]
	# A syntax-aware diff, by difftastic.
	dft = -c diff.external=difft diff

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

# Which GitHub account a remote uses follows the repo's URL, not whichever gh account is active.
# Every lareysbd remote is dialled through the github.com-lareys ssh alias, which pins the commercial key.
# Rewriting changes only the URL git dials; .git/config keeps the github.com remote.
[url "git@github.com-lareys:lareysbd/"]
	insteadOf = git@github.com:lareysbd/
	insteadOf = https://github.com/lareysbd/
	insteadOf = ssh://git@github.com/lareysbd/

# There is no git@github.com:saifulapm/ line: that form already dials the right alias, and rewriting it to itself loops.
[url "git@github.com:saifulapm/"]
	insteadOf = https://github.com/saifulapm/
	insteadOf = ssh://git@github.com/saifulapm/
