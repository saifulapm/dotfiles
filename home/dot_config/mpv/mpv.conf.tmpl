# Each file starts where it last stopped.
save-position-on-quit=yes
video-sync=display-resample
interpolation=yes
tscale=oversample
{{ if hasPrefix "mac" .machine -}}
# Zero-copy vaapi draws corrupt frames on the Macs' decoder, so frames come back by vaapi-copy; OpenGL uploads them for about half the CPU gpu-next needs, which made software decoding cheaper than vaapi-copy there for all but HEVC (10 s of 4K on the M2: H.264 18.4 s of CPU in software on gpu-next, 9.3 s by vaapi-copy on OpenGL).
vo=gpu
gpu-api=opengl
hwdec=vaapi-copy
hwdec-codecs=h264,hevc,vp9
{{ else -}}
vo=gpu-next
hwdec=vaapi
{{ end -}}
{{ if eq .machine "nuc" -}}
# The NUC's Intel UHD cannot upscale 1080p to its 4K panel with lanczos and interpolate to 60 Hz in one refresh, and drops about 7 frames a second; bilinear drops none.
scale=bilinear
{{ end -}}
# dots colorscheme renders the OSD and OSC colours here.
include=~/.local/state/dots/theme-out/mpv.conf
