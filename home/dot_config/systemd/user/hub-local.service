[Unit]
Description=hub local: this machine's local hub, for questions and answers between machines
# Local hubs reach each other on port 8789 over the tailnet, with the peer token; mem reaches this one on its own socket. The tokens come from ~/.config/hub/local.env, which dots secrets writes from pass, so a machine without that file skips the unit instead of failing it.
ConditionPathExists=%h/.config/hub/local.env
After=network-online.target
StartLimitIntervalSec=0

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/hub/local.env
# The hub reads its tailnet name once, as it starts, so it waits up to a minute for tailscale to run, which also serves its port on the tailnet; at boot the user manager starts it seconds before tailscale is up.
ExecStartPre=-%h/Codes/dotfiles/bin/dots-hub-serve
ExecStart=%h/.local/bin/hub local
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
