[Unit]
Description=dots touchpad pinches
PartOf=graphical-session.target
After=graphical-session.target
# Restart=always must never give up, however often the watcher dies.
StartLimitIntervalSec=0

[Service]
# A pinch runs dots-call, which lives in the repo's bin/.
Environment=PATH=%h/Codes/dotfiles/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/dots-gestures
Restart=always
RestartSec=500ms
