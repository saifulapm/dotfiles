[Unit]
Description=dots office HomePod sender
# Only the mini shares the office LAN with the HomePod; Restart=always must never give up.
ConditionHost=mac-mini-m2
After=pipewire.service
StartLimitIntervalSec=0

[Service]
# The manager learns ~/.local/bin only after login, and the sender calls cliairplay from there.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/dots-homepod
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
