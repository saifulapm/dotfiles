[Unit]
Description=dots clipboard history
PartOf=graphical-session.target
After=graphical-session.target
# Restart=always must never give up, however often the watcher dies.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/wl-paste --watch %h/.local/bin/dots-clip-store
Restart=always
RestartSec=500ms
