[Unit]
Description=Receive Taildrop files into the downloads directory
Documentation=https://tailscale.com/kb/1106/taildrop
# There is no network-online.target in the user manager and tailscaled is a
# system service a user unit cannot order against, so the ordering that is
# actually available is the session the notifications land in. Anything else
# (tailscaled still starting, no operator, logged out) is a state the script
# backs off through rather than a dependency.
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.dotfiles/bin/taildrop-receive
# The whole point is to sit blocked in `tailscale file get --wait` forever;
# anything that ends that is worth starting again, and the script's own backoff
# means a restart loop cannot spin.
Restart=always
RestartSec=10
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
