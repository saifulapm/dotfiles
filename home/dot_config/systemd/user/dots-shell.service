[Unit]
Description=dots shell (Quickshell)
PartOf=graphical-session.target
After=graphical-session.target
# Restart=always must never give up, however often the shell dies.
StartLimitIntervalSec=0

[Service]
ExecStart=qs
Restart=always
RestartSec=500ms
# The shell draws its own UI; the gtk3 platform theme a session may set costs up to 1.5 s of start-up.
Environment=QT_QPA_PLATFORMTHEME=
