[Unit]
Description=dots shell (Quickshell)
PartOf=graphical-session.target
After=graphical-session.target
# Restart=always must never give up, however often the shell dies.
StartLimitIntervalSec=0

[Service]
# Linked by run_onchange_after_18-shell, since systemd finds a bare name only on its own fixed PATH.
ExecStart=%h/.local/bin/dots-qs
Restart=always
RestartSec=500ms
# The shell draws its own UI; the gtk3 platform theme a session may set costs up to 1.5 s of start-up.
Environment=QT_QPA_PLATFORMTHEME=
# One render loop on the GUI thread shares a GL context across windows: 13 MiB less RSS, faster first frames.
Environment=QSG_RENDER_LOOP=basic
# Text falls back only to the themes' faces, never to the system sans (shell/fonts.conf).
Environment=FONTCONFIG_FILE=%h/.config/quickshell/fonts.conf
