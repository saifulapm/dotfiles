[Unit]
Description=libinput-gestures, the touchpad pinches niri cannot bind
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# The gestures run dots-call, which lives in the repo's bin/.
Environment=PATH=%h/Codes/dotfiles/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/libinput-gestures
Restart=on-failure
RestartSec=5
