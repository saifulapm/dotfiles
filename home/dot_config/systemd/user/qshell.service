[Unit]
Description=qshell (Quickshell desktop shell)
# The niri wiki's session-service shape (Example systemd Setup): starts only
# inside a graphical session, stops with it, never outlives it.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# session.slice, beside niri's own unit: Fedora marks app.slice's members
# eligible for systemd-oomd kills, and the shell (notification daemon,
# polkit agent, lock screen) must never be in that pool — the apps it
# launches are, individually, via bin/app-run's transient units.
Slice=session.slice
ExecStart=/usr/bin/qs
# Quickshell ships its own crash-handler relaunch: the crashed MainPID
# lingers as a launcher while a child under comm "quickshell" takes over, so
# systemd never sees the failure (verified live with a SIGSEGV) — and that
# orphan-relaunch is what once drew a second stale bar. One supervisor:
# disable the built-in one, systemd-coredump still records the stack trace.
Environment=QS_DISABLE_CRASH_HANDLER=1
# Quickshell watches the QML it loaded and reloads on change, and
# ~/.config/quickshell is a symlink onto ~/.dotfiles/shell — so a chezmoi
# apply, a git pull or an editor writing a .qml reloads the running shell
# against a half-written tree. A reload that fails raises the reload popup,
# which is a second engine generation, and with more than one alive
# EngineGeneration::currentGeneration() returns null: the next
# bin/qshell-relaunch IPC kill then takes the QCoreApplication::exit(0)
# branch and tears the QML graph down after the QGuiApplication is gone,
# which aborts on the first GUI resource it touches (omarchy 0900855).
# Nothing here has ever relied on that watcher — bin/qshell-relaunch is how
# QML changes are picked up, and config/theme changes come in over IPC.
Environment=QS_DISABLE_FILE_WATCHER=1
# The popup goes with it: QML can still ask for a reload directly and leave
# the same extra generation behind.
Environment=QS_NO_RELOAD_POPUP=1
# glibc keeps freed heap pages: destroying 109 MiB of evicted picker pixmaps
# returned 0.6 MiB to the OS (measured 2026-08-09), because freeing a large
# block silently raises the mmap/trim thresholds toward 32/64 MiB, after
# which image-decode buffers land in arenas that never shrink. Setting the
# thresholds pins them at 128 KiB — big transient decodes (a 4K PNG is
# ~33-66 MiB raw) become individual mmaps, returned the moment they free —
# and 2 arenas is plenty for a process whose allocation is one GUI thread
# plus render threads. This is what makes the shell's 45 s surface eviction
# (shell.qml SurfaceLoader) shrink RSS instead of just capping it.
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_MMAP_THRESHOLD_=131072
Environment=MALLOC_TRIM_THRESHOLD_=131072
# One render thread for every window instead of one per window (the threaded
# loop gave 18 threads with the bar's panels up — each with its own arenas
# and scenegraph caches). Verified rendering fine on this compositor; drop
# this line first if animations ever stutter.
Environment=QSG_RENDER_LOOP=basic
# The shell owns org.freedesktop.Notifications and the polkit agent — a crash
# must bring it back without the pkill-and-relaunch dance (and without the
# stale-second-bar failure mode a manual crash-relaunch once produced).
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
