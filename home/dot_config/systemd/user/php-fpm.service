[Unit]
Description=PHP 8.5 FPM (on-demand, .test sites)
StopWhenUnneeded=true

[Service]
ExecStartPre=/usr/bin/mkdir -p %S/php-fpm

Type=exec
ExecStart=/usr/sbin/php-fpm --nodaemonize --fpm-config %h/.config/php-fpm/dev.conf

ExecStartPost=/usr/bin/bash -c 'for i in $(seq 1 100); do (exec 3<>/dev/tcp/127.0.0.1/39085) 2>/dev/null && exit 0; sleep 0.05; done; echo "php-fpm: 39085 never accepted a connection" >&2; exit 1'

ExecReload=/usr/bin/kill -USR2 $MAINPID
