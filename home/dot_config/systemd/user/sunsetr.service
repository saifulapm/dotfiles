[Unit]
Description=sunsetr (blue-light filter / night light)
Documentation=https://psi4j.github.io/sunsetr/
# Same session shape as qshell.service and qshell-dshift.service: starts only
# inside a graphical session, stops with it, never outlives it. Not merely
# tidy — sunsetr drives the compositor's gamma over a Wayland protocol, so
# without WAYLAND_DISPLAY it has nothing to talk to.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
# Built by run_after_09-cargo-tools.sh into ~/.cargo/bin. A machine that has
# not run the cargo pass yet (or where the build failed) skips this cleanly
# rather than showing a failed unit, the librepods.service gate exactly.
ConditionPathExists=%h/.cargo/bin/sunsetr

[Service]
# session.slice like the shell and the dshift watcher: Fedora marks
# app.slice's members eligible for systemd-oomd kills, and an oomd kill here
# would leave the screen stuck at whatever temperature was applied last, with
# nothing on screen to say why.
Slice=session.slice
# Foreground, NOT `-b`. sunsetr's own background mode double-forks and
# daemonizes, which would leave systemd supervising a process that exits
# immediately (Type=simple) or needing Type=forking to guess at the child.
# Verified 2026-08-21: plain `sunsetr` runs in the foreground and drives the
# gamma identically.
ExecStart=%h/.cargo/bin/sunsetr
# No ExecStop and no KillSignal override on purpose: sunsetr installs a
# SIGTERM handler that runs its own cleanup (verified 2026-08-21 — "Received
# termination request … Cleanup complete", and the display returns to
# neutral). systemd's default SIGTERM is therefore already the graceful path,
# and `sunsetr stop` as an ExecStop would be a second, racing shutdown.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
