[Unit]
Description=Bluetooth pairing agent (auto-accept)
Documentation=man:bt-agent(1)
ConditionPathIsDirectory=/sys/class/bluetooth
# bluez must be reachable on the system bus before we can register.
After=dbus.socket
Requires=dbus.socket

[Service]
Type=simple
# If bluetoothd is unavailable (for example on a machine without a usable
# adapter), skip cleanly instead of entering a restart loop.
ExecCondition=/usr/bin/systemctl is-active --quiet bluetooth.service
# NoInputNoOutput answers every pairing confirmation and PIN request itself,
# which is what lets the bluetooth panel's pair action complete unattended on
# devices that would otherwise wait forever on a passkey nobody can type
# (quickshell registers no agent of its own). Inbound exposure is bounded by
# the adapter, not by this agent: nothing in this shell ever sets the adapter
# discoverable — the panel's discovery is outbound scanning only — so a pair
# request we did not initiate still needs a peer that already knows the
# adapter address and the adapter pairable at the BlueZ layer.
ExecStart=/usr/bin/bt-agent -c NoInputNoOutput
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
