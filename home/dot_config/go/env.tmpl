{{/* go's own config file (chezmoi-managed) — go reads it in EVERY context:
bash chezmoi scripts, systemd units, editors. This is what makes `go install`
land in the XDG tree even where fish's GOPATH/GOBIN exports never ran
(env vars, when present, take precedence and agree — 00-env.fish).
No comments in the rendered file: go env parses plain KEY=VALUE lines. */ -}}
GOPATH={{ .chezmoi.homeDir }}/.local/share/go
GOBIN={{ .chezmoi.homeDir }}/.local/share/go/bin
