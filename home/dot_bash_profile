# .bash_profile (managed by chezmoi)

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi

# User specific environment and startup programs
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Start niri on tty1 login (autologin lands here; see
# .chezmoiscripts/run_before_01-autologin.sh.tmpl). The interactive guard is
# load-bearing: niri-session re-execs itself through a non-interactive login
# shell that sources this file again, and without it the exec recurses forever.
if [[ $- == *i* ]] && [ -z "${WAYLAND_DISPLAY:-}" ] && [ "$(tty)" = "/dev/tty1" ] \
   && ! systemctl --user -q is-active niri.service 2>/dev/null; then
    exec niri-session
fi
