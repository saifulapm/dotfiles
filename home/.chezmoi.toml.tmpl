{{- /* Machine identity — RECORDED first, detected second, asked last
  (2026-08-10, reworked 2026-08-19 so a fourth machine cannot inherit a
  third's id).

  This is not a preference: it is the sync fabric's device id. Shell history
  is one file per machine inside the synced folder (dot_bashrc.d/20-history.sh,
  fish conf.d/10-history.fish) and Services/Sync.qml names its snapshot the
  same way, so two boxes answering the same id collapse into one device and
  overwrite each other. The hostname cannot supply it — every install here
  answers "fedora" — which is why a prompt existed at all.

  Step 1, an id already in this file WINS, and it is the fix for the whole
  class of problem. Detection can only ever guess from hardware, and the
  guess is unstable across a model bump or a second box of the same shape;
  once a machine has an id, the sync fabric has files named after it, so
  re-deriving it on a later `chezmoi init` would orphan them. Recorded beats
  clever.

  Step 2 detects, but ONLY the three machines that exist, and precisely. The
  previous version matched "any amd64" -> nuc and bare "mac mini"/"macbook"
  -> the M2 ids, which meant a second x86 box, a Mac mini M4 or a MacBook Air
  silently ANSWERED AS an existing machine — the exact collision described
  above, arriving without a prompt or a warning. Model strings are the ones
  these boxes actually report: this Mac mini says "Apple Mac mini (M2 Pro,
  2023)" (Mac14,12 / J474s — measured 2026-08-19; the old comment's
  "M2, 2023"/j473 was the base model, not this one). x86 reads DMI instead,
  where an Intel NUC names itself.

  Step 3 asks, as free text with the model as the default — promptChoiceOnce
  over the three existing names was a trap: hardware that fell through
  detection could only be given an id that was already taken. */ -}}
{{- $machine := "" -}}
{{- if hasKey . "machine" -}}
{{-   $machine = .machine -}}
{{- end -}}
{{- $model := "" -}}
{{- if stat "/proc/device-tree/model" -}}
{{-   $model = lower (output "sh" "-c" "tr -d '\\0' < /proc/device-tree/model") -}}
{{- else if stat "/sys/class/dmi/id/product_name" -}}
{{-   $model = lower (output "sh" "-c" "cat /sys/class/dmi/id/product_name") -}}
{{- end -}}
{{- if not $machine -}}
{{-   if contains "mac mini (m2" $model -}}
{{-     $machine = "mac-mini-m2" -}}
{{-   else if contains "macbook pro (13-inch, m2" $model -}}
{{-     $machine = "macbook-m2" -}}
{{-   else if contains "nuc" $model -}}
{{-     $machine = "nuc" -}}
{{-   end -}}
{{- end -}}
{{- if not $machine -}}
{{-   $machine = promptStringOnce . "machine" "Machine id — must be unique, it names this device's files in the sync fabric" (trimPrefix "apple-" (trimAll "-" (regexReplaceAll "[^a-z0-9]+" $model "-"))) -}}
{{- end -}}
# The repo lives at ~/.dotfiles on every machine; restore with:
#   sh -c "$(curl -fsLS get.chezmoi.io)" -- init --apply --source ~/.dotfiles <repo-url>
sourceDir = "~/.dotfiles"

# Symlink mode: non-templated files are symlinked into the repo, so editing
# the live config edits the repo directly — no apply loop.
mode = "symlink"

encryption = "age"

[data]
    machine = {{ $machine | quote }}
    # mailUser and mailIdentities USED TO LIVE HERE, prompted by
    # promptStringOnce. Moved 2026-08-19 into the age-encrypted
    # .chezmoitemplates/mail-identities.toml.age, which the four mail
    # templates read directly.
    #
    # The reason is the same property that made this file the safe place for
    # them at first: `chezmoi apply` NEVER re-evaluates .chezmoi.toml.tmpl.
    # That is exactly what you want for a machine id and exactly wrong for
    # data you edit — a value in [data] is frozen at `chezmoi init`, so adding
    # one address meant re-initialising all three boxes by hand. The encrypted
    # file is read on every apply instead, so `update-all` (git pull, then
    # apply) rewrites .mbsyncrc, .msmtprc and the notmuch/imapnotify configs
    # from one pushed commit.
    #
    # It also removes the prompt from a fresh install: the addresses arrive
    # with the repo, and the key that opens them arrives with
    # bin/secrets-restore. Nothing to type either way.
    #
    # Written as literal TOML comments rather than a {{ "{{/* ... */}}" }}
    # template comment on purpose: a trim marker there swallows the newline
    # after `machine`, which silently concatenates the keys onto one line and
    # fails the whole init with a TOML parse error.

[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1y05rw7sm72al7vnxqd54th9rj7s0v8ynpuw07lhgtwz547823dyqusaaqr"
