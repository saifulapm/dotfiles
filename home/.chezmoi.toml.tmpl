{{- /* Machine identity — detected, not asked (2026-08-10).

  This is not a preference: it is the sync fabric's device id. Shell history
  is one file per machine inside the synced folder (dot_bashrc.d/20-history.sh,
  fish conf.d/10-history.fish) and Services/Sync.qml names its snapshot the
  same way, so two boxes answering the same id collapse into one device and
  overwrite each other. The hostname cannot supply it — every Asahi install
  here answers "fedora" — which is why a prompt existed at all.

  Detection instead, because the hardware already says which box this is:
  x86_64 is the NUC (the only one), and every Apple box publishes its exact
  model in the device tree ("Apple Mac mini (M2, 2023)" / "Apple MacBook Pro
  (13-inch, M2, 2022)" — apple,j473 / apple,j493). The prompt stays as the
  fallback for hardware not listed here, so a fourth machine still installs;
  it just no longer asks the three known ones a question they can answer
  themselves. The strings are unchanged, so a machine that answered the
  prompt before keeps its identity across a re-init. */ -}}
{{- $machine := "" -}}
{{- if eq .chezmoi.arch "amd64" -}}
{{-   $machine = "nuc" -}}
{{- else if stat "/proc/device-tree/model" -}}
{{-   $model := lower (output "sh" "-c" "tr -d '\\0' < /proc/device-tree/model") -}}
{{-   if contains "mac mini" $model -}}
{{-     $machine = "mac-mini-m2" -}}
{{-   else if contains "macbook" $model -}}
{{-     $machine = "macbook-m2" -}}
{{-   end -}}
{{- end -}}
{{- if not $machine -}}
{{-   $machine = promptChoiceOnce . "machine" "Which machine is this" (list "macbook-m2" "mac-mini-m2" "nuc") -}}
{{- end -}}
# The repo lives at ~/.dotfiles on every machine; restore with:
#   sh -c "$(curl -fsLS get.chezmoi.io)" -- init --apply --source ~/.dotfiles <repo-url>
sourceDir = "~/.dotfiles"

# Symlink mode: non-templated files are symlinked into the repo, so editing
# the live config edits the repo directly — no apply loop.
mode = "symlink"

encryption = "age"

[data]
    machine = {{ $machine | quote }}
    # Primary mail account — the IMAP login and the From: address for the
    # notmuch/mbsync/msmtp setup (packages/manifest.toml: isync, notmuch,
    # msmtp). Prompted rather than committed BECAUSE ~/.dotfiles is PUBLIC and
    # an IMAP login address is half a credential: the mail templates read
    # .mailUser, so no file in the repo ever names it.
    #
    # promptStringOnce asks once per machine at `chezmoi init` and reads it
    # back out of this file forever after. `chezmoi apply` never re-evaluates
    # .chezmoi.toml.tmpl, so no background apply can be made to hang on the
    # prompt. A machine that does no mail can answer with anything — every
    # mail unit is ConditionPathExists-gated.
    #
    # Written as literal TOML comments rather than a {{ "{{/* ... */}}" }}
    # template comment on purpose: a trim marker there swallows the newline
    # after `machine`, which silently concatenates the two keys onto one line
    # and fails the whole init with a TOML parse error.
    mailUser = {{ promptStringOnce . "mailUser" "Primary email address (IMAP login)" | quote }}
    # Every other address that lands in the same mailbox — the iCloud+ Custom
    # Email Domain addresses (five domains, three addresses each, one inbox).
    # Semicolon-separated, exactly the shape notmuch's other_email wants, so
    # the template is a straight substitution.
    #
    # Here for the same reason as mailUser: a list of real addresses is not
    # something a public repo gets to hold. Blank is a fine answer on a
    # machine with one address — the notmuch template omits the line entirely.
    #
    # Keep it matching iCloud's own settings: catch-all delivers anything at a
    # domain, but only the addresses iCloud is configured with may be SENT
    # from, and a From it does not recognise is refused at send time.
    mailIdentities = {{ promptStringOnce . "mailIdentities" "Other addresses you send as (semicolon-separated, blank for none)" | quote }}

[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1y05rw7sm72al7vnxqd54th9rj7s0v8ynpuw07lhgtwz547823dyqusaaqr"
