#!/usr/bin/env bash
# ~/.pi/agent/settings.json — a modify_ script rather than a plain source file,
# because this repo applies in symlink mode and pi WRITES to this file.
#
# A plain source file lands as a symlink into ~/Sites/github/dotfiles (that is
# what mode = "symlink" in chezmoi.toml does). pi's settings-manager persists on
# every ctrl+l model switch (setDefaultModelAndProvider), every shift+tab
# thinking cycle (setDefaultThinkingLevel) and every version bump
# (setLastChangelogVersion), so through a symlink, ordinary use of pi would
# leave the repo dirty.
#
# A modify_ script is exempt from symlink mode: chezmoi writes a real file, and
# feeds the current one in on stdin. So pi owns the file day to day and this
# owns the keys below: apply forces them back and leaves everything else
# (lastChangelogVersion above all) exactly as pi left it.
#
# The trade is that this is the one config in the repo you cannot edit live:
# edit here, then `chezmoi apply`. Editing ~/.pi/agent/settings.json by hand
# works until the next apply overwrites the key.
#
# lastChangelogVersion is deliberately absent: pinning it would re-show the
# changelog after every pi upgrade.
#
# The things these keys name arrive by other routes, none of them this file:
#   provider "pxy"  run_onchange_after_28-pin-pxy fills extensions/pxy.ts from
#                   the pinned pxy checkout's contrib/pi-pxy.ts, so a bare `pi`
#                   has the provider without anyone running `pxy launch pi`
#   amx, mem        amx's extensions/amx.ts and amx-subagent.ts are written by
#                   `amx setup pi --subagent` in run_onchange_after_26-pin-amx;
#                   mem's mem.ts by `mem doctor --fix` in
#                   run_onchange_after_27-pin-workflow
#   theme "dots"    dots theme writes ~/.pi/agent/themes/dots.json from the
#                   current theme on every switch
set -euo pipefail

managed=$(
  cat <<'JSON'
{
  "theme": "dots",
  "defaultProvider": "pxy",
  "defaultModel": "default",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "quietStartup": true,
  "defaultProjectTrust": "never",
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "fullscreenScrollbar": "hidden",
  "steeringMode": "all",
  "followUpMode": "all",
  "defaultTools": ["bash", "edit", "write", "ls", "find", "grep", "read"]
}
JSON
)

# Empty stdin is a machine where pi has never run, so merge onto {}.
current=$(cat)
[ -n "$current" ] || current='{}'

# `*` is jq's recursive object merge: nested objects combine, scalars and
# arrays are replaced outright by the right-hand side.
printf '%s' "$current" | jq --argjson managed "$managed" '. * $managed'
