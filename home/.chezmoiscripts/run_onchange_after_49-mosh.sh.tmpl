#!/bin/bash
{{ template "lib.sh" . }}
if root firewall-cmd --state >/dev/null 2>&1; then
  # mosh-server binds a UDP port in 60000-61000, which the default zone drops, so only the tailnet's own addresses get through.
  for rule in 'rule family="ipv4" source address="100.64.0.0/10" port port="60000-61000" protocol="udp" accept' \
    'rule family="ipv6" source address="fd7a:115c:a1e0::/48" port port="60000-61000" protocol="udp" accept'; do
    root firewall-cmd -q --add-rich-rule="$rule" && root firewall-cmd -q --permanent --add-rich-rule="$rule" || die "could not let the tailnet reach mosh on UDP 60000-61000"
  done
fi
