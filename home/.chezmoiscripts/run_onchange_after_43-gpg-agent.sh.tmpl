#!/bin/bash
# gpg-agent.conf hash: {{ include "private_dot_gnupg/private_gpg-agent.conf" | sha256sum }}
{{ template "lib.sh" . }}
# The agent reads its config only at start, and a reload also drops every cached passphrase, so this runs only when the file changes.
command -v gpg-connect-agent >/dev/null || exit 0
gpg-connect-agent reloadagent /bye >/dev/null || log "gpg-agent did not reload; the new config lands at the next login"
