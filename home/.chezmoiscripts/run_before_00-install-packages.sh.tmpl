#!/bin/bash
# Installs everything declared in packages/manifest.toml.
#
# Runs on EVERY apply, gated by its own state file rather than run_onchange:
# run_onchange records "done" the moment the script exits 0, so a run that
# skipped for lack of sudo (any background apply) was marked done and the
# next TERMINAL apply silently never installed anything (found 2026-08-06).
# Here the hash is written only after dnf actually succeeds, so a skipped
# run stays pending until a terminal apply lands it.
set -euo pipefail

root="{{ .chezmoi.workingTree }}"
manifest="$root/packages/manifest.toml"
arch="$(uname -m)"

hashfile="$HOME/.local/state/qshell/packages.sha256"
current="$(sha256sum "$manifest" | cut -d' ' -f1)"
if [ -f "$hashfile" ] && [ "$(cat "$hashfile")" = "$current" ]; then
  exit 0
fi

# Root policy, and which run gets which path:
#   * The fresh-machine bootstrap and any interactive `chezmoi apply` have a
#     controlling terminal, so bare sudo prompts there and everything below
#     runs — that is the path the restore one-liner takes from a TTY.
#   * Background runs (agents, keybinds, timers) have no terminal; sudo cannot
#     prompt at all, so this script skips LOUDLY instead of hanging.
#     Deliberate: a full dnf transaction should not be approvable by a single
#     polkit click with no diff on screen, so there is no pkexec fallback here
#     (03-portal-backend does use pkexec — one file, a reviewable dialog).
if ! sudo -v; then
  echo "install-packages: sudo unavailable — skipping (rerun 'chezmoi apply' in a terminal)" >&2
  exit 0
fi

# This script's own interpreter: everything below — the dnf.conf edit and the
# manifest parses — is python3, but dnf5 is C++ and drags no python in, so a
# true minimal install can lack python3 entirely and the first heredoc would
# abort the apply before a single package landed. Bootstrapped here exactly
# like dnf5-plugins further down (and declared in the manifest for the
# inventory's sake).
rpm -q python3 >/dev/null 2>&1 \
  || sudo dnf install --setopt=install_weak_deps=False -y python3

# Weak deps off, globally and permanently. The per-command --setopt below
# still applies as belt and braces, but the config file is what makes one-off
# `sudo dnf install` invocations honour the policy too. Idempotent, and also
# repairs a duplicated line (this machine had two from a hand-run append).
if [ "$(grep -c '^install_weak_deps=False$' /etc/dnf/dnf.conf 2>/dev/null || true)" != 1 ]; then
  sudo python3 - <<'PY'
conf = "/etc/dnf/dnf.conf"
try:
    lines = open(conf).read().splitlines()
except FileNotFoundError:
    lines = ["[main]"]
lines = [l for l in lines if l.strip() != "install_weak_deps=False"]
out, inserted = [], False
for l in lines:
    out.append(l)
    if l.strip() == "[main]" and not inserted:
        out.append("install_weak_deps=False")
        inserted = True
if not inserted:
    out += ["[main]", "install_weak_deps=False"]
open(conf, "w").write("\n".join(out) + "\n")
PY
  echo "install-packages: enforced install_weak_deps=False in /etc/dnf/dnf.conf"
fi

# `dnf copr` lives in dnf5-plugins, which Fedora minimal does not ship — the
# copr loop below dies without it. (Also declared in the manifest for the
# inventory's sake; installed here first because of the chicken-and-egg.)
rpm -q dnf5-plugins >/dev/null 2>&1 \
  || sudo dnf install --setopt=install_weak_deps=False -y dnf5-plugins

mapfile -t coprs < <(python3 - "$manifest" <<'PY'
import sys, tomllib
m = tomllib.load(open(sys.argv[1], "rb"))
for c in m.get("copr", []):
    print(c["name"])
PY
)

mapfile -t pkgs < <(python3 - "$manifest" "$arch" <<'PY'
import sys, tomllib
m = tomllib.load(open(sys.argv[1], "rb"))
arch = sys.argv[2]
for p in m.get("pkg", []):
    if p.get("arch", "all") in ("all", arch):
        print(p["name"])
PY
)

# mapfile does not propagate the substituted python's exit status — a parse
# failure would leave pkgs empty and hand dnf a bare `install` below. Refuse.
if [ "${#pkgs[@]}" -eq 0 ]; then
  echo "install-packages: manifest parse produced zero packages (python3/tomllib failure?) — aborting" >&2
  exit 1
fi

# Warn-don't-abort from here down (audit 2026-08-08): this script gates the
# ENTIRE apply — a failing run_before blocks even the file phase — so a single
# COPR outage or dead mirror must degrade, not brick the machine. Failures
# leave the hash unwritten, and the next apply retries.
for copr in "${coprs[@]}"; do
  sudo dnf copr enable -y "$copr" \
    || echo "install-packages: copr enable $copr failed — its packages will skip this pass" >&2
done

# Remi's repo: parallel-installable PHP SCL collections (php82/83/84 beside
# the system 8.5 — multi-version decision 2026-08-07, aarch64 packages
# verified against rpms.remirepo.net the same day). A release rpm, not a
# copr, hence its own bootstrap. The default-enabled 'remi' repo carries the
# SCLs; the remi-php8X repos stay disabled on purpose — enabling one REPLACES
# the system php.
rpm -q remi-release >/dev/null 2>&1 \
  || sudo dnf install --setopt=install_weak_deps=False -y \
       "https://rpms.remirepo.net/fedora/remi-release-$(rpm -E %fedora).rpm" \
  || echo "install-packages: remi-release install failed — php8x SCLs will skip this pass" >&2

# The default-enabled [remi] repo also ships composer, release-tagged .remi
# so it outranks Fedora's on every upgrade — dnf then noisily fails the swap
# against the installed Fedora composer ("cannot install both composer-…remi
# and …@System", seen 2026-08-07) and would hand composer ownership to remi
# the day the solver finds a path. remi is here ONLY for the SCL php8x
# collections; composer stays Fedora's. Per-repo exclude via dnf5's override
# dir (idempotent rewrite each apply), never the rpm-owned remi.repo.
sudo dnf5 config-manager setopt --create-missing-dir remi.excludepkgs=composer \
  || echo "install-packages: remi composer exclude failed — watch for a composer takeover on upgrade" >&2

# RPM Fusion (free): the full ffmpeg. Fedora's own ffmpeg-free strips the
# H.264/H.265 encoders for patent reasons (Cisco's openh264 is the only
# sanctioned path), so omacut's and omarchy's hardcoded libx264 invocations
# die on it. User decision 2026-08-07: match the Arch setup, where stock
# ffmpeg carries libx264, instead of patching every consumer. A release rpm
# like remi above, hence the same bootstrap shape.
rpm -q rpmfusion-free-release >/dev/null 2>&1 \
  || sudo dnf install --setopt=install_weak_deps=False -y \
       "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
  || echo "install-packages: rpmfusion-free install failed — full ffmpeg will skip this pass" >&2

# One-time migration on machines that already carry ffmpeg-free: the two
# conflict, so the plain install below would abort with ffmpeg-free present.
# swap replaces the whole -free lib stack (--allowerasing, per RPM Fusion's
# own howto); dependents keep working — the rpmfusion libs provide the same
# sonames.
if rpm -q ffmpeg-free >/dev/null 2>&1; then
  sudo dnf swap --setopt=install_weak_deps=False -y --allowerasing ffmpeg-free ffmpeg \
    || echo "install-packages: ffmpeg swap failed — the bulk install may conflict; retrying next apply" >&2
fi

# --skip-unavailable: without it the transaction is all-or-nothing, and one
# stale name or one repo the loop above failed to enable turns a fresh
# machine into a zero-package brick. The rpm -q sweep after names anything
# that skipped, and leaves the hash unwritten so every apply retries until
# the manifest and reality agree.
sudo dnf install --setopt=install_weak_deps=False --skip-unavailable -y "${pkgs[@]}" \
  || { echo "install-packages: dnf transaction failed — nothing recorded, rerun 'chezmoi apply' in a terminal" >&2; exit 0; }

missing=()
for p in "${pkgs[@]}"; do
  rpm -q "$p" >/dev/null 2>&1 || missing+=("$p")
done
if [ "${#missing[@]}" -gt 0 ]; then
  echo "install-packages: NOT installed (unavailable this pass): ${missing[*]}" >&2
  echo "install-packages: hash withheld — every apply retries until these land or the manifest drops them" >&2
  exit 0
fi

# Packages this desktop must not have: they shadow the shell's own lock,
# keyring-agent and bar. Fedora minimal ships none of them (verified
# 2026-08-06), but if something dragged one in, say so rather than let it
# fight the shell. Removal stays a user decision — the brief forbids
# unapproved `dnf remove`.
unwanted="$(rpm -q --qf '%{NAME}\n' waybar swaylock gnome-keyring 2>/dev/null | grep -vF 'not installed' || true)"
if [ -n "$unwanted" ]; then
  echo "install-packages: WARNING — conflicting packages present: ${unwanted//$'\n'/ }" >&2
  echo "install-packages: remove with: sudo dnf remove ${unwanted//$'\n'/ }" >&2
fi

# Success — record it so healthy applies skip the dnf round trip entirely.
mkdir -p "$(dirname "$hashfile")"
printf '%s\n' "$current" >"$hashfile"
