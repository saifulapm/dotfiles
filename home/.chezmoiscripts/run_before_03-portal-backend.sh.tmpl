#!/bin/bash
# Registers the shell's file chooser as an xdg-desktop-portal backend.
#
# Everything else about the picker lives in $HOME: the D-Bus activation file
# under ~/.local/share/dbus-1/services, the preference in
# ~/.config/xdg-desktop-portal/niri-portals.conf, the service and the QML. Only
# the .portal declaration has to be root-owned — xdg-desktop-portal reads
# exactly one portals directory, compiled in as
# /usr/share/xdg-desktop-portal/portals, and XDG_DESKTOP_PORTAL_DIR replaces
# that directory rather than adding to it (which would hide the gnome and gtk
# backends along with everything they carry).
#
# Runs on every apply; the src-vs-dest cmp below is the real change gate.
# (Was run_onchange, but run_onchange records "done" on exit 0 — a run whose
# pkexec was declined skipped gracefully and was never retried until the
# portal file itself changed. Found 2026-08-06.)
set -euo pipefail

src="{{ .chezmoi.homeDir }}/.dotfiles/packages/qshell.portal"
dest=/usr/share/xdg-desktop-portal/portals/qshell.portal

[ -f "$src" ] || exit 0

if [ -f "$dest" ] && cmp -s "$src" "$dest"; then
  exit 0
fi

# Root, by whichever route this run can actually reach. `chezmoi apply` from a
# terminal gets sudo; run from anything without a controlling terminal — a
# background agent, a keybind, a systemd unit — sudo cannot prompt at all, so
# fall back to pkexec and let the shell's own polkit agent ask on screen.
run_root() {
  if sudo -n true 2>/dev/null; then
    sudo "$@"
  elif [ -t 0 ] && sudo -v 2>/dev/null; then
    sudo "$@"
  elif command -v pkexec >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    echo "portal backend: asking for authorization on screen…" >&2
    timeout 180 pkexec "$@"
  else
    return 1
  fi
}

if ! run_root /usr/bin/install -D -m 0644 "$src" "$dest"; then
  echo "portal backend: not authorized — skipping (rerun 'chezmoi apply')" >&2
  echo "portal backend: file dialogs keep using the gtk backend until then" >&2
  exit 0
fi

# The frontend caches the backend list at startup.
systemctl --user restart xdg-desktop-portal.service 2>/dev/null || true
echo "portal backend: installed $dest"
