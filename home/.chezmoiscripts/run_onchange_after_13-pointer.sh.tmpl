#!/bin/bash
# pointer source hash: {{ joinPath .chezmoi.workingTree "bin/dots-pointer.c" | include | sha256sum }}
{{ template "lib.sh" . }}
mkdir -p "$HOME/.local/bin"
# The protocol's C bindings come from wlr-protocols' XML, generated next to the build.
gen=$(mktemp -d)
xml=/usr/share/wlr-protocols/unstable/wlr-virtual-pointer-unstable-v1.xml
wayland-scanner client-header "$xml" "$gen/wlr-virtual-pointer-unstable-v1-client-protocol.h" &&
  wayland-scanner private-code "$xml" "$gen/wlr-virtual-pointer-unstable-v1-protocol.c" &&
  gcc -O2 -Wall -I"$gen" -o "$HOME/.local/bin/dots-pointer" {{ joinPath .chezmoi.workingTree "bin/dots-pointer.c" | quote }} "$gen/wlr-virtual-pointer-unstable-v1-protocol.c" -lwayland-client || {
  rm -rf "$gen"
  die "pointer build failed"
}
rm -rf "$gen"
