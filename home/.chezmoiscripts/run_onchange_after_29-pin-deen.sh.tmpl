#!/bin/bash
# deen-data: {{ range (include (joinPath .chezmoi.workingTree "versions.toml") | fromToml).pin }}{{ if eq .name "deen-data" }}{{ .version }}{{ end }}{{ end }}, gh: {{ if stat (joinPath (env "GH_CONFIG_DIR" | default (joinPath .chezmoi.homeDir ".config/gh")) "hosts.yml") }}logged in{{ else }}not logged in{{ end }} (the data is built from the deen-data pin, which runs just before this, so its version and the gh login re-run this when either changes)
{{ template "lib.sh" . }}
{{ template "pin.sh" (dict "chezmoi" .chezmoi "name" "deen") }}
{{ template "cargo.sh" . }}
tarball=$(pin_fetch)
tar -xzf "$tarball" -C "$pin_tmp"
src=$pin_tmp/deen-$pin_version
pin_cargo "$src" deen
# The Quran text, its word meanings and Hisn al-Muslim are built from the deen-data tree, again whenever deen or that tree moves, with the pronunciation from the deen just installed; only the hadith corpus waits for Deen's first open.
data=$HOME/.local/share/deen
sources=$HOME/.local/share/deen-data
if [[ -f $sources/.commit ]]; then
  built="$pin_version $(cat "$sources/.commit")"
  if [[ $(cat "$data/built-from" 2>/dev/null) != "$built" ]]; then
    DEEN_BIN=$HOME/.local/bin/deen "$src/scripts/build-data" "$sources" "$data" || die "pin deen: scripts/build-data failed"
    echo "$built" >"$data/built-from"
  fi
fi
pin_done
