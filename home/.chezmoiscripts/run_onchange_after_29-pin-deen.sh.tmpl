#!/bin/bash
{{ template "lib.sh" . }}
{{ template "pin.sh" (dict "chezmoi" .chezmoi "name" "deen") }}
{{ template "cargo.sh" . }}
tarball=$(pin_fetch)
tar -xzf "$tarball" -C "$pin_tmp"
src=$pin_tmp/deen-$pin_version
pin_cargo "$src" deen
# The Quran text, its word meanings and Hisn al-Muslim come at the first apply that lacks them; only the hadith corpus waits for Deen's first open.
data=$HOME/.local/share/deen
mkdir -p "$data"
for pair in quran:fetch-data words:fetch-words duas:fetch-duas; do
  file=$data/${pair%%:*}.json
  [ -s "$file" ] && continue
  "$src/scripts/${pair#*:}" >"$file.tmp" || { rm -f "$file.tmp"; die "pin deen: scripts/${pair#*:} failed"; }
  mv -f "$file.tmp" "$file"
done
pin_done
