#!/bin/bash
# theme sources hash:{{ range concat (glob (joinPath .chezmoi.workingTree "colorschemes/*")) (glob (joinPath .chezmoi.workingTree "shell/lib/colorscheme*.mjs")) (list (joinPath .chezmoi.workingTree "shell/lib/render-out.mjs")) (list (joinPath .chezmoi.workingTree "shell/lib/theme.mjs")) (list (joinPath .chezmoi.workingTree "shell/lib/apps.mjs")) (list (joinPath .chezmoi.workingTree "shell/lib/toml.mjs")) }} {{ include . | sha256sum }}{{ end }}
{{ template "lib.sh" . }}
state=${XDG_STATE_HOME:-$HOME/.local/state}/dots
# The clipboard history and the notifications, one-time codes among them, live here, so only the user reads it.
mkdir -p "$state" && chmod 700 "$state"
# The render keeps a colorscheme chosen earlier, and saves artboard over a name that is none.
node {{ joinPath .chezmoi.workingTree "shell/lib/colorscheme-render.mjs" | quote }} --saved || die "colorscheme render failed"
# Only a switch tells GTK light or dark and recolours the open apps, so a dark old theme mapped to artboard leaves nothing dark.
{{ joinPath .chezmoi.workingTree "bin/dots" | quote }} colorscheme "$(cat "$state/theme")" >/dev/null || die "colorscheme switch failed"
