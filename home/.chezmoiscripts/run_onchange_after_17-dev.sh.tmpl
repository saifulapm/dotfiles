#!/bin/bash
# dev source hashes:{{ range list "dnsmasq.d/test-domains.conf" "resolved.conf.d/test-domains.conf" "sysctl.d/99-dev-unprivileged-ports.conf" }} {{ joinPath $.chezmoi.workingTree "system" . | include | sha256sum }}{{ end }}
{{ template "lib.sh" . }}
system={{ joinPath .chezmoi.workingTree "system" | quote }}
mkdir -p "$HOME/.config/caddy/sites" "$HOME/.local/state/php-fpm"
# dnsmasq answers *.test on 127.0.0.2, and resolved sends only .test there.
root install -D -m 0644 "$system/dnsmasq.d/test-domains.conf" /etc/dnsmasq.d/test-domains.conf || die "could not write the .test dnsmasq config"
root install -D -m 0644 "$system/resolved.conf.d/test-domains.conf" /etc/systemd/resolved.conf.d/test-domains.conf || die "could not route .test to dnsmasq"
root install -D -m 0644 "$system/sysctl.d/99-dev-unprivileged-ports.conf" /etc/sysctl.d/99-dev-unprivileged-ports.conf || die "could not let caddy-dev use ports 80 and 443"
root systemctl enable dnsmasq 2>/dev/null || log ".test resolves once dnsmasq runs at the next boot"
if root systemctl restart dnsmasq systemd-resolved 2>/dev/null && root sysctl -q --system 2>/dev/null; then
  # The sockets are enabled by their wants/ links; a running manager starts them now.
  systemctl --user daemon-reload 2>/dev/null && systemctl --user start sockets.target 2>/dev/null || true
fi
# validate provisions caddy's internal CA, so its root exists to be trusted before caddy first serves.
caddy validate --config "$HOME/.config/caddy/Caddyfile" --adapter caddyfile >/dev/null 2>&1 || die "caddy refused ~/.config/caddy/Caddyfile"
root install -D -m 0644 "$HOME/.local/share/caddy/pki/authorities/local/root.crt" /etc/pki/ca-trust/source/anchors/caddy-dev-local-ca.crt || die "could not trust caddy's .test CA"
root update-ca-trust || die "update-ca-trust failed"
