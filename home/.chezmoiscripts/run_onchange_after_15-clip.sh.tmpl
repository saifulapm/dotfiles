#!/bin/bash
{{ template "lib.sh" . }}
# dots-clip.service runs the store script from ~/.local/bin, since the repo's bin/ is not on the user manager's PATH.
mkdir -p "$HOME/.local/bin"
ln -sfn {{ joinPath .chezmoi.workingTree "bin/dots-clip-store" | quote }} "$HOME/.local/bin/dots-clip-store" || die "could not link the clipboard store script"
