#!/bin/bash
{{ template "lib.sh" . }}
{{ template "pin.sh" (dict "chezmoi" .chezmoi "name" "kakoune-lsp") }}
tarball=$(pin_fetch)
tar -xzf "$tarball" -C "$pin_tmp"
src=$pin_tmp/kakoune-lsp-$pin_version
# The releases ship no aarch64 Linux binary, so both arches build from source.
cargo build --release --locked --manifest-path "$src/Cargo.toml"
install -D -m 0755 -t "$HOME/.local/bin" "$src/target/release/kak-lsp"
pin_done
