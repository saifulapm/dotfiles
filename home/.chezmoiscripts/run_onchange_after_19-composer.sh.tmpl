#!/bin/bash
{{ template "lib.sh" . }}
# Bash does not read fish's config, so the composer home is set here to match it.
export COMPOSER_HOME="$HOME/.config/composer"
# Composer runs sudo -K as it starts unless this is set, which ended the install's sudo cache and failed every root step after it; it runs as Saiful here, never root.
export COMPOSER_ALLOW_SUPERUSER=1
# The tool list is in this script, so a change to it reruns the step.
composer global require --no-interaction laravel/installer:^5 laravel/pint:^1 || die "the composer global install failed"
