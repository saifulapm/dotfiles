#!/bin/bash
# Gives bluetooth.service a Restart=on-failure drop-in.
#
# Why this needs root at all: it is a SYSTEM unit, so unlike almost everything
# else in this repo the override cannot live in $HOME. systemd reads drop-ins
# from /etc/systemd/system/<unit>.d, and there is no per-user equivalent for a
# system service. The reasoning for the override itself is in the file being
# installed, packages/bluetooth-restart.conf.
#
# Same shape as run_before_03-portal-backend.sh.tmpl, for the same reasons:
# runs on every apply with a src-vs-dest cmp as the real change gate, rather
# than run_onchange, which records "done" on exit 0 and would therefore mark a
# declined-authorization run as complete and never retry it.
set -euo pipefail

# workingTree, not a hardcoded ~/.dotfiles — a non-default --source makes the
# hardcoded path miss and the [ -f ] guard below then skips silently.
src="{{ .chezmoi.workingTree }}/packages/bluetooth-restart.conf"
dest=/etc/systemd/system/bluetooth.service.d/10-restart.conf

[ -f "$src" ] || exit 0

# Nothing to do on a machine with no Bluetooth unit at all.
systemctl list-unit-files bluetooth.service >/dev/null 2>&1 || exit 0

if [ -f "$dest" ] && cmp -s "$src" "$dest"; then
  exit 0
fi

# Root by whichever route this run can reach: passwordless sudo, then sudo with
# a controlling terminal, then pkexec against the shell's polkit agent for runs
# with no tty (background agents, keybinds, systemd units).
run_root() {
  if sudo -n true 2>/dev/null; then
    sudo "$@"
  elif [ -t 0 ] && sudo -v 2>/dev/null; then
    sudo "$@"
  elif command -v pkexec >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    echo "bluetooth restart: asking for authorization on screen…" >&2
    timeout 180 pkexec "$@"
  else
    return 1
  fi
}

if ! run_root /usr/bin/install -D -m 0644 "$src" "$dest"; then
  echo "bluetooth restart: not authorized — skipping (rerun 'chezmoi apply')" >&2
  echo "bluetooth restart: bluetoothd stays Restart=no until then" >&2
  exit 0
fi

# Drop-ins are only read at daemon-reload. Not restarting bluetooth here: the
# point of the override is unattended recovery from a CRASH, and bouncing a
# working adapter mid-apply would drop any connected device for no reason.
run_root systemctl daemon-reload || true
echo "bluetooth restart: installed $dest"
