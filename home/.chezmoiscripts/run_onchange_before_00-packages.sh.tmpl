#!/bin/bash
# packages.toml hash: {{ include (joinPath .chezmoi.workingTree "packages.toml") | sha256sum }}
{{ template "lib.sh" . }}
list={{ joinPath .chezmoi.workingTree "packages.toml" | quote }}

# One "name copr rpm fusion" line per entry for this arch; copr is "-" when the package is in Fedora, rpm is "-" unless it installs from a URL, fusion is "-" unless it comes from RPM Fusion.
entries=$(awk -v arch="$(uname -m)" '
  function flush() { if (name != "" && (a == "all" || a == arch)) print name, (copr == "" ? "-" : copr), (rpm == "" ? "-" : rpm), (fusion == "" ? "-" : fusion) }
  function val() { match($0, /"[^"]*"/); return substr($0, RSTART + 1, RLENGTH - 2) }
  /^\[\[package\]\]/ { flush(); name = ""; a = ""; copr = ""; rpm = ""; fusion = ""; next }
  /^name *=/ { name = val() }
  /^arch *=/ { a = val() }
  /^copr *=/ { copr = val() }
  /^rpm *=/ { rpm = val() }
  /^rpmfusion *=/ { fusion = val() }
  END { flush() }
' "$list")

missing=()
from_fusion=()
while read -r name copr rpm fusion; do
  # Fedora's ffmpeg-free also answers to "ffmpeg", so an RPM Fusion package stays out of the batch, where dnf would quietly pick the Fedora one.
  if [[ $fusion != - ]]; then
    if [[ ! -e /etc/yum.repos.d/rpmfusion-$fusion.repo ]]; then
      log "enabling RPM Fusion $fusion"
      # download1 is RPM Fusion's own server; mirrors.rpmfusion.org can redirect to a mirror that times out.
      root dnf -y -q install "https://download1.rpmfusion.org/$fusion/fedora/rpmfusion-$fusion-release-$(rpm -E %fedora).noarch.rpm" ||
        log "could not reach RPM Fusion $fusion, so $name is left out until it is installed by hand"
    fi
    rpm -q --quiet "$name" || from_fusion+=("$name $fusion")
    continue
  fi
  if [[ $copr != - && ! -e /etc/yum.repos.d/_copr:copr.fedorainfracloud.org:${copr/\//:}.repo ]]; then
    log "enabling COPR $copr"
    root dnf -y -q copr enable "$copr" || die "could not enable COPR $copr"
  fi
  if [[ $rpm != - ]] && ! rpm -q --quiet "$name"; then
    log "installing $name"
    root dnf -y -q install "${rpm//\{fedora\}/$(rpm -E %fedora)}" || die "could not install $name"
  fi
  rpm -q --quiet "$name" || missing+=("$name")
done <<<"$entries"

# Remi also ships composer, which would fight Fedora's on every upgrade.
if [[ -e /etc/yum.repos.d/remi.repo ]]; then
  root dnf -y -q config-manager setopt --create-missing-dir remi.excludepkgs=composer || die "could not keep composer on Fedora's package"
fi

if ((${#missing[@]})); then
  log "installing ${missing[*]}"
  root dnf -y install "${missing[@]}" || die "dnf could not install ${missing[*]}"
fi

# --allowerasing replaces the -free libraries mpv and wf-recorder pulled in, as dnf swap would, and works whether or not they are there.
for entry in "${from_fusion[@]}"; do
  read -r name fusion <<<"$entry"
  [[ -e /etc/yum.repos.d/rpmfusion-$fusion.repo ]] || continue
  log "installing $name from RPM Fusion $fusion"
  # Fedora's dnf skips a repo it cannot reach, so with RPM Fusion down this installs ffmpeg-free and exits 0; rpm -q is the check.
  root dnf -y -q install --allowerasing "$name" && rpm -q --quiet "$name" || log "could not install $name from RPM Fusion $fusion"
done
