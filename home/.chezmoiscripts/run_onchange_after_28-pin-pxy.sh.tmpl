#!/bin/bash
{{ template "lib.sh" . }}
{{ template "pin.sh" (dict "chezmoi" .chezmoi "name" "pxy") }}
{{ template "cargo.sh" . }}
tarball=$(pin_fetch)
tar -xzf "$tarball" -C "$pin_tmp"
pin_cargo "$pin_tmp/pxy-$pin_version" pxy
# A running pxy keeps the old binary until it restarts, and the reload first makes the restart read the unit this apply linked.
systemctl --user daemon-reload 2>/dev/null && systemctl --user try-restart pxy.service 2>/dev/null || true
pin_done
