{{- $versions := include (joinPath .chezmoi.workingTree "versions.toml") | fromToml -}}
{{- $t := dict -}}
{{- range $versions.toolchain }}{{ $_ := set $t .name . }}{{ end -}}
{{- $tools := index $t "cmdline-tools" -}}
{{- $gradle := index $t "gradle" -}}
{{- $buildTools := index $t "build-tools" -}}
{{- $arm := index $t "arm-build-tools" -}}
{{- $swiftly := index $t "swiftly" -}}
{{- $swift := index $t "swift" -}}
{{- $arch := .chezmoi.arch | replace "arm64" "aarch64" | replace "amd64" "x86_64" -}}
#!/bin/bash
{{ template "lib.sh" . }}
# The toolchain lareys-mobile's Android shell and Rust engine build with, at the versions.toml [[toolchain]] numbers its engine also pins.
sdk=$HOME/Android/Sdk
tools_version={{ $tools.version | quote }}
tools_url={{ $tools.url | replace "{version}" $tools.version | quote }}
tools_sha256={{ $tools.sha256 | quote }}
packages=(platform-tools{{ range list "platform" "build-tools" "ndk" }}{{ $p := index $t . }} {{ $p.package | replace "{version}" $p.version | quote }}{{ end }})
{{- if eq .chezmoi.arch "amd64" }}
# Google ships the emulator for x86_64 Linux only; the image is the one the NUC's lareys AVD already runs.
image="system-images;android-35;google_apis;x86_64"
packages+=(emulator "$image")
{{- end }}
gradle_version={{ $gradle.version | quote }}
gradle_url={{ $gradle.url | replace "{version}" $gradle.version | quote }}
gradle_sha256={{ $gradle.sha256 | quote }}
swiftly_version={{ $swiftly.version | quote }}
swiftly_url={{ index $swiftly.url $arch | replace "{version}" $swiftly.version | quote }}
swiftly_sha256={{ index $swiftly.sha256 $arch | quote }}
swift_version={{ $swift.version | quote }}
swift_platform={{ $swift.platform | quote }}

# On disk, not in /tmp: /tmp is a small tmpfs on the Macs and the NDK does not fit.
mkdir -p "$HOME/.cache"
tmp=$(mktemp -d -p "$HOME/.cache" dots-mobile-XXXXXX)
trap 'rm -rf "$tmp"' EXIT
# fetch <url> <sha256>: downloads into the temp dir and prints the file; a wrong sha256 stops the script.
fetch() {
  local file=$tmp/${1##*/}
  curl -fsSL -o "$file" "$1" || die "mobile: could not download $1"
  echo "$2  $file" | sha256sum -c --status || die "mobile: sha256 of $1 is not $2"
  echo "$file"
}

"$HOME/.cargo/bin/rustup" target add aarch64-linux-android x86_64-linux-android || die "mobile: rustup could not add the Android targets"

# The tools' own version file names a release, not the zip's build number, so the number the zip came from is kept beside them.
tools=$sdk/cmdline-tools/latest
if [[ $(cat "$tools/.dots-version" 2>/dev/null) != "$tools_version" ]]; then
  zip=$(fetch "$tools_url" "$tools_sha256")
  unzip -q "$zip" -d "$tmp/tools"
  rm -rf "$tools"
  mkdir -p "$sdk/cmdline-tools"
  mv "$tmp/tools/cmdline-tools" "$tools"
  echo "$tools_version" >"$tools/.dots-version"
  log "mobile: Android command-line tools $tools_version"
fi

# Only what is missing goes to sdkmanager, so an apply with everything in place makes no call to Google.
missing=()
for p in "${packages[@]}"; do [[ -d $sdk/${p//;//} ]] || missing+=("$p"); done
if ((${#missing[@]})); then
  # printf finishes before sdkmanager exits, so no SIGPIPE under pipefail.
  printf 'y\n%.0s' {1..50} | "$tools/bin/sdkmanager" --sdk_root="$sdk" --licenses >/dev/null || die "mobile: sdkmanager could not accept the licenses"
  "$tools/bin/sdkmanager" --sdk_root="$sdk" "${missing[@]}" >"$tmp/sdkmanager.log" 2>&1 || { cat "$tmp/sdkmanager.log" >&2; die "mobile: sdkmanager could not install ${missing[*]}"; }
  log "mobile: ${missing[*]}"
fi

{{ if eq .chezmoi.arch "arm64" -}}
# Google builds aapt2, zipalign and adb for x86_64 only, so the Macs swap in arm64 builds and Fedora's adb, each checked whenever this script runs, so the next toolchain change undoes an sdkmanager update that put Google's back.
build_tools=$sdk/build-tools/{{ $buildTools.version }}
{{- range $f := list "aapt2" "zipalign" }}
sum={{ index $arm.sha256 $f | quote }}
if ! echo "$sum  $build_tools/{{ $f }}" | sha256sum -c --status 2>/dev/null; then
  file=$(fetch {{ print ($arm.url | replace "{version}" $arm.version) "/" $f | quote }} "$sum")
  install -m 0755 "$file" "$build_tools/{{ $f }}"
  log "mobile: arm64 {{ $f }}"
fi
{{- end }}
# AGP runs the aapt2 it fetches from Maven, which is x86_64, unless gradle.properties names another.
mkdir -p "$HOME/.gradle"
touch "$HOME/.gradle/gradle.properties"
{ grep -v '^android.aapt2FromMavenOverride=' "$HOME/.gradle/gradle.properties" || true; echo "android.aapt2FromMavenOverride=$build_tools/aapt2"; } >"$tmp/gradle.properties"
cat "$tmp/gradle.properties" >"$HOME/.gradle/gradle.properties"
for f in adb fastboot; do ln -sfn "/usr/bin/$f" "$sdk/platform-tools/$f"; done
{{ end -}}

{{ if eq .chezmoi.arch "amd64" -}}
if [[ ! -f $HOME/.android/avd/lareys.ini ]]; then
  # avdmanager asks whether to make a custom hardware profile; the answer is no.
  echo no | "$tools/bin/avdmanager" create avd -n lareys -k "$image" -d pixel_8 >"$tmp/avdmanager.log" 2>&1 || { cat "$tmp/avdmanager.log" >&2; die "mobile: avdmanager could not create the lareys AVD"; }
  log "mobile: the lareys AVD"
fi
{{ end -}}

gradle_home=$HOME/.local/opt/gradle-$gradle_version
if [[ ! -x $gradle_home/bin/gradle ]]; then
  zip=$(fetch "$gradle_url" "$gradle_sha256")
  mkdir -p "$HOME/.local/opt"
  unzip -q -o "$zip" -d "$HOME/.local/opt"
  log "mobile: Gradle $gradle_version"
fi
mkdir -p "$HOME/.local/bin"
ln -sfn "$gradle_home/bin/gradle" "$HOME/.local/bin/gradle"

export SWIFTLY_HOME_DIR=$HOME/.local/share/swiftly SWIFTLY_BIN_DIR=$HOME/.local/share/swiftly/bin
# init with a newer swiftly updates the one in place and leaves its toolchains alone.
if [[ $("$SWIFTLY_BIN_DIR/swiftly" --version 2>/dev/null) != "$swiftly_version" ]]; then
  tarball=$(fetch "$swiftly_url" "$swiftly_sha256")
  tar -xzf "$tarball" -C "$tmp"
  "$tmp/swiftly" init --platform "$swift_platform" --skip-install --no-modify-profile --quiet-shell-followup --assume-yes >"$tmp/swiftly.log" 2>&1 || { cat "$tmp/swiftly.log" >&2; die "mobile: swiftly init failed"; }
  log "mobile: swiftly $swiftly_version"
fi
if [[ ! -d $SWIFTLY_HOME_DIR/toolchains/$swift_version ]]; then
  # With a file to write them to, swiftly never runs sudo dnf for the system packages it thinks are missing; its yum check answers yes on dnf5 anyway, so the run below is the check.
  "$SWIFTLY_BIN_DIR/swiftly" install "$swift_version" --use --assume-yes --post-install-file "$tmp/swift-deps" >"$tmp/swiftly.log" 2>&1 || { cat "$tmp/swiftly.log" >&2; die "mobile: swiftly could not install Swift $swift_version"; }
  log "mobile: Swift $swift_version"
fi
out=$("$SWIFTLY_BIN_DIR/swift" --version 2>&1) || die "mobile: Swift $swift_version does not run: $out"
# swiftly's bin dir also proxies clang and lld, which would shadow the distribution clang the engine's Android linker runs, so only these two are linked.
for b in swift swiftc; do ln -sfn "$SWIFTLY_BIN_DIR/$b" "$HOME/.local/bin/$b"; done
