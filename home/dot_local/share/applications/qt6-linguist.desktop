# Shadows /usr/share/applications/qt6-linguist.desktop to add NoDisplay=true —
# see qt6-designer.desktop next to this file for the why (both come in with
# qt6-qttools-devel, librepods' build dep, not by choice).
[Desktop Entry]
Name=Qt6 Linguist
GenericName=Translation tool
Comment=Add translations to Qt5 applications
Exec=linguist-qt6
Icon=linguist-qt6
MimeType=text/vnd.trolltech.linguist;application/x-linguist;
Terminal=false
Type=Application
Categories=Qt;Development;
NoDisplay=true
