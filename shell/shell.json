{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "sync": {
    "enabled": true,
    "dir": "~/.local/state/qshell/sync/model-usage"
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "clock",
    "left": [
      "launcher",
      "workspaces",
      "window"
