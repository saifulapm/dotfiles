    "center": [
      "indicators",
      {
        "id": "clock",
        "birthYear": 1991,
        "lifeExpectancy": 90
      },
      "weather",
      "update"
    ],
    "right": [
      "tray",
      "media",
      "ai",
      "kb",
      "devservices",
      "icloud",
      "dropbox-rclone",
      "dropbox",
      "tailscale",
      "mic",
      "bluetooth",
      "network",
      "audio",
      "monitor",
      "battery",
      "notifs"
    ]
  }
}
