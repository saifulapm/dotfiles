{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "blank": 0,
    "lock": 360
  },
  "sync": {
    "enabled": true,
    "dir": "~/.local/state/qshell/sync/model-usage"
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "clock",
    "left": [
      "launcher",
      "workspaces",
      "window"
    ],
    "center": [
      "indicators",
      "prayer",
      {
        "id": "clock",
        "birthYear": 1991,
        "lifeExpectancy": 70,
        "format": "ddd d MMM HH:mm"
      },
      {
        "id": "timezones",
        "zones": [
          "UTC",
          "Asia/Dhaka",
          "Europe/London",
          "America/New_York"
        ]
      },
      "weather",
      "update"
    ],
    "right": [
      "tray",
      "mail",
      "ai",
      "pxy",
      "kb",
      "devservices",
      "dufs",
      "pass",
      "ports",
      "drives",
      "ssh",
      "icloud",
      "dropbox",
      "sync",
      "dnsshield",
      "warp",
      "tailscale",
      "airpods",
      "bluetooth",
      "network",
      "mic",
      "audio",
      "monitor",
      "battery",
      "notifs",
      "shelf"
    ]
  }
}
