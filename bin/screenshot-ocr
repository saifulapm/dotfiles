#!/usr/bin/env bash
# screenshot-ocr — select a region with slurp, OCR it with tesseract, copy
# the recognized text to the clipboard.
#
#   screenshot-ocr            OCR a region → clipboard
#   screenshot-ocr --speak    OCR a region → clipboard, then read it aloud
#   screenshot-ocr --stop     stop whatever is currently being read
#
# Port of the pre-qshell dotfiles-linux script. Its wayfreeze screen freeze
# is back as of 2026-08-07 (cargo-built, presence-gated below) — without the
# binary, slurp draws over the live screen as before.
#
# --speak exists because Orca is the wrong tool for "read me THAT bit": it is
# an AT-SPI screen reader that walks widget trees, so it is blind to text in
# images, video, canvas and PDFs, and it narrates chrome you did not ask for.
# OCR + TTS reads exactly the pixels you drew a box around, in any app.
#
# Set OCR_LANGS to override (e.g. "eng+deu"); needs the matching
# tesseract-langpack-* packages.
set -euo pipefail

notify() {
  notify-send -a qshell -t "${2:-2000}" "OCR" "$1" >/dev/null 2>&1 || true
}

# --- speech ------------------------------------------------------------------
# Backends in descending quality; the first one actually present wins, so
# installing a better engine later upgrades this script with no edit here.
#
# piper is gated on its VOICE MODEL, not its binary, and deliberately so:
# Fedora ships an unrelated `piper` (a GTK gaming-mouse config tool), and the
# neural TTS of the same name is a pip package. A voice .onnx on disk is the
# only unambiguous signal that the TTS one is what is installed.
PIPER_VOICE="${PIPER_VOICE:-$HOME/.local/share/piper/en_US-amy-medium.onnx}"
FLITE_VOICE="${FLITE_VOICE:-slt}"

# sherpa-onnx (run_after_24-sherpa-onnx.sh) is the good one: one prebuilt
# binary that runs Kokoro (82M-param neural, natural-sounding) and Kitten
# (15M, tiny) from the same CLI, no Python and no venv. It lives in a
# self-contained tree rather than on PATH, so nothing but this script needs
# to know about its LD_LIBRARY_PATH.
#
# Defaults are Kokoro fp32 and voice 3. fp32 rather than int8 is measured,
# not assumed: on this M2, int8 is SLOWER than fp32 despite being a third of
# the size — 3.44 s vs 1.92 s for the same sentence, three runs each, at the
# cost of 177 MB (360 -> 537 MB peak RSS). ARM int8 kernels lose to the fp32
# paths here, and quantization cannot improve fidelity, so fp32 is the strict
# win as long as the RAM fits — which it does even with ~1.5 GB free (see
# bin/mem-pressure-warn). Revisit if that headroom ever shrinks.
# Override per-invocation, e.g. SHERPA_VOICE=16 or
# SHERPA_MODEL=kitten-nano-en-v0_8-int8 (143 MB peak, the low-RAM fallback).
SHERPA_DIR="${SHERPA_DIR:-$HOME/.local/share/sherpa-onnx}"
SHERPA_MODEL="${SHERPA_MODEL:-kokoro-multi-lang-v1_0}"
SHERPA_VOICE="${SHERPA_VOICE:-3}"
export PIPER_VOICE FLITE_VOICE SHERPA_DIR SHERPA_MODEL SHERPA_VOICE

pick_backend() {
  if [[ -x $SHERPA_DIR/bin/sherpa-onnx-offline-tts-play &&
    -d $SHERPA_DIR/models/$SHERPA_MODEL ]]; then
    echo sherpa
  elif [[ -f $PIPER_VOICE ]] && command -v piper >/dev/null 2>&1 &&
    { command -v ffplay >/dev/null 2>&1 || command -v pw-play >/dev/null 2>&1; }; then
    echo piper
  elif command -v espeak-ng >/dev/null 2>&1; then
    echo espeak-ng
  elif command -v flite >/dev/null 2>&1; then
    echo flite
  fi
}

# Runs in a detached process group (see speak) so --stop can kill the engine
# AND its player, not just the shell that launched them.
run_tts() {
  case "$TTS_BACKEND" in
  sherpa)
    local m="$SHERPA_DIR/models/$SHERPA_MODEL" onnx flags
    onnx="$m/model.int8.onnx"
    [[ -f $onnx ]] || onnx="$m/model.onnx"
    # Kokoro and Kitten take differently-named flags for the same four files.
    if [[ $SHERPA_MODEL == kitten* ]]; then
      flags=(--kitten-model="$onnx" --kitten-voices="$m/voices.bin"
        --kitten-tokens="$m/tokens.txt" --kitten-data-dir="$m/espeak-ng-data")
    else
      flags=(--kokoro-model="$onnx" --kokoro-voices="$m/voices.bin"
        --kokoro-tokens="$m/tokens.txt" --kokoro-data-dir="$m/espeak-ng-data"
        --kokoro-lang=en)
    fi
    # -play streams audio as the model synthesizes it, so speech starts almost
    # at once instead of after the whole passage is rendered.
    #
    # --output-filename is NOT optional despite reading like it: with it unset
    # the tool writes ./generated.wav into whatever directory niri happened to
    # spawn the bind in. Pointed at the scratch file so the trap reaps it.
    # The LEADING SPACE on the text is load-bearing, not a typo. sherpa's
    # option parser inspects the positional argument too, so a passage that
    # begins with "--" (a markdown rule, a diff hunk, a shell flag in a
    # terminal capture — all routine OCR fodder) aborts with "Invalid option"
    # and exit 255, giving silence rather than speech. It has no "--" end-of-
    # options separator, and a space is inaudible, so this is the fix.
    LD_LIBRARY_PATH="$SHERPA_DIR/lib" \
      "$SHERPA_DIR/bin/sherpa-onnx-offline-tts-play" "${flags[@]}" \
      --num-threads=4 --sid="$SHERPA_VOICE" \
      --output-filename="$SPEAK_WAV" " $(cat "$1")" >/dev/null 2>&1
    ;;
  piper)
    if command -v pw-play >/dev/null 2>&1; then
      piper --model "$PIPER_VOICE" --output-raw <"$1" |
        pw-play --format s16 --rate 22050 --channels 1 -
    else
      piper --model "$PIPER_VOICE" --output-raw <"$1" |
        ffplay -f s16le -ar 22050 -ac 1 -nodisp -autoexit -loglevel quiet -
    fi
    ;;
  espeak-ng) espeak-ng -v en-us -s 175 -f "$1" ;;
  flite) flite -voice "$FLITE_VOICE" -f "$1" ;;
  esac
}

# Scratch files live at FIXED paths, not mktemp ones, and that is what makes
# cleanup reliable. Only one read can be in flight at a time (speak() stops any
# predecessor first), so a stable name is safe — and it means three independent
# things can clean up: the reader's own trap, --stop, and the next --speak
# overwriting them. An mktemp path can only be cleaned by whoever still knows
# it, which is how the earlier version leaked two files per interrupted read:
# the trap referenced a `local` that had already gone out of scope by the time
# a signal unwound the function. XDG_RUNTIME_DIR is tmpfs and per-user, so even
# a total failure to clean costs two files that vanish at logout.
runtime="${XDG_RUNTIME_DIR:-/tmp}"
pidfile="$runtime/screenshot-ocr-speak.pid"
SPEAK_TXT="$runtime/screenshot-ocr-speak.txt"
SPEAK_WAV="$runtime/screenshot-ocr-speak.wav"
SPEAK_PID="$pidfile"
export SPEAK_TXT SPEAK_WAV SPEAK_PID

# SPEAK_* are exported globals rather than function locals precisely so they
# are still in scope when a signal fires this trap mid-read.
#
# The pidfile is removed here too, and that is a correctness fix rather than
# tidiness: a read that ends on its own would otherwise leave a pidfile naming
# a dead process group, and PGIDs get reused. A later --stop would then signal
# whatever unrelated process group inherited that number.
speak_runner() {
  # The READER records its own pid, rather than the parent recording $!.
  # setsid forks whenever its caller is already a process group leader, and
  # whether that is true depends on how the bind was spawned — so $! names the
  # short-lived wrapper about half the time, and --stop then signals a pid that
  # has already exited while the real reader plays on, unkillable. Inside the
  # new session this shell IS the group leader, so $$ is exactly the PGID that
  # `kill -- -PGID` needs.
  echo "$$" >"$SPEAK_PID"
  trap 'rm -f "$SPEAK_TXT" "$SPEAK_WAV" "$SPEAK_PID"' EXIT INT TERM
  run_tts "$SPEAK_TXT"
}

stop_speech() {
  if [[ -f $pidfile ]]; then
    local pid
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    # Negative PID = whole process group. setsid made the child a group leader,
    # so its PID is its PGID and one signal takes down engine + player together.
    [[ -n $pid ]] && { kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true; }
    # Reap before deleting, or the delete races the engine's dying write: a
    # signalled sherpa still flushes its wav a few ms later and re-creates the
    # file we just removed, stranding it until the next read. Bounded at ~2 s
    # so a wedged engine cannot hang the bind.
    # pgrep -g selects by process GROUP; ps -g is ambiguous (POSIX reads it as
    # session), which is the wrong question to ask here.
    if [[ -n $pid ]]; then
      for _ in {1..40}; do
        pgrep -g "$pid" >/dev/null 2>&1 || break
        sleep 0.05
      done
    fi
    rm -f "$pidfile"
  fi
  # Belt and braces: the reader's own trap should have done this already.
  rm -f "$SPEAK_TXT" "$SPEAK_WAV"
}

# OCR emits one line per visual line, so a wrapped paragraph arrives as a
# stack of fragments. Fed to TTS verbatim that becomes a full stop at every
# line end — a stilted, robotic read. Rejoin each paragraph into one line
# (blank line = real break) and undo hyphenation split across lines.
reflow() {
  awk '
    /^[[:space:]]*$/ { if (buf != "") { print buf; buf = "" } ; next }
    {
      line = $0
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      if (line == "") next
      if (buf == "") buf = line
      else if (buf ~ /[A-Za-z]-$/) { sub(/-$/, "", buf); buf = buf line }
      else buf = buf " " line
    }
    END { if (buf != "") print buf }
  '
}

speak() {
  local text="$1"
  TTS_BACKEND="$(pick_backend)"
  if [[ -z $TTS_BACKEND ]]; then
    notify "No speech engine found (install flite, espeak-ng or piper)" 4000
    return 1
  fi
  export TTS_BACKEND

  stop_speech # a second press interrupts the previous read rather than overlapping

  printf '%s\n' "$text" | reflow >"$SPEAK_TXT"

  # --fork makes the double-fork unconditional, so the reader is always a
  # freshly-created session leader regardless of how this script was spawned.
  # It writes its own pidfile (see speak_runner); $! here would be the wrapper.
  setsid --fork bash -c "$(declare -f run_tts speak_runner); speak_runner" \
    >/dev/null 2>&1 &
}

# --- entry point -------------------------------------------------------------
speak_mode=0
case "${1:-}" in
--stop)
  stop_speech
  exit 0
  ;;
--speak) speak_mode=1 ;;
"") ;;
*)
  echo "usage: screenshot-ocr [--speak | --stop]" >&2
  exit 2
  ;;
esac

if ! command -v tesseract >/dev/null 2>&1; then
  notify "tesseract is not installed" 3000
  exit 1
fi

# Freeze while picking (wayfreeze, presence-gated — see screenshot-annotate);
# grim reads the frozen overlay, the EXIT trap covers every early return.
freeze_pid=""
if command -v wayfreeze >/dev/null 2>&1; then
  wayfreeze --hide-cursor &
  freeze_pid=$!
  trap '[[ -n $freeze_pid ]] && kill "$freeze_pid" 2>/dev/null || true' EXIT
  sleep 0.15
fi

region="$(slurp 2>/dev/null)" || exit 0
[[ -z $region ]] && exit 0

text="$(grim -g "$region" - | tesseract stdin stdout \
  --oem 1 --psm 6 -l "${OCR_LANGS:-eng}" --dpi 300 \
  -c preserve_interword_spaces=1 2>/dev/null)" || {
  notify "tesseract failed" 3000
  exit 1
}

if [[ -z ${text//[[:space:]]/} ]]; then
  notify "No text recognized"
  exit 0
fi

printf '%s' "$text" | wl-copy

if ((speak_mode)); then
  # Drop the freeze before speaking — otherwise the frozen overlay would sit
  # over the screen for the whole read, since the EXIT trap only fires at exit.
  [[ -n $freeze_pid ]] && kill "$freeze_pid" 2>/dev/null
  freeze_pid=""
  speak "$text"
  notify "Reading aloud — press the stop bind to cancel"
else
  notify "Copied text to clipboard"
fi
