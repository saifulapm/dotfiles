#!/usr/bin/env python3
# dots-youtube-api: the YouTube App's only network reader. search <query> <type> <offset> prints 20 rows of a YouTube search from offset through yt-dlp; channel <UC-id|@handle> <offset> prints 20 of a channel's uploads; playlist <id|url> prints every item of a playlist; snapshot <id|url> reads every item too, printing {read, count, title, channel} after each 100 rows before its {title, channel, count, rows}; resolve <url> says whether a pasted URL is a video (with its row), a playlist, a channel or none; thumbs <id>... fetches mqdefault thumbnails into a cache capped at 200 MiB. Each call but snapshot prints one compact JSON object; a failed read prints {error, kind, raw} and exits 1.
import ctypes
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request

FILTERS = {"videos": "EgIQAQ%3D%3D", "playlists": "EgIQAw%3D%3D", "channels": "EgIQAg%3D%3D"}
PAGE = 20
# YouTube's videos filter still lists a channel's card now and then (2 of 20 for nujabes, 2026-10-31), so a page asks past itself to fill 20.
SPARE = 10
CAP = 200 * 1024 * 1024
ID = re.compile(r"^[A-Za-z0-9_-]{11}$")
COUNT = re.compile(r"^(\d[\d,]*) videos?$")
NETWORK = re.compile(r"name resolution|connection refused|connection reset|network is unreachable|timed out|urlopen error", re.I)

# The running yt-dlp, which a SIGTERM or SIGHUP takes down with this process.
child = None


def usage():
    print("dots-youtube-api: usage: search <query> videos|playlists|channels <offset> | channel <UC-id|@handle> <offset> | playlist <id|url> | snapshot <id|url> | resolve <url> | thumbs <id>...", file=sys.stderr)
    sys.exit(2)


def out(obj):
    print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")), flush=True)


def fail(error, kind, raw=""):
    out({"error": error, "kind": kind, "raw": raw})
    sys.exit(1)


# The deno mise names, if it runs and is 2.3 or newer; yt-dlp needs it to solve YouTube's player JS.
def deno():
    try:
        path = subprocess.run(["mise", "which", "deno"], capture_output=True, text=True, timeout=10)
        if path.returncode != 0 or not path.stdout.strip():
            return None
        found = path.stdout.strip()
        version = subprocess.run([found, "--version"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.match(r"deno (\d+)\.(\d+)", version.stdout)
    if version.returncode != 0 or not m or (int(m[1]), int(m[2])) < (2, 3):
        return None
    return found


# Runs as the child between fork and exec: the kernel kills it when this process dies, even by SIGKILL, which no handler sees.
def die_with_parent():
    ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGKILL)  # PR_SET_PDEATHSIG


def stop(signum, _frame):
    if child is not None:
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    sys.exit(128 + signum)


# Starts yt-dlp with the deno mise names, in cwd when given, its stdout a pipe and its stderr where asked.
def start(args, cwd=None, stderr=subprocess.PIPE):
    global child
    if shutil.which("yt-dlp") is None:
        fail("yt-dlp is missing: run dots update", "runtime")
    runtime = deno()
    if runtime is None:
        fail("yt-dlp needs deno 2.3 or newer: run dots update", "runtime")
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    # A group of its own, so stop() also reaches whatever yt-dlp starts.
    child = subprocess.Popen(
        ["yt-dlp", *args[:-1], "--js-runtimes", "deno:" + runtime, args[-1]],
        stdout=subprocess.PIPE, stderr=stderr, text=True, cwd=cwd, process_group=0, preexec_fn=die_with_parent,
    )
    return child


# Runs yt-dlp and answers its JSON object (None when it failed or printed none) and its stderr.
def ytdlp(args, cwd=None):
    stdout, stderr = start(args, cwd).communicate()
    try:
        data = json.loads(stdout)
    except ValueError:
        data = None
    if child.returncode != 0 or not isinstance(data, dict):
        data = None
    return data, stderr


# Fails with what yt-dlp's stderr says went wrong; when YouTube gave its own reason (a missing playlist), its sentence is the error.
def broke(stderr):
    raw = next((line.rstrip() for line in reversed(stderr.splitlines()) if line.startswith("ERROR:")), "")
    if "YouTube said: " in raw:
        fail(raw.split("YouTube said: ", 1)[1], "extraction", raw)
    # A mistyped handle or a truncated list id: YouTube answers 404 or 400, which no newer yt-dlp mends.
    if re.search(r"HTTP Error (400|404)\b", raw):
        fail("YouTube has no such channel or playlist", "extraction", raw)
    if NETWORK.search(stderr):
        fail("No network. Check Wi-Fi, then ↵ to try again.", "network", raw)
    version = subprocess.run(["yt-dlp", "--version"], capture_output=True, text=True).stdout.strip()
    fail("yt-dlp %s may be behind YouTube: run dots bump, then dots update" % version, "extraction", raw)


# The first i.ytimg.com video id among an entry's thumbnails.
def thumb_of(e, fallback):
    return next((m[1] for t in e.get("thumbnails") or [] if (m := re.search(r"/vi/([A-Za-z0-9_-]{11})/", t.get("url", "")))), fallback)


# A video row; a video with no ytimg thumbnail falls back to its own id. A playlist's private or deleted video is a flat entry with no title and no duration, and only "private" in availability tells the two apart.
def video_row(e, channel=None):
    row = {"id": e["id"], "kind": "video", "title": e.get("title"), "channel": e.get("channel") or e.get("uploader") or channel, "duration": e.get("duration"), "thumb": thumb_of(e, e["id"])}
    if not e.get("title") and e.get("duration") is None:
        row["unavailable"] = "made private" if e.get("availability") == "private" else "made private or deleted"
    return row


# The results page is HTML holding ytInitialData; the pages after it are JSON.
def page_data(text):
    try:
        return json.loads(text)
    except ValueError:
        m = re.search(r"var ytInitialData\s*=\s*(\{.*?\});\s*</script>", text, re.S)
        return json.loads(m[1]) if m else None


def strings(o, found):
    if isinstance(o, str):
        found.append(o)
    elif isinstance(o, dict):
        for x in o.values():
            strings(x, found)
    elif isinstance(o, list):
        for x in o:
            strings(x, found)


# Maps each lockup's contentId to the "14 videos" somewhere under it, or None.
def lockups(o, counts):
    if isinstance(o, dict):
        v = o.get("lockupViewModel")
        if isinstance(v, dict) and v.get("contentId"):
            texts = []
            strings(v, texts)
            counts.setdefault(v["contentId"], next((int(m[1].replace(",", "")) for t in texts if (m := COUNT.match(t))), None))
        for x in o.values():
            lockups(x, counts)
    elif isinstance(o, list):
        for x in o:
            lockups(x, counts)


# No flat search entry carries a playlist's count (playlist_count is always null), so it comes from the pages yt-dlp wrote; a page that no longer parses names no count and never fails the search.
def page_counts(folder):
    counts = {}
    for name in sorted(os.listdir(folder)):
        if name.endswith(".dump"):
            try:
                with open(os.path.join(folder, name), encoding="utf-8", errors="replace") as f:
                    lockups(page_data(f.read()), counts)
            except (OSError, ValueError, RecursionError):
                pass
    return counts


def search(query, kind, offset):
    # The filter is already percent-encoded, so only the query is quoted.
    url = "https://www.youtube.com/results?search_query=%s&sp=%s" % (urllib.parse.quote_plus(query), FILTERS[kind])
    args = ["--flat-playlist", "-J", "--playlist-start", str(offset + 1), "--playlist-end", str(offset + PAGE + SPARE), url]
    counts = {}
    if kind == "playlists":
        with tempfile.TemporaryDirectory() as folder:
            data, stderr = ytdlp(["--write-pages", *args], cwd=folder)
            counts = page_counts(folder)
    else:
        data, stderr = ytdlp(args)
    if data is None or not isinstance(data.get("entries"), list):
        broke(stderr)
    rows = []
    kept = set()
    # next is where the following page starts, past the last entry this one kept.
    following = offset
    for at, e in enumerate(data["entries"]):
        if len(rows) == PAGE:
            break
        if not isinstance(e, dict) or e.get("id") in kept:
            continue
        url = str(e.get("url"))
        # Every filter lets channel cards through, and a channel card or a null entry is nothing to play.
        if kind == "videos" and not (e.get("ie_key") in (None, "Youtube") and ID.match(str(e.get("id")))):
            continue
        if kind == "playlists" and "/playlist?list=" not in url or kind == "channels" and "/channel/" not in url:
            continue
        kept.add(e["id"])
        following = offset + at + 1
        if kind == "videos":
            rows.append(video_row(e))
        elif kind == "playlists":
            # A playlist's thumbnail is one of its videos.
            rows.append({"id": e["id"], "kind": "playlist", "title": e.get("title"), "channel": e.get("channel") or e.get("uploader"), "duration": None, "thumb": thumb_of(e, ""), "count": counts.get(e["id"])})
        else:
            rows.append({"id": e["id"], "kind": "channel", "title": e.get("title"), "channel": e.get("uploader_id") or "", "duration": None, "thumb": ""})
    out({"rows": rows, "next": following})


# A channel's uploads, newest first as YouTube lists them; no entry carries a timestamp to sort by, nor a channel, so each takes the top level's.
def channel(who, offset):
    url = "https://www.youtube.com/%s/videos" % (who if who.startswith("@") else "channel/" + who)
    page = ["--flat-playlist", "-J", "--playlist-start", str(offset + 1), "--playlist-end", str(offset + PAGE)]
    data, stderr = ytdlp([*page, url])
    title = data.get("channel") if data else None
    if data is None and "does not have a videos tab" in stderr:
        # A Topic channel or a tiny one has no videos tab; its uploads are the playlist UU and the rest of its id, as yt-dlp's own extractor falls back to, and only when that fails too is there nothing to list.
        if who.startswith("UC"):
            data, stderr = ytdlp([*page, "https://www.youtube.com/playlist?list=UU" + who[2:]])
        if data is None:
            out({"title": None, "rows": [], "next": offset})
            return
        title = re.sub(r"^Uploads from ", "", data.get("title") or "") or data.get("channel")
    if data is None or not isinstance(data.get("entries"), list):
        broke(stderr)
    entries = data["entries"]
    rows = [video_row(e, data.get("channel")) for e in entries if isinstance(e, dict) and ID.match(str(e.get("id")))]
    out({"title": title, "rows": rows, "next": offset + len(entries)})


# Every item of a playlist; YouTube's playlist_count can be missing, and the rows count then.
def playlist(list_id):
    data, stderr = ytdlp(["--flat-playlist", "-J", "https://www.youtube.com/playlist?list=" + list_id])
    if data is None or not isinstance(data.get("entries"), list):
        broke(stderr)
    rows = [video_row(e) for e in data["entries"] if isinstance(e, dict) and ID.match(str(e.get("id")))]
    count = data.get("playlist_count")
    out({"title": data.get("title"), "count": count if isinstance(count, int) else len(rows), "rows": rows})


# Every item of a playlist, read as yt-dlp prints each page of 100, so a long one says how far it has read. Each line carries the playlist's count, title and channel.
def snapshot(list_id):
    # stderr goes to a file, so a yt-dlp warning a pipe left unread never stalls it.
    with tempfile.TemporaryFile("w+", encoding="utf-8", errors="replace") as errors:
        proc = start(["--flat-playlist", "--lazy-playlist", "-j", "https://www.youtube.com/playlist?list=" + list_id], stderr=errors)
        rows = []
        head = {}
        for line in proc.stdout:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if not isinstance(e, dict):
                continue
            head = e
            if not ID.match(str(e.get("id"))):
                continue
            rows.append(video_row(e))
            if len(rows) % 100 == 0:
                count = e.get("playlist_count")
                out({"read": len(rows), "count": count if isinstance(count, int) else None, "title": e.get("playlist_title"), "channel": e.get("playlist_channel") or e.get("playlist_uploader")})
        if proc.wait() != 0:
            errors.seek(0)
            broke(errors.read())
    count = head.get("playlist_count")
    out({"title": head.get("playlist_title"), "channel": head.get("playlist_channel") or head.get("playlist_uploader"), "count": count if isinstance(count, int) else len(rows), "rows": rows})


# A playlist argument is its id, or a URL whose list= names it.
def list_id(arg):
    if "?" in arg:
        arg = (urllib.parse.parse_qs(urllib.parse.urlsplit(arg).query).get("list") or [""])[0]
    return arg if re.fullmatch(r"[A-Za-z0-9_-]+", arg) else None


# What a pasted URL names, read from the URL alone: (kind, id), or ("none", None).
def place(text):
    if not re.match(r"[A-Za-z][A-Za-z0-9+.-]*://", text):
        text = "https://" + text
    try:
        u = urllib.parse.urlsplit(text)
        host = u.hostname or ""
    except ValueError:
        return "none", None
    parts = [p for p in u.path.split("/") if p]
    query = urllib.parse.parse_qs(u.query)
    if host == "youtu.be":
        if parts and ID.match(parts[0]):
            return "video", parts[0]
    elif host in ("youtube.com", "www.youtube.com", "m.youtube.com", "music.youtube.com") and parts:
        v = (query.get("v") or [""])[0]
        if parts == ["watch"] and ID.match(v):
            return "video", v
        if parts[0] in ("shorts", "live", "embed") and len(parts) > 1 and ID.match(parts[1]):
            return "video", parts[1]
        if parts == ["playlist"] and re.fullmatch(r"[A-Za-z0-9_-]+", (query.get("list") or [""])[0]):
            return "playlist", query["list"][0]
        if re.fullmatch(r"@[\w.-]+", parts[0]):
            return "channel", parts[0]
        if parts[0] == "channel" and len(parts) > 1 and re.fullmatch(r"UC[A-Za-z0-9_-]{22}", parts[1]):
            return "channel", parts[1]
    return "none", None


def resolve(text):
    kind, found = place(text)
    if kind == "none":
        out({"kind": "none"})
    elif kind != "video":
        out({"kind": kind, "id": found})
    else:
        # Always the clean watch URL, so a list= never opens the playlist; the DASH and HLS manifests and the player JS are no part of a row.
        data, stderr = ytdlp(["-J", "--no-playlist", "--skip-download", "--extractor-args", "youtube:skip=dash,hls,translated_subs;player_skip=js", "https://www.youtube.com/watch?v=" + found])
        if data is None or not data.get("id"):
            broke(stderr)
        out({"kind": "video", "id": found, "rows": [video_row(data)]})


def thumbs(ids):
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    folder = os.path.abspath(os.path.join(cache, "dots", "youtube", "thumbs"))
    os.makedirs(folder, exist_ok=True)
    template = os.environ.get("DOTS_YOUTUBE_THUMB_URL") or "https://i.ytimg.com/vi/{id}/mqdefault.jpg"
    asked = [i for i in dict.fromkeys(ids) if ID.match(i)]
    for i in asked:
        path = os.path.join(folder, i + ".jpg")
        if os.path.exists(path):
            # A thumbnail in use is new again, so the prune takes the ones not seen for longest.
            os.utime(path)
            continue
        # A temp name, then a rename, so a reader never sees half a file.
        fd, part = tempfile.mkstemp(dir=folder, prefix="." + i, suffix=".part")
        try:
            with os.fdopen(fd, "wb") as f, urllib.request.urlopen(template.replace("{id}", i), timeout=10) as r:
                shutil.copyfileobj(r, f)
            os.replace(part, path)
        except OSError:
            os.unlink(part)
    files = [e for e in os.scandir(folder) if e.is_file()]
    stats = sorted(((e.stat(), e.path) for e in files), key=lambda s: s[0].st_mtime)
    total = sum(s.st_size for s, _ in stats)
    for s, path in stats:
        if total <= CAP:
            break
        os.unlink(path)
        total -= s.st_size
    present = {i: os.path.join(folder, i + ".jpg") for i in asked if os.path.exists(os.path.join(folder, i + ".jpg"))}
    out({"dir": folder, "files": present})


def main(args):
    if len(args) == 4 and args[0] == "search" and args[2] in FILTERS and re.fullmatch(r"[0-9]+", args[3]):
        search(args[1], args[2], int(args[3]))
    elif len(args) == 3 and args[0] == "channel" and re.fullmatch(r"UC[A-Za-z0-9_-]{22}|@[\w.-]+", args[1]) and re.fullmatch(r"[0-9]+", args[2]):
        channel(args[1], int(args[2]))
    elif len(args) == 2 and args[0] == "playlist" and list_id(args[1]):
        playlist(list_id(args[1]))
    elif len(args) == 2 and args[0] == "snapshot" and list_id(args[1]):
        snapshot(list_id(args[1]))
    elif len(args) == 2 and args[0] == "resolve":
        resolve(args[1])
    elif len(args) >= 2 and args[0] == "thumbs":
        thumbs(args[1:])
    else:
        usage()


main(sys.argv[1:])
