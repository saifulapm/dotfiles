#!/usr/bin/env bash
# secrets-restore — phase 2 of a fresh install: everything the PUBLIC dotfiles
# repo deliberately cannot carry.
#
# The restore is two phases on purpose, and the split is the whole design:
#
#   1. `chezmoi apply` from github.com/saifulapm/dotfiles — public, needs no
#      credentials, installs packages and writes every non-secret config.
#   2. reboot into autologin, run `rclone config` for iCloud + Dropbox by hand
#      (Apple 2FA and Dropbox OAuth are browser flows, not scriptable), then
#      run THIS. It pulls the secrets out of iCloud and wires them up —
#      except ~/.ssh, which comes from the Dropbox hub as an encrypted blob
#      that the age key restored from iCloud opens.
#
# Why nothing here lives in the repo, encrypted or otherwise: a public repo's
# ciphertext is permanent — forks, mirrors and git history keep it after any
# deletion — and encrypting it would only move the bootstrap secret from "the
# keys" to "the age key", not remove it. Something must be carried in by hand
# either way, so it may as well be the thing that is already private. iCloud
# is that thing: reaching it needs the Apple ID, which lives in iCloud
# Keychain on the phone and never passes through `pass`, so the chain cannot
# deadlock.
#
# ONE DELIBERATE EXCEPTION, 2026-08-19: home/.chezmoitemplates/
# mail-identities.toml.age, the mail address list. The permanence argument
# above still applies to it in full — that ciphertext is in the public history
# forever, and a future leak of the age key retroactively opens every version
# of it. It is accepted there because the payload is ADDRESSES, NOT
# CREDENTIALS: most are the public-facing business addresses already printed
# on the sites they belong to, and the one that is genuinely half a credential
# (the iCloud IMAP login) is worth less than what the exception buys — a list
# that updates on every machine from one pushed commit instead of a by-hand
# re-init of three. The line holds where it matters: nothing that OPENS an
# account is in the repo. The app-specific password stays in `pass`, the keys
# stay here.
#
# Idempotent: every step detects work already done and skips it, so re-running
# after fixing one failure is safe and cheap.
#
# Deliberately NOT here — all interactive browser/device logins:
#   tailscale up · dropbox · rclone config
set -uo pipefail

ICLOUD="${SECRETS_REMOTE:-iCloud:}"
STORE_URL="git@github.com:saifulapm/password-store.git"
STORE_DIR="$HOME/.password-store"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

problems=()
step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }
ok()   { printf '    \033[32mok\033[0m %s\n' "$1"; }
skip() { printf '    -- %s\n' "$1"; }
bad()  { printf '    \033[31m!!\033[0m %s\n' "$1"; problems+=("$1"); }

# ---------------------------------------------------------------- preflight
# Everything below reads from iCloud, so a missing or expired remote is not a
# per-step failure but a stop condition — without it each step would fail in
# its own confusing way.
step "Preflight"
command -v rclone >/dev/null || { bad "rclone not installed — run 'chezmoi apply' first"; exit 1; }
# `grep -x >/dev/null`, never `grep -qx`: -q exits at the first match, which
# SIGPIPEs rclone mid-write and makes pipefail report 141 for a found remote.
if ! rclone listremotes 2>/dev/null | grep -x "$ICLOUD" >/dev/null; then
  bad "no '$ICLOUD' remote — run 'rclone config' (Apple ID + 2FA) first"
  exit 1
fi
if ! timeout 90 rclone lsf "$ICLOUD" --max-depth 1 >/dev/null 2>&1; then
  bad "'$ICLOUD' unreachable or session expired — 'rclone config reconnect $ICLOUD'"
  exit 1
fi
ok "$ICLOUD reachable"

# A graphical session is a hard requirement for the GPG step, which is why
# this script exists as phase 2 instead of folding into the first
# `chezmoi apply` — that one runs from a TTY. Measured 2026-08-09:
# pinentry-qt with no DISPLAY/WAYLAND_DISPLAY does not degrade, it ABORTS
# (SIGABRT, core dumped), and `gpg --import` of a passphrase-protected key
# with no usable pinentry then exits 0 having imported NOTHING. A silent
# success that leaves you with no key is the worst possible failure here, so
# it is turned into a loud refusal.
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
  bad "no graphical session — pinentry-qt cannot prompt, and the GPG import"
  bad "would silently import nothing. Log in to the desktop, then re-run."
  exit 1
fi
ok "graphical session present (pinentry can prompt)"

# --------------------------------------------------------------- dropbox
# Restores the Dropbox remote so phase 2 needs ONE interactive login (iCloud)
# rather than two. Safe to carry and durable: the [Dropbox] section holds an
# OAuth refresh_token and nothing else — no password — and rclone renews the
# access token itself, so a backup taken once does not go stale.
#
# ONLY this section is backed up, never the whole rclone.conf. The [iCloud]
# section stores the Apple ID password under rclone's "obscure", which is
# reversible — `rclone reveal` prints it in clear — so that file is exactly as
# sensitive as the Apple ID itself. It is also the bootstrap credential, so it
# has to be typed by hand regardless.
step "Dropbox remote"
rcconf="$(rclone config file 2>/dev/null | tail -1)"
if [ -z "$rcconf" ]; then
  bad "cannot locate rclone.conf"
elif grep -q '^\[Dropbox\]' "$rcconf" 2>/dev/null; then
  skip "[Dropbox] already configured"
elif timeout 120 rclone copy "${ICLOUD}rclone/dropbox.conf" "$TMP/" 2>/dev/null \
     && [ -f "$TMP/dropbox.conf" ]; then
  # Force a separating newline first: rclone.conf need not end with one, and a
  # "[Dropbox]" glued onto the previous line corrupts the section silently.
  if [ -s "$rcconf" ] && [ "$(tail -c1 "$rcconf" | wc -l)" -eq 0 ]; then printf '\n' >>"$rcconf"; fi
  cat "$TMP/dropbox.conf" >>"$rcconf"
  chmod 600 "$rcconf"
  if rclone listremotes 2>/dev/null | grep -x 'Dropbox:' >/dev/null; then
    ok "restored — no OAuth browser flow needed"
  else
    bad "appended but rclone still does not list Dropbox:"
  fi
else
  bad "could not fetch ${ICLOUD}rclone/dropbox.conf"
fi

# --------------------------------------------------------- chezmoi age key
# BEFORE the ssh step, not after it: ~/.ssh now arrives as an age-encrypted
# blob and this key is what opens it.
#
# It comes from iCloud on purpose, and that is the whole security argument.
# The blob lives in Dropbox; putting its key in the same account would mean
# one compromised account yields both halves, and encrypting the blob would
# stop buying anything. Two providers means an attacker needs two accounts.
# iCloud is also the credential typed by hand in phase 2, so the chain cannot
# deadlock on itself.
step "chezmoi age key"
mkdir -p "$HOME/.config/chezmoi"
if [ -f "$HOME/.config/chezmoi/key.txt" ]; then
  skip "key.txt already present"
elif timeout 120 rclone copy "${ICLOUD}chezmoi/key.txt" "$HOME/.config/chezmoi/" 2>/dev/null \
     && [ -f "$HOME/.config/chezmoi/key.txt" ]; then
  chmod 600 "$HOME/.config/chezmoi/key.txt"; ok "restored"
else
  bad "could not fetch ${ICLOUD}chezmoi/key.txt — the SSH step below needs it"
fi

# ------------------------------------------------------------- mail configs
# The four mail configs are templates over an age-encrypted address list
# (home/.chezmoitemplates/mail-identities.toml.age), and they are wrapped in a
# guard that renders NOTHING when the key is missing — so phase 1's apply,
# which runs before the key exists, deliberately produced none of them. This
# is the moment they become renderable, so render them here rather than leave
# a fresh machine with mail silently off until the next apply. Every mail unit
# is ConditionPathExists-gated on exactly these paths, so writing them is what
# switches mail on.
#
# Targeted rather than a bare `chezmoi apply`: this script's job is secrets,
# and a full apply here would re-run every run_after script as a side effect
# of restoring a key.
step "mail configs"
if [ -f "$HOME/.config/chezmoi/key.txt" ]; then
  if chezmoi apply "$HOME/.mbsyncrc" "$HOME/.msmtprc" \
                   "$HOME/.config/notmuch/default/config" \
                   "$HOME/.config/imapnotify/icloud.yaml" 2>/dev/null; then
    ok "rendered from the encrypted identity list"
  else
    bad "chezmoi apply failed for the mail configs"
  fi
else
  skip "no age key — mail configs stay unrendered (mail units are gated on them)"
fi

# ------------------------------------------------------------------- ssh
# From the Dropbox HUB, not from iCloud (changed 2026-08-17). ~/.ssh is a
# qshell-sync unit now: one age-encrypted blob carrying the same key set to
# every machine, authorized_keys among them, so the boxes can reach each other.
#
# iCloud still holds the OLD plaintext copy from the pre-hub procedure. It
# predates authorized_keys and the Host blocks, so restoring from it here
# would hand a fresh machine a ~/.ssh that DISAGREES with the hub — which is
# exactly the two-sided divergence the ssh unit is built to refuse to merge,
# and every fresh install would land in a conflict it did nothing to earn.
# One source of truth. That iCloud copy stays only as a cold, possibly stale
# last resort for the disaster where Dropbox itself is gone, and nothing reads
# it automatically any more.
#
# Runs after the age key above, which decrypts the blob, and before the
# password-store clone below, which authenticates with the keys it restores.
step "SSH keys"
ssh_sync="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ssh-hub-sync"
if [ ! -x "$ssh_sync" ]; then
  bad "$ssh_sync missing — cannot restore ~/.ssh"
else
  ssh_out="$("$ssh_sync" 2>&1)"; ssh_rc=$?
  case $ssh_rc in
  0) ok "$ssh_out" ;;
  2) skip "$ssh_out" ;;
  3) bad "this machine and the hub disagree: $ssh_out"
     bad "  pick a side in the sync panel, or: ssh-hub-sync --adopt-remote" ;;
  *) bad "ssh-hub-sync: $ssh_out"
     bad "  cold fallback (plaintext, pre-hub, may be stale):"
     bad "    rclone copy ${ICLOUD}.ssh/ \$HOME/.ssh/" ;;
  esac
fi
# Always reassert permissions: rclone writes with the default umask, and ssh
# silently refuses any private key it considers group- or world-readable.
if [ -d "$HOME/.ssh" ]; then
  chmod 700 "$HOME/.ssh"
  find "$HOME/.ssh" -type f ! -name '*.pub' ! -name 'known_hosts*' -exec chmod 600 {} +
  find "$HOME/.ssh" -type f -name '*.pub' -exec chmod 644 {} +
  ok "permissions asserted (700 dir, 600 keys, 644 public)"
fi

# ------------------------------------------------------------------- gpg
# The key behind `pass`. Import is interactive — gpg asks for the passphrase
# through pinentry-qt (configured by chezmoi in ~/.gnupg/gpg-agent.conf).
step "GPG key (pass)"
# Warm the agent before ANY secret-key query. `gpg --list-secret-keys` asks
# gpg-agent which secrets exist, and in a fresh GNUPGHOME the first call can
# return nothing while the agent is still starting — a race that made an
# earlier count-based check report success when the import had actually failed
# (found 2026-08-09 testing against a scratch HOME).
gpg-connect-agent /bye >/dev/null 2>&1 || true
if [ "$(gpg --list-secret-keys --with-colons 2>/dev/null | grep -c '^sec' || true)" -gt 0 ]; then
  skip "a secret key is already present"
else
  if timeout 300 rclone copy "${ICLOUD}GPG-Backup/" "$TMP/" 2>/dev/null; then
    key="$(find "$TMP" -name 'gpg-secret-*.asc' | head -1)"
    if [ -z "$key" ]; then
      bad "no gpg-secret-*.asc in ${ICLOUD}GPG-Backup/"
    else
      # Read the fingerprint WITHOUT importing, so ownertrust can be set for
      # exactly this key rather than a hardcoded value that a future key
      # rotation would silently invalidate.
      fpr="$(gpg --with-colons --import-options show-only --import "$key" 2>/dev/null \
             | awk -F: '/^fpr/{print $10; exit}')"
      # Verify that THIS fingerprint now has secret material — not the exit
      # status, and not a before/after count. Both of those lie here:
      #   * `gpg --import` returns 0 even when it imported nothing. Without a
      #     usable pinentry it fails with "error sending to agent:
      #     Inappropriate ioctl for device", imports the PUBLIC key only, and
      #     still exits 0.
      #   * a count can be satisfied by some other key in the ring, and races
      #     agent startup besides.
      # Measured 2026-08-09; the count version reported success on an import
      # that had silently produced a public key and nothing else.
      gpg --import "$key" 2>&1 | sed 's/^/    /' | tail -3
      if gpg --list-secret-keys "$fpr" >/dev/null 2>&1; then
        ok "imported $fpr (secret material confirmed)"
      else
        bad "no secret key for $fpr — public key only."
        bad "  wrong passphrase, or pinentry could not prompt."
      fi
      # NOT optional. An imported secret key lands at ownertrust '-', and every
      # encryption then fails with "Unusable public key" — `pass insert` dies
      # with no explanation. Verified experimentally 2026-08-09.
      if [ -n "$fpr" ] && echo "$fpr:6:" | gpg --import-ownertrust >/dev/null 2>&1; then
        ok "ownertrust set to ultimate"
      else
        bad "could not set ownertrust — 'pass insert' will fail until fixed"
      fi
    fi
  else
    bad "could not copy ${ICLOUD}GPG-Backup/"
  fi
fi

# ------------------------------------------------------- password store
step "Password store"
if [ -d "$STORE_DIR/.git" ]; then
  skip "$STORE_DIR already cloned"
elif git clone --quiet "$STORE_URL" "$STORE_DIR" 2>/dev/null; then
  ok "cloned $STORE_URL"
else
  bad "clone failed — needs the SSH key above registered with GitHub"
fi

# ------------------------------------------------------------------ gh auth
# After the store clone above, which is where the token comes from.
#
# NOT `gh auth login`'s OAuth flow, which is what this replaces. That flow
# authorizes ONE OAuth App — the CLI's own — and with three machines a fresh
# authorization on the second box leaves the first holding a token GitHub
# answers `401 Bad credentials` to. Nothing announces it: the token has no
# expiry (GitHub sends no token-expiration header for a gho_), so it looks
# valid right up until it is refused. bin/update-all baked such a 401 body
# into its release-tag state and re-downloaded nine current binaries over it
# (found and fixed 2026-08-21; its release checks now fall back to
# unauthenticated curl, so a dead token cannot fail an update run).
#
# A classic PAT with NO expiration removes the mechanism rather than the
# symptom: one credential per account, installed identically on every machine,
# and nothing ever re-runs a device flow that could invalidate its siblings.
# Every scope is ticked deliberately (user ask 2026-08-21) so gh never stops
# mid-command for a permission it was not given — which makes a lost machine
# a REVOKE-NOW event, for BOTH tokens: regenerate at github.com/settings/
# tokens, then `pass edit <entry>`, `pass git push`, and re-run this on the
# others. delete_repo and admin:org are in that set.
#
# TWO ACCOUNTS since 2026-09-09 — saifulapm (personal) and lareysbd
# (commercial) — and everything below is per account, because a bare
# `gh auth status` exits 1 when EITHER is unhealthy. Treated as one answer it
# would report the good personal token as broken the moment the commercial one
# lapsed, then reinstall the personal one and leave the dead token dead.
#
# In hosts.yml rather than GH_TOKEN in the environment, on purpose: a systemd
# timer gets no unlocked gpg-agent, so an env var sourced from `pass` would
# be empty in exactly the unattended context that needs it most. gh reads
# hosts.yml with no agent at all.
#
# account:pass-entry. saifulapm keeps the unsuffixed entry it has always had;
# renaming it for symmetry would mean a store edit on three machines to buy
# nothing.
gh_accounts="saifulapm:github/cli-token lareysbd:github/cli-token-lareysbd"

# One row per account: login, live state, and whether it is the active one.
# `state` is the result of a real API call, so a token that EXISTS but has
# been revoked reports failure here — that is the property worth having, since
# re-running this script is then the fix for a dead token and not just for a
# missing one. `--json` also makes gh exit 0 whatever it finds, so a broken
# account arrives as data instead of as an error to interpret.
gh_states() {
  gh auth status --json hosts \
     --jq '.hosts["github.com"][]? | "\(.login):\(.state):\(.active)"' \
     2>/dev/null | tr '\n' ' '
}

# Scope + expiry audit for ONE account. Informational and never fatal: GitHub
# adds and renames scopes on its own schedule, and a list that has drifted is
# not a reason to fail a machine restore. It is here because "all permissions"
# is the whole point of these tokens, and the alternative to naming a gap now
# is discovering it halfway through some future gh command.
#
# The token is read explicitly rather than switched to: `gh auth switch`
# mutates hosts.yml, and a restore script has no business leaving the active
# account wherever its last loop iteration happened to stop. Headers are
# fetched once and both answers read out of them — the old code called
# `gh api user -i` twice, which at two accounts would be four round trips for
# data that arrives in one.
gh_audit() {
  local user="$1" entry="$2" tok hdrs granted missing s exp
  tok="$(gh auth token --hostname github.com --user "$user" 2>/dev/null)"
  [ -n "$tok" ] || return 0
  hdrs="$(GH_TOKEN="$tok" gh api user -i 2>/dev/null)"

  granted="$(awk -F': ' 'tolower($1)=="x-oauth-scopes"{print $2}' <<<"$hdrs" | tr -d '\r,')"
  missing=""
  for s in admin:enterprise admin:gpg_key admin:org admin:org_hook \
           admin:public_key admin:repo_hook admin:ssh_signing_key audit_log \
           codespace copilot delete:packages delete_repo gist notifications \
           project repo user workflow write:discussion write:packages; do
    case " $granted " in *" $s "*) ;; *) missing="$missing $s" ;; esac
  done
  if [ -n "$missing" ]; then
    skip "$user scopes NOT granted:$missing"
    skip "  tick them at https://github.com/settings/tokens (edit the token)"
  else
    ok "$user — every classic scope granted"
  fi

  # The expiry check matters more than the scope one, and is easier to get
  # wrong: GitHub's "Expiration" dropdown DEFAULTS to 30 days, so a token
  # created in a hurry is a 30-day token that behaves perfectly until the
  # morning it does not. Caught exactly that way 2026-08-21, on the first PAT
  # issued for this. GitHub sends the header only when an expiry exists, so
  # absence is the good case.
  exp="$(awk -F': ' 'tolower($1)=="github-authentication-token-expiration"{print $2}' <<<"$hdrs" | tr -d '\r')"
  if [ -n "$exp" ]; then
    bad "$user token EXPIRES $exp — the point of this PAT is that it does not."
    bad "  github.com/settings/tokens → the token → Regenerate token →"
    bad "  'No expiration', then: pass edit $entry && pass git push"
  else
    ok "$user — no expiry, this token does not go stale on a clock"
  fi
}

step "gh auth"
if ! command -v gh >/dev/null 2>&1; then
  bad "gh not installed — run 'chezmoi apply' first"
else
  gh_seen="$(gh_states)"

  # Whichever account was active before this script touched anything. Restored
  # at the end rather than forced to saifulapm: a restore run must not silently
  # repoint a session the user had deliberately switched.
  gh_active_before=""
  for gh_row in $gh_seen; do
    case "$gh_row" in *:true) gh_active_before="${gh_row%%:*}" ;; esac
  done

  gh_installed=0
  for gh_pair in $gh_accounts; do
    gh_user="${gh_pair%%:*}"
    gh_entry="${gh_pair#*:}"
    case " $gh_seen " in
    *" $gh_user:success:"*)
      skip "$gh_user already authenticated"
      continue
      ;;
    esac
    # sed -n 1p, never head -1: head closes the pipe after the first line and
    # SIGPIPEs pass, which pipefail then reports as failure for a token that
    # was read perfectly well — the same trap as the `grep -qx` note above.
    ghtoken="$(pass show "$gh_entry" 2>/dev/null | sed -n '1p')"
    if [ -z "$ghtoken" ]; then
      bad "no '$gh_entry' in pass. Create a classic PAT signed in AS $gh_user —"
      bad "  NO expiration, every scope ticked — at github.com/settings/tokens/new"
      bad "  then: pass insert -m $gh_entry && pass git push"
    elif printf '%s\n' "$ghtoken" | gh auth login --with-token 2>/dev/null; then
      gh_installed=1
      # Names the ENTRY, not the account: which account this token actually
      # belongs to is not known until the check below re-reads hosts.yml, and
      # claiming it here is exactly the wrong-entry mistake that check exists
      # to catch.
      ok "installed the token from $gh_entry"
    else
      bad "gh rejected 'pass $gh_entry' — revoked, or not a token"
    fi
    unset ghtoken
  done

  # Re-read, and check each account by NAME. This catches the one thing the
  # login itself cannot: a token pasted into the wrong pass entry
  # authenticates perfectly well and puts the WRONG account into hosts.yml,
  # which then reads as a working two-account setup right up until a
  # commercial push is refused.
  [ "$gh_installed" = 1 ] && gh_seen="$(gh_states)"
  for gh_pair in $gh_accounts; do
    gh_user="${gh_pair%%:*}"
    gh_entry="${gh_pair#*:}"
    case " $gh_seen " in
    *" $gh_user:success:"*) gh_audit "$gh_user" "$gh_entry" ;;
    *) bad "$gh_user is still not authenticated — see above" ;;
    esac
  done

  # `gh auth login --with-token` makes the account it just installed ACTIVE, so
  # after a two-account install the pointer sits wherever the loop ended —
  # lareysbd, by list order. Left there, every later bare `gh` command would
  # target the commercial account and 404 on the next private personal repo.
  if [ "$gh_installed" = 1 ]; then
    gh_want="${gh_active_before:-saifulapm}"
    gh_active_now="$(gh auth status --json hosts \
                     --jq '.hosts["github.com"][]? | select(.active) | .login' 2>/dev/null)"
    if [ -n "$gh_active_now" ] && [ "$gh_active_now" != "$gh_want" ]; then
      if gh auth switch --hostname github.com --user "$gh_want" >/dev/null 2>&1; then
        ok "active account is $gh_want (\`gh lareys\` switches, \`gh personal\` switches back)"
      else
        bad "could not make $gh_want the active account — run: gh auth switch --user $gh_want"
      fi
    fi
  fi
fi

# ------------------------------------------------------------ intelephense
step "intelephense licence"
lic="$HOME/intelephense/licence.txt"
if [ -s "$lic" ]; then
  skip "already present"
elif timeout 120 rclone copy "${ICLOUD}.dotfiles/config/zed/settings.json" "$TMP/" 2>/dev/null \
     && [ -f "$TMP/settings.json" ]; then
  k="$(grep -oE '"licen[cs]eKey"[[:space:]]*:[[:space:]]*"[^"]+"' "$TMP/settings.json" \
       | head -1 | sed 's/.*"\([^"]*\)"$/\1/')"
  if [ -n "$k" ]; then
    mkdir -p "$HOME/intelephense" && printf '%s' "$k" >"$lic" && chmod 600 "$lic"
    ok "written to $lic"
  else
    bad "no licence key found in that settings.json"
  fi
else
  bad "could not read the zed settings.json holding the licence"
fi

# ---------------------------------------------------------------- summary
step "Summary"
if [ ${#problems[@]} -eq 0 ]; then
  printf '    \033[32mall steps completed\033[0m\n'
else
  printf '    \033[31m%d step(s) need attention:\033[0m\n' "${#problems[@]}"
  printf '      - %s\n' "${problems[@]}"
fi
cat <<'EOF'

    Still manual (interactive, deliberately not scripted):
      tailscale up   — one browser click. NOT automated on purpose: auth keys
                       cap at 90 days, so a stored one is stale exactly when a
                       reinstall needs it; OAuth clients need device tags and
                       target servers, not laptops.
      Browserpass    — Chrome Web Store, then restart Chromium

    Verify pass end to end (exercises key, trust, agent and store together):
      pass show github/cli-token >/dev/null && echo 'pass ok'

    The redirect is not decoration: that entry is a full-scope GitHub token,
    and a verification step has no business printing it. Decrypting it is
    what exercises the chain; reading it is not.
EOF
[ ${#problems[@]} -eq 0 ]
