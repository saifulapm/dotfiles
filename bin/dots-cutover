#!/usr/bin/env bash
# dots cutover: the one-off switch from v1, safe to run again; stops the v1 units v2 replaces, removes the v1 links that outrank or shadow v2's, imports v1's notes, goals and fish history, and leaves ~/.dotfiles in place.
set -uo pipefail
{
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
v1=$HOME/.dotfiles
config=${XDG_CONFIG_HOME:-$HOME/.config}
data=${XDG_DATA_HOME:-$HOME/.local/share}
fish=$data/fish
units=$config/systemd/user
# v2 takes over hub-local, pxy, bt-agent, dufs and libinput-gestures under the same names, homepod-sink as dots-homepod, clipboard-sync and clipboard-serve as dots-clip-sync and dots-clip-serve on the same port, and havit-guard with WirePlumber's HFP retry, since cycling the link under music is what that retry avoids; every other v1 unit (mempressure...) has no v2 replacement and keeps running from ~/.dotfiles.
replaced=(qshell.service qshell-dshift.service qshell-sync.service qshell-sync.timer qshell-sync-notes.path qshell-sync-notes.service
  qshell-sync-goals.path qshell-sync-goals.service qshell-updates.service qshell-updates.timer update-all.service update-all.timer vicinae.service taildrop-receive.service homepod-sink.service havit-guard.service
  clipboard-sync.service clipboard-serve.socket)

# v1 has stopped writing by the time its data is read.
stopped=0
for unit in "${replaced[@]}"; do
  # A static unit answers is-enabled with 0 too, so only the word enabled counts; a v1 sync caught mid-run is activating, which is-active --quiet calls stopped.
  state=$(systemctl --user is-active "$unit" 2>/dev/null)
  [[ $(systemctl --user is-enabled "$unit" 2>/dev/null) == enabled || ! $state =~ ^(inactive|failed|unknown|)$ ]] || continue
  systemctl --user disable --now "$unit" >/dev/null 2>&1 || { echo "dots: could not stop $unit" >&2; exit 1; }
  ((stopped++))
done

v1_link() { [[ -L $1 && $(readlink -f "$1") == "$(readlink -f "$v1")"/* ]]; }

# v1's instance file outranks v2's imapnotify@ template, so v1's mail watcher only stops here: disabling it would drop the wants link v2's instance of the same name starts from at the next login.
if v1_link "$units/imapnotify@icloud.service"; then
  systemctl --user stop imapnotify@icloud.service >/dev/null 2>&1 || { echo "dots: could not stop imapnotify@icloud.service" >&2; exit 1; }
  ((stopped++))
fi

# ~/.gitconfig outranks v2's ~/.config/git/config; v1's fish files shadow v2's, and 10-history.fish points fish at <machine>_history instead of the merged fish_history; v1's desktop entries mostly run commands v2 does not ship; the units stopped above have no use left.
links=("$HOME/.gitconfig" "$units/imapnotify@icloud.service")
for unit in "${replaced[@]}"; do links+=("$units/$unit"); done
while IFS= read -r -d '' link; do links+=("$link"); done < <(find "$config/fish" "$data/applications" -type l -print0 2>/dev/null)
# A unit v2 took over keeps v1's wants link, which names v1's file and starts it at the next login.
for link in "$units"/*.wants/*; do
  [[ -e $units/${link##*/} ]] && ! v1_link "$units/${link##*/}" && links+=("$link")
done
reload=0
for link in "${links[@]}"; do
  v1_link "$link" || continue
  rm "$link"
  [[ $link == "$units"/* ]] && ((reload++))
done
((reload)) && { systemctl --user daemon-reload || { echo "dots: systemctl --user daemon-reload failed" >&2; exit 1; }; }

machine=$("$here/dots-sync-merge" machine)
counts=$("$here/dots-cutover-import" "${XDG_STATE_HOME:-$HOME/.local/state}/qshell" "${XDG_DATA_HOME:-$HOME/.local/share}/dots" "$machine") || exit 1

# v1 named fish's history after its machine slug, as its 10-history.fish did.
slug=$(cat "$config/qshell/machine" 2>/dev/null || uname -n)
old=$fish/${slug//[^a-zA-Z0-9_]/_}_history
entries() { grep -c '^- cmd: ' "$fish/fish_history" 2>/dev/null; }
before=$(entries)
if [[ -f $old ]]; then
  "$here/dots-sync-fish" "$fish/fish_history" "$old" || exit 1
fi
after=$(entries)

echo "$counts · history: $((${after:-0} - ${before:-0})) merged · v1 units: $stopped stopped"
exit
}
