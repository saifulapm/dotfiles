#!/usr/bin/env bash
# just dev's dots-youtube-api: answers search, channel, playlist, snapshot, resolve and thumbs from the canned JSON and thumbnails in dev/youtube, so a nested check never reaches YouTube, and logs each call to DOTS_DEV_DIR/youtube.log.
set -euo pipefail
{
[ -n "${DOTS_DEV_DIR:-}" ] || { echo "dev-fake-youtube: run it from a sourced just dev env" >&2; exit 1; }
fixtures=$(dirname "$(realpath "$0")")/../dev/youtube
fixtures=$(realpath "$fixtures")
echo "$*" >>"$DOTS_DEV_DIR/youtube.log"

# With DOTS_DEV_DIR/youtube-fail naming runtime, extraction or network, every verb but thumbs fails that way until the file goes, as the real CLI does with no deno, a stale yt-dlp or no network.
fail_if_asked() {
  local fail=$DOTS_DEV_DIR/youtube-fail
  if [ -f "$fail" ]; then
    jq -c . "$fixtures/fail-$(tr -d '[:space:]' <"$fail").json"
    exit 1
  fi
}

# The playlist an id or URL names, as {title, count, rows}, or nothing for one the fixtures lack. PLfakeList5000's 5000 rows are built here rather than kept in the JSON; with DOTS_DEV_DIR/youtube-grow, every playlist has one more item than when it was saved.
items() {
  local data
  if [ "$1" = PLfakeList5000 ]; then
    data=$(jq -nc '{title: "Five thousand", count: 5000, rows: [range(1; 5001) | ("fakeBig" + ("000" + tostring)[-4:]) as $id | {id: $id, kind: "video", title: "Big \(.)", channel: "lofi archive", duration: 61, thumb: $id}]}')
  else
    data=$(jq -c --arg id "$1" '.[$id] // empty' "$fixtures/playlist-items.json")
  fi
  if [ -n "$data" ] && [ -f "$DOTS_DEV_DIR/youtube-grow" ]; then
    data=$(jq -c '.rows += [{id: "fakeGrow001", kind: "video", title: "Grown", channel: "lofi archive", duration: 60, thumb: ""}] | .count += 1' <<<"$data")
  fi
  printf '%s' "$data"
}

no_playlist() {
  jq -nc --arg id "$1" '{error: "The playlist does not exist.", kind: "extraction", raw: "ERROR: [youtube:tab] \($id): YouTube said: The playlist does not exist."}'
  exit 1
}

case "${1:-}" in
search)
  [ $# = 4 ] || { echo "dev-fake-youtube: usage: search <query> <type> <offset>" >&2; exit 2; }
  fail_if_asked
  case $3 in
  videos) file=search ;;
  playlists | channels) file=$3 ;;
  *) echo "dev-fake-youtube: unknown search type: $3" >&2; exit 2 ;;
  esac
  jq -c --argjson at "$4" '(.rows | length) as $n | .rows |= .[$at:$at + 20] | .next = ([$at + 20, $n] | min)' "$fixtures/$file.json"
  ;;
channel)
  [ $# = 3 ] || { echo "dev-fake-youtube: usage: channel <UC-id|@handle> <offset>" >&2; exit 2; }
  fail_if_asked
  id=$2
  [ "$id" != @nujabes ] || id=UCfakeChan00000000000001
  # A channel with no uploads at all, and one the fixtures lack, answer an empty page that stays at its offset.
  jq -c -n --arg id "$id" --argjson at "$3" --slurpfile all "$fixtures/uploads.json" '
    ($all[0][$id] // {title: null, rows: []}) as $c
    | $c | (.rows | length) as $n
    | .next = (if $n == 0 then $at else ([$at + 20, $n] | min) end)
    | .rows |= .[$at:$at + 20]'
  ;;
playlist)
  [ $# = 2 ] || { echo "dev-fake-youtube: usage: playlist <id|url>" >&2; exit 2; }
  fail_if_asked
  id=$2
  [[ $id =~ list=([A-Za-z0-9_-]+) ]] && id=${BASH_REMATCH[1]}
  data=$(items "$id")
  [ -n "$data" ] || no_playlist "$id"
  printf '%s\n' "$data"
  ;;
snapshot)
  [ $# = 2 ] || { echo "dev-fake-youtube: usage: snapshot <id|url>" >&2; exit 2; }
  fail_if_asked
  id=$2
  [[ $id =~ list=([A-Za-z0-9_-]+) ]] && id=${BASH_REMATCH[1]}
  data=$(items "$id")
  [ -n "$data" ] || no_playlist "$id"
  # The playlist's channel is the one its search row names, as yt-dlp's playlist_channel would.
  channel=$(jq -c --arg id "$id" '(.rows | map(select(.id == $id))[0].channel) // null' "$fixtures/playlists.json")
  # yt-dlp takes 0.4 s or more per page of 100; the 5000-row list pages faster, so a check of its progress stays short.
  pause=0.4
  [ "$id" != PLfakeList5000 ] || pause=0.05
  jq -c --argjson channel "$channel" '(.rows | length) as $n | range(1; ($n + 99) / 100 | floor + 1) as $page | {read: ([$page * 100, $n] | min), count, title, channel: $channel}' <<<"$data" |
    while read -r line; do
      sleep "$pause"
      printf '%s\n' "$line"
    done
  jq -c --argjson channel "$channel" '{title, channel: $channel, count, rows}' <<<"$data"
  ;;
resolve)
  [ $# = 2 ] || { echo "dev-fake-youtube: usage: resolve <url>" >&2; exit 2; }
  fail_if_asked
  url=${2#http://}
  url=${url#https://}
  vid='[A-Za-z0-9_-]{11}'
  video=
  if [[ $url =~ ^(www\.|m\.|music\.)?youtube\.com/watch\?(.*&)?v=($vid)(&|$) ]]; then
    video=${BASH_REMATCH[3]}
  elif [[ $url =~ ^youtu\.be/($vid)([?/&]|$) ]]; then
    video=${BASH_REMATCH[1]}
  fi
  if [ -n "$video" ]; then
    # A pasted id the fixtures lack gets a stand-in row.
    jq -c --arg id "$video" '(.rows | map(select(.id == $id))[0]) // {id: $id, kind: "video", title: "Pasted video", channel: "Pasted", duration: 61, thumb: $id} | {kind: "video", id: $id, rows: [.]}' "$fixtures/search.json"
  elif [[ $url =~ ^(www\.|m\.)?youtube\.com/playlist\?(.*&)?list=([A-Za-z0-9_-]+) ]]; then
    jq -nc --arg id "${BASH_REMATCH[3]}" '{kind: "playlist", id: $id}'
  elif [[ $url =~ ^(www\.|m\.)?youtube\.com/(@[A-Za-z0-9_.-]+)(/|\?|$) ]]; then
    jq -nc --arg id "${BASH_REMATCH[2]}" '{kind: "channel", id: $id}'
  elif [[ $url =~ ^(www\.|m\.)?youtube\.com/channel/(UC[A-Za-z0-9_-]{22})(/|\?|$) ]]; then
    jq -nc --arg id "${BASH_REMATCH[2]}" '{kind: "channel", id: $id}'
  else
    echo '{"kind":"none"}'
  fi
  ;;
thumbs)
  shift
  # fakeVid0008 has no thumbnail, as a failed fetch leaves a row on its placeholder.
  files='{}'
  for id; do
    [[ $id =~ ^[A-Za-z0-9_-]{11}$ && -f $fixtures/thumbs/$id.jpg ]] || continue
    files=$(jq -c --arg id "$id" --arg f "$fixtures/thumbs/$id.jpg" '. + {($id): $f}' <<<"$files")
  done
  jq -nc --arg dir "$fixtures/thumbs" --argjson files "$files" '{dir: $dir, files: $files}'
  ;;
*)
  echo "dev-fake-youtube: unknown verb: $*" >&2
  exit 2
  ;;
esac
exit
}
