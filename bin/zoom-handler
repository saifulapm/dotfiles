#!/usr/bin/env bash
# zoom-handler — open Zoom meeting links in the Zoom web client app window.
#
# Port of omarchy-webapp-handler-zoom (CREDITS.md): registered as the
# x-scheme-handler for zoommtg:// and zoomus:// (webapp-zoom.desktop), so
# "Open in app" links from zoom.us land in the web client instead of
# prompting for a native client that isn't installed. Anything without a
# conference number falls through to the web client home.
set -euo pipefail

url="${1:-}"
web_url="https://app.zoom.us/wc/home"

if [[ $url =~ ^zoom(mtg|us):// ]]; then
  confno=$(sed -n 's/.*[?&]confno=\([^&]*\).*/\1/p' <<<"$url")

  if [[ -n $confno ]]; then
    pwd=$(sed -n 's/.*[?&]pwd=\([^&]*\).*/\1/p' <<<"$url")

    if [[ -n $pwd ]]; then
      web_url="https://app.zoom.us/wc/join/$confno?pwd=$pwd"
    else
      web_url="https://app.zoom.us/wc/join/$confno"
    fi
  fi
fi

exec webapp-launch "$web_url"
