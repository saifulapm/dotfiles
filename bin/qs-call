#!/usr/bin/env bash
# qs-call — `qs ipc call` without the ~45 ms client startup.
#
#   qs-call <target> <function> [args...]
#
# Same arguments, output and exit status as `qs ipc call -- <target>
# <function> [args...]` (the `--` built in, so `show` needs no escaping).
# Port of omarchy c231097d's omarchy-shell socket path: the shell serves
# $XDG_RUNTIME_DIR/qshell-$WAYLAND_DISPLAY.sock (shell.qml, SocketServer)
# and socat starts in ~5 ms. Fields are split by unit separators and the
# request ends with a record separator, so an argument holding either goes
# through qs ipc instead. The shell replies "OK" with the output once the
# call has run, or "SKIP" when it ran nothing (no such target or function,
# the wrong number of arguments), and qs ipc then gives its exact answer — as
# it does when the socket is absent or nothing listens on it. A call that
# may already have run (timeout, reply cut off) is reported, never retried.

socket="${XDG_RUNTIME_DIR:-/run/user/$UID}/qshell-${WAYLAND_DISPLAY:-}.sock"
request="$*"
if [[ -n ${WAYLAND_DISPLAY:-} && -S $socket && $# -ge 2 &&
  $request != *$'\x1e'* && $request != *$'\x1f'* ]]; then
  request=$(IFS=$'\x1f'; printf '%s' "$*")
  # socat waits as long as the shell takes; the timeout alone bounds the
  # call. Its own errors land in the reply too, so a connection it could not
  # make is told apart from one that failed after the request went out.
  reply=$(printf '%s\x1e' "$request" | timeout --kill-after=1s "${QS_CALL_TIMEOUT:-2s}" socat -t 86400 - "UNIX-CONNECT:$socket" 2>&1)

  # An answer counts only once its record separator arrived.
  if [[ $reply == OK$'\x1f'*$'\x1e'* ]]; then
    output=${reply#OK$'\x1f'}
    output=${output%$'\x1e'*}
    # As qs ipc prints a return value: verbatim plus one newline (every
    # first-party verb declares a return type, so none is void).
    printf '%s\n' "$output"
    exit 0
  elif [[ $reply == "SKIP"$'\x1e'* ]]; then
    : # The shell ran nothing; qs ipc gives its exact answer below.
  elif [[ $reply != OK* && $reply == *" E connect("* ]]; then
    : # socat never connected (stale socket); qs ipc answers below.
  else
    echo "qs-call: the shell is not responding" >&2
    exit 1
  fi
fi

exec qs ipc call -- "$@"
