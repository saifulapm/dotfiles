#!/usr/bin/env bash
# playwright-cli: hands the browser Playwright starts the desktop's scaling flags and the machine-wide config, then runs the real CLI.
set -euo pipefail
{
# This wrapper comes first on PATH, so a PATH lookup would find itself; mise which prints the install's own path, asked from home since mise refuses to run inside a folder with an untrusted mise.toml.
real=$(mise -C "$HOME" which playwright-cli)
# Playwright starts chromium with its own flags, so without WaylandPerSurfaceScale and WaylandUiScale from this config it renders at 1x on a 1.5 scale output and blurs; the config repeats Playwright's own CDPScreenshotNewSurface there, since a second --enable-features replaces the first.
config=${XDG_CONFIG_HOME:-$HOME/.config}/playwright/cli.config.json

subcommand=""
explicit_config=false
extension=false
# The global session flag is spelled -s=<name>, so a token that starts with - is never the subcommand.
for arg in "$@"; do
  case $arg in
    --config | --config=*) explicit_config=true ;;
    --extension | --extension=*) extension=true ;;
    -*) ;;
    *) [[ -n $subcommand ]] || subcommand=$arg ;;
  esac
done

# attach --extension drives the desktop chromium, and Playwright would look for Google Chrome, which has no Linux arm64 build.
if [[ $subcommand == attach && $extension == true ]]; then
  export PLAYWRIGHT_MCP_EXECUTABLE_PATH=${PLAYWRIGHT_MCP_EXECUTABLE_PATH:-/usr/bin/chromium-browser}
  # Over ssh nobody is at the screen to click the extension's Allow, so chromium starts as its own user unit, not a child of the CLI daemon, and the extension's token approves the attach.
  if [[ -n ${SSH_CONNECTION:-} ]]; then
    # SingletonLock links to <host>-<pid> of the running browser; the socket beside it outlives a killed chromium.
    chromium_up() {
      local lock
      lock=$(readlink "$HOME/.config/chromium/SingletonLock" 2>/dev/null) &&
        kill -0 "${lock##*-}" 2>/dev/null
    }
    if ! chromium_up; then
      systemd-run --user --quiet --collect --property=ExitType=cgroup -- chromium-browser
      for _ in {1..50}; do
        chromium_up && break
        sleep 0.2
      done
    fi
    if [[ -z ${PLAYWRIGHT_MCP_EXTENSION_TOKEN:-} ]] &&
      token=$(playwright-extension-token); then
      export PLAYWRIGHT_MCP_EXTENSION_TOKEN=$token
    fi
  fi
fi

# playwright-cli reads a default config only from .playwright/ in the cwd, and only open and attach take --config; a project's own config or an explicit --config wins.
if [[ -f $config ]] &&
  [[ $subcommand == open || $subcommand == attach ]] &&
  [[ $explicit_config == false ]] &&
  [[ ! -f .playwright/cli.config.json ]]; then
  exec "$real" "$@" --config "$config"
fi

exec "$real" "$@"
exit
}
