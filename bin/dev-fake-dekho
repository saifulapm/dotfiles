#!/usr/bin/env bash
# just dev's dekho: answers the api verbs from the canned JSON in dev/dekho, so a nested check never reaches TMDB, and logs each call to DOTS_DEV_DIR/dekho.log.
set -euo pipefail
{
[ -n "${DOTS_DEV_DIR:-}" ] || { echo "dev-fake-dekho: run it from a sourced just dev env" >&2; exit 1; }
fixtures=$(dirname "$(realpath "$0")")/../dev/dekho
echo "$*" >>"$DOTS_DEV_DIR/dekho.log"

# The real dekho prints one compact JSON object on stdout.
answer() { jq -c . "$fixtures/$1.json"; }

# With DOTS_DEV_DIR/dekho-offline present TMDB is unreachable: trending comes back as the backend's saved copy from two days ago, 9 titles of the fixture's 12, and search has no saved copy to serve.
offline() { [ -f "$DOTS_DEV_DIR/dekho-offline" ]; }
saved() { jq -c '.items |= .[:9] | . + {cached: true, stale: true, age_secs: 172800}' "$fixtures/$1.json"; }

# A flag's value in this call's arguments, else "".
flag() {
  local name=$1
  shift
  sed -n "s/.* $name \([0-9a-z]*\).*/\1/p" <<<" $* "
}

# What a play leaves is kept in DOTS_DEV_DIR and outlasts the call, as the real history file does; until a play ends it is the fixture's.
history=$DOTS_DEV_DIR/dekho-history.json
[ -f "$history" ] || cp "$fixtures/history.json" "$history"

# api title's answer. Harbour Lights has a backdrop and no poster, A Quiet Verdict is a film with neither and no trailer; any other film answers as A Quiet Verdict under its own id, named, dated and pictured as Home's rows have it, with a trailer of its own; every other series answers as The Long Tide under its own id, its picture paths renamed for that id, so one title's pictures never match another's.
title_of() {
  if [ "$1" = 300 ] || [ "$1" = 400 ]; then
    answer "title-$1"
  elif [ "$2" = movie ]; then
    jq -c --argjson id "$1" --slurpfile t "$fixtures/trending-movie.json" --slurpfile h "$history" '
      (first($t[0].items[], $h[0].items[] | select(.id == $id and .kind == "movie")) // {title: "Film \($id)", year: "2026", poster: null, backdrop: null}) as $m
      | .id = $id | .title = $m.title | .year = $m.year | .poster = $m.poster | .backdrop = $m.backdrop
      | .trailer = "https://www.youtube.com/watch?v=fake\($id)"' "$fixtures/title-400.json"
  else
    jq -c --argjson id "$1" '.id = $id | (.poster, .backdrop, (.cast, .crew)[].profile) |= (strings |= sub("101"; $id | tostring))' "$fixtures/title-101.json"
  fi
}

# fake-mpv.qml stands in for mpv, its window titled as the real one is; it runs as this script's child so the script can write what the real backend writes once mpv quits. It ends by SIGTERM when its window closes, so its status is not this script's. A second title and a delay in seconds have it move on to that title then, as mpv does to an appended episode.
mpv() {
  FAKE_MPV_TITLE=$1 FAKE_MPV_NEXT_TITLE=${2:-} FAKE_MPV_NEXT_SECS=${3:-} FAKE_MPV_NEXT_MARK=${4:-} env -u QS_CONFIG_PATH qs -p "$fixtures/../fake-mpv.qml" >>"$DOTS_DEV_DIR/fake-mpv.log" 2>&1 &
  wait $! || true
}

case "${1:-} ${2:-}" in
"api history")
  limit=$(flag --limit "$*")
  jq -c --argjson n "${limit:-20}" '.items |= .[:$n]' "$history"
  ;;
"api trending")
  case "$*" in
  *"--kind tv"*) if offline; then saved trending-tv; else answer trending-tv; fi ;;
  *"--kind movie"*) if offline; then saved trending-movie; else answer trending-movie; fi ;;
  *) echo "dev-fake-dekho: trending needs --kind tv or movie: $*" >&2; exit 2 ;;
  esac
  ;;
"api discover")
  # Filters the fixture catalog as TMDB would, then prints only the fields a real hit carries.
  shift 2
  kind='' sort=popular genre='' lang='' rating='' year='' person='' page=1
  while [ $# -gt 0 ]; do
    case $1 in
    --kind) kind=$2 ;; --sort) sort=$2 ;; --genre) genre=$2 ;; --lang) lang=$2 ;;
    --min-rating) rating=$2 ;; --year) year=$2 ;; --person) person=$2 ;; --page) page=$2 ;;
    *) echo "dev-fake-dekho: unknown discover flag: $1" >&2; exit 2 ;;
    esac
    shift 2
  done
  # With DOTS_DEV_DIR/dekho-many-pages holding a count, every filter answers that many pages of 20 made-up hits each, "Film 2-07" the seventh film of page 2, and a page past the count answers none. A page past the first comes as late as DOTS_DEV_DIR/dekho-slow-pages says in seconds, and with DOTS_DEV_DIR/dekho-pages-fail present it fails as an unreachable TMDB does.
  if [ -f "$DOTS_DEV_DIR/dekho-many-pages" ]; then
    if [ "$page" -gt 1 ]; then
      [ -f "$DOTS_DEV_DIR/dekho-slow-pages" ] && sleep "$(cat "$DOTS_DEV_DIR/dekho-slow-pages")"
      if [ -f "$DOTS_DEV_DIR/dekho-pages-fail" ]; then
        echo '{"error":"tmdb: network unreachable"}'
        exit 1
      fi
    fi
    jq -nc --argjson n "$(cat "$DOTS_DEV_DIR/dekho-many-pages")" --argjson p "$page" --arg kind "$kind" '
      (if $kind == "tv" then "Series" else "Film" end) as $name
      | {items: (if $p > $n then [] else [range(1; 21) as $i | {id: ((if $kind == "tv" then 200000 else 100000 end) + $p * 100 + $i), kind: $kind,
          title: "\($name) \($p)-\($i | tostring | if length == 1 then "0" + . else . end)", year: "2026", vote: 7, poster: null, language: "English", genres: ["Drama"]}] end),
        page: $p, total_pages: $n}'
    exit 0
  fi
  if [ "$kind" = tv ] && [ "$sort" = box-office ]; then
    echo '{"error":"--sort box-office only applies to movies"}'
    exit 1
  fi
  if [ -n "$lang" ] && ! jq -e --arg l "$lang" 'any(.items[]; .code == $l)' "$fixtures/languages.json" >/dev/null; then
    echo "{\"error\":\"unknown --lang \\\"$lang\\\"; try a code like \`bn\` or a name like \`Bangla\`\"}"
    exit 1
  fi
  # A real hit names its language and genres, as the board's last two columns draw them.
  jq -c --slurpfile langs "$fixtures/languages.json" --slurpfile genres "$fixtures/genres-${kind:-tv}.json" --arg kind "$kind" --arg sort "$sort" --arg genre "$genre" --arg lang "$lang" --arg rating "$rating" --arg year "$year" --arg person "$person" '
    ($year | split("-") | map(tonumber)) as $y
    | [.[] | select(.kind == $kind)
      | select($genre == "" or (.genre_ids | index($genre | tonumber)))
      | select($lang == "" or .lang == $lang)
      | select($rating == "" or .vote >= ($rating | tonumber))
      | select($year == "" or ((.year | tonumber) >= $y[0] and (.year | tonumber) <= ($y[1] // $y[0])))
      | select($person == "" or (.person_ids | index($person | tonumber)))]
    | if $sort == "top-rated" then sort_by(-.vote)
      elif $sort == "newest" then sort_by(.year) | reverse
      elif $sort == "oldest" then sort_by(.year)
      elif $sort == "box-office" then sort_by(-.revenue)
      else . end
    | {items: map(. as $h | .language = ([$langs[0].items[] | select(.code == $h.lang) | .name] | .[0] // "")
        | .genres = [.genre_ids[] as $g | $genres[0].items[] | select(.id == $g) | .name]
        | del(.lang, .genre_ids, .person_ids, .revenue)), page: 1, total_pages: 1}' "$fixtures/discover.json"
  ;;
"api genres")
  case "$*" in
  *"--kind tv"*) answer genres-tv ;;
  *"--kind movie"*) answer genres-movie ;;
  *) echo '{"error":"genres needs --kind movie or tv"}'; exit 1 ;;
  esac
  ;;
"api languages")
  answer languages
  ;;
"api people")
  shift 2
  jq -c --arg q "${*,,}" '{items: [.items[] | select(.name | ascii_downcase | contains($q))]}' "$fixtures/people.json"
  ;;
"api search")
  if offline; then
    echo '{"error":"tmdb: network unreachable"}'
    exit 1
  fi
  shift 2
  # A query that is part of "tide" finds search-tide, any other finds search-harbour. A query held in DOTS_DEV_DIR/dekho-slow-search is answered 1.5 s late, so a check can have an older answer land after a newer one.
  q=${*,,}
  [ "$q" = "$(cat "$DOTS_DEV_DIR/dekho-slow-search" 2>/dev/null)" ] && sleep 1.5
  if [[ tide == *"$q"* ]]; then answer search-tide; else answer search-harbour; fi
  ;;
"api title")
  title_of "$(flag --id "$*")" "$(flag --kind "$*")"
  ;;
"api episodes")
  # Air dates count in days from today, so one to come still reads airs; w's marks are kept in DOTS_DEV_DIR and outlast the call.
  id=$(sed -n 's/.*--id \([0-9]*\).*/\1/p' <<<"$*")
  season=$(sed -n 's/.* -s \([0-9]*\).*/\1/p' <<<"$*")
  marks=$DOTS_DEV_DIR/dekho-watched.json
  [ -f "$marks" ] || echo '{}' >"$marks"
  jq -c --arg today "$(date -d today +%F)" --arg key "$id $season" --slurpfile marks "$marks" '
    {items: [(.[$key | split(" ")[1]] // [])[]
      | .watched = ($marks[0][$key + " " + (.episode | tostring)] // .watched)
      | .air_date = (($today + "T00:00:00Z" | fromdate) + .days * 86400 | strftime("%Y-%m-%d"))
      | .still |= (strings |= sub("101"; $key | split(" ")[0]))
      | del(.days)]}' "$fixtures/episodes.json"
  ;;
"api watched")
  id=$(sed -n 's/.*--id \([0-9]*\).*/\1/p' <<<"$*")
  season=$(sed -n 's/.* -s \([0-9]*\).*/\1/p' <<<"$*")
  episode=$(sed -n 's/.* -e \([0-9]*\).*/\1/p' <<<"$*")
  marks=$DOTS_DEV_DIR/dekho-watched.json
  [ -f "$marks" ] || echo '{}' >"$marks"
  case "$*" in *--unset*) to=false ;; *) to=true ;; esac
  jq --arg key "$id $season $episode" --argjson to "$to" '.[$key] = $to' "$marks" >"$marks.new"
  mv "$marks.new" "$marks"
  echo "{\"watched\":$to}"
  ;;
"api releases")
  # With DOTS_DEV_DIR/dekho-slow-releases holding seconds the answer comes that late, as a slow tracker's would.
  [ -f "$DOTS_DEV_DIR/dekho-slow-releases" ] && sleep "$(cat "$DOTS_DEV_DIR/dekho-slow-releases")"
  # The Long Tide's S3 E3 has no releases, so a check can draw that board; every other choice lists the fixture's, out of rank order, or with DOTS_DEV_DIR/dekho-many-releases holding a count that many, each its own.
  case "$*" in
  *"--id 101 "*"-s 3 -e 3"*) echo '{"items":[],"dropped":0,"failed":[]}' ;;
  *)
    if [ -f "$DOTS_DEV_DIR/dekho-many-releases" ]; then
      jq -c --argjson n "$(cat "$DOTS_DEV_DIR/dekho-many-releases")" '.items as $r | .items = [range($n) as $i | $r[$i % ($r | length)] | .hash = ("\($i + 10)" + .hash[2:]) | .title = "\(.title).\($i + 1)" | .seeders = 100 - $i]' "$fixtures/releases.json"
    else
      answer releases
    fi
    ;;
  esac
  ;;
"play --json")
  # The Starting events contract over about 3 s, then dev/fake-mpv.qml stands in for mpv until its window closes or the unit is stopped.
  emit() { printf '%s\n' "$1"; sleep 0.35; }
  # With DOTS_DEV_DIR/dekho-play-fails present the play fails before it plays: the file's text is the error's, then the backend exits 1.
  if [ -f "$DOTS_DEV_DIR/dekho-play-fails" ]; then
    emit '{"event":"status","text":"looking for releases"}'
    jq -nc --rawfile text "$DOTS_DEV_DIR/dekho-play-fails" '{event: "error", text: $text}'
    echo '{"event":"exit","code":1}'
    exit 1
  fi
  # As the real one on SIGTERM: before mpv there is nothing to save, and it exits 143 with no event; once mpv is up, it quits mpv and the run ends as when mpv quits.
  trap 'exit 143' TERM
  id=$(flag --id "$*")
  kind=$(flag --kind "$*")
  season=$(flag -s "$*")
  episode=$(flag -e "$*")
  case " $* " in *" --resume "*) resume=1 ;; *) resume= ;; esac
  title=$(title_of "$id" "$kind")
  name=$(jq -r .title <<<"$title")
  year=$(jq -r '.year // ""' <<<"$title")
  seen=$(jq -c --argjson id "$id" --arg kind "$kind" 'first(.items[] | select(.id == $id and .kind == $kind)) // null' "$history")
  # As the real one: --resume plays a series at the episode history holds unless -s/-e say otherwise, and from where it stopped only in that same episode.
  if [ "$kind" = tv ]; then
    if [ -z "$season" ] && [ -n "$resume" ] && [ "$seen" != null ]; then
      season=$(jq .season <<<"$seen")
      episode=$(jq .episode <<<"$seen")
    fi
    season=${season:-1} episode=${episode:-1}
    ep=$(jq -c --argjson s "$season" --argjson e "$episode" 'first((.[$s | tostring] // [])[] | select(.episode == $e)) // {name: "Episode \($e)", runtime: 3120}' "$fixtures/episodes.json")
    label=$(printf '%s — S%02dE%02d  %s' "$name" "$season" "$episode" "$(jq -r .name <<<"$ep")")
    duration=$(jq .runtime <<<"$ep")
    same=$(jq --argjson s "$season" --argjson e "$episode" '. != null and .season == $s and .episode == $e' <<<"$seen")
  else
    label=$name
    [ -z "$year" ] || label="$name ($year)"
    duration=$(jq '.runtime // 6300' <<<"$title")
    same=$(jq '. != null' <<<"$seen")
  fi
  # The length history holds for the same episode or film wins, as mpv measured it.
  [ "$same" != true ] || duration=$(jq --argjson d "$duration" 'if .duration > 0 then .duration else $d end' <<<"$seen")
  start=0
  if [ -n "$resume" ] && [ "$same" = true ]; then
    start=$(jq --argjson d "$duration" 'if .position > 0 and .position + 60 < $d then .position else 0 end' <<<"$seen")
  fi
  mb=1048576
  emit '{"event":"status","text":"looking for releases"}'
  emit '{"event":"trying","quality":"720p","size":"1.1 GB","seeders":530,"audio":"EN 2.0","needed_bps":4000000}'
  for i in 0 1 2 3 4; do
    emit "{\"event\":\"buffer\",\"buffered\":$((i * 27 * mb)),\"rate_bps\":31876710,\"live_peers\":$((i * 4)),\"seen_peers\":20,\"needed_bps\":4000000,\"bytes\":$((i * 27 * mb)),\"needed_bytes\":$((108 * mb)),\"peers\":$((i * 4)),\"sending\":$((i * 2)),\"down_bps\":$((i * 8000000)),\"up_bps\":3355443}"
  done
  emit "{\"event\":\"ready\",\"rate_bps\":31876710,\"buffered\":$((108 * mb)),\"cached\":false}"
  jq -nc --arg t "$label" --arg kind "$kind" --argjson id "$id" --argjson at "$start" '{event: "playing", title: $t, kind: $kind, id: $id, resumed_at: $at, bitrate: 4000000}'
  # Each play watches ten minutes, so what it leaves is known to a check: history holds the title first, 600 s past where it started.
  position=$((start + 600 > duration ? duration : start + 600))
  # With DOTS_DEV_DIR/dekho-advance holding seconds, a series moves on to its next episode that long after mpv opens, with no event, as dekho appends it: only mpv's window title says so, and history then holds that episode, 600 s in.
  next_label='' advance=''
  if [ "$kind" = tv ] && [ -f "$DOTS_DEV_DIR/dekho-advance" ]; then
    next=$(jq -c --argjson s "$season" --argjson e "$((episode + 1))" 'first((.[$s | tostring] // [])[] | select(.episode == $e)) // null' "$fixtures/episodes.json")
    if [ "$next" != null ]; then
      advance=$(cat "$DOTS_DEV_DIR/dekho-advance")
      next_label=$(printf '%s — S%02dE%02d  %s' "$name" "$season" "$((episode + 1))" "$(jq -r .name <<<"$next")")
    fi
  fi
  # The stand-in leaves this mark once it has moved on.
  mark=$DOTS_DEV_DIR/fake-mpv-moved-$$
  rm -f "$mark"
  moved_on() {
    [ -n "$advance" ] && [ -f "$mark" ] || return 1
    episode=$((episode + 1)) ep=$next duration=$(jq .runtime <<<"$next") position=$((600 > $(jq .runtime <<<"$next") ? $(jq .runtime <<<"$next") : 600))
  }
  record() {
    jq --argjson e "$(jq -nc --argjson t "$title" --arg kind "$kind" --argjson s "${season:-null}" --argjson ep "${episode:-null}" --arg epname "$( [ "$kind" = tv ] && jq -r .name <<<"$ep")" --argjson p "$position" --argjson d "$duration" --argjson now "$(date +%s)" '
      {id: $t.id, kind: $kind, title: $t.title, year: $t.year, poster: $t.poster, backdrop: $t.backdrop,
       season: (if $kind == "tv" then $s else null end), episode: (if $kind == "tv" then $ep else null end),
       episode_name: (if $kind == "tv" then $epname else null end),
       position: $p, duration: $d, finished: ($p >= $d * 0.9), updated: $now, progress: ($p / $d)}')" \
      '.items = [$e] + [.items[] | select((.id == $e.id and .kind == $e.kind) | not)]' "$history" >"$history.new"
    mv "$history.new" "$history"
  }
  # The stop's SIGTERM reaches every process in the unit at once, the ones this forks to save history among them, so once ending it ignores SIGTERM, and so do they.
  ended() {
    [ -z "${over:-}" ] || return 0
    over=1
    trap '' TERM
    moved_on || true
    record
    jq -nc --argjson p "$position" --argjson d "$duration" '{event: "ended", reason: "quit", position: $p, duration: $d}'
    echo '{"event":"exit","code":0}'
  }
  # mpv maps its window a while after playing.
  sleep 1.5 &
  wait $!
  # The stand-in can quit on the same SIGTERM, so the run may already be ending when the trap runs; it then lets that finish.
  trap 'if [ -z "${over:-}" ]; then ended; exit 0; fi' TERM
  mpv "$label" "$next_label" "$advance" "$mark"
  ended
  ;;
"trailer --json")
  # A trailer is never a playback run: no buffering and no history, only mpv on the title's trailer, which ends by itself.
  printf '%s\n' '{"event":"status","text":"Looking up the trailer…"}'
  # With DOTS_DEV_DIR/dekho-trailer-fails present the trailer fails with the file's text as its error.
  if [ -f "$DOTS_DEV_DIR/dekho-trailer-fails" ]; then
    jq -nc --rawfile text "$DOTS_DEV_DIR/dekho-trailer-fails" '{event: "error", text: $text}'
    echo '{"event":"exit","code":1}'
    exit 1
  fi
  title=$(title_of "$(flag --id "$*")" "$(flag --kind "$*")")
  url=$(jq -r '.trailer // ""' <<<"$title")
  if [ -z "$url" ]; then
    jq -nc --argjson t "$title" '{event: "error", text: "TMDB has no trailer for \($t.title)"}'
    echo '{"event":"exit","code":1}'
    exit 1
  fi
  label=$(jq -r 'if (.year // "") == "" then "\(.title) — Trailer" else "\(.title) (\(.year)) — Trailer" end' <<<"$title")
  jq -nc --arg t "$label" --argjson a "$title" --arg url "$url" '{event: "playing", title: $t, kind: $a.kind, id: $a.id, url: $url}'
  trap 'exit 143' TERM
  mpv "$label"
  echo '{"event":"exit","code":0}'
  ;;
"api person")
  # Only the ids with a fixture are known people, as TMDB knows only its own.
  id=$(sed -n 's/.*--id \([0-9]*\).*/\1/p' <<<"$*")
  if [ -f "$fixtures/person-$id.json" ]; then
    answer "person-$id"
  else
    echo '{"error":"no such person"}'
    exit 1
  fi
  ;;
"api prefetch")
  # As the real one: a path that is not one /name refuses the whole call; each image it holds is copied into img/<size> and named, a named fixture if there is one, else a sample; a name starting gone is left out, as a 404 is; offline, only what is already in img/<size> is named.
  size=$4
  # With DOTS_DEV_DIR/dekho-slow-prefetch present each answer comes that many seconds late, as a slow CDN's would, and dekho-slow.log records when it lands.
  if [ -f "$DOTS_DEV_DIR/dekho-slow-prefetch" ]; then
    sleep "$(cat "$DOTS_DEV_DIR/dekho-slow-prefetch")"
    echo "$*" >>"$DOTS_DEV_DIR/dekho-slow.log"
  fi
  [ -f "$fixtures/$size.png" ] || { echo "{\"error\":\"unknown --size \\\"$size\\\"\"}"; exit 1; }
  dir=$DOTS_DEV_DIR/img/$size
  for path in "${@:5}"; do
    name=${path#/}
    if [ -z "$name" ] || [[ $name == */* ]] || [[ $name == *..* ]]; then
      echo "{\"error\":\"image path \\\"$path\\\" is not one segment\"}"
      exit 1
    fi
  done
  mkdir -p "$dir"
  files='{}'
  missed=
  for path in "${@:5}"; do
    name=${path#/}
    if ! [ -f "$dir/$name" ]; then
      offline && { missed=1; continue; }
      [[ $name == gone* ]] && continue
      # A still (s<id>-<season>-<episode>) is landscape, as TMDB's are; every other sample has its size's shape.
      if [ -f "$fixtures/$name" ]; then cp "$fixtures/$name" "$dir/$name"; elif [[ $name == s[0-9]*-* ]]; then cp "$fixtures/still.png" "$dir/$name"; else cp "$fixtures/$size.png" "$dir/$name"; fi
    fi
    files=$(jq -c --arg p "$path" --arg f "$dir/$name" '.[$p] = $f' <<<"$files")
  done
  # The real one answers only once each missing download has failed, which offline is its 20 s timeout; 4 s here.
  [ -z "$missed" ] || sleep 4
  jq -nc --arg dir "$dir" --argjson files "$files" '{dir: $dir, files: $files}'
  ;;
*)
  echo "dev-fake-dekho: unknown command: $*" >&2
  exit 2
  ;;
esac
exit
}
