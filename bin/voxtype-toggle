#!/usr/bin/env bash
# voxtype-toggle — start the dictation daemon on demand, then toggle recording.
# What a double-tap of Alt spawns (packages/src/qshell-dshift.c), and what the
# bar widget and panel call, instead of `voxtype record toggle`.
#
# WHY: voxtype's daemon PRELOADS its whisper model at startup rather than
# per utterance, so leaving it running costs the whole model resident. Measured
# on this M2 (2026-08-08, fresh restart, idle VmRSS):
#   base.en    162 MB  (151 anon)
#   small.en   486 MB  (475 anon)   <- the model in use
# which made voxtype the single largest process on a 7.3 GB laptop while doing
# nothing at all. CPU is NOT the problem and never was: the idle daemon burned
# 0.000 s over a 5 s sample and 0.41 s total across its whole uptime, all of it
# the startup model load. This is purely about RAM.
#
# The memory is anonymous and therefore swappable rather than pinned — a daemon
# left idle for hours was observed at 4.8 MB VmRSS with the model entirely
# paged out, still working — so the kernel already reclaims it under pressure.
# Stopping it outright is the deterministic version of that, and it is cheap
# because a warm start is 0.20 s (see below).
#
# WHY A WRAPPER AND NOT SOCKET ACTIVATION: `voxtype record toggle` does not
# start the daemon, it fails with "Voxtype daemon is not running", so the binds
# alone cannot do this. And the mysql/postgres/redis on-demand pattern used
# elsewhere on this machine does not apply: record start/stop is SIGUSR1 and
# SIGUSR2 to the pidfile in $XDG_RUNTIME_DIR/voxtype, not a connection, and the
# binary carries no LISTEN_FDS/sd_listen support to be activated on.
#
# voxtype.service is `systemctl --user disable`d so nothing starts it at login;
# voxtype-idle-stop.timer stops it again after ~90 s idle. The bar is
# unaffected either way: Dictation.qml is only `active` while recording or
# transcribing, so a stopped daemon and an idle one look identical.
set -uo pipefail

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/voxtype"
state="$runtime/state"

# voxtype is a hand-installed [[tool]] (see packages/manifest.toml), absent on
# the NUC. Without this guard the systemctl start below no-ops against a unit
# that does not exist and the bind hangs the full 5 s readiness ceiling before
# complaining. Same guard voxtype-status already carries.
if ! command -v voxtype >/dev/null 2>&1; then
  command -v notify-send >/dev/null &&
    notify-send -u critical "Dictation" "voxtype is not installed on this machine"
  exit 0
fi

# Never START a dictation under the session lock. This guard is new with
# Alt-Alt and exists BECAUSE of it: the old niri binds could not fire while
# locked, but qshell-dshift reads evdev directly and does not care what the
# compositor is showing — so without this, two taps at a locked screen would
# open the microphone and transcribe into whatever gets focus at unlock.
#
# Only the START leg is blocked. A lock that lands mid-dictation must still be
# stoppable, and stopping is the safe direction in every case. Same check
# bin/notes-quick-capture makes, for the same reason.
if [[ "$(cat "$state" 2>/dev/null)" != "recording" ]] &&
  [[ "$(qs ipc call lock isLocked 2>/dev/null)" == "true" ]]; then
  exit 0
fi

if [[ ! -e $state ]]; then
  systemctl --user start voxtype.service

  # The state file IS the readiness signal, and a precise one: measured here it
  # appears at 0.20 s already containing "idle", 0.01 s before the daemon logs
  # "ready for voice input". Polling it beats trusting `systemctl start` to
  # return at the right moment — voxtype.service is Type=simple, so systemd
  # calls it started once it has forked, long before the 466 MB model is
  # loaded, and a toggle sent then is a silently lost keypress.
  #
  # 5 s ceiling: warm start is 0.20 s and a cold page cache only adds the model
  # read. Past that something is actually wrong, and saying so beats hanging a
  # keybind forever.
  for _ in $(seq 1 100); do
    [[ -e $state ]] && break
    sleep 0.05
  done

  if [[ ! -e $state ]]; then
    command -v notify-send >/dev/null &&
      notify-send -u critical "Dictation" "voxtype daemon failed to start"
    exit 1
  fi
fi

# Everything below is the START leg only. Reading the state tells the two legs
# apart: a STOP must neither reopen the microphone (bin/voxtype-mic-gate's
# waiter already owns closing it) nor stamp a fresh take over the one whose
# transcript is about to arrive.
if [[ "$(cat "$state" 2>/dev/null)" != "recording" ]]; then
  # The microphone is muted at rest on this machine, so without this the
  # daemon records digital silence. Full reasoning in bin/voxtype-mic-gate;
  # this runs BEFORE the toggle because the source has to be live before the
  # daemon opens the capture stream.
  voxtype-mic-gate open

  # Stamp the take for bin/voxtype-capture, which sees only the transcript and
  # could otherwise report neither how long it took nor where it went. Two
  # lines: epoch, then the focused window's app_id. This is the recording-start
  # hook we cannot install — `voxtype config set` rejects
  # output.pre_recording_command — done at the one place every dictation here
  # passes through.
  #
  # app_id only, never the title: the title of the window you dictate into is
  # far more revealing than the name of the program, and the panel only ever
  # buckets by program.
  app=""
  if command -v niri >/dev/null 2>&1; then
    # Bounded, and failure is silent: a wedged compositor must not hold up a
    # keypress, and an unattributed take is still a take.
    app="$(timeout 0.3 niri msg --json focused-window 2>/dev/null |
      jq -r '.app_id // ""' 2>/dev/null)" || app=""
  fi
  printf '%s\n%s\n' "$(date +%s)" "$app" >"$runtime/take-start" 2>/dev/null || true
fi

exec voxtype record toggle
