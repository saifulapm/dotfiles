#!/bin/bash
# Clipboard-image probe for the Notes capture input (Ctrl+V): if the
# clipboard offers an image, write it into the store's attachments dir and
# print the path — the panel stages it as the pending attachment. No image:
# print nothing, exit 1, and the TextEdit's own paste handles any text.
set -uo pipefail

type="$(wl-paste --list-types 2>/dev/null | grep -im1 '^image/')" || exit 1

dir="${XDG_STATE_HOME:-$HOME/.local/state}/qshell/notes/attachments"
mkdir -p "$dir"

ext="${type#image/}"
ext="${ext%%;*}"
ext="${ext%%+*}" # image/svg+xml -> svg, so isImagePath recognizes the file
[ "$ext" = "jpeg" ] && ext=jpg

f="$dir/paste-$(date +%s%N).$ext"
if ! wl-paste --type "$type" >"$f" 2>/dev/null || [ ! -s "$f" ]; then
    rm -f "$f"
    exit 1
fi
printf '%s\n' "$f"
