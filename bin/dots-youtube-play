#!/usr/bin/env bash
# dots-youtube-play video <id>: plays a YouTube video in an mpv window under a transient user unit of its own, youtube-video-<n>, so it outlives the App's window and qs, and two plays are two windows each stoppable by unit; prints {"unit": <name>}.
set -uo pipefail
{
usage() {
  echo "dots-youtube-play: usage: video <video id>" >&2
  exit 2
}
[ "${1:-}" = video ] && [ $# = 2 ] || usage
# An id is all the App plays here, so nothing else reaches mpv's command line as an option.
[[ $2 =~ ^[A-Za-z0-9_-]{11}$ ]] || usage
url=https://www.youtube.com/watch?v=$2

# The unit gets the user manager's PATH, so mpv's yt-dlp is named by path, and yt-dlp is handed the deno mise holds (ruling B47Y3V5J).
player=(
  "${DOTS_YOUTUBE_MPV:-mpv}"
  --force-window=immediate
  "--ytdl-format=bv*[height<=1080]+ba/b[height<=1080]"
  # A stream URL YouTube has since refused answers 403; lavf reconnects instead of ending the video.
  --stream-lavf-o=reconnect=1,reconnect_on_http_error=403,reconnect_delay_max=3
)
ytdlp=$(command -v yt-dlp) && player+=("--script-opts=ytdl_hook-ytdl_path=$ytdlp")
deno=$(mise which deno 2>/dev/null) && [ -n "$deno" ] && player+=("--ytdl-raw-options=js-runtimes=deno:$deno")

# The display mpv opens on and a nested check's dirs reach the unit only by name.
pass=()
for name in $(compgen -e); do
  case $name in WAYLAND_DISPLAY | XDG_RUNTIME_DIR | XDG_CONFIG_HOME | XDG_CACHE_HOME | XDG_STATE_HOME | MPV_HOME | DOTS_DEV_DIR) pass+=("--setenv=$name") ;; esac
done

# The first free number; systemd-run refuses a name another play took a moment ago, so the next is tried.
for n in $(seq 1 99); do
  unit=youtube-video-$n
  systemctl --user is-active --quiet "$unit.service" && continue
  if systemd-run --user --collect --quiet --unit "$unit" "${pass[@]}" -- "${player[@]}" "$url" 2>/dev/null; then
    jq -nc --arg u "$unit" '{unit: $u}'
    exit 0
  fi
done
jq -nc '{error: "no video window could start: systemd-run refused youtube-video-1 to 99"}'
exit 1
}
