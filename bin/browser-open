#!/usr/bin/env bash
# browser-open — open URLs in THIS workspace's chromium, never another one's.
#
# One chromium profile spread over several niri workspaces (one per project)
# has a problem: chromium hands a forwarded URL to whichever browser window
# was activated last, which is regularly a window on some other workspace.
# Click a link in foot on the shopify workspace and the tab lands in the
# laravel one, three workspaces away, silently.
#
# So: find the tabbed chromium window on the workspace that is focused RIGHT
# NOW, focus it, and only then hand the URL over — the activation is what
# makes chromium choose that window (verified on this machine 2026-09-08:
# focus window A, open a URL, the tab is in A; focus B, open another, it is
# in B). With no browser window here, --new-window opens one, which niri maps
# on the focused workspace. Either way the tab you asked for is on the
# workspace you asked from.
#
#   browser-open [url...]
#
# This is the x-scheme-handler/http(s) default (browser-open.desktop), so it
# covers everything that goes through xdg-open — links clicked in foot,
# notifications, editors, any app.
set -euo pipefail

# Fedora's binary and app-id. Webapp windows (chrome-<host>__-Default) are
# deliberately NOT candidates: chromium cannot put a tab in an app window and
# would silently fall back to a tabbed browser somewhere else, so a workspace
# holding only a webapp gets a new window instead.
readonly APP_ID=chromium-browser

workspace=$(niri msg --json workspaces 2>/dev/null |
  jq -r 'map(select(.is_focused)) | first | .id // empty') || workspace=

target=
if [[ -n $workspace ]]; then
  # Floating windows are out for the same reason as webapps: a sign-in popup
  # carries the browser's app-id but is not a tabbed browser. Newest FOCUS
  # wins among the rest, so with two browser windows side by side on one
  # workspace the tab joins the one that was last worked in.
  target=$(niri msg --json windows 2>/dev/null |
    jq -r --arg app "$APP_ID" --argjson ws "$workspace" '
      map(select(.app_id == $app and .workspace_id == $ws and .is_floating == false))
      | sort_by([(.focus_timestamp.secs // -1), (.focus_timestamp.nanos // 0), .id])
      | last | .id // empty') || target=
fi

if [[ -z $target ]]; then
  # Via app-run, like every other launch here: its own transient unit under
  # app-graphical.slice, so a leaking tab cannot take the shell down with it.
  exec app-run "$APP_ID" --new-window "$@" >/dev/null 2>&1
fi

niri msg action focus-window --id "$target" >/dev/null

# The handoff races the activation: chromium picks its window when the URL
# arrives, so the URL must not arrive before the compositor has told chromium
# it is focused. Wait for niri to report the focus (typically the first pass),
# then a beat for chromium to process the activation it was just sent.
for _ in $(seq 20); do
  [[ $(niri msg --json focused-window 2>/dev/null | jq -r '.id // empty') == "$target" ]] && break
  sleep 0.025
done
sleep 0.1

exec app-run "$APP_ID" "$@" >/dev/null 2>&1
