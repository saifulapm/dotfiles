#!/usr/bin/env bash
# theme-set <name> — activate a theme from themes/ and fan it out.
# theme-set        — list themes (* marks the active one).
#
# The active theme is a REGULAR file written atomically (cp + same-dir mv).
# Never a symlink: repointing a symlink is invisible to the shell's inotify
# watch (the watch stays bound to the old target's inode).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
state_dir="$HOME/.local/state/qshell"
state="$state_dir/theme.toml"
name_file="$state_dir/theme.name"

if [[ $# -eq 0 ]]; then
  current=""
  [[ -f $name_file ]] && current="$(<"$name_file")"
  for f in "$root"/themes/*.toml; do
    n="$(basename "${f%.toml}")"
    if [[ $n == "$current" ]]; then echo "* $n"; else echo "  $n"; fi
  done
  exit 0
fi

if [[ $# -ne 1 ]]; then
  echo "usage: theme-set [<name>]" >&2
  exit 1
fi

src="$root/themes/$1.toml"
if [[ ! -f $src ]]; then
  echo "theme-set: no such theme: $1 (looked at $src)" >&2
  exit 1
fi

mkdir -p "$state_dir"

# Serialize concurrent theme changes (omarchy's rule): the sequence below is
# ordered — name write, peek, IPC push, theme.toml write, wallpaper write —
# and two interleaved runs can resolve one run's peek against the other's
# theme name, leaving the last palette and the last wallpaper disagreeing.
# Released before the slow app fan-out so another selection queues only
# behind the critical section.
exec 9>"$state_dir/theme-set.lock"
flock 9

# The synchronized switch, omarchy's sequencing: hand the running shell the
# wallpaper pair and the palette in ONE IPC call, before any watched file
# changes. The shell latches its theme file-watch off, starts the slanted-wipe
# reveal, and applies the palette on the reveal's first frame — so the colors
# and the wallpaper land together instead of in file-watch order. The state
# files are still written below either way: they are what the next shell start
# (and every non-shell consumer) reads.
#
# Wallpaper choice: bin/background-next owns the candidate list and the cycle,
# and reads the theme name written here first — so switching themes lands on
# the new theme's first image and re-applying the active one advances to its
# next, omarchy-style. --peek chooses without writing; the write comes after
# the IPC push so the shell's file watch sees a path it already transitioned
# to and de-duplicates.
old_bg=""
[[ -f $state_dir/background ]] && old_bg="$(<"$state_dir/background")"

printf '%s\n' "$1" >"$name_file.tmp"
mv "$name_file.tmp" "$name_file"

next_bg="$("$root/bin/background-next" --peek || true)"

if ! timeout 2 qs ipc call background themeTransition "$old_bg" "$next_bg" "$(base64 -w 0 "$src")" >/dev/null 2>&1; then
  # Degradation path — shell dead, absent, or predating the IPC surface. The
  # palette will land through the theme.toml file watch (or the next shell
  # start), the wallpaper through the state file, in no particular order; the
  # compositor-level crossfade folds those uncoordinated flips into one
  # motion. Never fired on the synchronized path: freezing the screen there
  # would hide the reveal it is sequenced around. Best-effort — a dead or
  # absent niri must never block a theme change.
  timeout 1 niri msg action do-screen-transition --delay-ms 200 >/dev/null 2>&1 || true
fi

cp "$src" "$state.tmp"
mv "$state.tmp" "$state"

# Nudge the shell to re-read it rather than trusting the FileView watch on this
# file. A watch on something rewritten in quick succession can stop delivering
# permanently (omarchy hit that on their bar-toggle flag, e1fc5022), and the
# failure mode is silent: the shell keeps the old palette until it restarts,
# with nothing in the log to say why. Best-effort and after the move, so a dead
# or absent shell costs a timeout and the watch still covers a hand edit.
timeout 2 qs ipc call theme reload >/dev/null 2>&1 || true

# No candidates just means no wallpaper change. Never abort here: the shell
# has already accepted the transition, and the app fan-out below must still
# run even if the peeked path vanished in between.
if [[ -n $next_bg ]]; then
  "$root/bin/background-next" --set "$next_bg" || true
fi

# Critical section over — release before the slower fan-out.
flock -u 9

exec "$root/bin/theme-apply"
