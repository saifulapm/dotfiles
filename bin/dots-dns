#!/usr/bin/env node
// Reads every DNS Shield device into one `state` JSON and writes their Kid mode, categories and allow rules. Carried devices are uBlockDNS profiles reached over its API; router devices are reservations on the home OpenWrt router, reached over ssh.
import { mkdirSync, readFileSync, readdirSync, renameSync, rmSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { spawn, spawnSync } from 'node:child_process';
import { randomBytes } from 'node:crypto';

const env = process.env;
const API = env.DOTS_DNS_API || 'https://ublockdns.com/api';
const CONFIG = join(env.HOME, '.config', 'dns-helper');
const STATE = join(env.HOME, '.local', 'state', 'dns-helper');
const SESSION = join(STATE, 'session');
const ID = /^[A-Za-z0-9_-]{1,64}$/;

// The service has no YouTube module, so YouTube is this group of custom rules; the apps keep playing if only youtube.com goes.
const YOUTUBE = ['||youtube.com^', '||youtu.be^', '||googlevideo.com^', '||ytimg.com^', '||youtubekids.com^', '||youtube-nocookie.com^', '||youtubei.googleapis.com^'];
const MODULES = { social: 'social-apps', adult: 'adult-content', gambling: 'gambling' };

// A failure's message names the step and the HTTP code only, never a token, an account id or a device id.
class Failure extends Error {}

// Text a server controls reaches the state as one line with no control characters or bidi marks, so it cannot forge a row when drawn.
const clean = (v) =>
  typeof v === 'string'
    ? v
        .replace(/[\r\n\t\u2028\u2029]+/g, ' ')
        .replace(/[\p{Cc}\u202A-\u202E\u2066-\u2069\u200E\u200F]/gu, '')
        .trim()
    : '';

const firstLine = (path) => {
  try {
    return readFileSync(path, 'utf8').split('\n')[0];
  } catch {
    return '';
  }
};

// Each write goes to a temp file renamed over the old one, so a reader only ever sees a whole file.
function save(path, data, mode = 0o644) {
  const tmp = `${path}.${process.pid}.tmp`;
  writeFileSync(tmp, data, { mode });
  renameSync(tmp, path);
}

// The cookie jar is curl's, shared with v1's dns-filter; only its ubd_session row is read or replaced.
function jarCookie() {
  try {
    for (const line of readFileSync(SESSION, 'utf8').split('\n')) {
      const f = line.split('\t');
      if (f.length >= 7 && f[5] === 'ubd_session') return f[6];
    }
  } catch {}
  return null;
}

function saveCookie(value, maxAge) {
  const url = new URL(API);
  let lines;
  try {
    lines = readFileSync(SESSION, 'utf8').split('\n').filter((l) => l.split('\t')[5] !== 'ubd_session');
  } catch {
    lines = ['# Netscape HTTP Cookie File', ''];
  }
  while (lines.length && lines[lines.length - 1] === '') lines.pop();
  const expires = Math.floor(Date.now() / 1000) + maxAge;
  lines.push(['#HttpOnly_' + url.hostname, 'FALSE', url.pathname.replace(/\/$/, '') || '/', url.protocol === 'https:' ? 'TRUE' : 'FALSE', expires, 'ubd_session', value].join('\t'));
  mkdirSync(STATE, { recursive: true });
  save(SESSION, lines.join('\n') + '\n', 0o600);
}

let session;
let login;

async function call(method, path, body) {
  if (session === undefined) session = jarCookie();
  const headers = {};
  if (session) headers.cookie = 'ubd_session=' + session;
  if (body) headers['content-type'] = 'application/json';
  try {
    return await fetch(API + path, { method, headers, body: body && JSON.stringify(body), signal: AbortSignal.timeout(25000) });
  } catch {
    return null;
  }
}

// The session cookie lasts a year, so a login happens only when the server refuses it, and at most once per run.
async function signIn() {
  const token = firstLine(join(CONFIG, 'token')).replace(/\s/g, '');
  if (!token) throw new Failure('no account token in ~/.config/dns-helper/token');
  let res;
  try {
    res = await fetch(API + '/auth', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ token }), signal: AbortSignal.timeout(25000) });
  } catch {
    throw new Failure('login failed (no answer)');
  }
  if (res.status !== 200) throw new Failure(`login failed (HTTP ${res.status})`);
  for (const c of res.headers.getSetCookie()) {
    const m = c.match(/^ubd_session=([^;]*)/);
    if (!m) continue;
    const age = c.match(/;\s*max-age=(\d+)/i);
    session = m[1];
    saveCookie(session, age ? Number(age[1]) : 365 * 86400);
  }
}

async function api(step, method, path, body, raw = false) {
  let res = await call(method, path, body);
  if (res && (res.status === 401 || res.status === 403)) {
    await (login ??= signIn());
    res = await call(method, path, body);
  }
  if (!res) throw new Failure(`${step} failed (no answer)`);
  if (res.status !== 200) throw new Failure(`${step} failed (HTTP ${res.status})`);
  if (raw) return Buffer.from(await res.arrayBuffer());
  try {
    return await res.json();
  } catch {
    throw new Failure(`${step} failed (not JSON)`);
  }
}

// The account id is found once from v1's profile id and kept beside it.
async function account() {
  const known = firstLine(join(CONFIG, 'account')).trim();
  if (ID.test(known)) return known;
  const profile = firstLine(join(CONFIG, 'profile')).trim();
  if (!ID.test(profile)) throw new Failure('no account id in ~/.config/dns-helper/account');
  const id = (await api('read profile', 'GET', '/profile/' + profile)).account_id;
  if (typeof id !== 'string' || !ID.test(id)) throw new Failure('read profile failed (no account id)');
  save(join(CONFIG, 'account'), id + '\n');
  return id;
}

async function devices(acct) {
  const list = await api('list devices', 'GET', `/account/${acct}/devices`);
  if (!Array.isArray(list)) throw new Failure('list devices failed (not a list)');
  return list.filter((d) => d && typeof d.id === 'string' && ID.test(d.id));
}

function categories(dev) {
  const rules = Array.isArray(dev.custom_rules) ? dev.custom_rules : [];
  const on = { youtube: YOUTUBE.every((r) => rules.includes(r)) };
  for (const [cat, mod] of Object.entries(MODULES)) on[cat] = (dev.policy_modules || {})[mod] === true;
  return on;
}

const allowList = (dev) => (Array.isArray(dev.custom_rules) ? dev.custom_rules : []).map((r) => typeof r === 'string' && r.match(/^@@\|\|(.+)\^$/)).filter(Boolean).map((m) => clean(m[1]));

// The server ignores action=blocked, so the allowed answers are dropped here.
const blocks = (body) =>
  (Array.isArray(body && body.entries) ? body.entries : [])
    .filter((e) => e && e.action === 'blocked' && typeof e.timestamp === 'number')
    .sort((a, b) => b.timestamp - a.timestamp)
    .slice(0, 20)
    .map((e) => ({ domain: clean(e.domain), at: e.timestamp }));

async function carriedRows() {
  const acct = await account();
  return Promise.all(
    (await devices(acct)).map(async ({ id }) => {
      const [dev, queries] = await Promise.all([api('read device', 'GET', `/account/${acct}/device/${id}`), api('read queries', 'GET', `/account/${acct}/device/${id}/queries?limit=100&action=blocked`)]);
      const cats = categories(dev);
      const recent = blocks(queries);
      return { key: 'carried:' + id, name: clean(dev.name), path: 'carried', kid: Object.values(cats).some(Boolean), categories: cats, open_until: null, allow: allowList(dev), last_block: recent.length ? recent[0].at : null, blocks: recent, ip: null, mac: null };
    }),
  );
}

// Only the three keys dots-dns needs are read from router.env; the rest of it is secrets.
function routerEnv() {
  const vars = { ROUTER_HOST: '192.168.0.1' };
  let text = '';
  try {
    text = readFileSync(join(CONFIG, 'router.env'), 'utf8');
  } catch {}
  for (const line of text.split('\n')) {
    const m = line.match(/^\s*(?:export\s+)?(SSH_KEY|ROUTER_HOST|ROUTER_JUMP)=(.*)$/);
    if (!m) continue;
    const v = m[2].trim().replace(/^'(.*)'$|^"(.*)"$/, '$1$2');
    vars[m[1]] = v.replace(/^~(?=\/)/, env.HOME).replace(/\$\{HOME\}|\$HOME\b/g, env.HOME);
  }
  if (!vars.SSH_KEY) throw new Failure('no SSH_KEY in ~/.config/dns-helper/router.env');
  return vars;
}

// One ssh per read or write, with the script on stdin. The timer is a backstop past ConnectTimeout for a link that connects and then hangs.
function ssh(script) {
  const r = routerEnv();
  mkdirSync(STATE, { recursive: true });
  const args = [...(r.ROUTER_JUMP ? ['-J', r.ROUTER_JUMP] : []), '-i', r.SSH_KEY, '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=5', '-o', 'StrictHostKeyChecking=accept-new', '-o', 'UserKnownHostsFile=' + join(STATE, 'router_known_hosts'), 'root@' + r.ROUTER_HOST, 'sh', '-s'];
  return new Promise((resolve) => {
    const child = spawn('ssh', args, { stdio: ['pipe', 'pipe', 'ignore'] });
    let stdout = '';
    const timer = setTimeout(() => child.kill('SIGKILL'), 20000);
    child.stdout.on('data', (d) => (stdout += d));
    child.stdin.on('error', () => {});
    child.on('error', () => {});
    child.on('close', (code) => {
      clearTimeout(timer);
      resolve({ code, stdout });
    });
    child.stdin.end(script);
  });
}

// `uci show` quotes each value and writes a quote inside one as '\'' ; a value may run over lines, so the text is walked whole.
function uciShow(text) {
  const sections = new Map();
  let i = 0;
  const lineEnd = () => {
    const e = text.indexOf('\n', i);
    i = e < 0 ? text.length : e + 1;
  };
  while (i < text.length) {
    const eq = text.indexOf('=', i);
    const nl = text.indexOf('\n', i);
    if (eq < 0) break;
    if (nl >= 0 && nl < eq) {
      i = nl + 1;
      continue;
    }
    const key = text.slice(i, eq).split('.');
    i = eq + 1;
    const vals = [];
    if (text[i] === "'") {
      while (text[i] === "'") {
        let v = '';
        i++;
        for (;;) {
          const j = text.indexOf("'", i);
          if (j < 0) {
            v += text.slice(i);
            i = text.length;
            break;
          }
          v += text.slice(i, j);
          i = j + 1;
          if (!text.startsWith("\\''", i)) break;
          v += "'";
          i += 3;
        }
        vals.push(v);
        if (text[i] === ' ' && text[i + 1] === "'") i++;
      }
      lineEnd();
    } else {
      const start = i;
      lineEnd();
      vals.push(text.slice(start, i).replace(/\n$/, ''));
    }
    if (key.length === 2) sections.set(key[1], { type: vals[0], o: {} });
    else if (key.length === 3 && sections.has(key[1])) sections.get(key[1]).o[key[2]] = vals;
  }
  return [...sections.values()];
}

const MONTHS = { Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5, Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11 };
const IPV4 = /^\d{1,3}(\.\d{1,3}){3}$/;
const MAC = /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/;
const DOMAIN = /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/;

// The Kid dnsmasq logs with log-queries=extra and no year, on the router's UTC clock; a date past the router's now belongs to last year. A block is a name it answered from its own config.
function kidBlocks(log, now) {
  const year = new Date(now * 1000).getUTCFullYear();
  const byIp = new Map();
  for (const line of log.split('\n')) {
    const m = line.match(/^(\w{3}) +(\d{1,2}) (\d\d):(\d\d):(\d\d) dnsmasq\[\d+\]: (?:\d+ )?([\d.]+)\/\d+ config (\S+) is (NXDOMAIN|0\.0\.0\.0|::|NODATA\S*)$/);
    if (!m || MONTHS[m[1]] === undefined) continue;
    const t = (y) => Date.UTC(y, MONTHS[m[1]], Number(m[2]), Number(m[3]), Number(m[4]), Number(m[5])) / 1000;
    const at = t(year) > now + 86400 ? t(year - 1) : t(year);
    if (!byIp.has(m[6])) byIp.set(m[6], []);
    byIp.get(m[6]).push({ domain: clean(m[7]), at });
  }
  for (const list of byIp.values()) list.sort((a, b) => b.at - a.at).splice(20);
  return byIp;
}

function routerRows(sections, now) {
  const [dhcp, firewall, log, allowFile] = sections;
  const ipsets = uciShow(firewall).filter((s) => s.type === 'ipset');
  const set = (name) => new Set(ipsets.filter((s) => (s.o.name || [])[0] === name).flatMap((s) => s.o.entry || []).map((e) => e.toLowerCase()));
  const kidIps = set('kid');
  const kidMacs = set('kid_mac');
  const allow = allowFile.split('\n').map(clean).filter((d) => DOMAIN.test(d));
  const recent = kidBlocks(log, now);
  return uciShow(dhcp)
    .filter((s) => s.type === 'host')
    .map((s) => ({ name: clean((s.o.dns_shield_name || s.o.name || [''])[0]), mac: ((s.o.mac || [''])[0].split(' ')[0] || '').toLowerCase(), ip: (s.o.ip || [''])[0] }))
    .filter((h) => MAC.test(h.mac))
    .map((h) => {
      const ip = IPV4.test(h.ip) ? h.ip : null;
      const kid = kidMacs.has(h.mac) || (ip !== null && kidIps.has(ip));
      const blocks = (ip && recent.get(ip)) || [];
      return { key: 'router:' + h.mac, name: h.name, path: 'router', kid, categories: { youtube: kid, social: kid, adult: kid, gambling: kid }, open_until: null, allow: kid ? allow : [], last_block: blocks.length ? blocks[0].at : null, blocks, ip, mac: h.mac };
    });
}

const CACHE = join(env.XDG_CACHE_HOME || join(env.HOME, '.cache'), 'dots', 'dns');

// A lease line is `expiry mac ip hostname clientid`; a device's own DHCP hostname is anything it likes, `*` for none.
function leaseRows(text, listed) {
  const known = new Set(listed.map((d) => d.mac));
  const seen = new Set();
  return text
    .split('\n')
    .map((l) => l.split(' '))
    .filter((f) => f.length >= 4 && MAC.test((f[1] || '').toLowerCase()) && IPV4.test(f[2]))
    .map((f) => ({ mac: f[1].toLowerCase(), ip: f[2], hostname: f[3] === '*' ? '' : clean(f[3]) }))
    .filter((l) => !known.has(l.mac) && !seen.has(l.mac) && seen.add(l.mac));
}

// Each section starts on a marker line made fresh per read, so text on the router cannot fake one.
async function routerRead(asOf) {
  const mark = '@@' + randomBytes(8).toString('hex');
  const parts = ['date +%s', 'uci show dhcp', 'uci show firewall', 'tail -n 2000 "$R/tmp/dns-shield/kid.log" 2>/dev/null', 'cat "$R/etc/dns-shield/allow" 2>/dev/null', 'cat "$R/tmp/dhcp.leases" 2>/dev/null'];
  const script = ['R=${DOTS_DNS_ROUTER_ROOT:-}', ...parts.flatMap((p) => [`echo ${mark}`, p]), `echo ${mark}`].join('\n') + '\n';
  let error;
  try {
    const r = await ssh(script);
    const sections = r.stdout.split(mark + '\n').slice(1);
    const now = Number(sections[0]);
    if (r.code === 0 && sections.length === parts.length + 1 && now > 0) {
      const out = { as_of: asOf, devices: routerRows(sections.slice(1), now) };
      mkdirSync(CACHE, { recursive: true });
      save(join(CACHE, 'router.json'), JSON.stringify(out));
      return { ok: true, as_of: out.as_of, error: null, devices: out.devices, leases: leaseRows(sections[5], out.devices) };
    }
    error = r.code === 0 ? 'router read failed (unexpected answer)' : `router unreachable (ssh exit ${r.code === null ? 'killed' : r.code})`;
  } catch (e) {
    if (!(e instanceof Failure)) throw e;
    error = e.message;
  }
  let cached = null;
  try {
    cached = JSON.parse(readFileSync(join(CACHE, 'router.json'), 'utf8'));
  } catch {}
  const ok = cached && Array.isArray(cached.devices);
  return { ok: false, as_of: ok ? cached.as_of : null, error, devices: ok ? cached.devices : [] };
}

async function state() {
  if ([...deadlines().values()].some((until) => until <= Date.now() / 1000)) spawnSync(process.execPath, [process.argv[1], 'reconcile'], { stdio: ['ignore', 'ignore', 'inherit'], env });
  const out = { as_of: Math.floor(Date.now() / 1000), carried: { ok: true, error: null }, router: null, devices: [] };
  const router = routerRead(out.as_of);
  try {
    out.devices.push(...(await carriedRows()));
  } catch (e) {
    if (!(e instanceof Failure)) throw e;
    out.carried = { ok: false, error: e.message };
    process.stderr.write(`dots-dns: ${e.message}\n`);
  }
  const { devices, leases, ...status } = await router;
  out.router = status;
  out.devices.push(...devices);
  const open = deadlines();
  for (const d of out.devices) {
    const until = open.get(d.key);
    if (!until || d.kid) continue;
    d.open_until = until;
    d.categories = d.path === 'router' ? { youtube: true, social: true, adult: true, gambling: true } : kept(d.key.slice('carried:'.length));
  }
  return JSON.stringify(out) + '\n';
}

async function profiles() {
  return (await devices(await account())).map((d) => `${clean(d.name)}\t${d.id}\n`).join('');
}

// The file is named after the device, with the characters a file name cannot hold replaced.
async function profile(id) {
  const acct = await account();
  const dev = (await devices(acct)).find((d) => d.id === id);
  if (!dev) throw new Failure('no such carried device');
  const body = await api('read apple-profile', 'GET', `/account/${acct}/device/${id}/apple-profile`, null, true);
  const name = clean(dev.name).replace(/[/\\:*?"<>|]/g, '-').replace(/^\.+/, '').slice(0, 100) || id;
  const dir = join(env.HOME, 'Downloads');
  mkdirSync(dir, { recursive: true });
  const path = join(dir, name + '.mobileconfig');
  save(path, body);
  return path + '\n';
}

const CATS = ['youtube', 'social', 'adult', 'gambling'];

function setCategory(dev, cat, on) {
  const rules = dev.custom_rules;
  if (cat === 'youtube') dev.custom_rules = on ? [...rules, ...YOUTUBE.filter((r) => !rules.includes(r))] : rules.filter((r) => !YOUTUBE.includes(r));
  else dev.policy_modules = { ...dev.policy_modules, [MODULES[cat]]: on };
}

// PUT replaces the whole config, so every write reads the device first and sends back the five keys with only its own change made.
async function writeCarried(id, change) {
  const acct = await account();
  const path = `/account/${acct}/device/${id}`;
  const dev = await api('read device', 'GET', path);
  if (!dev || !Array.isArray(dev.custom_rules)) throw new Failure('read device failed (unexpected answer)');
  change(dev);
  const { lists, custom_rules, dns_provider, preset_id, policy_modules } = dev;
  await api('write device', 'PUT', path, { lists, custom_rules, dns_provider, preset_id, policy_modules });
}

const kidFile = (id) => join(STATE, `kid-${id}.json`);

// Kid off keeps the categories it turns off, so Kid on brings back the same ones; with nothing kept it turns all four on.
function kidCarried(id, on) {
  return writeCarried(id, (dev) => {
    if (!on) {
      const cats = categories(dev);
      if (CATS.some((c) => cats[c])) save(kidFile(id), JSON.stringify(cats) + '\n');
      for (const c of CATS) setCategory(dev, c, false);
      return;
    }
    const cats = kept(id);
    for (const c of CATS) if (cats[c]) setCategory(dev, c, true);
  });
}

// The categories Kid on brings back: those Kid off kept, or all four when none were kept.
function kept(id) {
  let k = null;
  try {
    k = JSON.parse(readFileSync(kidFile(id), 'utf8'));
  } catch {}
  if (!k || !CATS.some((c) => k[c] === true)) return { youtube: true, social: true, adult: true, gambling: true };
  return Object.fromEntries(CATS.map((c) => [c, k[c] === true]));
}

function allowCarried(id, domain, on) {
  const rule = `@@||${domain}^`;
  return writeCarried(id, (dev) => {
    const rest = dev.custom_rules.filter((r) => r !== rule);
    dev.custom_rules = on && rest.length === dev.custom_rules.length ? [...rest, rule] : on ? dev.custom_rules : rest;
  });
}

const ROUTER_FAIL = { 3: 'the router has no reservation for that device', 4: 'the router has no kid and kid_mac ipsets', 5: 'router write failed (uci commit)', 6: 'router write failed (nft)', 7: 'router write failed (dns-shield reload)', 8: 'that device is already listed', 9: 'the router has no lease for that device', 10: 'router write failed (dnsmasq reload)' };

async function writeRouter(lines) {
  const r = await ssh(['R=${DOTS_DNS_ROUTER_ROOT:-}', ...lines].join('\n') + '\n');
  if (r.code === 0) return;
  if (r.code === 255 || r.code === null) throw new Failure(`router unreachable (ssh exit ${r.code === null ? 'killed' : r.code})`);
  throw new Failure(ROUTER_FAIL[r.code] || `router write failed (exit ${r.code})`);
}

// The MAC was checked against MAC before it reaches the script. The IP is the reservation's, found on the router, and both Kid sets change in uci and in the live nft set so no fw4 reload is needed.
function kidRouter(mac, on) {
  const change = on
    ? ['uci del_list "firewall.@ipset[$k].entry=$ip"', 'uci add_list "firewall.@ipset[$k].entry=$ip"', 'uci del_list "firewall.@ipset[$km].entry=$mac"', 'uci add_list "firewall.@ipset[$km].entry=$mac"', 'uci commit firewall || exit 5', 'nft add element inet fw4 kid "{ $ip }" || exit 6', 'nft add element inet fw4 kid_mac "{ $mac }" || exit 6']
    : ['uci del_list "firewall.@ipset[$k].entry=$ip"', 'uci del_list "firewall.@ipset[$km].entry=$mac"', 'uci commit firewall || exit 5', 'nft delete element inet fw4 kid "{ $ip }" 2>/dev/null', 'nft delete element inet fw4 kid_mac "{ $mac }" 2>/dev/null'];
  return writeRouter([
    `mac=${mac}`,
    'ip=',
    'i=0',
    'while m=$(uci -q get "dhcp.@host[$i].mac"); do',
    '  m=$(echo "$m" | tr A-F a-f)',
    '  case " $m " in *" $mac "*) ip=$(uci -q get "dhcp.@host[$i].ip") ;; esac',
    '  i=$((i + 1))',
    'done',
    '[ -n "$ip" ] || exit 3',
    'k=',
    'km=',
    'i=0',
    'while n=$(uci -q get "firewall.@ipset[$i].name"); do',
    '  if [ "$n" = kid ]; then k=$i; fi',
    '  if [ "$n" = kid_mac ]; then km=$i; fi',
    '  i=$((i + 1))',
    'done',
    '[ -n "$k" ] && [ -n "$km" ] || exit 4',
    ...change,
  ]);
}

// dnsmasq has no per-client policy, so a router allow is one shared file the Kid resolver reads for every Kid device.
function allowRouter(domain, on) {
  const edit = on ? 'grep -qxF "$d" "$f" || echo "$d" >>"$f"' : 'grep -vxF "$d" "$f" >"$f.new"; mv "$f.new" "$f"';
  return writeRouter([`d=${domain}`, 'f="$R/etc/dns-shield/allow"', 'mkdir -p "$R/etc/dns-shield"', 'touch "$f"', edit, '"$R/etc/init.d/dns-shield" reload || exit 7']);
}

// What a person pastes, a URL or a mixed-case host, becomes the bare domain, the way v1's normalize_domain reads it.
function normalize(raw) {
  const d = String(raw || '')
    .toLowerCase()
    .replace(/^https?:\/\//, '')
    .replace(/[/?:].*$/s, '')
    .replace(/^\./, '')
    .replace(/\.$/, '');
  if (!DOMAIN.test(d)) usage('that is not a domain name');
  return d;
}

const OPEN = { '30m': 1800, '2h': 7200 };
const slug = (key) => key.replace(/[^A-Za-z0-9_-]/g, '_');
const openFile = (key) => join(STATE, 'open-' + slug(key));
const timerUnit = (key) => 'dots-dns-open-' + slug(key);

// A timed open is a deadline file, `<epoch> <key>`, which outlives a reboot; the transient timer only makes it end on time while the machine is up.
function deadlines() {
  const out = new Map();
  let names = [];
  try {
    names = readdirSync(STATE).filter((n) => n.startsWith('open-'));
  } catch {}
  for (const n of names) {
    const [until, key] = firstLine(join(STATE, n)).split(' ');
    if (Number(until) > 0 && key && slug(key) === n.slice('open-'.length)) out.set(key, Number(until));
  }
  return out;
}

function clearOpen(key) {
  rmSync(openFile(key), { force: true });
  spawnSync('systemctl', ['--user', 'stop', timerUnit(key) + '.timer'], { stdio: 'ignore', env });
}

const kidAny = (key, on) => (key.path === 'carried' ? kidCarried(key.id, on) : kidRouter(key.id, on));

async function openDevice(key, keyText, secs) {
  await kidAny(key, false);
  save(openFile(keyText), `${Math.floor(Date.now() / 1000) + secs} ${keyText}\n`, 0o600);
  spawnSync('systemctl', ['--user', 'stop', timerUnit(keyText) + '.timer'], { stdio: 'ignore', env });
  spawnSync('systemd-run', ['--user', '--quiet', '--collect', '--unit', timerUnit(keyText), `--on-active=${secs}s`, process.execPath, process.argv[1], 'reconcile'], { stdio: 'ignore', env });
}

// A deadline whose Kid on fails stays for the next reconcile, so a router that is down only delays the end of an open.
async function reconcile() {
  let failed = 0;
  for (const [keyText, until] of deadlines()) {
    if (until > Date.now() / 1000) continue;
    try {
      await kidAny(parseKey(keyText), true);
      clearOpen(keyText);
    } catch (e) {
      if (!(e instanceof Failure)) throw e;
      failed++;
      process.stderr.write(`dots-dns: ${keyText}: ${e.message}\n`);
    }
  }
  if (failed) throw new Failure(`${failed} timed open could not end yet`);
}

async function leases() {
  const r = await routerRead(Math.floor(Date.now() / 1000));
  if (!r.ok) throw new Failure(r.error);
  return JSON.stringify(r.leases) + '\n';
}

const sq = (v) => "'" + v.replace(/'/g, "'\\''") + "'";

// OpenWrt hands a reservation's name to dnsmasq as a DNS host name, so the name to show lives in its own option and `name` is a safe slug.
async function addDevice(mac, name) {
  const host = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 32) || 'device-' + mac.slice(-5).replace(':', '');
  await writeRouter([
    `mac=${mac}`,
    'ip=$(awk -v m="$mac" \'tolower($2) == m { print $3; exit }\' "$R/tmp/dhcp.leases")',
    '[ -n "$ip" ] || exit 9',
    'i=0',
    'while m=$(uci -q get "dhcp.@host[$i].mac"); do',
    '  m=$(echo "$m" | tr A-F a-f)',
    '  case " $m " in *" $mac "*) exit 8 ;; esac',
    '  i=$((i + 1))',
    'done',
    'uci add dhcp host >/dev/null',
    `uci set "dhcp.@host[-1].name=${host}"`,
    `uci set dhcp.@host[-1].dns_shield_name=${sq(name)}`,
    'uci set "dhcp.@host[-1].mac=$mac"',
    'uci set "dhcp.@host[-1].ip=$ip"',
    'uci commit dhcp || exit 5',
    '"$R/etc/init.d/dnsmasq" reload || exit 10',
  ]);
  await kidRouter(mac, true);
}

const USAGE = 'usage: dots-dns state | profiles | profile <key> | kid <key> on|off | category <key> youtube|social|adult|gambling on|off | allow|unallow <key> <domain> | open <key> 30m|2h | reconcile | leases | add <mac> <name>';

function usage(why = USAGE) {
  process.stderr.write((why === USAGE ? '' : 'dots-dns: ') + why + '\n');
  process.exit(2);
}

function parseKey(key) {
  const m = typeof key === 'string' && key.match(/^(carried):([A-Za-z0-9_-]{1,64})$|^(router):([0-9a-f]{2}(?::[0-9a-f]{2}){5})$/);
  if (!m) usage();
  return m[1] ? { path: 'carried', id: m[2] } : { path: 'router', id: m[4] };
}

function carriedKey(key) {
  const k = parseKey(key);
  if (k.path !== 'carried') usage('a router device has no profile');
  return k.id;
}

function onOff(v) {
  if (v !== 'on' && v !== 'off') usage();
  return v === 'on';
}

// Every write holds v1's flock file, so dots-dns and dns-filter never interleave a read-modify-write; the run starts itself again under flock(1).
function holdLock() {
  if (env.DOTS_DNS_LOCK_HELD === '1') return;
  mkdirSync(STATE, { recursive: true });
  const r = spawnSync('flock', ['-w', '30', '-E', '75', join(STATE, 'lock'), process.execPath, process.argv[1], ...process.argv.slice(2)], { stdio: 'inherit', env: { ...env, DOTS_DNS_LOCK_HELD: '1' } });
  if (r.error) throw new Failure('flock is not installed');
  if (r.status === 75) throw new Failure('another dots-dns or dns-filter run holds the lock');
  process.exit(r.status === null ? 1 : r.status);
}

async function write(verb, args) {
  const key = parseKey(args[0]);
  let run;
  if (verb === 'kid') {
    const on = onOff(args[1]);
    run = async () => {
      await kidAny(key, on);
      clearOpen(args[0]);
    };
  } else if (verb === 'open') {
    const secs = OPEN[args[1]];
    if (!secs) usage();
    run = () => openDevice(key, args[0], secs);
  } else if (verb === 'category') {
    if (key.path === 'router') usage('router devices carry one Kid policy');
    if (!CATS.includes(args[1])) usage();
    const on = onOff(args[2]);
    run = () => writeCarried(key.id, (dev) => setCategory(dev, args[1], on));
  } else {
    const domain = normalize(args[1]);
    const on = verb === 'allow';
    run = () => (key.path === 'carried' ? allowCarried(key.id, domain, on) : allowRouter(domain, on));
  }
  holdLock();
  await run();
  return '';
}

async function main() {
  const [verb, ...args] = process.argv.slice(2);
  let out;
  try {
    if (verb === 'state') out = await state();
    else if (verb === 'reconcile') {
      holdLock();
      await reconcile();
      out = '';
    } else if (verb === 'leases') out = await leases();
    else if (verb === 'add') {
      const mac = String(args[0] || '').toLowerCase();
      const name = clean(args[1]).slice(0, 40);
      if (!MAC.test(mac) || !name) usage();
      holdLock();
      await addDevice(mac, name);
      out = '';
    }
    else if (verb === 'profiles') out = await profiles();
    else if (verb === 'profile') out = await profile(carriedKey(args[0]));
    else if (['kid', 'category', 'allow', 'unallow', 'open'].includes(verb)) out = await write(verb, args);
    else usage();
  } catch (e) {
    if (!(e instanceof Failure)) throw e;
    process.stderr.write(`dots-dns: ${e.message}\n`);
    process.exit(1);
  }
  process.stdout.write(out);
}

main();
