#!/usr/bin/env bash
# Usage: imapnotify-wait CONFIG. Returns once CONFIG's passwordCMD decrypts with no prompt, so a locked gpg-agent at login never draws pinentry; the mail-sync timer is the one place that asks.
set -uo pipefail
{
cmd=$(sed -n 's/^ *passwordCMD: *"\(.*\)" *$/\1/p' "$1")
[[ -n $cmd ]] || { echo "imapnotify-wait: no passwordCMD in $1" >&2; exit 1; }
# pass hands these to gpg, which then fails on an uncached passphrase instead of asking for it.
export PASSWORD_STORE_GPG_OPTS=--pinentry-mode=error
# The password goes to /dev/null, since this unit's output lands in the journal.
until bash -o pipefail -c "$cmd" >/dev/null 2>&1; do
  sleep "${IMAPNOTIFY_WAIT_SECONDS:-30}"
done
exit 0
}
