#!/usr/bin/env bash
# dots secrets: iCloud, then the Dropbox remote and age key, ~/.ssh, GPG, the pass store and the files rendered from pass; each step skips when its result exists.
set -euo pipefail

die() {
  echo "dots: $*" >&2
  exit 1
}

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
config=${XDG_CONFIG_HOME:-$HOME/.config}
store=${PASSWORD_STORE_DIR:-$HOME/.password-store}
tmp=$(mktemp -d)
# shellcheck disable=SC2064 # the temp dir is fixed now
trap "rm -rf '$tmp'" EXIT

# install_new <file> <mode>: moves $tmp/new over <file> only when it differs, so a second run leaves the file and its mtime alone.
install_new() {
  if cmp -s "$tmp/new" "$1"; then
    rm -f "$tmp/new"
    return
  fi
  mkdir -p "$(dirname "$1")"
  chmod "$2" "$tmp/new"
  mv -f "$tmp/new" "$1"
  echo "dots: wrote $1"
}

secret() {
  pass show "$1" 2>/dev/null | sed -n 1p
}

remotes=$(timeout 30 rclone listremotes 2>/dev/null) || true
grep -qxF 'iCloud:' <<<"$remotes" ||
  die "no iCloud: remote. Next: rclone config, add a remote named iCloud, then dots secrets again"
timeout 90 rclone lsf iCloud: --max-depth 1 >/dev/null 2>&1 ||
  die "iCloud: is unreachable or its session expired. Next: rclone config reconnect iCloud:"

# Only the [Dropbox] section travels: the [iCloud] one holds the Apple ID password, obscured reversibly.
if ! grep -qxF 'Dropbox:' <<<"$remotes"; then
  rclone copyto iCloud:rclone/dropbox.conf "$tmp/dropbox.conf" || die "could not fetch iCloud:rclone/dropbox.conf"
  if [[ $(head -n 1 "$tmp/dropbox.conf") != '[Dropbox]' ]] || grep -q '^\[iCloud\]' "$tmp/dropbox.conf"; then
    die "iCloud:rclone/dropbox.conf is not a lone [Dropbox] section"
  fi
  conf=$(rclone config file | tail -n 1)
  mkdir -p "$(dirname "$conf")"
  # A [Dropbox] glued onto a last line with no newline would corrupt both sections.
  [[ ! -s $conf || -z $(tail -c 1 "$conf") ]] || echo >>"$conf"
  cat "$tmp/dropbox.conf" >>"$conf"
  chmod 600 "$conf"
  rclone listremotes | grep -xF 'Dropbox:' >/dev/null || die "appended [Dropbox] to $conf, but rclone does not list it"
  echo "dots: Dropbox: remote restored"
fi

# The age key comes from iCloud and the ssh blob from Dropbox, so one account alone opens neither.
key=$config/chezmoi/key.txt
if [[ ! -f $key ]]; then
  mkdir -p "$config/chezmoi"
  rclone copyto iCloud:chezmoi/key.txt "$tmp/key.txt" || die "could not fetch iCloud:chezmoi/key.txt"
  chmod 600 "$tmp/key.txt"
  mv "$tmp/key.txt" "$key"
  echo "dots: age key restored"
fi

# known_hosts is each machine's own, so a ~/.ssh holding only that still pulls the blob.
if [[ -z $(find "$HOME/.ssh" -type f ! -name 'known_hosts*' 2>/dev/null) ]]; then
  "$here/dots-sync" --only ssh || die "dots sync --only ssh could not restore ~/.ssh"
  [[ -n $(find "$HOME/.ssh" -type f ! -name 'known_hosts*' 2>/dev/null) ]] || die "$HOME/.ssh is still empty after dots sync --only ssh"
  echo "dots: ~/.ssh restored"
fi

# gpg --import exits 0 having imported only the public key when pinentry fails, so the secret key is checked by fingerprint.
if ! gpg --list-secret-keys --with-colons 2>/dev/null | grep -q '^sec'; then
  rclone copy iCloud:GPG-Backup "$tmp/gpg" --include 'gpg-secret-*.asc' || die "could not fetch iCloud:GPG-Backup"
  asc=$(find "$tmp/gpg" -name 'gpg-secret-*.asc' | sort | head -n 1)
  [[ -n $asc ]] || die "no gpg-secret-*.asc in iCloud:GPG-Backup"
  fpr=$(gpg --with-colons --import-options show-only --import "$asc" 2>/dev/null | awk -F: '/^fpr/ {print $10; exit}')
  gpg --import "$asc" || true
  gpg --list-secret-keys "$fpr" >/dev/null 2>&1 || die "no secret key for $fpr after the import; wrong passphrase, or pinentry could not prompt"
  # An imported key starts with unknown ownertrust, and pass then refuses to encrypt to it.
  echo "$fpr:6:" | gpg --import-ownertrust
  echo "dots: GPG key $fpr imported"
fi

if [[ ! -d $store/.git ]]; then
  git clone --quiet "${DOTS_PASS_REPO:-git@github.com:saifulapm/password-store.git}" "$store" ||
    die "could not clone the password store; is this machine's ssh key on GitHub?"
  echo "dots: password store cloned"
fi

# gh's own login checks the token over the network; its multi-account hosts.yml takes the PATs without that.
personal=$(secret github/cli-token) || die "no github/cli-token in pass"
lareys=$(secret github/cli-token-lareysbd) || die "no github/cli-token-lareysbd in pass"
hosts=${GH_CONFIG_DIR:-$config/gh}/hosts.yml
active=$(sed -n 's/^    user: //p' "$hosts" 2>/dev/null) || true
[[ $active == lareysbd ]] || active=saifulapm
token=$personal
[[ $active == lareysbd ]] && token=$lareys
cat >"$tmp/new" <<EOF
github.com:
    users:
        saifulapm:
            oauth_token: $personal
        lareysbd:
            oauth_token: $lareys
    oauth_token: $token
    user: $active
EOF
install_new "$hosts" 600

ctx7=$(secret AI/context7/main) || die "no AI/context7/main in pass"
jq -n --arg t "$ctx7" '{access_token: $t, token_type: "Bearer"}' >"$tmp/new"
install_new "$config/context7/credentials.json" 600

# A machine without the hub's entries in pass runs no local hub, so it gets no local.env.
if peer=$(secret workflow/hub-peer-token) && [[ -n $peer ]]; then
  hub=$HOME/.config/hub/local.env
  {
    echo "HUB_PEER_TOKEN=$peer"
    v=$(secret workflow/slack-bot-token) && echo "SLACK_BOT_TOKEN=$v"
    v=$(secret workflow/slack-app-token) && echo "SLACK_APP_TOKEN=$v"
    v=$(secret workflow/slack-user-id || secret dulali/slack-user-id) && echo "SLACK_USER_ID=$v"
    v=$(secret workflow/hub-cloud-token) && echo "HUB_CLOUD_TOKEN=$v"
    v=$(secret workflow/cloud-next-access-id) && echo "HUB_STORE_ACCESS_ID=$v"
    v=$(secret workflow/cloud-next-access-secret) && echo "HUB_STORE_ACCESS_SECRET=$v"
    # The store's URL, name and machine token are workflow switch's lines, so they stay as they were.
    [[ -f $hub ]] && grep -Ev '^(HUB_PEER_TOKEN|SLACK_BOT_TOKEN|SLACK_APP_TOKEN|SLACK_USER_ID|HUB_CLOUD_TOKEN|HUB_STORE_ACCESS_ID|HUB_STORE_ACCESS_SECRET)=' "$hub"
  } >"$tmp/new" || true
  install_new "$hub" 600
fi

echo "dots: secrets in place"
