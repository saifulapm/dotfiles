#!/usr/bin/env bash
# The shell draws with Vulkan through the GPU's own driver only: GL's gallium and libLLVM cost 56 MiB of RSS, and every installed Vulkan driver 40 ms of start-up.
{
node=${DOTS_RENDER_NODE:-/sys/class/drm/renderD128}
driver=$(readlink "$node/device/driver")
# An unknown GPU keeps GL.
case ${driver##*/} in
asahi) export QSG_RHI_BACKEND=vulkan VK_LOADER_DRIVERS_SELECT='asahi_icd*' ;;
i915 | xe) export QSG_RHI_BACKEND=vulkan VK_LOADER_DRIVERS_SELECT='intel*' ;;
esac
exec qs "$@"
exit
}
