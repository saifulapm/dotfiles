#!/usr/bin/env bash
# The nearest .php-version up from $PWD picks Remi's /usr/bin/phpXY; none means the system php.
set -u
{

ver=""
dir="$PWD"
while :; do
  if [ -f "$dir/.php-version" ]; then
    read -r ver <"$dir/.php-version" || true
    break
  fi
  [ "$dir" = / ] && break
  dir="$(dirname "$dir")"
done

mm="$(grep -oE '^[0-9]+\.[0-9]+' <<<"$ver" || true)"
if [ -n "$mm" ]; then
  scl="/usr/bin/php${mm//./}"
  if [ -x "$scl" ]; then
    exec "$scl" "$@"
  fi
  sys="$(/usr/bin/php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')"
  [ "$sys" != "$mm" ] \
    && echo "php shim: $dir/.php-version wants $mm but /usr/bin/php${mm//./} is not installed — using system $sys (chezmoi apply installs the Remi SCLs)" >&2
fi
exec /usr/bin/php "$@"
exit
}
