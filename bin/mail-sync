#!/usr/bin/env bash
# mail-sync — pull mail, index it, let the routing engine sort it.
#
# The single entry point for "get mail now", called from three places:
#   * imapnotify-icloud.service, within ~1s of iCloud announcing new mail
#   * mail-sync.timer, every 15 min, as the fallback for a dead IDLE session
#   * by hand, and from Emacs (`G` in notmuch), when you are impatient
#
# All three run the same two commands in the same order. The interesting work
# is not here — it is in ~/.config/notmuch/hooks/post-new, which turns freshly
# indexed mail into mail that is already in the right HEY box.
#
# Usage: mail-sync [--quiet]

set -uo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hey-mail"
LOG="$STATE/sync.log"
LOCK="$STATE/sync.lock"
mkdir -p "$STATE"

quiet=0
[ "${1:-}" = "--quiet" ] && quiet=1

log() {
    printf '%s mail-sync: %s\n' "$(date -Is)" "$*" >>"$LOG"
    [ "$quiet" -eq 1 ] || printf 'mail-sync: %s\n' "$*"
}

if [ -f "$LOG" ] && [ "$(stat -c%s "$LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
    tail -n 2000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

# IDLE and the timer WILL overlap — that is the normal case, not the edge one:
# a burst of arriving mail fires imapnotify repeatedly while the 15-minute
# timer keeps its own schedule. Two mbsync processes on one maildir corrupt
# the sync state, so the second caller simply leaves. Nothing is lost by
# giving up: whatever the running sync is about to fetch includes the mail
# this invocation was called for.
exec 9>"$LOCK"
if ! flock -n 9; then
    log "another sync is running — skipping"
    exit 0
fi

command -v mbsync >/dev/null 2>&1 || { log "mbsync not installed"; exit 1; }
command -v notmuch >/dev/null 2>&1 || { log "notmuch not installed"; exit 1; }

# gpg-agent holds the passphrase that unlocks the pass entry mbsync and msmtp
# read. Its socket lives in the runtime dir and is reachable from a user unit,
# but a LOCKED agent needs pinentry-qt, which needs the Wayland display — so a
# sync that fires while the agent's cache has expired pops a passphrase dialog
# rather than failing. That is the intended behaviour (it is the same prompt
# browserpass causes), and it is why these units are session-tied: outside a
# graphical session there would be nowhere to draw it.
start=$(date +%s)

if ! mbsync -c "$HOME/.mbsyncrc" icloud >>"$LOG" 2>&1; then
    # Deliberately not fatal. iCloud drops IMAP connections mid-fetch under
    # load, and mbsync exits nonzero having still written most of what it
    # fetched. Indexing what DID land beats discarding a partial sync, and the
    # next run resumes from the sync state.
    log "mbsync exited nonzero — indexing what landed anyway"
fi

# `notmuch new` runs the post-new hook, which does the HEY routing, publishes
# the bar counts, refreshes Emacs and raises the notification.
if ! notmuch new --quiet >>"$LOG" 2>&1; then
    log "notmuch new failed"
    exit 1
fi

# ── phone parity: tags -> IMAP folders ──────────────────────────────────────
# Everything above this line is the mailbox as Emacs sees it. What follows is
# the only part the iPhone can see, because IMAP has folders and no tags: mail
# that is not screened-in Imbox mail is moved OUT of INBOX, which is what makes
# the Screener's promise ("an unscreened stranger cannot buzz you") hold on a
# device that only raises notifications for INBOX.
#
# HERE and not in the post-new hook, and the ordering is the whole reason:
#
#   notmuch new      the hook settles the TAGS (routing, sweeps, counts)
#   folder sync      reads those tags and moves FILES; notmuch's index is now
#                    stale, pointing at filenames that no longer exist
#   notmuch new      teaches notmuch the new names — a rename, not an arrival,
#                    so no new.tags and no second notification
#   mbsync           pushes the moves up, but only if there were any
#
# A post-new hook cannot do this itself: it would have to call `notmuch new` to
# repair the index it just invalidated, and that re-enters the hook. Leaving
# the reindex to the next sync is worse still — for up to fifteen minutes
# (the timer interval) Emacs would be unable to open a moved message.
#
# The second `notmuch new` deliberately runs the full hook rather than
# --no-hooks: the folder sync's reverse pass converts folder moves made on the
# phone into tags, so the bar counts published by the first pass can be out of
# date by the time this line is reached. Re-running is cheap and cannot double
# up on notifications — every step in the hook is scoped to `tag:new`, and
# there is none left by now.
FOLDER_SYNC="$(dirname "$(readlink -f "$0")")/hey-folder-sync"
if [ -x "$FOLDER_SYNC" ]; then
    # HEY_SYNC_LOCKED: this process already holds the sync lock on fd 9, which
    # the child inherits. Without the marker the child would try to take it
    # again on a new descriptor and wait five minutes for itself.
    # Two numbers back: messages moved, and boxes newly created. They are not
    # the same question. Only a MOVE invalidates notmuch's index, so only a
    # move needs the reindex; but a box created because a line was just added
    # to foldersync.db needs the push just as much, or the folder stays
    # invisible on the phone until the next sync happens along — and you cannot
    # drag a mail into a folder that is not there.
    read -r moved created <<<"$(HEY_SYNC_LOCKED=1 "$FOLDER_SYNC" --apply 2>>"$LOG")"
    case "${moved:-}"   in ''|*[!0-9]*) moved=0 ;; esac
    case "${created:-}" in ''|*[!0-9]*) created=0 ;; esac

    if [ "$moved" -gt 0 ]; then
        log "folder sync: moved $moved message(s) between IMAP folders"
        notmuch new --quiet >>"$LOG" 2>&1 || log "reindex after folder sync failed"
    fi
    [ "$created" -gt 0 ] && log "folder sync: created $created new box(es)"
    if [ $((moved + created)) -gt 0 ]; then
        # Push straight away rather than waiting for the next arrival. A
        # stranger sitting in the server's INBOX for fifteen minutes is a
        # stranger who is still in the phone's inbox for fifteen minutes, and
        # the point of all this was that they should not be there at all.
        mbsync -c "$HOME/.mbsyncrc" icloud >>"$LOG" 2>&1 \
            || log "mbsync push after folder sync exited nonzero — retried next sync"
    fi
fi

log "done in $(( $(date +%s) - start ))s"
exit 0
