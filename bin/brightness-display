#!/usr/bin/env bash
# brightness-display — show or adjust brightness on the focused display,
# whatever kind it is. Port of omarchy-brightness-display (CREDITS.md):
# internal panels go through brightnessctl's backlight class, anything else
# through DDC/CI (bin/brightness-display-ddc). This is what makes the Mac
# mini's HDMI monitor adjustable at all — it has no backlight device.
#
#   brightness-display [--no-osd] [--monitor name] [+N%|N%-|N%]
#
# No step prints the current percentage. Their Apple Studio/XDR branch
# (asdcontrol) is not ported: Fedora doesn't package it and no such display
# exists here — if one appears, that branch slots in beside the DDC check.
# Their off/on DPMS verbs aren't either; the lid/idle path owns DPMS here.

no_osd=0
monitor=""

while (($# > 0)); do
  case "$1" in
  --no-osd)
    no_osd=1
    shift
    ;;
  --monitor)
    (($# >= 2)) || exit 1
    monitor="$2"
    shift 2
    ;;
  *)
    break
    ;;
  esac
done

backlight_brightness() {
  brightnessctl --class=backlight -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4; found=1 } END{ exit !found }'
}

[[ -n $monitor ]] || monitor="$(niri msg --json focused-output 2>/dev/null | jq -r '.name // empty')"

monitor_is_internal() {
  [[ $monitor =~ ^(eDP|LVDS|DSI)- ]]
}

# Name-only, like upstream: an external connector goes DDC even on a laptop
# whose internal backlight exists — the backlight device says nothing about
# the display currently focused.
use_ddc_display() {
  [[ -n $monitor ]] && ! monitor_is_internal
}

show_osd() {
  ((no_osd)) && return 0
  command -v qs >/dev/null 2>&1 || return 0
  # `show` collides with a qs CLI subcommand — the `--` is load-bearing.
  qs ipc call osd -- show "{\"icon\":\"brightness\",\"value\":$1,\"progressText\":\"$1%\"}" >/dev/null 2>&1 || true
}

if (($# == 0)); then
  if use_ddc_display; then
    brightness-display-ddc "$monitor"
    exit
  fi
  backlight_brightness
  exit
fi

step="$1"

# Drop overlapping brightness key events so concurrent invocations don't race
# (hardware key repeat can otherwise glitch the OSD) — their flock, kept.
exec {lock_fd}>"${XDG_RUNTIME_DIR:-/tmp}/qshell-brightness-display.lock"
flock -n "$lock_fd" || exit 0

if use_ddc_display; then
  brightness="$(brightness-display-ddc "$monitor" "$step")" || exit 1
  show_osd "$brightness"
else
  current=$(backlight_brightness) || exit 1

  # Non-uniform steps near the floor: 1% moves at or below 5%, and absolute
  # targets above it so raw backlight rounding can't drift the OSD steps.
  if [[ $step == "+5%" ]]; then
    if ((current < 5)); then
      ((target = current + 1))
    else
      ((target = current + 5))
    fi

    ((target > 100)) && target=100
    step="$target%"
  elif [[ $step == "5%-" ]]; then
    if ((current <= 5)); then
      ((target = current - 1))
    else
      ((target = current - 5))
    fi

    ((target < 1)) && target=1
    step="$target%"
  fi

  brightnessctl --class=backlight set "$step" >/dev/null || exit 1
  show_osd "$(backlight_brightness)"
fi
