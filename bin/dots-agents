#!/usr/bin/env bash
# dots-agents <muted> <alert> <ink>, colours as hex without # since tmux runs it with sh, where # starts a comment: amx statusline's ✽N working and ⚠N waiting as the tmux bar's words, then the margin's separator; nothing when no agent needs mentioning.
set -uo pipefail
{
muted=#$1 alert=#$2 ink=#$3
command -v amx >/dev/null || exit 0
working='' waiting=''
for part in $(amx statusline 2>/dev/null); do
  case $part in
    ✽*) working=${part#✽} ;;
    ⚠*) waiting=${part#⚠} ;;
  esac
done
[[ -n $working || -n $waiting ]] || exit 0
work="working" wait="#[fg=$alert]● #[fg=$ink]$waiting waiting" sep='   ' end='   '
line=''
[[ -n $working ]] && line="#[fg=$muted]$working $work"
[[ -n $waiting ]] && line="${line:+$line$sep}$wait"
printf '%s' "$line#[fg=$muted]$end"
exit
}
