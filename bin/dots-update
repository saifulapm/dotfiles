#!/usr/bin/env bash
# dots update: pull the repo, dnf upgrade, chezmoi apply, mise up, claude update, then one summary line.
set -euo pipefail

die() {
  echo "dots: $*" >&2
  exit 1
}

# Packages are compared by name.arch, so the count does not depend on dnf's output format.
installed() { rpm -qa --qf '%{NAME}.%{ARCH} %{VERSION}-%{RELEASE}\n' | sort; }

# A booted kernel older than the newest installed one of its flavour (+16k on Asahi), or a niri whose binary dnf replaced, takes effect only after a reboot; only tests move the modules dir.
reboot_needed() {
  local running arch flavour d newest pid
  running=$(uname -r)
  arch=$(uname -m)
  flavour=${running##*."$arch"}
  newest=$(for d in "${DOTS_MODULES_DIR:-/usr/lib/modules}"/*; do
    d=${d##*/}
    [[ $d == *."$arch"* && ${d##*."$arch"} == "$flavour" ]] && echo "$d"
  done | sort -V | tail -n 1)
  [[ -n $newest && $newest != "$running" ]] && return 0
  for pid in $(pgrep -x niri); do
    [[ $(readlink "/proc/$pid/exe") == *" (deleted)" ]] && return 0
  done
  return 1
}

main() {
  local repo tmp
  repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
  tmp=$(mktemp -d -t dots-update-XXXX)

  git -C "$repo" pull --ff-only || die "git pull failed"

  # The only sudo that may prompt; every later root command uses sudo -n.
  sudo -v || die "sudo failed"
  # A killed update runs no trap, so the keepalive checks it is still alive before each renewal; only tests change the tick.
  while sleep "${DOTS_SUDO_TICK:-50}" && kill -0 $$ 2>/dev/null; do sudo -n -v || exit; done >/dev/null 2>&1 &
  # shellcheck disable=SC2064 # the keepalive pid and tmp are fixed now
  trap "kill $! 2>/dev/null; sudo -k; rm -rf '$tmp'" EXIT

  installed >"$tmp/before" || die "rpm query failed"
  sudo -n dnf upgrade -y || die "dnf upgrade failed"
  installed >"$tmp/after" || die "rpm query failed"

  chezmoi apply | tee "$tmp/chezmoi" || die "chezmoi apply failed"

  # A failed mise up is named and stops nothing, like the claude update below.
  local mise=''
  mise up || mise=' · mise: update failed'

  # Claude Code's own updater is off in its settings, so its updates come from here; a failed one is named and stops nothing.
  local claude='' was now
  if command -v claude >/dev/null; then
    was=$(claude --version 2>/dev/null | cut -d' ' -f1)
    if claude update; then
      now=$(claude --version 2>/dev/null | cut -d' ' -f1)
      if [[ $now != "$was" ]]; then claude=" · claude: $was → $now"; fi
    else
      claude=' · claude: update failed'
    fi
  fi

  local upgraded pins
  upgraded=$(comm -13 "$tmp/before" "$tmp/after" | wc -l)
  pins=$(grep -c '^dots: pin [^ ]* [^ ]*$' "$tmp/chezmoi" || true)
  echo "dnf: $upgraded upgraded · pins: $pins changed$mise$claude$(reboot_needed && echo ' · reboot: needed')"
}

# git pull can rewrite this file while bash reads it, so main runs and exits on one line.
main "$@"; exit
