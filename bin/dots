#!/usr/bin/env bash
# dots install runs before the repo is cloned (curl ... | bash -s install), so it reads nothing from its own path.
set -euo pipefail

die() {
  echo "dots: $*" >&2
  exit 1
}

install() {
  local repo=${DOTS_REPO:-https://github.com/saifulapm/dotfiles.git}
  local branch=${DOTS_BRANCH:-v2}
  local dir=$HOME/Codes/dotfiles

  # The only sudo that may prompt; every later root command uses sudo -n.
  sudo -v || die "sudo failed"
  # A killed install runs no trap, so the keepalive checks it is still alive before each renewal.
  while sleep 50 && kill -0 $$ 2>/dev/null; do sudo -n -v || exit; done >/dev/null 2>&1 &
  # shellcheck disable=SC2064 # the keepalive pid is fixed now
  trap "kill $! 2>/dev/null" EXIT

  local missing=() p
  for p in git chezmoi; do rpm -q --quiet "$p" || missing+=("$p"); done
  if ((${#missing[@]})); then
    sudo -n dnf -y install "${missing[@]}" || die "dnf could not install ${missing[*]}"
  fi

  if [[ ! -e $dir ]]; then
    mkdir -p "${dir%/*}"
    git clone --branch "$branch" "$repo" "$dir" || die "could not clone $repo ($branch)"
  fi

  # chezmoi init rewrites its config and state db, so it runs only until the config names this repo.
  local config=${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/chezmoi.toml
  if grep -qxF 'sourceDir = "~/Codes/dotfiles"' "$config" 2>/dev/null; then
    chezmoi apply || die "chezmoi apply failed"
  else
    local args=()
    [[ -n ${DOTS_MACHINE:-} ]] && args+=(--promptString "machine=$DOTS_MACHINE")
    chezmoi init --apply --source "$dir" "${args[@]}" || die "chezmoi apply failed"
  fi

  cat <<'EOF'
dots: installed. Next:
  dots secrets
  sudo tailscale up --operator=$USER
  reboot
EOF
}

# Pids of the processes named $1 that run on this Wayland display, so a nested session never reaches the live one.
session_pids() {
  local pid
  for pid in $(pgrep -x "$1"); do
    grep -qzxF "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" "/proc/$pid/environ" 2>/dev/null && echo "$pid"
  done
}

reload_foot() {
  local foot child pts
  for foot in $(session_pids foot); do
    for child in $(pgrep -P "$foot"); do
      pts=$(readlink "/proc/$child/fd/0" 2>/dev/null) || continue
      [[ $pts == /dev/pts/* ]] && cat "$1/foot.osc" >"$pts"
    done
  done
}

reload_kak() {
  local pid session sessions
  sessions=$(kak -l 2>/dev/null) || return 0
  for pid in $(session_pids kak); do
    # A server without -s is named by its pid.
    session=$(tr '\0' '\n' <"/proc/$pid/cmdline" | sed -n '/^-s$/{n;p;q}')
    session=${session:-$pid}
    grep -qxF "$session" <<<"$sessions" && echo 'colorscheme dots' | kak -p "$session"
  done
}

# helix rereads its config, and with it the dots theme file, on USR1.
reload_helix() {
  local pid
  for pid in $(session_pids hx); do
    kill -USR1 "$pid" 2>/dev/null
  done
  return 0
}

# Each mpv opens $XDG_RUNTIME_DIR/mpv-<pid>.sock (scripts/dots-ipc.lua); a killed one leaves its socket behind, which goes here.
reload_mpv() {
  local dir=${XDG_RUNTIME_DIR:-/run/user/$UID} sock pid
  for sock in "$dir"/mpv-*.sock; do
    [[ -S $sock ]] || continue
    pid=${sock##*/mpv-}
    pid=${pid%.sock}
    [[ $(cat "/proc/$pid/comm" 2>/dev/null) == mpv ]] || rm -f "$sock"
  done
  for pid in $(session_pids mpv); do
    sock=$dir/mpv-$pid.sock
    [[ -S $sock ]] || continue
    socat -t 0.2 - "UNIX-CONNECT:$sock" <"$1/mpv.ipc" >/dev/null || return 1
  done
}

# Each zathura answers on the session bus by its pid and rereads its zathurarc, and with it the fragment, on SourceConfig.
reload_zathura() {
  local name
  for name in $(busctl --user list --no-legend 2>/dev/null | awk '$1 ~ /^org\.pwmt\.zathura\.PID-/ {print $1}'); do
    busctl --user call "$name" /org/pwmt/zathura org.pwmt.zathura SourceConfig >/dev/null || return 1
  done
}

# Each coding agent's config names the theme file below, and an agent not installed gets no file; cp writes in place, so a watcher on the file itself sees the change.
reload_agents() {
  local home=${DOTS_AGENT_HOME:-$HOME} src dst
  while read -r src dst; do
    [[ -d $home/${dst%%/themes/*} ]] || continue
    cmp -s "$1/$src" "$home/$dst" && continue
    mkdir -p "$(dirname "$home/$dst")" && cp "$1/$src" "$home/$dst" || return 1
  done <<'AGENTS'
claude.json .claude/themes/dots.json
pi.json .pi/agent/themes/dots.json
amx.toml .config/amx/themes/dots.toml
AGENTS
}

theme() {
  local name=${1:-} t0=${DOTS_SWITCH_T0:-} LC_ALL=C
  [[ -n $name ]] || die "usage: dots theme <name>"
  # The name lands in paths, theme-switch.json and the island, so it is checked before anything runs; C keeps [a-z] ASCII.
  [[ $name =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] || die "theme $name: not a theme name"
  # The caller's stamp goes into arithmetic, so only a time in ms from the last minute is taken.
  local now
  now=$(date +%s%3N)
  [[ $t0 =~ ^[0-9]{13}$ ]] && ((now - t0 >= 0 && now - t0 <= 60000)) || t0=$now
  local repo state out from
  repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
  state=${XDG_STATE_HOME:-$HOME/.local/state}/dots
  out=$state/theme-out
  # Two switches at once would leave fragments from both, so they take turns; the fallback to paper already holds the lock.
  if [[ -z ${theme_locked:-} ]]; then
    mkdir -p -m 700 "$state"
    exec 8>"$state/theme.lock"
    flock -w 30 8 || die "theme $name: another switch held the lock for 30 s"
    theme_locked=1
  fi
  from=$(cat "$state/theme" 2>/dev/null || true)
  if ! node "$repo/shell/lib/theme-render.mjs" "$name"; then
    local msg="theme $name: invalid theme.toml"
    [[ -f $repo/themes/$name/theme.toml ]] || msg="theme $name: no such theme"
    [[ $name == paper ]] && exit 1
    theme paper
    # The island shows what the shell finds here for 5 s.
    echo "$msg" >"$out/notice"
    exit 1
  fi
  echo "$name" >"$state/theme"

  local scheme=prefer-light ui mono
  [[ $(jq -r .mode "$out/shell.json") == dark ]] && scheme=prefer-dark
  { read -r ui; read -r mono; } < <(jq -r '.type.ui, .type.mono' "$out/shell.json")
  local failed
  failed=$(mktemp)
  reload_foot "$out" &
  { tmux has-session 2>/dev/null && { tmux source-file "$out/tmux.conf" || echo tmux >>"$failed"; }; } &
  { command -v kak >/dev/null && reload_kak; } &
  reload_helix &
  { reload_mpv "$out" || echo mpv >>"$failed"; } &
  { reload_zathura || echo zathura >>"$failed"; } &
  { gsettings set org.gnome.desktop.interface color-scheme "$scheme" &&
    gsettings set org.gnome.desktop.interface font-name "$ui 11" &&
    gsettings set org.gnome.desktop.interface monospace-font-name "$mono 11" || echo gsettings >>"$failed"; } &
  { reload_agents "$out" || echo agents >>"$failed"; } &
  wait
  # The island shows the notice for 5 s, so an app left on the old theme is named.
  [[ -s $failed ]] && echo "theme $name: $(sort "$failed" | paste -sd, - | sed 's/,/, /g') did not reload" >"$out/notice"
  rm -f "$failed"
  printf '{"from":"%s","to":"%s","ms":%d}\n' "$from" "$name" $(($(date +%s%3N) - t0)) >"$state/theme-switch.json"
}

main() {
  case ${1:-} in
    install) install ;;
    theme) theme "${2:-}" ;;
    dev) exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/dots-services" "${@:2}" ;;
    sync | update | bump | secrets | cutover | claude-account | dns) exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/dots-$1" "${@:2}" ;;
    *)
      echo "usage: dots install | dots update | dots bump | dots secrets | dots theme <name> | dots cutover | dots claude-account add <label> | use <id> | dots dns <verb> | dots dev [stop <name>] | dots sync [--only notes|goals|fish|ssh | --adopt local|remote]" >&2
      exit 2
      ;;
  esac
}

# Everything runs from here, so bash has read the whole script before a pipe could cut it short; exit stops it reading on after a git pull rewrote the file.
main "$@"; exit
