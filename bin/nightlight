#!/usr/bin/env bash
# nightlight — the blue-light filter, as one verb.
#
# A thin, opinionated face over sunsetr (packages/manifest.toml [[tool]]
# sunsetr; the daemon is sunsetr.service, its config is seeded by
# run_after_44). sunsetr's own vocabulary is presets, and the three that
# matter here are the schedule and the two overrides that suspend it:
#
#   auto    sunsetr preset default   the geo schedule decides
#   day     sunsetr preset day       held neutral, 6500K
#   night   sunsetr preset night     held warm, 3300K
#
# The presets live in ~/.config/sunsetr/presets/{day,night}/sunsetr.toml and
# are three lines each (static mode + a temperature + a gamma).
#
#   nightlight [toggle|auto|day|night|status] [--json]
#
# `toggle` is what a keybinding wants and is the one piece of policy here:
# an override of either kind releases back to auto, and auto forces the
# OPPOSITE of what the schedule is currently doing. So the key means "not
# this" — warm evening, one press, neutral; neutral afternoon, one press,
# warm — and a second press always gives the schedule back.
set -uo pipefail

# ~/.cargo/bin is on PATH in fish but not in a bash context (a niri spawn, a
# systemd unit, the shell's Process), and sunsetr lives there.
export PATH="$HOME/.cargo/bin:$PATH"

die() {
  echo "nightlight: $*" >&2
  exit 1
}

command -v sunsetr >/dev/null 2>&1 \
  || die "sunsetr is not installed — it is built by chezmoi's cargo pass (run_after_09-cargo-tools.sh)"

# The daemon holds the gamma; every verb below needs it up. A stopped unit is
# a normal state on a machine that has just booted into a TTY, so start it
# rather than failing. `is-active` covers the socket-less case cheaply.
ensure_running() {
  systemctl --user -q is-active sunsetr.service 2>/dev/null && return 0
  systemctl --user start sunsetr.service 2>/dev/null \
    || die "could not start sunsetr.service — check: systemctl --user status sunsetr"
  # The status IPC is not answerable until the backend is initialized; a
  # preset applied into that window is silently dropped.
  local i
  for i in $(seq 30); do
    sunsetr status --json >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  die "sunsetr.service started but is not answering — check: systemctl --user status sunsetr"
}

# One `status --json` object, or empty when nothing is running. Compact,
# single-line JSON in --follow mode; the one-shot form is pretty-printed, so
# everything here goes through jq rather than reading lines.
state_json() {
  sunsetr status --json 2>/dev/null
}

# "day" | "night" | "" — which override is pinned, if any. sunsetr calls the
# no-override case "default".
active_preset() {
  local preset
  preset="$(jq -r '.active_preset // ""' <<<"$1" 2>/dev/null)"
  [ "$preset" = "default" ] && preset=""
  echo "$preset"
}

# Whether the screen is currently warmed, whatever the reason. Asking the
# temperature rather than the period is deliberate: mid-transition the period
# has already flipped while the display is still halfway there, and the icon
# must follow the glass, not the calendar.
is_warm() {
  local temp day_temp
  temp="$(jq -r '.current_temp // 0' <<<"$1" 2>/dev/null)"
  day_temp="$(sunsetr get day_temp 2>/dev/null | tr -cd '0-9')"
  [ -z "$day_temp" ] && day_temp=6500
  [ "${temp:-0}" -gt 0 ] && [ "$temp" -lt "$day_temp" ]
}

apply_preset() {
  # `preset default` is sunsetr's spelling of "no override".
  sunsetr preset "$1" >/dev/null 2>&1 \
    || die "sunsetr preset $1 failed — check that ~/.config/sunsetr/presets/$1 exists"
}

action="${1:-status}"

case "$action" in
auto | default)
  ensure_running
  apply_preset default
  ;;
day)
  ensure_running
  apply_preset day
  ;;
night)
  ensure_running
  apply_preset night
  ;;
toggle)
  ensure_running
  json="$(state_json)"
  [ -n "$(active_preset "$json")" ] && apply_preset default \
    || { is_warm "$json" && apply_preset day || apply_preset night; }
  ;;
status)
  json="$(state_json)"
  if [ -z "$json" ]; then
    # Not an error: "off" is a legitimate answer, and a bar widget or a
    # status line asking must not get a failing exit for it.
    [ "${2:-}" = "--json" ] && echo '{"running":false}' || echo "off"
    exit 0
  fi
  if [ "${2:-}" = "--json" ]; then
    jq -c '. + {running: true}' <<<"$json"
  else
    preset="$(active_preset "$json")"
    temp="$(jq -r '.current_temp // "?"' <<<"$json")"
    if [ -n "$preset" ]; then
      echo "$preset (held) — ${temp}K"
    else
      is_warm "$json" && echo "auto, warm — ${temp}K" || echo "auto, neutral — ${temp}K"
    fi
  fi
  ;;
*)
  echo "Usage: nightlight [toggle|auto|day|night|status] [--json]" >&2
  exit 1
  ;;
esac
