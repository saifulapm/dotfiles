#!/usr/bin/env bash
# font-set <family> — make <family> the system monospace font.
# font-set          — list installed monospace families (* marks the current).
# font-set --json   — the same list as JSON, for the shell's menu.
#
# Port of omarchy-font-set (MIT, see CREDITS.md). fontconfig is the source of
# truth: this writes a user config that prepends <family> to the `monospace`
# alias, which is what the shell resolves at startup and re-resolves whenever
# this file changes, and what every Qt/GTK app asking for "monospace" gets.
#
# Their script also seds each terminal's own config. Ours doesn't need to:
# templates/ owns those files, so it re-runs bin/theme-apply, which resolves
# an unpinned font.mono through the same alias.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
conf="$HOME/.config/fontconfig/fonts.conf"

current() {
  fc-match -f '%{family[0]}' monospace 2>/dev/null || true
}

# omarchy-font-list, verbatim, plus one addition: fontconfig does not tag
# every monospace face `spacing=100` (Noto Sans Mono, a variable font, is
# missing here) so the family the alias currently resolves to can be absent
# from its own list. Put it in, or the picker cannot show what is active.
list_families() {
  {
    fc-list :spacing=100 -f "%{family[0]}\n" | grep -v -i -E 'emoji|signwriting|omarchy'
    cur="$(current)"
    [[ -n $cur ]] && printf '%s\n' "$cur"
  } | grep -v '^$' | sort -u
}

if [[ $# -eq 0 || ${1:-} == "--json" ]]; then
  cur="$(current)"
  if [[ ${1:-} == "--json" ]]; then
    list_families | python3 -c '
import json, sys
cur = sys.argv[1]
names = [l.rstrip("\n") for l in sys.stdin]
json.dump([{"name": n, "current": n == cur} for n in names], sys.stdout)
' "$cur"
  else
    while IFS= read -r n; do
      if [[ $n == "$cur" ]]; then echo "* $n"; else echo "  $n"; fi
    done < <(list_families)
  fi
  exit 0
fi

case "$1" in
-h | --help)
  echo "usage: font-set [<family>]" >&2
  exit 0
  ;;
esac

family="$1"
if ! fc-list | grep -Fqi -- "$family"; then
  echo "font-set: no installed font matches '$family'" >&2
  exit 1
fi

mkdir -p "$(dirname "$conf")"
# Their file, verbatim in shape: loaded after the package-owned default, and
# prepend_first puts the chosen family at the head of the monospace list so it
# beats whatever that default prefers.
cat >"$conf.tmp" <<XML
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend_first" binding="strong">
      <string>$family</string>
    </edit>
  </match>
</fontconfig>
XML
mv "$conf.tmp" "$conf"

# fontconfig re-reads its config per process, so this is not what makes the
# change take — it just keeps the per-directory caches current.
fc-cache >/dev/null 2>&1 || true

resolved="$(current)"
if [[ $resolved != "$family" ]]; then
  echo "font-set: warning: 'monospace' still resolves to '$resolved'" >&2
fi

# Re-render the templated app configs against the new alias. The shell needs
# nothing: it watches fonts.conf.
"$root/bin/theme-apply" >/dev/null

# foot reads its font at startup only — same caveat omarchy notifies about.
if pgrep -x foot >/dev/null 2>&1; then
  notify-send -a qshell "Font set to $family" "Restart foot to see it there." >/dev/null 2>&1 || true
fi

echo "font-set: monospace → $resolved"
