#!/usr/bin/env bash
# just dev's dots-accounts: prints the collector's rows for two Claude accounts and the other providers, so a nested check never reaches a provider or pass. Each call appends its arguments as one line to DOTS_DEV_DIR/accounts.log; --cached prints the same rows fetched two hours before. A file DOTS_DEV_DIR/accounts-near-full puts main at 92% and 79% and makes a full fetch take 3 s, so a check sees the warning and "refreshing…". A file DOTS_DEV_DIR/accounts-offline makes a full fetch answer as the collector does with no network: every cached row, stale, with its old time. A file DOTS_DEV_DIR/accounts-rows.json is printed as it is for both calls, so a walk can show the real collector's rows or forged ones.
set -euo pipefail
{
dir=${DOTS_DEV_DIR:-${XDG_STATE_HOME:?dev-fake-accounts: run it from a sourced just dev env}}
printf '%s\n' "$*" >>"$dir/accounts.log"
if [ -e "$dir/accounts-rows.json" ]; then
  cat "$dir/accounts-rows.json"
  exit 0
fi

five=34 weekly=61 state=ok reason=null
if [ -e "$dir/accounts-near-full" ]; then
  five=92 weekly=79
  [ "${1:-}" = --cached ] || sleep 3
fi
now=$EPOCHSECONDS
fetched=$now
[ "${1:-}" = --cached ] && fetched=$((now - 7200))
if [ "${1:-}" != --cached ] && [ -e "$dir/accounts-offline" ]; then
  fetched=$((now - 7200)) state=stale reason='"network"'
fi

# Times come from printf's own clock, in local time with its offset, so the cached answer forks nothing and the card reads 17:00 and 16:40 whatever the zone.
iso() {
  local z
  printf -v z '%(%z)T' "$2"
  printf -v "$1" '%(%Y-%m-%dT%H:%M:%S)T%s' "$2" "${z:0:3}:${z:3}"
}
printf -v today '%(%Y-%m-%d)T' "$now"
printf -v z '%(%z)T' "$now"
five_main=${today}T17:00:00${z:0:3}:${z:3}
five_work=${today}T16:40:00${z:0:3}:${z:3}
iso as_of "$fetched"
iso week $((now + 6 * 86400))
iso month $((now + 12 * 86400))
iso codex $((now + 28 * 86400))

rows=()
row() {
  # provider label account metric kind value limit unit resets_at
  local account=null resets=null limit=null out
  [ "$3" = - ] || account="\"$3\""
  [ "$7" = - ] || limit=$7
  [ "$9" = - ] || resets="\"$9\""
  printf -v out '{"provider":"%s","label":"%s","account":%s,"metric":"%s","kind":"%s","value":%s,"limit":%s,"unit":"%s","resets_at":%s,"as_of":"%s","state":"%s","reason":%s}' \
    "$1" "$2" "$account" "$4" "$5" "$6" "$limit" "$8" "$resets" "$as_of" "$state" "$reason"
  rows+=("$out")
}

row claude main main 5-hour percent "$five" 100 % "$five_main"
row claude main main weekly percent "$weekly" 100 % "$week"
row claude main main 'weekly Fable' percent 22 100 % "$week"
row claude work work 5-hour percent 8 100 % "$five_work"
row claude work work weekly percent 12 100 % -
row deepseek-ai DeepSeek - balance money 12.4 - USD -
row openrouter OpenRouter - balance money 3.1 10 USD -
row zenmux ZenMux - balance money 7 - USD -
row vercel 'Vercel AI' - balance money 4.5 - USD -
row fal fal - balance money 18.2 - USD -
row elevenlabs ElevenLabs - characters count 11500 32000 characters "$month"
row codex Codex - monthly percent 0 100 % "$codex"
(IFS=,; printf '[%s]\n' "${rows[*]}")
exit
}
