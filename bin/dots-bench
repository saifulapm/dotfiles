#!/usr/bin/env bash
# The shell times itself: a qs ipc round trip costs tens of ms, too much to time a 16 ms open from here.
{
source "$(dirname "$0")/../tests/dev/lib.sh"

idle_s=${DOTS_BENCH_IDLE_S:-60}

die() {
  echo "bench: $*" >&2
  exit 1
}

layer_up() { niri msg -j layers | jq -e --arg ns "$1" 'any(.[]; .namespace == $ns)' >/dev/null; }
launcher_closed() { launcher_state | jq -e ".open == false" >/dev/null && niri msg -j layers | jq -e 'any(.[]; .namespace == "dots-surfaces" and .keyboard_interactivity == "None")' >/dev/null; }
launcher_state() { timeout 0.5 qs ipc call launcher state 2>/dev/null; }
status_has() { shell_status | jq -e "$1" >/dev/null; }
open_reported() { launcher_state | jq -e ".opens == $1 and (.openMs | type) == \"number\"" >/dev/null; }

# Opens number $1, reads the time the launcher measured, closes it and waits for the keyboard.
open_once() {
  qs ipc call launcher open >/dev/null || die "launcher open failed"
  until_ok 3000 layer_up dots-surfaces || die "dots-surfaces never mapped"
  until_ok 3000 open_reported "$1" || die "open $1 never reported openMs"
  launcher_state | jq -r .openMs
  qs ipc call launcher close >/dev/null
  until_ok 3000 launcher_closed || die "the launcher never gave the keyboard back"
}

picker_reported() { themes_state | jq -e ".opens == $1 and (.openMs | type) == \"number\"" >/dev/null; }
themes_state() { timeout 0.5 qs ipc call themes state 2>/dev/null; }
themes_focus() { themes_state | jq -e --arg k "$1" '.open == ($k == "Exclusive")' >/dev/null && niri msg -j layers | jq -e --arg k "$1" 'any(.[]; .namespace == "dots-surfaces" and .keyboard_interactivity == $k)' >/dev/null; }

# Opens the theme picker number $1 like open_once does the launcher: reads the time the shell measured, closes it and waits for the keyboard.
picker_once() {
  qs ipc call themes open >/dev/null || die "themes open failed"
  until_ok 3000 picker_reported "$1" || die "picker open $1 never reported openMs"
  themes_state | jq -r .openMs
  qs ipc call themes close >/dev/null
  until_ok 3000 themes_focus None || die "the switcher never gave the keyboard back"
}

# A start's first frame and cold open vary by 50 ms run to run, so each budget holds the median of five starts; nothing asks qs before niri lists the paper, since early ipc calls hold a start back 1 to 2 s.
paper_gone() { ! layer_up dots-paper; }
frames=() colds=() picker_colds=()
# lib.sh waits for the warm-up, so even the first start is a fresh one, and each open lands before its shell warms.
for i in 1 2 3 4 5; do
  systemctl --user kill -s KILL "$DOTS_DEV_UNIT"
  until_ok 3000 paper_gone || die "the killed shell's paper never went away"
  until_ok 10000 layer_up dots-paper || die "dots-paper never mapped"
  until_ok 3000 status_has '(.firstFrameMs | type) == "number"' || die "status never reported firstFrameMs"
  frames+=("$(shell_status | jq -r .firstFrameMs)")
  colds+=("$(open_once 1)") || exit 1
  picker_colds+=("$(picker_once 1)") || exit 1
done
echo "     first frames: ${frames[*]}; cold opens: ${colds[*]}; picker cold opens: ${picker_colds[*]}"
median() { printf '%s\n' "$@" | sort -n | sed -n 3p; }
first_frame=$(median "${frames[@]}")
cold=$(median "${colds[@]}")
picker_cold=$(median "${picker_colds[@]}")
sleep 0.3
warm=$(open_once 2) || exit 1
picker_warm=$(picker_once 2) || exit 1

# Pass loads on its open and unloads 30 s after it closes, so the open after that is a cold one.
pass_state() { timeout 0.5 qs ipc call pass state 2>/dev/null; }
pass_is() { pass_state | jq -e "$1" >/dev/null; }
pass_once() {
  qs ipc call pass open >/dev/null || die "pass open failed"
  until_ok 3000 pass_is '.opens == 1 and (.openMs | type) == "number"' || die "pass never reported openMs"
  pass_state | jq -r .openMs
  qs ipc call pass close >/dev/null
  until_ok 3000 pass_is '.drawing == false' || die "pass never closed"
}
pass_once >/dev/null || exit 1
until_ok 35000 pass_is '.loaded == false' || die "pass never unloaded"
pass_cold=$(pass_once) || exit 1
# Its unload Tick would count as a running timer, and the loaded card as memory, in what follows.
until_ok 35000 pass_is '.loaded == false' || die "pass never unloaded"

# The file picker loads on a request and unloads 30 s after it closes, so the request after that opens it cold; socat plays the portal, its connection open until the picker answers.
files_state() { timeout 0.5 qs ipc call picker state 2>/dev/null; }
files_is() { files_state | jq -e "$1" >/dev/null; }
files_once() {
  local request client
  request=$(jq -cn --arg f "$HOME" '{mode: "open", multiple: false, title: "", app: "", folder: $f, name: "", filters: [], filter: 0, accept: ""}')
  { printf '%s\n' "$request"; sleep 10; } | socat - "UNIX-CONNECT:$XDG_RUNTIME_DIR/dots-picker-$WAYLAND_DISPLAY.sock" >/dev/null 2>&1 &
  client=$!
  until_ok 3000 files_is '.opens == 1 and (.openMs | type) == "number"' || die "the file picker never reported openMs"
  files_state | jq -r .openMs
  wtype -k Escape
  until_ok 3000 files_is '.open == false' || die "the file picker never closed"
  kill "$client" 2>/dev/null
}
files_once >/dev/null || exit 1
until_ok 35000 files_is '.loaded == false' || die "the file picker never unloaded"
files_cold=$(files_once) || exit 1
until_ok 35000 files_is '.loaded == false' || die "the file picker never unloaded"

switch_json=$XDG_STATE_HOME/dots/theme-switch.json
theme_index() { themes_state | jq -r --arg n "$1" '.themes | index($n)'; }
selected_is() { themes_state | jq -e --arg t "$1" '.selected == $t' >/dev/null; }
switched_to() { jq -e --arg t "$1" --arg was "$2" '.to == $t and (tojson != $was)' "$switch_json" >/dev/null 2>&1; }

# Through the switcher as a person would, so the time runs from the Enter key to dots theme's last reload.
switch_once() {
  local to=$1 was from delta key
  was=$(jq -c . "$switch_json" 2>/dev/null)
  qs ipc call themes open >/dev/null || die "themes open failed"
  until_ok 3000 themes_focus Exclusive || die "the switcher never took the keyboard"
  from=$(themes_state | jq -r .selected)
  delta=$(($(theme_index "$to") - $(theme_index "$from")))
  key=j
  ((delta < 0)) && key=k delta=$((-delta))
  for ((; delta > 0; delta--)); do wtype "$key"; done
  until_ok 1000 selected_is "$to" || die "the cursor never reached $to"
  wtype -k Return
  until_ok 3000 switched_to "$to" "$was" || die "the switch to $to was never recorded"
  until_ok 3000 themes_focus None || die "the switcher never gave the keyboard back"
  jq -r .ms "$switch_json"
}
# The budget's RSS is read with every surface opened once on the starting theme, before any switch.
qs ipc call themes open >/dev/null || die "themes open failed"
until_ok 3000 themes_focus Exclusive || die "the switcher never took the keyboard"
qs ipc call themes close >/dev/null
until_ok 3000 themes_focus None || die "the switcher never gave the keyboard back"
notifs_focus() { timeout 0.5 qs ipc call notifs state 2>/dev/null | jq -e --arg k "$1" '.open == ($k == "Exclusive")' >/dev/null && niri msg -j layers | jq -e --arg k "$1" 'any(.[]; .namespace == "dots-surfaces" and .keyboard_interactivity == $k)' >/dev/null; }
qs ipc call notifs open >/dev/null || die "notifs open failed"
until_ok 3000 notifs_focus Exclusive || die "the notification centre never took the keyboard"
qs ipc call notifs close >/dev/null
until_ok 3000 notifs_focus None || die "the notification centre never gave the keyboard back"
sheet_focus() { timeout 0.5 qs ipc call cheatsheet state 2>/dev/null | jq -e --arg k "$1" '.open == ($k == "Exclusive")' >/dev/null && niri msg -j layers | jq -e --arg k "$1" 'any(.[]; .namespace == "dots-surfaces" and .keyboard_interactivity == $k)' >/dev/null; }
qs ipc call cheatsheet open >/dev/null || die "cheatsheet open failed"
until_ok 3000 sheet_focus Exclusive || die "the cheat sheet never took the keyboard"
qs ipc call cheatsheet close >/dev/null
until_ok 3000 sheet_focus None || die "the cheat sheet never gave the keyboard back"
host_focus() { niri msg -j layers | jq -e --arg k "$1" 'any(.[]; .namespace == "dots-surfaces" and .keyboard_interactivity == $k)' >/dev/null; }
qs ipc call control open >/dev/null || die "control open failed"
until_ok 3000 host_focus Exclusive || die "Control never took the keyboard"
qs ipc call control close >/dev/null
until_ok 3000 host_focus None || die "Control never gave the keyboard back"
qs ipc call goals open >/dev/null || die "goals open failed"
until_ok 3000 host_focus Exclusive || die "Goals never took the keyboard"
qs ipc call goals close >/dev/null
until_ok 3000 host_focus None || die "Goals never gave the keyboard back"
# The picker opens and closes on one toggle each; nothing records.
qs ipc call record toggle >/dev/null || die "record toggle failed"
until_ok 3000 host_focus Exclusive || die "the region picker never took the keyboard"
qs ipc call record toggle >/dev/null
until_ok 3000 host_focus None || die "the region picker never gave the keyboard back"
# Emoji mode reads its bundled list on first use, so it is opened once too.
qs ipc call launcher mode emoji >/dev/null || die "launcher emoji mode failed"
until_ok 3000 host_focus Exclusive || die "emoji mode never took the keyboard"
qs ipc call launcher close >/dev/null
until_ok 3000 host_focus None || die "emoji mode never gave the keyboard back"
sleep 5
rss_kib=$(shell_status | jq -r .rssKiB) || die "status did not answer after the opens"
# GPU buffers are shmem, which RSS misses, so the unit's cgroup anon+shmem is read at the same moment.
cgroup=$(systemctl --user show -p ControlGroup --value "$DOTS_DEV_UNIT")
[ -n "$cgroup" ] || die "$DOTS_DEV_UNIT has no cgroup"
anon_shmem_kib=$(awk '$1 == "anon" || $1 == "shmem" { b += $2 } END { printf "%d", b / 1024 }' "/sys/fs/cgroup$cgroup/memory.stat") || die "memory.stat of $DOTS_DEV_UNIT unreadable"

start=$(shell_status | jq -r .theme)
switch_max=0
mapfile -t names < <(themes_state | jq -r '.themes[]')
for to in $(node "$(dirname "$0")/../shell/lib/bench.mjs" cycle "$start" "${names[@]}"); do
  ms=$(switch_once "$to") || exit 1
  echo "     switch to $to: $ms ms" >&2
  ((ms > switch_max)) && switch_max=$ms
  # The paper's own transition runs up to 300 ms after dots theme returns.
  sleep 0.4
done

sleep 5
status=$(shell_status) || die "status did not answer after the switches"
switched_kib=$(jq -r .rssKiB <<<"$status")
timers=$(jq -r .timers <<<"$status")

# Files, Dekho and Deen are Apps, each its own qs process, started the way the desktop starts them and closed by window, before the idle window so they cannot skew idle cpu; bench_app <entry qml> <bin> <app id> [walk] sets app_first_frame (median of five), app_rss_kib (largest) and app_left (most left over).
bench_app() {
  local qml=$repo/shell/$1 bin=$repo/bin/$2 appid=$3 walk=${4:-} i kib left
  app_state() { timeout 0.5 qs ipc -p "$qml" call "$appid" state 2>/dev/null; }
  app_is() { app_state | jq -e "$1" >/dev/null 2>&1; }
  app_windows() { niri msg -j windows | jq --arg a "$appid" '[.[] | select(.app_id == $a)] | length'; }
  app_up() { [ "$(app_windows)" = 1 ] && app_is '.firstFrameMs != null'; }
  app_pids() { session_qs_pids "-p $qml"; }
  app_gone() { [ -z "$(app_pids)" ]; }
  local frames=()
  app_rss_kib=0 app_left=0
  for i in 1 2 3 4 5; do
    niri msg action spawn -- "$bin" >/dev/null || die "spawning $2 failed"
    until_ok 5000 app_up || die "$appid never drew its first frame"
    frames+=("$(app_state | jq -r .firstFrameMs)")
    [ -z "$walk" ] || "$walk"
    # Its rows have a second to settle before the memory is read; the largest of the five starts is kept.
    sleep 1
    kib=$(app_state | jq -r .rssKiB) || die "$appid did not report rssKiB"
    [[ $kib =~ ^[0-9]+$ ]] && ((kib > 0)) || die "$appid reported rssKiB '$kib', not a size"
    ((kib > app_rss_kib)) && app_rss_kib=$kib
    niri msg action close-window >/dev/null || die "closing $appid failed"
    until_ok 3000 app_gone || {
      left=$(app_pids | wc -l)
      ((left > app_left)) && app_left=$left
      kill $(app_pids) 2>/dev/null
      sleep 0.3
    }
  done
  echo "     $appid first frames: ${frames[*]}"
  app_first_frame=$(median "${frames[@]}")
}
# Dekho's memory is read with its pictures out: Home's posters, a title with 20 cast faces, then Browse's rows.
dekho_walk() {
  until_ok 3000 app_is '[.rows.series[] | select(.poster.shown)] | length >= 8' || die "Dekho's Home drew no posters"
  wtype -k Shift_L
  wtype jl
  until_ok 1000 app_is '.focus == {"row": "series", "col": 1}' || die "Dekho's cursor never reached The Long Tide"
  wtype -k Return
  until_ok 3000 app_is '.page == "title" and .title.slot.shown and .title.cast[2].face.shown' || die "Dekho's title page drew no faces"
  wtype -k Escape
  until_ok 1000 app_is '.page == "home"' || die "Esc never took Dekho back to Home"
  wtype f
  until_ok 3000 app_is '.page == "browse" and ([.browse.rows[] | select(.poster.shown)] | length) >= 20' || die "Dekho's Browse drew fewer than 20 posters"
}
bench_app dekho.qml dots-dekho dekho dekho_walk
dekho_first_frame=$app_first_frame dekho_rss_kib=$app_rss_kib dekho_left=$app_left
bench_app deen.qml dots-deen deen
deen_first_frame=$app_first_frame deen_rss_kib=$app_rss_kib deen_left=$app_left
bench_app files.qml dots-files files

"$(dirname "$0")/dots" theme blueprint >/dev/null || die "dots theme blueprint failed"
until_ok 3000 status_has '.theme == "blueprint"' || die "the shell never reported blueprint"
# The paper's transition ends 300 ms after the call; idle starts after it.
sleep 1
pid=$(systemctl --user show -p MainPID --value "$DOTS_DEV_UNIT")
# utime and stime are fields 14 and 15; the comm in field 2 is cut off first.
cpu_ticks() { local s; s=$(<"/proc/$pid/stat"); read -ra f <<<"${s##*) }"; echo $((f[11] + f[12])); }
t0=$(cpu_ticks)
sleep "$idle_s"
t1=$(cpu_ticks)
cpu=$(awk -v d=$((t1 - t0)) -v hz="$(getconf CLK_TCK)" -v s="$idle_s" 'BEGIN { printf "%.2f", d / hz / s * 100 }')

node "$(dirname "$0")/../shell/lib/bench.mjs" "$first_frame" "$rss_kib" "$cold" "$warm" "$timers" "$cpu" "$switch_max" "$switched_kib" "$anon_shmem_kib" "$picker_cold" "$picker_warm" "$pass_cold" "$files_cold" "$app_first_frame" "$app_rss_kib" "$app_left" "$dekho_first_frame" "$dekho_rss_kib" "$dekho_left" "$deen_first_frame" "$deen_rss_kib" "$deen_left"
exit
}
