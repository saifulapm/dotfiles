#!/usr/bin/env bash
# The shell times itself: a qs ipc round trip costs tens of ms, too much to time a 16 ms open from here.
{
# The nested session starts in a colorscheme, and the switches go through every one in colorschemes/.
export DOTS_DEV_SCHEME=artboard
source "$(dirname "$0")/../tests/dev/lib.sh"

idle_s=${DOTS_BENCH_IDLE_S:-60}

# With no input the live monitors go off minutes into a run, and the nested session's keys then stall and repeat (m100's bench died on it twice), so they are powered on every 20 s until the bench ends.
if [ -n "$live_niri" ]; then
  (while :; do NIRI_SOCKET="$live_niri" niri msg action power-on-monitors >/dev/null 2>&1; sleep 20; done) 9>&- &
  monitors_pid=$!
fi
cleanup() { [ -z "${monitors_pid:-}" ] || kill "$monitors_pid" 2>/dev/null; }

die() {
  echo "bench: $*" >&2
  exit 1
}

layer_up() { niri msg -j layers | jq -e --arg ns "$1" 'any(.[]; .namespace == $ns)' >/dev/null; }
launcher_closed() { launcher_state | jq -e ".open == false" >/dev/null && niri msg -j layers | jq -e 'any(.[]; .namespace == "dots-surfaces" and .keyboard_interactivity == "None")' >/dev/null; }
launcher_state() { timeout 0.5 qs ipc call launcher state 2>/dev/null; }
status_has() { shell_status | jq -e "$1" >/dev/null; }
open_reported() { launcher_state | jq -e ".opens == $1 and (.openMs | type) == \"number\"" >/dev/null; }

# Opens number $1, reads the time the launcher measured, closes it and waits for the keyboard.
open_once() {
  qs ipc call launcher open >/dev/null || die "launcher open failed"
  until_ok 3000 layer_up dots-surfaces || die "dots-surfaces never mapped"
  until_ok 3000 open_reported "$1" || die "open $1 never reported openMs"
  launcher_state | jq -r .openMs
  qs ipc call launcher close >/dev/null
  until_ok 3000 launcher_closed || die "the launcher never gave the keyboard back"
}

launcher_focus() { launcher_state | jq -e --arg k "$1" '.open == ($k == "Exclusive")' >/dev/null && niri msg -j layers | jq -e --arg k "$1" 'any(.[]; .namespace == "dots-surfaces" and .keyboard_interactivity == $k)' >/dev/null; }

# Opens the launcher's colorscheme mode as open number $1, like open_once: reads the time the launcher measured, closes it and waits for the keyboard.
schemes_once() {
  qs ipc call launcher mode colorschemes >/dev/null || die "launcher colorschemes mode failed"
  until_ok 3000 open_reported "$1" || die "colorschemes open $1 never reported openMs"
  launcher_state | jq -r .openMs
  qs ipc call launcher close >/dev/null
  until_ok 3000 launcher_closed || die "the launcher never gave the keyboard back"
}

# A start's first frame and cold open vary by 50 ms run to run, so each budget holds the median of five starts; nothing asks qs before niri lists the paper, since early ipc calls hold a start back 1 to 2 s.
paper_gone() { ! layer_up dots-paper; }
frames=() colds=() schemes_colds=()
# lib.sh waits for the warm-up, so even the first start is a fresh one, and each open lands before its shell warms.
for i in 1 2 3 4 5; do
  systemctl --user kill -s KILL "$DOTS_DEV_UNIT"
  until_ok 3000 paper_gone || die "the killed shell's paper never went away"
  until_ok 10000 layer_up dots-paper || die "dots-paper never mapped"
  until_ok 3000 status_has '(.firstFrameMs | type) == "number"' || die "status never reported firstFrameMs"
  frames+=("$(shell_status | jq -r .firstFrameMs)")
  colds+=("$(open_once 1)") || exit 1
  schemes_colds+=("$(schemes_once 2)") || exit 1
done
echo "     first frames: ${frames[*]}; cold opens: ${colds[*]}; c mode cold opens: ${schemes_colds[*]}"
median() { printf '%s\n' "$@" | sort -n | sed -n 3p; }
first_frame=$(median "${frames[@]}")
cold=$(median "${colds[@]}")
schemes_cold=$(median "${schemes_colds[@]}")
# A warm open reopens the mode it was in: an open in the other mode rebuilds the launcher's rows and read 17 to 22 ms on any tree, so each warm row drops the first open after the switch and takes the median of the next five.
sleep 2
warms=() schemes_warms=()
for i in 0 1 2 3 4 5; do
  sleep 0.3
  ms=$(open_once $((3 + i))) || exit 1
  ((i > 0)) && warms+=("$ms")
done
for i in 0 1 2 3 4 5; do
  sleep 0.3
  ms=$(schemes_once $((9 + i))) || exit 1
  ((i > 0)) && schemes_warms+=("$ms")
done
echo "     warm opens: ${warms[*]}; c mode warm opens: ${schemes_warms[*]}"
warm=$(median "${warms[@]}")
schemes_warm=$(median "${schemes_warms[@]}")

# Control in the island: open number $1, its time as Control measured it, then closed with the keyboard back.
control_state() { timeout 0.5 qs ipc call control state 2>/dev/null; }
control_reported() { control_state | jq -e ".opens == $1 and (.openMs | type) == \"number\"" >/dev/null; }
control_closed() { control_state | jq -e '.open == false' >/dev/null && niri msg -j layers | jq -e 'any(.[]; .namespace == "dots-surfaces" and .keyboard_interactivity == "None")' >/dev/null; }
control_once() {
  qs ipc call control open >/dev/null || die "control open failed"
  until_ok 3000 control_reported "$1" || die "control open $1 never reported openMs"
  control_state | jq -r .openMs
  qs ipc call control close >/dev/null
  until_ok 3000 control_closed || die "Control never gave the keyboard back"
}
# Cold is Control's first open after a start, before the warm-up has made it: the median of five starts, as the launcher's.
control_colds=()
for i in 1 2 3 4 5; do
  systemctl --user kill -s KILL "$DOTS_DEV_UNIT"
  until_ok 3000 paper_gone || die "the killed shell's paper never went away"
  until_ok 10000 layer_up dots-paper || die "dots-paper never mapped"
  until_ok 3000 status_has '(.firstFrameMs | type) == "number"' || die "status never reported firstFrameMs"
  control_colds+=("$(control_once 1)") || exit 1
done
sleep 2
control_warms=()
for i in 0 1 2 3 4 5; do
  sleep 0.3
  ms=$(control_once $((2 + i))) || exit 1
  ((i > 0)) && control_warms+=("$ms")
done
echo "     control cold opens: ${control_colds[*]}; warm opens: ${control_warms[*]}"
control_cold=$(median "${control_colds[@]}")
control_warm=$(median "${control_warms[@]}")

# Pass loads on its open and unloads 30 s after it closes, so the open after that is a cold one.
pass_state() { timeout 0.5 qs ipc call pass state 2>/dev/null; }
pass_is() { pass_state | jq -e "$1" >/dev/null; }
pass_once() {
  qs ipc call pass open >/dev/null || die "pass open failed"
  until_ok 3000 pass_is '.opens == 1 and (.openMs | type) == "number"' || die "pass never reported openMs"
  pass_state | jq -r .openMs
  qs ipc call pass close >/dev/null
  until_ok 3000 pass_is '.drawing == false' || die "pass never closed"
}
pass_once >/dev/null || exit 1
until_ok 35000 pass_is '.loaded == false' || die "pass never unloaded"
pass_cold=$(pass_once) || exit 1
# Its unload Tick would count as a running timer, and the loaded card as memory, in what follows.
until_ok 35000 pass_is '.loaded == false' || die "pass never unloaded"

# The file picker loads on a request and unloads 30 s after it closes, so the request after that opens it cold; socat plays the portal, its connection open until the picker answers.
files_state() { timeout 0.5 qs ipc call picker state 2>/dev/null; }
files_is() { files_state | jq -e "$1" >/dev/null; }
files_once() {
  local request client
  request=$(jq -cn --arg f "$HOME" '{mode: "open", multiple: false, title: "", app: "", folder: $f, name: "", filters: [], filter: 0, accept: ""}')
  { printf '%s\n' "$request"; sleep 10; } | socat - "UNIX-CONNECT:$XDG_RUNTIME_DIR/dots-picker-$WAYLAND_DISPLAY.sock" >/dev/null 2>&1 &
  client=$!
  until_ok 3000 files_is '.opens == 1 and (.openMs | type) == "number"' || die "the file picker never reported openMs"
  files_state | jq -r .openMs
  wtype -k Escape
  until_ok 3000 files_is '.open == false' || die "the file picker never closed"
  kill "$client" 2>/dev/null
}
files_once >/dev/null || exit 1
until_ok 35000 files_is '.loaded == false' || die "the file picker never unloaded"
files_cold=$(files_once) || exit 1
until_ok 35000 files_is '.loaded == false' || die "the file picker never unloaded"

switch_json=$XDG_STATE_HOME/dots/theme-switch.json
first_is() { launcher_state | jq -e --arg t "$1" '.names[0] == $t' >/dev/null; }
switched_to() { jq -e --arg t "$1" --arg was "$2" '.to == $t and (tojson != $was)' "$switch_json" >/dev/null 2>&1; }

# Through the launcher's c mode as a person would, the name typed as its title, so the time runs from the Enter key to dots colorscheme's last reload.
switch_once() {
  local to=$1 was
  was=$(jq -c . "$switch_json" 2>/dev/null)
  qs ipc call launcher mode colorschemes >/dev/null || die "launcher colorschemes mode failed"
  until_ok 3000 launcher_focus Exclusive || die "the launcher never took the keyboard"
  wtype "${to//-/ }"
  until_ok 1000 first_is "$to" || die "typing ${to//-/ } never put $to first"
  wtype -k Return
  until_ok 3000 switched_to "$to" "$was" || die "the switch to $to was never recorded"
  until_ok 3000 launcher_focus None || die "the launcher never gave the keyboard back"
  jq -r .ms "$switch_json"
}
# The budget's RSS is read with every surface opened once on the starting theme, before any switch.
qs ipc call launcher mode colorschemes >/dev/null || die "launcher colorschemes mode failed"
until_ok 3000 launcher_focus Exclusive || die "the launcher never took the keyboard"
qs ipc call launcher close >/dev/null
until_ok 3000 launcher_focus None || die "the launcher never gave the keyboard back"
notifs_focus() { timeout 0.5 qs ipc call notifs state 2>/dev/null | jq -e --arg k "$1" '.open == ($k == "Exclusive")' >/dev/null && niri msg -j layers | jq -e --arg k "$1" 'any(.[]; .namespace == "dots-surfaces" and .keyboard_interactivity == $k)' >/dev/null; }
qs ipc call notifs open >/dev/null || die "notifs open failed"
until_ok 3000 notifs_focus Exclusive || die "the notification centre never took the keyboard"
qs ipc call notifs close >/dev/null
until_ok 3000 notifs_focus None || die "the notification centre never gave the keyboard back"
sheet_focus() { timeout 0.5 qs ipc call cheatsheet state 2>/dev/null | jq -e --arg k "$1" '.open == ($k == "Exclusive")' >/dev/null && niri msg -j layers | jq -e --arg k "$1" 'any(.[]; .namespace == "dots-surfaces" and .keyboard_interactivity == $k)' >/dev/null; }
qs ipc call cheatsheet open >/dev/null || die "cheatsheet open failed"
until_ok 3000 sheet_focus Exclusive || die "the cheat sheet never took the keyboard"
qs ipc call cheatsheet close >/dev/null
until_ok 3000 sheet_focus None || die "the cheat sheet never gave the keyboard back"
host_focus() { niri msg -j layers | jq -e --arg k "$1" 'any(.[]; .namespace == "dots-surfaces" and .keyboard_interactivity == $k)' >/dev/null; }
qs ipc call control open >/dev/null || die "control open failed"
until_ok 3000 host_focus Exclusive || die "Control never took the keyboard"
qs ipc call control close >/dev/null
until_ok 3000 host_focus None || die "Control never gave the keyboard back"
qs ipc call goals open >/dev/null || die "goals open failed"
until_ok 3000 host_focus Exclusive || die "Goals never took the keyboard"
qs ipc call goals close >/dev/null
until_ok 3000 host_focus None || die "Goals never gave the keyboard back"
# The picker opens and closes on one toggle each; nothing records.
qs ipc call record toggle >/dev/null || die "record toggle failed"
until_ok 3000 host_focus Exclusive || die "the region picker never took the keyboard"
qs ipc call record toggle >/dev/null
until_ok 3000 host_focus None || die "the region picker never gave the keyboard back"
# Emoji mode reads its bundled list on first use, so it is opened once too.
qs ipc call launcher mode emoji >/dev/null || die "launcher emoji mode failed"
until_ok 3000 host_focus Exclusive || die "emoji mode never took the keyboard"
qs ipc call launcher close >/dev/null
until_ok 3000 host_focus None || die "emoji mode never gave the keyboard back"
# The island's morph into the cheat sheet and back, three times warm: each row holds the median of the three longest gaps (D7WQ3J6Q), so one stray frame of the nested session does not decide it, and the worst p95 of the frames' work.
island_state() { timeout 0.5 qs ipc call island state 2>/dev/null; }
island_is() { island_state | jq -e "$1" >/dev/null 2>&1; }
morph_stats() { node "$(dirname "$0")/../shell/lib/bench.mjs" frames "$(island_state | jq -c .morph.frames)"; }
worse() { printf '%s\n%s\n' "$1" "$2" | sort -n | tail -1; }
middle() { printf '%s\n' "$@" | sort -n | sed -n 2p; }
open_maxes=() close_maxes=() open_p95=0 close_p95=0
for i in 1 2 3; do
  dots-call cheatsheet toggle >/dev/null || die "cheatsheet toggle failed"
  until_ok 3000 island_is '.surface == "cheatsheet" and .animating == false and .morph.kind == "open"' || die "the island never settled on the cheat sheet"
  read -r mx p95 < <(morph_stats)
  [ -n "$mx" ] || die "the island recorded no frames for its open"
  open_maxes+=("$mx") open_p95=$(worse "$open_p95" "$p95")
  wtype -k Escape
  until_ok 3000 island_is '.surface == null and .animating == false and .morph.kind == "close"' || die "the island never settled back at rest"
  read -r mx p95 < <(morph_stats)
  [ -n "$mx" ] || die "the island recorded no frames for its close"
  close_maxes+=("$mx") close_p95=$(worse "$close_p95" "$p95")
  until_ok 3000 host_focus None || die "the cheat sheet never gave the keyboard back"
done
open_max=$(middle "${open_maxes[@]}") close_max=$(middle "${close_maxes[@]}")
echo "     morph open: longest gaps ${open_maxes[*]}, p95 ${open_p95}; close: longest gaps ${close_maxes[*]}, p95 ${close_p95}"
# The island's morph from the launcher straight into the cheat sheet, three times warm, read as the open and close are.
switch_maxes=() switch_p95=0
for i in 1 2 3; do
  dots-call launcher toggle >/dev/null || die "launcher toggle failed"
  until_ok 3000 island_is '.surface == "launcher" and .animating == false' || die "the island never settled on the launcher"
  dots-call cheatsheet toggle >/dev/null || die "cheatsheet toggle failed"
  until_ok 3000 island_is '.surface == "cheatsheet" and .animating == false and .morph.from[0] > 400' || die "the island never settled on the cheat sheet from the launcher"
  read -r mx p95 < <(morph_stats)
  [ -n "$mx" ] || die "the island recorded no frames for its switch"
  switch_maxes+=("$mx") switch_p95=$(worse "$switch_p95" "$p95")
  wtype -k Escape
  until_ok 3000 island_is '.surface == null and .animating == false' || die "the island never settled back at rest"
  until_ok 3000 host_focus None || die "the cheat sheet never gave the keyboard back"
done
switch_morph_max=$(middle "${switch_maxes[@]}")
echo "     morph switch: longest gaps ${switch_maxes[*]}, p95 ${switch_p95}"
# The island's open from rest into Control, its clock gliding with it, three times warm and read as the open is.
control_maxes=() control_p95=0
for i in 1 2 3; do
  dots-call control toggle >/dev/null || die "control toggle failed"
  until_ok 3000 island_is '.surface == "control" and .animating == false and .morph.kind == "open"' || die "the island never settled on Control"
  read -r mx p95 < <(morph_stats)
  [ -n "$mx" ] || die "the island recorded no frames for its open into Control"
  control_maxes+=("$mx") control_p95=$(worse "$control_p95" "$p95")
  wtype -k Escape
  until_ok 3000 island_is '.surface == null and .animating == false' || die "the island never settled back at rest"
  until_ok 3000 host_focus None || die "Control never gave the keyboard back"
done
control_morph_max=$(middle "${control_maxes[@]}")
echo "     morph control: longest gaps ${control_maxes[*]}, p95 ${control_p95}"
sleep 5
rss_kib=$(shell_status | jq -r .rssKiB) || die "status did not answer after the opens"
# GPU buffers are shmem, which RSS misses, so the unit's cgroup anon+shmem is read at the same moment.
cgroup=$(systemctl --user show -p ControlGroup --value "$DOTS_DEV_UNIT")
[ -n "$cgroup" ] || die "$DOTS_DEV_UNIT has no cgroup"
anon_shmem_kib=$(awk '$1 == "anon" || $1 == "shmem" { b += $2 } END { printf "%d", b / 1024 }' "/sys/fs/cgroup$cgroup/memory.stat") || die "memory.stat of $DOTS_DEV_UNIT unreadable"

start=$(shell_status | jq -r .theme)
switch_max=0
mapfile -t names < <(cd "$(dirname "$0")/../colorschemes" && ls -- *.toml | sed 's/\.toml$//')
for to in $(node "$(dirname "$0")/../shell/lib/bench.mjs" cycle "$start" "${names[@]}"); do
  ms=$(switch_once "$to") || exit 1
  echo "     switch to $to: $ms ms" >&2
  ((ms > switch_max)) && switch_max=$ms
  # The paper's own transition runs up to 300 ms after dots colorscheme returns.
  sleep 0.4
done

sleep 5
status=$(shell_status) || die "status did not answer after the switches"
switched_kib=$(jq -r .rssKiB <<<"$status")
timers=$(jq -r .timers <<<"$status")

# Files, Dekho and Deen are Apps, each its own qs process, started the way the desktop starts them and closed by window, before the idle window so they cannot skew idle cpu; bench_app <entry qml> <bin> <app id> [walk] sets app_first_frame (median of five), app_rss_kib (largest) and app_left (most left over).
bench_app() {
  local qml=$repo/shell/$1 bin=$repo/bin/$2 appid=$3 walk=${4:-} i kib left
  app_state() { timeout 0.5 qs ipc -p "$qml" call "$appid" state 2>/dev/null; }
  app_is() { app_state | jq -e "$1" >/dev/null 2>&1; }
  app_windows() { niri msg -j windows | jq --arg a "$appid" '[.[] | select(.app_id == $a)] | length'; }
  app_up() { [ "$(app_windows)" = 1 ] && app_is '.firstFrameMs != null'; }
  app_pids() { session_qs_pids "-p $qml"; }
  app_gone() { [ -z "$(app_pids)" ]; }
  local frames=()
  app_rss_kib=0 app_left=0
  for i in 1 2 3 4 5; do
    niri msg action spawn -- "$bin" >/dev/null || die "spawning $2 failed"
    until_ok 5000 app_up || die "$appid never drew its first frame"
    frames+=("$(app_state | jq -r .firstFrameMs)")
    [ -z "$walk" ] || "$walk"
    # Its rows have a second to settle before the memory is read; the largest of the five starts is kept.
    sleep 1
    kib=$(app_state | jq -r .rssKiB) || die "$appid did not report rssKiB"
    [[ $kib =~ ^[0-9]+$ ]] && ((kib > 0)) || die "$appid reported rssKiB '$kib', not a size"
    ((kib > app_rss_kib)) && app_rss_kib=$kib
    niri msg action close-window >/dev/null || die "closing $appid failed"
    until_ok 3000 app_gone || {
      left=$(app_pids | wc -l)
      ((left > app_left)) && app_left=$left
      kill $(app_pids) 2>/dev/null
      sleep 0.3
    }
  done
  echo "     $appid first frames: ${frames[*]}"
  app_first_frame=$(median "${frames[@]}")
}
# Dekho's memory is read with its pictures out: Home's posters, a title with 20 cast faces, then Browse's rows.
dekho_walk() {
  until_ok 3000 app_is '[.rows.series[] | select(.poster.shown)] | length >= 8' || die "Dekho's Home drew no posters"
  wtype -k Shift_L
  wtype jl
  until_ok 1000 app_is '.focus == {"row": "series", "col": 1}' || die "Dekho's cursor never reached The Long Tide"
  wtype -k Return
  until_ok 3000 app_is '.page == "title" and .title.slot.shown and .title.cast[2].face.shown' || die "Dekho's title page drew no faces"
  wtype -k Escape
  until_ok 1000 app_is '.page == "home"' || die "Esc never took Dekho back to Home"
  wtype f
  until_ok 3000 app_is '.page == "browse" and ([.browse.rows[] | select(.poster.shown)] | length) >= 20' || die "Dekho's Browse drew fewer than 20 posters"
}
bench_app dekho.qml dots-dekho dekho dekho_walk
dekho_first_frame=$app_first_frame dekho_rss_kib=$app_rss_kib dekho_left=$app_left
bench_app deen.qml dots-deen deen
deen_first_frame=$app_first_frame deen_rss_kib=$app_rss_kib deen_left=$app_left
bench_app files.qml dots-files files

"$(dirname "$0")/dots" colorscheme gruvbox-dark >/dev/null || die "dots colorscheme gruvbox-dark failed"
until_ok 3000 status_has '.theme == "gruvbox-dark"' || die "the shell never reported gruvbox-dark"
# The paper's transition ends 300 ms after the call; idle starts after it.
sleep 1
pid=$(systemctl --user show -p MainPID --value "$DOTS_DEV_UNIT")
# utime and stime are fields 14 and 15; the comm in field 2 is cut off first.
cpu_ticks() { local s; s=$(<"/proc/$pid/stat"); read -ra f <<<"${s##*) }"; echo $((f[11] + f[12])); }
t0=$(cpu_ticks)
sleep "$idle_s"
t1=$(cpu_ticks)
cpu=$(awk -v d=$((t1 - t0)) -v hz="$(getconf CLK_TCK)" -v s="$idle_s" 'BEGIN { printf "%.2f", d / hz / s * 100 }')

# The notification centre in the island, timed last so its kills and its forty rows' memory touch no other row: open number $1, its time as the centre measured it, then closed with the keyboard back.
notifs_state() { timeout 0.5 qs ipc call notifs state 2>/dev/null; }
notifs_reported() { notifs_state | jq -e ".opens == $1 and (.openMs | type) == \"number\"" >/dev/null; }
notifs_count_is() { notifs_state | jq -e ".count == $1" >/dev/null; }
notifs_closed() { notifs_state | jq -e '.open == false' >/dev/null && niri msg -j layers | jq -e 'any(.[]; .namespace == "dots-surfaces" and .keyboard_interactivity == "None")' >/dev/null; }
notifs_once() {
  qs ipc call notifs open >/dev/null || die "notifs open failed"
  until_ok 3000 notifs_reported "$1" || die "notifs open $1 never reported openMs"
  notifs_state | jq -r .openMs
  qs ipc call notifs close >/dev/null
  until_ok 3000 notifs_closed || die "the notification centre never gave the keyboard back"
}
# The centre is timed over forty notifications in its history, which outlives each kill, so the open draws a list taller than the island lets it be.
for i in $(seq 1 40); do notify-send -a Bench "bench $i" "a body that draws on one line"; done
until_ok 5000 notifs_count_is 40 || die "the forty notifications never reached the history"
sleep 1
notifs_colds=()
for i in 1 2 3 4 5; do
  systemctl --user kill -s KILL "$DOTS_DEV_UNIT"
  until_ok 3000 paper_gone || die "the killed shell's paper never went away"
  until_ok 10000 layer_up dots-paper || die "dots-paper never mapped"
  until_ok 3000 status_has '(.firstFrameMs | type) == "number"' || die "status never reported firstFrameMs"
  notifs_colds+=("$(notifs_once 1)") || exit 1
done
sleep 2
notifs_warms=()
for i in 0 1 2 3 4 5; do
  sleep 0.3
  ms=$(notifs_once $((2 + i))) || exit 1
  ((i > 0)) && notifs_warms+=("$ms")
done
echo "     notifs cold opens: ${notifs_colds[*]}; warm opens: ${notifs_warms[*]}"
notifs_cold=$(median "${notifs_colds[@]}")
notifs_warm=$(median "${notifs_warms[@]}")

# The AI chat loads on its first open and unloads 30 s after it closes, so cold is the open after an unload and warm one while it is still loaded; opens counts from the load, and the island is the only state that says the close has drawn. Nothing is ever sent, so no request leaves for pxy.
chat_state() { timeout 0.5 qs ipc call chat state 2>/dev/null; }
chat_is() { chat_state | jq -e "$1" >/dev/null; }
chat_once() {
  qs ipc call chat open >/dev/null || die "chat open failed"
  until_ok 3000 chat_is ".opens == $1 and (.openMs | type) == \"number\"" || die "chat open $1 never reported openMs"
  chat_state | jq -r .openMs
  qs ipc call chat close >/dev/null
  until_ok 3000 island_is '.surface == null and .animating == false' || die "the chat never closed"
}
chat_colds=()
for i in 1 2 3; do
  chat_colds+=("$(chat_once 1)") || exit 1
  [ "$i" = 3 ] || until_ok 35000 chat_is '.loaded == false' || die "the chat never unloaded"
done
chat_warms=()
for i in 2 3 4; do
  sleep 0.3
  chat_warms+=("$(chat_once "$i")") || exit 1
done
echo "     chat cold opens: ${chat_colds[*]}; warm opens: ${chat_warms[*]}"
chat_cold=$(middle "${chat_colds[@]}")
chat_warm=$(middle "${chat_warms[@]}")
# Its unload Tick would count as a running timer, and the loaded card as memory, in any row measured after it.
until_ok 35000 chat_is '.loaded == false' || die "the chat never unloaded"

node "$(dirname "$0")/../shell/lib/bench.mjs" "$first_frame" "$rss_kib" "$cold" "$warm" "$timers" "$cpu" "$switch_max" "$switched_kib" "$anon_shmem_kib" "$schemes_cold" "$schemes_warm" "$pass_cold" "$files_cold" "$app_first_frame" "$app_rss_kib" "$app_left" "$dekho_first_frame" "$dekho_rss_kib" "$dekho_left" "$deen_first_frame" "$deen_rss_kib" "$deen_left" "$open_max" "$open_p95" "$close_max" "$close_p95" "$switch_morph_max" "$switch_p95" "$control_cold" "$control_warm" "$control_morph_max" "$control_p95" "$notifs_cold" "$notifs_warm" "$chat_cold" "$chat_warm"
exit
}
