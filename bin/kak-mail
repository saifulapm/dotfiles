#!/usr/bin/env python3
"""kak-mail — the Kakoune side of mail: draws what mail_engine.py reads for kak/autoload/tools/mail.kak.

Everything below the UI is not this file's business: mbsync, goimapnotify,
the notmuch post-new router, hey-folder-sync and msmtp run on their own. This
renders mail_engine.py's reads as Kakoune buffers, sends through msmtp, and
writes the HEY decision files the post-new hook reads.

Subcommands (the kak side is the only intended caller):
  boxes [--maps]              box list with counts, or kak `map` lines for J
  query NAME                  the notmuch query of a box
  list --out F [--unthreaded] [--offset N] QUERY   render 500 rows from N into F, print `mail_ids` and the rows shown
  show --out F QUERY          render a thread into F, print `mail_msgs`, mark read
  links QUERY                 `N label — host/path` per link of a message, or of a thread: with sender and date
  link QUERY PICK             the URL of the links line PICK
  attachments QUERY           `N: name (type)` per attachment, as links gathers them
  save QUERY PICK             the attachment on line PICK → ~/Downloads (never overwrites)
  identities                  sender identities, one per line
  compose new|reply|replyall|forward [QUERY]   write a draft, print its path
  compose mailto URL          a draft to a mailto: URL's to, cc, subject and body
  header FILE set|add NAME VALUE   edit a draft's headers (From, Attach)
  send FILE                   send a draft via msmtp, file it in Sent, delete it
  hey ACTION [--arg A] QUERY...   the HEY routing actions (see HEY below)
  count                       write the Imbox unread count for the margin, print it
"""

import email.policy
import mimetypes
import os
import re
import secrets
import subprocess
import sys
import time
import unicodedata
from email.message import EmailMessage
from email.utils import formatdate, getaddresses, make_msgid, parseaddr
from urllib.parse import unquote, urlsplit
import json

# Python would write bin/__pycache__ into the checkout on the first import.
sys.dont_write_bytecode = True
from mail_engine import (BOXES, URL, MailError, body_text, box, box_counts, idq, line, matched_messages, message_of, nm,
                         one_message, part_bytes, refresh_count, search_threads, set_unread, target, thread_messages,
                         write_count)

HOME = os.path.expanduser("~")
DB_DIR = os.environ.get("HEY_MAIL_DB_DIR") or os.path.join(os.environ.get("XDG_DATA_HOME", HOME + "/.local/share"), "hey-mail")
DRAFTS = os.path.join(os.environ.get("XDG_DATA_HOME", HOME + "/.local/share"), "kak-mail", "drafts")
SENT_FOLDER = "icloud/Sent Messages"
MSMTP_ACCOUNT = "icloud"
LIST_LIMIT = 500


def kq(s):
    """Quote for Kakoune: single quotes, embedded ones doubled."""
    return "'" + s.replace("'", "''") + "'"


def die(msg):
    print(f"kak-mail: {msg}", file=sys.stderr)
    sys.exit(1)


# ───────────────────────────── text layout ─────────────────────────────

def width(s):
    w = 0
    for ch in s:
        if unicodedata.combining(ch) or unicodedata.category(ch) in ("Mn", "Me", "Cf"):
            continue
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def fit(s, n):
    """Truncate/pad S to exactly N display cells."""
    s = s.replace("\t", " ").replace("\n", " ")
    out, w = "", 0
    for ch in s:
        cw = width(ch)
        if w + cw > n:
            break
        out, w = out + ch, w + cw
    return out + " " * (n - w)


def fmt_date(ts):
    t, now = time.localtime(ts), time.localtime()
    if t[:3] == now[:3]:
        return time.strftime("%H:%M", t)
    if t.tm_year == now.tm_year:
        return time.strftime("%b %d", t)
    return time.strftime("%Y-%m-%d", t)


def row(ts, who, subject, tags):
    return f"{fmt_date(ts):<10} {fit(line(who), 22)} {line(subject)}  [{line(' '.join(tags))}]"


# ───────────────────────────── boxes / lists ─────────────────────────────

def cmd_boxes(args):
    if args[:1] == ["--maps"]:
        for key, name, _, _ in BOXES:
            print(f"map global mail-jump {kq(key)} {kq(':mail-box %{' + name + '}<ret>')} -docstring {kq(name)}")
        return
    for (key, name, _, _), n in zip(BOXES, box_counts()):
        print(f" {key}  {name:<12} {n:>5}")


def cmd_query(args):
    b = box(args[0])
    print(b[2] if b else args[0])


def cmd_list(args):
    out, flat, offset, words = None, False, 0, []
    it = iter(args)
    for a in it:
        if a == "--out":
            out = next(it)
        elif a == "--unthreaded":
            flat = True
        elif a == "--offset":
            offset = int(next(it))
        else:
            words.append(a)
    query = " ".join(words)
    b = box(query)
    unthreaded = b[3] if b else flat
    q = b[2] if b else query
    total = int(nm("count", *([] if unthreaded else ["--output=threads"]), "--", q))
    # A page an archive emptied falls back to the last page that still has rows.
    if offset >= total:
        offset = max(0, (total - 1) // LIST_LIMIT * LIST_LIMIT)
    ids, lines = [], []
    if unthreaded:
        for m in matched_messages(q)[offset:offset + LIST_LIMIT]:
            h = m["headers"]
            name, addr = parseaddr(h.get("From", ""))
            ids.append("id:" + m["id"])
            lines.append(row(m["timestamp"], name or addr, h.get("Subject", ""), m["tags"]))
    else:
        for t in search_threads(q, LIST_LIMIT, offset):
            ids.append("thread:" + t["thread"])
            count = f" ({t['matched']}/{t['total']})" if t["total"] > 1 else ""
            lines.append(row(t["timestamp"], t["authors"], t["subject"] + count, t["tags"]))
    with open(out, "w") as f:
        f.write("\n".join(lines) + ("\n" if lines else f"(nothing in {query})\n"))
    print("set-option buffer mail_ids " + " ".join(kq(i) for i in ids))
    rows = f"rows {offset + 1}–{offset + len(ids)} of {total}" if ids else "no rows"
    print(f"set-option buffer mail_offset {offset}\nset-option buffer mail_total {total}\nset-option buffer mail_rows {kq(rows)}")


def cmd_count(args):
    print(write_count())


# ───────────────────────────── thread view ─────────────────────────────

def render_message(m):
    h = m["headers"]
    atts = []
    body = body_text(m.get("body", []), atts)
    head = "".join(f"{k}: {line(h[k])}\n" for k in ("From", "To", "Cc", "Date", "Subject") if h.get(k))
    head += f"Tags: {' '.join(m['tags'])}\n"
    tail = "".join(f"[attachment {i}: {name} ({ct})]\n" for i, name, ct in atts)
    return head + "\n" + body + ("\n" + tail if tail else "")


def cmd_show(args):
    out, query = args[1], target(" ".join(args[2:]))
    msgs = thread_messages(query)
    lines, marks = [], []
    for m in msgs:
        marks.append(f"{len(lines) + 1}:{m['id']}")
        lines.append("━" * 72)
        lines.extend(render_message(m).rstrip("\n").split("\n"))
        lines.append("")
    with open(out, "w") as f:
        f.write("\n".join(lines) + "\n")
    # Opening a thread marks it read.
    set_unread(query, False)
    print("set-option buffer mail_msgs " + " ".join(kq(x) for x in marks))


def shown(url):
    """URL as the picker shows it: host and path, with a query or fragment cut to …, as one line of the sender's text."""
    try:
        u = urlsplit(url)
        host = (u.hostname or "") + (f":{u.port}" if u.port else "")
    except ValueError:
        # A host urlsplit cannot read (a cut IPv6 address, a port past 65535) shows as written.
        return " ".join(line(url).split())
    return " ".join(line(host + u.path.rstrip("/") + ("…" if u.query or u.fragment else "")).split())


def html_first(parts):
    """PARTS with each multipart/alternative's plain part dropped when it has an HTML one, so links keep their anchor text."""
    out = []
    for p in parts:
        c = p.get("content")
        if isinstance(c, list) and p.get("content-type", "").lower() == "multipart/alternative" \
                and any(q.get("content-type", "").lower() == "text/html" for q in c):
            p = {**p, "content": [q for q in c if q.get("content-type", "").lower() != "text/plain"]}
        elif isinstance(c, list) and all("content-type" in q for q in c):
            p = {**p, "content": html_first(c)}
        out.append(p)
    return out


def gathered(query):
    """The messages o and A read for QUERY, each with the words that name it: a list's thread: row is every message
    of the thread, oldest first, named by sender and date; a thread view's id: is its one message, unnamed."""
    if not query.startswith("thread:"):
        return [(one_message(message_of(query)), "")]
    named = []
    for m in sorted(thread_messages(query), key=lambda m: m["timestamp"]):
        name, addr = parseaddr(m["headers"].get("From", ""))
        named.append((m, f" ({line(name or addr).strip()}, {fmt_date(m['timestamp'])})"))
    return named


def link_rows(query):
    """(picker text, url) for each http and https link of QUERY's messages, in reading order, a url once under its first label."""
    rows = {}
    for m, who in gathered(query):
        found = []
        text = body_text(html_first(m.get("body", [])), [], found=found)
        # A body lynx's link list did not parse keeps its URLs in the text.
        found += [(u, u) for u in (u.rstrip(".,;:!?") for u in URL.findall(text))]
        for label, url in found:
            if not re.match(r"https?://", url, re.I) or url in rows:
                continue
            # The anchor text is the sender's: one line, and cut short.
            label = " ".join(line(label).split())
            label = label if len(label) <= 60 else label[:59] + "…"
            rows[url] = (f"{label} — {shown(url)}" if label and label != url else shown(url)) + who
    return [(text, url) for url, text in rows.items()]


def attachment_rows(query):
    """(picker text, message id, part, name) for each attachment of QUERY's messages."""
    rows = []
    for m, who in gathered(query):
        atts = []
        body_text(m.get("body", []), atts)
        rows += [(f"{name} ({ct}){who}", m["id"], part, name) for part, name, ct in atts]
    return rows


def picked(rows, pick, what):
    """The row PICK names by its leading number."""
    n = re.match(r"\d+", pick)
    if not n or not 1 <= int(n.group()) <= len(rows):
        die(f"no {what} {pick}")
    return rows[int(n.group()) - 1]


def cmd_links(args):
    """links QUERY — one numbered line per link, its label beside where it goes."""
    for i, (text, _) in enumerate(link_rows(args[0]), 1):
        print(f"{i} {text}")


def cmd_link(args):
    """link QUERY PICK — the url of the line PICK, as links numbered it."""
    print(picked(link_rows(args[0]), args[1], "link")[1])


def cmd_attachments(args):
    """attachments QUERY — one `N: name (type)` line per attachment."""
    for i, (text, *_) in enumerate(attachment_rows(args[0]), 1):
        print(f"{i}: {text}")


def cmd_save(args):
    """save QUERY PICK — write the attachment on line PICK of attachments to ~/Downloads, print its path.
    An existing file is never overwritten: name (1).ext, name (2).ext, …"""
    _, msg_id, part, name = picked(attachment_rows(args[0]), args[1], "attachment")
    folder = os.path.join(HOME, "Downloads")
    os.makedirs(folder, exist_ok=True)
    stem, ext = os.path.splitext(os.path.basename(name) or "attachment")
    path, n = os.path.join(folder, stem + ext), 1
    while os.path.exists(path):
        path, n = os.path.join(folder, f"{stem} ({n}){ext}"), n + 1
    data = part_bytes(msg_id, part)
    with open(path, "wb") as f:
        f.write(data)
    print(path)


# ───────────────────────────── compose / send ─────────────────────────────

def identities():
    name = nm("config", "get", "user.name").strip()
    addrs = [nm("config", "get", "user.primary_email").strip()]
    addrs += [a for a in nm("config", "get", "user.other_email").split() if a]
    return [f"{name} <{a}>" if name else a for a in addrs]


def nametag():
    try:
        with open(os.path.join(DB_DIR, "nametag")) as f:
            s = f.read().strip()
        return f"\n\n-- \n{s}\n" if s else "\n"
    except FileNotFoundError:
        return "\n"


def quote(text):
    return "".join("> " + l if l.strip() else ">\n" for l in text.splitlines(True)) + "\n"


# Every character str.splitlines() breaks on: a sender's header value holding one would start a header line of its own in the draft.
LINE_BREAKS = re.compile("[\n\r\v\f\x1c\x1d\x1e\x85\u2028\u2029]")


def oneline(value):
    return LINE_BREAKS.sub(" ", value)


# The mailto fields a draft takes; any other (bcc, from, attach, in-reply-to) is a web page's say about who the mail goes to or what it holds, so it is dropped.
MAILTO_FIELDS = {"to": "To", "cc": "Cc", "subject": "Subject", "body": "Body"}


def mailto(url):
    """URL's draft headers (To, Cc, Subject) and Body, as RFC 6068 spells them; + is a plus, not a space."""
    if not url.lower().startswith("mailto:"):
        die(f"not a mailto URL: {url}")
    path, _, query = url[7:].partition("?")
    fields = {"To": [unquote(path)] if path else [], "Cc": [], "Subject": [], "Body": []}
    for pair in query.split("&"):
        k, _, v = pair.partition("=")
        name = MAILTO_FIELDS.get(unquote(k).lower())
        if name:
            fields[name].append(unquote(v))
    out = [(k, ", ".join(a for a in fields[k] if a)) for k in ("To", "Cc") if any(fields[k])]
    out.append(("Subject", fields["Subject"][0] if fields["Subject"] else ""))
    if fields["Body"]:
        out.append(("Body", fields["Body"][0].replace("\r\n", "\n")))
    return out


def cmd_compose(args):
    kind = args[0]
    headers, body = [], ""
    if kind == "new":
        headers = [("From", identities()[0]), ("To", ""), ("Subject", "")]
    elif kind in ("reply", "replyall"):
        msg_id = message_of(args[1])
        r = json.loads(nm("reply", "--format=json",
                          "--reply-to=" + ("all" if kind == "replyall" else "sender"), idq(msg_id)))
        rh = r["reply-headers"]
        # notmuch spells it "In-reply-to"; send keys off the canonical name.
        rh = {k.lower(): v for k, v in rh.items()}
        headers = [(k, rh[k.lower()]) for k in ("From", "To", "Cc", "Subject", "In-Reply-To", "References")
                   if rh.get(k.lower())]
        orig = one_message(msg_id)
        oh = orig["headers"]
        body = (f"\n\nOn {oh.get('Date', '')}, {oh.get('From', '')} wrote:\n" +
                quote(body_text(orig.get("body", []), [], links=False)))
    elif kind == "mailto":
        fields = mailto(args[1])
        headers = [("From", identities()[0])] + [f for f in fields if f[0] != "Body"]
        body = "".join("\n" + v for k, v in fields if k == "Body")
    elif kind == "forward":
        msg_id = message_of(args[1])
        orig = one_message(msg_id)
        oh = orig["headers"]
        subj = oh.get("Subject", "")
        headers = [("From", identities()[0]), ("To", ""),
                   ("Subject", subj if subj.lower().startswith("fwd:") else "Fwd: " + subj)]
        atts = []
        text = body_text(orig.get("body", []), atts)
        # The original's attachments ride along as Attach: pseudo-headers, like a hand-added one, so send has one path.
        os.makedirs(DRAFTS, exist_ok=True)
        for part_id, name, _ in atts:
            path = os.path.join(DRAFTS, f"fwd-{secrets.token_hex(4)}-{oneline(os.path.basename(name))}")
            with open(path, "wb") as f:
                f.write(part_bytes(msg_id, part_id))
            headers.append(("Attach", path))
        body = ("\n\n---------- Forwarded message ----------\n" +
                "".join(f"{k}: {oh[k]}\n" for k in ("From", "Date", "Subject", "To") if oh.get(k)) +
                "\n" + text)
    else:
        die(f"unknown compose kind: {kind}")
    os.makedirs(DRAFTS, exist_ok=True)
    path = os.path.join(DRAFTS, time.strftime("%Y%m%d-%H%M%S-") + secrets.token_hex(3) + ".eml")
    with open(path, "w") as f:
        f.write("".join(f"{k}: {oneline(v)}\n" for k, v in headers) + body + nametag())
    print(path)


def parse_draft(text):
    head, _, body = text.partition("\n\n")
    headers = []
    for line in head.splitlines():
        if line[:1] in (" ", "\t") and headers:
            headers[-1] = (headers[-1][0], headers[-1][1] + " " + line.strip())
        elif ":" in line:
            k, v = line.split(":", 1)
            headers.append((k.strip(), v.strip()))
    return headers, body


def cmd_header(args):
    """header FILE set|add NAME VALUE — edit a draft's header block in place."""
    path, op, name, value = args
    if name.lower() == "attach":
        value = os.path.abspath(os.path.expanduser(value))
        if not os.path.isfile(value):
            die(f"no such file: {value}")
    with open(path) as f:
        head, sep, body = f.read().partition("\n\n")
    lines = head.split("\n")
    if op == "set":
        lines = [l for l in lines if not l.lower().startswith(name.lower() + ":")]
        lines.insert(0, f"{name}: {value}")
    else:
        lines.append(f"{name}: {value}")
    with open(path, "w") as f:
        f.write("\n".join(lines) + (sep or "\n\n") + body)


def cmd_send(args):
    path = args[0]
    # Kakoune writes the buffer back over the draft before each send, so the mark lives beside it.
    mark = path + ".sent"
    if os.path.exists(mark):
        die(f"already sent; {mark} holds the message as it went out")
    with open(path) as f:
        headers, body = parse_draft(f.read())
    msg = EmailMessage(policy=email.policy.SMTP)
    attach = []
    for k, v in headers:
        if k.lower() == "attach":
            attach.append(os.path.expanduser(v))
        elif v and k.lower() in ("to", "cc", "bcc") and msg.get(k):
            # A second To line adds its people; the message can hold only one.
            merged = f"{msg[k]}, {v}"
            del msg[k]
            msg[k] = merged
        elif v:
            msg[k] = v
    if not any(msg.get(h) for h in ("To", "Cc", "Bcc")):
        die("no recipients (To/Cc/Bcc all empty)")
    if not msg.get("From"):
        die("no From header")
    domain = parseaddr(msg["From"])[1].rpartition("@")[2] or None
    msg["Date"] = formatdate(localtime=True)
    msg["Message-ID"] = make_msgid(domain=domain)
    msg.set_content(body)
    for a in attach:
        if not os.path.isfile(a):
            die(f"attachment not found: {a}")
        ctype = mimetypes.guess_type(a)[0] or "application/octet-stream"
        maintype, subtype = ctype.split("/", 1)
        with open(a, "rb") as f:
            msg.add_attachment(f.read(), maintype=maintype, subtype=subtype, filename=os.path.basename(a))
    raw = msg.as_bytes()
    # -t takes recipients from To/Cc/Bcc (msmtp strips Bcc) and the envelope-from from From, so every iCloud+ alias sends as itself.
    r = subprocess.run(["msmtp", "-a", MSMTP_ACCOUNT, "--read-envelope-from", "-t"],
                       input=raw, capture_output=True)
    if r.returncode != 0:
        die("msmtp: " + (r.stderr.decode(errors="replace").strip().splitlines() or ["failed"])[-1])
    with open(mark, "wb") as f:
        f.write(raw)
    # File the sent copy in icloud/Sent Messages, tagged +sent -inbox -unread -new.
    filed = subprocess.run(["notmuch", "insert", f"--folder={SENT_FOLDER}", "+sent", "-inbox", "-unread", "-new"],
                           input=raw, capture_output=True)
    if filed.returncode != 0:
        why = (filed.stderr.decode(errors="replace").strip().splitlines() or ["notmuch insert failed"])[-1]
        # Kakoune's status line cuts a long message, so the file to look in comes before notmuch's reason.
        die(f"sent, but not filed in Sent; {os.path.basename(mark)} beside the draft holds it: {why}")
    irt = msg.get("In-Reply-To", "").strip().strip("<>")
    if irt:
        subprocess.run(["notmuch", "tag", "+replied", "--", idq(irt)])
        # The mail is out and filed, so a busy database only leaves the thread's piles as they were.
        threads = subprocess.run(["notmuch", "search", "--output=threads", idq(irt)], capture_output=True, text=True).stdout.split()
        if threads:
            subprocess.run(["notmuch", "tag", "-replylater", "-setaside", "--", " or ".join(threads)])
    for a in attach:
        if os.path.dirname(a) == DRAFTS:
            os.unlink(a)
    os.unlink(path)
    os.unlink(mark)
    print(f"sent to {', '.join(a for _, a in getaddresses([msg.get('To', ''), msg.get('Cc', '')]) if a)}")


# ───────────────────────────── HEY actions ─────────────────────────────

# The post-new hook applies these .db files to every new message, so their tags and line formats are its own.

def db_path(db):
    os.makedirs(DB_DIR, exist_ok=True)
    return os.path.join(DB_DIR, db)


def db_add(db, line):
    with open(db_path(db), "a") as f:
        f.write(line + "\n")


def db_drop(db, addr):
    """Remove the lines naming ADDR as one whole field, so joann@ outlives ann@;
    written via rename so the post-new hook never reads a half-written routing
    table (suffix distinct from the hook's own `.tmp')."""
    path = db_path(db)
    if not os.path.exists(path):
        return
    with open(path) as f:
        lines = f.readlines()
    keep = [l for l in lines if addr.lower() not in (w.lower() for w in l.split())]
    if len(keep) != len(lines):
        with open(path + ".kak-tmp", "w") as f:
            f.writelines(keep)
        os.replace(path + ".kak-tmp", path)


def sanitize(name, what):
    clean = re.sub(r"[^A-Za-z0-9_-]", "", name or "")
    if not clean:
        die(f"{what} must contain a letter, digit, - or _")
    return clean


def sender(query):
    """The sender to decide on: newest sender of QUERY that is not you."""
    mine = {parseaddr(i)[1].lower() for i in identities()}
    for a in nm("address", "--output=sender", "--output=address", query).split():
        if a.lower() not in mine:
            return a.lower()
    die(f"no sender found for {query}")


def tag(query, *changes):
    nm("tag", *changes, "--", query)


def cmd_hey(args):
    action, arg = args[0], None
    rest = args[1:]
    if rest[:1] == ["--arg"]:
        arg, rest = rest[1], rest[2:]
    queries = [target(q) for q in rest]
    if not queries:
        die("no message selected")
    done = []
    if action in ("screen-in", "feed", "papertrail", "screen-out", "unscreen", "autofile", "recycle"):
        for addr in dict.fromkeys(sender(q) for q in queries):
            frm = "from:" + addr
            if action == "screen-in":
                tag(frm, "+screened")
                db_add("screened.db", addr)
            elif action == "feed":
                tag(frm, "+thefeed", "+archived", "-inbox")
                db_add("thefeed.db", addr)
            elif action == "papertrail":
                cat = sanitize(arg, "Category")
                tag(frm, f"+ledger/{cat}", "+archived", "-inbox", "-unread")
                db_add("ledger.db", f"{cat} {addr}")
            elif action == "screen-out":
                tag(frm, "+spam", "+deleted", "+archived", "-inbox", "-unread", "-screened")
                db_add("spam.db", addr)
            elif action == "unscreen":
                for db in ("screened.db", "thefeed.db", "spam.db", "ledger.db", "autofile.db", "recycle.db"):
                    db_drop(db, addr)
                tag(frm, "-screened", "-thefeed", "-spam", "-deleted", "-bubble", "+inbox")
            elif action == "autofile":
                label = sanitize(arg, "Label")
                db_add("autofile.db", f"{addr} {label}")
                tag(frm, f"+label/{label}")
            elif action == "recycle":
                if arg not in ("30", "90", "730"):
                    die("recycle days must be 30, 90 or 730")
                db_add("recycle.db", f"{addr} {arg}")
            done.append(addr)
    elif action in ("reply-later", "set-aside", "clear", "bubble", "archive"):
        threads = dict.fromkeys(t.removeprefix("thread:")
                                for t in nm("search", "--output=threads", " or ".join(f"({q})" for q in queries)).split())
        when = None
        if action == "bubble":
            r = subprocess.run(["date", "-d", arg or "", "+%s"], capture_output=True, text=True)
            if r.returncode != 0 or not arg:
                die(f"cannot read a time from {arg!r} (try: tomorrow 9am, next friday, 3 days)")
            when = int(r.stdout)
            if when <= time.time():
                die("that time is already past")
        for tid in threads:
            q = "thread:" + tid
            if action == "reply-later":
                tag(q, "+replylater")
            elif action == "set-aside":
                tag(q, "+setaside")
            elif action == "clear":
                tag(q, "-replylater", "-setaside", "-bubbled")
            elif action == "archive":
                tag(q, "-inbox", "+archived")
            elif action == "bubble":
                db_add("bubble.db", f"{tid} {when}")
                tag(q, "+bubble", "-inbox", "-unread", "-bubbled")
        done = [f"{len(threads)} thread(s)"]
        if when:
            done.append(time.strftime("until %a %d %b %H:%M", time.localtime(when)))
    elif action == "sender":
        print(sender(queries[0]))
        return
    else:
        die(f"unknown action: {action}")
    refresh_count()
    print(f"{action}: {', '.join(done)}")


def main():
    if len(sys.argv) < 2:
        die("usage: kak-mail <boxes|query|list|show|identities|compose|send|hey|count> …")
    cmd, args = sys.argv[1], sys.argv[2:]
    fn = {
        "boxes": cmd_boxes, "query": cmd_query, "list": cmd_list, "show": cmd_show,
        "identities": lambda a: print("\n".join(identities())),
        "links": cmd_links, "link": cmd_link, "attachments": cmd_attachments, "save": cmd_save,
        "compose": cmd_compose, "header": cmd_header, "send": cmd_send, "hey": cmd_hey,
        "count": cmd_count,
    }.get(cmd)
    if not fn:
        die(f"unknown command: {cmd}")
    try:
        fn(args)
    except MailError as e:
        die(str(e))


if __name__ == "__main__":
    main()
