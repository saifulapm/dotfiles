#!/usr/bin/env python3
"""mail — Saiful's mail as JSON for an agent, read through the engine Kakoune uses.

  mail boxes                                   each box: key, name, total, unread
  mail search [QUERY] [--box NAME] [--limit N] [--offset N]
  mail show ID                                 one message; never marks it read
  mail thread ID                               every message of a thread, oldest first
  mail read ID / mail unread ID                mark a message read or unread
  mail preview ID [--images]                   the HTML part as a file a browser opens with nothing remote loaded
  mail draft new|reply|replyall|forward [ID] [--to A] [--cc A] [--bcc A] [--subject S] [--from ADDR]
             [--body-file F] [--attach FILE]...  write a draft where Kakoune keeps them; prints its id and path
  mail drafts                                  every draft, newest first
  mail draft show DRAFT                        what the draft sends, and the digest send takes
  mail send DRAFT --yes --digest D             send the draft draft show gave digest D, only after Saiful's yes to it
  mail hey ACTION ID [--category C] [--at DATE]   file a message HEY's way, in ways that can be undone:
                                               screen-in, feed, papertrail, replylater, setaside, bubble, archive, clear
  mail hey screen-out --sender ADDR            screen out a sender Saiful named

ID is a message id as search gives it, bare, as id:ID or as <ID>; thread
also takes thread:THREAD. Every command prints one JSON object,
{"ok":true,"data":...} or {"ok":false,"error":...,"hint":...}, and exits
0 ok, 1 usage, 2 not found, 3 refused. Mail text (subjects, names, bodies,
link labels, attachment names) sits between
<<<untrusted-mail>>> and <<<end-untrusted-mail>>>, and any <<< inside it
becomes ‹‹‹, so a mail cannot close its own field.
"""

import argparse
import email.policy
import html
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from email.parser import BytesHeaderParser
from email.utils import getaddresses, parseaddr

# Python would write bin/__pycache__ into the checkout on the first import.
sys.dont_write_bytecode = True
from mail_engine import (BOXES, MSMTP_ACCOUNT, AlreadySent, MailError, MissingAttachment, NotFound, Refusal, body_text, both, box_counts, boxes_of, digest, draft_message, draft_path,
                         SENDER_ACTIONS, decide, drafts, identities, idq, line, pile, refresh_count, sender, matched_messages, nm, one_message, part_sizes, search_threads,
                         send_draft, set_unread, thread_messages, thread_of, write_draft)

OPEN, CLOSE = "<<<untrusted-mail>>>", "<<<end-untrusted-mail>>>"
LIMIT_MAX = 500


class Usage(Exception):
    pass


class Refused(Exception):
    def __init__(self, error, hint="run it in a desktop session"):
        super().__init__(error)
        self.hint = hint


def missing(error, hint):
    """NotFound with the hint main() prints for it."""
    e = NotFound(error)
    e.hint = hint
    return e


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise Usage(message)


def untrusted(text):
    return OPEN + text.replace("<<<", "‹‹‹") + CLOSE


def person(header):
    return who(*parseaddr(header))


def who(name, address):
    """A name and address as the sender wrote them; parsed once, so a quote in the name cannot change the address shown."""
    name = line(name).strip()
    # An address is a short token; one holding spaces, quotes or <> is a sentence the sender wrote.
    plain = re.fullmatch(r'[^\s<>"]*', address)
    return {"name": untrusted(name) if name else None, "address": address if plain else untrusted(line(address))}


def row(m, thread, count, home):
    h, tags = m["headers"], m["tags"]
    return {
        "thread": thread,
        "id": m["id"],
        "date": datetime.fromtimestamp(m["timestamp"]).astimezone().isoformat(),
        "from": person(h.get("From", "")),
        "subject": untrusted(line(h.get("Subject", ""))),
        "tags": tags,
        "box": home,
        "screened": "screened" in tags,
        "unread": "unread" in tags,
        "count": count,
    }


def message_id(arg):
    """The Message-ID notmuch keeps for ARG: notmuch drops a Message-ID's whitespace, so the sender's own spelling finds it too."""
    s = arg[3:] if arg.startswith("id:") else arg
    if len(s) > 1 and s[0] == s[-1] == '"':
        s = s[1:-1].replace('""', '"')
    s = re.sub(r"\s", "", s)
    return s[1:-1] if s.startswith("<") and s.endswith(">") else s


def list_headers(m):
    """List-Id and List-Unsubscribe from the raw file, which notmuch's JSON leaves out."""
    for path in m.get("filename") or []:
        try:
            with open(path, "rb") as f:
                h = BytesHeaderParser(policy=email.policy.default).parse(f)
        except OSError:
            continue
        # List-Id is a phrase the sender wrote; of List-Unsubscribe only its <URI>s are kept, without the words around them.
        uris = re.findall(r"<([^<>\s]+)>", str(h["List-Unsubscribe"] or ""))
        return {"list_id": untrusted(line(h["List-Id"])) if h["List-Id"] is not None else None,
                "list_unsubscribe": ", ".join(f"<{u}>" for u in uris) or None}
    return {"list_id": None, "list_unsubscribe": None}


def message(m, thread, home):
    """A message from notmuch's JSON as show gives it."""
    h, tags = m["headers"], m["tags"]
    atts, links = [], []
    body = body_text(m.get("body", []), atts, found=links)
    sizes = part_sizes(m.get("body", []))
    people = lambda k: [who(n, a) for n, a in getaddresses([h[k]])] if h.get(k) else []
    return {
        "id": m["id"],
        "thread": thread,
        "date": datetime.fromtimestamp(m["timestamp"]).astimezone().isoformat(),
        "from": person(h.get("From", "")),
        "to": people("To"),
        "cc": people("Cc"),
        "subject": untrusted(line(h.get("Subject", ""))),
        "tags": tags,
        "box": home,
        "screened": "screened" in tags,
        "unread": "unread" in tags,
        "body": untrusted(body.rstrip("\n")),
        "links": [{"label": untrusted(line(label)), "url": url} for label, url in links],
        "attachments": [{"part": part, "name": untrusted(name), "type": ct, "size": sizes.get(part)} for part, name, ct in atts],
        **list_headers(m),
    }


def found(arg):
    """The message ARG names, or NotFound naming ARG as it was given."""
    msg_id = message_id(arg)
    try:
        return one_message(msg_id)
    except NotFound:
        raise NotFound(f"no message {arg}") from None


def cmd_show(a):
    m = found(a.id)
    return message(m, thread_of(m["id"]), boxes_of([m["id"]]).get(m["id"]))


def cmd_thread(a):
    if a.id.startswith("thread:"):
        if not re.fullmatch(r"thread:[0-9a-f]+", a.id):
            raise Usage(f"{a.id} is not a thread id; take one from a search row's thread")
        thread = a.id.removeprefix("thread:")
    else:
        thread = thread_of(found(a.id)["id"])
    msgs = sorted(thread_messages(f"thread:{thread}"), key=lambda m: m["timestamp"])
    if not msgs:
        raise NotFound(f"no thread {thread}")
    homes = boxes_of([m["id"] for m in msgs])
    return [message(m, thread, homes.get(m["id"])) for m in msgs]


def cmd_mark(a):
    msg_id = found(a.id)["id"]
    set_unread(idq(msg_id), a.unread)
    return {"id": msg_id, "unread": a.unread}


def cmd_boxes(a):
    # One batch of counts for every box, then one for each box's unread mail.
    unread = [int(n) for n in nm("count", "--batch", stdin="".join(both(b[2], "tag:unread") + "\n" for b in BOXES)).split()]
    return [{"key": b[0], "name": b[1], "total": total, "unread": u} for b, total, u in zip(BOXES, box_counts(), unread)]


def cmd_search(a):
    if not 1 <= a.limit <= LIMIT_MAX:
        raise Usage(f"limit must be 1 to {LIMIT_MAX}")
    if a.offset < 0:
        raise Usage("offset must be 0 or more")
    b = None
    if a.box:
        b = next((b for b in BOXES if b[1].lower() == a.box.lower()), None)
        if not b:
            raise Usage(f"no box named {a.box}; the boxes are {', '.join(b[1] for b in BOXES)}")
    words = " ".join(a.query)
    if not words and not b:
        raise Usage("give a query, or --box NAME")
    query = both(b[2], words) if b and words else (b[2] if b else words)
    if b and b[3]:
        # The Screener decides on people, so each mail is its own row.
        rows = [(m, thread_of(m["id"]), 1) for m in matched_messages(query)[a.offset:a.offset + a.limit]]
    else:
        # notmuch reads -tag:x alone and inside `thread:T and (...)` differently, so a listed thread may match nothing there; its newest message stands in.
        rows = [((matched_messages(both(f"thread:{t['thread']}", query)) or matched_messages(f"thread:{t['thread']}"))[0],
                 t["thread"], t["total"]) for t in search_threads(query, a.limit, a.offset)]
    homes = boxes_of([m["id"] for m, _, _ in rows])
    return [row(m, thread, count, homes.get(m["id"])) for m, thread, count in rows]


def html_part(parts):
    """The first HTML part of a MIME tree that is not an attachment, or None."""
    for p in parts:
        c = p.get("content")
        if p.get("filename") or p.get("content-disposition") == "attachment":
            continue
        if p.get("content-type", "").lower() == "text/html" and isinstance(c, str):
            return c
        if isinstance(c, list):
            found = html_part([q for q in c if "content-type" in q] + [b for inner in c for b in inner.get("body", [])])
            if found is not None:
                return found
    return None


# Tags CSP does not stop (a refresh, a dns-prefetch or preconnect, a base href) or stops only after Chromium has connected (a frame, object or embed, whose own srcdoc this never reads) are renamed into unknown elements.
INERT = re.compile(r"<(?=(?:meta|link|base|i?frame|frameset|object|embed)[\s/>])", re.I)
PREVIEW_AGE = 3600


def preview_page(mail_html, subject, images):
    """An outer page whose CSP blocks every load (images over https too, with IMAGES) around the mail in a sandboxed srcdoc iframe, which takes the outer page's policy and runs no script."""
    csp = "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'" + ("; img-src https: data:" if images else "")
    return ('<!doctype html>\n<html><head><meta charset="utf-8">\n'
            f'<meta http-equiv="Content-Security-Policy" content="{csp}">\n'
            '<meta name="referrer" content="no-referrer">\n'
            f"<title>{html.escape(line(subject))}</title>\n"
            "<style>html, body, iframe { margin: 0; border: 0; width: 100%; height: 100%; display: block; }</style>\n"
            f'</head><body><iframe sandbox srcdoc="{html.escape(INERT.sub("<x-", mail_html))}"></iframe></body></html>\n')


def cmd_preview(a):
    run = os.environ.get("XDG_RUNTIME_DIR")
    if not run:
        raise Refused("XDG_RUNTIME_DIR is not set, and a preview is written only there, never to a shared /tmp")
    m = found(a.id)
    mail_html = html_part(m.get("body", []))
    if mail_html is None:
        raise NotFound("no HTML part")
    folder = os.path.join(run, "mail-preview")
    os.makedirs(folder, mode=0o700, exist_ok=True)
    os.chmod(folder, 0o700)
    now = time.time()
    for name in os.listdir(folder):
        path = os.path.join(folder, name)
        try:
            if now - os.lstat(path).st_mtime > PREVIEW_AGE:
                os.unlink(path)
        except OSError:
            pass
    # mkstemp makes a new 0600 file with a random name, so two previews of one mail never share one.
    fd, path = tempfile.mkstemp(prefix="mail-", suffix=".html", dir=folder)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(preview_page(mail_html, m["headers"].get("Subject", ""), a.images))
    return {"path": path}


def cmd_draft_write(a):
    fields = []
    if a.sender is not None:
        addr = parseaddr(a.sender)[1].lower()
        mine = next((i for i in identities() if parseaddr(i)[1].lower() == addr), None)
        if not addr or not mine:
            raise Usage(f"{a.sender} is not one of your addresses")
        fields.append(("From", mine))
    fields += [(name, v) for name, v in (("To", a.to), ("Cc", a.cc), ("Bcc", a.bcc), ("Subject", a.subject)) if v is not None]
    attach = []
    for p in a.attach:
        p = os.path.abspath(os.path.expanduser(p))
        if not os.path.isfile(p):
            raise Usage(f"no such file: {p}")
        attach.append(p)
    text = None
    if a.body_file is not None:
        try:
            with open(a.body_file, encoding="utf-8") as f:
                text = f.read()
        except OSError as e:
            raise Usage(f"cannot read {a.body_file}: {e.strerror}") from None
    arg = None if a.kind == "new" else "id:" + found(a.id)["id"]
    path = write_draft(a.kind, arg, fields, text, attach)
    return {"id": os.path.basename(path).removesuffix(".eml"), "path": path}


def addresses(msg, name):
    return [who(n, a) for n, a in getaddresses([str(msg.get(name, ""))]) if a or n]


def draft_file(arg):
    path = draft_path(arg)
    if path is None:
        raise Usage(f"not a draft: {arg}")
    if not os.path.isfile(path):
        raise missing(f"no draft {arg}", "list them with mail drafts")
    return path


def cmd_drafts(a):
    rows = []
    for path in drafts():
        with open(path, "rb") as f:
            msg, _, _ = draft_message(f.read().decode("utf-8", "replace"))
        rows.append({"id": os.path.basename(path).removesuffix(".eml"), "path": path,
                     "date": datetime.fromtimestamp(os.stat(path).st_mtime).astimezone().isoformat(),
                     "to": addresses(msg, "To"), "subject": untrusted(line(msg.get("Subject", "")))})
    return rows


def cmd_draft_show(a):
    path = draft_file(a.draft)
    with open(path, "rb") as f:
        raw = f.read()
    # A reply quotes the sender and takes To and Cc from their headers, so the draft's text is wrapped as mail text is.
    msg, attach, body = draft_message(raw.decode("utf-8", "replace"))
    return {
        "id": os.path.basename(path).removesuffix(".eml"),
        "path": path,
        "from": person(str(msg.get("From", ""))),
        "to": addresses(msg, "To"),
        "cc": addresses(msg, "Cc"),
        "bcc": addresses(msg, "Bcc"),
        "subject": untrusted(line(msg.get("Subject", ""))),
        # A forward's attachment is saved under the sender's file name, so its path is mail text too.
        "attachments": [{"path": untrusted(line(p)), "name": untrusted(line(os.path.basename(p))),
                         "size": os.path.getsize(p) if os.path.isfile(p) else None} for p in attach],
        "body": untrusted(body.strip("\n")),
        "digest": digest(raw, attach),
    }


# pass hands these to gpg, which then fails on an uncached passphrase instead of drawing pinentry over Saiful's screen.
NO_PINENTRY = "--pinentry-mode=error"
PASS_WAIT = 3


def password_command():
    """The passwordeval of ~/.msmtprc's account, without the `| head` that would hide a failed decrypt, or None."""
    try:
        with open(os.path.expanduser("~/.msmtprc")) as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    account = None
    for l in lines:
        words = l.split(None, 1)
        if words[:1] == ["account"]:
            account = words[1].split(":")[0].strip() if len(words) > 1 else None
        elif words[:1] == ["passwordeval"] and account == MSMTP_ACCOUNT and len(words) > 1:
            cmd = words[1].strip()
            if len(cmd) > 1 and cmd[0] == cmd[-1] == '"':
                cmd = cmd[1:-1]
            return re.sub(r"\s*\|\s*head\b.*$", "", cmd)
    return None


def unlocked_env():
    """msmtp's environment, after refusing at once when the pass store would ask for its passphrase."""
    env = dict(os.environ, PASSWORD_STORE_GPG_OPTS=(os.environ.get("PASSWORD_STORE_GPG_OPTS", "") + " " + NO_PINENTRY).strip())
    cmd = password_command()
    if cmd is None:
        return env
    try:
        ok = subprocess.run(["bash", "-o", "pipefail", "-c", cmd], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, timeout=PASS_WAIT).returncode == 0
    except subprocess.TimeoutExpired:
        ok = False
    if not ok:
        raise Refused("refused: the pass store is locked",
                      f"ask Saiful to unlock it: he runs `{cmd} >/dev/null` in a terminal and types the passphrase; then send again")
    return env


def cmd_send(a):
    path = draft_file(a.draft)
    if not a.yes:
        raise Refused("refused: needs --yes", "send only after Saiful says yes to this draft in the chat, then pass --yes --digest D")
    if not a.digest:
        raise Refused("refused: needs --digest D from mail draft show", "show Saiful the draft with mail draft show, and pass its digest")
    try:
        to = send_draft(path, a.digest, unlocked_env())
    except AlreadySent as e:
        raise Refused(f"refused: {e}", "the mail went out already and is in Sent (mail search --box Sent); tell Saiful, and send nothing again") from None
    except Refusal as e:
        raise Refused(f"refused: {e}", "show the draft again with mail draft show, and ask Saiful again") from None
    except NotFound:
        raise missing(f"no draft {a.draft}", "it was sent or discarded; list the drafts with mail drafts") from None
    except MailError as e:
        if isinstance(e, MissingAttachment):
            e = MailError(f"attachment not found: {untrusted(line(e.path))}")
        # msmtp may have taken the mail before the failure, so a retry could send it twice.
        e.hint = "tell Saiful this error, and do not send again without asking him"
        raise e from None
    return {"id": os.path.basename(path).removesuffix(".eml"), "to": to}


# mail hey's action names, as kak-mail spells them.
HEY = {"screen-in": "screen-in", "feed": "feed", "papertrail": "papertrail", "replylater": "reply-later",
       "setaside": "set-aside", "bubble": "bubble", "archive": "archive", "clear": "clear", "screen-out": "screen-out"}
# One address and nothing notmuch reads as more: a * would match every sender.
ADDRESS = re.compile(r"[^\s<>\"'(),;:@*]+@[^\s<>\"'(),;:@*]+")


def cmd_hey(a):
    if a.action == "screen-out":
        # An agent screens out only a sender Saiful named, never one it read off a mail.
        if a.id is not None or not a.sender:
            raise Usage("screen-out takes --sender ADDR")
        if not ADDRESS.fullmatch(a.sender):
            raise Usage(f"{a.sender} is not one address")
        decide("screen-out", a.sender.lower())
        refresh_count()
        return {"action": a.action, "sender": a.sender.lower()}
    if a.sender is not None:
        raise Usage("--sender is only for screen-out")
    if a.id is None:
        raise Usage(f"{a.action} takes a message id")
    if a.category is not None and a.action != "papertrail":
        raise Usage("--category is only for papertrail")
    if a.at is not None and a.action != "bubble":
        raise Usage("--at is only for bubble")
    if a.action == "papertrail" and a.category is None:
        raise Usage("papertrail takes --category C")
    if a.action == "bubble" and a.at is None:
        raise Usage("bubble takes --at DATE")
    msg_id = found(a.id)["id"]
    action = HEY[a.action]
    if action in SENDER_ACTIONS:
        addr = sender(idq(msg_id))
        decide(action, addr, a.category)
        refresh_count()
        return {"action": a.action, "id": msg_id, "sender": addr}
    n, when = pile(action, [idq(msg_id)], a.at)
    refresh_count()
    return {"action": a.action, "id": msg_id, "threads": n,
            "until": datetime.fromtimestamp(when).astimezone().isoformat() if when else None}


def parser():
    p = Parser(prog="mail", description="Read mail as JSON.")
    sub = p.add_subparsers(dest="cmd", required=True, parser_class=Parser)
    sub.add_parser("boxes", help="each box with its total and unread count").set_defaults(fn=cmd_boxes)
    s = sub.add_parser("search", help="threads matching a notmuch query, newest first")
    s.add_argument("query", nargs="*", help="a notmuch query; one starting with - goes after --")
    s.add_argument("--box", help="only mail in this box, such as Imbox or Screener")
    s.add_argument("--limit", type=int, default=50, help=f"rows to return, 1 to {LIMIT_MAX}")
    s.add_argument("--offset", type=int, default=0, help="rows to skip")
    s.set_defaults(fn=cmd_search)
    for name, fn, doc in (("show", cmd_show, "one message, without marking it read"),
                          ("thread", cmd_thread, "every message of a thread, oldest first")):
        c = sub.add_parser(name, help=doc)
        c.add_argument("id", help="a message id, or for thread a thread:THREAD")
        c.set_defaults(fn=fn)
    v = sub.add_parser("preview", help="write the HTML part to a file under $XDG_RUNTIME_DIR/mail-preview that loads nothing remote")
    v.add_argument("id", help="a message id")
    v.add_argument("--images", action="store_true", help="let images over https load")
    v.set_defaults(fn=cmd_preview)
    d = sub.add_parser("draft", help="write a draft, or show one")
    dsub = d.add_subparsers(dest="kind", required=True, parser_class=Parser)
    for kind in ("new", "reply", "replyall", "forward"):
        c = dsub.add_parser(kind, help=f"a {kind} draft" if kind == "new" else f"a draft that does {kind} on the message ID")
        if kind != "new":
            c.add_argument("id", help="a message id")
        c.add_argument("--to", help="recipients, comma separated")
        c.add_argument("--cc", help="recipients, comma separated")
        c.add_argument("--bcc", help="recipients, comma separated")
        c.add_argument("--subject")
        c.add_argument("--from", dest="sender", help="one of your addresses; a new draft goes from the primary, a reply from the address it was sent to")
        c.add_argument("--body-file", help="the text of the mail, above any quote")
        c.add_argument("--attach", action="append", default=[], metavar="FILE", help="a file to attach; give it once per file")
        c.set_defaults(fn=cmd_draft_write)
    c = dsub.add_parser("show", help="what a draft sends, with the digest mail send takes")
    c.add_argument("draft", help="a draft id or path, as mail drafts gives it")
    c.set_defaults(fn=cmd_draft_show)
    sub.add_parser("drafts", help="every draft, newest first").set_defaults(fn=cmd_drafts)
    c = sub.add_parser("send", help="send a draft, only after Saiful's yes to it")
    c.add_argument("draft", help="a draft id or path, as mail drafts gives it")
    c.add_argument("--yes", action="store_true", help="Saiful said yes to this draft in the chat")
    c.add_argument("--digest", help="the digest mail draft show printed for the draft Saiful saw")
    c.set_defaults(fn=cmd_send)
    c = sub.add_parser("hey", help="file a message HEY's way; screen-out takes only --sender")
    c.add_argument("action", choices=list(HEY))
    c.add_argument("id", nargs="?", help="a message id")
    c.add_argument("--sender", help="for screen-out: the address Saiful named")
    c.add_argument("--category", help="for papertrail: letters, digits, - or _")
    c.add_argument("--at", help="for bubble: when it comes back, as date -d reads it")
    c.set_defaults(fn=cmd_hey)
    for name, unread in (("read", False), ("unread", True)):
        c = sub.add_parser(name, help=f"mark a message {name}")
        c.add_argument("id", help="a message id")
        c.set_defaults(fn=cmd_mark, unread=unread)
    return p


def emit(obj, code):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False, separators=(",", ":")) + "\n")
    sys.exit(code)


def main():
    sys.stdout.reconfigure(encoding="utf-8")
    p = parser()
    argv = sys.argv[1:]
    # A Message-ID may start with -, and argparse would read it as an option.
    if len(argv) == 2 and argv[0] in ("show", "thread", "read", "unread", "preview") and argv[1].startswith("-") and argv[1] not in ("-h", "--help", "--"):
        argv.insert(1, "--")
    try:
        a = p.parse_args(argv)
        data = a.fn(a)
    except Usage as e:
        emit({"ok": False, "error": str(e), "hint": p.format_usage().strip()}, 1)
    except NotFound as e:
        hint = getattr(e, "hint", "take ids from mail search" if str(e) != "no HTML part" else "read it with mail show")
        emit({"ok": False, "error": str(e), "hint": hint}, 2)
    except Refused as e:
        emit({"ok": False, "error": str(e), "hint": e.hint}, 3)
    except MailError as e:
        emit({"ok": False, "error": str(e), "hint": getattr(e, "hint", "notmuch failed; try again, or run mail boxes to see the store answers")}, 1)
    except Exception as e:
        # Still one JSON object, so an agent reads the failure rather than a traceback.
        emit({"ok": False, "error": f"{type(e).__name__}: {e}", "hint": "a bug in bin/mail; tell Saiful the command and this error"}, 1)
    emit({"ok": True, "data": data}, 0)


if __name__ == "__main__":
    main()
