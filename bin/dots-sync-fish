#!/usr/bin/env node
// dots-sync-fish <live> <list> <pulled>...: unions the pulled .history files into the live one, each (cmd, when) once, ordered by when, leaving out every line on the list or a pulled .forgotten list; dots-sync-fish forget <text> takes every line holding text out of it and records each as forgotten.
import { createHash } from 'node:crypto';
import { existsSync, mkdirSync, readFileSync, renameSync, statSync, unlinkSync, writeFileSync } from 'node:fs';
import { basename, dirname, join } from 'node:path';

// latin1 keeps every byte as it was, so blocks pass through without fish's escaping ever being decoded.
const read = (path) => (existsSync(path) ? readFileSync(path, 'latin1') : '');
const mtime = (path) => (existsSync(path) ? statSync(path, { bigint: true }).mtimeNs : null);

// Each block is "- cmd: ..." and its indented lines, kept verbatim; text before the first block is a broken head and is dropped.
function parse(text) {
  const out = [];
  for (const block of text.split(/^(?=- cmd: )/m)) {
    if (!block.startsWith('- cmd: ')) continue;
    const cmd = block.slice(7, block.indexOf('\n') < 0 ? undefined : block.indexOf('\n'));
    const when = Number(/^\s+when: (\d+)/m.exec(block)?.[1] ?? 0);
    out.push({ cmd, key: cmd + '\0' + when, when, block: block.endsWith('\n') ? block : block + '\n' });
  }
  return out;
}

// A forgotten line is known by the sha256 of its command and time, so the list of them holds no secret.
const hash = (e) => createHash('sha256').update(Buffer.from(e.key, 'latin1')).digest('hex');

// The command as typed: its UTF-8 bytes, with fish's \\ and \n undone.
const decode = (cmd) => Buffer.from(cmd, 'latin1').toString('utf8').replace(/\\([\\n])/g, (_, c) => (c === 'n' ? '\n' : '\\'));

// Writes text to path through a temp file beside it; false, with nothing written, when path changed since its mtime was before.
function replace(path, text, before) {
  mkdirSync(dirname(path), { recursive: true });
  const tmp = join(dirname(path), '.' + basename(path) + '.' + process.pid + '.tmp');
  writeFileSync(tmp, text, 'latin1');
  if (before !== undefined && mtime(path) !== before) {
    unlinkSync(tmp);
    return false;
  }
  renameSync(tmp, path);
  return true;
}

const hashes = (path) => read(path).split('\n').filter(Boolean);

// One try: false when fish appended while the union was built, so the caller starts again from the new file.
function round(live, list, pulled) {
  const lists = pulled.filter((f) => f.endsWith('.forgotten'));
  const known = hashes(list);
  // This machine's list takes in every pulled one, its own old file on Dropbox among them, so a reinstall gets it back before its next push.
  const forgotten = new Set(known.concat(...lists.map(hashes)));
  if (forgotten.size > known.length) replace(list, [...forgotten].map((h) => h + '\n').join(''));
  const before = mtime(live);
  const own = parse(read(live));
  const kept = (e) => forgotten.size === 0 || !forgotten.has(hash(e));
  const merged = new Map();
  for (const e of own.concat(...pulled.filter((f) => !lists.includes(f)).map((f) => parse(read(f))))) if (kept(e) && !merged.has(e.key)) merged.set(e.key, e);
  // Nothing new and nothing forgotten means no write, so the file's mtime and fish's own appends stay untouched.
  if (own.every(kept) && merged.size === new Set(own.map((e) => e.key)).size) return true;
  return replace(live, [...merged.values()].sort((x, y) => x.when - y.when).map((e) => e.block).join(''), before);
}

// One try of forget: the count it took out, or null when fish appended meanwhile. The hashes are recorded before the history is cut, so a cut lost here is still made at the next round.
function forgetRound(live, list, text) {
  const before = mtime(live);
  const own = parse(read(live));
  const gone = text === '' ? new Set() : new Set(own.filter((e) => decode(e.cmd).includes(text)));
  if (gone.size === 0) return 0;
  const known = read(list).split('\n').filter(Boolean);
  replace(list, [...new Set(known.concat([...gone].map(hash)))].map((h) => h + '\n').join(''));
  return replace(live, own.filter((e) => !gone.has(e)).map((e) => e.block).join(''), before) ? gone.size : null;
}

function forget(args) {
  // A text that looks like a flag goes after --, so dots forget --help is never a forget of every line holding --help.
  if (args[0] === '--') args = args.slice(1);
  else if (args[0]?.startsWith('-')) args = [];
  if (args.length !== 1) {
    process.stderr.write('usage: dots forget [--] <text>\n');
    process.exit(2);
  }
  const share = process.env.XDG_DATA_HOME || join(process.env.HOME, '.local/share');
  for (let i = 0; i < 3; i++) {
    const n = forgetRound(join(share, 'fish/fish_history'), join(share, 'dots/fish/forgotten'), args[0]);
    if (n === null) continue;
    process.stdout.write(`forgot ${n} line${n === 1 ? '' : 's'}\n`);
    if (n > 0) process.stdout.write('a secret typed in a forgotten line is still out there: rotate it; open fish sessions keep the line until they restart\n');
    process.exit(0);
  }
  process.stderr.write('fish: the live history kept changing, so its lines are recorded as forgotten and go at the next dots sync\n');
  process.exit(1);
}

if (process.argv[2] === 'forget') forget(process.argv.slice(3));
const [live, list, ...pulled] = process.argv.slice(2);
if (!live || !list) {
  process.stderr.write('usage: dots-sync-fish <live> <list> <pulled>...\n');
  process.exit(2);
}
// A list that does not parse could hold a line that must stay gone, so nothing merges or goes up until it is fixed.
for (const f of [list].concat(pulled.filter((f) => f.endsWith('.forgotten')))) {
  if (hashes(f).some((h) => !/^[0-9a-f]{64}$/.test(h))) {
    process.stderr.write(`fish: ${f === list ? f : basename(f)} is not a list of forgotten lines, so this round left the history alone\n`);
    process.exit(1);
  }
}
for (let i = 0; i < 3; i++) if (round(live, list, pulled)) process.exit(0);
process.stderr.write('fish: the live history kept changing, so this round left it alone\n');
process.exit(1);
