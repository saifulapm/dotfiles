#!/usr/bin/env node
// Prints every account limit and balance as one JSON array of rows. `--cached` prints each source's last good rows from the cache, with no network. Each source is one entry in sources(): a name for its cache file, the placeholder row's names, and run(signal), which resolves its rows or throws Failure.
import { existsSync, mkdirSync, openSync, closeSync, readFileSync, renameSync, statSync, unlinkSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { spawn } from 'node:child_process';

const env = process.env;
// Only a test shortens the limit.
const LIMIT_MS = Number(env.DOTS_ACCOUNTS_LIMIT_MS) || 10000;
const STATE = env.XDG_STATE_HOME || env.HOME + '/.local/state';
const CACHE = join(env.XDG_CACHE_HOME || env.HOME + '/.cache', 'dots', 'accounts');
const ANTHROPIC = env.DOTS_ACCOUNTS_ANTHROPIC_URL || 'https://api.anthropic.com';
const ELEVENLABS = env.DOTS_ACCOUNTS_ELEVENLABS_URL || 'https://api.elevenlabs.io';
const FAL = env.DOTS_ACCOUNTS_FAL_URL || 'https://api.fal.ai';
const JINA = env.DOTS_ACCOUNTS_JINA_URL || 'https://embeddings-dashboard-api.jina.ai';
const CONTEXT7 = env.DOTS_ACCOUNTS_CONTEXT7_URL || 'https://context7.com';
const AUTH = new Set(['expired', 'forbidden', 'locked', 'no-key']);

// A source's failure carries only a reason from the fixed list, never text from a response.
class Failure extends Error {
  constructor(reason) {
    super(reason);
    this.reason = reason;
  }
}

// Seconds precision, in UTC, so no local time zone reaches a row.
const iso = (t) => {
  const d = new Date(t);
  return isNaN(d) ? null : d.toISOString().replace(/\.\d{3}Z$/, 'Z');
};

const readJSON = (path) => {
  try {
    return JSON.parse(readFileSync(path, 'utf8'));
  } catch {
    return null;
  }
};

// One request, never retried; the status alone picks the reason. A 401 means an expired login for Claude and a bad key for a source that reads its key from pass, so the caller names it.
async function fetchJSON(url, headers, signal, unauthorized = 'expired') {
  let res;
  try {
    res = await fetch(url, { headers, signal });
  } catch (e) {
    throw new Failure(e.name === 'TimeoutError' ? 'timeout' : 'network');
  }
  if (res.status === 401) throw new Failure(unauthorized);
  if (res.status === 403) throw new Failure('forbidden');
  if (res.status === 429) throw new Failure('rate-limited');
  if (!res.ok) throw new Failure('network');
  try {
    return await res.json();
  } catch {
    throw new Failure('shape');
  }
}

function registry() {
  const reg = readJSON(join(STATE, 'dots', 'claude-accounts.json'));
  const accounts = reg ? reg.accounts : [{ id: 'main', label: 'main', home: env.HOME + '/.claude' }];
  // The id names a cache file, so anything but the label alphabet is refused.
  return Array.isArray(accounts) ? accounts.filter((a) => a && typeof a.id === 'string' && /^[a-z0-9-]+$/.test(a.id)) : [];
}

// The model name comes from the response: one line of letters, digits, spaces, dots and dashes, 32 at most.
const modelName = (scope) => {
  const name = scope && scope.model && scope.model.display_name;
  return typeof name === 'string' ? name.replace(/[^\p{L}\p{N} .-]/gu, '').trim().slice(0, 32) : '';
};

function claudeRows(account, body) {
  if (!body || !Array.isArray(body.limits)) throw new Failure('shape');
  const rows = [];
  for (const l of body.limits) {
    if (!l || typeof l.percent !== 'number' || !isFinite(l.percent)) continue;
    let metric = { session: '5-hour', weekly_all: 'weekly' }[l.kind];
    if (l.kind === 'weekly_scoped' && modelName(l.scope)) metric = 'weekly ' + modelName(l.scope);
    if (!metric) continue;
    rows.push({ ...names(account), metric, kind: 'percent', value: l.percent, limit: 100, unit: '%', resets_at: l.resets_at ? iso(l.resets_at) : null });
  }
  // Limits that name nothing known mean the endpoint changed shape, so the cache stays and serves stale.
  if (!rows.length) throw new Failure('shape');
  // A subscription's API credit sits in a bucket under a codename, so any bucket with a dollar grant is read, whatever its name.
  for (const b of Object.values(body)) {
    if (b && num(b.limit_dollars) !== null && num(b.remaining_dollars) !== null) rows.push({ ...names(account), metric: 'credit', kind: 'money', value: num(b.remaining_dollars), limit: num(b.limit_dollars), unit: 'USD', resets_at: b.resets_at ? iso(b.resets_at) : null });
  }
  return rows;
}

const names = (account) => ({ provider: 'claude', label: account.id, account: account.id, kind: 'percent' });

// The credentials file is only read, and only the access token and its expiry; the refresh token stays where it is.
async function claude(account, signal) {
  if (typeof account.home !== 'string' || !existsSync(account.home)) throw new Failure('no-home');
  const oauth = (readJSON(join(account.home, '.credentials.json')) || {}).claudeAiOauth;
  if (!oauth || typeof oauth.accessToken !== 'string') throw new Failure('no-key');
  if (typeof oauth.expiresAt !== 'number' || oauth.expiresAt <= Date.now()) throw new Failure('expired');
  const headers = { authorization: 'Bearer ' + oauth.accessToken, 'anthropic-beta': 'oauth-2025-04-20' };
  return claudeRows(account, await fetchJSON(ANTHROPIC + '/api/oauth/usage', headers, signal));
}

// A child runs in its own process group so killing it takes its helpers too, and the limit's abort kills it.
function exec(cmd, args, signal) {
  return new Promise((resolve, reject) => {
    const child = spawn(cmd, args, { env: { ...env, PASSWORD_STORE_GPG_OPTS: '--pinentry-mode error' }, detached: true, stdio: ['ignore', 'pipe', 'pipe'] });
    let stdout = '';
    let stderr = '';
    child.stdout.on('data', (d) => (stdout += d));
    child.stderr.on('data', (d) => (stderr += d));
    signal.addEventListener('abort', () => (killGroup(child), reject(new Failure('timeout'))), { once: true });
    child.on('error', (e) => reject(new Failure(e.code === 'ENOENT' ? 'no-key' : 'network')));
    child.on('close', (code) => resolve({ code, stdout, stderr }));
  });
}

const killGroup = (child) => {
  try {
    process.kill(-child.pid, 'SIGKILL');
  } catch {}
};

// pass runs with no passphrase prompt: a locked store fails at once and says so on stderr.
// An entry's lines, the key first.
async function entry(name, signal) {
  const r = await exec('pass', ['show', name], signal);
  if (r.code !== 0) throw new Failure(/pinentry|decryption failed/.test(r.stderr) ? 'locked' : 'no-key');
  const lines = r.stdout.split('\n').map((l) => l.trim());
  if (!lines[0]) throw new Failure('no-key');
  return lines;
}

const key = async (name, signal) => (await entry(name, signal))[0];

// Text from a response reaches a row only as a number or as a three-letter currency code.
const num = (v) => (typeof v === 'number' && isFinite(v) ? Math.round(v * 1e6) / 1e6 : null);
const amount = (v) => (typeof v === 'string' && v.trim() !== '' ? num(Number(v)) : null);
const currency = (v) => (typeof v === 'string' && /^[A-Za-z]{3}$/.test(v) ? v.toUpperCase() : 'USD');
const unix = (v) => (typeof v === 'number' ? iso(v * 1000) : null);

// The kind travels with the names, so a placeholder still says which group of the card it belongs to.
const own = (provider, label, kind = 'money') => ({ provider, label, account: null, kind });
const money = (names, value, limit, unit) => ({ ...names, metric: 'balance', kind: 'money', value, limit, unit, resets_at: null });

async function elevenlabs(signal) {
  const body = await fetchJSON(ELEVENLABS + '/v1/user/subscription', { 'xi-api-key': await key('AI/elevenlabs/main', signal) }, signal, 'no-key');
  const used = num(body && body.character_count);
  const cap = num(body && body.character_limit);
  if (used === null || cap === null) throw new Failure('shape');
  return [{ ...own('elevenlabs', 'ElevenLabs'), metric: 'characters', kind: 'count', value: used, limit: cap, unit: 'characters', resets_at: unix(body.next_character_count_reset_unix) }];
}

// The billing key has the usage scope; the main key is the fallback when the billing key is not in the store.
async function fal(signal) {
  let k;
  try {
    k = await key('AI/fal/billing', signal);
  } catch (e) {
    if (!(e instanceof Failure) || e.reason !== 'no-key') throw e;
    k = await key('AI/fal/main', signal);
  }
  const body = await fetchJSON(FAL + '/v1/account/billing?expand=credits', { authorization: 'Key ' + k }, signal, 'no-key');
  const left = num(body && body.credits && body.credits.current_balance);
  if (left === null) throw new Failure('shape');
  return [money(own('fal', 'fal'), left, null, currency(body.credits.currency))];
}

// Jina's dashboard reads the wallet with the key in the query; it takes no header. The balance is in tokens.
async function jina(signal) {
  const k = await key('AI/jina-reader/main', signal);
  const body = await fetchJSON(JINA + '/api/v1/api_key/user?api_key=' + encodeURIComponent(k), {}, signal, 'no-key');
  const left = num(body && body.wallet && body.wallet.total_balance);
  if (left === null) throw new Failure('shape');
  return [{ ...own('jina', 'Jina', 'tokens'), metric: 'balance', value: left, limit: null, unit: 'tokens', resets_at: null }];
}

// Context7's requests this month against the plan's, per key; reading them costs no request.
const CONTEXT7_KEYS = { main: 'AI/context7/main', alt: 'AI/context7/alt', clt: 'AI/context7/clt' };
async function context7(id, signal) {
  const body = await fetchJSON(CONTEXT7 + '/api/v2/usage?days=1', { authorization: 'Bearer ' + (await key(CONTEXT7_KEYS[id], signal)) }, signal, 'no-key');
  const used = num(body && body.member && body.member.requests);
  const cap = num(body && body.member && body.member.includedInPlan);
  if (used === null || cap === null) throw new Failure('shape');
  return [{ ...own('context7', 'Context7 ' + id, 'count'), metric: 'requests', value: used, limit: cap, unit: 'requests', resets_at: typeof body.usageResetsAt === 'string' ? iso(body.usageResetsAt) : null }];
}

// A Console org's spend in cents since a time, from the daily cost report, page by page. cost_report is the legacy endpoint, kept because analytics/cost needs read:analytics, which an Admin key lacks. It allows 90 requests a window, so a day two days past its end, which no longer changes, is summed into the org's cache file, and a run asks only for the days after the last one kept.
const SETTLED_MS = 2 * 86400000;
async function cost(org, from, headers, signal) {
  const name = `anthropic-${org}-days`;
  const kept = readJSON(join(CACHE, name + '.json'));
  const known = kept && kept.from === from && typeof kept.until === 'string' && num(kept.cents) !== null;
  const start = known ? kept.until : from;
  let settled = known ? kept.cents : 0;
  let until = start;
  let cents = settled;
  let open = false;
  let page = null;
  do {
    const url = `${ANTHROPIC}/v1/organizations/cost_report?starting_at=${start}&limit=31` + (page ? '&page=' + encodeURIComponent(page) : '');
    const body = await fetchJSON(url, headers, signal, 'no-key');
    if (!body || !Array.isArray(body.data)) throw new Failure('shape');
    for (const day of body.data) {
      let c = 0;
      for (const r of (day && Array.isArray(day.results) && day.results) || []) {
        const v = amount(r && r.amount);
        if (v === null) throw new Failure('shape');
        c += v;
      }
      cents += c;
      const end = Date.parse(day && day.ending_at);
      if (!open && end <= Date.now() - SETTLED_MS) {
        settled += c;
        until = iso(end);
      } else open = true;
    }
    page = body.has_more ? body.next_page : null;
    if (body.has_more && typeof page !== 'string') throw new Failure('shape');
  } while (page);
  mkdirSync(CACHE, { recursive: true });
  save(name, { from, until, cents: settled });
  return cents;
}

// No key can read a Console org's credit, so its grants are lines under the key in pass: `grant <dollars> <granted YYYY-MM-DD> <expires YYYY-MM-DD>`, dates in UTC as the Console shows them. A grant lasts through its expiry day.
const GRANT = /^grant\s+(\d+(?:\.\d+)?)\s+(\d{4}-\d{2}-\d{2})\s+(\d{4}-\d{2}-\d{2})$/;
const day = (d) => Date.parse(d + 'T00:00:00Z');

// With grants in force, what is left of them: their total less all spend since the first was granted. With none, the spend since the first of this UTC month.
async function anthropic(org, signal) {
  const lines = await entry(`AI/anthropic/${org}-admin`, signal);
  const headers = { 'x-api-key': lines[0], 'anthropic-version': '2023-06-01' };
  const names = own('anthropic', 'Anthropic ' + org);
  const grants = lines
    .map((l) => GRANT.exec(l))
    .filter((m) => m && !isNaN(day(m[2])) && Date.now() < day(m[3]) + 86400000)
    .map((m) => ({ dollars: Number(m[1]), from: day(m[2]), until: day(m[3]) }));
  if (grants.length) {
    const total = grants.reduce((t, g) => t + g.dollars, 0);
    const spent = (await cost(org, iso(Math.min(...grants.map((g) => g.from))), headers, signal)) / 100;
    return [{ ...names, metric: 'grant', kind: 'money', value: num(Math.max(0, total - spent)), limit: num(total), unit: 'USD', resets_at: iso(Math.min(...grants.map((g) => g.until))) }];
  }
  const now = new Date();
  const cents = await cost(org, iso(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1)), headers, signal);
  return [{ ...names, metric: 'this month', kind: 'spend', value: num(cents / 100), limit: null, unit: 'USD', resets_at: null }];
}

// pxy names its providers; only these have a balance body read here, under the label the card shows.
const PXY = { 'deepseek-ai': 'DeepSeek', openrouter: 'OpenRouter' };

// The shapes pxy's own parsers know for those providers, tried in its order. A shape none of them knows returns null.
function balances(data, names) {
  const d = data.data;
  if (d && num(d.total_credits) !== null && num(d.total_usage) !== null) return [money(names, num(d.total_credits - d.total_usage), num(d.total_credits), 'USD')];
  if (Array.isArray(data.balance_infos) && data.balance_infos.length) {
    const rows = data.balance_infos.map((b) => (amount(b && b.total_balance) === null ? null : money(names, amount(b.total_balance), null, currency(b.currency))));
    return rows.includes(null) ? null : rows;
  }
  return null;
}

const failed = (names, reason) => ({ ...names, metric: null, kind: names.kind || null, value: null, limit: null, unit: null, resets_at: null, reason });

// A provider pxy could not read says why in a summary; the summary only picks one of the fixed reasons.
function pxyReason(summary) {
  if (typeof summary !== 'string') return 'network';
  if (summary.includes('No pinentry')) return 'locked';
  return /^(credential|balance_key) error/.test(summary) ? 'no-key' : 'network';
}

// One source, many rows: a provider that failed is a row with its own reason, and the frame turns it into stale or a placeholder.
async function pxy(signal) {
  const r = await exec('pxy', ['status', '--remote', '--json'], signal);
  let remote;
  try {
    remote = JSON.parse(r.stdout).remote;
  } catch {}
  if (!remote || typeof remote !== 'object') throw new Failure(r.code === 0 ? 'shape' : 'network');
  return Object.keys(PXY)
    .filter((k) => remote[k])
    .flatMap((k) => {
      const names = own(k, PXY[k]);
      const entry = remote[k];
      if (!entry.data || typeof entry.data !== 'object') return [failed(names, pxyReason(entry.summary))];
      return balances(entry.data, names) || [failed(names, 'shape')];
    });
}

function sources() {
  const claudes = registry().map((a) => ({ name: 'claude-' + a.id, names: names(a), run: (signal) => claude(a, signal) }));
  return [
    ...claudes,
    { name: 'pxy', names: own('pxy', 'pxy'), run: pxy },
    { name: 'elevenlabs', names: own('elevenlabs', 'ElevenLabs', 'count'), run: elevenlabs },
    { name: 'fal', names: own('fal', 'fal'), run: fal },
    ...['main', 'alt'].map((org) => ({ name: 'anthropic-' + org, names: own('anthropic', 'Anthropic ' + org), run: (signal) => anthropic(org, signal) })),
    { name: 'jina', names: own('jina', 'Jina', 'tokens'), run: jina },
    ...Object.keys(CONTEXT7_KEYS).map((id) => ({ name: 'context7-' + id, names: own('context7', 'Context7 ' + id, 'count'), run: (signal) => context7(id, signal) })),
  ];
}

const cached = (name) => {
  const rows = readJSON(join(CACHE, name + '.json'));
  return Array.isArray(rows) ? rows : null;
};

// What a failure shows: the cached rows as stale, or one placeholder row. `only` limits the cached rows to one provider's, for a source with many.
function fallback(source, reason, now, names = source.names, only) {
  const old = (cached(source.name) || []).filter((r) => !only || r.provider === only);
  if (old.length) return { shown: old.map((r) => ({ ...r, state: 'stale', reason })), kept: old };
  const state = AUTH.has(reason) ? 'auth' : 'error';
  return { shown: [{ ...failed(names, reason), as_of: now, state }], kept: [] };
}

// Runs one source within the limit. A source that throws shows its fallback; a row that carries its own reason shows that provider's fallback beside the rows that were read. The cache keeps the good rows and the old rows of providers that failed.
async function settle(source) {
  const now = iso(Date.now());
  const signal = AbortSignal.timeout(LIMIT_MS);
  const late = new Promise((_, reject) => signal.addEventListener('abort', () => reject(new Failure('timeout')), { once: true }));
  try {
    const rows = await Promise.race([source.run(signal), late]);
    const shown = [];
    const kept = [];
    for (const r of rows) {
      if (r.reason) {
        const f = fallback(source, r.reason, now, r, r.provider);
        shown.push(...f.shown);
        kept.push(...f.kept);
      } else {
        const ok = { ...r, as_of: now, state: 'ok', reason: null };
        shown.push(ok);
        kept.push(ok);
      }
    }
    return { fresh: shown.some((r) => r.state === 'ok'), rows: shown, kept };
  } catch (e) {
    return { rows: fallback(source, e instanceof Failure ? e.reason : 'shape', now).shown };
  }
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

// Two collectors write the cache one at a time: the lock file is created exclusively, and one older than 15 s was left by a collector that died holding it.
async function locked(write) {
  mkdirSync(CACHE, { recursive: true });
  const lock = join(CACHE, '.lock');
  for (let tries = 0; ; tries++) {
    try {
      closeSync(openSync(lock, 'wx'));
      break;
    } catch (e) {
      if (e.code !== 'EEXIST') throw e;
      try {
        if (Date.now() - statSync(lock).mtimeMs > 15000) unlinkSync(lock);
      } catch {}
      if (tries >= 250) return;
      await sleep(20);
    }
  }
  try {
    write();
  } finally {
    unlinkSync(lock);
  }
}

// A reader only ever sees a whole file: each write goes to a temp file renamed over the old one.
function save(name, rows) {
  const tmp = join(CACHE, `.${name}.${process.pid}.tmp`);
  writeFileSync(tmp, JSON.stringify(rows));
  renameSync(tmp, join(CACHE, name + '.json'));
}

async function main() {
  const list = sources();
  let out;
  if (process.argv[2] === '--cached') {
    out = list.flatMap((s) => cached(s.name) || []);
  } else {
    const results = await Promise.all(list.map(settle));
    await locked(() => results.forEach((r, i) => r.fresh && save(list[i].name, r.kept)));
    out = results.flatMap((r) => r.rows);
  }
  // Exits at once so a source still running past its limit cannot hold the process.
  process.stdout.write(JSON.stringify(out) + '\n', () => process.exit(0));
}

main();
