#!/usr/bin/env bash
# qshell-sync — one sync round against the Dropbox hub. Ours; the structural
# idea (each device writes ONLY its own file into a shared folder, so
# conflicts are impossible by construction) is omarchy's model-usage sync
# invariant (CREDITS.md), applied to real files with rclone as the transport.
#
# What moves, and how:
#
#   history      ~/.local/state/qshell/sync/history/<machine>.history
#                PUSH only this machine's file, PULL everyone else's.
#                Append-only by nature, so plain `rclone copy` both ways is
#                conflict-free — nothing ever writes another machine's file.
#                bashrc.d/20-history.sh is the consumer: bash appends to its
#                own file and reads the union.
#
#   fish history ~/.local/share/fish/<machine_slug>_history
#                Push-own / pull-others like bash history, then
#                bin/fish-history-merge unions the pulled files into the
#                local session file (fish cannot read foreign session files
#                the way bash reads foreign HISTFILEs). See the section
#                comment below for the convergence trade-off.
#
#   model-usage  ~/.local/state/qshell/sync/model-usage/<machine>.json
#                Same push-own / pull-others shape as history. The files are
#                Services/Sync.qml's per-device snapshots (shell.json's sync
#                block points there); the AI widget merges whatever the pull
#                brings on its next publish cycle.
#
#   screenshots  ~/Pictures/Screenshots  <->  Dropbox:qshell-sync/screenshots
#                `rclone bisync`, so pruning a screenshot on one machine
#                deletes it everywhere. The first run (and recovery after an
#                interrupted one) needs `--resync`, which this script does by
#                itself when bisync asks for it — that one round is
#                union-only, so a deletion made just before it can resurrect
#                once. Said loudly when it happens.
#
#   notes        ~/.local/state/qshell/notes  <->  Dropbox:qshell-sync/notes
#                The Notes panel's store (Modules/Notes): notes.json plus the
#                pasted-image attachments dir. Same bisync shape as
#                screenshots — notes are edited on every machine and a
#                delete must propagate. The store's FileView watches the
#                file, so a pulled change lands in an open panel by itself.
#                last-capture.sha1 (the shift-shift dedupe) is machine-local
#                state and stays out; attachments referencing files OUTSIDE
#                the store (drops from ~/Downloads) never travel — only the
#                store dir does.
#
# No mount involved anywhere: rclone talks to Dropbox directly, so this runs
# whether or not any remote is mounted. Fired by qshell-sync.timer every 15
# minutes and by hand; a flock keeps the two from overlapping.
#
# Failures land in ~/.local/state/qshell/sync/status.json (error and empty
# stay distinguishable) and notify ONCE per failure streak — a 15-minute
# timer must not nag every round. Auth rot and a full Dropbox are named as
# themselves; the free space on this account is thin (~60 MiB, 2026-08-06),
# so the quota message is expected to matter someday.
set -euo pipefail

remote="Dropbox:qshell-sync"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/qshell"
sync_dir="$state_dir/sync"
hist_dir="$sync_dir/history"
shots_dir="$HOME/Pictures/Screenshots"
status_file="$sync_dir/status.json"

machine="$(cat "$HOME/.config/qshell/machine" 2>/dev/null || true)"
[[ -z $machine ]] && machine="$(uname -n)"

mkdir -p "$hist_dir" "$shots_dir"

# One round at a time: the timer and a hand-run must not interleave bisync.
exec 9>>"$sync_dir/.lock"
if ! flock -n 9; then
  echo "qshell-sync: another round is already running" >&2
  exit 0
fi

# Unconfigured is not an error either: on a fresh machine the timer's first
# tick (OnStartupSec=3min) lands long before the documented manual
# `rclone config` step, and without this guard that round raised a confusing
# "Sync failed: didn't find section in config file" notification and left the
# unit failed (audit 2026-08-07). Quiet skip; ok stays null (not false) so the
# first real success never raises a phantom "Sync recovered" toast, and the
# distinct errorKind names the state for anyone reading status.json.
# `grep -x >/dev/null`, never `grep -qx`: -q exits at the first match, which
# SIGPIPEs rclone mid-write and makes pipefail report 141 for a found remote.
if ! rclone listremotes 2>/dev/null | grep -x "${remote%%:*}:" >/dev/null; then
  echo "qshell-sync: rclone remote ${remote%%:*}: not configured — skipped (run: rclone config)"
  mkdir -p "$sync_dir"
  tmp="$(mktemp "$status_file.XXXXXX")"
  jq -cn --arg machine "$machine" --arg when "$(date -Is)" \
    '{ok: null, machine: $machine, lastRun: $when, error: "rclone remote not configured", errorKind: "unconfigured", resynced: false}' >"$tmp"
  mv "$tmp" "$status_file"
  exit 0
fi

# Offline is not an error — the next round will catch up. Only a firm "none"
# skips: "unknown" (connectivity checking disabled) must still try.
if command -v nmcli >/dev/null 2>&1; then
  connectivity="$(nmcli -t -f CONNECTIVITY general 2>/dev/null || true)"
  if [[ $connectivity == "none" ]]; then
    echo "qshell-sync: offline, skipped"
    exit 0
  fi
fi

failures=()
resynced=false

# Run one rclone verb, keeping stderr for classification. A failure is
# recorded, never fatal — the other half of the round still deserves its try.
run_rclone() { # label, argv...
  local label="$1"
  shift
  local rc=0 err=""
  err="$(rclone "$@" 2>&1 >/dev/null)" || rc=$?
  if ((rc != 0)); then
    local first_line
    first_line="$(head -n 1 <<<"$err")"
    failures+=("$label: ${first_line:-rclone exited $rc}")
    return 1
  fi
  return 0
}

# ------------------------------------------------------------------ history
# Push only our own file; pull everything but it. The exclusion is what keeps
# a pull from clobbering appends made since the push.
if [[ -f "$hist_dir/$machine.history" ]]; then
  run_rclone "history push" copyto "$hist_dir/$machine.history" "$remote/history/$machine.history" || true
else
  echo "qshell-sync: no local history file yet ($hist_dir/$machine.history), nothing to push"
fi
run_rclone "history pull" copy "$remote/history" "$hist_dir" --exclude "$machine.history" || true

# ------------------------------------------------------------- fish history
# Same push-own / pull-others shape, plus an import step bash never needed:
# fish cannot read another session's file, so pulled files stage under the
# sync dir (NOT ~/.local/share/fish — fish must never see them as sessions)
# and bin/fish-history-merge unions them into the local session file. The
# push runs FIRST, so the hub copy of this machine's file converges toward
# the union one round late — accepted: identity is (cmd, when), the union is
# monotone, and one writer per hub file still holds. Session slug mirrors
# conf.d/10-history.fish: fish session names are [a-zA-Z0-9_] only.
fish_slug="${machine//[^a-zA-Z0-9_]/_}"
fish_local="$HOME/.local/share/fish/${fish_slug}_history"
fish_stage="$sync_dir/fish-history"
mkdir -p "$fish_stage"
if [[ -f $fish_local ]]; then
  run_rclone "fish-history push" copyto "$fish_local" "$remote/fish-history/${fish_slug}_history" || true
fi
run_rclone "fish-history pull" copy "$remote/fish-history" "$fish_stage" --exclude "${fish_slug}_history" || true
shopt -s nullglob
fish_remote_files=("$fish_stage"/*_history)
shopt -u nullglob
if ((${#fish_remote_files[@]} > 0)); then
  merge_err="$("$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/fish-history-merge" "$fish_local" "${fish_remote_files[@]}" 2>&1)" \
    || failures+=("fish-history merge: ${merge_err:-merge failed}")
fi

# -------------------------------------------------------------- model-usage
# Services/Sync.qml's snapshots: same one-writer-per-device shape as history.
usage_dir="$sync_dir/model-usage"
mkdir -p "$usage_dir"
if [[ -f "$usage_dir/$machine.json" ]]; then
  run_rclone "model-usage push" copyto "$usage_dir/$machine.json" "$remote/model-usage/$machine.json" || true
fi
run_rclone "model-usage pull" copy "$remote/model-usage" "$usage_dir" --exclude "$machine.json" || true

# -------------------------------------------------------------- screenshots
# bisync needs both ends to exist, and demands --resync on its first run and
# after a run that died mid-flight. Detect that exact ask and answer it once.
bisync_err=""
bisync_rc=0
bisync_err="$(rclone bisync "$shots_dir" "$remote/screenshots" --resilient --recover 2>&1 >/dev/null)" || bisync_rc=$?
if ((bisync_rc != 0)); then
  if grep -q -i -e "--resync" -e "cannot find prior" <<<"$bisync_err"; then
    resynced=true
    run_rclone "screenshots resync" mkdir "$remote/screenshots" || true
    if ! run_rclone "screenshots bisync --resync" bisync "$shots_dir" "$remote/screenshots" --resync --resilient --recover; then
      : # recorded by run_rclone
    fi
  else
    first_line="$(head -n 1 <<<"$bisync_err")"
    failures+=("screenshots bisync: ${first_line:-rclone exited $bisync_rc}")
  fi
fi

# -------------------------------------------------------------------- notes
# Same bisync-with-self-service---resync shape as screenshots above.
notes_dir="$state_dir/notes"
mkdir -p "$notes_dir/attachments"
notes_err=""
notes_rc=0
notes_err="$(rclone bisync "$notes_dir" "$remote/notes" --resilient --recover --exclude last-capture.sha1 2>&1 >/dev/null)" || notes_rc=$?
if ((notes_rc != 0)); then
  if grep -q -i -e "--resync" -e "cannot find prior" <<<"$notes_err"; then
    resynced=true
    run_rclone "notes resync" mkdir "$remote/notes" || true
    if ! run_rclone "notes bisync --resync" bisync "$notes_dir" "$remote/notes" --resync --resilient --recover --exclude last-capture.sha1; then
      : # recorded by run_rclone
    fi
  else
    first_line="$(head -n 1 <<<"$notes_err")"
    failures+=("notes bisync: ${first_line:-rclone exited $notes_rc}")
  fi
fi

# ------------------------------------------------------------------- status
# Name the failure for what it is: an expired/revoked token and a full
# Dropbox have fixes only a human can run, and deserve their own words.
error_text=""
error_kind=""
if ((${#failures[@]} > 0)); then
  error_text="$(printf '%s; ' "${failures[@]}")"
  error_text="${error_text%; }"
  lowered="${error_text,,}"
  if [[ $lowered == *"insufficient space"* || $lowered == *"quota"* || $lowered == *"507"* ]]; then
    error_kind="quota"
  elif [[ $lowered == *"oauth"* || $lowered == *"token"* || $lowered == *"unauthorized"* || $lowered == *"401"* || $lowered == *"expired"* || $lowered == *"reconnect"* ]]; then
    error_kind="auth"
  else
    error_kind="other"
  fi
fi

previous_ok="unknown"
if [[ -f $status_file ]]; then
  previous_ok="$(jq -r 'if .ok == true then "true" elif .ok == false then "false" else "unknown" end' "$status_file" 2>/dev/null || echo unknown)"
fi

tmp="$(mktemp "$status_file.XXXXXX")"
jq -cn \
  --arg machine "$machine" \
  --arg when "$(date -Is)" \
  --argjson ok "$([[ -z $error_text ]] && echo true || echo false)" \
  --arg error "$error_text" \
  --arg errorKind "$error_kind" \
  --argjson resynced "$resynced" \
  '{ok: $ok, machine: $machine, lastRun: $when, error: $error, errorKind: $errorKind, resynced: $resynced}' >"$tmp"
mv "$tmp" "$status_file"

notify() { # summary, body
  notify-send -a qshell "$1" "${2:-}" >/dev/null 2>&1 || true
}

if [[ -n $error_text ]]; then
  echo "qshell-sync: FAILED — $error_text" >&2
  # One notification per failure streak, not one per 15-minute round.
  if [[ $previous_ok != "false" ]]; then
    case $error_kind in
    quota)
      notify "Sync: Dropbox is full" "Free up space or upgrade — history and screenshots are not syncing. $error_text"
      ;;
    auth)
      notify "Sync: Dropbox needs re-authorizing" "Run in a terminal:  rclone config reconnect Dropbox:  — until then nothing syncs. $error_text"
      ;;
    *)
      notify "Sync failed" "$error_text"
      ;;
    esac
  fi
  exit 1
fi

if [[ $previous_ok == "false" ]]; then
  notify "Sync recovered" "History and screenshots are syncing again"
fi
# Not `$resynced && echo`: a false left side would be this script's last
# status and set -e would turn a clean round into exit 1.
if [[ $resynced == true ]]; then
  echo "qshell-sync: screenshots pair was (re)bootstrapped with --resync — deletions did not propagate this round"
fi
echo "qshell-sync: ok"
