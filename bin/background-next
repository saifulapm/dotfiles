#!/usr/bin/env bash
# background-next — the wallpaper cycle, and the only place that knows how
# wallpapers are enumerated. Shared by bin/theme-set (which advances on every
# re-apply of the active theme) and by the shell's picker.
#
#   background-next             advance to the next candidate
#   background-next --peek      print what the advance would choose, change nothing
#   background-next --list      print the candidates, one per line as
#                               path<TAB>thumbnail (thumbnail column omitted
#                               only if bin/wallpaper-thumbs falls back)
#   background-next --current   print the active wallpaper
#   background-next --set PATH  make PATH the active wallpaper
#
# --peek exists for bin/theme-set's synchronized switch: the shell needs the
# chosen path in the IPC push BEFORE the state file changes, or the file
# watch would start an uncoordinated transition first.
#
# Candidates are omarchy-theme-bg-next's merged sources adapted to our layout
# (CREDITS.md): the active theme's backgrounds first, then the user's own
# ~/Pictures/Wallpapers. Neither directory is ever created. Same-named files
# collide the way their picker collides them — first listed wins.
#
# The active wallpaper is a REGULAR file written atomically (tmp + same-dir
# mv); the shell's Background module watches it. Never a symlink: repointing
# one is invisible to the inotify watch (see bin/theme-set).
set -euo pipefail

state_dir="$HOME/.local/state/qshell"
state="$state_dir/background"
name_file="$state_dir/theme.name"

theme_name=""
[[ -f $name_file ]] && theme_name="$(<"$name_file")"

# The theme backgrounds come from our own saifulapm/wallpapers mirror, which
# run_after_27-wallpapers.sh fetches into ~/.local/share/qshell/backgrounds,
# so every machine has them after an apply — the old source,
# the dev MacBook's read-only ~/ref/omarchy clone, existed on one machine
# only and left every other first boot wallpaperless (audit 2026-08-07).
dirs=()
[[ -n $theme_name ]] && dirs+=("$HOME/.local/share/qshell/backgrounds/$theme_name/backgrounds")
dirs+=("$HOME/Pictures/Wallpapers")

# list.sh's extensions and per-directory sort. Their thumbnail cache lives in
# bin/wallpaper-thumbs (ffmpeg here, ImageMagick there) and is attached only
# in the --list branch below: the picker draws thumbnails, but the cycle and
# --set always deal in original paths.
list() {
  local dir
  for dir in "${dirs[@]}"; do
    [[ -d $dir ]] || continue
    # || true: under `set -e -o pipefail` a find hiccup (unreadable entry,
    # looping symlink) would otherwise abort this loop's subshell mid-way and
    # silently truncate the candidate list; find's partial output still counts.
    find -L "$dir" -maxdepth 1 -type f \
      \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' \
      -o -iname '*.bmp' -o -iname '*.webp' \) \
      -print0 2>/dev/null | sort -z | tr '\0' '\n' || true
  done | awk -F/ '!seen[$NF]++'
}

apply() {
  local path="$1"
  if [[ ! -f $path ]]; then
    echo "background-next: no such image: $path" >&2
    exit 1
  fi
  mkdir -p "$state_dir"
  printf '%s\n' "$path" >"$state.tmp"
  mv "$state.tmp" "$state"
}

peek=0
case "${1-}" in
"--list")
  # path<TAB>thumbnail — the shape PickerModel.loadRows already reads
  # (omarchy's own row format): column 1 is what --set applies, column 2 is
  # what the filmstrip decodes. wallpaper-thumbs echoes the original path
  # for anything it cannot thumbnail, so column 2 always draws.
  candidates="$(list)"
  [[ -n $candidates ]] || exit 0
  paste <(printf '%s\n' "$candidates") \
    <(printf '%s\n' "$candidates" | "$(dirname "$0")/wallpaper-thumbs")
  exit 0
  ;;
"--peek")
  peek=1
  ;;
"--current")
  [[ -f $state ]] && cat "$state"
  exit 0
  ;;
"--set")
  if [[ $# -ne 2 ]]; then
    echo "usage: background-next --set <path>" >&2
    exit 1
  fi
  apply "$2"
  exit 0
  ;;
"") ;;
*)
  echo "usage: background-next [--list | --current | --set <path>]" >&2
  exit 1
  ;;
esac

mapfile -t bgs < <(list)
# No wallpaper for this theme is not an error: leave whatever is showing.
((${#bgs[@]})) || exit 0

current=""
[[ -f $state ]] && current="$(<"$state")"

# Unknown current (a fresh theme) starts at the first image; a known one
# advances, so re-applying the active theme walks the set.
next="${bgs[0]}"
for i in "${!bgs[@]}"; do
  if [[ ${bgs[$i]} == "$current" ]]; then
    next="${bgs[$(((i + 1) % ${#bgs[@]}))]}"
    break
  fi
done

if ((peek)); then
  printf '%s\n' "$next"
  exit 0
fi

apply "$next"
