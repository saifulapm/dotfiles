#!/usr/bin/env bash
# update-all — roll the whole machine forward: dnf, chezmoi-managed configs,
# toolchains, cargo tools, prebuilt release binaries, and the source-built
# tools the run_after scripts install once and then guard forever.
#
# The mechanism leans on chezmoi rather than duplicating install logic: every
# run_after script already knows how to install its tool, but each one guards
# on "binary exists" so an apply never surprise-rebuilds. This script decides
# what is STALE, removes exactly those binaries (and advances their src
# checkouts), then runs one `chezmoi apply` and lets the guards reinstall at
# current versions. cargo tools are the exception: re-running `cargo install`
# IS the staleness check (fast no-op when current), where rm+apply would
# force a full rebuild even when nothing changed.
#
# `update-all --emacs` additionally rebuilds Emacs 31 from the branch tip
# (bin/rebuild-emacs — the long one, native compilation throughout).
#
# Deliberately NOT here:
#   * podman dev images (mysql/postgres/redis/mailpit) — a major-version pull
#     can strand the data dirs; bump those by hand, deliberately.
#   * librepods — hand-built with packages/librepods-status-ipc.patch (see
#     the manifest); a reminder prints instead.
#   * nirisnap upstream syncs — rebasing the port onto tobi's omasnap is a
#     decision with conflicts to review (NIRI.md in the fork), not an update.
#     The source-build check below rebuilds only when the FORK's main moved.
set -uo pipefail

WITH_EMACS=0
[ "${1:-}" = "--emacs" ] && WITH_EMACS=1

STATE="$HOME/.local/state/qshell/update-all"
mkdir -p "$STATE"
FAILURES=()

say() { printf '\n\033[1m== %s\033[0m\n' "$*"; }
warn() {
  echo "update-all: $*" >&2
  FAILURES+=("$*")
}

# ------------------------------------------------------------------ dotfiles
# First, so a pushed manifest/script change takes effect in THIS run.
say "dotfiles"
if ! git -C "$HOME/.dotfiles" diff-index --quiet HEAD 2>/dev/null; then
  echo "  tree is dirty — skipping the pull, applying what is here"
elif ! git -C "$HOME/.dotfiles" pull --ff-only; then
  warn "dotfiles pull failed (diverged from origin?)"
fi

# ----------------------------------------------------------------- dnf / rpm
say "dnf packages"
# BEFORE the upgrade, because the whole question is whether qt6 may move in
# THIS transaction: quickshell links Qt's private API and a patch release can
# leave it unable to start (bin/qt6-hold — it also lifts its own hold once a
# rebuilt quickshell is available). Then verify, so a shell that broke anyway
# is reported here instead of at the next reboot.
qt6-hold --refresh || warn "qt6-hold could not set the qt6 hold"
sudo dnf upgrade --refresh || warn "dnf upgrade failed"
qt6-hold --verify || warn "quickshell is broken against the installed Qt — run: qshell-rebuild"

# ----------------------------------------------- prebuilt release binaries
# Tag-file staleness: compare the repo's latest release tag against the one
# recorded at the last refresh. First sighting records a baseline without
# redownloading (the guards installed these recently enough). On a bump the
# binary is removed; the apply below reinstalls it through run_after_10's
# own asset logic — the tool→repo map here is the only duplication.
#
# yazi is the one entry that stands for two binaries: removing ~/.local/bin/yazi
# is enough, because run_after_10 guards on that file and reinstalls `ya`
# alongside it from the same zip. Removing `ya` instead would refresh nothing.
#
# cliamp ships its own `cliamp --upgrade`, deliberately unused: a tool that
# updates itself outside this loop is a tool whose version nothing here knows.
# Remove-and-let-the-apply-reinstall keeps one mechanism for all of them.
say "release binaries"
declare -A PREBUILT=(
  [watchexec]=watchexec/watchexec
  [hurl]=Orange-OpenSource/hurl
  [cloudflared]=cloudflare/cloudflared
  [stripe]=stripe/stripe-cli
  [ouch]=ouch-org/ouch
  [usql]=xo/usql
  [jj]=jj-vcs/jj
  [witr]=pranshuparmar/witr
  [herdr]=herdrdev/herdr
  [yazi]=sxyazi/yazi
  [cliamp]=bjarneo/cliamp
  # yt-dlp shadows the rpm from ~/.local/bin, so `command -v` below always
  # succeeds whether or not OUR copy exists — which is fine: the staleness
  # check still fires, and removing ~/.local/bin/yt-dlp is what run_after_10
  # guards on. This is the entry most worth refreshing; it breaks whenever
  # YouTube changes, which is roughly monthly.
  [yt-dlp]=yt-dlp/yt-dlp
)
# Prints a tag, or nothing. Never an error body: `gh api` writes the API's
# JSON error to STDOUT and exits nonzero, so a bare `gh || curl` concatenates
# the two — a 401 once put `{"message":"Bad credentials"...}v0.3.3` in a tag
# file, and every run after that compared that against a clean `v0.3.3`,
# "refreshing" nine binaries that were already current. Hence the shape check
# on both sources: a release tag has no whitespace in it, an error body does.
latest_tag() { # <owner/repo>
  local tag
  tag="$(gh api "repos/$1/releases/latest" --jq .tag_name 2>/dev/null)" || tag=""
  case "$tag" in
    '' | *[[:space:]]*) # unauthenticated fallback — rate-limited, still fine
      tag="$(curl -fsSL "https://api.github.com/repos/$1/releases/latest" 2>/dev/null \
             | grep -m1 '"tag_name"' | cut -d'"' -f4)" ;;
  esac
  case "$tag" in
    '' | *[[:space:]]*) return 1 ;;
    *) printf '%s\n' "$tag" ;;
  esac
}
for tool in "${!PREBUILT[@]}"; do
  command -v "$tool" >/dev/null 2>&1 || continue # missing → apply installs anyway
  tag="$(latest_tag "${PREBUILT[$tool]}")"
  if [ -z "$tag" ]; then
    echo "  $tool: release check failed — keeping current"
    continue
  fi
  tagfile="$STATE/$tool.tag"
  if [ ! -f "$tagfile" ]; then
    printf '%s\n' "$tag" >"$tagfile"
    echo "  $tool: baseline $tag recorded"
  elif [ "$(cat "$tagfile")" != "$tag" ]; then
    echo "  $tool: $(cat "$tagfile") → $tag — refreshing"
    rm -f "$HOME/.local/bin/$tool"
    printf '%s\n' "$tag" >"$tagfile"
  else
    echo "  $tool: current ($tag)"
  fi
done

# ------------------------------------------------------------- source builds
# Advance each shallow src checkout; when the remote moved, drop the binary
# so the matching run_after script rebuilds it during the apply. Build dirs
# are untracked, so the reset keeps them and the rebuilds stay incremental.
say "source builds"
update_src() { # <src-dir> <installed-binary> <label>
  local src="$1" bin="$2" label="$3"
  if ! git -C "$src" rev-parse HEAD >/dev/null 2>&1; then
    echo "  $label: no checkout — the apply will clone and build"
    rm -f "$bin"
    return
  fi
  local branch
  branch="$(git -C "$src" rev-parse --abbrev-ref HEAD)"
  if ! git -C "$src" fetch -q --depth 1 origin "$branch"; then
    warn "$label: fetch failed"
    return
  fi
  if [ "$(git -C "$src" rev-parse HEAD)" = "$(git -C "$src" rev-parse FETCH_HEAD)" ]; then
    echo "  $label: current ($(git -C "$src" rev-parse --short HEAD))"
    return
  fi
  echo "  $label: $(git -C "$src" rev-parse --short HEAD) → $(git -C "$src" rev-parse --short FETCH_HEAD) — rebuilding on apply"
  git -C "$src" reset -q --hard FETCH_HEAD
  rm -f "$bin"
}
update_src "$HOME/.local/src/kakoune" "$HOME/.local/bin/kak" kakoune-fork
update_src "$HOME/.local/src/nirisnap" "$HOME/.local/bin/omasnap" nirisnap
update_src "$HOME/.local/src/nirisaver" "$HOME/.local/bin/nirisaver" nirisaver
update_src "$HOME/.local/src/pxy" "$HOME/.local/bin/pxy" pxy
# amx has no releases to check, so the source lane is the only lane it has —
# `main` is the version. Same dev caveat as pxy: this builds from the clone in
# ~/.local/src, not from ~/Sites/github/amx, so push before update-all or the
# binary goes back to origin/main.
update_src "$HOME/.local/src/amx" "$HOME/.local/bin/amx" amx
# workflow is THREE binaries (mem, workflow, hub) out of one checkout at one
# revision, so one guard is the honest number: dropping `workflow` is what
# makes run_after_46 rebuild and reinstall all three. Same no-releases story as
# amx — `main` is the version.
update_src "$HOME/.local/src/workflow" "$HOME/.local/bin/workflow" workflow
update_src "$HOME/.local/src/omacalc" "$HOME/.local/bin/omacalc" omacalc
update_src "$HOME/.local/src/omacut" "$HOME/.local/bin/omacut" omacut
update_src "$HOME/.local/src/omawrite" "$HOME/.local/bin/omawrite" omawrite
update_src "$HOME/.local/src/libinput-gestures" "$HOME/.local/bin/libinput-gestures" libinput-gestures
# dekho's build is the long one here (librqbit), so it only ever runs when
# origin actually moved — which is the point of the check.
update_src "$HOME/.local/src/dekho" "$HOME/.local/bin/dekho" dekho
# deen is the opposite: four small crates, no HTTP client and no ML runtime,
# because the Quran text is on disk and transcription shells out to voxtype. It
# gets the same lane anyway — the Quran does not change but the CLI does, and a
# machine whose hub is a front end for a stale binary is the failure this lane
# exists to prevent. The text, the duas and the model are NOT refreshed by this:
# they are fetched once by run_after_49 and guarded on their own files.
update_src "$HOME/.local/src/deen" "$HOME/.local/bin/deen" deen

# -------------------------------------------------------------------- apply
say "chezmoi apply (reinstalls everything removed above)"
chezmoi apply || warn "chezmoi apply failed"

# --------------------------------------------------------------- toolchains
say "toolchains"
mise up || warn "mise up failed"
rustup update || warn "rustup update failed"

# -------------------------------------------------------------- cargo tools
# Mirrors run_after_09's set (keep the two in sync). cargo is the version
# check: a re-run no-ops when the index (or git HEAD) has not moved and
# rebuilds when it has — no guard removal needed.
say "cargo tools"
for crate in sd skim television dufs hop-kak kak-popup dedoc; do
  cargo install --quiet "$crate" || warn "cargo update $crate failed"
done
cargo install --quiet --git https://github.com/kakoune-lsp/kakoune-lsp --locked \
  || warn "cargo update kakoune-lsp failed"
cargo install --quiet --git https://github.com/Jappie3/wayfreeze --locked \
  || warn "cargo update wayfreeze failed"
# ttfx is no longer installed as a binary: the screensaver links it as a
# crate now (nirisaver), so it rides that source build's Cargo.lock. An
# already-installed ~/.cargo/bin/ttfx is left alone — removing it is a user
# call, and nothing here calls it.

# ------------------------------------------------------------------- emacs
if [ "$WITH_EMACS" = 1 ]; then
  say "emacs 31 (branch tip rebuild)"
  "$HOME/.dotfiles/bin/rebuild-emacs" || warn "emacs rebuild failed"
else
  echo
  echo "  (skipping the Emacs 31 rebuild — pass --emacs to include it)"
fi

# ------------------------------------------------------------ small updaters
say "gh extensions"
gh extension upgrade --all || warn "gh extension upgrade failed"

say "agent CLIs"
if command -v claude >/dev/null 2>&1; then
  claude update || warn "claude update failed"
fi
# fx replaces its own binary in place, so unlike the source-built tools above
# there is nothing to make stale for the apply to repair. --json keeps an
# already-current run to one line instead of a redraw, and </dev/null is the
# same courtesy the rest of this script pays: nothing here owns the tty.
# The channel comes from ~/.fx (stable unless someone chose dev by hand).
if command -v fx >/dev/null 2>&1; then
  fx upgrade --json </dev/null || warn "fx upgrade failed"
fi
# codex ships no update verb worth scripting — rerun its installer by hand
# when needed (run_after_04 has the URL).

# ------------------------------------------------------------------ summary
say "summary"
# gh's token is the one credential this script depends on that can go stale
# with no symptom until it does: an expiring PAT works perfectly right up to
# its date, and the release checks above would then drop silently to
# unauthenticated curl (60/hr, shared per IP). Report the date while there is
# still time to rotate. Never a FAILURE — a token with a month left is not a
# reason to fail an update run, and secrets-restore is where it gets fixed.
gh_exp="$(gh api user -i 2>/dev/null \
          | awk -F': ' 'tolower($1)=="github-authentication-token-expiration"{print $2}' | tr -d '\r')"
if [ -n "$gh_exp" ]; then
  echo "  gh token EXPIRES $gh_exp — regenerate with 'No expiration' (github.com/settings/tokens)"
fi
echo "  librepods: hand-built with a patch — rebuild manually after upstream bumps (manifest has the recipe)"
echo "  podman dev images: deliberately untouched (data-dir compatibility)"
if [ "${#FAILURES[@]}" -gt 0 ]; then
  printf '  FAILED: %s\n' "${FAILURES[@]}"
  exit 1
fi
echo "  everything else: up to date"
