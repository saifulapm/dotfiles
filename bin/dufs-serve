#!/usr/bin/env bash
# dufs-serve — the dufs file server behind the dufs.service user unit and the
# bar's "dufs" widget. Serves $HOME over HTTP on port 5000, dotfiles hidden,
# upload+search allowed — the old Arch repo's contract, minus always-on: the
# unit installs nowhere and runs only while the widget's switch is on.
#
# Basic auth with the fixed password `developer` (user decision 2026-08-07,
# replacing a per-machine random secret) — the repo is public, so this is a
# deliberate convenience gate, not a secret: the unit is off unless started
# on purpose, and LAN sits behind firewalld until port 5000 is opened.
set -euo pipefail

# The binary comes from cargo (run_after_09) and the user-manager PATH does
# not always carry ~/.cargo/bin.
PATH="$HOME/.cargo/bin:$PATH"

exec dufs --bind 0.0.0.0 --port 5000 \
  --auth "$USER:developer@/:rw" \
  --hidden '.*' \
  --allow-upload --allow-search \
  "$HOME"
