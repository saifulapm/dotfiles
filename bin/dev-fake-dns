#!/usr/bin/env bash
# just dev's dots-dns: answers state, kid, category, allow, open, reconcile, leases and add as the collector does, from a state file in the temp dir, so a nested check never reaches uBlockDNS or the router. Each call appends its arguments as one line to DOTS_DEV_DIR/dns.log. state prints DOTS_DEV_DIR/dns-state.json when it exists, else the boards' sample of 3 carried and 5 router devices; a write first copies the sample into that file, then changes it, so the next state shows the write. state ends opens whose time has passed first, as the collector does; state --cached prints the file as it is, at once. Flag files in DOTS_DEV_DIR: dns-slow makes each write take 1 s, so a check can press a second key while one runs; dns-slow-state makes a full state take 2 s, so a check sees the cached rows first; dns-open-seconds holds the length of every open in seconds; dns-router-down makes state report the router unreachable since 14 minutes ago, keeping its rows; dns-leases.json replaces the 3 sample leases.
set -euo pipefail
{
dir=${DOTS_DEV_DIR:-${XDG_STATE_HOME:?dev-fake-dns: run it from a sourced just dev env}}
printf '%s\n' "$*" >>"$dir/dns.log"
file=$dir/dns-state.json

sample() {
  jq -n --argjson now "$EPOCHSECONDS" '
    def cats($y; $s; $a; $g): {youtube: $y, social: $s, adult: $a, gambling: $g};
    def device($key; $name; $path; $kid; $cats; $allow; $blocks; $mac):
      {key: $key, name: $name, path: $path, kid: $kid, categories: $cats, open_until: null, allow: $allow,
       last_block: (if ($blocks | length) > 0 then $blocks[0].at else null end), blocks: $blocks,
       ip: (if $mac then "192.168.0.1" + $mac[-2:] else null end), mac: $mac};
    def router($n; $name; $kid; $ago):
      device("router:02:00:00:00:00:" + $n; $name; "router"; $kid; cats($kid; $kid; $kid; $kid); [];
        (if $ago then [{domain: "youtube.com", at: ($now - $ago)}] else [] end); "02:00:00:00:00:" + $n);
    {as_of: $now, carried: {ok: true, error: null}, router: {ok: true, as_of: $now, error: null},
     devices: [
       device("carried:dev00iphone"; "Saiful'\''s iPhone"; "carried"; false; cats(false; false; false; false); []; []; null),
       device("carried:dev00ipad"; "iPad"; "carried"; true; cats(true; true; true; false); ["khanacademy.org", "wikipedia.org"];
         [{domain: "youtube.com", at: ($now - 120)}, {domain: "i.ytimg.com", at: ($now - 125)}, {domain: "tiktok.com", at: ($now - 3700)}]; null),
       device("carried:dev00wife"; "Wife'\''s iPhone"; "carried"; false; cats(false; false; false; false); []; []; null),
       router("01"; "macbook"; false; null),
       router("02"; "nuc"; false; null),
       router("03"; "mini"; false; null),
       router("04"; "Sister'\''s phone"; true; 2460),
       router("05"; "Living-room TV"; true; 3600)
     ]}'
}

current() { if [ -e "$file" ]; then cat "$file"; else sample; fi; }

# Applies a jq program to the state file, made from the sample on the first write.
change() {
  [ -e "$file" ] || sample >"$file"
  jq "$@" "$file" >"$file.tmp"
  mv "$file.tmp" "$file"
}
write() {
  [ -e "$dir/dns-slow" ] && sleep 1
  change "$@"
}

# An open whose time has passed ends: Kid comes back with the categories it kept.
reconcile() {
  [ -e "$file" ] || return 0
  change --argjson now "$EPOCHSECONDS" '.devices |= map(if .open_until != null and .open_until <= $now then .kid = true | .open_until = null else . end)'
}

leases() {
  local all
  if [ -e "$dir/dns-leases.json" ]; then
    all=$(cat "$dir/dns-leases.json")
  else
    all='[{"mac":"02:00:00:00:00:41","ip":"192.168.0.143","hostname":"Galaxy-A54"},{"mac":"02:00:00:00:00:42","ip":"192.168.0.151","hostname":"android-7f2c"},{"mac":"02:00:00:00:00:43","ip":"192.168.0.160","hostname":"Chromecast"}]'
  fi
  # A lease whose MAC is already a listed device is left out.
  current | jq -c --argjson all "$all" '[.devices[].mac] as $listed | [$all[] | select(.mac as $m | $listed | index($m) | not)]'
}

verb=${1:-}
key=${2:-}
case $verb in
state)
  if [ "$key" = --cached ]; then
    current
    exit 0
  fi
  [ -e "$dir/dns-slow-state" ] && sleep 2
  reconcile
  if [ -e "$dir/dns-router-down" ]; then
    current | jq --argjson now "$EPOCHSECONDS" '.router = {ok: false, as_of: ($now - 840), error: "unreachable"}'
  else
    current
  fi
  ;;
reconcile)
  reconcile
  ;;
kid)
  # Kid off remembers a carried device's categories, and Kid on brings them back, all four the first time; ending a timed open brings back the ones it kept.
  remembered=$dir/dns-kid-${key#*:}.json
  [ -e "$file" ] || sample >"$file"
  if [ "$3" = off ] && [ "${key%%:*}" = carried ]; then
    jq -c --arg k "$key" '.devices[] | select(.key == $k) | .categories' "$file" >"$remembered"
  fi
  cats='{"youtube":true,"social":true,"adult":true,"gambling":true}'
  [ "$3" = on ] && [ -e "$remembered" ] && cats=$(cat "$remembered")
  [ "$3" = on ] && jq -e --arg k "$key" '.devices[] | select(.key == $k) | .open_until != null' "$file" >/dev/null &&
    cats=$(jq -c --arg k "$key" '.devices[] | select(.key == $k) | .categories' "$file")
  [ "$3" = off ] && cats='{"youtube":false,"social":false,"adult":false,"gambling":false}'
  write --arg k "$key" --argjson c "$cats" '(.devices[] | select(.key == $k)) |= (.categories = $c | .kid = ([$c[]] | any) | .open_until = null)'
  ;;
category)
  if [ "${key%%:*}" = router ]; then
    echo "router devices carry one Kid policy" >&2
    exit 2
  fi
  write --arg k "$key" --arg c "$3" --argjson on "$([ "$4" = on ] && echo true || echo false)" \
    '(.devices[] | select(.key == $k)) |= (.categories[$c] = $on | .kid = ([.categories[]] | any))'
  ;;
allow)
  # A router allow is one list that every router device shares.
  write --arg k "$key" --arg d "$3" '
    (.devices[] | select(.key == $k or ($k | startswith("router:")) and .path == "router")) |= (.allow = (.allow - [$d]) + [$d])'
  ;;
open)
  seconds=$([ "$3" = 2h ] && echo 7200 || echo 1800)
  [ -e "$dir/dns-open-seconds" ] && seconds=$(cat "$dir/dns-open-seconds")
  write --arg k "$key" --argjson until $((EPOCHSECONDS + seconds)) '(.devices[] | select(.key == $k)) |= (.kid = false | .open_until = $until)'
  ;;
leases)
  leases
  ;;
add)
  lease=$(leases | jq -c --arg m "$key" '.[] | select(.mac == $m)')
  if [ -z "$lease" ]; then
    echo "no lease" >&2
    exit 1
  fi
  write --argjson l "$lease" --arg n "$3" '
    ([.devices[] | select(.path == "router") | .allow][0] // []) as $allow
    | .devices += [{key: ("router:" + $l.mac), name: $n, path: "router", kid: true,
        categories: {youtube: true, social: true, adult: true, gambling: true}, open_until: null, allow: $allow,
        last_block: null, blocks: [], ip: $l.ip, mac: $l.mac}]'
  ;;
*)
  echo "dev-fake-dns: no verb $verb" >&2
  exit 2
  ;;
esac
exit
}
