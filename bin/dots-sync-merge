#!/usr/bin/env node
// dots sync's merge step with the shell's models: `machine` prints the id Notes.qml uses, `<notes|goals> <store> <pulled>...` merges the pulled files into the local store.
import { execFileSync } from 'node:child_process';
import { existsSync, linkSync, mkdirSync, readFileSync, unlinkSync, writeFileSync } from 'node:fs';
import { basename, dirname, join } from 'node:path';
import * as goals from '../shell/lib/goals.mjs';
import * as notes from '../shell/lib/notes.mjs';

const read = (path) => (existsSync(path) ? readFileSync(path, 'utf8') : '');
const fail = (msg, code) => {
  process.stderr.write(msg + '\n');
  process.exit(code);
};

function machine() {
  const env = process.env;
  const config = env.XDG_CONFIG_HOME || env.HOME + '/.config';
  return notes.machineId(env.DOTS_MACHINE, read(config + '/chezmoi/chezmoi.toml'), read('/etc/hostname'));
}

// How many of this machine's records the last round re-stamped, named once the round holds.
let restamped = 0;

// Merging a store with itself only sorts it, so the two compare equal when the others brought nothing and the file stays untouched.
function round(unit, path, others) {
  const model = { notes, goals }[unit];
  const text = existsSync(path) ? readFileSync(path, 'utf8') : null;
  const local = text === null ? model.emptyStore() : model.parseStore(text);
  if (!local) fail(`${basename(path)}: the local store is broken, so it is left as it is`, 4);
  const base = model.mergeStores(local, local);
  const own = restamp(unit, local);
  restamped = own.fixed;
  const merged = others.reduce((s, store) => model.mergeStores(s, store), model.mergeStores(own.store, own.store));
  if (JSON.stringify(merged) === JSON.stringify(base)) return true;
  const tmp = join(dirname(path), '.' + basename(path) + '.' + process.pid + '.tmp');
  mkdirSync(dirname(path), { recursive: true });
  writeFileSync(tmp, JSON.stringify(merged));
  // Only tests set it, to save over the store at the worst moment.
  if (process.env.DOTS_MERGE_BEFORE_SWAP) execFileSync(process.env.DOTS_MERGE_BEFORE_SWAP);
  // A store the shell created meanwhile is not replaced: link refuses it and the round starts again from it.
  if (text === null) {
    if (!place(() => linkSync(tmp, path), tmp)) return false;
    unlinkSync(tmp);
    return true;
  }
  // The swap is one step, so a shell save cannot land between a check and a rename; whatever it swapped out is kept to compare.
  if (!place(() => execFileSync('mv', ['--exchange', tmp, path], { stdio: 'ignore' }), tmp)) return false;
  const out = readFileSync(tmp, 'utf8');
  unlinkSync(tmp);
  if (out === text) return true;
  // The shell saved after this round read the store: its file merges into the result in the next round.
  const late = model.parseStore(out);
  if (late) others.push(late);
  return false;
}

// Runs the step that puts the result in place; when the store changed under it (made, or removed), the temp file goes and the round starts again.
function place(step, tmp) {
  try {
    step();
    return true;
  } catch (e) {
    unlinkSync(tmp);
    return false;
  }
}

// A record stamped more than a day ahead of this clock would win every merge from now on, so a pulled file's such records are left out and counted.
function recent(unit, store) {
  const limit = Date.now() + 24 * 3600000;
  let dropped = 0;
  const ok = (x) => x.updatedAt <= limit || (dropped++, false);
  if (unit === 'notes') return { store: Object.assign({}, store, { notes: store.notes.filter(ok) }), dropped };
  const kept = store.goals.filter(ok).map((g) => Object.assign({}, g, { tasks: g.tasks.filter(ok) }));
  return { store: Object.assign({}, store, { goals: kept }), dropped };
}

// This machine's records stamped more than a day ahead come from a clock that ran fast; every other machine leaves them out, so they are stamped now and travel again.
function restamp(unit, store) {
  const now = Date.now();
  const limit = now + 24 * 3600000;
  let fixed = 0;
  const fix = (x) => {
    if (x.updatedAt <= limit) return x;
    fixed++;
    if (!x.stamps) return Object.assign({}, x, { updatedAt: now });
    const stamps = Object.fromEntries(Object.entries(x.stamps).map(([f, t]) => [f, t > limit ? now : t]));
    return Object.assign({}, x, { stamps, updatedAt: Math.max(now, ...Object.values(stamps)) });
  };
  const out =
    unit === 'notes'
      ? Object.assign({}, store, { notes: store.notes.map(fix) })
      : Object.assign({}, store, { goals: store.goals.map((g) => Object.assign({}, fix(g), { tasks: g.tasks.map(fix) })) });
  return { store: out, fixed };
}

// A pulled file that does not parse, or its records stamped ahead, are left out and the rest still merge; exit 5 then names them last, so the unit shows the error while this machine's store still goes up.
function merge(unit, path, files) {
  const model = { notes, goals }[unit];
  const others = [];
  const skipped = [];
  // This machine's own remote file is merged too, so a reinstall with no local store gets its goals and notes back before its first push.
  for (const f of files) {
    const store = model.parseStore(read(f));
    if (!store) {
      skipped.push(`${unit}: skipped ${basename(f)}, which does not parse`);
      continue;
    }
    const { store: kept, dropped } = recent(unit, store);
    others.push(kept);
    if (dropped) skipped.push(`${unit}: left out ${dropped} record${dropped === 1 ? '' : 's'} from ${basename(f)}, stamped more than a day ahead`);
  }
  for (let i = 0; i < 3; i++) {
    if (!round(unit, path, others)) continue;
    if (restamped) process.stderr.write(`${unit}: re-stamped ${restamped} record${restamped === 1 ? '' : 's'} stamped more than a day ahead\n`);
    if (skipped.length) fail(skipped.join('\n'), 5);
    return;
  }
  fail(`${unit}: the local store kept changing, so this round left it alone`, 1);
}

const [cmd, path, ...files] = process.argv.slice(2);
if (cmd === 'machine') process.stdout.write(machine() + '\n');
else if ((cmd === 'notes' || cmd === 'goals') && path) merge(cmd, path, files);
else fail('usage: dots-sync-merge machine | dots-sync-merge <notes|goals> <store> <other>...', 2);
