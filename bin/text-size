#!/usr/bin/env bash
# text-size — one knob for apparent text size across the desktop.
#
# Port of omarchy-display-text-size onto our theme machinery.
# The knob is `[font] size` in ~/.config/qshell/theme-override.toml: the
# shell watches that file and reflows live, and bin/theme-apply layers it
# over the active theme, so foot (derived point size + line height) and GTK
# (quantized text-scaling-factor) follow from one write. Survives theme
# switches — the override outlives the theme, exactly like upstream's
# ~/.config/omarchy/shell.toml.
#
#   text-size            print the current state
#   text-size <9-20>     set the size in px (shell token units)
#   text-size reset      drop the override, back to the theme's own size
#   text-size --value    just the effective integer (Display panel probe)

MIN=9
MAX=20
DEFAULT=12
override="$HOME/.config/qshell/theme-override.toml"

current_size() {
  [[ -f $override ]] || return 0
  awk '
    /^[[:space:]]*\[/ { in_font = ($0 ~ /^[[:space:]]*\[font\][[:space:]]*$/); next }
    in_font && /^[[:space:]]*size[[:space:]]*=/ {
      v = $0
      sub(/^[^=]*=[[:space:]]*/, "", v)
      sub(/[[:space:]]*(#.*)?$/, "", v)
      print v
      exit
    }
  ' "$override"
}

# Upsert `size` under [font], leaving every other section and key untouched.
# Atomic same-dir replace: the shell's FileView needs the rename, not a
# truncate-and-write.
set_size() {
  local size="$1" tmp
  mkdir -p "$(dirname "$override")"

  if [[ ! -f $override ]]; then
    tmp="$(mktemp "$override.XXXXXX")"
    printf '[font]\nsize = %s\n' "$size" >"$tmp"
    mv "$tmp" "$override"
    return
  fi

  tmp="$(mktemp "$override.XXXXXX")"
  awk -v val="$size" '
    function emit() { print "size = " val; done = 1 }
    /^[[:space:]]*\[/ {
      if (in_font && !done) emit()
      in_font = ($0 ~ /^[[:space:]]*\[font\][[:space:]]*$/)
      print
      next
    }
    in_font && /^[[:space:]]*size[[:space:]]*=/ {
      if (!done) emit()
      next
    }
    { print }
    END {
      if (in_font && !done) emit()
      if (!done) {
        if (NR > 0) print ""
        print "[font]"
        emit()
      }
    }
  ' "$override" >"$tmp"
  mv "$tmp" "$override"
}

reset_size() {
  [[ -f $override ]] || return 0
  local tmp
  tmp="$(mktemp "$override.XXXXXX")"
  awk '
    /^[[:space:]]*\[/ { in_font = ($0 ~ /^[[:space:]]*\[font\][[:space:]]*$/) }
    in_font && /^[[:space:]]*size[[:space:]]*=/ { next }
    { print }
  ' "$override" >"$tmp"
  mv "$tmp" "$override"
}

# theme-apply owns every derivation; foot cannot reload, so nudge — one toast
# that replaces itself while stepping through sizes (their replaces-id trick).
apply() {
  theme-apply >/dev/null 2>&1 || true

  if pgrep -x foot >/dev/null 2>&1 || pgrep -x footclient >/dev/null 2>&1; then
    local id_file="${XDG_RUNTIME_DIR:-/tmp}/qshell-text-size.foot-notif-id"
    local prev_id="" replace=() new_id
    [[ -f $id_file ]] && read -r prev_id <"$id_file" 2>/dev/null
    [[ $prev_id =~ ^[0-9]+$ ]] && replace=(-r "$prev_id")
    new_id="$(notify-send -a qshell -p "${replace[@]}" -t 5000 \
      "Text size changed" "Reopen foot windows to apply the new terminal size" 2>/dev/null)" || true
    [[ $new_id =~ ^[0-9]+$ ]] && printf '%s\n' "$new_id" >"$id_file"
  fi
}

case "${1:-}" in
  -h | --help)
    sed -n '4,18p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  --value)
    cur="$(current_size)"
    [[ $cur =~ ^[0-9]+$ ]] && echo "$cur" || echo "$DEFAULT"
    exit 0
    ;;
  "")
    cur="$(current_size)"
    printf 'text size: %s px\ngtk text-scaling-factor: %s\nfoot font: %s\n' \
      "${cur:-$DEFAULT (theme default)}" \
      "$(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null || echo n/a)" \
      "$(grep -oP ':size=\K[0-9.]+' ~/.config/foot/foot.ini 2>/dev/null || echo n/a)pt"
    exit 0
    ;;
  reset | default)
    reset_size
    apply
    exit 0
    ;;
esac

size="$1"
if [[ ! $size =~ ^[0-9]+$ ]] || ((size < MIN || size > MAX)); then
  echo "Size must be an integer between $MIN and $MAX (px)." >&2
  exit 1
fi

set_size "$size"
apply
