#!/usr/bin/python3
# dots-taildrop-send <name> <target> [file...]: sends files to a tailnet machine with tailscale file cp, picking them with the portal's file chooser when none are named, while the island shows the send through dots-call sending.

# Python, as the dev fakes are, since bash can do neither of two things: the portal answers on the connection that asked, so one D-Bus connection spans the call and the wait; and tailscale file cp paints progress only when stderr is a terminal, so it runs on a pty.
import os
import pty
import re
import subprocess
import sys

# The chooser's answer gives up after this long, so an abandoned dialog cannot keep the island's slot up.
ANSWER_TIMEOUT_SEC = 600
# dots-call beside this script: the shell starts it by path, and the nested session's PATH holds no bin/.
DOTS_CALL = os.path.join(os.path.dirname(os.path.realpath(__file__)), "dots-call")
PERCENT = re.compile(rb"(\d+(?:\.\d+)?)%")


# The name comes from the tailnet: one line, no control characters or bidi marks.
def clean(text):
    text = re.sub(r"[‪-‮⁦-⁩‎‏؜]", "", text)
    text = re.sub(r"[\x00-\x1f\x7f-\x9f]+", " ", text)
    return " ".join(text.split())


def portal_pick(title):
    import gi

    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    loop = GLib.MainLoop()
    uris = []

    def on_response(_conn, _sender, _path, _iface, _signal, params):
        code, results = params.unpack()
        if code == 0:
            uris.extend(results.get("uris", []))
        loop.quit()

    def subscribe(path):
        bus.signal_subscribe("org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request", "Response", path, None, Gio.DBusSignalFlags.NONE, on_response)

    # The request path follows from our bus name and token, so it is subscribed before asking: a dialog answered at once would beat a later subscribe.
    token = "dots%d" % os.getpid()
    sender = bus.get_unique_name()[1:].replace(".", "_")
    predicted = "/org/freedesktop/portal/desktop/request/%s/%s" % (sender, token)
    subscribe(predicted)
    options = {"handle_token": GLib.Variant("s", token), "multiple": GLib.Variant("b", True)}
    handle = bus.call_sync(
        "org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop", "org.freedesktop.portal.FileChooser", "OpenFile",
        GLib.Variant("(ssa{sv})", ("", title, options)), None, Gio.DBusCallFlags.NONE, -1, None,
    ).unpack()[0]
    if handle != predicted:
        subscribe(handle)
    GLib.timeout_add_seconds(ANSWER_TIMEOUT_SEC, lambda: loop.quit() or GLib.SOURCE_REMOVE)
    loop.run()
    return [GLib.filename_from_uri(u)[0] for u in uris]


# DOTS_PICK_FILES names a command printing one path per line, for the nested session, whose bus has no portal.
def pick(title):
    command = os.environ.get("DOTS_PICK_FILES")
    if not command:
        return portal_pick(title)
    out = subprocess.run([command, title], capture_output=True, text=True)
    return [line for line in out.stdout.splitlines() if line] if out.returncode == 0 else []


def call(*args):
    subprocess.run([DOTS_CALL, "sending"] + [str(a) for a in args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def notify(summary, body="", critical=False):
    subprocess.run(["notify-send"] + (["-u", "critical"] if critical else []) + ["-a", "Tailscale", "--", summary, body], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    if len(sys.argv) < 3:
        print("usage: dots-taildrop-send <name> <target> [file...]", file=sys.stderr)
        return 2
    name, target, files = clean(sys.argv[1]), sys.argv[2], sys.argv[3:]
    if not files:
        files = pick("Send to %s" % name)
        if not files:
            return 0
    sizes = [max(os.path.getsize(f), 1) if os.path.isfile(f) else 1 for f in files]
    total = sum(sizes)
    call("start", len(files), name)

    # tailscale paints one line per file, its name padded to 36 columns and its percent rising to 100; a new name, or a lower percent for two files of one name, means the next file began.
    pid, fd = pty.fork()
    if pid == 0:
        os.execvp("tailscale", ["tailscale", "file", "cp", "--update-interval=250ms", "--"] + files + [target + ":"])
    index, last, label, shown, said, buf = 0, 0.0, None, -1, b"", b""
    while True:
        try:
            chunk = os.read(fd, 4096)
        except OSError:
            break
        if not chunk:
            break
        buf += chunk
        *lines, buf = re.split(rb"[\r\n]", buf)
        # The paint still open at the end of a read is read too: tailscale starts each repaint with \r, so waiting for it would show every percent one repaint late.
        for line, whole_line in [(l, True) for l in lines] + [(buf, False)]:
            line = re.sub(rb"\x1b\[[0-9;]*[A-Za-z]", b"", line).strip()
            m = PERCENT.search(line)
            if not m:
                if line and whole_line:
                    said = line
                continue
            pct = float(m.group(1))
            if label is not None and (line[:36].rstrip() != label or pct < last) and index < len(files) - 1:
                index += 1
            last, label = pct, line[:36].rstrip()
            whole = int((sum(sizes[:index]) + sizes[index] * min(pct, 100) / 100) * 100 // total)
            if whole != shown:
                shown = whole
                call("progress", whole)
    _, status = os.waitpid(pid, 0)
    call("done")
    if os.waitstatus_to_exitcode(status) != 0:
        notify("Could not send to %s" % name, clean(said.decode(errors="replace")) or "tailscale file cp failed", critical=True)
        return 1
    names = [clean(os.path.basename(f)) for f in files]
    if len(names) == 1:
        notify("Sent %s to %s" % (names[0], name))
    else:
        notify("Sent %d files to %s" % (len(names), name), "\n".join(names))
    return 0


if __name__ == "__main__":
    sys.exit(main())
