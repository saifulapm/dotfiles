#!/usr/bin/env bash
# The shell's hands for the password store: each pass action is one verb here, so a secret travels only on stdin or stdout and never in argv.
set -uo pipefail
{

store=${PASSWORD_STORE_DIR:-$HOME/.password-store}
dir=${XDG_STATE_HOME:-$HOME/.local/state}/dots
recent=$dir/pass-recent tagged=$dir/pass-otp
self=$(readlink -f -- "$0")

die() {
  echo "dots-pass: $1" >&2
  exit "${2:-1}"
}

# A names-only state file: puts the name first when keep is 1, and drops every other copy of it.
state_set() {
  local file=$1 name=$2 keep=$3 tmp line
  mkdir -p "$dir" && chmod 700 "$dir"
  tmp=$(mktemp "$file.XXXXXX") || return 0
  {
    [ "$keep" = 0 ] || printf '%s\n' "$name"
    [ ! -f "$file" ] || while IFS= read -r line || [ -n "$line" ]; do
      [ "$line" = "$name" ] || printf '%s\n' "$line"
    done <"$file"
  } >"$tmp"
  mv -f "$tmp" "$file"
}

# Plain git, because pass git always exits 0, a refused push included.
push() {
  [ -n "$(git -C "$store" remote 2>/dev/null)" ] || return 0
  git -C "$store" push --quiet >/dev/null 2>&1 || die "saved, not pushed" 3
}

# Sets secret to the first line of what pass prints for the entry.
fetch() {
  local out
  [ -f "$store/$name.gpg" ] || die "no entry $name"
  out=$("$@" 2>/dev/null) || die "could not decrypt $name"
  secret=${out%%$'\n'*}
}

# Sets secret to the entry's current TOTP code. pass otp would hand the seed to oathtool in argv, where any process can read it, so the seed goes in on stdin.
totp() {
  local out line query pair uri='' key=''
  local -a pairs
  local -a args=(-b --totp)
  [ -f "$store/$name.gpg" ] || die "no entry $name"
  out=$(pass show -- "$name" 2>/dev/null) || die "could not decrypt $name"
  while IFS= read -r line; do
    case $line in otpauth://totp/*\?*)
      uri=$line
      break
      ;;
    esac
  done <<<"$out"
  [ -n "$uri" ] || die "no totp code in $name"
  query=${uri#*\?}
  IFS='&' read -ra pairs <<<"$query"
  for pair in "${pairs[@]}"; do
    case $pair in
    secret=?*) key=${pair#secret=} ;;
    algorithm=*) [[ ${pair#algorithm=} =~ ^(SHA1|SHA256|SHA512)$ ]] && args[1]=--totp=${pair#algorithm=} && args[1]=${args[1],,} ;;
    digits=*) [[ ${pair#digits=} =~ ^([6-8])$ ]] && args+=(--digits="${pair#digits=}") ;;
    period=*) [[ ${pair#period=} =~ ^[1-9][0-9]*$ ]] && args+=(--time-step-size="${pair#period=}s") ;;
    esac
  done
  [ -n "$key" ] || die "no totp code in $name"
  secret=$(printf '%s\n' "$key" | oathtool "${args[@]}" -) || die "could not make a code for $name"
}

# Holds the secret on the clipboard; the timer clears it only while this wl-copy still owns the selection, so a newer copy is left alone.
clip() {
  local pid
  printf '%s' "$secret" | wl-copy --sensitive --foreground --trim-newline >/dev/null 2>&1 &
  pid=$!
  sleep 0.1
  kill -0 "$pid" 2>/dev/null || die "wl-copy failed"
  (
    sleep "${DOTS_PASS_CLEAR_S:-45}"
    ! kill -0 "$pid" 2>/dev/null || wl-copy --clear
  ) >/dev/null 2>&1 </dev/null &
}

list() {
  [ -d "$store" ] || return 0
  local n line
  local -a all=()
  local -A exist=() otp=() printed=()
  while IFS= read -r -d '' n; do
    case $n in *$'\t'* | *$'\n'*) continue ;; esac
    all+=("$n")
    exist["$n"]=1
  done < <(find "$store/" -mindepth 1 -name '.*' -prune -o -type f -name '*.gpg' -printf '%P\0' | sed -z 's/\.gpg$//' | LC_ALL=C sort -z)
  [ ! -f "$tagged" ] || while IFS= read -r line || [ -n "$line" ]; do otp["$line"]=1; done <"$tagged"
  emit() {
    local flag=0
    if [ -n "${otp["$1"]+x}" ] || [[ $1 == otp/* ]]; then flag=1; fi
    printf '%s\t%s\n' "$1" "$flag"
    printed["$1"]=1
  }
  [ ! -f "$recent" ] || while IFS= read -r line || [ -n "$line" ]; do
    [ -z "${exist["$line"]+x}" ] || [ -n "${printed["$line"]+x}" ] || emit "$line"
  done <"$recent"
  for n in "${all[@]}"; do
    [ -n "${printed["$n"]+x}" ] || emit "$n"
  done
}

# %XX becomes its byte and + a space, as pass-otp reads a label; the backslash pass keeps printf %b from eating a literal \n.
urldecode() {
  local value=${1//+/ }
  value=${value//\\/\\\\}
  printf '%b' "${value//%/\\x}"
}

# A field leaves on a tab-separated line, so control characters and edge spaces go first.
field() {
  printf '%s' "$1" | tr -d '[:cntrl:]' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

# Sets uri from the first QR on the clipboard image; neither the image's text nor the URI is ever printed.
read_qr() {
  local out rc
  out=$(wl-paste --type image/png 2>/dev/null | zbarimg --raw -q - 2>/dev/null)
  rc=$?
  case $rc in
  0) ;;
  4) die "no qr code in the clipboard image" ;;
  *) die "no image on the clipboard" ;;
  esac
  uri=${out%%$'\n'*}
  case $uri in
  otpauth://totp/* | otpauth://hotp/*) ;;
  *) die "the qr code is not an otpauth code" ;;
  esac
}

# Sets issuer, account, kind, digits and period from uri, and refuses one with no secret.
parse_uri() {
  local rest=${uri#otpauth://} label query=() pair has_secret=0 param_issuer=
  kind=${rest%%/*}
  rest=${rest#*/}
  label=$(urldecode "${rest%%\?*}")
  case $rest in
  *\?*) IFS='&' read -ra query < <(printf '%s' "${rest#*\?}") ;;
  esac
  digits=6 period=30
  for pair in "${query[@]}"; do
    case $pair in
    secret=?*) has_secret=1 ;;
    issuer=*) param_issuer=$(urldecode "${pair#issuer=}") ;;
    digits=*) [[ ${pair#digits=} =~ ^([6-9]|10)$ ]] && digits=${pair#digits=} ;;
    period=*) [[ ${pair#period=} =~ ^[0-9]+$ ]] && period=${pair#period=} ;;
    esac
  done
  [ "$has_secret" = 1 ] || die "that code carries no secret"
  account=$label issuer=
  case $label in
  *:*)
    issuer=${label%%:*}
    account=${label#*:}
    ;;
  esac
  [ -z "$param_issuer" ] || issuer=$param_issuer
  kind=$(printf '%s' "$kind" | tr '[:lower:]' '[:upper:]')
}

verb=${1:-}
name=${2:-}
case $verb in
copy | otp | show | exists | insert | delete | edit | qr-save) [ -n "$name" ] || die "$verb needs a name" 2 ;;
esac

case $verb in
list) list ;;
copy)
  fetch pass show -- "$name"
  clip
  state_set "$recent" "$name" 1
  ;;
otp)
  totp
  clip
  state_set "$recent" "$name" 1
  state_set "$tagged" "$name" 1
  ;;
show)
  fetch pass show -- "$name"
  printf '%s\n' "$secret"
  ;;
exists) [ -f "$store/$name.gpg" ] || exit 1 ;;
generate)
  if ! [[ $name =~ ^[0-9]{1,3}$ ]] || ((10#$name < 8 || 10#$name > 128)); then die "generate needs a length from 8 to 128" 2; fi
  IFS= read -r -N "$name" secret < <(LC_ALL=C tr -dc '[:graph:]' </dev/urandom)
  printf '%s\n' "$secret"
  ;;
insert)
  [ ! -e "$store/$name.gpg" ] || die "$name exists"
  IFS= read -r secret || [ -n "$secret" ]
  [ -n "$secret" ] || die "no password on stdin" 2
  printf '%s\n' "$secret" | pass insert -e -- "$name" >/dev/null 2>&1 || die "could not save $name"
  state_set "$recent" "$name" 1
  push
  ;;
delete)
  pass rm -f -- "$name" >/dev/null 2>&1 || die "could not delete $name"
  state_set "$recent" "$name" 0
  state_set "$tagged" "$name" 0
  push
  ;;
edit)
  [ -f "$store/$name.gpg" ] || die "no entry $name"
  # pass edit takes no --, and reads its one argument as the name, so a leading dash is safe; dots-foot is the one beside this script, since the shell's user manager need not have bin/ on PATH.
  # shellcheck disable=SC2016
  "${self%/*}/dots-foot" env EDITOR=kak bash -c 'pass edit "$1" && exec "$2" push' _ "$name" "$self"
  ;;
push) push ;;
qr-scan)
  read_qr
  parse_uri
  printf '%s\t%s\t%s\t%s\t%s\n' "$(field "$issuer")" "$(field "$account")" "$kind" "$digits" "$period"
  ;;
qr-save)
  read_qr
  parse_uri
  if [ -f "$store/$name.gpg" ]; then
    printf '%s\n' "$uri" | pass otp append -f -- "$name" >/dev/null 2>&1 || die "could not add the code to $name"
  else
    printf '%s\n' "$uri" | pass otp insert -- "$name" >/dev/null 2>&1 || die "could not save $name"
  fi
  state_set "$tagged" "$name" 1
  state_set "$recent" "$name" 1
  push
  ;;
*) die "usage: dots-pass list|copy|otp|show|exists|generate|insert|delete|edit|qr-scan|qr-save [name]" 2 ;;
esac
exit 0
}
