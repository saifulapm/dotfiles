#!/usr/bin/env bash
# dots-dekho-play: runs `dekho play --json` in a transient user unit, so playback outlives Dekho's window and qs, and writes its NDJSON to a file Dekho tails; --stop stops it (mpv is in its cgroup) and waits, --status prints {active, session}. With --trailer first, each of these runs `dekho trailer --json` under a unit of its own instead, so a trailer never stops a film.

# The caller names the file, a new path each run: its tail starts at once, and a reused path would replay the last run's events.
set -uo pipefail
{
unit=${DOTS_DEKHO_UNIT:-dekho-play}
verb=play
if [ "${1:-}" = --trailer ]; then
  unit=$unit-trailer verb=trailer
  shift
fi
runtime=${XDG_RUNTIME_DIR:-/tmp}/dekho
log=$runtime/$unit.log
# --status reads the session back from here, since the unit's own properties do not name it plainly.
current=$runtime/$unit.session

active() { systemctl --user is-active --quiet "$unit.service"; }

# systemctl stop returns before the cgroup drains, and systemd-run refuses a unit still active; bounded at 2 s so a stuck unit cannot hang the App.
stop_wait() {
  systemctl --user stop "$unit.service" >/dev/null 2>&1 || true
  local _
  for _ in $(seq 1 40); do
    active || return 0
    sleep 0.05
  done
}

case "${1:-}" in
--stop)
  stop_wait
  exit 0
  ;;
--status)
  if active && [ -f "$current" ]; then
    jq -nc --arg s "$(cat "$current")" '{active: true, session: $s}'
  else
    echo '{"active":false,"session":""}'
  fi
  exit 0
  ;;
--session)
  session=${2:?dots-dekho-play: --session needs a path}
  shift 2
  ;;
*)
  echo "dots-dekho-play: usage: [--trailer] --session <file> <play args...> | [--trailer] --stop | [--trailer] --status" >&2
  exit 2
  ;;
esac

mkdir -p "$runtime"
# Each play leaves its session file; a day on, nothing tails it any more.
find "$runtime" -maxdepth 1 -name 'session-*.ndjson' -mmin +1440 -delete 2>/dev/null
stop_wait
printf '%s\n' "$session" >"$current"
# The unit gets the user manager's environment, not this one's, so whatever dekho reads (its hosts, key and dirs, and the display mpv opens on) is passed on by name when set, as is a nested check's fake dir.
pass=()
for name in $(compgen -e); do
  case $name in DEKHO_* | TMDB_API_KEY | XDG_CONFIG_HOME | XDG_CACHE_HOME | XDG_STATE_HOME | MPV_HOME | WAYLAND_DISPLAY | DOTS_DEV_DIR) pass+=("--setenv=$name") ;; esac
done
# A play that never starts writes no event, and Starting would wait on an empty file, so this writes the error and exit Starting draws.
failed() {
  jq -nc --arg t "dekho did not start; $unit.log in $runtime says why" '{event: "error", text: $t}' >"$session"
  echo '{"event":"exit","code":1}' >>"$session"
  exit 1
}
systemd-run --user --collect --quiet --unit "$unit" \
  "${pass[@]}" \
  -p "StandardOutput=truncate:$session" -p "StandardError=append:$log" \
  -- "${DOTS_DEKHO:-dekho}" "$verb" --json "$@" || failed
# A dekho that is missing or dies at once leaves its unit gone with nothing written.
sleep 0.3
active || [ -s "$session" ] || failed
exit
}
