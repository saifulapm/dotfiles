#!/usr/bin/env python3
"""dots-sync-mail STORE PULLED...: dots sync's mail unit, run through dots-sync-merge mail.

This machine's HEY decisions, read from the hey-mail files, are stamped
records in STORE; every machine's pulled file merges in, the newest stamp
winning per key, and what the merge changed is written back to those files
and its mail re-filed on this machine. A record's key is "sender ADDR"
(value screened, thefeed, spam or "ledger CATEGORY"), "folder NAME"
(foldersync.db), "autofile ADDR LABEL", "notify ADDR", "recycle ADDR" (value
its days), "speakeasy" (value the code), "bubble id:MESSAGE-ID" (value its
due time in epoch seconds) or "mute id:MESSAGE-ID"; a value of null is a
removal. The
away message and its replied list are never read, so only the machine that
holds them replies.

Exits 0; 4 when STORE does not parse; 5 when a pulled file or some of its
records were left out, the rest still merged; 1 when mail-sync's lock stays
held or re-filing failed.
"""

import fcntl
import json
import os
import re
import sys
import time

sys.dont_write_bytecode = True
import mail_engine as E

DAY = 24 * 3600 * 1000
SYNCED = (*E.CLASS_FILES, "foldersync.db", "autofile.db", "notify.db", "recycle.db", "speakeasy", "bubble.db", "muted.db")
FOLDERS = ("HEY/Screener", "HEY/Feed", "HEY/PaperTrail", "HEY/ReplyLater", "HEY/SetAside", "HEY/Bubbled", "HEY/Read", "Archive")
ADDR = E.ADDR
# The days the engine offers; post-new's recycle query has no tag:new, so 0 would delete all the sender's mail.
DAYS = re.compile(r"30|90|730")
# A Message-ID goes into a thread:{} query, so nothing in it may close the braces or widen the query.
MSGID = re.compile(r'id:[^\s"(){}\[\]\\]+')
THREAD = re.compile(r"[0-9a-f]{16}")
# post-new puts the code in a subject: query with its quotes dropped, where /.../ is a regex.
CODE = re.compile(r"[A-Za-z0-9_-]{1,64}")


def fail(msg, code):
    print(msg, file=sys.stderr)
    sys.exit(code)


def valid(key, value):
    if not (value is None or value is True or type(value) in (str, int)):
        return False
    kind, _, rest = key.partition(" ")
    if kind == "sender":
        return (ADDR.fullmatch(rest) is not None and rest == rest.lower()
                and (value is None or value in E.CLASS_TAGS
                     or (isinstance(value, str) and value.startswith("ledger ") and E.CATEGORY.fullmatch(value[7:]) is not None)))
    if kind == "folder":
        return rest in FOLDERS and value in (None, True)
    if kind == "autofile":
        addr, _, label = rest.partition(" ")
        return ADDR.fullmatch(addr) is not None and addr == addr.lower() and E.CATEGORY.fullmatch(label) is not None and value in (None, True)
    if kind == "notify":
        return ADDR.fullmatch(rest) is not None and rest == rest.lower() and value in (None, True)
    if kind == "recycle":
        return ADDR.fullmatch(rest) is not None and rest == rest.lower() and (value is None or (isinstance(value, str) and DAYS.fullmatch(value) is not None))
    if kind == "mute":
        return MSGID.fullmatch(rest) is not None and value in (None, True)
    if kind == "bubble":
        return MSGID.fullmatch(rest) is not None and (value is None or (type(value) is int and value > 0))
    if key == "speakeasy":
        return value is None or (isinstance(value, str) and CODE.fullmatch(value) is not None)
    return False


def ok_record(key, r):
    return (isinstance(r, dict) and "v" in r and isinstance(r.get("at"), (int, float)) and not isinstance(r["at"], bool)
            and r["at"] >= 0 and valid(key, r["v"]))


def parse(text):
    """The records of a store's text, or None when it is not one."""
    try:
        store = json.loads(text)
    except ValueError:
        return None
    if not isinstance(store, dict) or not isinstance(store.get("records"), dict):
        return None
    return store["records"]


def read(name):
    try:
        with open(os.path.join(E.DB_DIR, name)) as f:
            return f.read().splitlines()
    except FileNotFoundError:
        return None


def write(name, lines):
    path = os.path.join(E.DB_DIR, name)
    os.makedirs(E.DB_DIR, exist_ok=True)
    with open(path + ".sync-tmp", "w") as f:
        f.write("".join(line + "\n" for line in lines))
    os.replace(path + ".sync-tmp", path)


def line_record(name, line):
    """The (key, value) one line of a hey-mail file holds, or None for a comment or a line no decision reads."""
    if name == "foldersync.db":
        return (f"folder {line}", True) if line in FOLDERS else None
    if name == "speakeasy":
        code = "".join(line.split())
        return ("speakeasy", code) if CODE.fullmatch(code) else None
    if name == "muted.db":
        return (f"mute {line.strip()}", True) if MSGID.fullmatch(line.strip()) else None
    if name == "bubble.db":
        w = line.split()
        return (f"bubble {w[0]}", int(w[1])) if len(w) == 2 and MSGID.fullmatch(w[0]) and w[1].isdigit() and int(w[1]) > 0 else None
    if name in E.CLASS_FILES:
        got = E.class_line(name, line)
        return (f"sender {got[0]}", got[1]) if got and ADDR.fullmatch(got[0]) else None
    w = line.split()
    if not w or w[0].startswith("#") or not ADDR.fullmatch(w[0].lower()):
        return None
    addr = w[0].lower()
    if name == "notify.db":
        return f"notify {addr}", True
    if len(w) < 2:
        return None
    if name == "autofile.db":
        return (f"autofile {addr} {w[1]}", True) if E.CATEGORY.fullmatch(w[1]) else None
    return (f"recycle {addr}", w[1]) if DAYS.fullmatch(w[1]) else None


def file_of(key, value):
    """The file a live record of KEY is a line of."""
    kind = key.split(" ")[0]
    if kind == "sender":
        return value.split(" ")[0] + ".db"
    return {"folder": "foldersync.db", "speakeasy": "speakeasy", "mute": "muted.db"}.get(kind, kind + ".db")


def files_of(key):
    """Every file a line of KEY may sit in."""
    return E.CLASS_FILES if key.startswith("sender ") else (file_of(key, None),)


def render(key, value):
    kind, _, rest = key.partition(" ")
    if kind == "sender" and value.startswith("ledger "):
        return f"{value[7:]} {rest}"
    if kind in ("recycle", "speakeasy", "bubble"):
        return f"{rest} {value}".strip()
    return rest


def rank(value):
    return E.class_rank(value) if isinstance(value, str) else 0


def local_view():
    """Every decision the hey-mail files hold now, and which of the files are missing; a later line of one key wins, but a sender's highest class does."""
    view, missing = {}, set()
    for name in SYNCED:
        lines = read(name)
        if lines is None:
            missing.add(name)
            continue
        # post-new reads the speakeasy code from the first line only.
        for line in lines[:1] if name == "speakeasy" else lines:
            kv = line_record(name, line)
            if kv and (kv[0] not in view or not kv[0].startswith("sender ") or rank(kv[1]) > rank(view[kv[0]])):
                view[kv[0]] = kv[1]
    return view, missing


def newer(a, b):
    # Equal stamps fall to the value, so every machine picks the same one.
    return (a["at"], json.dumps(a["v"])) > (b["at"], json.dumps(b["v"]))


def plural(n, one, many):
    return f"{n} record{'' if n == 1 else 's'} " + (one if n == 1 else many)


def lock():
    """Hold mail-sync's lock, so neither post-new nor hey-folder-sync reads a file or tags mail while this round changes them."""
    state = os.path.join(os.environ.get("XDG_STATE_HOME") or E.HOME + "/.local/state", "hey-mail")
    os.makedirs(state, exist_ok=True)
    fd = os.open(os.path.join(state, "sync.lock"), os.O_WRONLY | os.O_CREAT, 0o644)
    for _ in range(300):
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            time.sleep(1)
    fail("mail: a mail sync held its lock for 5 minutes, so this round changed nothing", 1)


def journal():
    """When each decision in the engine's journal was made; the journal is set aside first, so one made meanwhile starts a new file, and a set-aside file a failed round left is read again."""
    try:
        os.replace(E.JOURNAL, f"{E.JOURNAL}.{os.getpid()}")
    except FileNotFoundError:
        pass
    folder, stamps, taken = os.path.dirname(E.JOURNAL), {}, []
    for name in os.listdir(folder) if os.path.isdir(folder) else ():
        if name.startswith(os.path.basename(E.JOURNAL) + "."):
            taken.append(os.path.join(folder, name))
            with open(taken[-1]) as f:
                for line in f:
                    at, _, key = line.rstrip("\n").partition(" ")
                    if at.isdigit():
                        stamps[key] = max(stamps.get(key, 0), int(at))
    return stamps, taken


def migrate_bubbles():
    """Name each bubble.db line's thread by its first Message-ID, as every machine knows it, where a line from before bubbles synced named this machine's thread id."""
    lines = read("bubble.db") or []
    out = []
    for line in lines:
        w = line.split()
        if len(w) == 2 and THREAD.fullmatch(w[0]):
            first = E.nm("search", "--exclude=false", "--output=messages", "--sort=oldest-first", "thread:" + w[0]).split()
            line = f"{first[0]} {w[1]}" if first else line
        out.append(line)
    if out != lines:
        write("bubble.db", out)


def twin_bubbles(records):
    """Live bubbles naming a thread another, newer live bubble names by a different Message-ID, as when one machine lacks the thread's older mail, with the newer one's stamp."""
    live = sorted(((r["at"], k) for k, r in records.items() if k.startswith("bubble ") and r["v"] is not None), reverse=True)
    twins = {}
    for i, (at, key) in enumerate(live[:-1]):
        if key in twins:
            continue
        thread = set(E.nm("search", "--exclude=false", "--output=messages", f"thread:{{{key[7:]}}}").split())
        twins.update({other: at for _, other in live[i + 1:] if other not in twins and other[7:] in thread})
    return twins


def apply(changed, view, now_s):
    """Write each changed key's line where it now belongs and drop its old lines, touching only the files that change; a due bubble line stays for post-new to fire."""
    edits = {}
    for key, (_, new) in changed.items():
        if new is None and key.startswith("bubble ") and view.get(key) is not None and view[key] <= now_s:
            continue
        for name in files_of(key):
            edits.setdefault(name, (set(), []))[0].add(key)
        if new is not None:
            edits[file_of(key, new)][1].append(render(key, new))
    for name, (strip, add) in edits.items():
        lines = read(name)
        if lines is None and not add:
            continue
        out = [line for line in lines or [] if (line_record(name, line) or (None,))[0] not in strip] + add
        if out != lines:
            write(name, out)


def main(path, pulled):
    now = int(time.time() * 1000)
    text = None
    own = {}
    if os.path.exists(path):
        with open(path) as f:
            text = f.read()
        own = parse(text)
        if own is None or not all(ok_record(k, r) for k, r in own.items()):
            fail(f"{os.path.basename(path)}: the local store is broken, so it is left as it is", 4)
    held = lock()
    said = []

    # This machine's own records stamped far ahead come from a clock that ran fast, and every other machine leaves them out.
    fixed = [r for r in own.values() if r["at"] > now + DAY]
    for r in fixed:
        r["at"] = now
    if fixed:
        said.append(f"mail: re-stamped {plural(len(fixed), 'stamped more than a day ahead', 'stamped more than a day ahead')}")

    # A file's change since the last round is a decision made here, stamped when the engine made it; a missing file is not every line of it removed.
    try:
        migrate_bubbles()
    except E.MailError as e:
        print(f"mail: could not name bubble.db's threads by Message-ID: {e}", file=sys.stderr)
    view, missing = local_view()
    stamps, taken = journal()
    records = dict(own)
    live = {k: r["v"] for k, r in own.items() if r["v"] is not None}
    for key in sorted(set(live) | set(view) | set(stamps)):
        value = view.get(key)
        prev = own.get(key)
        # A decision that leaves the files as they were still counts when the engine made it after the key's last stamp, or another machine's older one would win.
        decided = stamps.get(key, 0) > (prev["at"] if prev else 0) and (prev is not None or value is not None)
        if (value == live.get(key) and not decided) or (value is None and key in live and file_of(key, live[key]) in missing):
            continue
        # Never at or below the key's last stamp, so a decision made after seeing another machine's wins on a slow clock too.
        floor = prev["at"] + 1 if prev else 0
        if key.startswith("bubble "):
            # A due line is post-new's to fire, so it is no decision and its firing is the removal, stamped at its due; one set and fired between two rounds tells the others nothing.
            if (value is not None and value <= now // 1000) or (value is None and key not in live):
                continue
            if value is None and live[key] <= now // 1000:
                records[key] = {"v": None, "at": max(live[key] * 1000, floor)}
                continue
            # hey-folder-sync's default day for a mail dragged into HEY/Bubbled is no decision either, so any made one outvotes it.
            records[key] = {"v": value, "at": max(stamps.get(key, 1), floor)}
            continue
        records[key] = {"v": value, "at": max(stamps.get(key, now), floor)}

    detected = dict(records)
    before = {k: r["v"] for k, r in records.items()}
    left_out = False
    for f in pulled:
        name = os.path.basename(f)
        try:
            with open(f) as fh:
                theirs = parse(fh.read())
        except OSError:
            theirs = None
        if theirs is None:
            said.append(f"mail: skipped {name}, which does not parse")
            left_out = True
            continue
        bad = ahead = 0
        for key, r in theirs.items():
            if not ok_record(key, r):
                bad += 1
            elif r["at"] > now + DAY:
                ahead += 1
            elif key not in records or newer(r, records[key]):
                records[key] = {"v": r["v"], "at": r["at"]}
        if bad:
            said.append(f"mail: left out {plural(bad, 'from ' + name + ', which is not a HEY decision', 'from ' + name + ', which are not HEY decisions')}")
        if ahead:
            said.append(f"mail: left out {plural(ahead, 'from ' + name + ', stamped more than a day ahead', 'from ' + name + ', stamped more than a day ahead')}")
        left_out = left_out or bool(bad or ahead)

    try:
        for key, at in twin_bubbles(records).items():
            records[key] = {"v": None, "at": at}
    except E.MailError as e:
        said.append(f"mail: could not tell which bubbles share a thread: {e}")

    changed = {k: (before.get(k), r["v"]) for k, r in records.items() if r["v"] != before.get(k)}
    refused = []
    for key, (old, new) in sorted(changed.items()):
        kind, _, rest = key.partition(" ")
        try:
            if kind == "sender":
                E.refile(rest, old, new)
            elif kind == "mute":
                E.tag(f"thread:{{{rest}}}", *(("+muted", "-inbox") if new else ("-muted",)))
            elif kind == "bubble" and new is not None:
                E.tag(f"thread:{{{rest}}}", "+bubble", "-inbox", "-unread", "-bubbled")
            elif kind == "autofile":
                addr, label = rest.split(" ")
                E.tag("from:" + addr, ("+" if new else "-") + "label/" + label)
        except E.MailError as e:
            refused.append(f"mail: could not re-file {rest.split(' ')[0]}'s mail: {e}")
            # Its line and record stay as they were, so the next round pulls the decision and re-files again.
            del changed[key]
            if key in detected:
                records[key] = detected[key]
            else:
                records.pop(key)
    apply(changed, view, now // 1000)

    out = json.dumps({"v": 1, "records": records}, sort_keys=True)
    if out != text:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = f"{path}.{os.getpid()}.tmp"
        with open(tmp, "w") as f:
            f.write(out)
        os.replace(tmp, path)
    for f in taken:
        os.unlink(f)
    os.close(held)
    for line in said + refused:
        print(line, file=sys.stderr)
    if refused:
        sys.exit(1)
    if left_out:
        sys.exit(5)


if __name__ == "__main__":
    if len(sys.argv) < 2:
        fail("usage: dots-sync-mail STORE [PULLED...]", 2)
    main(sys.argv[1], sys.argv[2:])
