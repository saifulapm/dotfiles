#!/usr/bin/env -S mise exec -- node
// theme-list [--json]
// Plain: one theme name per line (same as theme-set with no args, minus marker).
// --json: array of { name, title, mode, current, preview, tokens } where tokens
// is the flat "section.key" map the shell's Theme.qml consumes — this feeds the
// theme switcher's live preview without QML ever parsing TOML files — and
// preview is the tile image for the switcher's filmstrip (may be "").
"use strict"
const fs = require("fs")
const os = require("os")
const path = require("path")

const ROOT = path.resolve(__dirname, "..")
const THEMES = path.join(ROOT, "themes")
const NAME_FILE = path.join(os.homedir(), ".local/state/qshell/theme.name")

function parseToml(raw) {
  const out = {}
  let section = ""
  for (const lineRaw of String(raw).split("\n")) {
    const line = lineRaw.trim()
    if (!line || line.startsWith("#")) continue
    const sec = line.match(/^\[([A-Za-z0-9_.-]+)\]\s*(#.*)?$/)
    if (sec) { section = sec[1]; continue }
    const kv = line.match(/^(?:"([^"]+)"|([A-Za-z0-9_-]+))\s*=\s*(?:"([^"]*)"|(-?\d+(?:\.\d+)?)|([A-Za-z][A-Za-z0-9_-]*))\s*(#.*)?$/)
    if (!kv || !section) continue
    const key = kv[1] !== undefined ? kv[1] : kv[2]
    out[section + "." + key] = kv[3] !== undefined ? kv[3] : (kv[4] !== undefined ? kv[4] : kv[5])
  }
  return out
}

// omarchy-theme-switcher's find_preview, per theme directory: a preview file
// in the theme root wins in this extension order, otherwise the first sorted
// image in its backgrounds/. Their theme is a directory; ours is a single
// .toml, so the images come from a directory beside it if one exists (a user
// theme) and from the reference clone otherwise — the same place
// bin/background-next takes wallpapers from. Their user-themes-first order.
// No directory at all just means no preview; the shell draws a swatch tile.
const PREVIEW_NAMES = ["preview.png", "preview.jpg", "preview.jpeg", "preview.webp", "preview.gif", "preview.bmp"]
const IMAGE_EXTS = [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp"]

function listFiles(dir) {
  try {
    return fs.readdirSync(dir, { withFileTypes: true })
      .filter(e => e.isFile() || e.isSymbolicLink())
      .map(e => e.name)
  } catch (e) { return [] }
}

function findPreview(themeDir) {
  const files = listFiles(themeDir)
  for (const wanted of PREVIEW_NAMES) {
    const hit = files.find(f => f.toLowerCase() === wanted)
    if (hit) return path.join(themeDir, hit)
  }

  const backgrounds = path.join(themeDir, "backgrounds")
  const images = listFiles(backgrounds)
    .filter(f => IMAGE_EXTS.includes(path.extname(f).toLowerCase()))
    .sort()
  return images.length > 0 ? path.join(backgrounds, images[0]) : ""
}

function previewFor(name) {
  // The external-fetched backgrounds (see bin/background-next) replace the
  // dev-machine-only ~/ref/omarchy lookup.
  for (const dir of [path.join(THEMES, name), path.join(os.homedir(), ".local/share/qshell/backgrounds", name)]) {
    const preview = findPreview(dir)
    if (preview) return preview
  }
  return ""
}

let current = ""
try { current = fs.readFileSync(NAME_FILE, "utf8").trim() } catch (e) {}

const names = fs.readdirSync(THEMES)
  .filter(f => f.endsWith(".toml")).map(f => f.slice(0, -5)).sort()

if (!process.argv.includes("--json")) {
  for (const n of names) console.log(n)
  process.exit(0)
}

const list = names.map(name => {
  const tokens = parseToml(fs.readFileSync(path.join(THEMES, name + ".toml"), "utf8"))
  return {
    name,
    title: tokens["meta.name"] || name,
    mode: tokens["meta.mode"] === "light" ? "light" : "dark",
    current: name === current,
    preview: previewFor(name),
    tokens
  }
})
process.stdout.write(JSON.stringify(list))
