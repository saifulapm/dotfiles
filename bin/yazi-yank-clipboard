#!/usr/bin/env bash
# yazi-yank-clipboard — mirror a yazi yank onto the Wayland clipboard.
#
# yazi's `y` fills yazi's OWN clipboard and nothing else: `p` pastes inside
# yazi, while wl-paste outside it still reports "Nothing is copied", so no
# other application ever sees the selection. keymap.toml runs this alongside
# the builtin `yank` rather than in place of it — the in-yazi paste keeps
# working untouched, and the same keypress also lands the selection on the
# system clipboard.
#
# The base of this is yazi's own documented tip, which is one line:
#
#   for path in %s; do echo "file://$path"; done | wl-copy -t text/uri-list
#
# text/uri-list IS the right default and is what a file-manager copy means —
# it is what Nautilus puts on the clipboard, and what GIMP, Nautilus and
# browser upload dialogs read to paste the actual file. Two things are added
# to that line, both of them things the community plugins do too
# (grappas/wl-clipboard.yazi, XYenon/clipboard.yazi, checked 2026-08-10):
# each path is percent-encoded, and lines are CRLF-terminated per RFC 2483.
#
# The one real departure is images, and it exists because a Wayland source
# serves exactly ONE payload under ONE type, so images cannot be both a file
# reference and something an editor can paste. Measured against Claude Code
# on 2026-08-10 by driving real Ctrl+V presses:
#
#   file:///path/img.png  on text/uri-list  ->  pastes the literal URI text
#   /path/img.png         as plain text     ->  attaches the image
#
# So images go over as bare newline-separated paths. That is the whole
# mechanism: no re-encoding, no mime juggling, and it works the same for one
# image or twenty.
#
# Two things this deliberately does NOT do:
#
#   * It does not relabel bytes. The widely-posted `wl-copy -t image/png <
#     photo.jpg` trick — the accepted answer on yazi discussion #1525 — makes
#     the clipboard claim PNG while serving JPEG bytes, and a reader that
#     believes the label gets a broken image.
#   * It does not re-encode images to PNG. An earlier version of this script
#     did, via ffmpeg, on the theory that Claude Code only reads image/png.
#     True, but irrelevant: the path route above attaches a jpeg just fine,
#     which made ~35 lines of decode-and-temp-file machinery pointless.
#
# The cost of the image branch is honest and worth stating: yanking an image
# and pasting it into a browser upload dialog gives text, not a file. Swap
# the branch for the default one if that trade ever stops being right.
#
# Not -e: an unreadable file should fall through to a working branch, never
# abort the yank half of the keybinding.
set -uo pipefail

(($# > 0)) || exit 0

# RFC 3986 encoding, byte-wise under LC_ALL=C so multi-byte UTF-8 names are
# escaped per byte rather than mangled. Bash applies an LC_ALL assignment
# immediately, including a local one, and restores it on return. Literal
# spaces are the reason this exists — ~/Pictures/Screenshots names them.
uri_encode() {
    local LC_ALL=C s=$1 out='' i c
    for ((i = 0; i < ${#s}; i++)); do
        c=${s:i:1}
        case $c in
        [a-zA-Z0-9/._~-]) out+=$c ;;
        *)
            printf -v c '%%%02X' "'$c"
            out+=$c
            ;;
        esac
    done
    printf '%s' "$out"
}

# Assembles the payload first and only hands it over if it is non-empty:
# piping straight into wl-copy would replace a perfectly good clipboard with
# nothing at all the moment every path failed to resolve.
copy_list() {
    local type=$1 eol=$2 list='' p
    shift 2
    for p in "$@"; do
        list+=$p$eol
    done
    [[ -n $list ]] || exit 0
    printf '%s' "$list" | wl-copy --type "$type"
}

# Resolve once, and note whether the selection is images all the way down.
paths=()
uris=()
all_images=1
for arg in "$@"; do
    p=$(realpath -- "$arg" 2>/dev/null) || continue
    paths+=("$p")
    uris+=("file://$(uri_encode "$p")")
    if ((all_images)); then
        if [[ -f $p ]]; then
            mime=$(file -bL --mime-type -- "$p" 2>/dev/null)
        else
            mime=''
        fi
        [[ $mime == image/* ]] || all_images=0
    fi
done

((${#paths[@]})) || exit 0

# Images: bare paths, one per line, so a reader that resolves paths into
# attachments gets one attachment per line. Newline-terminated like any text
# file, trailing one included — verified not to produce a stray empty
# attachment (two images in, "[Image #2] [Image #3]" out).
if ((all_images)); then
    copy_list text/plain $'\n' "${paths[@]}"
    exit 0
fi

# Everything else: the file-manager shape. Each line CRLF-terminated,
# including the last, which is what RFC 2483 specifies and what both yazi
# clipboard plugins emit.
copy_list text/uri-list $'\r\n' "${uris[@]}"
