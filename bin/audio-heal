#!/bin/bash
# audio-heal — keep the HomePod RAOP sink and the HAVIT headset usable.
#
# Two failure modes this box has actually hit (memory: homepod-airplay-setup):
#
#  * The HomePod has no DHCP reservation and its lease drifts (.50 → .51 on
#    2026-08-31). The static RAOP sink then points at a dead IP and shows a
#    "connected" sink that can never open a session. mDNS discovery cannot
#    notice — the eCommerceStaff AP filters multicast — so the heal is: verify
#    the configured IP still answers unicast mDNS as the Office HomePod, and
#    when it does not, hunt the /22 for port 7000, confirm identity the same
#    way, rewrite raop.ip and restart pipewire. A failed RTSP session also
#    makes the raop module destroy itself (sink vanishes until a pipewire
#    restart) — covered by the same restart once the HomePod answers again.
#
#  * The HAVIT wedges in two shapes: audio up but AVRCP down (no MediaControl,
#    no uinput device — buttons dead, audio pausing every few seconds), or
#    connected with no PipeWire device at all. The first is fixed by a
#    bluetoothctl disconnect/connect cycle, the second by a wireplumber
#    restart. Both fire only after TWO consecutive bad ticks: AVRCP is
#    legitimately down for a moment right after a connect, and a heal that
#    cycles a headset the instant it joins is worse than the wedge.
#
# Run by audio-heal.timer every 2 minutes. The healthy path costs one dig,
# one wpctl status and one busctl call; the subnet scan only runs while the
# HomePod is already lost, and backs off to every 10 minutes so a HomePod
# that is simply unplugged does not get the LAN probed all day.
#
# pipewire is never restarted while any stream is running — killing the
# audio someone is listening to, to repair a sink nobody is using, is the
# defect this guard exists to prevent. The conf edit still lands; the
# restart happens on the next idle tick.

set -uo pipefail

CONF="$HOME/.config/pipewire/pipewire.conf.d/99-homepod-raop.conf"
RAOP_ID="22613DB70BF7" # the Office HomePod's id in its _raop._tcp name
HAVIT="67:6D:E6:03:06:ED"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/audio-heal"
mkdir -p "$STATE"

log() { echo "$*"; }

# --- debounce: true only when the SAME flag was already raised last tick.
bad_twice() {
    if [[ -f "$STATE/$1" ]]; then return 0; fi
    touch "$STATE/$1"
    return 1
}
clear_flag() { rm -f "$STATE/$1"; }

is_office() {
    dig +short +time=1 +tries=1 @"$1" -p 5353 _raop._tcp.local PTR 2>/dev/null | grep -q "$RAOP_ID"
}

pipewire_busy() {
    pw-dump 2>/dev/null | jq -e '
        [.[] | select(.type == "PipeWire:Interface:Node"
                      and .info.state == "running"
                      and ((.info.props["media.class"] // "") | startswith("Stream/")))]
        | length > 0' >/dev/null 2>&1
}

restart_pipewire() {
    if pipewire_busy; then
        log "pipewire busy (live stream) — deferring restart to next tick"
        return 1
    fi
    systemctl --user restart pipewire wireplumber
    log "restarted pipewire + wireplumber"
}

# Hunt the eCommerceStaff /22 for an AirPlay endpoint that answers unicast
# mDNS as the Office HomePod. .68 first — that is where the Deco has always
# put it.
find_homepod() {
    local base cand
    for base in 192.168.68 192.168.69 192.168.70 192.168.71; do
        while read -r cand; do
            if is_office "$cand"; then
                echo "$cand"
                return 0
            fi
        done < <(seq 1 254 | xargs -P 64 -I{} bash -c \
            "timeout 0.3 bash -c 'echo > /dev/tcp/$base.{}/7000' 2>/dev/null && echo $base.{}")
    done
    return 1
}

heal_homepod() {
    [[ -f "$CONF" ]] || return 0 # not this machine

    local ip
    ip=$(sed -n 's/.*raop\.ip = "\([0-9.]*\)".*/\1/p' "$CONF")
    [[ -n "$ip" ]] || { log "homepod: no raop.ip in $CONF"; return 0; }

    if is_office "$ip"; then
        clear_flag scan-backoff
        # IP good but the module self-destructed after a failed session?
        if ! wpctl status 2>/dev/null | grep -q "HomePod"; then
            log "homepod: sink missing with $ip alive — restarting"
            restart_pipewire
        fi
        return 0
    fi

    # The configured IP is not the HomePod any more. Scan, with backoff.
    if [[ -f "$STATE/scan-backoff" ]] \
        && (($(date +%s) - $(stat -c %Y "$STATE/scan-backoff") < 600)); then
        return 0
    fi
    touch "$STATE/scan-backoff"

    local found
    if found=$(find_homepod); then
        log "homepod: moved $ip → $found — rewriting conf"
        # $CONF is a chezmoi symlink into the repo, and sed -i replaces a
        # symlink with a regular file: editing it leaves the repo on the old
        # IP, so the next `chezmoi apply` reverts the heal, this branch fires
        # again and the audio stack restarts once per apply instead of once
        # per lease change. Edit the source, then re-apply just this file.
        # --force because apply prompts on a changed file and there is no TTY
        # here; --exclude=scripts so a DHCP blip never re-runs the installers.
        local src
        src=$(chezmoi source-path "$CONF" 2>/dev/null) || src="$CONF"
        sed -i "s/raop\.ip = \"$ip\"/raop.ip = \"$found\"/" "$src"
        [[ "$src" == "$CONF" ]] \
            || chezmoi apply --force --exclude=scripts "$CONF"
        clear_flag scan-backoff
        restart_pipewire
    else
        log "homepod: $ip dead and no replacement found (off or unplugged?)"
    fi
}

heal_havit() {
    bluetoothctl info "$HAVIT" 2>/dev/null | grep -q "Connected: yes" || {
        clear_flag havit-pw
        clear_flag havit-avrcp
        return 0
    }

    # Connected but PipeWire has no trace of it: the wireplumber wedge.
    if ! wpctl status 2>/dev/null | grep -q "HAVIT"; then
        if bad_twice havit-pw; then
            log "havit: connected but absent from pipewire — restarting wireplumber"
            systemctl --user restart wireplumber
            clear_flag havit-pw
        fi
        return 0
    fi
    clear_flag havit-pw

    # Audio up, control channel down: buttons dead, audio pausing. The uinput
    # device is the observable the shell actually depends on, MediaControl1
    # is the cause — either missing means the same cycle.
    local dev="dev_${HAVIT//:/_}"
    local ctl
    ctl=$(busctl --system get-property org.bluez "/org/bluez/hci0/$dev" \
        org.bluez.MediaControl1 Connected 2>/dev/null)
    if [[ "$ctl" == *false* ]] \
        || ! grep -qF "HAVIT LITE NC01H (AVRCP)" /proc/bus/input/devices; then
        if bad_twice havit-avrcp; then
            log "havit: AVRCP wedged (ctl=$ctl) — cycling connection"
            bluetoothctl disconnect "$HAVIT" >/dev/null
            sleep 3
            bluetoothctl connect "$HAVIT" >/dev/null
            clear_flag havit-avrcp
        fi
        return 0
    fi
    clear_flag havit-avrcp
}

heal_homepod
heal_havit
