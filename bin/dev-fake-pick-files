#!/usr/bin/env bash
# just dev's file chooser for dots-taildrop-send: prints the paths listed in DOTS_DEV_DIR/picked, one per line, or exits 1 as a cancel when it is missing, since the nested bus has no portal.
set -euo pipefail
{
[ -n "${DOTS_DEV_DIR:-}" ] || { echo "dev-fake-pick-files: run it from a sourced just dev env" >&2; exit 1; }
[ -s "$DOTS_DEV_DIR/picked" ] || exit 1
cat "$DOTS_DEV_DIR/picked"
exit
}
