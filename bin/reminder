#!/usr/bin/env node
// reminder add <when> <text> sets a reminder in this machine's synced store, as the launcher's `r ` mode does, for an agent or a terminal; reminder list shows those waiting, and reminder rm <id> cancels one. The store changes only through dots-sync-merge's swap, so a shell save in the same moment merges in rather than being lost.
import { spawnSync } from 'node:child_process';
import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import * as R from '../shell/lib/reminders.mjs';
import { machineId } from '../shell/lib/notes.mjs';

const env = process.env;
const read = (path) => (existsSync(path) ? readFileSync(path, 'utf8') : '');
const fail = (msg, code = 1) => {
  process.stderr.write(msg + '\n');
  process.exit(code);
};

const usage = 'usage: reminder add <when> <text> | reminder list [--json] | reminder rm <id>';
const machine = machineId(env.DOTS_MACHINE, read((env.XDG_CONFIG_HOME || env.HOME + '/.config') + '/chezmoi/chezmoi.toml'), read('/etc/hostname'));
const path = join(env.XDG_DATA_HOME || env.HOME + '/.local/share', 'dots', 'reminders', machine + '.json');

function store() {
  if (!existsSync(path)) return R.emptyStore();
  return R.parseStore(readFileSync(path, 'utf8')) ?? fail(R.brokenStore(machine));
}

// The changed records go in as another machine's file would, so the merge keeps whatever the shell saved meanwhile. The temp file holds the text, so it goes before any refusal.
function merge(records) {
  const dir = mkdtempSync(join(tmpdir(), 'reminder-'));
  let r;
  try {
    const file = join(dir, machine + '.json');
    writeFileSync(file, JSON.stringify({ version: 1, reminders: records }));
    r = spawnSync(new URL('dots-sync-merge', import.meta.url).pathname, ['reminders', path, file], { encoding: 'utf8' });
  } finally {
    rmSync(dir, { recursive: true, force: true });
  }
  if (r.status === 0) return;
  // The merge's own refusal is one line; a crash is a stack, whose Error line says why.
  const said = (r.stderr ?? '').split('\n').map((l) => l.trim()).filter(Boolean);
  fail(`the store was left as it was: ${said.find((l) => /^\w*Error\b/.test(l)) ?? said[0] ?? `dots-sync-merge exited ${r.status ?? r.error?.code}`}`);
}

function add(when, words) {
  const now = Date.now();
  if (!when) fail(usage, 2);
  const parsed = R.parseReminder(`${when} ${words.join(' ')}`, now);
  // The time read fine with a text beside it, so it is the text that cleaned away to nothing.
  if (!parsed && R.parseReminder(`${when} x`, now)) fail(`Cannot set ${when}: it has no text`);
  if (!parsed) fail(`Cannot set ${when}: give a time as 20m, 1h30m or 17:30`);
  if (parsed.error) fail(parsed.error);
  const before = store();
  const r = R.setReminder(before, parsed, now);
  if (r.error) fail(r.error);
  merge(r.store.reminders.filter((x) => !before.reminders.includes(x)));
  process.stdout.write(`${parsed.text} · ${parsed.when}\n`);
}

// One line each, soonest first: the id rm takes, when it rings, the text; --json gives the records to an agent.
function list(json) {
  const now = Date.now();
  const pending = R.pendingList(store());
  if (json) return process.stdout.write(JSON.stringify(pending) + '\n');
  if (!pending.length) return process.stdout.write('no reminders\n');
  const rows = pending.map((r) => [r.id, R.whenText(r.due, now), r.text]);
  const w = [0, 1].map((i) => Math.max(...rows.map((row) => row[i].length)));
  process.stdout.write(rows.map(([id, when, text]) => `${id.padEnd(w[0])}  ${when.padEnd(w[1])}  ${text}\n`).join(''));
}

// Ends a waiting reminder as removed, as d in the launcher does; one already rung or removed is left as it is.
function rm(id) {
  const now = Date.now();
  const before = store();
  const r = R.pendingList(before).find((x) => x.id === id) ?? fail(`no pending reminder ${id}`);
  const after = R.endReminder(before, id, 'removed', now);
  merge(after.reminders.filter((x) => !before.reminders.includes(x)));
  // A ring the shell saved after the read is later than this removal and wins the merge, so what landed is read back.
  if (store().reminders.find((x) => x.id === id)?.ended !== 'removed') fail(`no pending reminder ${id}`);
  process.stdout.write(`removed: ${r.text}\n`);
}

const [cmd, ...args] = process.argv.slice(2);
if (cmd === 'add') add(args[0], args.slice(1));
else if (cmd === 'list' && (args.length === 0 || (args.length === 1 && args[0] === '--json'))) list(args[0] === '--json');
else if (cmd === 'rm' && args.length === 1) rm(args[0]);
else fail(usage, 2);
