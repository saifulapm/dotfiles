#!/usr/bin/env bash
# dots bump: moves each versions.toml pin to its upstream's latest release (or head commit for track = "commit"), rewriting only that pin's version and sha256 lines; the commit is left to the user.
set -euo pipefail
{

die() {
  echo "dots bump: $*" >&2
  exit 1
}

repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
file=$repo/versions.toml
[[ -f $file ]] || die "no $file"

work=$(mktemp -d -t dots-bump-XXXXXX)
trap 'rm -rf "$work"' EXIT

# gh prints an API error body on stdout when it fails, so the exit code and a whitespace-free answer both have to hold.
upstream() {
  local out
  out=$(gh api "$@") || return 1
  [[ -n $out && $out != *[[:space:]]* ]] || return 1
  echo "$out"
}

# bump_pin: the pin's keys are in the globals set by flush; queues edits only when every download worked.
bump_pin() {
  local latest
  if [[ $track == commit ]]; then
    latest=$(upstream "repos/$repo_name/commits/HEAD" --jq .sha) || { echo "dots bump: $name: could not ask $repo_name for its head commit" >&2; return 1; }
  else
    latest=$(upstream "repos/$repo_name/releases/latest" --jq .tag_name) || { echo "dots bump: $name: could not ask $repo_name for its latest release" >&2; return 1; }
    latest=${latest#v}
  fi
  [[ $latest != "$version" ]] || return 0

  local arch template url sum pending=$work/pending
  : >"$pending"
  echo "$version_line	$latest" >>"$pending"
  for arch in "${!sha_lines[@]}"; do
    template=${urls[$arch]:-}
    [[ -n $template ]] || { echo "dots bump: $name: no url for '$arch'" >&2; return 1; }
    url=${template//\{version\}/$latest}
    if [[ $fetch == gh ]]; then
      # A private repo: the same tarball the pin script fetches, through the gh login.
      gh api "repos/$repo_name/tarball/$latest" >"$work/download" || { echo "dots bump: $name: gh could not download $repo_name at $latest" >&2; return 1; }
    else
      curl -fsSL "$url" -o "$work/download" || { echo "dots bump: $name: could not download $url" >&2; return 1; }
    fi
    sum=$(sha256sum "$work/download")
    echo "${sha_lines[$arch]}	${sum%% *}" >>"$pending"
  done
  cat "$pending" >>"$work/edits"
  echo "$name $version → $latest" >>"$work/report"
}

# flush: bumps the pin read so far, if any.
flush() {
  [[ -n $name ]] || return 0
  [[ -n $repo_name && -n $version_line ]] || { echo "dots bump: ${name:-?}: needs repo and version" >&2; failed=1; return 0; }
  bump_pin || failed=1
}

declare -A urls sha_lines
failed=0
: >"$work/edits"
: >"$work/report"

reset() {
  name='' repo_name='' version='' version_line='' track='' fetch=''
  urls=() sha_lines=()
}
reset

n=0
while IFS= read -r line || [[ -n $line ]]; do
  n=$((n + 1))
  if [[ $line == '[[pin]]'* ]]; then
    flush
    reset
    continue
  fi
  [[ $line =~ ^([a-z0-9_.]+)[[:space:]]*=[[:space:]]*\"([^\"]*)\" ]] || continue
  key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
  case $key in
    name) name=$value ;;
    repo) repo_name=$value ;;
    track) track=$value ;;
    fetch) fetch=$value ;;
    version) version=$value version_line=$n ;;
    url) urls[single]=$value ;;
    url.*) urls[${key#url.}]=$value ;;
    sha256) sha_lines[single]=$n ;;
    sha256.*) sha_lines[${key#sha256.}]=$n ;;
  esac
done <"$file"
flush

if [[ -s $work/edits ]]; then
  # Only the first quoted value of an edited line changes, so a trailing comment survives.
  awk -F'\t' '
    NR == FNR { new[$1] = $2; next }
    FNR in new { sub(/"[^"]*"/, "\"" new[FNR] "\"") }
    { print }
  ' "$work/edits" "$file" >"$work/out"
  cat "$work/out" >"$file"
fi

if [[ -s $work/report ]]; then cat "$work/report"; elif ((!failed)); then echo "all pins current"; fi
exit "$failed"
}
