#!/usr/bin/env -S mise exec -- node
// Renders templates/ from the active theme and re-themes running foot
// terminals via OSC escapes (pattern from omarchy).
// Contrast math is shared with the shell: shell/Commons/color.js is the
// single source of truth, evaluated here directly.
"use strict"
const fs = require("fs")
const os = require("os")
const path = require("path")
const { execSync } = require("child_process")

const ROOT = path.resolve(__dirname, "..")
const HOME = os.homedir()
const STATE = path.join(HOME, ".local/state/qshell/theme.toml")

// Indirect eval: runs in global scope, so color.js's function declarations
// become globals despite this module's "use strict".
;(0, eval)(fs.readFileSync(path.join(ROOT, "shell/Commons/color.js"), "utf8"))
;(0, eval)(fs.readFileSync(path.join(ROOT, "shell/Commons/defaults.js"), "utf8"))
;(0, eval)(fs.readFileSync(path.join(ROOT, "shell/Commons/gradient.js"), "utf8"))
;(0, eval)(fs.readFileSync(path.join(ROOT, "shell/Commons/presets.js"), "utf8"))

// Same limited walker as Services/Theme.qml — sections, key = value,
// quoted keys, strings/numbers/bare words, inline comments.
function parseToml(raw) {
  const out = {}
  let section = ""
  for (const lineRaw of String(raw).split("\n")) {
    const line = lineRaw.trim()
    if (!line || line.startsWith("#")) continue
    const sec = line.match(/^\[([A-Za-z0-9_.-]+)\]\s*(#.*)?$/)
    if (sec) { section = sec[1]; continue }
    const kv = line.match(/^(?:"([^"]+)"|([A-Za-z0-9_-]+))\s*=\s*(?:"([^"]*)"|(-?\d+(?:\.\d+)?)|([A-Za-z][A-Za-z0-9_-]*))\s*(#.*)?$/)
    if (!kv || !section) continue
    const key = kv[1] !== undefined ? kv[1] : kv[2]
    out[section + "." + key] = kv[3] !== undefined ? kv[3] : (kv[4] !== undefined ? kv[4] : kv[5])
  }
  return out
}

const themeTokens = parseToml(fs.readFileSync(STATE, "utf8"))

// Machine-level overrides, exactly as Services/Theme.qml layers them: the
// same ~/.config/qshell/theme-override.toml wins over the active theme, so a
// per-machine tweak reaches the TEMPLATED apps too, not just the shell.
let overrideTokens = {}
try {
  overrideTokens = parseToml(fs.readFileSync(path.join(HOME, ".config/qshell/theme-override.toml"), "utf8"))
} catch (e) { /* no override file — the common case */ }

// The preset layer — `[meta] preset` names a bundle from Commons/presets.js
// that fills appearance keys the theme leaves unset. Same order as
// Services/Theme.qml: defaults < preset < theme < machine override.
const presetName = overrideTokens["meta.preset"] !== undefined
  ? overrideTokens["meta.preset"] : themeTokens["meta.preset"]
const presetTokens = THEME_PRESETS[String(presetName || "")] || {}

const tokens = Object.assign({}, THEME_DEFAULTS, presetTokens, themeTokens, overrideTokens)

// Same font precedence Services/Theme.qml applies, so the shell and the
// templated app configs never disagree: a theme that names the token wins; one
// that stays quiet follows the fontconfig `monospace` alias. Both tokens read
// that one alias — this desktop draws in a single family — and it is asked for
// by name here because a template hands a concrete family to foot and GTK,
// not an alias each would resolve for itself.
{
  let resolved = ""
  try {
    resolved = execSync("fc-match -f '%{family[0]}' monospace").toString().trim()
  } catch (e) { /* no fontconfig; keep the builtin defaults */ }
  if (resolved) {
    for (const token of ["font.ui", "font.mono"]) {
      if (themeTokens[token] === undefined && overrideTokens[token] === undefined)
        tokens[token] = resolved
    }
  }
}

// ---- font size ----
// This desktop draws text at one size, 12px, and does not offer a knob for it.
// The omarchy-display-text-size port that used to live here scaled the shell,
// foot, GTK and Emacs together off `[font] size` in the override file; it is
// gone, and with it the reason for a separate base/effective pair. A theme is
// free to name any other token, but not this one — a theme that shipped a
// different size would resize the whole desktop by being selected.
//
// The terminal metrics are the anchor pair the foot-metrics commit measured
// for 12px: 12.5pt in a 32px line box. Kitty reads the same two tokens.
const FONT_SIZE = 12
tokens["font.size"] = String(FONT_SIZE)
tokens["font.foot-pt"] = "12.5"
tokens["font.foot-line-height"] = "32"

// GTK: the interface fonts are ours, at the same fixed size. The scaling
// factor is written rather than left alone so a machine that carried a scaled
// one from the old knob is put back to 1.0 by the next theme apply.
try {
  execSync(`gsettings set org.gnome.desktop.interface font-name "${tokens["font.ui"]} ${FONT_SIZE}"`, { stdio: "ignore" })
  execSync(`gsettings set org.gnome.desktop.interface monospace-font-name "${tokens["font.mono"]} ${FONT_SIZE}"`, { stdio: "ignore" })
  execSync(`gsettings set org.gnome.desktop.interface text-scaling-factor 1.0`, { stdio: "ignore" })
} catch (e) { /* gsettings absent or no session bus */ }

// Per-theme GTK icon theme, resolved once — the settings.ini template and the
// gsettings flip below must agree. (meta.mode read inline: `mode` is declared
// further down, past this block's runtime.)
tokens["icon.resolved"] = String(tokens["icon.theme"] || (String(tokens["meta.mode"]) === "light" ? "Yaru" : "Yaru-dark"))

// The shell watches two files that may not exist yet on a fresh checkout
// (~/.config/qshell/theme-override.toml and the chezmoi-managed fontconfig
// policy), and a FileView cannot arm its watch on a path whose parent
// directory is missing — the file's first appearance would then need a shell
// restart to be noticed. Guarantee the directories instead: this runs on every
// theme change and at bootstrap.
for (const dir of [".config/qshell", ".config/fontconfig/conf.d"]) {
  fs.mkdirSync(path.join(HOME, dir), { recursive: true })
}

// A token's value may name another token ("accent.accent") instead of
// carrying a literal — the same indirection Services/Theme.qml resolves with
// deref(). Flatten the whole map once here so every template, template
// function and OSC write below sees a literal. Bounded, so a cycle settles on
// the last value seen rather than hanging.
for (const key of Object.keys(tokens)) {
  let v = String(tokens[key]).trim()
  for (let i = 0; i < 8; i++) {
    if (!/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(v)) break
    const next = tokens[v]
    if (next === undefined || String(next).trim() === v) break
    v = String(next).trim()
  }
  tokens[key] = v
}

// Derived tokens — same construction rules as Services/Theme.qml. The guard
// reads the RAW theme tokens: THEME_DEFAULTS pre-populates the merged map, so
// checking `tokens` would never derive and every theme would silently inherit
// tokyo-night's near-black default onto its own accent.
if (themeTokens["text.on-accent"] === undefined && tokens["accent.accent"]) {
  tokens["text.on-accent"] = ensureContrast(
    tokens["surface.0"] || "#16161e", tokens["accent.accent"], 4.5)
}

// The active-border token, derived from the accent when a theme omits it —
// same rule as text.on-accent above, and the same rule Services/Theme.qml
// applies, so a theme without the token looks identical either side of the
// shell boundary.
if (!tokens["border.active"]) tokens["border.active"] = tokens["accent.accent"]

// GTK polarity, derived here so the settings.ini template and the gsettings
// calls below read the same decision.
const mode = String(tokens["meta.mode"]) === "light" ? "light" : "dark"
tokens["gtk.prefer-dark"] = mode === "light" ? "0" : "1"
// The builtin stylesheet the plain-GTK4 theme (gtk4-theme.css.tmpl) layers
// itself on — the polarity decides which resource it @imports.
tokens["gtk.default-stylesheet"] = mode === "light" ? "Default" : "Default-dark"
// zathura page recolor follows the same polarity: dark themes tint the
// document into theme colors, light themes show pages as printed.
tokens["zathura.recolor"] = mode === "light" ? "false" : "true"

// Terminal frost strength — foot's background-only alpha while blur is on
// (the foot-alpha fragments below + bin/foot-frost). Background-only so
// glyphs stay crisp where a whole-window fade would dim them; themes may
// override with [foot] alpha.
if (tokens["foot.alpha"] === undefined) tokens["foot.alpha"] = "0.9"

// Plain sRGB interpolation, matching omarchy's awk mix_color — shared by the
// claude and emacs derived-shade blocks below.
function mixHex(aHex, bHex, t) {
  const a = hexToRgb(aHex), b = hexToRgb(bHex)
  if (!a || !b) return aHex
  return rgbToHex({
    r: a.r + (b.r - a.r) * t,
    g: a.g + (b.g - a.g) * t,
    b: a.b + (b.b - a.b) * t
  })
}

// Claude Code custom-theme shades (templates/claude-theme.json.tmpl) — the
// omarchy claude.json.tpl carries `{{ mix a b N% }}` expressions; our engine
// substitutes flat tokens, so the mixes are precomputed here instead.
{
  const mix = mixHex
  const bg = tokens["surface.0"] || "#16161e"
  const fg = tokens["text.primary"] || "#c0caf5"
  const accent = tokens["accent.accent"] || "#7aa2f7"
  tokens["claude.accent-shimmer"] = mix(accent, fg, 0.35)
  tokens["claude.inactive"] = mix(fg, bg, 0.40)
  tokens["claude.inactive-shimmer"] = mix(fg, bg, 0.25)
  tokens["claude.permission-shimmer"] = mix(tokens["ansi.blue"] || accent, fg, 0.35)
  tokens["claude.warning-shimmer"] = mix(tokens["ansi.yellow"] || accent, fg, 0.35)
  tokens["claude.diff-added"] = mix(bg, tokens["ansi.green"] || fg, 0.15)
  tokens["claude.diff-removed"] = mix(bg, tokens["ansi.red"] || fg, 0.15)
  tokens["claude.diff-added-dimmed"] = mix(bg, tokens["ansi.green"] || fg, 0.08)
  tokens["claude.diff-removed-dimmed"] = mix(bg, tokens["ansi.red"] || fg, 0.08)
  tokens["claude.diff-added-word"] = mix(bg, tokens["ansi.green"] || fg, 0.32)
  tokens["claude.diff-removed-word"] = mix(bg, tokens["ansi.red"] || fg, 0.32)
  tokens["claude.raised-bg"] = mix(bg, fg, 0.06)
  tokens["claude.raised-bg-hover"] = mix(bg, fg, 0.10)
  tokens["claude.rate-limit-empty"] = mix(bg, fg, 0.20)
}

// Pi theme derived vars (templates/pi-theme.json.tmpl) — port of
// omarchy default/themed/pi.json.tpl: `{{ mix a b N% }}` becomes flat
// tokens here (like claude above). Omarchy background/foreground/accent map
// to surface.0 / text.primary / accent.accent; selection is surface.3.
{
  const mix = mixHex
  const bg = tokens["surface.0"] || "#16161e"
  const fg = tokens["text.primary"] || "#c0caf5"
  const accent = tokens["accent.accent"] || "#7aa2f7"
  const green = tokens["ansi.green"] || "#9ece6a"
  const red = tokens["ansi.red"] || "#f7768e"
  tokens["pi.selectedBackground"] = mix(bg, accent, 0.22)
  tokens["pi.panel"] = mix(bg, fg, 0.06)
  tokens["pi.panelAlt"] = mix(bg, fg, 0.10)
  tokens["pi.panelPending"] = mix(bg, accent, 0.12)
  tokens["pi.panelSuccess"] = mix(bg, green, 0.12)
  tokens["pi.panelError"] = mix(bg, red, 0.12)
  tokens["pi.border"] = mix(bg, fg, 0.30)
  tokens["pi.borderMuted"] = mix(bg, fg, 0.20)
  tokens["pi.mutedText"] = mix(fg, bg, 0.34)
  tokens["pi.dimText"] = mix(fg, bg, 0.52)
}

// Emacs modus-palette shades (templates/emacs-theme.el.tmpl). The
// qshell-dark/qshell-light themes in the emacs config (saifulapm/emacs.d,
// themes/) are Modus derivatives: modus-themes keeps all ~200 semantic
// mappings and full face coverage, and the rendered file supplies the ~130
// NAMED colors those mappings resolve to. Every shade is blended from the
// theme's own tokens so nothing leaves the theme's gamut: warmer/cooler hue
// variants mix a quarter toward a neighboring ansi hue (the directions modus
// itself leans — red-warmer toward orange, blue-warmer toward violet), faint
// drops chroma in OKLCH with hue and lightness held, intense is the bright
// ansi color, and the special-purpose backgrounds are bg tinted by their hue.
//
// Blending in-gamut keeps the palette in character but says NOTHING about
// whether the result can be read. A theme whose ansi yellow is a light gold
// puts it on a light surface at 2.06:1 (catppuccin-latte), and the emacs
// config's faint preset maps most syntax — builtin, keyword, constant,
// string, variable, fnname, preprocessor, rx-* — onto exactly these entries.
// So every derived FOREGROUND is floored against the surface it actually
// lands on, via the shared `ensureContrast`: it holds hue and chroma and
// binary-searches the smallest lightness change that clears the ratio, so a
// theme already passing comes through byte-identical (no gruvbox hue moves).
// Backgrounds are left raw — their legibility is the paired foreground's job.
{
  const bg = tokens["surface.0"] || "#16161e"
  const fg = tokens["text.primary"] || "#c0caf5"
  const accent = tokens["accent.accent"] || "#7aa2f7"
  const raised = tokens["surface.3"] || bg
  const dim = tokens["text.muted"] || fg
  const a = name => tokens["ansi." + name] || fg
  const bright = name => tokens["ansi.bright-" + name] || a(name)
  const put = (key, v) => { tokens["emacs." + key] = v }

  // WCAG AA for body text — these entries carry syntax, so they are read.
  const AA = 4.5
  // Comments, docstrings and the inactive mode line are de-emphasised BY
  // INTENT; holding them to AA would erase the hierarchy that makes them
  // read as secondary. AA-for-large-text is the floor that keeps them
  // legible without promoting them to the weight of code.
  const MUTED = 3.0
  const readable = (hex, on, ratio) => ensureContrast(hex, on, ratio || AA)

  // chroma-only OKLCH adjustment; _gamutMap keeps the result in sRGB
  const okChroma = (hex, mul) => {
    const c = hexToRgb(hex)
    if (!c) return hex
    const o = _rgbToOklch(c)
    return rgbToHex(_gamutMap({ L: o.L, C: o.C * mul, h: o.h }))
  }

  const NEIGHBORS = { // hue: [warmer-toward, cooler-toward]
    red: ["yellow", "magenta"], green: ["yellow", "cyan"],
    yellow: ["red", "green"], blue: ["magenta", "cyan"],
    magenta: ["red", "blue"], cyan: ["blue", "green"]
  }
  for (const [hue, dirs] of Object.entries(NEIGHBORS)) {
    // Foregrounds — floored against bg-main. Each variant is derived from the
    // RAW ansi hue and floored afterwards, so the warmer/cooler/faint
    // relationships are the ones the blend intended, not compounded lifts.
    put(hue, readable(a(hue), bg))
    put(hue + "-intense", readable(bright(hue), bg))
    put(hue + "-warmer", readable(mixHex(a(hue), a(dirs[0]), 0.25), bg))
    put(hue + "-cooler", readable(mixHex(a(hue), a(dirs[1]), 0.25), bg))
    put(hue + "-faint", readable(okChroma(a(hue), 0.55), bg))
    // Backgrounds — raw hue tinted into bg, no floor.
    put("bg-" + hue + "-intense", mixHex(bg, a(hue), 0.5))
    put("bg-" + hue + "-subtle", mixHex(bg, a(hue), 0.3))
    put("bg-" + hue + "-nuanced", mixHex(bg, a(hue), 0.15))
    put("bg-graph-" + hue + "-1", mixHex(a(hue), bg, 0.45))
  }
  // diff blocks: bg tints stepped faint < base < refine < fringe, like modus.
  // The fg pair is floored against its OWN block background, not bg-main —
  // that is the surface a diff line actually paints behind the text.
  for (const [group, hue] of [["added", "green"], ["changed", "yellow"], ["removed", "red"]]) {
    const block = mixHex(bg, a(hue), 0.2)
    put("bg-" + group, block)
    put("bg-" + group + "-faint", mixHex(bg, a(hue), 0.12))
    put("bg-" + group + "-refine", mixHex(bg, a(hue), 0.3))
    put("bg-" + group + "-fringe", mixHex(bg, a(hue), 0.5))
    put("fg-" + group, readable(mixHex(a(hue), fg, 0.4), block))
    put("fg-" + group + "-intense", readable(bright(hue), block))
  }
  // modus's off-palette accent hues (org agenda dates, prose, mail levels),
  // as in-theme blends muted by a chroma cut
  put("rust", readable(okChroma(mixHex(a("red"), a("yellow"), 0.4), 0.75), bg))
  put("gold", readable(okChroma(mixHex(a("yellow"), a("red"), 0.25), 0.8), bg))
  put("olive", readable(okChroma(mixHex(a("green"), a("yellow"), 0.4), 0.7), bg))
  put("slate", readable(okChroma(mixHex(a("blue"), a("cyan"), 0.4), 0.55), bg))
  put("indigo", readable(okChroma(mixHex(a("blue"), a("magenta"), 0.4), 0.8), bg))
  put("maroon", readable(okChroma(mixHex(a("red"), a("magenta"), 0.4), 0.7), bg))
  put("pink", readable(okChroma(mixHex(a("magenta"), a("red"), 0.25), 0.7), bg))
  // tinted bg/fg companion pairs — fg floored against its own bg, as above
  for (const [name, base] of [
    ["clay", mixHex(a("red"), a("yellow"), 0.35)],
    ["ochre", a("yellow")],
    ["lavender", mixHex(a("magenta"), a("blue"), 0.3)],
    ["sage", a("green")]
  ]) {
    const tint = mixHex(bg, base, 0.22)
    put("bg-" + name, tint)
    put("fg-" + name, readable(mixHex(base, fg, 0.4), tint))
  }
  // fg-main is the theme's own primary text on its own background and clears
  // AA unaided on every theme here (5.93:1 worst), so it is passed through
  // untouched — flooring it would restyle the one color the theme most owns.
  put("fg-alt", readable(mixHex(fg, accent, 0.35), bg))
  put("fg-dim", readable(dim, bg, MUTED))
  // The inactive mode line paints text.muted on surface.1, a pairing 16 of
  // the 22 themes leave under 3:1 — the same muted floor rescues it.
  put("fg-mode-line-inactive", readable(dim, tokens["surface.1"] || bg, MUTED))
  put("border", mixHex(raised, dim, 0.5))
  put("bg-completion", mixHex(bg, accent, 0.35))
  put("bg-hover", mixHex(raised, accent, 0.2))
  put("bg-hover-secondary", mixHex(raised, tokens["accent.warn"] || a("yellow"), 0.25))
  // hl-line is surface.2 accent-TINTED, not surface.2 itself: bg-inactive is
  // surface.2, the user-level modus faint preset maps bg-region onto
  // bg-inactive, and hl-line + region at the same value makes a selection
  // invisible on the current line. Modus itself separates the pair by hue at
  // equal lightness (bluish hl-line, neutral bg-inactive) — same move here,
  // in the theme's own accent.
  put("bg-hl-line", mixHex(tokens["surface.2"] || bg, accent, 0.22))
  put("bg-paren-match", mixHex(bg, a("cyan"), 0.4))
  put("bg-paren-expression", mixHex(bg, a("magenta"), 0.25))
  put("border-mode-line", mixHex(raised, fg, 0.25))
  // modeline status colors sit on bg-mode-line-active (surface.3); the fg
  // blend alone bottomed out at 2.47:1 on rose-pine, so the shared contrast
  // floor lifts them (lightness-only, hue kept) to stay legible everywhere.
  // These stay at MUTED rather than AA: they are glyph-sized status accents
  // on an already-raised surface, not running text.
  put("modeline-err", readable(mixHex(tokens["accent.error"] || a("red"), fg, 0.35), raised, MUTED))
  put("modeline-warning", readable(mixHex(tokens["accent.warn"] || a("yellow"), fg, 0.35), raised, MUTED))
  put("modeline-info", readable(mixHex(a("cyan"), fg, 0.35), raised, MUTED))
}

// Template functions — `{{ fn token }}`. Plain `{{token}}` substitution stays
// what it was; these exist for the one thing it cannot express, which is a
// token whose VALUE decides which config KEY gets written. Omarchy has the
// same split (their sed script gets pre-computed `{{ shell_gradient X }}` /
// `{{ hypr_gradient X }}` entries alongside the flat colors).
const TEMPLATE_FNS = {
  // niri's active border/focus-ring line. A gradient token becomes
  // `active-gradient from=… to=… angle=… relative-to="workspace-view"`; a
  // solid one stays `active-color "…"`. Angles are stored in Hyprland's
  // convention (the themes were ported from there); niri reads CSS angles,
  // hence cssAngle.
  niri_active: spec => {
    const g = parseSpec(spec)
    if (!g.enabled) {
      const flat = firstColor(spec)
      return `active-color "${flat || spec}"`
    }
    const from = g.colors[0]
    const to = g.colors[g.colors.length - 1]
    return `active-gradient from="${from}" to="${to}" angle=${cssAngle(g.angle)} relative-to="workspace-view"`
  },
  // The flat color a gradient degrades to, for configs with nowhere to put
  // one (theirs: gradient_start).
  gradient_start: spec => firstColor(spec) || spec,
  // The window drop shadow, per theme. Emits a full shadow block when the
  // theme (or its preset) enables it; a comment otherwise — config.kdl never
  // turns shadows on, so the absence of an `on` here IS the off state.
  niri_shadow: () => {
    if (String(tokens["shadow.enabled"]) !== "true") return "// shadow: off for this theme"
    const n = k => { const v = Number(tokens["shadow." + k]); return isFinite(v) ? v : 0 }
    return "shadow {\n" +
      "        on\n" +
      `        softness ${n("softness")}\n` +
      `        spread ${n("spread")}\n` +
      `        offset x=${n("offset-x")} y=${n("offset-y")}\n` +
      `        color "${tokens["shadow.color"] || "#00000077"}"\n` +
      "    }"
  },
  // The base window-opacity pair (blur off), with the media exemption
  // re-stated AFTER it: this include is the last opacity writer before the
  // blur fragment, and for a contested property the latest matching rule
  // wins — without the re-statement a theme's blanket opacity would beat
  // config.kdl's media rule. Must mirror config.kdl's media match set.
  niri_opacity: () => {
    const num = (k, d) => { const v = Number(tokens["opacity." + k]); return isFinite(v) ? Math.min(1, Math.max(0.5, v)) : d }
    const active = num("active", 0.985)
    const inactive = num("inactive", 0.96)
    const rules = []
    if (active < 1) rules.push(`window-rule {\n    opacity ${active}\n}`)
    if (inactive < 1 && inactive !== active) rules.push(`window-rule {\n    match is-active=false\n    opacity ${inactive}\n}`)
    if (rules.length === 0) return "// opacity: fully opaque for this theme"
    rules.push('window-rule {\n' +
      '    match app-id=r#"^(zoom|vlc|mpv|org\\.kde\\.kdenlive|com\\.obsproject\\.Studio|com\\.github\\.PintaProject\\.Pinta|imv)$"#\n' +
      '    match app-id=r#"^org\\.quickshell$"#\n' +
      '    match title=r#"Picture.?in.?[Pp]icture"#\n' +
      '    opacity 1.0\n' +
      '}')
    return rules.join("\n\n")
  },
  // The compositor side of the theme's motion character: explicit animation
  // blocks built from the motion.* tokens, replacing config.kdl's reference
  // values (included sections merge and the later definition of each block
  // wins). motion.duration 0 stills the compositor outright.
  niri_animations: () => {
    if (Number(tokens["motion.duration"]) === 0) return "off"
    const n = (k, d) => { const v = Number(tokens["motion." + k]); return isFinite(v) && v > 0 ? v : d }
    const damping = Math.min(2, Math.max(0.4, n("spring-damping", 1.0)))
    const curve = name => {
      const named = {
        "linear": null,
        "standard": [0.33, 1, 0.68, 1],
        "signature": [0.23, 1, 0.32, 1],
        "snap": [0.19, 1, 0.22, 1],
        "overshoot": [0.34, 1.56, 0.64, 1]
      }
      const v = String(name || "").trim()
      if (v in named) return named[v] === null ? `curve "linear"` : `curve "cubic-bezier" ${named[v].join(" ")}`
      const pts = v.split(/\s+/).map(Number)
      if (pts.length === 4 && pts.every(isFinite)) return `curve "cubic-bezier" ${pts.join(" ")}`
      return `curve "ease-out-cubic"`
    }
    // damping-ratio must be a KDL float literal — `1` is rejected as an
    // integer where niri expects a float.
    const spring = stiffness => `spring damping-ratio=${damping.toFixed(2)} stiffness=${stiffness} epsilon=0.0001`
    const s = n("spring-stiffness", 1000)
    const ws = n("workspace-stiffness", 1200)
    return [
      `window-open {\n        duration-ms ${n("open-ms", 400)}\n        ${curve(tokens["motion.open-curve"])}\n    }`,
      `window-close {\n        duration-ms ${n("close-ms", 150)}\n        ${curve(tokens["motion.close-curve"])}\n    }`,
      `window-movement {\n        ${spring(s)}\n    }`,
      `window-resize {\n        ${spring(s)}\n    }`,
      `horizontal-view-movement {\n        ${spring(s)}\n    }`,
      `overview-open-close {\n        ${spring(s)}\n    }`,
      `workspace-switch {\n        ${spring(ws)}\n    }`
    ].join("\n    ")
  }
}

let missing = []
function render(tmpl) {
  return tmpl
    .replace(/\{\{\s*([a-z_]+)\s+([A-Za-z0-9_.-]+)\s*\}\}/g, (m, fn, key) => {
      if (!TEMPLATE_FNS[fn]) { missing.push(fn + "()"); return m }
      const v = tokens[key]
      if (v === undefined) { missing.push(key); return m }
      return TEMPLATE_FNS[fn](String(v))
    })
    .replace(/\{\{([A-Za-z0-9_.-]+)(?:\|(hexa?))?\}\}/g, (m, key, filter) => {
      const v = tokens[key]
      if (v === undefined) { missing.push(key); return m }
      if (filter === "hex") return String(v).replace(/^#/, "")
      if (filter === "hexa") return String(v).replace(/^#/, "") + "ff"
      return String(v)
    })
}

function writeAtomic(dest, content) {
  fs.mkdirSync(path.dirname(dest), { recursive: true })
  const tmp = dest + ".tmp"
  fs.writeFileSync(tmp, content)
  fs.renameSync(tmp, dest)
}

const OUTPUTS = {
  "foot.ini.tmpl": [path.join(HOME, ".config/foot/foot.ini")],
  "foot-theme.ini.tmpl": [path.join(HOME, ".config/foot/theme.ini")],
  // kitty: the yazi-only terminal (drag-and-drop needs OSC 72, which foot does
  // not implement). Same two-file split as foot — config includes theme — so
  // one palette and one font pair drive both terminals.
  "kitty.conf.tmpl": [path.join(HOME, ".config/kitty/kitty.conf")],
  "kitty-theme.conf.tpl": [path.join(HOME, ".config/kitty/theme.conf")],
  "gtk.css.tmpl": [
    path.join(HOME, ".config/gtk-3.0/gtk.css"),
