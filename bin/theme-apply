#!/usr/bin/env -S mise exec -- node
// Renders templates/ from the active theme and re-themes running foot
// terminals via OSC escapes (pattern from omarchy, CREDITS.md).
// Contrast math is shared with the shell: shell/Commons/color.js is the
// single source of truth, evaluated here directly.
"use strict"
const fs = require("fs")
const os = require("os")
const path = require("path")
const { execSync } = require("child_process")

const ROOT = path.resolve(__dirname, "..")
const HOME = os.homedir()
const STATE = path.join(HOME, ".local/state/qshell/theme.toml")

// Indirect eval: runs in global scope, so color.js's function declarations
// become globals despite this module's "use strict".
;(0, eval)(fs.readFileSync(path.join(ROOT, "shell/Commons/color.js"), "utf8"))
;(0, eval)(fs.readFileSync(path.join(ROOT, "shell/Commons/defaults.js"), "utf8"))
;(0, eval)(fs.readFileSync(path.join(ROOT, "shell/Commons/gradient.js"), "utf8"))

// Same limited walker as Services/Theme.qml — sections, key = value,
// quoted keys, strings/numbers/bare words, inline comments.
function parseToml(raw) {
  const out = {}
  let section = ""
  for (const lineRaw of String(raw).split("\n")) {
    const line = lineRaw.trim()
    if (!line || line.startsWith("#")) continue
    const sec = line.match(/^\[([A-Za-z0-9_.-]+)\]\s*(#.*)?$/)
    if (sec) { section = sec[1]; continue }
    const kv = line.match(/^(?:"([^"]+)"|([A-Za-z0-9_-]+))\s*=\s*(?:"([^"]*)"|(-?\d+(?:\.\d+)?)|([A-Za-z][A-Za-z0-9_-]*))\s*(#.*)?$/)
    if (!kv || !section) continue
    const key = kv[1] !== undefined ? kv[1] : kv[2]
    out[section + "." + key] = kv[3] !== undefined ? kv[3] : (kv[4] !== undefined ? kv[4] : kv[5])
  }
  return out
}

const themeTokens = parseToml(fs.readFileSync(STATE, "utf8"))

// Machine-level overrides, exactly as Services/Theme.qml layers them: the
// same ~/.config/qshell/theme-override.toml wins over the active theme, so a
// per-machine tweak (bin/text-size writes [font] size there) reaches the
// TEMPLATED apps too, not just the shell — before this the shell scaled and
// foot/GTK stayed put.
let overrideTokens = {}
try {
  overrideTokens = parseToml(fs.readFileSync(path.join(HOME, ".config/qshell/theme-override.toml"), "utf8"))
} catch (e) { /* no override file — the common case */ }

const tokens = Object.assign({}, THEME_DEFAULTS, themeTokens, overrideTokens)

// The theme's own base size, pre-override: the GTK settings.ini font pins to
// this so text scaling flows through ONE channel (text-scaling-factor below)
// instead of compounding with a scaled gtk-font-name.
tokens["font.size-base"] = String(themeTokens["font.size"] !== undefined ? themeTokens["font.size"] : THEME_DEFAULTS["font.size"] || 12)

// Same font precedence Services/Theme.qml applies, so the shell and the
// templated app configs never disagree: a theme that names the token wins; one
// that stays quiet follows the fontconfig `monospace` alias. Both tokens read
// that one alias — this desktop draws in a single family — and it is asked for
// by name here because a template hands a concrete family to foot and GTK,
// not an alias each would resolve for itself.
{
  let resolved = ""
  try {
    resolved = execSync("fc-match -f '%{family[0]}' monospace").toString().trim()
  } catch (e) { /* no fontconfig; keep the builtin defaults */ }
  if (resolved) {
    for (const token of ["font.ui", "font.mono"]) {
      if (themeTokens[token] === undefined && overrideTokens[token] === undefined)
        tokens[token] = resolved
    }
  }
}

// ---- text-size derivations (omarchy-display-text-size port, CREDITS.md) ----
// One knob: [font] size in the override file (bin/text-size writes it).
// Anchors follow the foot metrics commit: token 12 == foot 12.5pt / 32px
// line-height == GTK factor 1.0. Terminal sizes are derived here so the foot
// template scales with the knob instead of hardcoding the pair.
{
  const base = Number(tokens["font.size-base"]) || 12
  const size = Number(tokens["font.size"]) || base
  const ratio = size / base
  tokens["font.foot-pt"] = String(Math.round(12.5 * ratio * 10) / 10)
  tokens["font.foot-line-height"] = String(Math.max(1, Math.round(32 * ratio)))

  // GTK: the interface fonts are ours (set below), so the factor's
  // quantization anchor is our own base — rounded so the effective interface
  // font lands on a whole point size (omarchy's fix for GTK4 menus clipping
  // ascenders on raw ratios). Always written: 1.0000 on reset IS the reset.
  const factor = (Math.round(base * ratio) / base).toFixed(4)
  try {
    execSync(`gsettings set org.gnome.desktop.interface font-name "${tokens["font.ui"]} ${base}"`, { stdio: "ignore" })
    execSync(`gsettings set org.gnome.desktop.interface monospace-font-name "${tokens["font.mono"]} ${base}"`, { stdio: "ignore" })
    execSync(`gsettings set org.gnome.desktop.interface text-scaling-factor ${factor}`, { stdio: "ignore" })
  } catch (e) { /* gsettings absent or no session bus */ }
}

// Per-theme GTK icon theme, resolved once — the settings.ini template and the
// gsettings flip below must agree. (meta.mode read inline: `mode` is declared
// further down, past this block's runtime.)
tokens["icon.resolved"] = String(tokens["icon.theme"] || (String(tokens["meta.mode"]) === "light" ? "Yaru" : "Yaru-dark"))

// The shell watches two files that may not exist yet on a fresh checkout
// (~/.config/qshell/theme-override.toml and the chezmoi-managed fontconfig
// policy), and a FileView cannot arm its watch on a path whose parent
// directory is missing — the file's first appearance would then need a shell
// restart to be noticed. Guarantee the directories instead: this runs on every
// theme change and at bootstrap.
for (const dir of [".config/qshell", ".config/fontconfig/conf.d"]) {
  fs.mkdirSync(path.join(HOME, dir), { recursive: true })
}

// A token's value may name another token ("accent.accent") instead of
// carrying a literal — the same indirection Services/Theme.qml resolves with
// deref(). Flatten the whole map once here so every template, template
// function and OSC write below sees a literal. Bounded, so a cycle settles on
// the last value seen rather than hanging.
for (const key of Object.keys(tokens)) {
  let v = String(tokens[key]).trim()
  for (let i = 0; i < 8; i++) {
    if (!/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(v)) break
    const next = tokens[v]
    if (next === undefined || String(next).trim() === v) break
    v = String(next).trim()
  }
  tokens[key] = v
}

// Derived tokens — same construction rules as Services/Theme.qml. The guard
// reads the RAW theme tokens: THEME_DEFAULTS pre-populates the merged map, so
// checking `tokens` would never derive and every theme would silently inherit
// tokyo-night's near-black default onto its own accent.
if (themeTokens["text.on-accent"] === undefined && tokens["accent.accent"]) {
  tokens["text.on-accent"] = ensureContrast(
    tokens["surface.0"] || "#16161e", tokens["accent.accent"], 4.5)
}

// The active-border token, derived from the accent when a theme omits it —
// same rule as text.on-accent above, and the same rule Services/Theme.qml
// applies, so a theme without the token looks identical either side of the
// shell boundary.
if (!tokens["border.active"]) tokens["border.active"] = tokens["accent.accent"]

// GTK polarity, derived here so the settings.ini template and the gsettings
// calls below read the same decision.
const mode = String(tokens["meta.mode"]) === "light" ? "light" : "dark"
tokens["gtk.prefer-dark"] = mode === "light" ? "0" : "1"
// zathura page recolor follows the same polarity: dark themes tint the
// document into theme colors, light themes show pages as printed.
tokens["zathura.recolor"] = mode === "light" ? "false" : "true"

// Plain sRGB interpolation, matching omarchy's awk mix_color — shared by the
// claude and emacs derived-shade blocks below.
function mixHex(aHex, bHex, t) {
  const a = hexToRgb(aHex), b = hexToRgb(bHex)
  if (!a || !b) return aHex
  return rgbToHex({
    r: a.r + (b.r - a.r) * t,
    g: a.g + (b.g - a.g) * t,
    b: a.b + (b.b - a.b) * t
  })
}

// Claude Code custom-theme shades (templates/claude-theme.json.tmpl) — the
// omarchy claude.json.tpl carries `{{ mix a b N% }}` expressions; our engine
// substitutes flat tokens, so the mixes are precomputed here instead.
{
  const mix = mixHex
  const bg = tokens["surface.0"] || "#16161e"
  const fg = tokens["text.primary"] || "#c0caf5"
  const accent = tokens["accent.accent"] || "#7aa2f7"
  tokens["claude.accent-shimmer"] = mix(accent, fg, 0.35)
  tokens["claude.inactive"] = mix(fg, bg, 0.40)
  tokens["claude.inactive-shimmer"] = mix(fg, bg, 0.25)
  tokens["claude.permission-shimmer"] = mix(tokens["ansi.blue"] || accent, fg, 0.35)
  tokens["claude.warning-shimmer"] = mix(tokens["ansi.yellow"] || accent, fg, 0.35)
  tokens["claude.diff-added"] = mix(bg, tokens["ansi.green"] || fg, 0.15)
  tokens["claude.diff-removed"] = mix(bg, tokens["ansi.red"] || fg, 0.15)
  tokens["claude.diff-added-dimmed"] = mix(bg, tokens["ansi.green"] || fg, 0.08)
  tokens["claude.diff-removed-dimmed"] = mix(bg, tokens["ansi.red"] || fg, 0.08)
  tokens["claude.diff-added-word"] = mix(bg, tokens["ansi.green"] || fg, 0.32)
  tokens["claude.diff-removed-word"] = mix(bg, tokens["ansi.red"] || fg, 0.32)
  tokens["claude.raised-bg"] = mix(bg, fg, 0.06)
  tokens["claude.raised-bg-hover"] = mix(bg, fg, 0.10)
  tokens["claude.rate-limit-empty"] = mix(bg, fg, 0.20)
}

// Emacs modus-palette shades (templates/emacs-theme.el.tmpl). The
// qshell-dark/qshell-light themes in the emacs config (saifulapm/emacs.d,
// themes/) are Modus derivatives: modus-themes keeps all ~200 semantic
// mappings and full face coverage, and the rendered file supplies the ~130
// NAMED colors those mappings resolve to. Every shade is blended from the
// theme's own tokens so nothing leaves the theme's gamut: warmer/cooler hue
// variants mix a quarter toward a neighboring ansi hue (the directions modus
// itself leans — red-warmer toward orange, blue-warmer toward violet), faint
// drops chroma in OKLCH with hue and lightness held, intense is the bright
// ansi color, and the special-purpose backgrounds are bg tinted by their hue.
{
  const bg = tokens["surface.0"] || "#16161e"
  const fg = tokens["text.primary"] || "#c0caf5"
  const accent = tokens["accent.accent"] || "#7aa2f7"
  const raised = tokens["surface.3"] || bg
  const a = name => tokens["ansi." + name] || fg
  const put = (key, v) => { tokens["emacs." + key] = v }
  // chroma-only OKLCH adjustment; _gamutMap keeps the result in sRGB
  const okChroma = (hex, mul) => {
    const c = hexToRgb(hex)
    if (!c) return hex
    const o = _rgbToOklch(c)
    return rgbToHex(_gamutMap({ L: o.L, C: o.C * mul, h: o.h }))
  }

  const NEIGHBORS = { // hue: [warmer-toward, cooler-toward]
    red: ["yellow", "magenta"], green: ["yellow", "cyan"],
    yellow: ["red", "green"], blue: ["magenta", "cyan"],
    magenta: ["red", "blue"], cyan: ["blue", "green"]
  }
  for (const [hue, dirs] of Object.entries(NEIGHBORS)) {
    put(hue + "-warmer", mixHex(a(hue), a(dirs[0]), 0.25))
    put(hue + "-cooler", mixHex(a(hue), a(dirs[1]), 0.25))
    put(hue + "-faint", okChroma(a(hue), 0.55))
    put("bg-" + hue + "-intense", mixHex(bg, a(hue), 0.5))
    put("bg-" + hue + "-subtle", mixHex(bg, a(hue), 0.3))
    put("bg-" + hue + "-nuanced", mixHex(bg, a(hue), 0.15))
    put("bg-graph-" + hue + "-1", mixHex(a(hue), bg, 0.45))
  }
  // diff blocks: bg tints stepped faint < base < refine < fringe, like modus
  for (const [group, hue] of [["added", "green"], ["changed", "yellow"], ["removed", "red"]]) {
    put("bg-" + group, mixHex(bg, a(hue), 0.2))
    put("bg-" + group + "-faint", mixHex(bg, a(hue), 0.12))
    put("bg-" + group + "-refine", mixHex(bg, a(hue), 0.3))
    put("bg-" + group + "-fringe", mixHex(bg, a(hue), 0.5))
    put("fg-" + group, mixHex(a(hue), fg, 0.4))
  }
  // modus's off-palette accent hues (org agenda dates, prose, mail levels),
  // as in-theme blends muted by a chroma cut
  put("rust", okChroma(mixHex(a("red"), a("yellow"), 0.4), 0.75))
  put("gold", okChroma(mixHex(a("yellow"), a("red"), 0.25), 0.8))
  put("olive", okChroma(mixHex(a("green"), a("yellow"), 0.4), 0.7))
  put("slate", okChroma(mixHex(a("blue"), a("cyan"), 0.4), 0.55))
  put("indigo", okChroma(mixHex(a("blue"), a("magenta"), 0.4), 0.8))
  put("maroon", okChroma(mixHex(a("red"), a("magenta"), 0.4), 0.7))
  put("pink", okChroma(mixHex(a("magenta"), a("red"), 0.25), 0.7))
  // tinted bg/fg companion pairs
  for (const [name, base] of [
    ["clay", mixHex(a("red"), a("yellow"), 0.35)],
    ["ochre", a("yellow")],
    ["lavender", mixHex(a("magenta"), a("blue"), 0.3)],
    ["sage", a("green")]
  ]) {
    put("bg-" + name, mixHex(bg, base, 0.22))
    put("fg-" + name, mixHex(base, fg, 0.4))
  }
  put("fg-alt", mixHex(fg, accent, 0.35))
  put("border", mixHex(raised, tokens["text.muted"] || fg, 0.5))
  put("bg-completion", mixHex(bg, accent, 0.35))
  put("bg-hover", mixHex(raised, accent, 0.2))
  put("bg-hover-secondary", mixHex(raised, tokens["accent.warn"] || a("yellow"), 0.25))
  // hl-line is surface.2 accent-TINTED, not surface.2 itself: bg-inactive is
  // surface.2, the user-level modus faint preset maps bg-region onto
  // bg-inactive, and hl-line + region at the same value makes a selection
  // invisible on the current line. Modus itself separates the pair by hue at
  // equal lightness (bluish hl-line, neutral bg-inactive) — same move here,
  // in the theme's own accent.
  put("bg-hl-line", mixHex(tokens["surface.2"] || bg, accent, 0.22))
  put("bg-paren-match", mixHex(bg, a("cyan"), 0.4))
  put("bg-paren-expression", mixHex(bg, a("magenta"), 0.25))
  put("border-mode-line", mixHex(raised, fg, 0.25))
  // modeline status colors sit on bg-mode-line-active (surface.3); the fg
  // blend alone bottomed out at 2.47:1 on rose-pine, so the shared contrast
  // floor lifts them (lightness-only, hue kept) to stay legible everywhere.
  put("modeline-err", ensureContrast(mixHex(tokens["accent.error"] || a("red"), fg, 0.35), raised, 3.0))
  put("modeline-warning", ensureContrast(mixHex(tokens["accent.warn"] || a("yellow"), fg, 0.35), raised, 3.0))
  put("modeline-info", ensureContrast(mixHex(a("cyan"), fg, 0.35), raised, 3.0))
}

// Template functions — `{{ fn token }}`. Plain `{{token}}` substitution stays
// what it was; these exist for the one thing it cannot express, which is a
// token whose VALUE decides which config KEY gets written. Omarchy has the
// same split (their sed script gets pre-computed `{{ shell_gradient X }}` /
// `{{ hypr_gradient X }}` entries alongside the flat colors).
const TEMPLATE_FNS = {
  // niri's active border/focus-ring line. A gradient token becomes
  // `active-gradient from=… to=… angle=… relative-to="workspace-view"`; a
  // solid one stays `active-color "…"`. Angles are stored in Hyprland's
  // convention (the themes were ported from there); niri reads CSS angles,
  // hence cssAngle.
  niri_active: spec => {
    const g = parseSpec(spec)
    if (!g.enabled) {
      const flat = firstColor(spec)
      return `active-color "${flat || spec}"`
    }
    const from = g.colors[0]
    const to = g.colors[g.colors.length - 1]
    return `active-gradient from="${from}" to="${to}" angle=${cssAngle(g.angle)} relative-to="workspace-view"`
  },
  // The flat color a gradient degrades to, for configs with nowhere to put
  // one (theirs: gradient_start).
  gradient_start: spec => firstColor(spec) || spec,
  // The compositor side of the theme's motion character. motion.duration is
  // the shell's base animation duration (150 ms = reference speed); niri gets
  // the same scale as one global slowdown factor, so a slow theme slows the
  // compositor with the shell and a zero-motion theme turns niri animations
  // off outright. Clamped: past 2× the springs read as broken, not dreamy.
  niri_motion: v => {
    const d = Number(v)
    if (!isFinite(d) || d < 0) return "slowdown 1.0"
    if (d === 0) return "off"
    return "slowdown " + Math.min(2, Math.max(0.5, d / 150)).toFixed(2)
  }
}

let missing = []
function render(tmpl) {
  return tmpl
    .replace(/\{\{\s*([a-z_]+)\s+([A-Za-z0-9_.-]+)\s*\}\}/g, (m, fn, key) => {
      if (!TEMPLATE_FNS[fn]) { missing.push(fn + "()"); return m }
      const v = tokens[key]
      if (v === undefined) { missing.push(key); return m }
      return TEMPLATE_FNS[fn](String(v))
    })
    .replace(/\{\{([A-Za-z0-9_.-]+)(?:\|(hexa?))?\}\}/g, (m, key, filter) => {
      const v = tokens[key]
      if (v === undefined) { missing.push(key); return m }
      if (filter === "hex") return String(v).replace(/^#/, "")
      if (filter === "hexa") return String(v).replace(/^#/, "") + "ff"
      return String(v)
    })
}

function writeAtomic(dest, content) {
  fs.mkdirSync(path.dirname(dest), { recursive: true })
  const tmp = dest + ".tmp"
  fs.writeFileSync(tmp, content)
  fs.renameSync(tmp, dest)
}

const OUTPUTS = {
  "foot.ini.tmpl": [path.join(HOME, ".config/foot/foot.ini")],
  "foot-theme.ini.tmpl": [path.join(HOME, ".config/foot/theme.ini")],
  "gtk.css.tmpl": [
    path.join(HOME, ".config/gtk-3.0/gtk.css"),
    path.join(HOME, ".config/gtk-4.0/gtk.css")
  ],
  "gtk-settings.ini.tmpl": [
    path.join(HOME, ".config/gtk-3.0/settings.ini"),
    path.join(HOME, ".config/gtk-4.0/settings.ini")
  ],
  "niri-theme.kdl.tmpl": [path.join(HOME, ".local/state/qshell/niri-theme.kdl")],
  "oma-theme.toml.tmpl": [path.join(HOME, ".local/state/qshell/oma-theme.toml")],
  "yazi-theme.toml.tpl": [path.join(HOME, ".config/yazi/theme.toml")],
  "tmux-theme.tmpl": [path.join(HOME, ".config/tmux/theme.conf")],
  "zathurarc.tmpl": [path.join(HOME, ".config/zathura/zathurarc")],
  // omarchy gap item 6 (user-picked 2026-08-07): btop + helix render into
  // their theme DIRS under the fixed name "qshell" (btop.conf and helix
  // config.toml pin it); Claude Code hot-reloads ~/.claude/themes on change,
  // settings.json pins theme "custom:qshell"; gum is env-var-styled, the
  // state file is sourced by fish conf.d/40-gum-theme.fish at shell start.
  "btop-theme.tmpl": [path.join(HOME, ".config/btop/themes/qshell.theme")],
  "helix-theme.toml.tmpl": [path.join(HOME, ".config/helix/themes/qshell.toml")],
  "claude-theme.json.tmpl": [path.join(HOME, ".claude/themes/qshell.json")],
  "gum-theme.fish.tmpl": [path.join(HOME, ".local/state/qshell/gum-theme.fish")],
  // emacs: rendered DATA, not a theme — the qshell-dark/qshell-light Modus
  // derivatives in the emacs config (its own repo) load this file for their
  // named colors, so the generated artifact stays out of that repo's tree.
  "emacs-theme.el.tmpl": [path.join(HOME, ".local/state/qshell/emacs-theme.el")]
}

let gtkSettingsChanged = false
for (const [tmplName, dests] of Object.entries(OUTPUTS)) {
  const tmplPath = path.join(ROOT, "templates", tmplName)
  if (!fs.existsSync(tmplPath)) continue
  const rendered = render(fs.readFileSync(tmplPath, "utf8"))
  for (const dest of dests) {
    if (tmplName === "gtk-settings.ini.tmpl") {
      let old = null
      try { old = fs.readFileSync(dest, "utf8") } catch (e) { /* first render */ }
      if (old !== rendered) gtkSettingsChanged = true
    }
    writeAtomic(dest, rendered)
  }
}
if (missing.length) console.warn("theme-apply: tokens missing from theme:",
  [...new Set(missing)].join(", "))

// ---- GTK light/dark polarity ----
// Two channels, because neither covers everything: gsettings is what
// libadwaita apps read (and what a gsettings desktop backend would broadcast),
// and settings.ini above is what plain GTK reads on niri, where no such
// backend runs.
try {
  execSync(`gsettings set org.gnome.desktop.interface color-scheme prefer-${mode}`, { stdio: "ignore" })
  // Always "Adwaita", never "Adwaita-dark": that theme does not exist on disk
  // (GTK3's Adwaita is built into the library and its dark variant is the
  // prefer-dark flag in settings.ini), and naming it drops GTK to the light
  // default — measured, it was why every GTK app stayed light on a dark theme.
  execSync("gsettings set org.gnome.desktop.interface gtk-theme Adwaita", { stdio: "ignore" })
  // Per-theme GTK icon theme (omarchy gap item 6): themes carry icon.theme
  // (omarchy's icons.theme files, Yaru color variants — the Fedora
  // yaru-icon-theme rpm ships every variant in one package); themes without
  // the token follow polarity on the neutral Yaru pair. Resolved once up top
  // (icon.resolved) so this flip and settings.ini agree. New GTK apps only,
  // like the gtk-theme flip above.
  const iconTheme = String(tokens["icon.resolved"])
  // Flip only when the theme is actually on disk: naming a not-yet-installed
  // theme breaks Qt icon lookup entirely — hicolor fallback included — for
  // every process that resolves it, and installing the package later does not
  // retrigger resolution (2026-08-07: Yaru-purple named 6h before the
  // yaru-icon-theme rpm landed; every shell icon fell back to the checkerboard).
  const iconThemeOnDisk = [
    path.join(HOME, ".icons"), path.join(HOME, ".local/share/icons"),
    "/usr/local/share/icons", "/usr/share/icons",
  ].some((d) => fs.existsSync(path.join(d, iconTheme, "index.theme")))
  if (/^[A-Za-z0-9._-]+$/.test(iconTheme) && iconThemeOnDisk)
    execSync(`gsettings set org.gnome.desktop.interface icon-theme "${iconTheme}"`, { stdio: "ignore" })
  else if (!iconThemeOnDisk)
    console.warn(`theme-apply: icon theme "${iconTheme}" not installed, keeping previous icon theme`)
} catch (e) { /* gsettings absent or no session bus */ }

// ---- Browser theme color (enterprise policy) ----
// Port of the Arch dotfiles-linux / omarchy mechanism: BrowserThemeColor
// tints the frame from the theme's base surface (the Arch per-theme
// chromium.theme files were exactly surface.1 — catppuccin's was #1e1e2e),
// and BrowserColorScheme=device follows the color-scheme flip above.
// run_after_14-chromium-policy.sh preps the dirs once (user-owned); on an
// unprepped machine or one without the browser, the write fails into the
// catch and the theme change proceeds untinted. Plain writeFileSync, not
// writeAtomic: its mkdirSync would EACCES on /etc before failing cleanly.
const browserPolicy = JSON.stringify({
  BrowserThemeColor: String(tokens["surface.1"] || "#1c2027"),
  BrowserColorScheme: "device"
})
for (const [dir, refresh] of [
  ["/etc/chromium/policies/managed", "chromium-browser"],
  ["/etc/opt/chrome/policies/managed", "google-chrome"]
]) {
  const dest = path.join(dir, "color.json")
  try {
    let old = null
    try { old = fs.readFileSync(dest, "utf8") } catch (e) { /* first write */ }
    if (old === browserPolicy) continue
    fs.writeFileSync(dest, browserPolicy)
    // Poke a running instance; skips quietly when the browser is not up.
    execSync(`sh -c 'pgrep -f ${refresh} >/dev/null && ${refresh} --refresh-platform-policy --no-startup-window >/dev/null 2>&1 &'`,
      { stdio: "ignore" })
  } catch (e) { /* policy dir unprepped or browser absent */ }
}

// The portal's GTK backend draws the file dialog we fall back to, and it reads
// settings.ini once at startup — so it has to be restarted to follow a
// POLARITY flip. Only then: restarting on every apply let a burst of theme
// switches trip systemd's start limit ("start-limit-hit"), which left the
// service failed and every fallback file dialog dead until a manual
// reset-failed (found 2026-08-06 in the user journal). Same-mode theme
// switches don't change settings.ini, so they skip this entirely; the
// reset-failed first heals a unit a previous burst already tripped.
if (gtkSettingsChanged) {
  try {
    execSync("systemctl --user reset-failed xdg-desktop-portal-gtk.service", { stdio: "ignore" })
  } catch (e) { /* not failed, or no systemd user session */ }
  try {
    execSync("systemctl --user try-restart xdg-desktop-portal-gtk.service", { stdio: "ignore" })
  } catch (e) { /* no systemd user session */ }
}

// ---- live foot retheme via OSC (written to each foot child's pty) ----
const ANSI = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white",
  "bright-black", "bright-red", "bright-green", "bright-yellow",
  "bright-blue", "bright-magenta", "bright-cyan", "bright-white"]
let osc = ""
if (tokens["text.primary"]) osc += `\x1b]10;${tokens["text.primary"]}\x1b\\`
if (tokens["surface.0"]) osc += `\x1b]11;${tokens["surface.0"]}\x1b\\`
ANSI.forEach((name, i) => {
  const v = tokens["ansi." + name]
  if (v) osc += `\x1b]4;${i};${v}\x1b\\`
})

if (osc) {
  let ptys = []
  try {
    ptys = execSync(
      `for fp in $(pgrep -x foot); do for cp in $(pgrep -P $fp); do ` +
      `readlink /proc/$cp/fd/1 2>/dev/null; done; done | grep ^/dev/pts/ | sort -u`,
      { shell: "/bin/bash" }).toString().trim().split("\n").filter(Boolean)
  } catch (e) { /* no foot running */ }
  for (const pty of ptys) {
    try { fs.writeFileSync(pty, osc) } catch (e) { /* pty vanished */ }
  }
  if (ptys.length) console.log(`theme-apply: rethemed ${ptys.length} foot pty(s)`)
}

// ---- kakoune theme: converted from the rendered helix theme ----
// bin/helix-to-kak.js (the mac dotfiles converter, resurrected) is the
// single source of the kak face mapping — kak mirrors helix exactly rather
// than maintaining a second hand-mapped template (a first attempt kept
// gruvbox's faces and the statusline came out visibly different).
try {
  const { convertTheme } = require(path.join(ROOT, "bin/helix-to-kak.js"))
  convertTheme(path.join(HOME, ".config/helix/themes/qshell.toml"),
               path.join(HOME, ".config/kak/colors/qshell.kak"))
} catch (e) {
  console.warn("theme-apply: helix→kak conversion failed:", e.message)
}

// ---- btop / helix / Claude Code live re-theme (omarchy gap item 6) ----
// btop.conf is deliberately UNMANAGED (btop rewrites it on every clean exit —
// a chezmoi symlink would go permanently dirty); only the color_theme line is
// pinned, everything else stays the user's. Then the pokes: btop re-reads its
// config on SIGUSR2, helix on SIGUSR1 (Fedora's binary is hx, not helix —
// omarchy-restart-helix's pgrep would miss every process here). Claude Code
// needs no poke: it watches ~/.claude/themes and hot-reloads the file.
{
  const btopConf = path.join(HOME, ".config/btop/btop.conf")
  const pin = 'color_theme = "qshell"'
  try {
    let conf = ""
    try { conf = fs.readFileSync(btopConf, "utf8") } catch (e) { /* first run */ }
    if (!conf.split("\n").includes(pin)) {
      const next = /^color_theme\s*=/m.test(conf)
        ? conf.replace(/^color_theme\s*=.*$/m, pin)
        : pin + "\n" + conf
      writeAtomic(btopConf, next)
    }
  } catch (e) { /* unwritable config dir; theme file still rendered */ }
  try { execSync("pkill -SIGUSR2 -x btop", { stdio: "ignore" }) } catch (e) { /* none running */ }
  try { execSync("pkill -SIGUSR1 -x hx", { stdio: "ignore" }) } catch (e) { /* none running */ }
  // kakoune has no reload signal, but `colorscheme` re-sources the file —
  // pushed into every live session (kak_session daemons included) over -p.
  try {
    execSync("for s in $(kak -l 2>/dev/null); do echo 'colorscheme qshell' | kak -p \"$s\" 2>/dev/null || true; done",
      { stdio: "ignore", shell: "/bin/bash" })
  } catch (e) { /* kak absent or no sessions */ }
  // emacs: the qshell themes re-read the rendered palette on every
  // `load-theme`, and qshell-theme-refresh (emacs config) does exactly that —
  // including the polarity flip, which the portal signal also covers but this
  // poke is the only channel for same-polarity theme switches. fboundp-guarded
  // so a daemon running an older config answers nil instead of erroring; the
  // timeout keeps a wedged daemon from stalling the whole theme switch.
  try {
    execSync("emacsclient --eval \"(when (fboundp 'qshell-theme-refresh) (qshell-theme-refresh))\"",
      { stdio: "ignore", timeout: 5000 })
  } catch (e) { /* no emacs server */ }
}

console.log("theme-apply: done")
