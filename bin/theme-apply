  "btop-theme.tmpl": [path.join(HOME, ".config/btop/themes/qshell.theme")],
  "helix-theme.toml.tmpl": [path.join(HOME, ".config/helix/themes/qshell.toml")],
  // cliamp (the music player) takes a theme's NAME from its filename, so this
