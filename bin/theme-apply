#!/usr/bin/env -S mise exec -- node
// Renders templates/ from the active theme and re-themes running foot
// terminals via OSC escapes (pattern from omarchy, CREDITS.md).
// Contrast math is shared with the shell: shell/Commons/color.js is the
// single source of truth, evaluated here directly.
"use strict"
const fs = require("fs")
const os = require("os")
const path = require("path")
const { execSync } = require("child_process")

const ROOT = path.resolve(__dirname, "..")
const HOME = os.homedir()
const STATE = path.join(HOME, ".local/state/qshell/theme.toml")

// Indirect eval: runs in global scope, so color.js's function declarations
// become globals despite this module's "use strict".
;(0, eval)(fs.readFileSync(path.join(ROOT, "shell/Commons/color.js"), "utf8"))
;(0, eval)(fs.readFileSync(path.join(ROOT, "shell/Commons/defaults.js"), "utf8"))
;(0, eval)(fs.readFileSync(path.join(ROOT, "shell/Commons/gradient.js"), "utf8"))

// Same limited walker as Services/Theme.qml — sections, key = value,
// quoted keys, strings/numbers/bare words, inline comments.
function parseToml(raw) {
  const out = {}
  let section = ""
  for (const lineRaw of String(raw).split("\n")) {
    const line = lineRaw.trim()
    if (!line || line.startsWith("#")) continue
    const sec = line.match(/^\[([A-Za-z0-9_.-]+)\]\s*(#.*)?$/)
    if (sec) { section = sec[1]; continue }
    const kv = line.match(/^(?:"([^"]+)"|([A-Za-z0-9_-]+))\s*=\s*(?:"([^"]*)"|(-?\d+(?:\.\d+)?)|([A-Za-z][A-Za-z0-9_-]*))\s*(#.*)?$/)
    if (!kv || !section) continue
    const key = kv[1] !== undefined ? kv[1] : kv[2]
    out[section + "." + key] = kv[3] !== undefined ? kv[3] : (kv[4] !== undefined ? kv[4] : kv[5])
  }
  return out
}

const themeTokens = parseToml(fs.readFileSync(STATE, "utf8"))
const tokens = Object.assign({}, THEME_DEFAULTS, themeTokens)

// Same font precedence Services/Theme.qml applies, so the shell and the
// templated app configs never disagree: a theme that names the token wins; one
// that stays quiet follows the fontconfig `monospace` alias. Both tokens read
// that one alias — this desktop draws in a single family — and it is asked for
// by name here because a template hands a concrete family to foot and GTK,
// not an alias each would resolve for itself.
{
  let resolved = ""
  try {
    resolved = execSync("fc-match -f '%{family[0]}' monospace").toString().trim()
  } catch (e) { /* no fontconfig; keep the builtin defaults */ }
  if (resolved) {
    for (const token of ["font.ui", "font.mono"]) {
      if (themeTokens[token] === undefined) tokens[token] = resolved
    }
  }
}

// The shell watches two files that may not exist yet on a fresh checkout
// (~/.config/qshell/theme-override.toml and the chezmoi-managed fontconfig
// policy), and a FileView cannot arm its watch on a path whose parent
// directory is missing — the file's first appearance would then need a shell
// restart to be noticed. Guarantee the directories instead: this runs on every
// theme change and at bootstrap.
for (const dir of [".config/qshell", ".config/fontconfig/conf.d"]) {
  fs.mkdirSync(path.join(HOME, dir), { recursive: true })
}

// A token's value may name another token ("accent.accent") instead of
// carrying a literal — the same indirection Services/Theme.qml resolves with
// deref(). Flatten the whole map once here so every template, template
// function and OSC write below sees a literal. Bounded, so a cycle settles on
// the last value seen rather than hanging.
for (const key of Object.keys(tokens)) {
  let v = String(tokens[key]).trim()
  for (let i = 0; i < 8; i++) {
    if (!/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(v)) break
    const next = tokens[v]
    if (next === undefined || String(next).trim() === v) break
    v = String(next).trim()
  }
  tokens[key] = v
}

// Derived tokens — same construction rules as Services/Theme.qml. The guard
// reads the RAW theme tokens: THEME_DEFAULTS pre-populates the merged map, so
// checking `tokens` would never derive and every theme would silently inherit
// tokyo-night's near-black default onto its own accent.
if (themeTokens["text.on-accent"] === undefined && tokens["accent.accent"]) {
  tokens["text.on-accent"] = ensureContrast(
    tokens["surface.0"] || "#16161e", tokens["accent.accent"], 4.5)
}

// The active-border token, derived from the accent when a theme omits it —
// same rule as text.on-accent above, and the same rule Services/Theme.qml
// applies, so a theme without the token looks identical either side of the
// shell boundary.
if (!tokens["border.active"]) tokens["border.active"] = tokens["accent.accent"]

// GTK polarity, derived here so the settings.ini template and the gsettings
// calls below read the same decision.
const mode = String(tokens["meta.mode"]) === "light" ? "light" : "dark"
tokens["gtk.prefer-dark"] = mode === "light" ? "0" : "1"

// Template functions — `{{ fn token }}`. Plain `{{token}}` substitution stays
// what it was; these exist for the one thing it cannot express, which is a
// token whose VALUE decides which config KEY gets written. Omarchy has the
// same split (their sed script gets pre-computed `{{ shell_gradient X }}` /
// `{{ hypr_gradient X }}` entries alongside the flat colors).
const TEMPLATE_FNS = {
  // niri's active border/focus-ring line. A gradient token becomes
  // `active-gradient from=… to=… angle=… relative-to="workspace-view"`; a
  // solid one stays `active-color "…"`. Angles are stored in Hyprland's
  // convention (the themes were ported from there); niri reads CSS angles,
  // hence cssAngle.
  niri_active: spec => {
    const g = parseSpec(spec)
    if (!g.enabled) {
      const flat = firstColor(spec)
      return `active-color "${flat || spec}"`
    }
    const from = g.colors[0]
    const to = g.colors[g.colors.length - 1]
    return `active-gradient from="${from}" to="${to}" angle=${cssAngle(g.angle)} relative-to="workspace-view"`
  },
  // The flat color a gradient degrades to, for configs with nowhere to put
  // one (theirs: gradient_start).
  gradient_start: spec => firstColor(spec) || spec,
  // The compositor side of the theme's motion character. motion.duration is
  // the shell's base animation duration (150 ms = reference speed); niri gets
  // the same scale as one global slowdown factor, so a slow theme slows the
  // compositor with the shell and a zero-motion theme turns niri animations
  // off outright. Clamped: past 2× the springs read as broken, not dreamy.
  niri_motion: v => {
    const d = Number(v)
    if (!isFinite(d) || d < 0) return "slowdown 1.0"
    if (d === 0) return "off"
    return "slowdown " + Math.min(2, Math.max(0.5, d / 150)).toFixed(2)
  }
}

let missing = []
function render(tmpl) {
  return tmpl
    .replace(/\{\{\s*([a-z_]+)\s+([A-Za-z0-9_.-]+)\s*\}\}/g, (m, fn, key) => {
      if (!TEMPLATE_FNS[fn]) { missing.push(fn + "()"); return m }
      const v = tokens[key]
      if (v === undefined) { missing.push(key); return m }
      return TEMPLATE_FNS[fn](String(v))
    })
    .replace(/\{\{([A-Za-z0-9_.-]+)(?:\|(hexa?))?\}\}/g, (m, key, filter) => {
      const v = tokens[key]
      if (v === undefined) { missing.push(key); return m }
      if (filter === "hex") return String(v).replace(/^#/, "")
      if (filter === "hexa") return String(v).replace(/^#/, "") + "ff"
      return String(v)
    })
}

function writeAtomic(dest, content) {
  fs.mkdirSync(path.dirname(dest), { recursive: true })
  const tmp = dest + ".tmp"
  fs.writeFileSync(tmp, content)
  fs.renameSync(tmp, dest)
}

const OUTPUTS = {
  "foot.ini.tmpl": [path.join(HOME, ".config/foot/foot.ini")],
  "foot-theme.ini.tmpl": [path.join(HOME, ".config/foot/theme.ini")],
  "gtk.css.tmpl": [
    path.join(HOME, ".config/gtk-3.0/gtk.css"),
    path.join(HOME, ".config/gtk-4.0/gtk.css")
  ],
  "gtk-settings.ini.tmpl": [
    path.join(HOME, ".config/gtk-3.0/settings.ini"),
    path.join(HOME, ".config/gtk-4.0/settings.ini")
  ],
  "niri-theme.kdl.tmpl": [path.join(HOME, ".local/state/qshell/niri-theme.kdl")],
  "oma-theme.toml.tmpl": [path.join(HOME, ".local/state/qshell/oma-theme.toml")],
  "yazi-theme.toml.tpl": [path.join(HOME, ".config/yazi/theme.toml")],
  "tmux-theme.tmpl": [path.join(HOME, ".config/tmux/theme.conf")]
}

let gtkSettingsChanged = false
for (const [tmplName, dests] of Object.entries(OUTPUTS)) {
  const tmplPath = path.join(ROOT, "templates", tmplName)
  if (!fs.existsSync(tmplPath)) continue
  const rendered = render(fs.readFileSync(tmplPath, "utf8"))
  for (const dest of dests) {
    if (tmplName === "gtk-settings.ini.tmpl") {
      let old = null
      try { old = fs.readFileSync(dest, "utf8") } catch (e) { /* first render */ }
      if (old !== rendered) gtkSettingsChanged = true
    }
    writeAtomic(dest, rendered)
  }
}
if (missing.length) console.warn("theme-apply: tokens missing from theme:",
  [...new Set(missing)].join(", "))

// ---- GTK light/dark polarity ----
// Two channels, because neither covers everything: gsettings is what
// libadwaita apps read (and what a gsettings desktop backend would broadcast),
// and settings.ini above is what plain GTK reads on niri, where no such
// backend runs.
try {
  execSync(`gsettings set org.gnome.desktop.interface color-scheme prefer-${mode}`, { stdio: "ignore" })
  // Always "Adwaita", never "Adwaita-dark": that theme does not exist on disk
  // (GTK3's Adwaita is built into the library and its dark variant is the
  // prefer-dark flag in settings.ini), and naming it drops GTK to the light
  // default — measured, it was why every GTK app stayed light on a dark theme.
  execSync("gsettings set org.gnome.desktop.interface gtk-theme Adwaita", { stdio: "ignore" })
} catch (e) { /* gsettings absent or no session bus */ }

// ---- Browser theme color (enterprise policy) ----
// Port of the Arch dotfiles-linux / omarchy mechanism: BrowserThemeColor
// tints the frame from the theme's base surface (the Arch per-theme
// chromium.theme files were exactly surface.1 — catppuccin's was #1e1e2e),
// and BrowserColorScheme=device follows the color-scheme flip above.
// run_after_14-chromium-policy.sh preps the dirs once (user-owned); on an
// unprepped machine or one without the browser, the write fails into the
// catch and the theme change proceeds untinted. Plain writeFileSync, not
// writeAtomic: its mkdirSync would EACCES on /etc before failing cleanly.
const browserPolicy = JSON.stringify({
  BrowserThemeColor: String(tokens["surface.1"] || "#1c2027"),
  BrowserColorScheme: "device"
})
for (const [dir, refresh] of [
  ["/etc/chromium/policies/managed", "chromium-browser"],
  ["/etc/opt/chrome/policies/managed", "google-chrome"]
]) {
  const dest = path.join(dir, "color.json")
  try {
    let old = null
    try { old = fs.readFileSync(dest, "utf8") } catch (e) { /* first write */ }
    if (old === browserPolicy) continue
    fs.writeFileSync(dest, browserPolicy)
    // Poke a running instance; skips quietly when the browser is not up.
    execSync(`sh -c 'pgrep -f ${refresh} >/dev/null && ${refresh} --refresh-platform-policy --no-startup-window >/dev/null 2>&1 &'`,
      { stdio: "ignore" })
  } catch (e) { /* policy dir unprepped or browser absent */ }
}

// The portal's GTK backend draws the file dialog we fall back to, and it reads
// settings.ini once at startup — so it has to be restarted to follow a
// POLARITY flip. Only then: restarting on every apply let a burst of theme
// switches trip systemd's start limit ("start-limit-hit"), which left the
// service failed and every fallback file dialog dead until a manual
// reset-failed (found 2026-08-06 in the user journal). Same-mode theme
// switches don't change settings.ini, so they skip this entirely; the
// reset-failed first heals a unit a previous burst already tripped.
if (gtkSettingsChanged) {
  try {
    execSync("systemctl --user reset-failed xdg-desktop-portal-gtk.service", { stdio: "ignore" })
  } catch (e) { /* not failed, or no systemd user session */ }
  try {
    execSync("systemctl --user try-restart xdg-desktop-portal-gtk.service", { stdio: "ignore" })
  } catch (e) { /* no systemd user session */ }
}

// ---- live foot retheme via OSC (written to each foot child's pty) ----
const ANSI = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white",
  "bright-black", "bright-red", "bright-green", "bright-yellow",
  "bright-blue", "bright-magenta", "bright-cyan", "bright-white"]
let osc = ""
if (tokens["text.primary"]) osc += `\x1b]10;${tokens["text.primary"]}\x1b\\`
if (tokens["surface.0"]) osc += `\x1b]11;${tokens["surface.0"]}\x1b\\`
ANSI.forEach((name, i) => {
  const v = tokens["ansi." + name]
  if (v) osc += `\x1b]4;${i};${v}\x1b\\`
})

if (osc) {
  let ptys = []
  try {
    ptys = execSync(
      `for fp in $(pgrep -x foot); do for cp in $(pgrep -P $fp); do ` +
      `readlink /proc/$cp/fd/1 2>/dev/null; done; done | grep ^/dev/pts/ | sort -u`,
      { shell: "/bin/bash" }).toString().trim().split("\n").filter(Boolean)
  } catch (e) { /* no foot running */ }
  for (const pty of ptys) {
    try { fs.writeFileSync(pty, osc) } catch (e) { /* pty vanished */ }
  }
  if (ptys.length) console.log(`theme-apply: rethemed ${ptys.length} foot pty(s)`)
}

console.log("theme-apply: done")
