#!/usr/bin/env -S mise exec -- node
// theme-from-image [--dry-run] <image-path>
//
// Extract dominant colors from <image-path> and write a theme TOML to
// ~/.local/state/qshell/theme.toml. The shell's Theme service watches
// that file and reloads automatically — no IPC, no restart. --dry-run
// prints the TOML to stdout and touches nothing.
//
// Polarity is decided by the image (2026-08-26): the pixel-count-weighted
// median lightness picks dark or light, so a snowy landscape becomes a
// light theme instead of a muddy dark one. Dark themes get the glass
// preset (frost against the wallpaper), light ones shaded — glass over a
// bright image washes out.
//
// Single balanced pass:
//   - ffmpeg downscales to 64×36, output as raw RGB (6912 bytes / 2304 pixels).
//     64×36 is small enough that bucket counting is instant and large
//     enough that rare highlights don't push out the surface color.
//   - node converts each pixel to OKLCH and buckets by 0.05 L/C, ~6° hue.
//     The first sample in each bucket is the representative color.
//   - Top 16 buckets by pixel count are the working palette.
//
// Role assignment:
//   - surface 0 = darkest palette entry; 1..3 = same hue/chroma with +0.06,
//     +0.10, +0.16 L (gamut-mapped).
//   - text primary = ensureContrast(white, surface 0, 4.5, 1).
//   - text muted   = ensureContrast(text primary, surface 0, 3.0, 0).
//   - accent       = most saturated palette entry.
//   - error/warn/ok = hue-rotated accents at 30°/80°/140°, contrast-checked
//     against surface 0 at 3:1 — a vibrant palette yields vibrant signals,
//     a muted one yields muted signals.
//   - ansi 16      = surface/text for black/white, six chromatic picks
//     from the palette's hue ranges (red wraps) scored by chroma + pixel
//     mass; a range the image lacks is synthesized at its canonical hue
//     with the accent's L/C. bright-* = +0.15 L.
//
// No wallpaper pinning: re-applying this theme (via background-next) just
// advances the rotation. The [meta] name is derived from the image basename
// for the Theme service's meta UI.
//
// Why ffmpeg + raw RGB instead of an imagemagick pipeline: we already have
// ffmpeg on this machine (bin/wallpaper-fetch uses it for thumbs) and our
// existing color math (shell/Commons/color.js) does the OKLCH math — no
// new tools to install.

"use strict"
const fs = require("fs")
const os = require("os")
const path = require("path")
const { execSync } = require("child_process")

const ROOT = path.resolve(__dirname, "..")
const HOME = os.homedir()
const STATE = path.join(HOME, ".local/state/qshell/theme.toml")

const SCALE_W = 64
const SCALE_H = 36

// Indirect eval so color.js's function declarations land in global scope
// despite this module's "use strict" — same trick bin/theme-apply uses.
;(0, eval)(fs.readFileSync(path.join(ROOT, "shell/Commons/color.js"), "utf8"))

function extractPalette(imagePath) {
    const tmp = `/tmp/raw-${process.pid}.rgb`
    try {
        // -pix_fmt rgb24 is load-bearing: without it, rawvideo emits the
        // DECODER's format — RGBA for PNGs (channel rotation: a red image
        // grew a phantom blue accent) and planar YUV for JPEGs (the luma
        // plane read as grey triples: a green forest themed grey).
        execSync(
            `ffmpeg -y -i "${imagePath}" -vf "scale=${SCALE_W}:${SCALE_H}" -frames:v 1 -f rawvideo -pix_fmt rgb24 "${tmp}"`,
            { stdio: ['ignore', 'ignore', 'ignore'] }
        )
    } catch (e) {
        throw new Error(`ffmpeg failed on ${imagePath}: ${e.message}`)
    }
    const data = fs.readFileSync(tmp)
    try { fs.unlinkSync(tmp) } catch {}
    if (data.length !== SCALE_W * SCALE_H * 3)
        throw new Error(`raw frame is ${data.length} bytes, expected ${SCALE_W * SCALE_H * 3} — pixel format drifted`)

    const buckets = new Map()
    for (let i = 0; i + 2 < data.length; i += 3) {
        const rgb = { r: data[i] / 255, g: data[i+1] / 255, b: data[i+2] / 255 }
        const o = _rgbToOklch(rgb)
        // Near-greys have C ≈ 0; atan2 then returns whatever noise is
        // left in a/b — typically π/2. Force h to 0 so these land in a
        // single achromatic bucket rather than scattering across all
        // hue slots. Hue only matters once a color has measurable chroma.
        const h = o.C < 0.01 ? 0 : o.h
        // 0.05 buckets on L and C; ~6° (π/30) on hue.
        const key = `${Math.round(o.L * 20)},${Math.round(o.C * 20)},${Math.round(h * 9.55)}`
        if (!buckets.has(key)) buckets.set(key, { count: 0, sample: o })
        buckets.get(key).count++
    }

    const top = [...buckets.values()]
        .sort((a, b) => b.count - a.count)
        .slice(0, 16)
        .map(b => ({ hex: rgbToHex(_gamutMap(b.sample)), count: b.count }))

    // Pixel-count-weighted median lightness over EVERY bucket (not just the
    // top 16): the polarity question is about the whole frame.
    const all = [...buckets.values()].sort((a, b) => a.sample.L - b.sample.L)
    const totalPx = all.reduce((n, b) => n + b.count, 0)
    let acc = 0, medianL = 0.5
    for (const b of all) {
        acc += b.count
        if (acc >= totalPx / 2) { medianL = b.sample.L; break }
    }

    return { palette: top, medianL }
}

function oklchOf(hex) {
    return _rgbToOklch(hexToRgb(hex))
}

function pickRoles(palette, light) {
    const items = palette.map(p => ({ hex: p.hex, count: p.count, o: oklchOf(p.hex) }))

    // Surface ramp anchored at the darkest (light mode: lightest) palette
    // entry, walking toward the middle. Chroma capped at 0.09 — surfaces
    // carry the image's tint, but a saturated anchor pixel must not turn
    // every card neon.
    const sortedByL = [...items].sort((a, b) => a.o.L - b.o.L)
    const anchor = light ? sortedByL[sortedByL.length - 1] : sortedByL[0]
    const base = { L: anchor.o.L, C: Math.min(anchor.o.C, 0.09), h: anchor.o.h }
    const dir = light ? -1 : 1
    const shade = (deltaL) => rgbToHex(_gamutMap({
        L: Math.max(0, Math.min(1, base.L + dir * deltaL)),
        C: base.C,
        h: base.h
    }))
    const surface = {
        "0": shade(0),
        "1": shade(0.06),
        "2": shade(0.10),
        "3": shade(0.16)
    }

    // Text — ensureContrast walks OKLCH lightness, preserving hue/chroma.
    const textPrimary = ensureContrast(light ? "#1a1a1a" : "#ffffff", surface["0"], 4.5, light ? -1 : 1)
    // Muted is a REDUCTION, which ensureContrast cannot express (it only
    // raises deficient contrast — primary already passes 3:1, so the old
    // call returned primary verbatim and every generated theme had
    // muted == primary). Walk primary's lightness toward the surface until
    // the ratio lands near 3.4:1: quieter than primary, still readable.
    const textMuted = (() => {
        const p = oklchOf(textPrimary)
        const s0 = oklchOf(surface["0"])
        let lo = s0.L, hi = p.L, best = textPrimary
        for (let i = 0; i < 18; i++) {
            const mid = (lo + hi) / 2
            const hex = rgbToHex(_gamutMap({ L: mid, C: p.C, h: p.h }))
            const ratio = contrastRatio(hex, surface["0"])
            if (ratio >= 3.4) { best = hex; hi = mid } else { lo = mid }
        }
        return best
    })()
    const textInverse = surface["0"]

    // Accent: salience-weighted, not just the single most-saturated bucket —
    // one vivid noise pixel used to win over the color the image is actually
    // about. Chroma dominates, presence breaks ties; near-greys sit out.
    const salience = it => (it.o.C < 0.04 ? 0 : Math.pow(it.o.C, 1.5) * Math.sqrt(it.count))
    const bySalience = [...items].sort((a, b) => salience(b) - salience(a))
    const mostSat = salience(bySalience[0]) > 0 ? bySalience[0] : [...items].sort((a, b) => b.o.C - a.o.C)[0]
    // Contrast-checked against the surface so a dark accent on a dark theme
    // (or pale on light) still reads; hue and chroma survive the walk.
    const accentHex = ensureContrast(mostSat.hex, surface["0"], 3.0, 0)
    const accentOk = mostSat.o

    // The border gradient's second color: the most salient hue at least
    // ~57° away from the accent — a REAL second color of the image. Only
    // synthesized (hue-rotated ok) when the image is effectively one hue.
    const hueDist = (a, b) => {
        let d = Math.abs(a - b) % (2 * Math.PI)
        return d > Math.PI ? 2 * Math.PI - d : d
    }
    const second = bySalience.find(it => salience(it) > 0 && hueDist(it.o.h, accentOk.h) > 1.0)
    const gradientEnd = second ? ensureContrast(second.hex, surface["0"], 2.0, 0) : null
    const hueSignal = (targetH) => ensureContrast(
        rgbToHex(_gamutMap({
            L: accentOk.L,
            C: Math.max(0.08, accentOk.C * 0.9),
            h: targetH
        })),
        surface["0"],
        3.0,
        0
    )
    // red ≈ 30°, amber ≈ 80°, green ≈ 140°.
    const error = hueSignal(0.5)
    const warn = hueSignal(1.4)
    const ok = hueSignal(2.4)

    const ansi = pickAnsi(items, surface["0"], textPrimary, accentOk)

    return {
        surface,
        text: { primary: textPrimary, muted: textMuted, inverse: textInverse },
        accent: { accent: accentHex, error, warn, ok },
        gradientEnd: gradientEnd || ok,
        ansi
    }
}

function pickAnsi(items, surface0, textPrimary, accentO) {
    // Hue ranges in radians, normalized to [0, 2π). Red wraps around 0.
    // The third value is the range's canonical hue, for synthesized slots.
    const ranges = {
        red:     [5.8, 0.5, 0.45],   // wraps
        yellow:  [1.0, 1.7, 1.4],
        green:   [1.9, 2.9, 2.4],
        cyan:    [2.9, 3.7, 3.3],
        blue:    [3.7, 5.0, 4.5],
        magenta: [5.0, 5.8, 5.4]
    }

    function hueInRange(h, lo, hi) {
        // Wrap case: lo > hi, so the range is [lo, 2π] ∪ [0, hi].
        if (lo > hi) return h >= lo || h <= hi
        return h >= lo && h <= hi
    }

    function pickFor([lo, hi, canonical]) {
        let best = null, bestScore = 0
        for (const { hex, o, count } of items) {
            // Skip near-greys: their hue is undefined (the C ≈ 0 case in
            // _rgbToOklch makes atan2 return a noise angle). Without
            // this guard, every wallpaper with greys would have its
            // entire grey mass cluster into one ANSI slot by accident.
            if (o.C < 0.01) continue
            const h = o.h < 0 ? o.h + 2 * Math.PI : o.h
            if (!hueInRange(h, lo, hi)) continue
            // Same salience shape as the accent pick: chroma first, pixel
            // mass breaks ties. Raw max-C let a single compression-artifact
            // pixel put a neon slot into an otherwise muted theme.
            const score = Math.pow(o.C, 1.5) * Math.sqrt(count)
            if (score > bestScore) { best = hex; bestScore = score }
        }
        if (best) return best
        // The image has no pixels in this hue range. Terminal slots are
        // semantic — yellow MUST read yellow — so synthesize the canonical
        // hue carrying the accent's L/C (the old accent-verbatim fallback
        // painted a red image's yellow/green/blue slots all crimson).
        return ensureContrast(rgbToHex(_gamutMap({
            L: accentO.L,
            C: Math.max(0.08, accentO.C * 0.9),
            h: canonical
        })), surface0, 3.0, 0)
    }

    const red = pickFor(ranges.red)
    const yellow = pickFor(ranges.yellow)
    const green = pickFor(ranges.green)
    const cyan = pickFor(ranges.cyan)
    const blue = pickFor(ranges.blue)
    const magenta = pickFor(ranges.magenta)

    // Bright variants: same hue/chroma, +0.15 L (gamut-mapped).
    const brighten = (hex) => {
        const o = oklchOf(hex)
        return rgbToHex(_gamutMap({
            L: Math.min(1, o.L + 0.15),
            C: o.C,
            h: o.h
        }))
    }

    return {
        black: surface0,
        red, green, yellow, blue, magenta, cyan,
        white: textPrimary,
        // A lightened surface tone, not the accent: bright-black is the
        // "subdued" slot (comments, line numbers) and the accent there made
        // every terminal comment shout.
        "bright-black": brighten(surface0),
        "bright-red":    brighten(red),
        "bright-green":  brighten(green),
        "bright-yellow": brighten(yellow),
        "bright-blue":   brighten(blue),
        "bright-magenta":brighten(magenta),
        "bright-cyan":   brighten(cyan),
        "bright-white":  textPrimary
    }
}

function generateToml(roles, name, light) {
    const lines = []
    lines.push("[meta]")
    lines.push(`name = "${name}"`)
    lines.push(`mode = "${light ? "light" : "dark"}"`)
    // A dark wallpaper theme lives against its wallpaper — the glass preset
    // (compositor blur, frosted windows). Glass over a bright image washes
    // out, so light themes separate by depth instead.
    lines.push(`preset = "${light ? "shaded" : "glass"}"`)
    lines.push("")
    lines.push("[surface]")
    for (const k of ["0", "1", "2", "3"])
        lines.push(`"${k}" = "${roles.surface[k]}"`)
    lines.push("")
    lines.push("[text]")
    lines.push(`primary = "${roles.text.primary}"`)
    lines.push(`muted = "${roles.text.muted}"`)
    lines.push(`inverse = "${roles.text.inverse}"`)
    lines.push("")
    lines.push("[accent]")
    lines.push(`accent = "${roles.accent.accent}"`)
    lines.push(`error = "${roles.accent.error}"`)
    lines.push(`warn = "${roles.accent.warn}"`)
    lines.push(`ok = "${roles.accent.ok}"`)
    lines.push("")
    lines.push("[ansi]")
    for (const k of [
        "black", "red", "green", "yellow", "blue", "magenta", "cyan", "white",
        "bright-black", "bright-red", "bright-green", "bright-yellow",
        "bright-blue", "bright-magenta", "bright-cyan", "bright-white"
    ]) lines.push(`${k} = "${roles.ansi[k]}"`)
    lines.push("")
    lines.push("[shape]")
    lines.push(`radius = 8`)
    lines.push(`border-width = 1`)
    lines.push("")
    lines.push("[motion]")
    lines.push(`duration = 150`)
    lines.push(`easing = "standard"`)
    lines.push("")
    // Gradient border from the image's own two strongest hues (gradientEnd
    // falls back to the synthetic ok only for a one-hue image).
    lines.push("[border]")
    lines.push(`active = "${roles.accent.accent} ${roles.gradientEnd} 45deg"`)
    lines.push("")
    return lines.join("\n")
}

function usage() {
    process.stderr.write("usage: theme-from-image [--dry-run] <image-path>\n")
    process.exit(2)
}

const args = process.argv.slice(2)
const dryRun = args[0] === "--dry-run"
if (dryRun) args.shift()
if (args.length !== 1) usage()

const imagePath = args[0]
if (!fs.existsSync(imagePath)) {
    process.stderr.write(`theme-from-image: file not found: ${imagePath}\n`)
    process.exit(1)
}

let extracted
try {
    extracted = extractPalette(imagePath)
} catch (e) {
    process.stderr.write(`theme-from-image: ${e.message}\n`)
    process.exit(1)
}

// 0.62, not 0.5: mid-bright images still read better as dark themes (the
// desktop is dark-leaning); only a genuinely bright frame flips polarity.
const light = extracted.medianL > 0.62
const roles = pickRoles(extracted.palette, light)
const name = path.basename(imagePath, path.extname(imagePath))
const toml = generateToml(roles, name, light)

if (dryRun) {
    process.stdout.write(toml + "\n")
    process.exit(0)
}

fs.mkdirSync(path.dirname(STATE), { recursive: true })

// Hand the toml off to a bash subshell that runs the apply pipeline. Doing
// this in bash (not node) keeps the flock / IPC / quoting identical to
// bin/theme-set's, which is the entire point — same race semantics, same
// degradation path, same fan-out ordering. The toml goes through a temp
// file (passed as $TOML_TMP) because heredocs collide with the toml's own
// quoted strings; base64 goes through TOML_B64 because the IPC call needs
// the bytes and we don't want to fight argv quoting.
const tomlTmp = `/tmp/theme-from-image-${process.pid}.toml`
fs.writeFileSync(tomlTmp, toml)

try {
    // Same pattern as bin/theme-set, condensed: flock the state dir, write
    // theme.name, send the synchronized themeTransition IPC, atomic-publish
    // theme.toml, set the wallpaper, exec theme-apply. A second Shift+Enter
    // mid-extract races its own theme.toml write against ours; the flock
    // serializes both and the file-watch sees whichever lands second.
    //
    // All values flow through env vars (TOML_B64, TOML_NAME, TOML_WALLPAPER,
    // TOML_TMP). Env values are stored as opaque strings — bash never
    // re-expands them — so a name or path containing $, ", or \ arrives
    // intact. The previous inline-interpolation pattern broke the moment a
    // wallhaven ID grew a character class the JS-side escape didn't cover.
    const b64 = Buffer.from(toml).toString("base64")
    const bash = `
        set -euo pipefail
        state_dir="$HOME/.local/state/qshell"
        exec 9>"$state_dir/theme-set.lock"
        flock 9

        # Synthesize a virtual theme name from the image basename so
        # theme-set (no args) stars the most recent pick.
        name_file="$state_dir/theme.name"
        printf '%s\\n' "$TOML_NAME" >"$name_file.tmp"
        mv "$name_file.tmp" "$name_file"

        # Read the current wallpaper BEFORE background-next --set overwrites
        # it — the synchronized wipe shows old → new, not new → new.
        bg_state="$state_dir/background"
        old_bg=""
        [[ -f "$bg_state" ]] && old_bg="$(<"$bg_state")"

        # IPC push FIRST. The shell latches off Theme.qml's file watch on
        # this call (Background.qml setPendingTheme), so the theme.toml
        # publish below is silent — the palette applies on the reveal's
        # first frame instead of from the file-watch.
        if ! timeout 2 qs ipc call background themeTransition \\
            "$old_bg" \\
            "$TOML_WALLPAPER" \\
            "$TOML_B64" >/dev/null 2>&1; then
            # Degradation path — shell dead, absent, or predating the IPC
            # surface. The file watch below will apply the palette; the
            # compositor-level crossfade folds the uncoordinated flips into
            # one motion.
            timeout 1 niri msg action do-screen-transition --delay-ms 200 >/dev/null 2>&1 || true
        fi

        # Atomic theme.toml publish — Theme.qml's inotify watch must never
        # see a half-written file (tmp + rename, same as theme-set).
        cp "$TOML_TMP" "$state_dir/theme.toml.tmp"
        mv "$state_dir/theme.toml.tmp" "$state_dir/theme.toml"

        # Persist the new wallpaper — the shell already has it via the IPC
        # and is mid-wipe-reveal; this is the record for the next shell
        # start and for non-shell consumers. Best-effort, never fatal.
        "$ROOT/bin/background-next" --set "$TOML_WALLPAPER" >/dev/null 2>&1 || true

        # Critical section over — release before the slow fan-out.
        flock -u 9

        exec "$ROOT/bin/theme-apply"
    `
    execSync(bash, {
        stdio: "inherit",
        env: {
            ...process.env,
            ROOT: ROOT,
            TOML_B64: b64,
            TOML_TMP: tomlTmp,
            TOML_NAME: name,
            TOML_WALLPAPER: imagePath
        },
        shell: "/bin/bash"
    })
} catch (e) {
    process.stderr.write(`theme-from-image: apply failed: ${e.message}\n`)
    process.exit(1)
} finally {
    try { fs.unlinkSync(tomlTmp) } catch {}
}

process.stdout.write(`${STATE}\n`)