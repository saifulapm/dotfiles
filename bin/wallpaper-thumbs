#!/usr/bin/env bash
# wallpaper-thumbs — the picker thumbnail cache omarchy's list.sh keeps with
# ImageMagick, rebuilt on ffmpeg (which IS installed here; magick is not).
#
# Reads wallpaper paths on stdin, one per line, and prints one line per input:
# the path of a 1152px-wide JPEG thumbnail, generated into the cache on first
# sight, or the original path when the thumbnail cannot be made (missing
# source, no ffmpeg, decode failure). Callers never need to distinguish.
#
# Why 1152: the filmstrip's widest tile (FilmstripPicker.qml expandedWidth,
# 768 logical px) at the picker's 1.5x decode cap. omarchy uses 1536 (2x,
# e5663c7e); here 2x peaked a browse at +246 MiB, so the cap is 1.5x. Decoding
# the originals instead cost
# ~110 MiB of transient RSS per theme-switcher browse (measured 2026-08-09):
# Qt's PNG handler has no scaled-decode path, so a 5120x3414 wallpaper fully
# materializes (~67 MiB RGBA) before its downscale. A cached thumbnail is
# ~130 KiB and decodes in one step.
#
# Keyed by sha1(path:mtime:size:width), so an edited or refetched source gets
# a fresh thumbnail and the stale key is simply never asked for again — and
# so did every older thumbnail when the width changed. The
# backgrounds tree is wiped and refetched wholesale (run_after_27-wallpapers),
# which strands the old keys — the >90-day prune below collects them; an
# actively-used thumbnail it removes regenerates on the next picker open.
set -uo pipefail

cache="$HOME/.cache/qshell/wallpaper-thumbs"
width=1152
mkdir -p "$cache" 2>/dev/null || cache=""

have_ffmpeg=1
command -v ffmpeg >/dev/null 2>&1 || have_ffmpeg=0

# Cheap enough to run every time: the directory holds tens of files.
[ -n "$cache" ] && find "$cache" -type f -mtime +90 -delete 2>/dev/null

while IFS= read -r src; do
  [ -n "$src" ] || continue
  if [ -z "$cache" ] || [ "$have_ffmpeg" -eq 0 ] || [ ! -f "$src" ]; then
    printf '%s\n' "$src"
    continue
  fi
  meta="$(stat -c '%Y:%s' "$src" 2>/dev/null)"
  if [ -z "$meta" ]; then
    printf '%s\n' "$src"
    continue
  fi
  key="$(printf '%s:%s:%s' "$src" "$meta" "$width" | sha1sum | cut -d' ' -f1)"
  thumb="$cache/$key.jpg"
  if [ ! -s "$thumb" ]; then
    # Generated beside the target and renamed in (omarchy f075a78): a run
    # killed mid-write — oomd, a closed picker — otherwise leaves a partial
    # JPEG that is non-empty, so the -s test above accepts it forever and
    # that wallpaper renders broken until the prune. rename(2) publishes
    # whole files only, which also makes two concurrent runs harmless.
    # A killed run's leftover .part is collected by the same prune.
    tmp="$thumb.$$.part"
    # -frames:v 1 makes an animated GIF/WebP contribute its first frame;
    # 'min(width,iw)' never upscales a source already narrower than a tile.
    if ! ffmpeg -v error -y -i "$src" -frames:v 1 \
      -vf "scale='min($width,iw)':-2" -q:v 4 -f mjpeg "$tmp" </dev/null 2>/dev/null \
      || [ ! -s "$tmp" ] || ! mv -f "$tmp" "$thumb" 2>/dev/null; then
      rm -f "$tmp" "$thumb" 2>/dev/null
      printf '%s\n' "$src"
      continue
    fi
  fi
  printf '%s\n' "$thumb"
done
