#!/usr/bin/env bash
# music — the music player. A thin wrapper around cliamp whose entire job is
# the one thing cliamp cannot do for itself: outlive its terminal.
#
# Replaced the old bin/music and bin/radio on 2026-08-18, together with the
# bar's media widget and panel. Those three existed because omarchy's music
# story was `pkg-add spotify`, which has no aarch64 build, so this machine had
# to grow a radio picker and a YouTube search around mpv. omarchy has since
# moved to cliamp itself, and cliamp does everything both scripts did in one
# process — plus podcasts, YouTube Music, SoundCloud, Spotify, an EQ and a
# spectrum analyser. See packages/manifest.toml's [[tool]] cliamp entry.
#
# WHY TMUX. cliamp is a TUI: close its window and the process dies with it,
# which for a music player means the music stops. The old radio dodged this by
# living in a systemd unit with no UI at all. Here the session holds the
# process and the window is just a view onto it — close the window, the song
# keeps playing, media keys keep working, and the next `music` re-attaches to
# the same player mid-track.
#
# It is also a correctness fix, not only a convenience: cliamp allows ONE
# instance per user (it owns a fixed IPC socket and the
# org.mpris.MediaPlayer2.cliamp bus name), and a second launch does not fail
# loudly — it starts anyway, silently loses MPRIS, and leaves you with a
# player the media keys and the OSD cannot see. `new-session -A` makes a
# second launch attach to the first instead.
#
# The tmux server is a PRIVATE one (-L cliamp) with its own config, not the
# ~/.tmux.conf session behind Mod+Alt+Return: that config runs `amx statusline`
# every second, rebinds the prefix, and would put a status bar across a player
# that already draws its own. This one has no status bar and no bindings worth
# colliding with.
#
#   music                  open the player, or focus/attach the running one
#   music <url>            play a URL now: stream, M3U/PLS/M3U8, podcast RSS
#                          feed, YouTube, YouTube Music, SoundCloud, Bandcamp,
#                          Bilibili, NetEase
#   music <query...>       play the top YouTube result for a search
#   music -p, --prompt     ask for the search with the shell's own input popup
#
# Transport is cliamp's own CLI and is deliberately NOT duplicated here —
# `cliamp toggle|next|prev|stop|status|volume|seek`, and the XF86Audio* keys
# already drive it through the shell's MPRIS service. `cliamp --help` has the
# rest: playlists, history, EQ presets, audio devices.
set -euo pipefail

server="cliamp"   # tmux -L: a private server, not the ~/.tmux.conf one
session="music"
app_id="cliamp-main"

tm() { tmux -L "$server" "$@"; }

notify() { notify-send -a qshell "󰝚 $1" "${2:-}" >/dev/null 2>&1 || true; }

usage() { sed -n '/^#   music/,/^#   music -p/p' "$0" | sed 's/^#   /  /'; }

command -v cliamp >/dev/null 2>&1 || {
  notify "cliamp is not installed" "chezmoi apply installs it"
  echo "music: cliamp not found on PATH — run \`chezmoi apply\`" >&2
  exit 1
}

# The private server's config, rewritten on every launch so it can never drift
# from this script. $XDG_RUNTIME_DIR is tmpfs and per-user, so it is gone at
# logout and unreadable by anyone else.
write_conf() {
  conf="${XDG_RUNTIME_DIR:-/tmp}/cliamp-tmux.conf"
  cat >"$conf" <<'EOF'
# generated by bin/music — do not edit.
set -g status off
set -g mouse on
set -g escape-time 0
set -g history-limit 2000
set -g default-terminal "tmux-256color"
# WITHOUT THIS the player renders in 256 colours. tmux advertises the
# capabilities of default-terminal, not of the terminal it is running inside,
# and cliamp's theme is 24-bit hex — every colour would be quantised to the
# nearest xterm-256 slot and the rendered qshell palette would not match the
# rest of the desktop.
set -ga terminal-features ",*:RGB"
EOF
  printf '%s' "$conf"
}

# Start the player detached if it is not already up. Extra arguments are
# cliamp's own argv; quoted through printf %q because tmux hands the command
# to sh rather than exec'ing it directly, and a YouTube URL is full of & and ?.
ensure_session() {
  tm has-session -t "$session" 2>/dev/null && return 0
  local conf cmd
  conf="$(write_conf)"
  cmd="$(printf '%q ' cliamp "$@")"
  tm -f "$conf" new-session -d -s "$session" -n cliamp "$cmd"
}

playing() { cliamp status >/dev/null 2>&1; }

# Hand a URL to the player: straight into a fresh session when nothing is
# running (so it starts playing on its own), added to the end of the playlist
# when something already is. cliamp's IPC has no "drop what you are doing and
# play this" verb — `track.play` wants a whole track object rather than an
# index, and there is no jump-to-index — and cutting off a song mid-play would
# be the wrong guess anyway.
#
# `url.load` over the socket rather than the `cliamp queue` CLI verb, because
# the two resolve very differently. queue takes the URL at face value and
# builds a track from the FILENAME, so a YouTube link lands in the playlist
# titled "watch". url.load is the same code path as the player's own `u` key:
# it runs the URL through yt-dlp / the RSS reader / the M3U parser first, so a
# video arrives with its real title and duration, and a podcast feed or an
# M3U playlist EXPANDS into its episodes and entries instead of becoming one
# dead row. That difference is the whole reason this talks to the socket at
# all — socat is already a declared dependency (packages/manifest.toml), and
# the old bin/radio drove mpv the same way.
#
# The server allows url.load 60s to resolve, so the client waits slightly
# longer than that rather than hanging up on a slow yt-dlp and looking failed.
#
# The reply is captured into a variable and matched with a glob rather than
# piped into `grep -q`: grep exits the moment it matches, socat takes SIGPIPE
# for it, and under `set -o pipefail` the whole pipeline then reports failure
# on a call that actually SUCCEEDED. Same trap as the `| head -1` one below.
load_url() {
  local url="$1" reply
  if command -v socat >/dev/null 2>&1; then
    reply="$(printf '{"cmd":"url.load","path":"%s"}\n' "$url" \
      | socat -T70 - "UNIX-CONNECT:$HOME/.config/cliamp/cliamp.sock" 2>/dev/null || true)"
    [[ $reply == *'"ok":true'* ]]
    return
  fi
  cliamp queue "$url"
}

play_url() {
  local url="$1" label="${2:-$1}"
  if playing; then
    if load_url "$url"; then
      notify "Added to the playlist" "$label"
    else
      notify "Could not add it" "$label"
      exit 1
    fi
  else
    ensure_session "$url" --auto-play
    notify "Playing" "$label"
  fi
}

case "${1:-}" in
  -h | --help | help)
    usage
    exit 0
    ;;
esac

# No arguments: show the player. In a terminal that means attaching; anywhere
# else (a niri bind, the menu, a .desktop entry) it means asking for a window
# first. launch-or-focus keeps it a singleton — a second press focuses the
# window that is already open instead of stacking another one on top.
if (($# == 0)); then
  if [ -t 1 ]; then
    conf="$(write_conf)"
    # `tmux` spelled out rather than the tm() helper: exec REPLACES the process
    # and can only do that with a real binary, so `exec tm …` dies with
    # "tm: not found" no matter that the function is defined right there.
    exec tmux -L "$server" -f "$conf" new-session -A -s "$session" -n cliamp cliamp
  fi
  exec launch-or-focus "$app_id" foot-run "--app-id=$app_id" music
fi

if [[ ${1:-} == -p || ${1:-} == --prompt ]]; then
  query="$(menu-input "Play music")" || exit 0
  [[ -n $query ]] || exit 0
  set -- "$query"
fi

query="$*"
[[ -n $query ]] || exit 0

# A URL needs no search — cliamp resolves streams, playlists, podcast feeds
# and every yt-dlp site itself.
if [[ $query =~ ^https?:// ]]; then
  play_url "$query"
  exit 0
fi

# A search does, and it has to happen HERE rather than through `cliamp search`:
# that subcommand only works as a launch argument, so it could not add a track
# to a player that is already running. yt-dlp resolves it either way, which is
# the same one-request --flat-playlist lookup the old bin/music did.
#
# No `| head -1` on that yt-dlp call, deliberately: head exits after its line,
# yt-dlp takes SIGPIPE, and under `set -o pipefail` the whole pipeline fails —
# the bug class this repo has already shipped twice. ytsearch1 returns one
# entry anyway, and the trailing trim covers the case where it does not.
notify "Searching…" "$query"
line="$(
  yt-dlp --flat-playlist --no-warnings --ignore-errors \
    --print $'%(url)s\t%(title)s' "ytsearch1:${query}" 2>/dev/null || true
)"
line="${line%%$'\n'*}"
url="${line%%$'\t'*}"
title="${line#*$'\t'}"

[[ -n ${url:-} ]] || {
  notify "Nothing found" "$query"
  exit 1
}

play_url "$url" "${title:-$query}"
