#!/bin/bash
# network-speedtest — measure live throughput for one direction.
#
# Direct port of omarchy's bin/omarchy-network-speedtest (MIT).
# Saturates the link with parallel curl workers against fast.com's Netflix OCA
# endpoints and prints one Mbit/s reading per second, computed from the
# interface counters, until it is killed. The panel runs it for five seconds
# per direction and terminates it.
#
# The only change from the original is that the endpoint list is pulled out of
# the JSON with grep rather than jq, so this needs nothing but curl.
#
#   network-speedtest down|up

set -e

direction="${1:-}"
probe=1.1.1.1
parallel=8
url_count=3

case "$direction" in
down | up) ;;
*)
    echo "Usage: network-speedtest [down|up]" >&2
    exit 2
    ;;
esac

format_mbps() {
    awk -v value="$1" 'BEGIN {
    if (value <= 0) print "0.0"
    else if (value < 10) printf "%.1f\n", value
    else printf "%.0f\n", value
  }'
}

iface=$(ip route get "$probe" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')

if [[ -z $iface ]]; then
    echo "No active network interface" >&2
    exit 1
fi

counters() {
    sed 's/^[[:space:]]*//' /proc/net/dev |
        awk -F'[:[:space:]]+' -v want="$iface" '$1 == want { print $2, $10; exit }'
}

if [[ -z $(counters) ]]; then
    echo "No counters for $iface" >&2
    exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
    echo "curl is required" >&2
    exit 1
fi

fast_token="YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm"
fast_api_url="https://api.fast.com/netflix/speedtest/v2?https=true&token=$fast_token&urlCount=$url_count"

fast_urls=$(curl -fsS "$fast_api_url" 2>/dev/null |
    grep -o '"url":"[^"]*"' | sed 's/^"url":"//; s/"$//')

if [[ -z $fast_urls ]]; then
    echo "Failed to fetch speed test endpoints" >&2
    exit 1
fi

traffic_pids=()

# Each worker runs in its own process group (set -m below), so worker and curl
# are signalled together by their group id. Killing them separately raced the
# worker's fork: a curl spawned after the pkill scan survived as an orphan and
# kept downloading. STOP first freezes the worker so it cannot fork past the
# TERM, which is then delivered to the whole group before CONT releases it.
cleanup() {
    local pid
    for pid in "${traffic_pids[@]}"; do
        [[ -n $pid ]] || continue
        kill -STOP -- "-$pid" 2>/dev/null || true
        kill -TERM -- "-$pid" 2>/dev/null || true
        kill -CONT -- "-$pid" 2>/dev/null || true
    done
    for pid in "${traffic_pids[@]}"; do
        [[ -n $pid ]] || continue
        wait "$pid" 2>/dev/null || true
    done
}
# EXIT alone is not enough: a bash killed by SIGTERM dies without running its
# EXIT trap, and the shell being killed outright reparents this script rather
# than ending it — either way the curl workers would keep saturating the link
# with nothing left to read them. Trapping the signals covers the panel
# stopping the process, and the parent-alive check in the loop below covers
# the shell disappearing from under it. (The original leaks in both cases.)
trap 'exit 143' TERM INT HUP
trap cleanup EXIT

parent=$PPID

# Round-robin across the returned URLs so load is spread across OCA nodes.
traffic_worker() {
    local urls=("$@")
    local count=${#urls[@]}
    local idx=$RANDOM
    if [[ $direction == "down" ]]; then
        while true; do
            url=${urls[$((idx % count))]}
            curl -fsS -o /dev/null "$url" 2>/dev/null || return
            idx=$((idx + 1))
        done
    else
        while true; do
            url=${urls[$((idx % count))]}
            dd if=/dev/zero bs=1M count=64 2>/dev/null | curl -fsS -o /dev/null -X POST --data-binary @- "$url" 2>/dev/null || return
            idx=$((idx + 1))
        done
    fi
}

# Job control puts every background worker in a process group of its own,
# which is what lets cleanup take out a worker and its current curl as a unit.
set -m
for ((i = 0; i < parallel; i++)); do
    traffic_worker $fast_urls &
    traffic_pids+=("$!")
done
set +m

read -r rx_before tx_before < <(counters)

any_alive() {
    local pid
    for pid in "${traffic_pids[@]}"; do
        [[ -n $pid ]] || continue
        if kill -0 "$pid" 2>/dev/null; then return 0; fi
    done
    return 1
}

while any_alive; do
    sleep 1
    kill -0 "$parent" 2>/dev/null || exit 143
    read -r rx_after tx_after < <(counters)

    if [[ $direction == "down" ]]; then
        rate=$(awk -v before="$rx_before" -v after="$rx_after" 'BEGIN {
      if (after < before) print 0
      else print (after - before) * 8 / 1000000
    }')
    else
        rate=$(awk -v before="$tx_before" -v after="$tx_after" 'BEGIN {
      if (after < before) print 0
      else print (after - before) * 8 / 1000000
    }')
    fi

    format_mbps "$rate"
    rx_before=$rx_after
    tx_before=$tx_after
done

wait 2>/dev/null || true
