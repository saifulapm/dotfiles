#!/usr/bin/env bash
# A transient unit gets the live user manager's env, so each nested-session variable is passed by name.
set -euo pipefail
{

# The nested session bus stands in for the system bus, so UPower and NetworkManager doubles run there.
export DBUS_SYSTEM_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS
# A user manager need not have bin/ on PATH, so the nested shell runs without it, and starts what it needs from bin/ by absolute path.
shell_path=$(tr ':' '\n' <<<"$PATH" | grep -vxF "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" | paste -sd:)

# qs drops console.log and console.debug unless qml.debug is on, and a check that reads the journal for a leaked secret must see them.
PATH=$shell_path systemd-run --user --quiet --collect --unit "$DOTS_DEV_UNIT" \
  -p Restart=always -p RestartSec=500ms -p StartLimitIntervalSec=0 \
  -E WAYLAND_DISPLAY -E NIRI_SOCKET -E DBUS_SESSION_BUS_ADDRESS \
  -E DBUS_SYSTEM_BUS_ADDRESS -E PATH \
  -E XDG_STATE_HOME -E XDG_DATA_HOME -E QS_CONFIG_PATH -E TMUX_TMPDIR -E DCONF_PROFILE -E DOTS_CHROMIUM_POLICY_DIR -E DOTS_AGENT_HOME -E DOTS_HUB_QUESTIONS -E DOTS_NIRI_BINDS -E DOTS_MACHINE -E PIPEWIRE_RUNTIME_DIR -E DOTS_RECORDINGS_DIR -E DOTS_WORKFLOW -E DOTS_NOTIFY_PHONE -E DOTS_PICK_FILES -E DOTS_ACCOUNTS -E DOTS_DEV_DIR -E DOTS_PAM_DIR -E RCLONE_CONFIG -E DOTS_AGE_IDENTITY -E PASSWORD_STORE_DIR -E GNUPGHOME -E DOTS_MOTION_SLOWDOWN -E QT_QPA_PLATFORMTHEME= -E QSG_RENDER_LOOP=basic -E FONTCONFIG_FILE=$QS_CONFIG_PATH/fonts.conf \
  qs --log-rules 'qml.debug=true'
# The clipboard watcher sees the nested clipboard only, and its db sits under the temp XDG_STATE_HOME.
systemd-run --user --quiet --collect --unit "$DOTS_DEV_UNIT-clip" \
  -E WAYLAND_DISPLAY -E XDG_STATE_HOME -E PATH \
  wl-paste --watch dots-clip-store

for v in WAYLAND_DISPLAY NIRI_SOCKET DBUS_SESSION_BUS_ADDRESS DBUS_SYSTEM_BUS_ADDRESS PATH QS_CONFIG_PATH XDG_STATE_HOME DOTS_DEV_UNIT TMUX_TMPDIR DCONF_PROFILE DOTS_CHROMIUM_POLICY_DIR DOTS_AGENT_HOME DOTS_HUB_QUESTIONS DOTS_NIRI_BINDS DOTS_MACHINE PIPEWIRE_RUNTIME_DIR DOTS_RECORDINGS_DIR DOTS_WORKFLOW DOTS_NOTIFY_PHONE DOTS_PICK_FILES DOTS_ACCOUNTS DOTS_PAM_DIR RCLONE_CONFIG DOTS_AGE_IDENTITY PASSWORD_STORE_DIR GNUPGHOME XDG_DATA_HOME; do
  printf 'export %s=%q\n' "$v" "${!v}"
done >"$DOTS_DEV_DIR/env.tmp"
# bin/dots-dev waits for env, so it appears whole.
mv "$DOTS_DEV_DIR/env.tmp" "$DOTS_DEV_DIR/env"
exit
}
