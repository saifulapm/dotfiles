#!/usr/bin/env bash
# A transient unit gets the live user manager's env, so each nested-session variable is passed by name.
set -euo pipefail

# The nested session bus stands in for the system bus, so UPower and NetworkManager doubles run there.
export DBUS_SYSTEM_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS

systemd-run --user --quiet --collect --unit "$DOTS_DEV_UNIT" \
  -p Restart=always -p RestartSec=500ms -p StartLimitIntervalSec=0 \
  -E WAYLAND_DISPLAY -E NIRI_SOCKET -E DBUS_SESSION_BUS_ADDRESS \
  -E DBUS_SYSTEM_BUS_ADDRESS -E PATH \
  -E XDG_STATE_HOME -E XDG_DATA_HOME -E QS_CONFIG_PATH -E TMUX_TMPDIR -E DCONF_PROFILE -E DOTS_CHROMIUM_POLICY_DIR -E DOTS_HUB_QUESTIONS -E DOTS_NIRI_BINDS -E PIPEWIRE_RUNTIME_DIR -E QT_QPA_PLATFORMTHEME= -E QSG_RENDER_LOOP=basic \
  qs

for v in WAYLAND_DISPLAY NIRI_SOCKET DBUS_SESSION_BUS_ADDRESS DBUS_SYSTEM_BUS_ADDRESS PATH QS_CONFIG_PATH XDG_STATE_HOME DOTS_DEV_UNIT TMUX_TMPDIR DCONF_PROFILE DOTS_CHROMIUM_POLICY_DIR DOTS_HUB_QUESTIONS DOTS_NIRI_BINDS PIPEWIRE_RUNTIME_DIR; do
  printf 'export %s=%q\n' "$v" "${!v}"
done >"$DOTS_DEV_DIR/env.tmp"
# bin/dots-dev waits for env, so it appears whole.
mv "$DOTS_DEV_DIR/env.tmp" "$DOTS_DEV_DIR/env"
