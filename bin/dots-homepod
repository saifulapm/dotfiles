#!/usr/bin/env bash
# dots-homepod: while a stream plays into the "HomePod (Office)" sink, sends it to the office HomePod over AirPlay 2 with cliairplay; the office AP filters multicast, so the HomePod is asked for its record directly, at its last address, its two known ones, or else wherever a sweep of the office LAN finds port 7000.
set -uo pipefail
{
id=22:61:3D:B7:0B:F7
nets=${DOTS_HOMEPOD_NETS:-192.168.68 192.168.69 192.168.70 192.168.71}
# Every wait below counts ticks of a second; a test shortens the tick.
tick=${DOTS_HOMEPOD_TICK:-1}
state=${XDG_STATE_HOME:-$HOME/.local/state}/dots-homepod
run=${XDG_RUNTIME_DIR:?}/dots-homepod
mkdir -p "$state" "$run"

log() { echo "dots-homepod: $*"; }

# playing: some stream feeds the sink's input ports.
playing() {
  pw-link -l -i 2>/dev/null | awk '/^homepod:playback_/ { on = 1; next } /^[^ ]/ { on = 0 } on && /\|<-/ { found = 1 } END { exit !found }'
}

# record <host>: prints "<name><TAB><txt>" when <host> answers unicast mDNS as our HomePod's _airplay._tcp service; anyone on the LAN can answer, so the name is printable and short before it reaches the journal.
record() {
  local service txt
  service=$(dig +short +time=1 +tries=1 @"$1" -p 5353 _airplay._tcp.local PTR 2>/dev/null | head -1)
  [[ -n $service ]] || return 1
  txt=$(dig +short +time=1 +tries=1 @"$1" -p 5353 "$service" TXT 2>/dev/null | tr -d '"')
  [[ " $txt " == *" deviceid=$id "* ]] || return 1
  service=${service%%._airplay._tcp.local.}
  service=${service//[^[:alnum:] ._()-]/}
  printf '%s\t%s\n' "${service:0:40}" "${txt//[^[:print:]]/}"
}

# sweep <net>: every host of <net>.0/24 that accepts a connection on 7000, AirPlay's port.
sweep() {
  # shellcheck disable=SC2016 # $0 is the inner bash's, the host xargs hands it
  seq 1 254 | xargs -P 64 -I{} bash -c 'timeout 0.3 bash -c "echo >/dev/tcp/$0/7000" 2>/dev/null && echo "$0"' "$1.{}"
}

# resolve: sets host, name and txt; the sweep runs only while this machine holds an address in a net, so it never probes a LAN that is not the office's.
resolve() {
  local cand found="" net
  for cand in $(cat "$state/host" 2>/dev/null) 192.168.68.50 192.168.68.51; do
    found=$(record "$cand") && break
  done
  if [[ -z $found ]]; then
    for net in $nets; do
      ip -4 -o addr show 2>/dev/null | grep -qF " $net." || continue
      while read -r cand; do
        found=$(record "$cand") && break 2
      done < <(sweep "$net")
    done
  fi
  [[ -n $found ]] || return 1
  host=$cand
  IFS=$'\t' read -r name txt <<<"$found"
  echo "$host" >"$state/host"
}

# send: one AirPlay session; 0 when nothing has played for 10 s, 1 when the HomePod failed or left it.
send() {
  local cmd=$run/cmd audio=$run/audio out=$run/cliairplay.log rec pid t=0 idle=0 misses=0 rc=1
  rm -f "$cmd" "$audio" && mkfifo "$cmd" "$audio" || return 1
  exec 3<>"$cmd"
  # 44.1 kHz s16 stereo is cliairplay's input format; the sink's monitor carries its volume, so Control's slider sets how loud the HomePod plays.
  pw-record --target homepod -P stream.capture.sink=true --rate 44100 --channels 2 --format s16 --raw - >"$audio" 2>/dev/null &
  rec=$!
  cliairplay --protocol auto --port 7000 --volume 75 --name "$name" --txt "$txt" --cmdpipe "$cmd" "$host" <"$audio" >"$out" 2>&1 &
  pid=$!
  echo ACTION=START >&3
  log "playing on $name at $host"
  while kill -0 "$pid" 2>/dev/null; do
    sleep "$tick"
    ((t++))
    if playing; then
      idle=0
    elif ((++idle >= 10)); then
      log "nothing plays; ending the session"
      echo ACTION=DISCONNECT >&3
      rc=0
      break
    fi
    if grep -a 'clock_ready' "$out" | tail -1 | grep -q 'state=stalled'; then
      log "the HomePod does not answer the PTP clock; UDP 319 and 320 must reach this machine"
      break
    fi
    if grep -aq '^\[STATUS\] eof' "$out"; then
      log "pw-record stopped"
      break
    fi
    # A HomePod that moved to a new address leaves the session talking to the old one, so it is asked again every 30 s.
    if ((t % 30 == 0)); then
      if record "$host" >/dev/null; then
        misses=0
      elif ((++misses >= 2)); then
        log "the HomePod no longer answers at $host"
        break
      fi
    fi
  done
  grep -a '^\[STATUS\] error' "$out" | tail -1
  for ((t = 0; t < 30; t++)); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  kill "$pid" "$rec" 2>/dev/null
  wait "$pid" "$rec" 2>/dev/null
  exec 3>&-
  return "$rc"
}

while :; do
  until playing; do sleep "$tick"; done
  if ! resolve; then
    log "the HomePod answers nowhere on the office LAN"
  elif send; then
    continue
  fi
  for ((i = 0; i < 10; i++)); do sleep "$tick"; done
done
exit
}
