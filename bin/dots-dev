#!/usr/bin/env bash
# just dev: a nested niri on its own bus, running this checkout's shell on a temp state and data dir.
set -euo pipefail
{

repo=$(cd "$(dirname "$0")/.." && pwd)
D=$(mktemp -d -t dots-dev-XXXXXXXX)
export DOTS_DEV_DIR=$D DOTS_DEV_UNIT=dots-shell-dev-${D##*-}
user_data=${XDG_DATA_HOME:-$HOME/.local/share}
# A check that edits the config must never edit the checkout's shell/, which the live shell watches.
export XDG_STATE_HOME=$D/state XDG_DATA_HOME=$D/data QS_CONFIG_PATH=${DOTS_DEV_SHELL:-$repo/shell}
# niri's spawn-at-startup finds bin/dots-dev-shell on PATH. dev/path comes first so the fake ddcutil hides the real one.
export PATH=$repo/dev/path:$repo/bin:$PATH
# The nested session must never reach the live tmux server, dconf database or Chromium policy dir.
dconf_name=dots_dev_${D##*-}
dconf_name=${dconf_name//[^[:alnum:]_]/_}
export TMUX_TMPDIR=$D/tmux DCONF_PROFILE=$D/dconf-profile
# Nor the live coding agents' theme files.
export DOTS_AGENT_HOME=$D/agents
# A fixed machine id names the notes store dev.json, whatever the live chezmoi config says.
export DOTS_MACHINE=dev
# Nor the live hub's questions or the live PipeWire.
export DOTS_HUB_QUESTIONS=$D/hub-questions.json PIPEWIRE_RUNTIME_DIR=$D/pw
# Surface motion runs this many times slower; only the motion checks pass more than 1, and the live unit never sets it.
export DOTS_MOTION_SLOWDOWN=${DOTS_MOTION_SLOWDOWN:-1}
# Recordings land in the temp dir, never in ~/Videos.
export DOTS_RECORDINGS_DIR=$D/recordings
# dots sync goes to an alias Dropbox: inside the temp dir, never the live rclone config's.
export RCLONE_CONFIG=$D/rclone.conf
# The ssh unit skips without an age key, so a nested round never reads the real key or ~/.ssh.
export DOTS_AGE_IDENTITY=$D/no-age-identity
# Pass reads and writes a store and a keyring inside the temp dir, never ~/.password-store, ~/.gnupg or the store's remote.
export PASSWORD_STORE_DIR=$D/password-store GNUPGHOME=$D/gnupg
# workflow route tells every hub, so Control's Route toggle runs a fake that keeps the route here.
export DOTS_WORKFLOW=$repo/bin/dev-fake-workflow
# Accounts runs a fake collector that logs each call in the temp dir, never the real one, which reads pass and calls every provider.
export DOTS_ACCOUNTS=$repo/bin/dev-fake-accounts
# DNS Shield runs a fake collector that keeps its devices in the temp dir, never the real one, which writes to uBlockDNS and the router.
export DOTS_DNS=$repo/bin/dev-fake-dns
# An agent lease tells the phone through a fake that records each call in the temp dir, never a real Slack DM.
export DOTS_NOTIFY_PHONE=$repo/bin/dev-fake-notify-phone
# Taildrop's s picks files through a fake that reads DOTS_DEV_DIR/picked, since the nested bus has no portal.
export DOTS_PICK_FILES=$repo/bin/dev-fake-pick-files
# Dekho asks a fake that answers from dev/dekho's canned JSON and logs each call in the temp dir, never the real dekho, which reaches TMDB.
export DOTS_DEKHO=$repo/bin/dev-fake-dekho
# Deen asks a fake that answers from dev/deen's canned JSON, never the real deen, which reaches aladhan, quran.com's audio and the hadith CDN; a check that reads only local texts names another in DOTS_DEV_DEEN.
export DOTS_DEEN=${DOTS_DEV_DEEN:-$repo/bin/dev-fake-deen}
# The nested niri includes the repo binds, so the cheat sheet reads them, never the live ones.
export DOTS_NIRI_BINDS=$repo/home/dot_config/niri/binds.kdl
# The lock's PAM service accepts only dev/pam-test-password's test password, and pam_exec needs its absolute path.
export DOTS_PAM_DIR=$D/pam.d
# TMUX would point every tmux call at the live server and ignore TMUX_TMPDIR.
unset TMUX
dconf_dir=${XDG_CONFIG_HOME:-$HOME/.config}/dconf
session=
pw=
wp=
a11y=
registry=

qs_dead() {
  local run=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshell live id pid shell
  live=$(qs list -j 2>/dev/null | jq -r '.[].id' 2>/dev/null) || true
  (qs list --show-dead -j 2>/dev/null || true) | (jq -r '.[] | "\(.id) \(.pid) \(.shell_id)"' 2>/dev/null || true) |
    while read -r id pid shell; do
      if grep -qx "$id" <<<"$live"; then continue; fi
      rm -rf "${run:?}/by-id/$id" "$run/by-shell/$shell/$id"
      if [ "$(readlink "$run/by-pid/$pid")" = "$run/by-id/$id" ]; then rm -f "$run/by-pid/$pid"; fi
    done
}

cleanup() {
  trap - EXIT INT TERM
  # The unit stops first, or systemd restarts a displayless qs every 500 ms once niri is gone.
  systemctl --user stop "$DOTS_DEV_UNIT" "$DOTS_DEV_UNIT-clip" "$DOTS_DEV_UNIT-relay" 2>/dev/null || true
  # qs keeps a dead instance's run dir, and every later qs ipc call walks them all, so this config's dead ones go.
  qs_dead
  if [ -n "$session" ]; then
    # dbus-run-session does not forward signals, so niri gets them directly.
    pkill -TERM -P "$session" -x niri 2>/dev/null || true
    wait "$session" 2>/dev/null || true
  fi
  tmux kill-server 2>/dev/null || true
  [ -z "$wp" ] || { kill "$wp" 2>/dev/null; wait "$wp" 2>/dev/null; } || true
  [ -z "$pw" ] || { kill "$pw" 2>/dev/null; wait "$pw" 2>/dev/null; } || true
  [ -z "$registry" ] || { kill "$registry" 2>/dev/null; wait "$registry" 2>/dev/null; } || true
  [ -z "$a11y" ] || { kill "$a11y" 2>/dev/null; wait "$a11y" 2>/dev/null; } || true
  rm -f "$dconf_dir/$dconf_name" "${XDG_RUNTIME_DIR:-/nonexistent}/dconf/$dconf_name"
  rm -rf "$D"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir -p "$XDG_STATE_HOME/dots" "$XDG_DATA_HOME/applications" "$TMUX_TMPDIR" "$PIPEWIRE_RUNTIME_DIR"
printf 'user-db:%s\n' "$dconf_name" >"$DCONF_PROFILE"
mkdir -p "$D/remote"
printf '[Dropbox]\ntype = alias\nremote = %s\n' "$D/remote" >"$RCLONE_CONFIG"
mkdir -p "$DOTS_PAM_DIR"
printf 'auth required pam_exec.so expose_authtok quiet %s\naccount required pam_permit.so\n' "$repo/dev/pam-test-password" >"$DOTS_PAM_DIR/dots-lock"
# Fonts are read, never written, so the user's own stay visible to the nested shell.
[ -d "$user_data/fonts" ] && ln -s "$user_data/fonts" "$XDG_DATA_HOME/fonts"
printf '%s\n' "${DOTS_DEV_THEME:-paper}" >"$XDG_STATE_HOME/dots/theme"
node "$repo/shell/lib/theme-render.mjs" "${DOTS_DEV_THEME:-paper}"
"$repo/bin/dots-shaders"
# The theme-out path changes every run, so the config that includes it is written here.
cat >"$D/niri.kdl" <<EOF
include "$repo/dev/niri-dev.kdl"
include "$XDG_STATE_HOME/dots/theme-out/niri.kdl"
EOF

# WirePlumber makes its own "default" metadata, and Quickshell follows the newest one it hears of, so under WirePlumber the conf's goes and WirePlumber picks the defaults: dots-null by its priority, dots-mic as the only source.
conf=$repo/dev/pipewire.conf
if [ "${DOTS_DEV_WIREPLUMBER:-}" = 1 ]; then
  conf=$D/pipewire.conf
  grep -v 'factory = metadata' "$repo/dev/pipewire.conf" >"$conf"
fi
pipewire -c "$conf" 2>"$D/pipewire.log" &
pw=$!
# The shell connects to PipeWire once, as it starts.
until [ -S "$PIPEWIRE_RUNTIME_DIR/pipewire-0" ]; do
  kill -0 "$pw" 2>/dev/null || { cat "$D/pipewire.log" >&2; exit 1; }
  sleep 0.02
done
# A check that sets DOTS_DEV_WIREPLUMBER=1 gets a session manager that links streams, with the repo's profile in place of the live user config; both buses point nowhere, since an unset session bus falls back to the live one at $XDG_RUNTIME_DIR/bus.
if [ "${DOTS_DEV_WIREPLUMBER:-}" = 1 ]; then
  DBUS_SESSION_BUS_ADDRESS=unix:path=$D/no-bus DBUS_SYSTEM_BUS_ADDRESS=unix:path=$D/no-bus XDG_CONFIG_HOME="$repo/dev" wireplumber -p dots-dev 2>"$D/wireplumber.log" &
  wp=$!
fi

# SELinux keeps the nested bus's dbus-daemon from starting at-spi-bus-launcher, so the nested apps and the desktop skill's gui share an accessibility bus started here.
mkdir -p "$D/a11y"
dbus-daemon --config-file=/usr/share/defaults/at-spi2/accessibility.conf --nofork --address="unix:path=$D/a11y/bus" --print-address=3 3>"$D/a11y/address" &
a11y=$!
until [ -s "$D/a11y/address" ]; do
  kill -0 "$a11y" 2>/dev/null || exit 1
  sleep 0.02
done
AT_SPI_BUS_ADDRESS=$(head -1 "$D/a11y/address")
export AT_SPI_BUS_ADDRESS
env -u DBUS_SESSION_BUS_ADDRESS /usr/libexec/at-spi2-registryd --use-gnome-session=0 >"$D/a11y/registry.log" 2>&1 &
registry=$!

# The nested bus starts file dialogs with the nested shell's picker; its daemon never sees the live display, so nothing it starts before niri's own can draw there (bin/dots-dev-shell hands it the nested one).
mkdir -p "$XDG_DATA_HOME/dbus-1/services"
printf '[D-BUS Service]\nName=org.freedesktop.impl.portal.desktop.dots\nExec=%s\n' "$repo/bin/dots-portal" >"$XDG_DATA_HOME/dbus-1/services/org.freedesktop.impl.portal.desktop.dots.service"
env -u WAYLAND_DISPLAY -u DISPLAY dbus-run-session -- env WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" ${DISPLAY+DISPLAY="$DISPLAY"} niri -c "$D/niri.kdl" &
session=$!
until [ -f "$D/env" ]; do
  kill -0 "$session" 2>/dev/null || exit 1
  sleep 0.05
done
echo "export DOTS_DEV_DIR=$D"
cat "$D/env"
wait "$session"
exit
}
