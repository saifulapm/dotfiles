#!/usr/bin/env python3
# A BlueZ adapter hci0 with a paired "Test Headphones" and a new "Test Speaker" on $DBUS_SYSTEM_BUS_ADDRESS; Connect, Disconnect, Pair and RemoveDevice change them, and a scan finds Test Mouse, Test Keyboard, Test Phone and a nameless device; Pair plays the device's request against the registered agent, and org.dots.FakeBluez on /org/bluez sets that request (SetPairing), types a shown passkey on the device, right (Typed) or wrong (Mistyped), asks for a service (Authorize), sets a device's battery (SetBattery), lists what agents did (Calls) and what was asked of BlueZ (Methods).
import os
import sys

REAL_SYSTEM_BUS = "unix:path=/run/dbus/system_bus_socket"
address = os.environ.get("DBUS_SYSTEM_BUS_ADDRESS", "")
if address in ("", REAL_SYSTEM_BUS):
    sys.exit("dev-fake-bluez: DBUS_SYSTEM_BUS_ADDRESS must be a test bus, not unset or the real system bus")

import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

ADAPTER = "org.bluez.Adapter1"
DEVICE = "org.bluez.Device1"
PROPS = "org.freedesktop.DBus.Properties"
MANAGER = "org.freedesktop.DBus.ObjectManager"
BATTERY = "org.bluez.Battery1"
AGENT = "org.bluez.Agent1"
HCI0 = "/org/bluez/hci0"
KNOB = "org.dots.FakeBluez"


def error(name, text=""):
    return dbus.DBusException(text or name, name="org.bluez.Error." + name)


class Object(dbus.service.Object):
    def __init__(self, bus, path, interface, props):
        super().__init__(bus, path)
        self.path = path
        self.interface = interface
        self.props = props
        self.extra = {}

    def managed(self):
        out = {self.interface: dbus.Dictionary(self.props, signature="sv")}
        for interface, props in self.extra.items():
            out[interface] = dbus.Dictionary(props, signature="sv")
        return out

    def change(self, **changed):
        self.props.update(changed)
        self.PropertiesChanged(self.interface, dbus.Dictionary(changed, signature="sv"), dbus.Array([], signature="s"))

    @dbus.service.method(PROPS, in_signature="ss", out_signature="v")
    def Get(self, interface, name):
        return self.extra[interface][name] if interface in self.extra else self.props[name]

    @dbus.service.method(PROPS, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface):
        return dbus.Dictionary(self.extra.get(interface, self.props if interface == self.interface else {}), signature="sv")

    @dbus.service.method(PROPS, in_signature="ssv")
    def Set(self, interface, name, value):
        self.root.methods.append("Set %s %s" % (self.path, name))
        self.change(**{name: value})

    @dbus.service.signal(PROPS, signature="sa{sv}as")
    def PropertiesChanged(self, interface, changed, invalidated):
        pass


# Test Headphones reports a Battery1 of 80% a second after Connect and drops it on Disconnect, as BlueZ does once the HFP link is up; a device that sent no name has no Name, and BlueZ makes its Alias the address in dashes.
class Device(Object):
    def __init__(self, bus, root, mac, name, paired, battery=None, pairing=("none", 0)):
        self.root = root
        self.battery = battery
        self.battery_timer = None
        # The request Pair plays, (kind, code), and the Pair waiting on a passkey typed on the device.
        self.pairing = pairing
        self.waiting = None
        props = {
            "Address": dbus.String(mac),
            "Alias": dbus.String(name or mac.replace(":", "-")),
            "Icon": dbus.String("audio-headphones"),
            "Adapter": dbus.ObjectPath(HCI0),
            "Paired": dbus.Boolean(paired),
            "Bonded": dbus.Boolean(paired),
            "Trusted": dbus.Boolean(paired),
            "Blocked": dbus.Boolean(False),
            "WakeAllowed": dbus.Boolean(False),
            "Connected": dbus.Boolean(False),
        }
        if name:
            props["Name"] = dbus.String(name)
        super().__init__(bus, HCI0 + "/dev_" + mac.replace(":", "_"), DEVICE, props)

    @dbus.service.method(DEVICE)
    def Connect(self):
        self.root.methods.append("Connect " + self.path)
        if not self.root.adapter.props["Powered"]:
            raise error("NotReady")
        self.change(Connected=dbus.Boolean(True))
        if self.battery is not None and self.battery_timer is None:
            self.battery_timer = GLib.timeout_add(1000, self.add_battery)

    @dbus.service.method(DEVICE)
    def Disconnect(self):
        self.change(Connected=dbus.Boolean(False))
        if self.battery_timer is not None:
            GLib.source_remove(self.battery_timer)
            self.battery_timer = None
        if BATTERY in self.extra:
            del self.extra[BATTERY]
            self.root.InterfacesRemoved(dbus.ObjectPath(self.path), dbus.Array([BATTERY], signature="s"))

    def add_battery(self):
        self.battery_timer = None
        props = {"Percentage": dbus.Byte(self.battery)}
        self.extra[BATTERY] = props
        self.root.InterfacesAdded(dbus.ObjectPath(self.path), {BATTERY: dbus.Dictionary(props, signature="sv")})
        return False

    # A percentage below 0 is a device that reports no battery; a connected one reports the new one at once, on Battery1 as BlueZ does.
    def set_battery(self, pct):
        self.battery = None if pct < 0 else pct
        if self.battery is None:
            if BATTERY in self.extra:
                del self.extra[BATTERY]
                self.root.InterfacesRemoved(dbus.ObjectPath(self.path), dbus.Array([BATTERY], signature="s"))
        elif BATTERY in self.extra:
            self.extra[BATTERY]["Percentage"] = dbus.Byte(pct)
            self.PropertiesChanged(BATTERY, dbus.Dictionary({"Percentage": dbus.Byte(pct)}, signature="sv"), dbus.Array([], signature="s"))
        elif self.props["Connected"] and self.battery_timer is None:
            self.add_battery()

    # BlueZ answers Pair only once the agent has answered the request the device makes, as each kind of device makes one.
    @dbus.service.method(DEVICE, async_callbacks=("ok", "fail"))
    def Pair(self, ok, fail):
        self.root.methods.append("Pair " + self.path)
        kind, code = self.pairing
        if not self.root.adapter.props["Powered"]:
            return fail(error("NotReady"))
        if self.props["Paired"]:
            return fail(error("AlreadyExists"))
        if kind == "fail":
            return fail(error("ConnectionAttemptFailed"))

        def paired(*_):
            self.change(Paired=dbus.Boolean(True), Bonded=dbus.Boolean(True))
            ok()

        if kind == "none":
            return paired()
        agent = self.root.agent
        if agent is None:
            return fail(error("AuthenticationFailed"))
        path = dbus.ObjectPath(self.path)

        def answered(*reply):
            if kind in ("pin", "passkey"):
                self.root.calls.append("Request%s %s %s" % ("PinCode" if kind == "pin" else "Passkey", self.path, reply[0]))
            paired()

        def refused(e):
            fail(error("AuthenticationRejected", str(e)))

        ask = dict(reply_handler=answered, error_handler=refused, timeout=120)
        if kind == "confirm":
            agent.RequestConfirmation(path, dbus.UInt32(code), **ask)
        elif kind == "pin":
            agent.RequestPinCode(path, **ask)
        elif kind == "passkey":
            agent.RequestPasskey(path, **ask)
        elif kind == "display":
            self.waiting = (paired, fail)
            agent.DisplayPasskey(path, dbus.UInt32(code), dbus.UInt16(0), reply_handler=lambda: None, error_handler=lambda e: None)

    @dbus.service.method(DEVICE)
    def CancelPairing(self):
        if self.waiting is None:
            return
        _, fail = self.waiting
        self.waiting = None
        self.root.agent.Cancel(reply_handler=lambda: None, error_handler=lambda e: None)
        fail(error("AuthenticationCanceled"))

    def typed(self):
        if self.waiting is not None:
            paired, _ = self.waiting
            self.waiting = None
            paired()

    # A wrong code typed on the device fails the bond, and BlueZ sends the agent no Cancel for a code it only showed.
    def mistyped(self):
        if self.waiting is not None:
            _, fail = self.waiting
            self.waiting = None
            fail(error("AuthenticationFailed"))


class Adapter(Object):
    def __init__(self, bus, root):
        self.bus_conn = bus
        super().__init__(bus, HCI0, ADAPTER, {
            "Address": dbus.String("00:00:00:00:00:01"),
            "Name": dbus.String("dots-fake"),
            "Alias": dbus.String("dots-fake"),
            "Powered": dbus.Boolean(True),
            "Discoverable": dbus.Boolean(False),
            "DiscoverableTimeout": dbus.UInt32(180),
            "Discovering": dbus.Boolean(False),
            "Pairable": dbus.Boolean(True),
            "PairableTimeout": dbus.UInt32(0),
        })
        self.root = root

    # Powering off stops a scan and drops every connection, as BlueZ does.
    def change(self, **changed):
        super().change(**changed)
        if changed.get("Powered") is not None and not changed["Powered"]:
            if self.props["Discovering"]:
                super().change(Discovering=dbus.Boolean(False))
            for obj in list(self.root.objects.values()):
                if isinstance(obj, Device) and obj.props["Connected"]:
                    obj.Disconnect()

    # The scan's devices stay once it stops, since BlueZ keeps what it found for a while.
    @dbus.service.method(ADAPTER)
    def StartDiscovery(self):
        self.root.methods.append("StartDiscovery " + self.path)
        if not self.props["Powered"]:
            raise error("NotReady")
        self.change(Discovering=dbus.Boolean(True))
        for mac, name, pairing in FOUND:
            path = HCI0 + "/dev_" + mac.replace(":", "_")
            if path not in self.root.objects:
                device = Device(self.bus_conn, self.root, mac, name, False, pairing=pairing)
                self.root.add(device)
                self.root.InterfacesAdded(dbus.ObjectPath(path), device.managed())

    @dbus.service.method(ADAPTER)
    def StopDiscovery(self):
        self.change(Discovering=dbus.Boolean(False))

    @dbus.service.method(ADAPTER, in_signature="o")
    def RemoveDevice(self, path):
        device = self.root.objects.pop(str(path))
        device.remove_from_connection()
        self.root.InterfacesRemoved(path, dbus.Array([DEVICE], signature="s"))


# What a scan finds: (address, name, the request Pair plays).
FOUND = [
    ("00:00:00:00:00:04", "Test Mouse", ("none", 0)),
    ("00:00:00:00:00:05", "Test Keyboard", ("confirm", 123456)),
    ("00:00:00:00:00:06", "Test Phone", ("confirm", 222222)),
    ("00:00:00:00:00:07", "", ("none", 0)),
]


class Root(dbus.service.Object):
    def __init__(self, bus):
        super().__init__(bus, "/")
        self.objects = {}
        self.adapter = None
        # The default agent's proxy, and each call agents made of the manager or answered with a code.
        self.agent = None
        self.calls = []
        # Each scan, pair, connect and property set asked of BlueZ, refused or not.
        self.methods = []

    def add(self, obj):
        self.objects[obj.path] = obj

    @dbus.service.method(MANAGER, out_signature="a{oa{sa{sv}}}")
    def GetManagedObjects(self):
        return {dbus.ObjectPath(p): o.managed() for p, o in self.objects.items()}

    @dbus.service.signal(MANAGER, signature="oa{sa{sv}}")
    def InterfacesAdded(self, path, interfaces):
        pass

    @dbus.service.signal(MANAGER, signature="oas")
    def InterfacesRemoved(self, path, interfaces):
        pass


def strict(message, signature):
    if message.get_signature() != signature:
        raise dbus.DBusException('Method "%s" with signature "%s" doesn\'t exist' % (message.get_member(), message.get_signature()), name="org.freedesktop.DBus.Error.UnknownMethod")


class Manager(dbus.service.Object):
    def __init__(self, bus, root):
        super().__init__(bus, "/org/bluez")
        self.bus = bus
        self.root = root

    # BlueZ matches a method by its signature, so a path sent as a string finds no method.
    @dbus.service.method("org.bluez.AgentManager1", in_signature="os", sender_keyword="sender", message_keyword="message")
    def RegisterAgent(self, path, capability, sender, message):
        strict(message, "os")
        self.root.calls.append("RegisterAgent %s %s" % (path, capability))
        self.root.agent = dbus.Interface(self.bus.get_object(sender, path, introspect=False), AGENT)

    @dbus.service.method("org.bluez.AgentManager1", in_signature="o")
    def UnregisterAgent(self, path):
        self.root.calls.append("UnregisterAgent %s" % path)
        self.root.agent = None

    @dbus.service.method("org.bluez.AgentManager1", in_signature="o", message_keyword="message")
    def RequestDefaultAgent(self, path, message):
        strict(message, "o")
        self.root.calls.append("RequestDefaultAgent %s" % path)

    @dbus.service.method(KNOB, in_signature="osu")
    def SetPairing(self, path, kind, code):
        self.root.objects[str(path)].pairing = (str(kind), int(code))

    @dbus.service.method(KNOB, in_signature="o")
    def Typed(self, path):
        self.root.objects[str(path)].typed()

    @dbus.service.method(KNOB, in_signature="o")
    def Mistyped(self, path):
        self.root.objects[str(path)].mistyped()

    # Answers allowed, or the error name the agent refused with.
    @dbus.service.method(KNOB, in_signature="os", out_signature="s", async_callbacks=("ok", "fail"))
    def Authorize(self, path, uuid, ok, fail):
        if self.root.agent is None:
            return ok("no agent")
        self.root.agent.AuthorizeService(path, uuid, reply_handler=lambda: ok("allowed"), error_handler=lambda e: ok(e.get_dbus_name()), timeout=120)

    @dbus.service.method(KNOB, in_signature="oi")
    def SetBattery(self, path, pct):
        self.root.objects[str(path)].set_battery(int(pct))

    @dbus.service.method(KNOB, out_signature="as")
    def Calls(self):
        return dbus.Array(self.root.calls, signature="s")

    @dbus.service.method(KNOB, out_signature="as")
    def Methods(self):
        return dbus.Array(self.root.methods, signature="s")


DBusGMainLoop(set_as_default=True)
bus = dbus.bus.BusConnection(address)
root = Root(bus)
root.adapter = Adapter(bus, root)
root.add(root.adapter)
Manager(bus, root)
root.add(Device(bus, root, "00:00:00:00:00:02", "Test Headphones", True, 80))
root.add(Device(bus, root, "00:00:00:00:00:03", "Test Speaker", False))
name = dbus.service.BusName("org.bluez", bus, do_not_queue=True)
GLib.MainLoop().run()
