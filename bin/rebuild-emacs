#!/usr/bin/env bash
# rebuild-emacs — build Emacs 31 (the emacs-31 release branch) into
# ~/.local with PGTK + native-comp + tree-sitter, shadowing the emacs-pgtk
# rpm's 30.2 on PATH. Fedora port of the Arch script of the same name:
# dnf's emacs-pgtk is locked to stable. NOT master: the 31 branch cut has
# already moved master on to 32.0.50 — building master here landed a
# surprise Emacs 32 (2026-08-07); the user wants 31. Rerun any time to
# roll forward to the branch tip (run_after_20 only calls this when
# ~/.local/bin/emacs is missing — an apply never surprise-rebuilds).
#
# The systemd side: dot_config/systemd/user/emacs.service (chezmoi-managed)
# points at /usr/bin/emacs; this script drops a machine-state override at
# ~/.config/systemd/user/emacs.service.d/50-local-build.conf resetting
# ExecStart to ~/.local/bin/emacs, then restarts the daemon if it was up.
# Fall back to the rpm with: rm -r ~/.config/systemd/user/emacs.service.d
# && systemctl --user daemon-reload && systemctl --user restart emacs.
#
# IGC (MPS incremental GC): kept from the Arch script but effectively off —
# Fedora packages no MPS; if /usr/include/mps.h ever appears it turns on.

set -euo pipefail

SRC="$HOME/.local/src/emacs"
PREFIX="$HOME/.local"
BRANCH="emacs-31"
JOBS="$(($(nproc) - 1))"
[ "$JOBS" -lt 1 ] && JOBS=1

# --- deps (manifest: "Emacs 31 build deps" block) ---------------------------
# libsystemd is load-bearing, not optional: the unit is Type=notify, and a
# build without --with-libsystemd never signals ready — systemd would kill
# the daemon at TimeoutStartSec.
missing=()
for c in git autoconf makeinfo pkg-config gcc make; do
  command -v "$c" >/dev/null 2>&1 || missing+=("$c")
done
for m in gtk+-3.0 gnutls libsystemd tree-sitter harfbuzz; do
  pkg-config --exists "$m" 2>/dev/null || missing+=("pkgconfig($m)")
done
[ -f /usr/include/libgccjit.h ] || missing+=(libgccjit-devel)
if [ "${#missing[@]}" -gt 0 ]; then
  echo "rebuild-emacs: missing build deps: ${missing[*]} — a terminal 'chezmoi apply' installs them (manifest)" >&2
  exit 1
fi

# --- source -----------------------------------------------------------------
# rev-parse, not [ -d .git ]: a clone killed mid-transfer leaves .git present
# but headless, which the old test accepted forever (audit 2026-08-08).
if ! git -C "$SRC" rev-parse HEAD >/dev/null 2>&1; then
  rm -rf "$SRC"
  mkdir -p "$(dirname "$SRC")"
  echo "==> Cloning emacs upstream $BRANCH (github mirror, faster than savannah)"
  old_head=none
  git clone --depth 1 --branch "$BRANCH" https://github.com/emacs-mirror/emacs.git "$SRC"
else
  echo "==> Updating $SRC to origin/$BRANCH"
  # FETCH_HEAD, not origin/$BRANCH: also handles a checkout that shallow-
  # cloned a different branch (the original master clone jumping to 31).
  old_head="$(git -C "$SRC" rev-parse HEAD)"
  git -C "$SRC" fetch --depth 1 origin "$BRANCH"
  git -C "$SRC" reset --hard FETCH_HEAD
fi

cd "$SRC"
# Clean only when the tip moved (audit 2026-08-08): an OOM-killed make at 80%
# — a real event on 8 GB machines — used to restart from zero on every rerun
# because the unconditional clean threw the objects away. Same tip resumes
# incrementally; a roll-forward still builds from a clean tree. A genuinely
# wedged tree: git -C ~/.local/src/emacs clean -xdf, then rerun.
if [ "$old_head" != "$(git rev-parse HEAD)" ]; then
  git clean -xdf
fi

mps_flag=(--with-mps=no)
if [ -f /usr/include/mps.h ]; then
  mps_flag=(--with-mps=yes)
  echo "==> MPS detected -> building with IGC support"
fi

echo "==> ./autogen.sh"
./autogen.sh

echo "==> ./configure --prefix=$PREFIX"
# Extra args (e.g. --with-imagemagick) pass through on the command line.
./configure \
  --prefix="$PREFIX" \
  --with-pgtk \
  --with-native-compilation=yes \
  --with-tree-sitter \
  --without-compress-install \
  --disable-gc-mark-trace \
  "${mps_flag[@]}" \
  "$@"

# `make uninstall` after configure removes files matching the new PREFIX,
# wiping a previous ~/.local emacs before the new one drops in.
echo "==> Removing previous ~/.local emacs (if any)"
make uninstall >/dev/null 2>&1 || true

echo "==> make -j$JOBS"
make -j"$JOBS"

echo "==> make install"
make install

# --- desktop entries --------------------------------------------------------
# make install drops upstream's launcher entries into $PREFIX/share/
# applications — which for a ~/.local prefix IS ~/.local/share/applications:
# its emacs.desktop clobbers the chezmoi-managed daemon-client override and
# emacsclient.desktop adds a second 'Emacs (Client)' launcher row (user
# report 2026-08-07). Drop all four and re-place the managed override by
# straight copy — NOT a nested `chezmoi apply`, which deadlocks on the
# state lock when this script runs under run_after_20 inside an apply.
rm -f "$PREFIX/share/applications"/emacs{,client}{,-mail}.desktop
repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
managed="$repo/home/dot_local/share/applications/emacs.desktop"
if [ -f "$managed" ]; then
  # The repo deploys files as symlinks into the source tree (chezmoi
  # mode=symlink) — recreate the link, not a copy, or chezmoi diff/verify
  # reports drift until the next apply.
  ln -sfn "$managed" "$PREFIX/share/applications/emacs.desktop"
  echo "==> Restored the daemon-client emacs.desktop override (symlink)"
else
  echo "rebuild-emacs: managed emacs.desktop not found at $managed — rerun chezmoi apply to restore it" >&2
fi

# --- systemd drop-in --------------------------------------------------------
dropin="$HOME/.config/systemd/user/emacs.service.d/50-local-build.conf"
mkdir -p "$(dirname "$dropin")"
printf '[Service]\nExecStart=\nExecStart=%%h/.local/bin/emacs --fg-daemon\n' > "$dropin"
systemctl --user daemon-reload
echo "==> Drop-in installed at $dropin"

if systemctl --user is-active emacs.service >/dev/null 2>&1; then
  echo "==> Restarting emacs.service onto the new build"
  systemctl --user restart emacs.service
fi

echo
echo "Done. Installed:"
"$PREFIX/bin/emacs" --version | head -1
echo "    -> $PREFIX/bin/emacs"
