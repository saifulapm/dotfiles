#!/usr/bin/env bash
# just bench — measures the four numbers the shell is accountable for:
#   1. cold start: process launch -> bar window constructed (shell-reported)
#      plus launch -> IPC responsive (externally observed)
#   2. idle RSS
#   3. idle CPU% over 60s
#   4. theme-switcher open latency, cold (first LazyLoader load) and warm —
#      the launcher itself is vicinae now (2026-08-26), so the shell's
#      lazy-surface cost is measured on the heaviest surviving picker
# Restarts the running shell. The session shell is qshell.service: it is
# stopped for the measurement (its Restart=on-failure would double-spawn
# against the bench instance otherwise) and handed back to systemd at the end.
set -euo pipefail

results_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/bench"
mkdir -p "$results_dir"
out="$results_dir/$(date +%Y%m%d-%H%M%S)-$(uname -m).txt"
# The relaunched shell keeps this fd for its whole life, so the log lives at a
# persistent path (truncated each run) instead of a mktemp file an EXIT trap
# deletes — unlinking it would leave qs -v writing into an invisible deleted
# tmpfs inode until the next restart.
log="$results_dir/.last-qs.log"
: >"$log"

now_ms() { date +%s%N | cut -c1-13; }

echo "bench: restarting shell..."
systemctl --user stop qshell.service 2>/dev/null || true
# Sweep BOTH names: a crash-relaunched or hand-started instance runs under
# comm "quickshell" (qs is a symlink) and pkill -x qs misses it.
pkill -x qs 2>/dev/null || true
pkill -x quickshell 2>/dev/null || true
sleep 1

t0=$(now_ms)
qs -v >"$log" 2>&1 &
disown

# ---- 1. cold start
first_bar=""
for _ in $(seq 1 150); do
  first_bar=$(grep -m1 -oP 'bench:first-bar \K\d+' "$log" || true)
  [ -n "$first_bar" ] && break
  sleep 0.05
done
[ -n "$first_bar" ] || { echo "bench: no first-bar line within 7.5s" >&2; exit 1; }

ipc_ready=""
for _ in $(seq 1 100); do
  if qs ipc call shell ping >/dev/null 2>&1; then
    ipc_ready=$(( $(now_ms) - t0 ))
    break
  fi
  sleep 0.05
done

qspid=$(pgrep -x qs | head -1)

# ---- 2. idle RSS (settle first, and sample BEFORE the picker tests: a
# summoned surface stays resident for its grace period, so measuring after
# them would charge the picker tree to "idle")
sleep 5
rss_kb=$(awk '/VmRSS/ {print $2}' "/proc/$qspid/status")

# ---- 3. idle CPU over 60s — BEFORE the picker tests: the theme switcher
# decodes 22 wallpaper thumbnails on first open (the retired launcher was
# trivial), and sampling after it charged that burst to "idle" (measured
# 2.95% vs 0.35% steady on 2026-08-26).
read -r ut0 st0 < <(awk '{print $14, $15}' "/proc/$qspid/stat")
sleep 60
read -r ut1 st1 < <(awk '{print $14, $15}' "/proc/$qspid/stat")
ticks=$(( ut1 - ut0 + st1 - st0 ))
hz=$(getconf CLK_TCK)
cpu_pct=$(python3 -c "print(f'{$ticks / $hz / 60 * 100:.3f}')")

# ---- 4a. theme-switcher cold latency (still honest this late: nothing
# above summons it, so its loader has never been active in this process)
lc0=$(now_ms)
qs ipc call theme show >/dev/null
picker_cold=$(( $(now_ms) - lc0 ))
qs ipc call theme hide >/dev/null
sleep 0.3

# warm
lw0=$(now_ms)
qs ipc call theme show >/dev/null
picker_warm=$(( $(now_ms) - lw0 ))
qs ipc call theme hide >/dev/null

# IPC round-trip overhead baked into the picker numbers
po0=$(now_ms)
qs ipc call shell ping >/dev/null
ipc_overhead=$(( $(now_ms) - po0 ))

{
  echo "date:            $(date -Iseconds)"
  echo "machine:         $(uname -m) $(uname -r)"
  echo "shell pid:       $qspid"
  echo "cold start:      ${first_bar} ms to bar constructed (shell-reported)"
  echo "ipc ready:       ${ipc_ready:-n/a} ms from spawn (external)"
  echo "idle rss:        $(( rss_kb / 1024 )) MiB (${rss_kb} kB)"
  echo "idle cpu (60s):  ${cpu_pct}%"
  echo "picker cold:     ${picker_cold} ms (incl. ~${ipc_overhead} ms qs-ipc overhead)"
  echo "picker warm:     ${picker_warm} ms (incl. ~${ipc_overhead} ms qs-ipc overhead)"
} | tee "$out"

echo "saved: $out"

# Hand the shell back to systemd supervision (no-op fallback: if the unit
# is missing — nested dev checkout, other machine — the bench instance just
# stays up, the old contract).
if systemctl --user cat qshell.service >/dev/null 2>&1; then
  echo "bench: handing shell back to qshell.service"
  kill "$qspid" 2>/dev/null || true
  sleep 0.5
  systemctl --user start qshell.service
fi
