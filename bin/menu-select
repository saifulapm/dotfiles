#!/usr/bin/env bash
# menu-select — pick one option from a list, dmenu-style, via vicinae.
#
# Same interface as the retired in-shell version (omarchy-menu-select port):
# options come as arguments or on stdin, an option may lead with an icon as
# "<glyph><TAB><label>" (the glyph is dropped — the answer is the label
# alone, and vicinae draws its own row chrome). Prints the selection to
# stdout; a cancelled picker exits 1.
#
#   menu-select <prompt> [option...]
#   printf '%s\n' one two | menu-select "Pick"
set -euo pipefail

if (($# < 1)); then
  echo "Usage: menu-select <prompt> [option...]" >&2
  exit 1
fi

prompt="$1"
shift

options=()
while (($# > 0)); do
  [[ $1 == "--" ]] && break # accept-and-ignore trailing menu args (upstream compat)
  options+=("$1")
  shift
done

if ((${#options[@]} == 0)) && [[ ! -t 0 ]]; then
  mapfile -t options
fi

((${#options[@]} > 0)) || { echo "menu-select: no options" >&2; exit 1; }

# Strip a leading "<glyph><TAB>" so callers keep their icon lists unchanged.
selection=$(printf '%s\n' "${options[@]}" | sed 's/^[^\t]*\t//' \
  | vicinae dmenu -p "$prompt" --no-quick-look --no-metadata) || exit 1

[[ -n $selection ]] || exit 1
printf '%s\n' "$selection"
