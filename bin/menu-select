#!/usr/bin/env bash
# menu-select — pick one option from the shell menu, dmenu-style.
#
# Port of omarchy-menu-select: options come as arguments or on
# stdin, an option may lead with an icon as "<glyph><TAB><label>" (the menu
# draws the glyph, the answer is the label alone). The payload rides
# `qs ipc call menu prompt`; the shell writes the answer into selectionFile
# and touches doneFile on EVERY dismissal, cancelled ones included.
#
#   menu-select <prompt> [option...]
#   printf '%s\n' one two | menu-select "Pick"
set -euo pipefail

if (($# < 1)); then
  echo "Usage: menu-select <prompt> [option...]" >&2
  exit 1
fi

prompt="$1"
shift

options=()
while (($# > 0)); do
  [[ $1 == "--" ]] && break # accept-and-ignore trailing menu args (upstream compat)
  options+=("$1")
  shift
done

if ((${#options[@]} == 0)) && [[ ! -t 0 ]]; then
  mapfile -t options
fi

((${#options[@]} > 0)) || { echo "menu-select: no options" >&2; exit 1; }

selection_file=$(mktemp)
done_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file"' EXIT

payload=$(jq -cn --arg prompt "$prompt" --arg sel "$selection_file" --arg done "$done_file" \
  '{mode: "select", prompt: $prompt, selectionFile: $sel, doneFile: $done, options: $ARGS.positional}' \
  --args "${options[@]}")

qs ipc call menu -- prompt "$payload" >/dev/null

# 120s cap: if the shell dies mid-prompt the done file never appears.
for ((i = 0; i < 2400; i++)); do
  [[ -e $done_file ]] && break
  sleep 0.05
done
[[ -e $done_file ]] || exit 1

if [[ -s $selection_file ]]; then
  cat "$selection_file"
else
  exit 1
fi
