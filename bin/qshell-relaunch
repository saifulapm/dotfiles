#!/usr/bin/env bash
# qshell-relaunch — restart the shell from inside the shell (the menu's
# "Relaunch Shell" row, Modules/Menu/MenuTree.js system.relaunch).
#
# The row used to be `pkill -x qs; sleep 0.5; exec setsid qs`, written when
# the shell was a niri spawn-at-startup child and an orphaned bash really did
# outlive it. Under qshell.service that command is a one-way trip, for two
# independent reasons (both reproduced 2026-08-10, `qs ipc call menu open
# restart-shell` → Result=success, ExecMainStatus=15, NRestarts=0, no qs):
#
#   * systemd counts SIGTERM as a CLEAN exit, so `pkill` retires the unit
#     with Result=success and `Restart=on-failure` correctly declines to act;
#   * the relauncher never gets to run anyway. Menu actions are
#     Quickshell.execDetached children, and detaching does not leave the
#     cgroup — `systemd-cgls --user-unit qshell.service` lists every helper
#     the shell spawns. When the main process goes, KillMode=control-group
#     SIGTERMs the rest of that cgroup, and `sleep 0.5` is in it.
#
# So: ask systemd instead. `--no-block` is the load-bearing flag — it queues
# the job and returns, leaving the restart to the user manager, which is
# outside the cgroup about to be torn down. A blocking `systemctl restart`
# would be killed halfway through waiting for its own job.
set -uo pipefail

force=0
[[ ${1:-} == --force ]] && force=1

# Restarting a LIVE lock client throws the session back to a blanked screen
# and a fresh password prompt for no reason. The shell recovers from it now
# (Modules/Lock/Lock.qml writes a marker, shell.qml re-arms the lock on the
# next start), so this is a courtesy, not a safety net — hence --force.
# Asking over IPC rather than reading the marker: the marker says "a lock was
# requested", the shell says whether one is actually up right now.
if ((!force)) && [[ $(timeout 2 qs ipc call lock isLocked 2>/dev/null) == "true" ]]; then
  echo "qshell-relaunch: the session is locked — restarting would force a re-auth." >&2
  echo "                 Unlock first, or pass --force." >&2
  exit 1
fi

# Are WE inside the unit? The cgroup line is inherited from the qs that
# spawned this script, so it answers "is the shell that asked for this the
# service instance" — not merely "is the service running", which is also true
# while a `just run` instance is being tested alongside it.
cgroup="$(cat /proc/self/cgroup 2>/dev/null || true)"

if [[ $cgroup == *qshell.service* ]]; then
  exec systemctl --user restart --no-block qshell.service
fi

# Reaching here means the CALLER is outside the unit, which is not the same
# thing as the shell being outside it. A terminal, an editor task or an agent
# invoking this by hand lands here while systemd owns the running shell
# perfectly well — and the pkill below would then retire the unit (SIGTERM
# reads as a clean exit, so Restart=on-failure declines, exactly as the header
# describes) and leave a bare replacement running OUTSIDE the cgroup, with no
# unit to restart it next time. So ask systemd whether it owns the only shell
# that is running, which MainPID answers from any caller.
#
# No --no-block here, unlike the branch above: nothing is about to tear this
# process down, so waiting is safe and tells the caller whether it worked.
main_pid="$(systemctl --user show qshell.service -p MainPID --value 2>/dev/null || echo 0)"
# Both names: a crash-relaunched or hand-started instance runs under comm
# "quickshell" (qs is a symlink), and `pkill -x qs` misses it — the same sweep
# bin/bench does.
others="$(pgrep -x qs; pgrep -x quickshell)"
others="$(printf '%s\n' "$others" | grep -v "^${main_pid}\$" | grep -c . || true)"

if [[ ${main_pid:-0} -gt 0 && -d /proc/${main_pid} && ${others} -eq 0 ]]; then
  exec systemctl --user restart qshell.service
fi

# A hand-run instance (`just run`, a dev checkout): no unit owns it, nothing
# will bring it back, and the old dance is right — setsid so the replacement
# does not sit in the dying process's session.
pkill -x qs
sleep 0.5
exec setsid qs
