#!/bin/bash
# clipboard-open — open a clipboard-history entry in the right application.
#
#   clipboard-open --history-index <index>
#
# Port of omarchy's bin/omarchy-clipboard-open (MIT, see CREDITS.md): a URL
# (or something that looks like a bare domain) goes to the browser, an image
# entry opens in the image viewer, and any other text is written to a scratch
# file and opened in an editor. The entry travels by INDEX for the same
# reason as clipboard-paste: argv is world-readable in /proc.
#
# Deviations from upstream, both about what is installed here: their
# tensaku-edit image editor and omarchy-launch-browser/-editor launchers are
# not shipped, so everything funnels through xdg-open, which resolves to the
# desktop's own defaults (chromium for URLs and whatever handles text/plain
# and the image mime).

set -uo pipefail

index=""
history_path="${XDG_STATE_HOME:-$HOME/.local/state}/qshell/clipboard/history.json"

while (($# > 0)); do
    case "$1" in
    --history-index)
        index="${2:-}"
        shift 2
        ;;
    *)
        echo "Usage: clipboard-open --history-index <index>" >&2
        exit 1
        ;;
    esac
done

[[ $index =~ ^[0-9]+$ ]] || exit 1
[[ -r $history_path ]] || exit 1

entry_type=$(jq -er --argjson i "$index" '.[$i].type' "$history_path") || exit 1

case "$entry_type" in
image)
    path=$(jq -er --argjson i "$index" '.[$i].path' "$history_path") || exit 1
    [[ -r $path ]] || exit 1
    exec xdg-open "$path"
    ;;
text)
    text=$(jq -er --argjson i "$index" '.[$i].text' "$history_path") || exit 1

    # Upstream's URL sniff, verbatim: an embedded http(s) URL wins, else a
    # lone bare domain is promoted to https.
    url=$(grep -Eom1 'https?://[^[:space:]"'\''<>]+' <<<"$text" || true)
    if [[ -z $url && $text =~ ^[[:space:]]*([[:alnum:]][[:alnum:].-]+\.[[:alpha:]]{2,})(/[^[:space:]]*)?[[:space:]]*$ ]]; then
        url="https://${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
    fi
    if [[ -n $url ]]; then
        exec xdg-open "$url"
    fi

    open_dir="${XDG_STATE_HOME:-$HOME/.local/state}/qshell/clipboard-open"
    mkdir -p "$open_dir"
    open_file=$(mktemp --tmpdir="$open_dir" clipboard.XXXXXX.txt) || exit 1
    printf '%s' "$text" >"$open_file"
    exec xdg-open "$open_file"
    ;;
*)
    exit 1
    ;;
esac
