#!/usr/bin/env bash
# wallhaven-fetch — wallhaven.cc search and full-image download.
#
#   wallhaven-fetch --list [--query QUERY] [--page N]
#       Fetch one page of search results, pre-download thumbs to
#       ~/.cache/qshell/wallhaven-thumbs/{id}.{ext}, emit TSV rows to stdout:
#           <thumb_path>\t<image_url>\t<id>\t<resolution>\t<ext>
#       Last line is a sentinel:
#           __META__\t<page>\t<total_pages>
#
#   wallhaven-fetch --download URL ID EXT
#       Download the full image to ~/Pictures/Wallpapers/wallhaven-{id}.{ext}
#       and print the saved path to stdout. Skips if the file already exists.
#
# Default sort is toplist/desc (Wallhaven's curated popular wallpapers, which
# skew landscape and high-res — a sensible default for a desktop picker). The
# API key is read from pass(1) wallhaven/api_key, so a stored secret is the
# only prerequisite.

set -euo pipefail

api_key="$(pass show wallhaven/api_key 2>/dev/null || true)"
[[ -n $api_key ]] || { echo "wallhaven-fetch: no API key in pass wallhaven/api_key" >&2; exit 1; }

thumb_cache="${XDG_CACHE_HOME:-$HOME/.cache}/qshell/wallhaven-thumbs"
download_dir="$HOME/Pictures/Wallpapers"
api_base="https://wallhaven.cc/api/v1"

# 1080-wide intermediates: the wallhaven-supplied `thumbs.large` is 432x243
# (300x200 for `small`), and our filmstrip draws slices 108x432 — a 432x243
# source upscaled 7x vertically is visibly soft on the dimmed slices.
# 1080-wide gives the 768x475 expanded preview and the 108x432 slices
# comfortable headroom, in ~80 KiB of JPEG instead of the 5 MiB full image.
THUMB_WIDTH=1080

# mkdir -p is best-effort: both dirs are user-owned and usually exist; failing
# here would only matter if $HOME is read-only, which is not our scenario.
mkdir -p "$thumb_cache" "$download_dir" 2>/dev/null || true

usage() {
    cat >&2 <<EOF
usage:
  wallhaven-fetch --list [--query QUERY] [--page N]
  wallhaven-fetch --download URL ID EXT
EOF
    exit 2
}

[[ $# -ge 1 ]] || usage
mode="$1"; shift

case "$mode" in
--list)
    query=""
    page=1
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --query) query="${2:-}"; shift 2 ;;
            --page) page="${2:-1}"; shift 2 ;;
            *) echo "wallhaven-fetch: unknown arg: $1" >&2; exit 2 ;;
        esac
    done

    # Wallhaven's /search params: q (free text), page (1-based), sorting, order,
    # and purity/categories/ratios/resolutions (left at defaults so SFW only).
    params=("sorting=toplist" "order=desc" "page=$page")
    [[ -n $query ]] && params+=("q=$(printf %s "$query" | jq -sRr @uri)")

    url="$api_base/search?$(IFS='&'; echo "${params[*]}")"

    body="$(curl -fsS --max-time 30 -H 'Accept: application/json' -H "X-API-Key: $api_key" "$url")"
    last_page="$(echo "$body" | jq -r '.meta.last_page // 1')"

    # Each row: tab-separated five columns. jq emits one row per wallpaper;
    # the while loop downloads the FULL image (`path`), scales it to a
    # 1080-wide intermediate JPEG cached under `thumb_cache`, and prints
    # the TSV row pointing the strip at the cached intermediate. The
    # pipeline runs in a subshell because of the pipe; the variables inside
    # only matter for that iteration.
    have_ffmpeg=1
    command -v ffmpeg >/dev/null 2>&1 || have_ffmpeg=0

    echo "$body" | jq -r '.data[]? | [
        .id,
        .path,
        (.resolution // ""),
        (.file_type // "image/jpeg" | split("/")[1] // "jpg")
      ] | @tsv' | while IFS=$'\t' read -r id path resolution ext; do
        [[ -z $id ]] || [[ -z $path ]] && continue

        thumb_path=""
        thumb_file="$thumb_cache/$id.jpg"

        if [[ ! -s $thumb_file ]]; then
            raw="$thumb_cache/$id.raw.$ext"
            # Best-effort: a failed full-image download or downscale leaves
            # the row with an empty imagePath so the picker draws the empty
            # swatch slot instead of holding up the whole page on a flaky
            # network. The .raw file is the intermediate; it is overwritten
            # on the next run for this id (no concurrency to worry about —
            # one picker fetch at a time).
            if curl -fsSL --max-time 30 -o "$raw" "$path" 2>/dev/null; then
                if ((have_ffmpeg)); then
                    # scale='min(W,iw)':-2 never upscales a wallpaper already
                    # narrower than the cap (rare but possible — vertical
                    # phone shots), -2 keeps the height even for yuv420p,
                    # -q:v 4 mirrors bin/wallpaper-thumbs for parity.
                    if ffmpeg -v error -y -i "$raw" -frames:v 1 \
                        -vf "scale='min($THUMB_WIDTH,iw)':-2" -q:v 4 \
                        -f mjpeg "$thumb_file.tmp" </dev/null 2>/dev/null \
                        && [[ -s $thumb_file.tmp ]]; then
                        mv -f "$thumb_file.tmp" "$thumb_file"
                    else
                        rm -f "$thumb_file.tmp"
                    fi
                else
                    # ffmpeg missing — fall back to the raw download so the
                    # strip still renders, just at the source's full size.
                    mv -f "$raw" "$thumb_file"
                    thumb_file="$thumb_file"  # (no-op: clarity for grep)
                fi
            fi
            rm -f "$raw"
        fi

        if [[ -s $thumb_file ]]; then
            thumb_path="$thumb_file"
        fi

        printf '%s\t%s\t%s\t%s\t%s\n' "$thumb_path" "$path" "$id" "$resolution" "$ext"
    done

    # Trailing sentinel so the QML caller learns current/total page in the
    # same read — saves a second HTTP round trip per page change.
    printf '__META__\t%s\t%s\n' "$page" "$last_page"
    ;;

--download)
    [[ $# -eq 3 ]] || usage
    url="$1"
    id="$2"
    ext="$3"

    dest="$download_dir/wallhaven-$id.$ext"
    if [[ -s $dest ]]; then
        echo "$dest"
        exit 0
    fi

    if ! curl -fsSL --max-time 120 -o "$dest.part" "$url"; then
        rm -f "$dest.part"
        echo "wallhaven-fetch: download failed for $id" >&2
        exit 1
    fi
    mv "$dest.part" "$dest"
    echo "$dest"
    ;;

*)
    usage
    ;;
esac
