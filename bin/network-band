#!/bin/bash
# network-band — show or pin the Wi-Fi band of the active connection.
#
# Direct port of omarchy's bin/omarchy-network-band (MIT):
# same nmcli mechanism, same output contract ("band"/"available"/"selected"
# key-tab-value lines), same revert-on-failure behaviour. The one change is
# that the current SSID and frequency are read from NetworkManager's own scan
# cache instead of `iw dev <device> link`, so `iw` is not a dependency.
#
#   no args           print status
#   auto | 2.4 | 5|6  pin the band (or unpin, with auto)

set -euo pipefail

# NetworkManager 1.44+ accepts a third band value, so 5GHz and 6GHz can be
# pinned apart. Pinning the band rather than a BSSID keeps working when the AP
# rotates BSSIDs, and leaves roaming between APs intact.
nm_band_for() {
    case "$1" in
    2.4) echo "bg" ;;
    5) echo "a" ;;
    6) echo "6GHz" ;;
    *) return 1 ;;
    esac
}

band_from_nm() {
    case "$1" in
    bg) echo "2.4" ;;
    a) echo "5" ;;
    6GHz) echo "6" ;;
    *) echo "auto" ;;
    esac
}

# Accepts nmcli's "5180 MHz": keep the leading digits and ignore the unit. The
# boundaries mirror NetworkModel.js formatHeaderFreq so the panel's label and
# this command cannot disagree.
band_for_freq() {
    local mhz=${1%%[!0-9]*}
    [[ -n $mhz ]] || return 1

    if ((mhz >= 2400 && mhz < 2500)); then
        echo "2.4"
    elif ((mhz >= 4900 && mhz < 5925)); then
        echo "5"
    elif ((mhz >= 5925 && mhz < 7125)); then
        echo "6"
    else
        return 1
    fi
}

# The frequency ranges this radio may TRANSMIT on, as "start end" pairs in MHz,
# from the kernel's enforced regulatory domain.
#
# WHY THIS EXISTS (diagnosed 2026-09-04, on a real network): receiving is always
# permitted, so an AP on a channel the card may not transmit on still appears in
# every scan — at full signal, advertising a rate six times the one in use.
# Pinning to it then fails the only way it can: the supplicant scans, never
# answers, and NetworkManager gives up after ~28 s with `association took too
# long` and the actively misleading reason `ssid-not-found`. It was found; it
# could not be replied to. On this machine, regdomain BD allows 5735-5835 MHz
# and the office AP's 5 GHz radio sits on 5180.
#
# Ranges are cached for the life of the process: print_status calls this once
# per poll and `iw` is a fork.
#
# NO-IR ranges are dropped with the disallowed ones. "No initiate radiation"
# means the card may not start or join a network there even though it may
# listen, which is the same failure with a different cause.
_reg_ranges=""
reg_ranges() {
    [[ -n $_reg_ranges ]] && {
        printf '%s' "$_reg_ranges"
        return 0
    }
    command -v iw >/dev/null 2>&1 || return 1

    # `iw reg get` prints the enforced global domain first, then a block per
    # phy. Stop at the first `phy#`: a phy block reports that card's own
    # (often unset, wide-open) view, and merging it in would widen the result
    # back to everything and defeat the filter.
    _reg_ranges=$(iw reg get 2>/dev/null | awk '
        /^phy#/ { exit }
        /^[[:space:]]*\([0-9]+ - [0-9]+ @/ {
            if ($0 ~ /NO-IR/) next
            gsub(/[()]/, "")
            print $1, $3
        }')
    [[ -n $_reg_ranges ]] || return 1
    printf '%s' "$_reg_ranges"
}

# The two-letter domain, for the one error message that needs to name it.
# "unknown" rather than empty: the message reads as a sentence either way.
reg_domain() {
    iw reg get 2>/dev/null | awk '/^country [A-Z0-9]{2}:/ { print $2; exit }' | tr -d ':' | grep . || echo unknown
}

# Whether the SSID is visible on $3 at all, ignoring whether we may transmit
# there. The difference between "the AP has no 5 GHz radio" and "it has one we
# are not allowed to answer", which are the same to available_bands and very
# different to a person looking at a full-strength network in the list.
seen_on_band() {
    local device=$1 ssid=$2 want=$3 freq band

    # Process substitution, not a pipe: the loop has to run in THIS shell for
    # `return 0` to leave the function. Piped into a subshell it cannot, and
    # reading the pipeline's status instead reports found for an SSID that is
    # not in the list at all — a while loop that never iterates exits 0.
    while read -r freq; do
        band=$(band_for_freq "$freq") || continue
        [[ $band == "$want" ]] && return 0
    done < <(
        nm_get FREQ,SSID dev wifi list ifname "$device" --rescan no |
            want="$ssid" awk -F: '
            BEGIN { want = ENVIRON["want"] }
            {
              name = $2
              for (i = 3; i <= NF; i++) name = name ":" $i
              if (name == want) print $1
            }'
    )
    return 1
}

# Whether a 20 MHz channel centred on $1 fits entirely inside a permitted range.
# The span matters: a centre inside the range whose edge falls outside is still
# not usable, which is how the boundary channels behave.
#
# UNKNOWN REGULATORY STATE MEANS ALLOWED. Without `iw`, or with an unparseable
# domain, this must not start hiding bands that work — a false negative here
# removes a working option from the panel, which is worse than the failure it
# is trying to prevent.
freq_permitted() {
    local mhz=${1%%[!0-9]*} ranges start end
    [[ -n $mhz ]] || return 1
    ranges=$(reg_ranges) || return 0

    while read -r start end; do
        [[ -n $start ]] || continue
        ((mhz - 10 >= start && mhz + 10 <= end)) && return 0
    done <<<"$ranges"
    return 1
}

# Every value read back from nmcli goes through here. LC_ALL=C because nmcli
# translates state words such as "connected", which would silently stop matching
# under a non-English session; `-e no` because `-g` otherwise escapes ':' and
# '\' in values, and an escaped SSID would never match the scan list's raw one.
nm_get() {
    LC_ALL=C nmcli -e no -g "$@" 2>/dev/null
}

# The prefix match accepts states like "connected (externally)", the same
# variance bin/network-qr handles; an exact match would report "no connected
# Wi-Fi device" for an externally-activated one.
wifi_device() {
    nm_get DEVICE,TYPE,STATE device status |
        awk -F: '$2 == "wifi" && $3 ~ /^connected/ { print $1; exit }'
}

wifi_profile() {
    nm_get GENERAL.CONNECTION device show "$1"
}

selected_band() {
    band_from_nm "$(nm_get 802-11-wireless.band connection show "$1")"
}

# Sets $ssid and $freq from the in-use row of the scan cache. SSID is queried
# last so one containing ':' can be reassembled verbatim from the tail fields.
read_link() {
    local line
    line=$(nm_get IN-USE,FREQ,SSID dev wifi list ifname "$1" --rescan no | awk -F: '$1 == "*" { print; exit }')
    freq=$(awk -F: '{ print $2; exit }' <<<"$line")
    ssid=$(awk -F: '{ v = $3; for (i = 4; i <= NF; i++) v = v ":" $i; print v; exit }' <<<"$line")
}

# Every band the SSID is reachable on AND this radio may transmit on, low to
# high, always including the one already in use -- a weak radio gets missed by
# plenty of scans, and the band we are sitting on must never be absent from its
# own list of options (nor can it be illegal: we are transmitting on it).
#
# A band the AP does not answer on is never offered: pinning to it would drop
# the connection with nothing to reassociate to. Neither is one the regulatory
# domain forbids -- see freq_permitted; that button's only possible outcome is a
# ~28 s stall and a revert.
#
# --rescan no reads NetworkManager's cache, which the panel's own scanner keeps
# warm; forcing a scan here would stall every poll.
available_bands() {
    local device=$1 ssid=$2 current=$3

    {
        if [[ -n $current ]]; then echo "$current"; fi

        # The SSID reaches awk through the environment, not -v, which would
        # expand backslash escapes in an SSID that contains one.
        nm_get FREQ,SSID dev wifi list ifname "$device" --rescan no |
            want="$ssid" awk -F: '
        BEGIN { want = ENVIRON["want"] }
        {
          name = $2
          for (i = 3; i <= NF; i++) name = name ":" $i
          if (name == want) print $1
        }' |
            while read -r freq; do
                freq_permitted "$freq" || continue
                band_for_freq "$freq" || true
            done
    } | sort -u -g | tr '\n' ' ' | sed 's/ $//'
}

print_status() {
    local device profile band available

    device=$(wifi_device)
    [[ -n $device ]] || return 0

    read_link "$device"
    [[ -n $ssid ]] || return 0

    band=$(band_for_freq "$freq" || true)
    available=$(available_bands "$device" "$ssid" "$band")
    profile=$(wifi_profile "$device")

    printf 'band\t%s\n' "$band"
    printf 'available\t%s\n' "$available"
    if [[ -n $profile ]]; then printf 'selected\t%s\n' "$(selected_band "$profile")"; fi
}

set_band() {
    local target=$1
    local device profile previous desired

    device=$(wifi_device)
    if [[ -z $device ]]; then
        echo "Error: no connected Wi-Fi device." >&2
        exit 1
    fi

    profile=$(wifi_profile "$device")
    if [[ -z $profile ]]; then
        echo "Error: no active Wi-Fi connection profile." >&2
        exit 1
    fi

    if [[ $target == "auto" ]]; then
        desired=""
    else
        read_link "$device"
        if [[ " $(available_bands "$device" "$ssid" "$(band_for_freq "$freq" || true)") " != *" $target "* ]]; then
            # Two different refusals wear the same words otherwise, and the
            # regulatory one is the confusing case: the AP is right there at
            # full signal, so "not available" reads as a bug in this script
            # rather than as a law. Say which it is.
            if seen_on_band "$device" "$ssid" "$target"; then
                echo "Error: this network's ${target}GHz radio is on a channel the regulatory domain ($(reg_domain)) does not allow transmitting on." >&2
            else
                echo "Error: ${target}GHz is not available on this network." >&2
            fi
            exit 1
        fi
        desired=$(nm_band_for "$target")
    fi

    previous=$(nm_get 802-11-wireless.band connection show "$profile")
    [[ $previous == "$desired" ]] && exit 0

    nmcli connection modify "$profile" 802-11-wireless.band "$desired" >/dev/null

    # A band change only takes effect on reassociation. If the radio cannot come
    # back up on the requested band, put the previous setting back and reconnect
    # rather than leaving the machine stranded offline.
    # The regulatory domain is read at THIS point on purpose: while still
    # associated it is whatever the AP's beacon claims, and that is the value
    # the pre-flight check in set_band used.
    local domain_while_up domain_while_down
    domain_while_up=$(reg_domain)

    if ! nmcli connection up "$profile" >/dev/null 2>&1; then
        # Sampled BEFORE reconnecting, while the radio is still unassociated —
        # this is the domain that actually governed the attempt.
        domain_while_down=$(reg_domain)

        nmcli connection modify "$profile" 802-11-wireless.band "$previous" >/dev/null
        nmcli connection up "$profile" >/dev/null 2>&1 || true

        # THE DEADLOCK, worth naming because nothing else in the system does.
        # A card takes its regulatory domain from the AP it is associated with,
        # and loses it the moment it disassociates. If the AP's 5 GHz channel
        # is legal only under the domain that AP grants, then the permission to
        # use it exists solely while already connected to it — and changing
        # band requires disconnecting. The supplicant then scans a channel it
        # may not transmit on, finds nothing, and NetworkManager gives up after
        # ~25 s with the misleading `ssid-not-found`.
        if [[ -n $domain_while_down && $domain_while_up != "$domain_while_down" ]]; then
            echo "Error: could not connect on ${target}; reverted to previous band." >&2
            echo "  The regulatory domain was ${domain_while_up} while connected but ${domain_while_down} once the radio dropped, and the AP's ${target}GHz channel is not permitted under ${domain_while_down}." >&2
            echo "  Nothing here can fix that: the permission only exists while already associated. Move the AP's ${target}GHz radio to a channel ${domain_while_down} allows." >&2
        else
            echo "Error: could not connect on ${target}; reverted to previous band." >&2
        fi
        exit 1
    fi
}

usage() {
    echo "Usage: network-band [auto|2.4|5|6]" >&2
}

if (($# == 0)); then
    print_status
    exit 0
fi

if (($# > 1)); then
    usage
    exit 1
fi

case "$1" in
auto | 2.4 | 5 | 6)
    set_band "$1"
    ;;
*)
    usage
    exit 1
    ;;
esac
