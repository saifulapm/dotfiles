#!/bin/bash
# network-qr — Wi-Fi share helper for the shell.
#
# Direct port of omarchy's bin/omarchy-network-qr and bin/omarchy-network-password
# (MIT, see CREDITS.md), merged into one command:
#
#   network-qr [interface]              print the QR matrix as 0/1 rows
#   network-qr --password [interface]   print the active connection's password
#
# The matrix form needs `qrencode`; it is listed in packages/manifest.toml, and
# the panel hides its share button when the binary is absent rather than
# offering an action that cannot work.
#
# Secrets only ever travel on stdout, which is a private pipe to the caller —
# never in argv, which is world-readable in /proc.

set -euo pipefail

mode=matrix
if [[ ${1:-} == "--password" ]]; then
    mode=password
    shift
fi

interface=${1:-}
if [[ -z $interface ]]; then
    # Prefer the default-route device: it is the connection the panel
    # describes. Fall back to the first connected Wi-Fi device. nmcli
    # localizes state names, so pin the locale, and the prefix match accepts
    # states like "connected (externally)".
    route_device=$(ip route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
    if [[ -n $route_device && -d /sys/class/net/$route_device/wireless ]]; then
        interface=$route_device
    else
        interface=$(LC_ALL=C nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null |
            awk -F: '$2 == "wifi" && $3 ~ /^connected/ { print $1; exit }')
    fi
fi
[[ -n $interface ]] || {
    echo "No active Wi-Fi connection" >&2
    exit 1
}

uuid=$(nmcli --get-values GENERAL.CON-UUID device show "$interface" | head -n 1)
[[ -n $uuid && $uuid != "--" ]] || {
    echo "No active Wi-Fi connection" >&2
    exit 1
}

# --show-secrets on a connection the calling user owns needs no root; on a
# system connection NetworkManager asks polkit, and the shell's agent prompts.
mapfile -t fields < <(nmcli --show-secrets --escape no --get-values \
    802-11-wireless.ssid,802-11-wireless-security.key-mgmt,802-11-wireless-security.psk,802-11-wireless.hidden,802-11-wireless-security.wep-key0 \
    connection show uuid "$uuid")

ssid=${fields[0]:-}
key_management=${fields[1]:-}
password=${fields[2]:-}
hidden=${fields[3]:-no}
wep_key=${fields[4]:-}

[[ $key_management != *eap* && $key_management != *ieee8021x* ]] || {
    echo "Enterprise Wi-Fi cannot be shared with a password QR code" >&2
    exit 1
}

# NetworkManager models WEP as key-mgmt "none" plus a wep-key; encoding it as
# an open network would produce a QR that silently fails to join.
if [[ -n $key_management && $key_management != "none" ]]; then
    security=WPA
elif [[ -n $wep_key ]]; then
    password=$wep_key
    security=WEP
else
    password=""
    security=nopass
fi

if [[ $mode == password ]]; then
    [[ $security != nopass ]] || {
        echo "This network has no password" >&2
        exit 1
    }
    [[ -n $password ]] || {
        echo "Could not read the Wi-Fi password" >&2
        exit 1
    }
    printf '%s\n' "$password"
    exit 0
fi

[[ -n $ssid ]] || {
    echo "Could not read the Wi-Fi name" >&2
    exit 1
}
command -v qrencode >/dev/null 2>&1 || {
    echo "qrencode is not installed" >&2
    exit 1
}
[[ $security == nopass || -n $password ]] || {
    echo "Could not read the Wi-Fi password" >&2
    exit 1
}

escape_wifi_qr() {
    local value=$1
    value=${value//\\/\\\\}
    value=${value//;/\\;}
    value=${value//,/\\,}
    value=${value//:/\\:}
    printf '%s' "$value"
}

payload="WIFI:T:$security;S:$(escape_wifi_qr "$ssid");P:$(escape_wifi_qr "$password");"
[[ $hidden == "yes" ]] && payload+="H:true;"
payload+=";"

# ASCII uses two characters per module. Collapse each pair to one 0/1 value so
# the panel can render a square matrix directly with native QML rectangles.
# Margin 4 is the spec quiet zone; the card surround is dark, so this white
# border is all the scanner gets.
ascii=$(printf '%s' "$payload" | qrencode --type ASCII --margin 4 --output -)
while IFS= read -r line; do
    row=
    for ((column = 0; column < ${#line}; column += 2)); do
        [[ ${line:column:2} == *#* ]] && row+=1 || row+=0
    done
    printf '%s\n' "$row"
done <<<"$ascii"
