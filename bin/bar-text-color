#!/usr/bin/env python3
"""Choose a legible foreground for a transparent bar.

Port of omarchy's `omarchy-bar-text-color` (CREDITS.md), adapted:

  * Their script samples the wallpaper with ImageMagick and falls back to the
    text color when `magick` is missing.  Nothing in the ImageMagick family is
    installed here, so the strip is sampled with GdkPixbuf (present with GTK,
    handles png/jpeg/webp) and, failing that, with a `grim` screenshot of the
    bar region — which needs no image library at all because `grim -t ppm`
    writes raw RGB.
  * We know the wallpaper path (`~/.local/state/qshell/background` holds it,
    written by Modules/Background), so there is no symlink to resolve.
  * The screen size comes from `niri msg --json outputs` instead of hyprctl.

Their logic is otherwise unchanged: cover-fit the wallpaper to the screen,
crop the strip the bar covers, average it to one color, and print whichever of
the two candidate colors has the better WCAG contrast against it.  Any failure
prints the theme foreground, so the bar is never left unstyled.

Usage: bar-text-color POSITION BAR_SIZE TEXT_COLOR BACKGROUND_COLOR
                      [--background PATH] [--screen WxH]
"""

import json
import os
import re
import subprocess
import sys

HEX = re.compile(r"^#[0-9A-Fa-f]{6}$")
STATE = os.path.expanduser("~/.local/state/qshell")


def fail(text_color):
    print(text_color)
    sys.exit(0)


def parse_args(argv):
    if len(argv) < 4:
        print("#ffffff")
        sys.exit(0)
    position, bar_size, text_color, background_color = argv[0], argv[1], argv[2], argv[3]
    background_path = ""
    screen_size = ""
    rest = argv[4:]
    while rest:
        if rest[0] == "--background" and len(rest) > 1:
            background_path, rest = rest[1], rest[2:]
        elif rest[0] == "--screen" and len(rest) > 1:
            screen_size, rest = rest[1], rest[2:]
        else:
            rest = rest[1:]
    return position, bar_size, text_color, background_color, background_path, screen_size


def wallpaper_path():
    try:
        with open(os.path.join(STATE, "background")) as handle:
            return handle.read().strip()
    except OSError:
        return ""


def screen_size():
    try:
        raw = subprocess.run(["niri", "msg", "--json", "outputs"], capture_output=True,
                             text=True, timeout=4).stdout
        outputs = json.loads(raw)
    except Exception:
        return None
    for output in outputs.values() if isinstance(outputs, dict) else outputs:
        mode = (output.get("logical") or {})
        if mode.get("width") and mode.get("height"):
            return int(mode["width"]), int(mode["height"])
    return None


def linear(channel):
    c = channel / 255.0
    return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4


def luminance(rgb):
    r, g, b = (linear(v) for v in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    l1, l2 = luminance(a), luminance(b)
    if l1 < l2:
        l1, l2 = l2, l1
    return (l1 + 0.05) / (l2 + 0.05)


def hex_rgb(value):
    return (int(value[1:3], 16), int(value[3:5], 16), int(value[5:7], 16))


def strip_box(position, width, height, bar_size):
    """The screen rectangle the bar covers — their four crop cases."""
    if position == "bottom":
        return (0, max(0, height - bar_size), width, min(bar_size, height))
    if position == "left":
        return (0, 0, min(bar_size, width), height)
    if position == "right":
        return (max(0, width - bar_size), 0, min(bar_size, width), height)
    return (0, 0, width, min(bar_size, height))


def sample_pixbuf(path, width, height, box):
    """Cover-fit the wallpaper to the screen, then average the bar strip."""
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf

    pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
    src_w, src_h = pixbuf.get_width(), pixbuf.get_height()
    if src_w <= 0 or src_h <= 0:
        return None

    # `-resize WxH^ -gravity center -extent WxH`: scale to cover, center-crop.
    scale = max(width / src_w, height / src_h)
    scaled_w, scaled_h = max(1, round(src_w * scale)), max(1, round(src_h * scale))
    scaled = pixbuf.scale_simple(scaled_w, scaled_h, GdkPixbuf.InterpType.BILINEAR)
    off_x, off_y = (scaled_w - width) // 2, (scaled_h - height) // 2

    x, y, w, h = box
    crop_x = min(max(0, off_x + x), max(0, scaled_w - 1))
    crop_y = min(max(0, off_y + y), max(0, scaled_h - 1))
    crop_w = max(1, min(w, scaled_w - crop_x))
    crop_h = max(1, min(h, scaled_h - crop_y))
    strip = scaled.new_subpixbuf(crop_x, crop_y, crop_w, crop_h)
    return average_pixbuf(strip)


def average_pixbuf(pixbuf):
    data = pixbuf.get_pixels()
    stride, channels = pixbuf.get_rowstride(), pixbuf.get_n_channels()
    width, height = pixbuf.get_width(), pixbuf.get_height()
    totals, count = [0, 0, 0], 0
    # Sample at most ~64 columns and ~16 rows: a mean over the whole strip and
    # a mean over a grid of it agree to well within a contrast decision.
    xs = range(0, width, max(1, width // 64))
    ys = range(0, height, max(1, height // 16))
    for y in ys:
        row = y * stride
        for x in xs:
            base = row + x * channels
            totals[0] += data[base]
            totals[1] += data[base + 1]
            totals[2] += data[base + 2]
            count += 1
    if not count:
        return None
    return tuple(total // count for total in totals)


def sample_grim(box):
    """Last resort: screenshot the bar region. Always available, and it sees
    whatever is actually behind the bar rather than the wallpaper file."""
    x, y, w, h = box
    raw = subprocess.run(["grim", "-t", "ppm", "-g", f"{x},{y} {w}x{h}", "-"],
                         capture_output=True, timeout=6).stdout
    if not raw.startswith(b"P6"):
        return None
    # P6 header: magic, width, height, maxval — whitespace separated, '#' comments.
    fields, pos = [], 2
    while len(fields) < 3 and pos < len(raw):
        while pos < len(raw) and raw[pos:pos + 1].isspace():
            pos += 1
        if raw[pos:pos + 1] == b"#":
            while pos < len(raw) and raw[pos:pos + 1] != b"\n":
                pos += 1
            continue
        start = pos
        while pos < len(raw) and not raw[pos:pos + 1].isspace():
            pos += 1
        fields.append(int(raw[start:pos]))
    pos += 1
    pw, ph, maxval = fields
    if maxval != 255:
        return None
    pixels = raw[pos:]
    totals, count = [0, 0, 0], 0
    step = max(1, (pw * ph) // 4096)
    for i in range(0, pw * ph, step):
        base = i * 3
        if base + 2 >= len(pixels):
            break
        totals[0] += pixels[base]
        totals[1] += pixels[base + 1]
        totals[2] += pixels[base + 2]
        count += 1
    if not count:
        return None
    return tuple(total // count for total in totals)


def main():
    position, bar_size, text_color, background_color, background_path, screen = parse_args(sys.argv[1:])

    if not HEX.match(text_color or ""):
        print(text_color or "#ffffff")
        return
    if not HEX.match(background_color or "") or position not in ("top", "bottom", "left", "right") or not str(bar_size).isdigit():
        fail(text_color)
    bar_size = int(bar_size)
    if bar_size <= 0:
        fail(text_color)

    size = None
    if re.match(r"^\d+x\d+$", screen or ""):
        size = tuple(int(v) for v in screen.split("x"))
    if size is None:
        size = screen_size()
    if not size or size[0] <= 0 or size[1] <= 0:
        fail(text_color)
    box = strip_box(position, size[0], size[1], bar_size)

    if not background_path:
        background_path = wallpaper_path()

    sample = None
    if background_path and os.path.isfile(background_path):
        try:
            sample = sample_pixbuf(background_path, size[0], size[1], box)
        except Exception:
            sample = None
    if sample is None:
        try:
            sample = sample_grim(box)
        except Exception:
            sample = None
    if sample is None:
        fail(text_color)

    text_contrast = contrast(hex_rgb(text_color), sample)
    background_contrast = contrast(hex_rgb(background_color), sample)
    print(background_color if background_contrast > text_contrast else text_color)


if __name__ == "__main__":
    main()
