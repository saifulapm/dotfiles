#!/bin/bash
# clipboard-capture — record clipboard selections as JSON entries.
#
# Direct port of omarchy's shell/plugins/clipboard/capture.sh (MIT, see
# CREDITS.md). Theirs is only the emitter: their Clipboard.qml owns three
# Process objects (one snapshot run, one `wl-paste --type text --watch`, one
# `--type image/png --watch`) that invoke the script. Ours folds the two
# watchers into a `watch` mode so the shell supervises a single persistent
# Process, but the emitter below — the sensitive-selection guard, the
# content-addressed image spill, the `{type,text}` / `{type,mime,path,capturedAt}`
# JSON shapes — is theirs.
#
# Modes:
#   clipboard-capture watch      run the wl-paste watchers, one JSON line per
#                                selection on stdout, until killed
#   clipboard-capture            snapshot the current selection, emit one line
#   clipboard-capture text       emit stdin as a text entry   (called by wl-paste)
#   clipboard-capture image/png  emit stdin as an image entry (called by wl-paste)
#
# Nothing here polls: wl-paste --watch blocks on the Wayland data-device
# protocol and only wakes when a selection actually changes.

set -o pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/qshell/clipboard"
IMAGE_DIR="$STATE_DIR/images"
LOCK_FILE="$STATE_DIR/.emit.lock"
mkdir -p "$IMAGE_DIR"

# wl-paste re-invokes this by path, so it has to be absolute no matter how the
# watch mode was started.
SELF=$(readlink -f "$0")

# ------------------------------------------------------------------ watch mode
# Two watchers share this script's stdout, so each line is written under a lock:
# a jq object bigger than the pipe buffer would otherwise interleave with the
# other watcher's. setpriv --pdeathsig kills a watcher if this script is killed
# outright; the traps cover the ordinary SIGTERM from the shell (bash skips the
# EXIT trap on a signal unless the signal is trapped too).
if [[ ${1:-} == "watch" ]]; then
    pids=()

    cleanup() {
        local pid
        for pid in "${pids[@]}"; do
            kill "$pid" 2>/dev/null || true
        done
    }

    trap 'exit 143' TERM INT HUP
    trap cleanup EXIT

    # Reap watchers stranded by a previous shell instance before starting ours,
    # or every restart would double up the capture.
    pkill -f "wl-paste --type .* --watch $SELF " 2>/dev/null || true

    setpriv --pdeathsig TERM wl-paste --type text --watch "$SELF" text &
    pids+=("$!")
    setpriv --pdeathsig TERM wl-paste --type image/png --watch "$SELF" image/png &
    pids+=("$!")

    # First child death ends the watch run. A bare `wait` would idle until
    # BOTH watchers were gone, leaving one capture type silently unrecorded —
    # the shell's supervision (Clipboard.qml) restarts this script only when
    # it exits, so exiting is what heals: the EXIT trap takes the survivor
    # down and the restarted run brings both watchers back.
    wait -n
    exit 1
fi

# ---------------------------------------------------------------- privacy gate
# Password managers mark their offer with the KDE hint, and wl-paste exports
# CLIPBOARD_STATE=sensitive for the same class of selection. Either one means
# the entry never reaches the history file.
types=$(wl-paste --list-types 2>/dev/null || true)

if [[ ${CLIPBOARD_STATE:-} == "sensitive" ]] || grep -qx 'x-kde-passwordManagerHint' <<<"$types"; then
    exit 0
fi

emit() {
    local line
    line=$(cat)
    [[ -n $line ]] || return 0
    (
        flock 9
        printf '%s\n' "$line"
    ) 9>"$LOCK_FILE"
}

# Images are spilled to disk under the hash of their bytes, so re-copying the
# same picture reuses the file instead of growing the store.
emit_image() {
    local mime="$1"
    local ext tmp hash file

    ext=${mime#image/}
    [[ $ext == jpeg ]] && ext=jpg

    tmp=$(mktemp --tmpdir="$IMAGE_DIR" clipboard.XXXXXX) || return 0
    cat >"$tmp"
    if [[ ! -s $tmp ]]; then
        rm -f "$tmp"
        return 0
    fi

    hash=$(sha256sum "$tmp" | awk '{print $1}')
    file="$IMAGE_DIR/$hash.$ext"
    if [[ -e $file ]]; then
        rm -f "$tmp"
    else
        mv "$tmp" "$file"
    fi

    jq -cn --arg mime "$mime" --arg path "$file" --arg captured_at "$(date +'%A %H:%M')" \
        '{type:"image", mime:$mime, path:$path, capturedAt:$captured_at}' | emit
}

emit_text() {
    jq -cRs 'select(length > 0) | {type:"text", text:.}' | emit
}

case "${1:-}" in
text)
    emit_text
    exit 0
    ;;
image/*)
    emit_image "$1"
    exit 0
    ;;
esac

# No argument: snapshot whatever is on the clipboard right now.
for mime in image/png image/jpeg image/webp image/gif image/bmp image/tiff; do
    if grep -qx "$mime" <<<"$types"; then
        timeout 2s wl-paste --type "$mime" 2>/dev/null | emit_image "$mime"
        exit 0
    fi
done

if grep -q '^text/' <<<"$types" || grep -qx 'UTF8_STRING' <<<"$types" || grep -qx 'STRING' <<<"$types"; then
    wl-paste --type text --no-newline 2>/dev/null | emit_text
fi
