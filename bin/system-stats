#!/bin/bash
#
# system-stats — one snapshot of the machine's live vitals, as key<TAB>value
# lines. Port of omarchy's `omarchy-system-stats` (CREDITS.md), extended with
# the battery facts UPower does not expose and the availability of
# power-profiles-daemon, so the power panel needs exactly one process per
# sample.
#
# Keys:
#   cpu                busy percentage over the sample window
#   memory             used / total, GB
#   load               1 / 5 / 15 minute load averages
#   temperature        best available temperature reading
#   temperature_label  what that reading is measuring
#   cycles             battery charge cycles
#   threshold          charge limit, "N%" or "start-end%"
#   health             battery health as the kernel reports it
#   power_profiles     available | missing
#
# Every key is optional: a machine that cannot answer one simply omits it.

set -uo pipefail

power_supply_path="${QSHELL_POWER_SUPPLY_PATH:-/sys/class/power_supply}"
hwmon_path="${QSHELL_HWMON_PATH:-/sys/class/hwmon}"
thermal_path="${QSHELL_THERMAL_PATH:-/sys/class/thermal}"

# ---------------------------------------------------------------------- cpu
# omarchy reads `top -bn1`, whose first iteration reports the average since
# boot rather than the load right now. Their bar widget samples /proc/stat
# from the shell instead and deltas it; this does the same sampling inside one
# process, so the number is the busy share of a real window.
cpu_stats() {
    local prev_idle prev_total idle total
    read -r prev_idle prev_total < <(proc_stat_sample)
    sleep 0.2
    read -r idle total < <(proc_stat_sample)

    awk -v pi="$prev_idle" -v pt="$prev_total" -v i="$idle" -v t="$total" 'BEGIN {
    dt = t - pt
    if (dt <= 0) exit
    printf "cpu\t%.0f%%\n", (1 - (i - pi) / dt) * 100
  }'
}

proc_stat_sample() {
    awk 'NR == 1 {
    idle = $5 + $6
    total = 0
    for (i = 2; i <= NF; i++) total += $i
    print idle, total
    exit
  }' /proc/stat
}

# ------------------------------------------------------------------- memory
memory_stats() {
    awk '
    /^MemTotal:/ { total = $2 }
    /^MemAvailable:/ { avail = $2 }
    END {
      if (total <= 0) exit
      used = total - avail
      printf "memory\t%.1fGB / %.0fGB\n", used / 1024 / 1024, total / 1024 / 1024
    }
  ' /proc/meminfo
}

# --------------------------------------------------------------------- load
load_stats() {
    awk '{ printf "load\t%s %s %s\n", $1, $2, $3 }' /proc/loadavg
}

# -------------------------------------------------------------- temperature
# Prefer a CPU/SoC sensor, then a labelled hwmon reading, then any thermal
# zone. The label travels with the value because on some machines (Apple
# silicon among them) no CPU sensor is exposed at all and the honest answer is
# whatever the reading actually measures.
temperature_stats() {
    local file label

    for chip in "$hwmon_path"/hwmon*; do
        [[ -r $chip/name ]] || continue
        case "$(<"$chip/name")" in
        coretemp | k10temp | zenpower | cpu_thermal | soc_thermal | acpitz)
            for input in "$chip"/temp*_input; do
                [[ -r $input ]] || continue
                file=$input
                label=$(sensor_label "$input" "CPU")
                emit_temperature "$file" "$label"
                return
            done
            ;;
        esac
    done

    for zone in "$thermal_path"/thermal_zone*; do
        [[ -r $zone/type && -r $zone/temp ]] || continue
        case "$(<"$zone/type")" in
        *cpu* | *CPU* | *soc* | *pkg*)
            emit_temperature "$zone/temp" "CPU"
            return
            ;;
        esac
    done

    # No CPU sensor (Apple silicon exposes none). Report the warmest labelled
    # reading the machine does publish, and say what it is.
    local hottest_file="" hottest_label="" hottest_value=""
    for chip in "$hwmon_path"/hwmon*; do
        for input in "$chip"/temp*_input; do
            [[ -r $input ]] || continue
            label=$(sensor_label "$input" "")
            [[ -n $label ]] || continue
            local value
            value=$(<"$input") || continue
            [[ $value =~ ^-?[0-9]+$ ]] || continue
            if [[ -z $hottest_value ]] || ((value > hottest_value)); then
                hottest_file=$input
                hottest_label=$label
                hottest_value=$value
            fi
        done
    done
    if [[ -n $hottest_file ]]; then
        emit_temperature "$hottest_file" "$hottest_label"
        return
    fi

    for zone in "$thermal_path"/thermal_zone*; do
        [[ -r $zone/type && -r $zone/temp ]] || continue
        emit_temperature "$zone/temp" "$(<"$zone/type")"
        return
    done
}

sensor_label() {
    local label_file="${1%_input}_label"
    if [[ -r $label_file ]]; then
        cat "$label_file"
    else
        printf '%s' "$2"
    fi
}

emit_temperature() {
    local raw
    raw=$(<"$1") || return
    [[ $raw =~ ^-?[0-9]+$ ]] || return
    awk -v raw="$raw" -v label="$2" 'BEGIN {
    printf "temperature\t%.1f°C\n", raw / 1000
    if (label != "") printf "temperature_label\t%s\n", label
  }'
}

# ------------------------------------------------------------------ battery
# The panel takes percentage, state, rate, capacity and time-remaining from
# UPower directly. These are the fields it does not publish.
battery_stats() {
    local battery cycles start end health
    for candidate in "$power_supply_path"/*; do
        [[ -r $candidate/type ]] || continue
        [[ $(<"$candidate/type") == "Battery" ]] || continue
        [[ -r $candidate/present && $(<"$candidate/present") == "1" ]] || continue
        battery=$candidate
        break
    done
    [[ -n ${battery:-} ]] || return

    cycles=$(read_or_empty "$battery/cycle_count")
    [[ -n $cycles && $cycles != "0" ]] && printf 'cycles\t%s\n' "$cycles"

    start=$(read_or_empty "$battery/charge_control_start_threshold")
    end=$(read_or_empty "$battery/charge_control_end_threshold")
    if [[ -n $end ]]; then
        if [[ -n $start && $start != "$end" ]]; then
            printf 'threshold\t%s-%s%%\n' "$start" "$end"
        else
            printf 'threshold\t%s%%\n' "$end"
        fi
    fi

    health=$(read_or_empty "$battery/health")
    [[ -n $health ]] && printf 'health\t%s\n' "$health"
}

read_or_empty() {
    [[ -r $1 ]] || return 0
    tr -d '[:space:]' <"$1"
}

# ----------------------------------------------------------------- profiles
# power-profiles-daemon ships the only client that can switch profiles; with
# it absent the panel says so rather than offering dead buttons.
profile_availability() {
    if command -v powerprofilesctl >/dev/null 2>&1; then
        printf 'power_profiles\tavailable\n'
    else
        printf 'power_profiles\tmissing\n'
    fi
}

case "${1:-}" in
"") ;;
*)
    echo "Usage: system-stats" >&2
    exit 1
    ;;
esac

cpu_stats
memory_stats
load_stats
temperature_stats
battery_stats
profile_availability
