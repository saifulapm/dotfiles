#!/usr/bin/env bash
# crash-watch — announce process crashes and offer an AI diagnosis.
#
# Port of omarchy's bin/omarchy-crash-watch. systemd-coredump is
# already this machine's core_pattern handler, and it journals every dump under
# a known MESSAGE_ID with structured COREDUMP_* fields — richer than the core
# filenames, and readable without touching the cores themselves.
#
# Runs as crash-watch.service. bin/crash-diagnose is what a click opens.
set -uo pipefail

# See systemd.journal-fields(7).
readonly COREDUMP_MESSAGE_ID=fc2e22bc6ee647b6b90729ab34a250b1

# nf-md-robot_dead, escaped so this file reads without a Nerd Font.
readonly CRASH_GLYPH=$'\U000f16a1'

# Crash loops dump core repeatedly, so announce each program at most once a
# window.
readonly dedupe_seconds=${QSHELL_CRASH_DEDUPE_SECONDS:-60}

# Extended regex of process NAMES never worth announcing. Upstream's only
# filter; kept, but it is not the one that matters here — see ignore_prefix.
readonly ignore_pattern=${QSHELL_CRASH_IGNORE:-}

# OURS, and the reason this service is usable on a development machine at all:
# a crash in a binary you are actively building is not news. Measured before
# writing this — of 45 coredumps in one day here, 44 were debug builds under
# ~/Sites (43 of them one Rust binary mid-refactor) and exactly one was a real
# event (/usr/bin/bash, SIGSEGV). Upstream filters on process name, which would
# mean naming every binary you ever build; the path is what actually separates
# "my own work in progress" from "something on this system broke".
#
# Set QSHELL_CRASH_IGNORE_PREFIX= (empty) to hear about your own builds too.
readonly ignore_prefix=${QSHELL_CRASH_IGNORE_PREFIX-$HOME/Sites}

# Per-program mutes, written by bin/crash-mute. A directory of flag files
# rather than one list: presence IS the state, the same shape the stay-awake
# and crash-capture toggles use, so `ls` reads the set and `rm` un-mutes.
readonly mute_dir="${XDG_STATE_HOME:-$HOME/.local/state}/qshell/crash-ignore"

declare -A last_notified

# The shell owns org.freedesktop.Notifications, so a shell crash takes the
# notification server down with it and a toast sent into that gap is lost. Wait
# for the restarted shell to claim the name again: the crash least likely to be
# delivered is the one most worth reporting. (Upstream splits this into
# omarchy-notification-wait; it has one caller, so it lives here.)
notification_server_ready() {
  local attempts=$((10 * 10))
  while ((attempts > 0)); do
    if qs ipc call notifs status >/dev/null 2>&1 &&
      busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications \
        org.freedesktop.Notifications GetServerInformation >/dev/null 2>&1; then
      return 0
    fi
    attempts=$((attempts - 1))
    sleep 0.1
  done
  return 1
}

# The click action rides along as a JSON argv (Notifs.runExecAction runs it as
# bash positional parameters, never a shell string), so a value out of the
# journal is only ever one argument no matter what is in it.
exec_argv_hint() {
  printf -- '--hint=string:qshell-exec-argv:%s' "$(jq -cn '$ARGS.positional' --args -- "$@")"
}

announce() {
  local comm=$1 pid=$2 exe=$3 signal=$4

  notification_server_ready || return 1

  # -a Crash, not -a qshell: NotificationLogic.isEphemeralApp keeps "qshell"
  # and bare "notify-send" out of the history buckets entirely, and a crash you
  # were away for is exactly the one you want to find later — the row stays
  # clickable in the notification centre (same argv runs).
  #
  # Deliberate deviation from upstream: they send this under the one app name
  # shouldBypassDnd() lets through, so a crash interrupts Do Not Disturb. Ours
  # does not. DND here is an explicit "not now", a crash is diagnosable just as
  # well ten minutes later, and the history row means nothing is lost by
  # waiting. Critical urgency still gives it the long on-screen life.
  #
  # `--` before the summary: comm comes from the journal, and a process named
  # with a leading dash would otherwise reach notify-send's option parser.
  notify-send -a Crash --urgency=critical \
    "$(exec_argv_hint "$HOME/.dotfiles/bin/crash-diagnose" "$pid" "$comm" "$exe" "$signal")" \
    -- "$CRASH_GLYPH Process crashed: $comm" \
    "Click to diagnose with AI" >/dev/null 2>&1
}

# -n 0 so a restart does not re-announce crashes already dealt with.
journalctl -f -n 0 -o json "MESSAGE_ID=$COREDUMP_MESSAGE_ID" 2>/dev/null |
  while IFS= read -r entry; do
    IFS=$'\t' read -r uid comm pid exe signal < <(
      jq -r '[(._UID // "-"),
              (.COREDUMP_COMM // "-"),
              (.COREDUMP_PID // "-"),
              (.COREDUMP_EXE // "-"),
              (.COREDUMP_SIGNAL_NAME // "-")] | @tsv' <<<"$entry" 2>/dev/null
    )

    [[ $pid =~ ^[0-9]+$ ]] || continue

    # Only this user's crashes; a daemon dumping core is a sysadmin's problem.
    [[ $uid =~ ^[0-9]+$ ]] || continue
    ((uid == UID)) || continue

    # comm is truncated to 15 characters, so prefer the executable's basename.
    name=$comm
    [[ $exe == /* ]] && name=${exe##*/}

    # A process can set its own comm to anything prctl takes, SLASHES INCLUDED,
    # and a crash with no recorded executable falls back to it. The mute below
    # turns this name into a path, so keep it to one component: a crash must
    # never reach a flag outside crash-ignore/, nor have anything write one
    # there. What that leaves is not always a name — "/" leaves nothing, and a
    # dot component names a directory rather than a flag, so a mute on it would
    # touch that directory and then never match.
    name=${name##*/}
    [[ -n $name && $name != "." && $name != ".." ]] || name=unknown

    # Muted by hand, or from the end of a diagnosis. A flag file per program
    # rather than one list, so it is the same "presence IS the state" shape as
    # the stay-awake and capture toggles, and `ls` reads the whole set.
    [[ -e "$mute_dir/$name" ]] && continue

    [[ -n $ignore_prefix && $exe == "$ignore_prefix"/* ]] && continue
    [[ -n $ignore_pattern && $name =~ $ignore_pattern ]] && continue

    # Never announce our own machinery, or it notifies about itself.
    [[ $name == crash-watch || $name == crash-diagnose ]] && continue

    now=$EPOCHSECONDS
    (((now - ${last_notified[$name]:-0}) < dedupe_seconds)) && continue

    # Only a delivered toast starts the dedupe window. A failed send that
    # counted would suppress the rest of a crash loop for a minute, and
    # `journalctl -n 0` never replays what was missed.
    announce "$name" "$pid" "$exe" "$signal" && last_notified[$name]=$now
  done
