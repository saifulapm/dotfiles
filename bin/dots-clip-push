#!/usr/bin/env bash
# dots-clip-push: what dots-clip-sync.service's wl-paste --watch runs on each copy; posts the text to every online Linux machine on the tailnet, marked as a relay so none of them passes it on again.
set -uo pipefail
{

runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
last=$runtime/dots-clip-sync.last
max_bytes=1048576

tmp=$(mktemp -p "$runtime" dots-clip-push.XXXXXX) || exit 0
trap 'rm -f "$tmp"' EXIT
# An owner that stalls would hold the watcher, so the read is bounded and a copy cut off is dropped.
timeout 2s cat >"$tmp" || exit 0

[[ -s $tmp ]] || exit 0
(($(stat -c %s "$tmp") <= max_bytes)) || exit 0
[[ ${CLIPBOARD_STATE:-} == sensitive ]] && exit 0
timeout 2s wl-paste --list-types 2>/dev/null | grep -qx 'x-kde-passwordManagerHint' && exit 0

# The copy dots-clip-serve just received from a peer.
cmp -s "$tmp" "$last" 2>/dev/null && exit 0
cp "$tmp" "$last" 2>/dev/null || true

# Every machine runs this setup, so the tailnet's online Linux nodes are the peers, this one excluded.
peers=$(tailscale status --json 2>/dev/null | jq -r '.Peer[]? | select(.OS == "linux" and .Online) | .DNSName' 2>/dev/null) || peers=""
for peer in $peers; do
  # A peer going down mid-push is normal, so nothing waits on it or reports it.
  curl -s -o /dev/null --connect-timeout 1 --max-time 5 -H 'Content-Type: text/plain; charset=utf-8' -H 'X-Clipboard-Relay: 1' --data-binary @"$tmp" "http://${peer%.}/" &
done
# The posts read the file the trap removes.
wait
exit
}
