#!/usr/bin/env bash
# default-agent — read or set the coding agent bin/launch-agent starts.
#
#   default-agent            print the current default
#   default-agent claude     make Claude Code the default
#   default-agent --list     every agent this knows, with what is installed
#
# Port of omarchy's omarchy-default-agent (CREDITS.md), minus its installer.
# Theirs installs a missing agent through `mise use -g` and relaunches into a
# floating terminal; ours only ever SELECTS among what is already here. Agent
# CLIs are installed by run_onchange_after_04-agent-clis.sh, declared one by
# one in packages/manifest.toml, and their logins are interactive — a menu row
# is not the place to acquire a new one.
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/qshell"
agent_file="$state_dir/default-agent"

# The agents upstream supports, in their order. The four at the front are the
# ones packages/manifest.toml installs here; the rest are carried so a machine
# that grows one picks it up without an edit.
KNOWN=(claude codex copilot pi opencode gemini crush grok omp)

# Their spelling of an agent's name, for messages.
agent_name() {
  case "$1" in
  claude) echo "Claude Code" ;;
  codex) echo "Codex" ;;
  copilot) echo "GitHub Copilot" ;;
  pi) echo "Pi" ;;
  omp) echo "Oh My Pi" ;;
  opencode) echo "OpenCode" ;;
  gemini) echo "Gemini" ;;
  crush) echo "Crush" ;;
  grok) echo "Grok" ;;
  *) echo "$1" ;;
  esac
}

# The stored choice if it is still installed, else the first installed agent —
# so removing the default agent degrades to a working one instead of an error
# at every launch. Falls back to claude, which is what this machine leads with.
current_agent() {
  local stored=""
  [[ -f $agent_file ]] && read -r stored <"$agent_file" 2>/dev/null || true

  if [[ -n $stored ]] && command -v "$stored" >/dev/null 2>&1; then
    printf '%s\n' "$stored"
    return
  fi

  local agent
  for agent in "${KNOWN[@]}"; do
    if command -v "$agent" >/dev/null 2>&1; then
      printf '%s\n' "$agent"
      return
    fi
  done

  printf '%s\n' "claude"
}

case "${1:-}" in
"")
  current_agent
  exit 0
  ;;
--list)
  current="$(current_agent)"
  for agent in "${KNOWN[@]}"; do
    marker=" "
    [[ $agent == "$current" ]] && marker="*"
    if command -v "$agent" >/dev/null 2>&1; then
      printf '%s %-9s %s\n' "$marker" "$agent" "$(agent_name "$agent")"
    else
      printf '%s %-9s %s (not installed)\n' "$marker" "$agent" "$(agent_name "$agent")"
    fi
  done
  exit 0
  ;;
-h | --help)
  printf 'usage: default-agent [%s|--list]\n' "$(
    IFS='|'
    echo "${KNOWN[*]}"
  )"
  exit 0
  ;;
esac

# Upstream accepts a few aliases per agent; keep the ones that name the same
# binary differently.
case "$1" in
claude | claude-code) agent="claude" ;;
codex) agent="codex" ;;
copilot | github-copilot) agent="copilot" ;;
pi) agent="pi" ;;
omp | oh-my-pi) agent="omp" ;;
opencode | open-code) agent="opencode" ;;
gemini | gemini-cli) agent="gemini" ;;
crush) agent="crush" ;;
grok) agent="grok" ;;
*)
  echo "default-agent: unknown agent $1" >&2
  printf 'usage: default-agent [%s|--list]\n' "$(
    IFS='|'
    echo "${KNOWN[*]}"
  )" >&2
  exit 1
  ;;
esac

if ! command -v "$agent" >/dev/null 2>&1; then
  echo "default-agent: $(agent_name "$agent") is not installed — see packages/manifest.toml" >&2
  exit 1
fi

mkdir -p "$state_dir"
printf '%s\n' "$agent" >"$agent_file"
echo "$(agent_name "$agent") is now the default coding agent"
