#!/usr/bin/env bash
# timezone-offsets — what the clock reads in other places, as TSV.
#
#   timezone-offsets [zone ...]
#
#   zone<TAB>offsetSeconds<TAB>abbrev<TAB>nextTransitionEpoch
#
# With no arguments it reports the system zone alone. offsetSeconds is signed
# and relative to UTC; abbrev is the zone's current short name ("EDT", "BST",
# or a numeric "+06" where tzdata has no letters for it); nextTransitionEpoch
# is when that offset next changes, or 0 for a zone with no DST ahead of it.
#
# WHY THIS EXISTS AT ALL, rather than the two lines of Intl.DateTimeFormat
# this would be in a browser: Quickshell's QML engine has no ECMA-402.
# `Intl is not defined` — measured 2026-08-21 by running the probe inside the
# real engine, not assumed from Qt's ICU linkage, which is present and
# irrelevant. So the offsets have to come from outside the shell, and this is
# the outside.
#
# The transition column is what keeps the widget honest without polling. A
# cached offset goes wrong exactly twice a year per zone, and knowing when
# means the shell can schedule a single one-shot re-read for that moment
# instead of asking again every minute forever.
set -uo pipefail

zones=("$@")
if [ ${#zones[@]} -eq 0 ]; then
  zones=("$(timedatectl show -p Timezone --value 2>/dev/null || cat /etc/timezone 2>/dev/null)")
fi

now="$(date +%s)"

# ±HHMM -> seconds. `date +%z` is the only portable source for the CURRENT
# offset, and it is deliberately preferred over the gmtoff of the last zdump
# transition: they agree, and this one cannot be thrown off by a zone whose
# transition list is empty.
offset_seconds() {
  local z="$1" raw sign hours minutes
  raw="$(TZ="$z" date +%z 2>/dev/null)"
  [[ $raw =~ ^([+-])([0-9]{2})([0-9]{2})$ ]] || { echo 0; return; }
  sign="${BASH_REMATCH[1]}"
  hours="${BASH_REMATCH[2]}"
  minutes="${BASH_REMATCH[3]}"
  # 10# forces base 10: "08" and "09" are invalid octal and would error out.
  local total=$((10#$hours * 3600 + 10#$minutes * 60))
  [ "$sign" = "-" ] && total=$((-total))
  echo "$total"
}

# The first UT instant after now at which this zone's offset changes, or 0.
#
# zdump -v prints every transition in the range, as
#   <zone>  <UT time> UT = <local time> <ABBR> isdst=N gmtoff=N
# plus SENTINEL rows at both extremes of representable time, and those are the
# whole difficulty here. The lower one has a year `date` cannot parse
# ("-2147481748") and prints "(gmtime failed)", so a grep removes it. The
# UPPER one parses perfectly well — into epoch 67768036191655199, the year
# 2147485547 — and it is emitted for every zone including the ones with no
# DST at all. Left unbounded, Asia/Dhaka and UTC therefore reported a "next
# transition" 2.1 billion years out (observed 2026-08-21) instead of the
# honest zero.
#
# So the answer is bounded by the window actually asked for: a transition
# after the end of the zdump range is not a transition, it is the sentinel.
next_transition() {
  local z="$1" year horizon line ut epoch
  year="$(date +%Y)"
  # Three years is enough to always contain the next boundary — a zone
  # changes at most twice a year, and one that has not changed in three is
  # not about to.
  horizon="$(date -u -d "$((year + 3))-01-01" +%s 2>/dev/null)" || horizon=0
  while read -r line; do
    ut="$(sed -E 's/^[^ ]+ +(.*) UT = .*/\1/' <<<"$line")"
    [ -n "$ut" ] || continue
    epoch="$(date -u -d "$ut" +%s 2>/dev/null)" || continue
    [ -n "$epoch" ] || continue
    if [ "$epoch" -gt "$now" ] && { [ "$horizon" -eq 0 ] || [ "$epoch" -le "$horizon" ]; }; then
      echo "$epoch"
      return
    fi
  done < <(zdump -v "$z" -c "$year,$((year + 3))" 2>/dev/null | grep 'gmtoff=' | grep -v 'failed')
  echo 0
}

for zone in "${zones[@]}"; do
  [ -n "$zone" ] || continue
  # A zone name is used as a path below and comes from a config file, so it
  # is validated against the tzdata tree rather than trusted. This also
  # rejects the "../.." shapes that would otherwise reach outside it.
  case "$zone" in
  */../* | ../* | */.. | /*) continue ;;
  esac
  [ -f "/usr/share/zoneinfo/$zone" ] || {
    echo "timezone-offsets: unknown zone: $zone" >&2
    continue
  }
  printf '%s\t%s\t%s\t%s\n' \
    "$zone" \
    "$(offset_seconds "$zone")" \
    "$(TZ="$zone" date +%Z 2>/dev/null)" \
    "$(next_transition "$zone")"
done
