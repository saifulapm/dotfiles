#!/usr/bin/env bash
# hub-local's ExecStartPre: once tailscale runs, it serves this machine's local hub on port 8789 of its tailnet address, so the phone and the other machines reach it. tailscaled keeps the serve in its own state, so one success holds across reboots; a machine not logged in yet gives up after a minute, so the hub starts without it, and the first hub start after `tailscale up` serves.
set -uo pipefail
{
for _ in $(seq 30); do
  if [[ $(tailscale status --json 2>/dev/null | jq -r .BackendState 2>/dev/null) == Running ]]; then
    # Handed to the hub on loopback by tailscaled itself: no firewall rule and no root, since the user is tailscale's operator.
    tailscale serve --bg --tcp 8789 tcp://localhost:8789 >/dev/null ||
      echo "dots-hub-serve: tailscale serve --tcp 8789 failed; other machines cannot reach this hub" >&2
    exit 0
  fi
  sleep "${DOTS_HUB_SERVE_INTERVAL:-2}"
done
echo "dots-hub-serve: tailscale is not running, so other machines cannot reach this hub until its next start" >&2
exit 0
}
