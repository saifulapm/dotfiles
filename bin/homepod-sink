#!/bin/bash
# homepod-sink — host the Office HomePod RAOP sink in its OWN pipewire
# process, attached to the session daemon as a client (the filter-chain /
# aes67 pattern from /usr/share/pipewire).
#
# Why not a pipewire.conf.d fragment: the RAOP module hard-codes raop.ip,
# the HomePod has no DHCP reservation (its lease has already drifted
# .50 <-> .51), and a failed RTSP session makes the module destroy itself.
# Baked into the main daemon, every repair for either meant restarting
# pipewire — killing whatever was playing. Hosted here, a repair is a
# restart of THIS unit alone; the daemon and every running stream stay
# untouched. (This replaces the old audio-heal timer, whose restarts and
# cycles were the interruption, not the cure.)
#
# Flow: resolve the HomePod's current IP — last-known first, then a
# port-7000 sweep of the office /22, each hit verified by unicast mDNS,
# because the eCommerceStaff AP filters multicast so avahi/raop-discover
# can never see it — write a runtime config, start pipewire -c on it, then
# watch. If the child dies (bad IP at load) or the sink drops out of the
# session daemon (module self-destructed after a failed session), exit and
# let Restart= start us over with a fresh resolve. Two consecutive missing
# checks are required so one flaky pw-dump can't kill a sink mid-song.
#
# Log level (2026-09-15): the child runs at 2 (warn), which is the level the
# module's own generic failures land at — the RTSP connection errors it prints
# as `mod.raop-sink: error -32`, the timestamp mismatches. What it does NOT
# carry is any request's status: `record status`, `announce status`,
# `setup status` and `teardown status` are all pw_log_info, so a HomePod that
# answers a resume with anything but 200 leaves no trace at level 2 — the only
# visible result is a sink that exists and plays nothing. Level 3 (info) adds
# the whole RTSP transcript, which is the only thing that tells those apart
# after the fact. It also logs a line per /feedback POST (every 2 s while
# recording), so it is an opt-in for a capture, never the resting state: put
# `RAOP_LOG_LEVEL=3` in the user manager environment (`systemctl --user
# set-environment RAOP_LOG_LEVEL=3`), restart this unit, reproduce, then unset
# and restart. Nothing in this file changes; the unit passes the manager's
# environment through to the script.
#
# User-Agent (2026-10-17): the HomePod on software 27.0 answers the very
# first RTSP OPTIONS with 403 unless the User-Agent is an Apple sender's —
# `iTunes/<ver>` or `AirPlay/<ver>`, and the version is checked too
# (AirPlay/409.16 passes, AirPlay/409.160 and AirPlay/1.0 are refused). The
# module hard-codes `PipeWire/<version>` with no property to override it, so
# the child loads a copy with that string swapped, in place, for an accepted
# one of the same length, from a private module dir. It is rebuilt on every
# start, so a pipewire update is picked up by the next restart.

set -uo pipefail

RAOP_ID="22613DB70BF7" # the Office HomePod's id in its _raop._tcp name
DESC="HomePod (Office)"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/homepod-sink"
CONF="${XDG_RUNTIME_DIR:-/tmp}/homepod-raop.conf"
LOG_LEVEL="${RAOP_LOG_LEVEL:-2}"
SYS_MODS=/usr/lib64/pipewire-0.3
MODS="${XDG_RUNTIME_DIR:-/tmp}/homepod-modules"
mkdir -p "$STATE"

is_office() {
    dig +short +time=1 +tries=1 @"$1" -p 5353 _raop._tcp.local PTR 2>/dev/null \
        | grep -q "$RAOP_ID"
}

# Only ever probe the office Deco range, and only while we hold an address
# in it — sweeping 192.168.68.0/22 from some other network would probe a
# LAN that isn't ours.
on_office_lan() {
    ip -4 addr show 2>/dev/null | grep -qE 'inet 192\.168\.(68|69|70|71)\.'
}

resolve() {
    local last="" ip base cand
    [[ -f "$STATE/ip" ]] && last=$(<"$STATE/ip")
    for ip in $last 192.168.68.50 192.168.68.51; do
        is_office "$ip" && { echo "$ip"; return 0; }
    done
    # Sweep the /22 for port 7000, at most once per 10 min so a HomePod
    # that is simply unplugged does not get the LAN probed all day.
    if [[ -f "$STATE/last-scan" ]] \
        && (($(date +%s) - $(stat -c %Y "$STATE/last-scan") < 600)); then
        return 1
    fi
    touch "$STATE/last-scan"
    for base in 192.168.68 192.168.69 192.168.70 192.168.71; do
        while read -r cand; do
            is_office "$cand" && { echo "$cand"; return 0; }
        done < <(seq 1 254 | xargs -P 64 -I{} bash -c \
            "timeout 0.3 bash -c 'echo > /dev/tcp/$base.{}/7000' 2>/dev/null && echo $base.{}")
    done
    return 1
}

# Build $MODS: symlinks to every system module, except raop-sink, which is
# a copy with its User-Agent swapped. Each replacement was tested against
# the HomePod.
patch_raop() {
    local so="$SYS_MODS/libpipewire-module-raop-sink.so" ua rep
    ua=$(grep -ao 'PipeWire/[0-9][0-9.]*' "$so" | head -1)
    case ${#ua} in
        14) rep="AirPlay/409.16" ;;
        15) rep="AirPlay/620.8.2" ;;
        16) rep="AirPlay/409.16.1" ;;
        *) return 1 ;;
    esac
    rm -rf "$MODS" && mkdir -p "$MODS" || return 1
    ln -s "$SYS_MODS"/*.so "$MODS"/
    rm "$MODS/libpipewire-module-raop-sink.so"
    sed "s|$ua|$rep|" "$so" >"$MODS/libpipewire-module-raop-sink.so"
    grep -aq "$rep" "$MODS/libpipewire-module-raop-sink.so"
}

sink_present() {
    pw-dump 2>/dev/null | jq -e --arg d "$DESC" '
        [.[] | select(.type == "PipeWire:Interface:Node"
                      and (.info.props["node.description"] // "") == $d)]
        | length > 0' >/dev/null 2>&1
}

if ! on_office_lan; then
    echo "not on the office LAN — rechecking in 30 min"
    sleep 1800
    exit 0
fi

if ! ip=$(resolve); then
    echo "HomePod not found (off or unplugged?) — retrying via Restart="
    sleep 240 # with RestartSec=60 this paces the quiet retry to ~5 min
    exit 0
fi
echo "$ip" >"$STATE/ip"

cat >"$CONF" <<EOF
# Generated by homepod-sink — do not edit, the source of truth is the script.
context.properties = { log.level = $LOG_LEVEL }
context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}
context.modules = [
    { name = libpipewire-module-rt flags = [ ifexists nofail ] }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
    { name = libpipewire-module-raop-sink
        args = {
            raop.ip = "$ip"
            raop.port = 7000
            raop.name = "22613DB70BF7@Office"
            raop.hostname = "Office.local"
            raop.transport = "udp"
            raop.encryption.type = "fp_sap25"
            raop.audio.codec = "PCM"
            node.description = "$DESC"
        }
    }
]
EOF

moddir="$MODS"
if ! patch_raop; then
    echo "could not patch the RAOP User-Agent — the HomePod will answer 403"
    moddir="$SYS_MODS"
fi

echo "hosting RAOP sink for $ip (log level $LOG_LEVEL)"
PIPEWIRE_MODULE_DIR="$moddir" pipewire -c "$CONF" &
child=$!

sleep 5
misses=0
while kill -0 "$child" 2>/dev/null; do
    if sink_present; then
        misses=0
    elif ((++misses >= 2)); then
        echo "sink vanished from the daemon (failed session?) — reloading"
        kill "$child" 2>/dev/null
        exit 1
    fi
    sleep 60
done
echo "pipewire child exited — reloading"
exit 1
