#!/usr/bin/env bash
# battery-health-log — appends one line a day about the pack's decline.
#
#   date<TAB>health<TAB>cycles<TAB>charge_full<TAB>charge_full_design
#   2026-09-04	83.4	359	4254000	5103000
#
# WHY THIS EXISTS. `charge_full` vs `charge_full_design` is the only honest
# measure of how much battery is left in the battery, and the kernel reports
# it as an instantaneous number with no history whatsoever. This machine is
# already at ~83% of design capacity and nothing anywhere recorded how fast it
# got there, so there is no way to tell a pack ageing normally from one that
# fell off a cliff last month. One line a day fixes that, permanently, for
# about 41 bytes — a year is ~15 KB.
#
# ONE LINE PER DAY, and the guard is the date in the last line rather than a
# timestamp file: the log IS the state, so it cannot drift out of sync with
# itself, and running this by hand ten times in an afternoon is a no-op. A day
# the machine was off is simply absent, which is why the panel plots against
# real dates and lets gaps read as gaps.
#
# `charge_full` MOVES between reads — it is the fuel gauge's running estimate,
# not a constant, and it swings by a few thousand µAh as the pack warms or the
# gauge recalibrates. That is noise, not signal: the trend only means anything
# over months, which is exactly why this samples daily instead of hourly.
#
# Absent hardware is not an error. The Mac mini and the NUC have no battery,
# the timer is condition-gated so it should never start there, and if it does
# this exits 0 having written nothing.
set -uo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/qshell"
log="$state_dir/battery-health.tsv"

power_supply_path="${QSHELL_POWER_SUPPLY_PATH:-/sys/class/power_supply}"

read_or_empty() {
  [ -r "$1" ] || return 0
  tr -d '[:space:]' <"$1"
}

battery=""
for candidate in "$power_supply_path"/*; do
  [ -r "$candidate/type" ] || continue
  [ "$(cat "$candidate/type" 2>/dev/null)" = "Battery" ] || continue
  [ "$(cat "$candidate/present" 2>/dev/null)" = "1" ] || continue
  battery="$candidate"
  break
done
[ -n "$battery" ] || exit 0

# energy_* is the same pair in µWh on hardware that reports watt-hours instead
# of amp-hours; either is fine because health is a RATIO and the units cancel.
full="$(read_or_empty "$battery/charge_full")"
design="$(read_or_empty "$battery/charge_full_design")"
if [ -z "$full" ] || [ -z "$design" ]; then
  full="$(read_or_empty "$battery/energy_full")"
  design="$(read_or_empty "$battery/energy_full_design")"
fi
cycles="$(read_or_empty "$battery/cycle_count")"

# A zero or missing design capacity would make the ratio meaningless, and a
# health number that is silently wrong is worse than no health number.
[ -n "$full" ] && [ -n "$design" ] || exit 0
[ "$design" -gt 0 ] 2>/dev/null || exit 0

today="$(date +%F)"

mkdir -p "$state_dir" || exit 0

# Today already recorded. Checked against the last line only: the file is
# append-only and chronological, so nothing earlier can match today.
if [ -f "$log" ] && [ "$(tail -n 1 "$log" 2>/dev/null | cut -f1)" = "$today" ]; then
  exit 0
fi

health="$(awk -v f="$full" -v d="$design" 'BEGIN { printf "%.1f", (f / d) * 100 }')"

# Written through a temp file and appended atomically-enough: a partial line
# from a machine losing power mid-write would corrupt the parse for good.
line="$(printf '%s\t%s\t%s\t%s\t%s' "$today" "$health" "${cycles:-0}" "$full" "$design")"
printf '%s\n' "$line" >>"$log" || exit 0
